// Пропагатор W3C Baggage.
//
// Обеспечивает внедрение и извлечение Baggage в/из HTTP-заголовков
// по спецификации W3C Baggage (https://www.w3.org/TR/baggage/).
// Заголовок: baggage
// Формат: key1=value1,key2=value2

#Область ОписаниеПеременных

// ОтелГеттерТекстовойКарты - геттер по умолчанию для HTTP-заголовков
Перем ГеттерПоУмолчанию;

// ОтелСеттерТекстовойКарты - сеттер по умолчанию для HTTP-заголовков
Перем СеттерПоУмолчанию;

// Логгер
Перем Лог;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Внедряет Baggage в заголовки.
// Внедряет Baggage из контекста в заголовки носителя.
//
// Параметры:
//   Контекст - Соответствие - OTel Context
//   Носитель - Произвольный - носитель заголовков
//   Сеттер - ОтелСеттерТекстовойКарты - объект для записи в носитель (по умолчанию для Соответствие)
//
Процедура Внедрить(Контекст, Носитель, Сеттер = Неопределено) Экспорт
    ОбъектBaggage = ОтелКонтекст.BaggageИзКонтекста(Контекст);
    Если ОбъектBaggage = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Значения = ОбъектBaggage.ПолучитьВсе();
    Если Значения.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    РабочийСеттер = Сеттер;
    Если РабочийСеттер = Неопределено Тогда
        РабочийСеттер = СеттерПоУмолчанию;
    КонецЕсли;

    Части = Новый Массив();
    Для Каждого Элемент Из Значения Цикл
        // Ключ в заголовке - token (RFC 7230) без кодирования, остальные ключи передать нельзя
        Если НЕ ЭтоТокен(Элемент.Ключ) Тогда
            Лог.Отладка("Ключ baggage '%1' не является token и не будет внедрён", Элемент.Ключ);
            Продолжить;
        КонецЕсли;
        Часть = Элемент.Ключ + "=" + КодироватьЗначение(Элемент.Значение);
        // Пробелы по краям свойств W3C Baggage необязательны (OWS), а значение поля HTTP не может
        // заканчиваться пробелом: с ним сеттер отбросил бы весь заголовок
        Метаданные = СокрЛП(ОбъектBaggage.ПолучитьМетаданные(Элемент.Ключ));
        Если ПустаяСтрока(Метаданные) Тогда // BSLLS:EmptyCodeBlock-off
            // Метаданных нет
        ИначеЕсли МетаданныеДопустимы(Метаданные) Тогда
            Часть = Часть + ";" + Метаданные;
        Иначе
            // Заголовок допускает только US-ASCII поля HTTP (RFC 9110): метаданные вне
            // грамматики свойств W3C Baggage опускаются, сама запись внедряется
            Лог.Отладка("Метаданные baggage для ключа '%1' недопустимы в заголовке и не будут внедрены",
                Элемент.Ключ);
        КонецЕсли;
        Части.Добавить(Часть);
    КонецЦикла;

    Если Части.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    ЗначениеЗаголовка = СтрСоединить(Части, ",");
    // W3C Baggage spec: значение заголовка не должно превышать 8192 байт
    МаксимальноеКоличествоСимволов = 8192;
    Если СтрДлина(ЗначениеЗаголовка) > МаксимальноеКоличествоСимволов Тогда
        Лог.Предупреждение(
            "Заголовок baggage превышает %1 байт и не будет внедрён",
            МаксимальноеКоличествоСимволов);
        Возврат;
    КонецЕсли;

    РабочийСеттер.Установить(Носитель, "baggage", ЗначениеЗаголовка);
КонецПроцедуры

// Извлекает Baggage из заголовков.
// Извлекает Baggage из заголовков носителя в новый контекст.
//
// Параметры:
//   Контекст - Соответствие - входной OTel Context
//   Носитель - Произвольный - носитель заголовков
//   Геттер - ОтелГеттерТекстовойКарты - объект для чтения из носителя (по умолчанию для Соответствие)
//
// Возвращаемое значение:
//   Соответствие - новый контекст с Baggage (или входной контекст если заголовок отсутствует)
//
Функция Извлечь(Контекст, Носитель, Геттер = Неопределено) Экспорт
    РабочийГеттер = Геттер;
    Если РабочийГеттер = Неопределено Тогда
        РабочийГеттер = ГеттерПоУмолчанию;
    КонецЕсли;

    Построитель = Новый ОтелПостроительBaggage();

    ЗначениеЗаголовка = РабочийГеттер.Получить(Носитель, "baggage");
    Если ЗначениеЗаголовка = Неопределено Тогда
        Возврат Контекст;
    КонецЕсли;

    Части = СтрРазделить(ЗначениеЗаголовка, ",");
    ЗаписьИзвлечена = Ложь;
    Для Каждого Часть Из Части Цикл
        ЧастьОчищенная = СокрЛП(Часть);
        Если ПустаяСтрока(ЧастьОчищенная) Тогда
            Продолжить;
        КонецЕсли;

        ПозРавно = СтрНайти(ЧастьОчищенная, "=");
        Если ПозРавно = 0 Тогда
            Продолжить;
        КонецЕсли;

        // Ключ - до первого "=", значение - до ";", остальное - metadata (игнорируем)
        Ключ = СокрЛП(Лев(ЧастьОчищенная, ПозРавно - 1));
        ОстатокЗначения = Сред(ЧастьОчищенная, ПозРавно + 1);

        // Извлекаем metadata (часть после ";")
        ПозТочкаЗап = СтрНайти(ОстатокЗначения, ";");
        Метаданные = "";
        Если ПозТочкаЗап > 0 Тогда
            Значение = СокрЛП(Лев(ОстатокЗначения, ПозТочкаЗап - 1));
            Метаданные = СокрЛП(Сред(ОстатокЗначения, ПозТочкаЗап + 1));
        Иначе
            Значение = СокрЛП(ОстатокЗначения);
        КонецЕсли;

        Если ЭтоТокен(Ключ) Тогда
            Построитель.Установить(Ключ, ДекодироватьЗначение(Значение), Метаданные);
            ЗаписьИзвлечена = Истина;
        КонецЕсли;
    КонецЦикла;

    // Заголовок без единой пары ключ=значение не разобран: по спецификации пропагатор
    // не записывает в контекст новое значение, чтобы сохранить существующий baggage
    Если НЕ ЗаписьИзвлечена Тогда
        Возврат Контекст;
    КонецЕсли;

    Возврат ОтелКонтекст.КонтекстСBaggage(Контекст, Построитель.Построить());
КонецФункции

// Возвращает список полей, используемых пропагатором.
//
// Возвращаемое значение:
//   Массив из Строка - имена используемых заголовков
//
Функция Поля() Экспорт
    Результат = Новый Массив();
    Результат.Добавить("baggage");
    Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, что ключ является token по RFC 7230.
// tchar = "!" / "#" / "$" / "%" / "&" / "'" / "*" / "+" / "-" / "." / "^" / "_" / "`" / "|" / "~" / DIGIT / ALPHA
//
// Параметры:
//   Ключ - Строка - ключ baggage
//
// Возвращаемое значение:
//   Булево - Истина, если ключ непустой и состоит только из tchar
//
Функция ЭтоТокен(Ключ)
    Если ТипЗнч(Ключ) <> Тип("Строка") ИЛИ Ключ = "" Тогда
        Возврат Ложь;
    КонецЕсли;
    Для Позиция = 1 По СтрДлина(Ключ) Цикл
        Если НЕ ЭтоTchar(КодСимвола(Ключ, Позиция)) Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

Функция ЭтоTchar(Код)
    // BSLLS:MagicNumber-off
    ЭтоЦифра = Код >= 48 И Код <= 57;
    ЭтоБуква = (Код >= 65 И Код <= 90) ИЛИ (Код >= 97 И Код <= 122);
    ЭтоСпецсимвол = Код < 128 И СтрНайти("!#$%&'*+-.^_`|~", Символ(Код)) > 0;
    Возврат ЭтоЦифра ИЛИ ЭтоБуква ИЛИ ЭтоСпецсимвол;
    // BSLLS:MagicNumber-on
КонецФункции

// Проверяет, что метаданные записи можно передать в заголовке как свойства W3C Baggage
// (property = key OWS "=" OWS value / key OWS, свойства разделяются ";"): допустимы
// baggage-octet (включая '%' уже закодированных значений), ';', пробел и табуляция.
// Запятая, кавычка, обратная косая черта и символы вне US-ASCII недопустимы.
//
// Параметры:
//   Метаданные - Строка - метаданные записи baggage
//
// Возвращаемое значение:
//   Булево - Истина, если метаданные можно внедрить как есть
//
Функция МетаданныеДопустимы(Метаданные)
    // BSLLS:MagicNumber-off
    Для Позиция = 1 По СтрДлина(Метаданные) Цикл
        Код = КодСимвола(Метаданные, Позиция);
        Допустим = ЭтоДопустимыйBaggageОктет(Код) ИЛИ Код = 37 ИЛИ Код = 59 ИЛИ Код = 32 ИЛИ Код = 9;
        Если НЕ Допустим Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
    // BSLLS:MagicNumber-on
КонецФункции

// Кодирует значение baggage по спецификации W3C.
// baggage-octet = %x21 / %x23-2B / %x2D-3A / %x3C-5B / %x5D-7E
// Все символы вне этого диапазона, а также '%', кодируются percent-encoding.
// Символ вне BMP (суррогатная пара UTF-16) кодируется целиком в UTF-8.
//
// Параметры:
//   Значение - Строка - исходное значение
//
// Возвращаемое значение:
//   Строка - закодированное значение
//
Функция КодироватьЗначение(Значение)
    Результат = "";
    Длина = СтрДлина(Значение);
    Позиция = 1;
    Пока Позиция <= Длина Цикл
        Код = КодСимвола(Значение, Позиция);
        ДлинаСимвола = ?(ЭтоСуррогатнаяПара(Значение, Позиция), 2, 1);
        Символ = Сред(Значение, Позиция, ДлинаСимвола);
        Если ЭтоДопустимыйBaggageОктет(Код) Тогда
            Результат = Результат + Символ;
        Иначе
            Результат = Результат + КодироватьСимволПроцентами(Символ, Код);
        КонецЕсли;
        Позиция = Позиция + ДлинаСимвола;
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Проверяет, что с позиции начинается суррогатная пара UTF-16 (символ вне BMP).
//
// Параметры:
//   Строка - Строка - исходная строка
//   Позиция - Число - позиция первого code unit
//
// Возвращаемое значение:
//   Булево - Истина, если в позиции старший суррогат, а за ним младший
//
Функция ЭтоСуррогатнаяПара(Строка, Позиция)
    // BSLLS:MagicNumber-off
    Если Позиция >= СтрДлина(Строка) Тогда
        Возврат Ложь;
    КонецЕсли;
    Старший = КодСимвола(Строка, Позиция);
    Младший = КодСимвола(Строка, Позиция + 1);
    ЭтоСтарший = Старший >= 55296 И Старший <= 56319; // 0xD800-0xDBFF
    ЭтоМладший = Младший >= 56320 И Младший <= 57343; // 0xDC00-0xDFFF
    Возврат ЭтоСтарший И ЭтоМладший;
    // BSLLS:MagicNumber-on
КонецФункции

// Проверяет, является ли символ допустимым baggage-octet, который не нужно кодировать.
// Диапазоны: 0x21, 0x23-0x2B, 0x2D-0x3A, 0x3C-0x5B, 0x5D-0x7E, кроме '%' (0x25):
// спецификация OpenTelemetry требует кодировать его всегда.
//
// Параметры:
//   Код - Число - код символа
//
// Возвращаемое значение:
//   Булево - Истина если символ допустим без кодирования
//
Функция ЭтоДопустимыйBaggageОктет(Код)
    // BSLLS:MagicNumber-off
    // BSLLS:IfElseDuplicatedCodeBlock-off
    Если Код = 33 Тогда // 0x21
        Возврат Истина;
    ИначеЕсли Код = 37 Тогда // 0x25 '%'
        Возврат Ложь;
    ИначеЕсли Код >= 35 И Код <= 43 Тогда // 0x23-0x2B
        Возврат Истина;
    ИначеЕсли Код >= 45 И Код <= 58 Тогда // 0x2D-0x3A
        Возврат Истина;
    ИначеЕсли Код >= 60 И Код <= 91 Тогда // 0x3C-0x5B
        Возврат Истина;
    ИначеЕсли Код >= 93 И Код <= 126 Тогда // 0x5D-0x7E
        Возврат Истина;
    Иначе
        Возврат Ложь;
    КонецЕсли;
    // BSLLS:IfElseDuplicatedCodeBlock-on
    // BSLLS:MagicNumber-on
КонецФункции

// Кодирует символ в percent-encoding (%XX).
// Для символов > 0x7F использует UTF-8 байтовое кодирование через КодироватьСтроку.
//
// Параметры:
//   Символ - Строка - символ; для символа вне BMP - суррогатная пара из двух code unit
//   Код - Число - код первого code unit символа
//
// Возвращаемое значение:
//   Строка - percent-encoded представление
//
Функция КодироватьСимволПроцентами(Символ, Код)
    ДлинаOкрета = 2; // два hex-символа на один ASCII-байт
    Если Код <= 127 Тогда // BSLLS:MagicNumber-off
        Возврат "%" + ВШестнадцатеричнуюСтрокуСДополнением(Код, ДлинаOкрета);
    КонецЕсли; // BSLLS:MagicNumber-on
    // Для не-ASCII используем штатное URL-кодирование
    Возврат КодироватьСтроку(Символ, СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Преобразует число в шестнадцатеричную строку с дополнением нулями до заданной длины.
//
// Параметры:
//   Число - Число - значение
//   Длина - Число - минимальная длина результата
//
// Возвращаемое значение:
//   Строка - шестнадцатеричная строка в верхнем регистре
//
Функция ВШестнадцатеричнуюСтрокуСДополнением(Число, Длина)
    Хекс = ОтелУтилиты.ВШестнадцатеричнуюСтроку(Число);
    ВерхРегистр = ВРег(Хекс);
    Пока СтрДлина(ВерхРегистр) < Длина Цикл
        ВерхРегистр = "0" + ВерхРегистр;
    КонецЦикла;
    Возврат ВерхРегистр;
КонецФункции

Функция ДекодироватьЗначение(Значение)
    Возврат РаскодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Инициализирует пропагатор W3C Baggage.
//
Процедура ПриСозданииОбъекта()
    ГеттерПоУмолчанию = Новый ОтелГеттерТекстовойКарты();
    СеттерПоУмолчанию = Новый ОтелСеттерТекстовойКарты();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.propagation.baggage");
КонецПроцедуры

#КонецОбласти
