// Модуль сэмплеров (Sampler) по спецификации OpenTelemetry Trace SDK.
//
// Создает встроенные сэмплеры - AlwaysOn, AlwaysOff, TraceIdRatioBased, ParentBased и AlwaysRecord -
// и содержит константы решений сэмплера. Сэмплер - объект с методами ИнтерфейсСэмплер:
// ДолженСэмплировать (ShouldSample) и Описание (GetDescription). Сэмплер задается провайдеру
// трассировки; пользовательский сэмплер реализует тот же интерфейс и задается так же.

#Область ОписаниеПеременных

// ОтелСэмплерВсегдаВключен - экземпляр AlwaysOn, создается при первом обращении
Перем ЭкземплярВсегдаВключен;

// ОтелСэмплерВсегдаВыключен - экземпляр AlwaysOff, создается при первом обращении
Перем ЭкземплярВсегдаВыключен;

// ОтелРезультатСэмплирования - решение DROP без атрибутов, не меняющее TraceState
Перем РезультатОтбросить;

// ОтелРезультатСэмплирования - решение RECORD_ONLY без атрибутов, не меняющее TraceState
Перем РезультатЗаписать;

// ОтелРезультатСэмплирования - решение RECORD_AND_SAMPLE без атрибутов, не меняющее TraceState
Перем РезультатЗаписатьИЭкспортировать;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Решение сэмплера RECORD_AND_SAMPLE: спан записывается, флаг sampled устанавливается, спан
// экспортируется.
//
// Возвращаемое значение:
//   Число - константа решения
//
Функция РешениеЗаписатьИЭкспортировать() Экспорт
    Возврат 2;
КонецФункции

// Решение сэмплера RECORD_ONLY: спан записывается и передается процессорам, но флаг sampled
// не устанавливается и спан не экспортируется.
//
// Возвращаемое значение:
//   Число - константа решения
//
Функция РешениеЗаписать() Экспорт
    Возврат 1;
КонецФункции

// Решение сэмплера DROP: спан не записывается.
//
// Возвращаемое значение:
//   Число - константа решения
//
Функция РешениеОтбросить() Экспорт
    Возврат 0;
КонецФункции

// Возвращает сэмплер AlwaysOn: записывает и экспортирует все спаны.
//
// Возвращаемое значение:
//   ОтелСэмплерВсегдаВключен - сэмплер с описанием "AlwaysOnSampler"
//
Функция ВсегдаВключен() Экспорт
    Если ЭкземплярВсегдаВключен = Неопределено Тогда
        ЭкземплярВсегдаВключен = Новый ОтелСэмплерВсегдаВключен();
    КонецЕсли;
    Возврат ЭкземплярВсегдаВключен;
КонецФункции

// Возвращает сэмплер AlwaysOff: отбрасывает все спаны.
//
// Возвращаемое значение:
//   ОтелСэмплерВсегдаВыключен - сэмплер с описанием "AlwaysOffSampler"
//
Функция ВсегдаВыключен() Экспорт
    Если ЭкземплярВсегдаВыключен = Неопределено Тогда
        ЭкземплярВсегдаВыключен = Новый ОтелСэмплерВсегдаВыключен();
    КонецЕсли;
    Возврат ЭкземплярВсегдаВыключен;
КонецФункции

// Создает сэмплер TraceIdRatioBased: сэмплирует заданную долю трассировок по их TraceId,
// флаг sampled родителя не учитывает. Чтобы учитывать решение родителя, используйте сэмплер
// корневым в НаОсновеРодителя.
//
// Параметры:
//   Доля - Число - доля трассировок для сэмплирования от 0.0 до 1.0
//
// Возвращаемое значение:
//   ОтелСэмплерПоДолеТрассировок - сэмплер с описанием "TraceIdRatioBased{ДОЛЯ}"
//
Функция ПоДолеТрассировок(Доля) Экспорт
    Возврат Новый ОтелСэмплерПоДолеТрассировок(Доля);
КонецФункции

// Создает сэмплер ParentBased: корневой спан сэмплирует корневой сэмплер, дочерний - делегат,
// выбранный по родителю: удаленный он (SpanContext.IsRemote) или локальный, установлен ли у него
// флаг sampled.
//
// Параметры:
//   Корневой - ИнтерфейсСэмплер - сэмплер корневых спанов (root)
//   УдаленныйРодительСэмплирован - ИнтерфейсСэмплер - для удаленного сэмплированного родителя,
//       по умолчанию ВсегдаВключен (необязательный)
//   УдаленныйРодительНеСэмплирован - ИнтерфейсСэмплер - для удаленного несэмплированного родителя,
//       по умолчанию ВсегдаВыключен (необязательный)
//   ЛокальныйРодительСэмплирован - ИнтерфейсСэмплер - для локального сэмплированного родителя,
//       по умолчанию ВсегдаВключен (необязательный)
//   ЛокальныйРодительНеСэмплирован - ИнтерфейсСэмплер - для локального несэмплированного родителя,
//       по умолчанию ВсегдаВыключен (необязательный)
//
// Возвращаемое значение:
//   ОтелСэмплерНаОсновеРодителя - сэмплер с описанием "ParentBased{root:...,remoteParentSampled:...,
//       remoteParentNotSampled:...,localParentSampled:...,localParentNotSampled:...}"
//
// BSLLS:NumberOfOptionalParams-off
Функция НаОсновеРодителя(Корневой,
        УдаленныйРодительСэмплирован = Неопределено,
        УдаленныйРодительНеСэмплирован = Неопределено,
        ЛокальныйРодительСэмплирован = Неопределено,
        ЛокальныйРодительНеСэмплирован = Неопределено) Экспорт
// BSLLS:NumberOfOptionalParams-on
    Возврат Новый ОтелСэмплерНаОсновеРодителя(Корневой,
        УдаленныйРодительСэмплирован, УдаленныйРодительНеСэмплирован,
        ЛокальныйРодительСэмплирован, ЛокальныйРодительНеСэмплирован);
КонецФункции

// Создает сэмплер AlwaysRecord: заменяет решение DROP обернутого сэмплера на RECORD_ONLY.
// Процессоры получают все спаны (например, для расчета метрик по спанам), экспортеры -
// только сэмплированные.
//
// Параметры:
//   Корневой - ИнтерфейсСэмплер - обернутый сэмплер (root)
//
// Возвращаемое значение:
//   ОтелСэмплерВсегдаЗаписывать - сэмплер с описанием "AlwaysRecord{ОПИСАНИЕ_ОБЕРНУТОГО}"
//
Функция ВсегдаЗаписывать(Корневой) Экспорт
    Возврат Новый ОтелСэмплерВсегдаЗаписывать(Корневой);
КонецФункции

// Возвращает результат сэмплирования с решением, без атрибутов и не меняющий TraceState
// (спан получает TraceState родителя). Результаты решений создаются один раз: сэмплер может
// возвращать их без создания объекта на каждый спан.
//
// Параметры:
//   Решение - Число - решение сэмплера: РешениеОтбросить, РешениеЗаписать или
//       РешениеЗаписатьИЭкспортировать
//
// Возвращаемое значение:
//   ОтелРезультатСэмплирования - неизменяемый результат
//
Функция Результат(Решение) Экспорт
    Если Решение = РешениеЗаписатьИЭкспортировать() Тогда
        РезультатРешения = РезультатЗаписатьИЭкспортировать;
    ИначеЕсли Решение = РешениеОтбросить() Тогда
        РезультатРешения = РезультатОтбросить;
    ИначеЕсли Решение = РешениеЗаписать() Тогда
        РезультатРешения = РезультатЗаписать;
    Иначе
        РезультатРешения = Новый ОтелРезультатСэмплирования(Решение);
    КонецЕсли;
    Возврат РезультатРешения;
КонецФункции

// Возвращает SpanContext родителя создаваемого спана из контекста, который получает сэмплер.
//
// Параметры:
//   Контекст - ФиксированноеСоответствие, Соответствие - контекст (Context), переданный сэмплеру
//
// Возвращаемое значение:
//   ОтелКонтекстСпана, Неопределено - контекст родительского спана; Неопределено - спан корневой:
//       в контексте нет спана или его SpanContext невалиден
//
Функция КонтекстСпанаРодителя(Контекст) Экспорт
    Если Контекст = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Спан = ОтелКонтекст.СпанИзКонтекста(Контекст);
    Если Спан = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    КонтекстСпана = Спан.КонтекстСпана();
    Если КонтекстСпана = Неопределено ИЛИ НЕ КонтекстСпана.Валиден() Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат КонтекстСпана;
КонецФункции

#КонецОбласти

#Область Инициализация

РезультатОтбросить = Новый ОтелРезультатСэмплирования(РешениеОтбросить());
РезультатЗаписать = Новый ОтелРезультатСэмплирования(РешениеЗаписать());
РезультатЗаписатьИЭкспортировать = Новый ОтелРезультатСэмплирования(РешениеЗаписатьИЭкспортировать());

#КонецОбласти
