#Область ОписаниеПеременных

// ОтелТрассировщик - Трассировщик для создания спана
Перем Трассировщик;
// Строка - Имя создаваемого спана
Перем ИмяСпана;
// Число - Вид спана (SpanKind)
Перем ВидСпана;
// Соответствие, ФиксированноеСоответствие, Неопределено - явно заданный контекст родителя
// (Неопределено - родитель берется из неявного текущего контекста)
Перем КонтекстРодителя;
// Булево - Признак корневого спана (без родителя)
Перем НетРодителя;
// Соответствие - Атрибуты создаваемого спана
Перем Атрибуты;
// Массив - Список линков создаваемого спана
Перем Линки;
// Строка - Время начала спана в наносекундах
Перем ВремяНачала;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Устанавливает родительский контекст.
// Аналог Java SDK: SpanBuilder.setParent(context)
// Родитель определяется по контексту: спан из контекста становится родителем,
// контекст без спана дает корневой спан (неявный текущий контекст не используется).
// Контекст передается процессорам в ПриНачале.
//
// Параметры:
//   Значение - ФиксированноеСоответствие, Соответствие - контекст (Context)
//
// Возвращаемое значение:
//   ОтелПостроительСпана - ЭтотОбъект для fluent API
//
Функция УстановитьРодителя(Значение) Экспорт
    КонтекстРодителя = Значение;
    НетРодителя = Ложь;
    Возврат ЭтотОбъект;
КонецФункции

// Указывает, что спан должен быть корневым (без родителя).
// Аналог Java SDK: SpanBuilder.setNoParent()
//
// Возвращаемое значение:
//   ОтелПостроительСпана - ЭтотОбъект для fluent API
//
Функция БезРодителя() Экспорт
    КонтекстРодителя = Неопределено;
    НетРодителя = Истина;
    Возврат ЭтотОбъект;
КонецФункции

// Устанавливает вид спана.
// Аналог Java SDK: SpanBuilder.setSpanKind(SpanKind)
//
// Параметры:
//   Значение - Число - одно из значений ОтелВидСпана
//
// Возвращаемое значение:
//   ОтелПостроительСпана - ЭтотОбъект для fluent API
//
Функция УстановитьВидСпана(Значение) Экспорт
    ВидСпана = Значение;
    Возврат ЭтотОбъект;
КонецФункции

// Устанавливает атрибут на создаваемом спане.
// Атрибуты предпочтительно устанавливать при создании спана
// через SpanBuilder, а не через Span.SetAttribute() после создания.
//
// Параметры:
//   Ключ - Строка - ключ атрибута
//   Значение - Произвольный - значение атрибута
//
// Возвращаемое значение:
//   ОтелПостроительСпана - ЭтотОбъект для fluent API
//
Функция УстановитьАтрибут(Ключ, Значение) Экспорт
    Атрибуты.Вставить(Ключ, Значение);
    Возврат ЭтотОбъект;
КонецФункции

// Добавляет линк к создаваемому спану.
// Линк к контексту, известному при создании спана, лучше задавать здесь, а не через
// ОтелСпан.ДобавитьЛинк() после создания: решение сэмплера (head sampling) учитывает
// только данные, известные при создании спана.
//
// Параметры:
//   КонтекстСпана - ОтелКонтекстСпана - контекст связанного спана
//   НовыеАтрибуты - ОтелАтрибуты - атрибуты линка (необязательный)
//
// Возвращаемое значение:
//   ОтелПостроительСпана - ЭтотОбъект для fluent API
//
Функция ДобавитьЛинк(КонтекстСпана, НовыеАтрибуты = Неопределено) Экспорт
    Линки.Добавить(Новый ОтелЛинк(КонтекстСпана, НовыеАтрибуты));
    Возврат ЭтотОбъект;
КонецФункции

// Устанавливает время начала спана.
// Аналог Java SDK: SpanBuilder.setStartTimestamp(instant)
//
// Устанавливать явно ТОЛЬКО если вызов API не совпадает с логическим стартом
// операции (например, при асинхронной постановке в очередь и отложенной
// обработке). По умолчанию SDK использует текущее время в момент НачатьСпан().
//
// Параметры:
//   Значение - Строка - время в наносекундах (Unix epoch)
//
// Возвращаемое значение:
//   ОтелПостроительСпана - ЭтотОбъект для fluent API
//
Функция УстановитьВремяНачала(Значение) Экспорт
    ВремяНачала = Значение;
    Возврат ЭтотОбъект;
КонецФункции

// Создает и запускает спан с настроенными параметрами.
// Аналог Java SDK: SpanBuilder.startSpan()
//
// Возвращаемое значение:
//   ОтелСпан, ОтелНезаписывающийСпан - спан или незаписывающий спан если отброшен семплером
//
Функция НачатьСпан() Экспорт
    // Время начала передается при создании спана: процессоры видят его уже в OnStart
    Если НетРодителя Тогда
        Спан = Трассировщик.НачатьКорневойСпан(ИмяСпана, ВидСпана, Атрибуты, Линки, ВремяНачала);
    ИначеЕсли КонтекстРодителя <> Неопределено Тогда
        Спан = Трассировщик.НачатьСпанВКонтексте(ИмяСпана, КонтекстРодителя, ВидСпана, Атрибуты, Линки,
            ВремяНачала);
    Иначе
        // Контекст не задан - родитель из неявного текущего контекста
        Спан = Трассировщик.НачатьСпан(ИмяСпана, ВидСпана, Атрибуты, Линки, ВремяНачала);
    КонецЕсли;
    Возврат Спан;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьИмяСпана(Значение)
    ИмяСпана = Значение;
КонецПроцедуры

Процедура УстановитьТрассировщик(Значение)
    Трассировщик = Значение;
КонецПроцедуры

// Построитель спана (SpanBuilder) по спецификации OpenTelemetry.
// Аналог Java SDK: Tracer.spanBuilder("name")
//
// Позволяет настроить параметры спана до его создания:
// - Родительский контекст
// - Вид спана
// - Атрибуты
// - Линки
// - Время начала
//
// Конструктор. Вызывается из ОтелТрассировщик.ПостроительСпана().
//
// Параметры:
//   Трассировщик - ОтелТрассировщик - трассировщик, создающий спан
//   ИмяСпана - Строка - имя создаваемого спана
//
// Пример:
//   Спан = Трассировщик.ПостроительСпана("обработка")
//       .УстановитьВидСпана(ОтелВидСпана.Сервер())
//       .УстановитьАтрибут("http.method", "GET")
//       .ДобавитьЛинк(ВнешнийКонтекст)
//       .НачатьСпан();
//
Процедура ПриСозданииОбъекта(Трассировщик, ИмяСпана)
    УстановитьТрассировщик(Трассировщик);
    УстановитьИмяСпана(ИмяСпана);
    ВидСпана = Неопределено;
    КонтекстРодителя = Неопределено;
    НетРодителя = Ложь;
    Атрибуты = Новый Соответствие();
    Линки = Новый Массив();
    ВремяНачала = Неопределено;
КонецПроцедуры

#КонецОбласти
