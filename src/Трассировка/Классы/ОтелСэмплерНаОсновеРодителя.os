#Область ОписаниеПеременных

// ИнтерфейсСэмплер - сэмплер корневых спанов (root)
Перем Корневой;

// ИнтерфейсСэмплер - сэмплер для удаленного сэмплированного родителя (remoteParentSampled)
Перем УдаленныйРодительСэмплирован;

// ИнтерфейсСэмплер - сэмплер для удаленного несэмплированного родителя (remoteParentNotSampled)
Перем УдаленныйРодительНеСэмплирован;

// ИнтерфейсСэмплер - сэмплер для локального сэмплированного родителя (localParentSampled)
Перем ЛокальныйРодительСэмплирован;

// ИнтерфейсСэмплер - сэмплер для локального несэмплированного родителя (localParentNotSampled)
Перем ЛокальныйРодительНеСэмплирован;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Передает решение сэмплеру, выбранному по родителю создаваемого спана (ShouldSample):
// нет родителя - корневому, иначе - делегату для удаленного (SpanContext.IsRemote) или локального
// родителя с флагом sampled или без него.
//
// Параметры:
//   Контекст - ФиксированноеСоответствие - контекст с родительским спаном
//   ИдТрассировки - Строка - TraceId создаваемого спана
//   ИмяСпана - Строка - имя создаваемого спана
//   ВидСпана - Число - вид создаваемого спана (ОтелВидСпана)
//   Атрибуты - Соответствие, ФиксированноеСоответствие - начальные атрибуты создаваемого спана
//   Линки - Массив из ОтелЛинк, ФиксированныйМассив из ОтелЛинк - линки создаваемого спана
//
// Возвращаемое значение:
//   ОтелРезультатСэмплирования - результат выбранного сэмплера
//
Функция ДолженСэмплировать(Контекст, ИдТрассировки, ИмяСпана, ВидСпана, Атрибуты, Линки) Экспорт
    КонтекстРодителя = ОтелСэмплер.КонтекстСпанаРодителя(Контекст);
    Сэмплер = СэмплерДляРодителя(КонтекстРодителя);
    Возврат Сэмплер.ДолженСэмплировать(Контекст, ИдТрассировки, ИмяСпана, ВидСпана, Атрибуты, Линки);
КонецФункции

// Возвращает описание сэмплера (GetDescription) с описаниями корневого сэмплера и делегатов.
//
// Возвращаемое значение:
//   Строка - "ParentBased{root:...,remoteParentSampled:...,remoteParentNotSampled:...,
//       localParentSampled:...,localParentNotSampled:...}"
//
Функция Описание() Экспорт
    ОписаниеКорневого = Корневой.Описание();
    ОписаниеУдаленногоСэмплированного = УдаленныйРодительСэмплирован.Описание();
    ОписаниеУдаленногоНеСэмплированного = УдаленныйРодительНеСэмплирован.Описание();
    ОписаниеЛокальногоСэмплированного = ЛокальныйРодительСэмплирован.Описание();
    ОписаниеЛокальногоНеСэмплированного = ЛокальныйРодительНеСэмплирован.Описание();
    Возврат СтрШаблон("ParentBased{root:%1,remoteParentSampled:%2,remoteParentNotSampled:%3,"
            + "localParentSampled:%4,localParentNotSampled:%5}",
        ОписаниеКорневого,
        ОписаниеУдаленногоСэмплированного, ОписаниеУдаленногоНеСэмплированного,
        ОписаниеЛокальногоСэмплированного, ОписаниеЛокальногоНеСэмплированного);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выбирает сэмплер по родителю создаваемого спана.
//
// Параметры:
//   КонтекстРодителя - ОтелКонтекстСпана, Неопределено - контекст родителя; Неопределено - корневой спан
//
// Возвращаемое значение:
//   ИнтерфейсСэмплер
//
Функция СэмплерДляРодителя(КонтекстРодителя)
    Если КонтекстРодителя = Неопределено Тогда
        Возврат Корневой;
    КонецЕсли;

    // BSLLS:MagicNumber-off
    Сэмплирован = КонтекстРодителя.ФлагиТрассировки() % 2 = 1;
    // BSLLS:MagicNumber-on
    Если КонтекстРодителя.Удаленный() Тогда
        Если Сэмплирован Тогда
            Возврат УдаленныйРодительСэмплирован;
        КонецЕсли;
        Возврат УдаленныйРодительНеСэмплирован;
    КонецЕсли;

    Если Сэмплирован Тогда
        Возврат ЛокальныйРодительСэмплирован;
    КонецЕсли;
    Возврат ЛокальныйРодительНеСэмплирован;
КонецФункции

// Параметры:
//   Сэмплер - ИнтерфейсСэмплер, Неопределено - сэмплер делегата
//   Умолчание - ИнтерфейсСэмплер - делегат по умолчанию
//
// Возвращаемое значение:
//   ИнтерфейсСэмплер
//
Функция СэмплерИлиУмолчание(Сэмплер, Умолчание)
    Если Сэмплер = Неопределено Тогда
        Возврат Умолчание;
    КонецЕсли;
    Возврат Сэмплер;
КонецФункции

// Сэмплер ParentBased по спецификации OpenTelemetry: решение для корневого спана принимает
// корневой сэмплер, для дочернего - делегат, выбранный по родителю.
// Создается функцией ОтелСэмплер.НаОсновеРодителя.
//
// Конструктор.
//
// Параметры:
//   НовыйКорневой - ИнтерфейсСэмплер - сэмплер корневых спанов (root)
//   НовыйУдаленныйРодительСэмплирован - ИнтерфейсСэмплер - для удаленного сэмплированного
//       родителя, по умолчанию ВсегдаВключен (необязательный)
//   НовыйУдаленныйРодительНеСэмплирован - ИнтерфейсСэмплер - для удаленного несэмплированного
//       родителя, по умолчанию ВсегдаВыключен (необязательный)
//   НовыйЛокальныйРодительСэмплирован - ИнтерфейсСэмплер - для локального сэмплированного
//       родителя, по умолчанию ВсегдаВключен (необязательный)
//   НовыйЛокальныйРодительНеСэмплирован - ИнтерфейсСэмплер - для локального несэмплированного
//       родителя, по умолчанию ВсегдаВыключен (необязательный)
//
// BSLLS:NumberOfOptionalParams-off
&Реализует("ИнтерфейсСэмплер")
Процедура ПриСозданииОбъекта(НовыйКорневой,
        НовыйУдаленныйРодительСэмплирован = Неопределено,
        НовыйУдаленныйРодительНеСэмплирован = Неопределено,
        НовыйЛокальныйРодительСэмплирован = Неопределено,
        НовыйЛокальныйРодительНеСэмплирован = Неопределено)
// BSLLS:NumberOfOptionalParams-on
    ВсегдаВключен = ОтелСэмплер.ВсегдаВключен();
    ВсегдаВыключен = ОтелСэмплер.ВсегдаВыключен();
    Корневой = НовыйКорневой;
    УдаленныйРодительСэмплирован = СэмплерИлиУмолчание(НовыйУдаленныйРодительСэмплирован, ВсегдаВключен);
    УдаленныйРодительНеСэмплирован = СэмплерИлиУмолчание(НовыйУдаленныйРодительНеСэмплирован, ВсегдаВыключен);
    ЛокальныйРодительСэмплирован = СэмплерИлиУмолчание(НовыйЛокальныйРодительСэмплирован, ВсегдаВключен);
    ЛокальныйРодительНеСэмплирован = СэмплерИлиУмолчание(НовыйЛокальныйРодительНеСэмплирован, ВсегдаВыключен);
КонецПроцедуры

#КонецОбласти
