#Область ОписаниеПеременных

// ОтелРесурс - Ресурс, описывающий источник телеметрии
Перем Ресурс;
// Массив - Список процессоров спанов
Перем Процессоры;
// ИнтерфейсСэмплер, Неопределено - сэмплер спанов; Неопределено - сэмплер по умолчанию
Перем Сэмплер;
// ОтелЛимитыСпана - Лимиты спана
Перем ЛимитыСпана;
// Произвольный, Неопределено - генератор идентификаторов (IdGenerator)
Перем ГенераторИд;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Устанавливает ресурс.
//
// Параметры:
//   Значение - ОтелРесурс
//
// Возвращаемое значение:
//   ОтелПостроительПровайдераТрассировки - ЭтотОбъект для fluent API
//
Функция УстановитьРесурс(Значение) Экспорт
    Ресурс = Значение;
    Возврат ЭтотОбъект;
КонецФункции

// Добавляет процессор спанов.
// Аналог Java SDK: SdkTracerProviderBuilder.addSpanProcessor(processor)
//
// Параметры:
//   Процессор - ОтелПростойПроцессорСпанов, ОтелПакетныйПроцессорСпанов - процессор спанов
//
// Возвращаемое значение:
//   ОтелПостроительПровайдераТрассировки - ЭтотОбъект для fluent API
//
Функция ДобавитьПроцессор(Процессор) Экспорт
    Процессоры.Добавить(Процессор);
    Возврат ЭтотОбъект;
КонецФункции

// Устанавливает сэмплер спанов. Без вызова используется сэмплер по умолчанию
// ParentBased(root=AlwaysOn).
// Аналог Java SDK: SdkTracerProviderBuilder.setSampler(sampler)
//
// Параметры:
//   НовыйСэмплер - ИнтерфейсСэмплер - встроенный сэмплер из ОтелСэмплер или пользовательский
//
// Возвращаемое значение:
//   ОтелПостроительПровайдераТрассировки - ЭтотОбъект для fluent API
//
Функция УстановитьСэмплер(НовыйСэмплер) Экспорт
    Сэмплер = НовыйСэмплер;
    Возврат ЭтотОбъект;
КонецФункции

// Устанавливает лимиты спана.
// Аналог Java SDK: SdkTracerProviderBuilder.setSpanLimits(spanLimits)
//
// Параметры:
//   Значение - ОтелЛимитыСпана - лимиты спана
//
// Возвращаемое значение:
//   ОтелПостроительПровайдераТрассировки - ЭтотОбъект для fluent API
//
Функция УстановитьЛимитыСпана(Значение) Экспорт
    ЛимитыСпана = Значение;
    Возврат ЭтотОбъект;
КонецФункции

// Устанавливает генератор идентификаторов.
// Аналог Java SDK: SdkTracerProviderBuilder.setIdGenerator(idGenerator)
// Генератор должен реализовывать методы:
//   СгенерироватьИдТрассировки() -> Строка (32 hex)
//   СгенерироватьИдСпана() -> Строка (16 hex)
// Некорректный идентификатор (не hex, неверная длина, одни нули) логируется
// как ошибка и заменяется идентификатором генератора по умолчанию.
//
// Параметры:
//   Значение - Произвольный - объект-генератор идентификаторов
//
// Возвращаемое значение:
//   ОтелПостроительПровайдераТрассировки - ЭтотОбъект для fluent API
//
Функция УстановитьГенераторИд(Значение) Экспорт
    ГенераторИд = Значение;
    Возврат ЭтотОбъект;
КонецФункции

// Создает экземпляр провайдера трассировки.
//
// Возвращаемое значение:
//   ОтелПровайдерТрассировки
//
Функция Построить() Экспорт
    Провайдер = Новый ОтелПровайдерТрассировки(Ресурс, , Сэмплер, ЛимитыСпана, ГенераторИд);
    Для Каждого Процессор Из Процессоры Цикл
        Провайдер.ДобавитьПроцессор(Процессор);
    КонецЦикла;
    Возврат Провайдер;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Построитель провайдера трассировки (SdkTracerProviderBuilder).
// Аналог Java SDK: SdkTracerProvider.builder()
//
// Пример:
//   Провайдер = Новый ОтелПостроительПровайдераТрассировки()
//       .УстановитьРесурс(Ресурс)
//       .ДобавитьПроцессор(Процессор)
//       .УстановитьСэмплер(ОтелСэмплер.НаОсновеРодителя(ОтелСэмплер.ПоДолеТрассировок(0.1)))
//       .Построить();
//
Процедура ПриСозданииОбъекта()
    Процессоры = Новый Массив();
КонецПроцедуры

#КонецОбласти
