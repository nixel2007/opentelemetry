#Область ОписаниеПеременных

// ИнтерфейсСэмплер - обернутый сэмплер (root), решение которого изменяется
Перем Корневой;

// ОтелРезультатСэмплирования - решение RECORD_ONLY без атрибутов, не меняющее TraceState
Перем РезультатЗаписать;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает решение обернутого сэмплера, заменяя DROP на RECORD_ONLY (ShouldSample):
// процессоры получают все спаны, а экспортеры - только сэмплированные. Решения RECORD_ONLY и
// RECORD_AND_SAMPLE, атрибуты и TraceState обернутого сэмплера не меняются.
//
// Параметры:
//   Контекст - ФиксированноеСоответствие - контекст с родительским спаном
//   ИдТрассировки - Строка - TraceId создаваемого спана
//   ИмяСпана - Строка - имя создаваемого спана
//   ВидСпана - Число - вид создаваемого спана (ОтелВидСпана)
//   Атрибуты - Соответствие, ФиксированноеСоответствие - начальные атрибуты создаваемого спана
//   Линки - Массив из ОтелЛинк, ФиксированныйМассив из ОтелЛинк - линки создаваемого спана
//
// Возвращаемое значение:
//   ОтелРезультатСэмплирования - решение ОтелСэмплер.РешениеЗаписать или
//       ОтелСэмплер.РешениеЗаписатьИЭкспортировать
//
Функция ДолженСэмплировать(Контекст, ИдТрассировки, ИмяСпана, ВидСпана, Атрибуты, Линки) Экспорт
    Результат = Корневой.ДолженСэмплировать(Контекст, ИдТрассировки, ИмяСпана, ВидСпана, Атрибуты, Линки);
    Если Результат.Решение() <> ОтелСэмплер.РешениеОтбросить() Тогда
        Возврат Результат;
    КонецЕсли;

    АтрибутыРезультата = Результат.Атрибуты();
    СостояниеТрассировки = Результат.СостояниеТрассировки();
    Если АтрибутыРезультата.Количество() = 0 И СостояниеТрассировки = Неопределено Тогда
        Возврат РезультатЗаписать;
    КонецЕсли;
    Возврат Новый ОтелРезультатСэмплирования(РезультатЗаписать.Решение(), АтрибутыРезультата,
        СостояниеТрассировки);
КонецФункции

// Возвращает описание сэмплера (GetDescription) с описанием обернутого сэмплера.
//
// Возвращаемое значение:
//   Строка - "AlwaysRecord{ОПИСАНИЕ_ОБЕРНУТОГО}"
//
Функция Описание() Экспорт
    Возврат "AlwaysRecord{" + Корневой.Описание() + "}";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сэмплер AlwaysRecord по спецификации OpenTelemetry: декоратор, который заменяет решение DROP
// обернутого сэмплера на RECORD_ONLY, например для расчета метрик по всем спанам.
// Создается функцией ОтелСэмплер.ВсегдаЗаписывать.
//
// Конструктор.
//
// Параметры:
//   НовыйКорневой - ИнтерфейсСэмплер - обернутый сэмплер (root)
//
&Реализует("ИнтерфейсСэмплер")
Процедура ПриСозданииОбъекта(НовыйКорневой)
    Корневой = НовыйКорневой;
    РезультатЗаписать = ОтелСэмплер.Результат(ОтелСэмплер.РешениеЗаписать());
КонецПроцедуры

#КонецОбласти
