#Область ОписаниеПеременных

// Число - доля трассировок для сэмплирования (0.0 - 1.0)
Перем Доля;

// Число - порог отбора: трассировка сэмплируется, если значение случайности ее TraceId не меньше
//   порога. Порог убывает с ростом доли
Перем Порог;

// Число - длина значения случайности в hex-символах: правые 7 байт TraceId (56 бит)
Перем ДлинаЗначенияСлучайности;

// ОтелРезультатСэмплирования - решение для отобранной трассировки
Перем РезультатОтобрана;

// ОтелРезультатСэмплирования - решение для неотобранной трассировки
Перем РезультатНеОтобрана;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Принимает решение по TraceId (ShouldSample): RECORD_AND_SAMPLE для отобранной трассировки,
// иначе DROP. Решение - детерминированная функция TraceId: значение случайности R - правые
// 7 байт TraceId, только они случайны по W3C Trace Context Level 2 (в UUIDv4 левее лежат
// фиксированные биты версии и варианта). Трассировка отобрана, если R >= (1 - Доля) * 2^56,
// поэтому сэмплер с большей долей отбирает все трассировки сэмплера с меньшей.
// Флаг sampled родителя не учитывается.
//
// Параметры:
//   Контекст - ФиксированноеСоответствие - контекст с родительским спаном
//   ИдТрассировки - Строка - TraceId создаваемого спана (32 hex-символа)
//   ИмяСпана - Строка - имя создаваемого спана
//   ВидСпана - Число - вид создаваемого спана (ОтелВидСпана)
//   Атрибуты - Соответствие, ФиксированноеСоответствие - начальные атрибуты создаваемого спана
//   Линки - Массив из ОтелЛинк, ФиксированныйМассив из ОтелЛинк - линки создаваемого спана
//
// Возвращаемое значение:
//   ОтелРезультатСэмплирования - решение ОтелСэмплер.РешениеЗаписатьИЭкспортировать или
//       ОтелСэмплер.РешениеОтбросить
//
// BSLLS:UnusedParameters-off
Функция ДолженСэмплировать(Контекст, ИдТрассировки, ИмяСпана, ВидСпана, Атрибуты, Линки) Экспорт
// BSLLS:UnusedParameters-on
    Если ТрассировкаОтобрана(ИдТрассировки) Тогда
        Возврат РезультатОтобрана;
    КонецЕсли;
    Возврат РезультатНеОтобрана;
КонецФункции

// Возвращает описание сэмплера (GetDescription): доля с шестью знаками после точки, а если
// значащих знаков у доли больше - со всеми, чтобы описание различало сэмплеры с разными долями.
//
// Возвращаемое значение:
//   Строка - "TraceIdRatioBased{ДОЛЯ}", например "TraceIdRatioBased{0.000100}"
//
Функция Описание() Экспорт
    Возврат "TraceIdRatioBased{" + ДоляСтрокой() + "}";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, отобрана ли трассировка. Пустой или нешестнадцатеричный TraceId отбирается.
//
// Параметры:
//   ИдТрассировки - Строка - TraceId (32 hex-символа)
//
// Возвращаемое значение:
//   Булево
//
Функция ТрассировкаОтобрана(ИдТрассировки)
    Если Доля <= 0 Тогда
        Возврат Ложь;
    КонецЕсли;
    Если Доля >= 1 ИЛИ ИдТрассировки = "" Тогда
        Возврат Истина;
    КонецЕсли;

    ЗначениеСлучайности = ОтелУтилиты.ИзШестнадцатеричнойСтроки(Прав(ИдТрассировки, ДлинаЗначенияСлучайности));
    Возврат ЗначениеСлучайности = Неопределено ИЛИ ЗначениеСлучайности >= Порог;
КонецФункции

// Возвращаемое значение:
//   Строка - доля для описания сэмплера
//
Функция ДоляСтрокой()
    // BSLLS:MagicNumber-off
    Если Окр(Доля, 6) = Доля Тогда
        Возврат Формат(Доля, "ЧДЦ=6; ЧРД=.; ЧН=0; ЧГ=");
    КонецЕсли;
    // BSLLS:MagicNumber-on
    Возврат XMLСтрока(Доля);
КонецФункции

// Сэмплер TraceIdRatioBased по спецификации OpenTelemetry: сэмплирует заданную долю трассировок
// по их TraceId. Создается функцией ОтелСэмплер.ПоДолеТрассировок.
//
// Конструктор.
//
// Параметры:
//   НоваяДоля - Число - доля трассировок для сэмплирования от 0.0 до 1.0
//
&Реализует("ИнтерфейсСэмплер")
Процедура ПриСозданииОбъекта(НоваяДоля)
    // BSLLS:MagicNumber-off
    ДлинаЗначенияСлучайности = 14;
    ДиапазонСлучайности = 72057594037927936; // 2^56
    // BSLLS:MagicNumber-on
    Доля = НоваяДоля;
    Порог = (1 - Доля) * ДиапазонСлучайности;
    РезультатОтобрана = ОтелСэмплер.Результат(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
    РезультатНеОтобрана = ОтелСэмплер.Результат(ОтелСэмплер.РешениеОтбросить());
КонецПроцедуры

#КонецОбласти
