#Область ОписаниеПеременных

// Число - решение сэмплера: ОтелСэмплер.РешениеОтбросить, РешениеЗаписать или
//   РешениеЗаписатьИЭкспортировать
Перем Решение;

// ФиксированноеСоответствие - атрибуты, которые сэмплер добавляет в спан
Перем Атрибуты;

// ОтелСостояниеТрассировки, Неопределено - TraceState спана; Неопределено - сэмплер TraceState
//   не меняет
Перем СостояниеТрассировки;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает решение сэмплера.
//
// Возвращаемое значение:
//   Число - ОтелСэмплер.РешениеОтбросить (DROP), РешениеЗаписать (RECORD_ONLY) или
//       РешениеЗаписатьИЭкспортировать (RECORD_AND_SAMPLE)
//
Функция Решение() Экспорт
    Возврат Решение;
КонецФункции

// Возвращает атрибуты, которые сэмплер добавляет в спан. Атрибуты устанавливаются после
// начальных атрибутов спана (одноименные заменяют их) и видны процессорам уже в ПриНачале.
// У отброшенного спана атрибутов нет.
//
// Возвращаемое значение:
//   ФиксированноеСоответствие - неизменяемый набор атрибутов; пустой, если сэмплер атрибутов не задал
//
Функция Атрибуты() Экспорт
    Возврат Атрибуты;
КонецФункции

// Возвращает TraceState, который получит спан через свой SpanContext.
// Пустой TraceState очищает состояние трассировки спана.
//
// Возвращаемое значение:
//   ОтелСостояниеТрассировки, Неопределено - TraceState спана; Неопределено - сэмплер TraceState
//       не меняет: спан получает TraceState родителя (корневой спан - пустой)
//
Функция СостояниеТрассировки() Экспорт
    Возврат СостояниеТрассировки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Приводит атрибуты результата к неизменяемому набору.
//
// Параметры:
//   НовыеАтрибуты - ОтелАтрибуты, Соответствие, ФиксированноеСоответствие, Неопределено - атрибуты
//
// Возвращаемое значение:
//   ФиксированноеСоответствие
//
Функция НеизменяемыеАтрибуты(НовыеАтрибуты)
    ТипАтрибутов = ТипЗнч(НовыеАтрибуты);
    Если ТипАтрибутов = Тип("ФиксированноеСоответствие") Тогда
        Неизменяемые = НовыеАтрибуты;
    ИначеЕсли ТипАтрибутов = Тип("Соответствие") Тогда
        Неизменяемые = Новый ФиксированноеСоответствие(НовыеАтрибуты);
    ИначеЕсли НовыеАтрибуты = Неопределено Тогда
        Неизменяемые = Новый ФиксированноеСоответствие(Новый Соответствие());
    Иначе
        Неизменяемые = Новый ФиксированноеСоответствие(НовыеАтрибуты.ВСоответствие());
    КонецЕсли;
    Возврат Неизменяемые;
КонецФункции

// Результат сэмплирования (SamplingResult) по спецификации OpenTelemetry.
//
// Неизменяемый объект: решение сэмплера, атрибуты, которые сэмплер добавляет в спан, и TraceState
// спана. Возвращается методом ДолженСэмплировать сэмплера (см. ИнтерфейсСэмплер). Результат без
// атрибутов, не меняющий TraceState, возвращает ОтелСэмплер.Результат без создания объекта.
//
// Конструктор.
//
// Параметры:
//   НовоеРешение - Число - решение сэмплера (ОтелСэмплер.РешениеОтбросить, РешениеЗаписать,
//       РешениеЗаписатьИЭкспортировать)
//   НовыеАтрибуты - ОтелАтрибуты, Соответствие, ФиксированноеСоответствие - атрибуты, которые
//       сэмплер добавляет в спан; результат хранит их копию (необязательный)
//   НовоеСостояниеТрассировки - ОтелСостояниеТрассировки - TraceState спана; пустой очищает
//       состояние трассировки. Не задан - спан получает TraceState родителя (необязательный)
//
Процедура ПриСозданииОбъекта(НовоеРешение, НовыеАтрибуты = Неопределено, НовоеСостояниеТрассировки = Неопределено)
    Решение = НовоеРешение;
    Атрибуты = НеизменяемыеАтрибуты(НовыеАтрибуты);
    СостояниеТрассировки = НовоеСостояниеТрассировки;
КонецПроцедуры

#КонецОбласти
