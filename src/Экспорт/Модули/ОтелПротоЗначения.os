// BSLLS:MagicNumber-off
// Кодирование общих сообщений OTLP common.proto (KeyValue, AnyValue, ArrayValue, KeyValueList)
// в protobuf wire-формат. Используется кодировщиками трассировки, метрик и логов.
// Входные данные - структуры OTLP/JSON: {"key": ..., "value": {"stringValue": ...}} и т.п.

#Область ОписаниеПеременных

// Число - wire-тип Varint (bool, int64)
Перем ВайрVarint;
// Число - wire-тип 64-bit (double)
Перем ВайрFixed64;
// Число - wire-тип Length-delimited (string, bytes, вложенные сообщения)
Перем ВайрLen;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Кодирует KeyValue: field 1 = key (string), field 2 = value (AnyValue).
//
// Параметры:
//   Писатель - ОтелПротоПисатель - писатель protobuf
//   КлючЗначение - Соответствие - {"key": Строка, "value": Соответствие AnyValue}
//
Процедура КодироватьKeyValue(Писатель, КлючЗначение) Экспорт
    Ключ = КлючЗначение.Получить("key");
    Если Ключ <> Неопределено И Строка(Ключ) <> "" Тогда
        Писатель.ЗаписатьТег(1, ВайрLen);
        Писатель.ЗаписатьСтроку(Строка(Ключ));
    КонецЕсли;

    Значение = КлючЗначение.Получить("value");
    Если Значение <> Неопределено Тогда
        ПисательЗначения = Новый ОтелПротоПисатель();
        КодироватьAnyValue(ПисательЗначения, Значение);
        ЗаписатьВложенное(Писатель, 2, ПисательЗначения);
    КонецЕсли;
КонецПроцедуры

// Кодирует AnyValue (oneof): string_value = 1, bool_value = 2, int_value = 3, double_value = 4,
// array_value = 5, kvlist_value = 6, bytes_value = 7. Пустое значение (без поля) дает пустое
// сообщение.
//
// Параметры:
//   Писатель - ОтелПротоПисатель - писатель protobuf
//   Значение - Соответствие - AnyValue в формате OTLP/JSON
//
Процедура КодироватьAnyValue(Писатель, Значение) Экспорт
    Если Значение.Получить("stringValue") <> Неопределено Тогда
        Писатель.ЗаписатьТег(1, ВайрLen);
        Писатель.ЗаписатьСтроку(Значение.Получить("stringValue"));
    ИначеЕсли Значение.Получить("boolValue") <> Неопределено Тогда
        Писатель.ЗаписатьТег(2, ВайрVarint);
        Писатель.ЗаписатьUInt64Varint(?(Значение.Получить("boolValue"), 1, 0));
    ИначеЕсли Значение.Получить("intValue") <> Неопределено Тогда
        Писатель.ЗаписатьТег(3, ВайрVarint);
        Писатель.ЗаписатьInt64Varint(ЦелоеПоле(Значение, "intValue"));
    ИначеЕсли Значение.Получить("doubleValue") <> Неопределено Тогда
        Писатель.ЗаписатьТег(4, ВайрFixed64);
        Писатель.ЗаписатьDouble(Значение.Получить("doubleValue"));
    ИначеЕсли Значение.Получить("arrayValue") <> Неопределено Тогда
        КодироватьСписок(Писатель, 5, Значение.Получить("arrayValue"), Ложь);
    ИначеЕсли Значение.Получить("kvlistValue") <> Неопределено Тогда
        КодироватьСписок(Писатель, 6, Значение.Получить("kvlistValue"), Истина);
    Иначе
        // Без bytesValue - пустое значение, поле не записывается
        Байты = Значение.Получить("bytesValue");
        Если Байты <> Неопределено Тогда
            Писатель.ЗаписатьТег(7, ВайрLen);
            Писатель.ЗаписатьLengthDelimited(ДвоичныеДанныеБайтов(Байты));
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Кодирует ArrayValue или KeyValueList: повторяющееся поле 1 с элементами AnyValue или KeyValue.
//
// Параметры:
//   Писатель - ОтелПротоПисатель - писатель protobuf
//   НомерПоля - Число - номер поля AnyValue (5 - array_value, 6 - kvlist_value)
//   Список - Соответствие - {"values": Массив}
//   ЭтоПары - Булево - элементы KeyValue (иначе AnyValue)
//
Процедура КодироватьСписок(Писатель, НомерПоля, Список, ЭтоПары)
    ПисательСписка = Новый ОтелПротоПисатель();
    Элементы = Список.Получить("values");
    Если Элементы <> Неопределено Тогда
        Для Каждого Элемент Из Элементы Цикл
            ПисательЭлемента = Новый ОтелПротоПисатель();
            Если ЭтоПары Тогда
                КодироватьKeyValue(ПисательЭлемента, Элемент);
            Иначе
                КодироватьAnyValue(ПисательЭлемента, Элемент);
            КонецЕсли;
            ЗаписатьВложенное(ПисательСписка, 1, ПисательЭлемента);
        КонецЦикла;
    КонецЕсли;
    ЗаписатьВложенное(Писатель, НомерПоля, ПисательСписка);
КонецПроцедуры

Процедура ЗаписатьВложенное(Писатель, НомерПоля, ПисательВложенного)
    Писатель.ЗаписатьТег(НомерПоля, ВайрLen);
    Писатель.ЗаписатьLengthDelimited(ПисательВложенного.ПолучитьДвоичныеДанные());
КонецПроцедуры

// Возвращает целое значение поля: int64 в OTLP/JSON может быть строкой.
//
// Параметры:
//   Данные - Соответствие - AnyValue
//   Ключ - Строка - имя поля
//
// Возвращаемое значение:
//   Число
//
Функция ЦелоеПоле(Данные, Ключ)
    Значение = Данные.Получить(Ключ);
    Если ТипЗнч(Значение) = Тип("Строка") Тогда
        Возврат Новый ОписаниеТипов("Число").ПривестиЗначение(Значение);
    КонецЕсли;
    Возврат Значение;
КонецФункции

// Возвращает двоичные данные bytes_value: в OTLP/JSON они записаны строкой base64.
//
// Параметры:
//   Значение - Строка, ДвоичныеДанные - значение поля bytesValue
//
// Возвращаемое значение:
//   ДвоичныеДанные
//
Функция ДвоичныеДанныеБайтов(Значение)
    Если ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
        Возврат Значение;
    КонецЕсли;
    Возврат Base64Значение(Строка(Значение));
КонецФункции

#КонецОбласти

ВайрVarint = 0;
ВайрFixed64 = 1;
ВайрLen = 2;
