#Использовать async
#Использовать logos

#Область ОписаниеПеременных

// Произвольный - экспортер данных
Перем Экспортер;
// Массив - буфер накопленных элементов
Перем Буфер;
// БлокировкаРесурса - блокировка для потокобезопасного доступа к буферу
Перем Блокировка;
// БлокировкаРесурса - блокировка для синхронизации вызовов Export (запрет конкурентных вызовов)
Перем БлокировкаЭкспорта;

// Число - максимальный размер буфера
Перем МаксРазмерБуфера;
// Число - максимальный размер пакета для экспорта
Перем МаксРазмерПакета;
// Число - интервал периодического экспорта в миллисекундах
Перем ИнтервалЭкспортаМс;
// Число - таймаут экспорта в миллисекундах (по спеке OTEL_BSP_EXPORT_TIMEOUT)
Перем ТаймаутЭкспортаМс;
// АтомарноеБулево - признак завершения работы процессора (потокобезопасный)
Перем Закрыт;
// Обещание - обещание фонового периодического экспорта
Перем Обещание;
// Объект - логгер библиотеки logos
Перем Лог;
// Число - количество отброшенных элементов при переполнении буфера
Перем КоличествоОтброшенных;
// Строка - название сигнала для сообщений (например "спанов" или "логов")
Перем ИмяСигнала;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Обрабатывает элемент - добавляет в буфер.
// При достижении максимального размера пакета инициирует экспорт.
//
// Параметры:
//   Элемент - Произвольный - элемент для обработки (спан или запись лога)
//
Процедура Обработать(Элемент) Экспорт
    Если Закрыт.Получить() Тогда
        Возврат;
    КонецЕсли;

    Блокировка.Заблокировать();
    Попытка
        Если Буфер.Количество() < МаксРазмерБуфера Тогда
            Буфер.Добавить(Элемент);
        Иначе
            КоличествоОтброшенных = КоличествоОтброшенных + 1;
        КонецЕсли;
        НуженЭкспорт = Буфер.Количество() >= МаксРазмерПакета;
        Блокировка.Разблокировать();
    Исключение
        Блокировка.Разблокировать();
        Возврат;
    КонецПопытки;

    Если НуженЭкспорт Тогда
        ЭкспортироватьПакет();
    КонецЕсли;
КонецПроцедуры

// Принудительно отправляет все накопленные элементы.
//
// Параметры:
//   ТаймаутМс - Число - таймаут в миллисекундах (0 - без ограничения)
//
// Возвращаемое значение:
//   ОтелРезультатЭкспорта - результат операции (ошибка/таймаут отражают исход экспорта)
//
Функция СброситьБуфер(ТаймаутМс = 0) Экспорт
    Возврат ЭкспортироватьВсеПакеты(ТаймаутМс);
КонецФункции

// Завершает работу процессора и возвращает результат. Shutdown включает эффект ForceFlush:
// после остановки фонового экспорта оставшиеся элементы экспортируются, затем экспортер
// закрывается. Все три шага укладываются в один общий срок; экспортер закрывается и после
// сбоя или таймаута финального экспорта.
//
// Параметры:
//   ТаймаутМс - Число - таймаут операции в миллисекундах (0 - без ограничения)
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия - результат закрытия: ошибка финального экспорта или закрытия
//       экспортера; иначе таймаут, если истек срок; иначе успех
//
Функция Закрыть(ТаймаутМс = 30000) Экспорт // BSLLS:MagicNumber-off
    // Проверка и установка флага одной атомарной операцией: при конкурентных вызовах
    // финальный экспорт и закрытие экспортера выполняет только один из них
    Если НЕ Закрыт.СравнитьИУстановить(Ложь, Истина) Тогда
        Возврат ОтелРезультатыЗакрытия.Ошибка("Процессор закрыт");
    КонецЕсли;
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Результаты = Новый Массив();
    Попытка
        ОстановитьФоновыйЭкспорт(ОтелРезультатыЗакрытия.ОставшеесяВремя(НачалоМс, ТаймаутМс));
        РезультатЭкспорта = ЭкспортироватьВсеПакеты(ОтелРезультатыЗакрытия.ОставшеесяВремя(НачалоМс, ТаймаутМс));
        Результаты.Добавить(РезультатФинальногоЭкспорта(РезультатЭкспорта));
    Исключение
        Результаты.Добавить(ОтелРезультатыЗакрытия.Ошибка(ОписаниеОшибки()));
    КонецПопытки;
    Если Экспортер <> Неопределено Тогда
        Результаты.Добавить(ОтелРезультатыЗакрытия.ВызватьВПределахСрока(Экспортер, "Закрыть", НачалоМс, ТаймаутМс));
    КонецЕсли;
    Возврат ОтелРезультатыЗакрытия.Свести(Результаты, ОтелРезультатыЗакрытия.СрокИстек(НачалоМс, ТаймаутМс));
КонецФункции

// Принудительно выгружает накопленные элементы и возвращает результат.
//
// Параметры:
//   ТаймаутМс - Число - таймаут операции в миллисекундах
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия - результат операции
//
Функция ПринудительноВыгрузитьСРезультатом(ТаймаутМс = 30000) Экспорт // BSLLS:MagicNumber-off
    Если Закрыт.Получить() Тогда
        Возврат ОтелРезультатыЗакрытия.Ошибка("Процессор закрыт");
    КонецЕсли;
    Попытка
        Результат = СброситьБуфер(ТаймаутМс);
    Исключение
        Возврат ОтелРезультатыЗакрытия.Ошибка(ОписаниеОшибки());
    КонецПопытки;
    Если ТипЗнч(Результат) = Тип("ОтелРезультатЭкспорта") И Результат.ИстекТаймаут() Тогда
        Возврат ОтелРезультатыЗакрытия.Таймаут();
    КонецЕсли;
    Если ТипЗнч(Результат) = Тип("ОтелРезультатЭкспорта") И НЕ Результат.Успешно() Тогда
        Возврат ОтелРезультатыЗакрытия.Ошибка("Сбой выгрузки буфера");
    КонецЕсли;
    Возврат ОтелРезультатыЗакрытия.Успех();
КонецФункции

// Возвращает количество отброшенных элементов при переполнении буфера.
//
// Возвращаемое значение:
//   Число - количество отброшенных элементов
//
Функция КоличествоОтброшенных() Экспорт
    Возврат КоличествоОтброшенных;
КонецФункции

// Запускает фоновый периодический экспорт.
//
Процедура ЗапуститьФоновыйЭкспорт() Экспорт
    Если Обещание <> Неопределено Тогда
        Возврат;
    КонецЕсли;

    Делегат = Новый Действие(ЭтотОбъект, "ПериодическийЭкспорт");
    Обещание = Обещания.ВыполнитьДелегат(Делегат, Новый Массив, Истина);
КонецПроцедуры

// Метод фонового задания: периодически экспортирует буфер.
// Не вызывать напрямую - используется ФоновымиЗаданиями.
//
Процедура ПериодическийЭкспорт() Экспорт
    Пока ДождатьсяИнтервалаЭкспорта() Цикл
        ЭкспортироватьПакет(ТаймаутЭкспортаМс);
    КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Экспортирует пакеты, пока буфер не опустеет. Каждый пакет извлекается под блокировкой
// экспорта, поэтому возврат означает и завершение пакетов, которые конкурентный экспорт
// извлек из буфера раньше.
//
// Параметры:
//   ТаймаутМс - Число - таймаут в миллисекундах; 0 - без ограничения
//
// Возвращаемое значение:
//   ОтелРезультатЭкспорта - ошибка, если не удался хотя бы один пакет; таймаут при истечении срока
//
Функция ЭкспортироватьВсеПакеты(ТаймаутМс = 0)
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    ИтоговыйРезультат = ОтелРезультатыЭкспорта.Успех();
    Пока Истина Цикл
        ПрошлоМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
        Если ТаймаутМс > 0 И ПрошлоМс >= ТаймаутМс Тогда
            Лог.Предупреждение("Таймаут при экспорте %1", ИмяСигнала);
            Возврат ОтелРезультатыЭкспорта.Таймаут();
        КонецЕсли;
        ОставшийсяТаймаутМс = ?(ТаймаутМс > 0, ТаймаутМс - ПрошлоМс, 0);
        Извлечено = 0;
        РезультатПакета = ЭкспортироватьПакет(ОставшийсяТаймаутМс, Извлечено);
        Если РезультатПакета.ИстекТаймаут() Тогда
            Возврат РезультатПакета;
        КонецЕсли;
        Если НЕ РезультатПакета.Успешно() Тогда
            ИтоговыйРезультат = РезультатПакета;
        КонецЕсли;
        Если Извлечено = 0 Тогда
            Возврат ИтоговыйРезультат;
        КонецЕсли;
    КонецЦикла;
КонецФункции

// Извлекает из буфера пакет и экспортирует его. Извлечение и вызов Export идут под одной
// блокировкой экспорта: вызовы Export не конкурируют (требование OTel spec), а ожидающий
// блокировку сброс или закрытие дожидается пакета, извлеченного другим потоком.
//
// Параметры:
//   ТаймаутМс - Число - таймаут в мс, включая ожидание блокировки; 0 - без ограничения
//   Извлечено - Число - выходной: количество извлеченных элементов
//
// Возвращаемое значение:
//   ОтелРезультатЭкспорта - результат экспорта пакета; ошибка, если экспортер вернул Ложь
//
Функция ЭкспортироватьПакет(ТаймаутМс = 0, Извлечено = 0)
    Извлечено = 0;
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    БлокировкаЭкспорта.Заблокировать();
    Попытка
        ПрошлоМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
        Если ТаймаутМс > 0 И ПрошлоМс >= ТаймаутМс Тогда
            // Срок истек, пока ждали конкурентный экспорт: пакет остается в буфере
            БлокировкаЭкспорта.Разблокировать();
            Лог.Предупреждение("Таймаут при экспорте %1", ИмяСигнала);
            Возврат ОтелРезультатыЭкспорта.Таймаут();
        КонецЕсли;
        Результат = ЭкспортироватьИзвлеченныйПакет(?(ТаймаутМс > 0, ТаймаутМс - ПрошлоМс, 0), Извлечено);
        БлокировкаЭкспорта.Разблокировать();
    Исключение
        БлокировкаЭкспорта.Разблокировать();
        Лог.Предупреждение("Ошибка экспорта %1: %2", ИмяСигнала, ОписаниеОшибки());
        Возврат ОтелРезультатыЭкспорта.Ошибка();
    КонецПопытки;
    Возврат Результат;
КонецФункции

// Извлекает пакет и вызывает Export. Вызывается под блокировкой экспорта.
//
// Параметры:
//   ТаймаутМс - Число - таймаут вызова Export в мс; 0 - без ограничения
//   Извлечено - Число - выходной: количество извлеченных элементов
//
// Возвращаемое значение:
//   ОтелРезультатЭкспорта
//
Функция ЭкспортироватьИзвлеченныйПакет(ТаймаутМс, Извлечено)
    ЭлементыДляЭкспорта = ИзвлечьЭлементыИзБуфера();
    Если ЭлементыДляЭкспорта = Неопределено ИЛИ ЭлементыДляЭкспорта.Количество() = 0 Тогда
        Возврат ОтелРезультатыЭкспорта.Успех();
    КонецЕсли;
    Извлечено = ЭлементыДляЭкспорта.Количество();
    Если Экспортер = Неопределено Тогда
        Возврат ОтелРезультатыЭкспорта.Успех();
    КонецЕсли;
    ТаймаутЭкспорта = ?(ТаймаутМс > 0, ТаймаутМс, Неопределено);
    РезультатЭкспортера = Экспортер.Экспортировать(ЭлементыДляЭкспорта, ТаймаутЭкспорта);
    Экспортер.СброситьБуфер();
    Если ЭкспортНеУдался(РезультатЭкспортера) Тогда
        Лог.Предупреждение("Экспортер не смог экспортировать %1: %2", ИмяСигнала, Извлечено);
        Возврат ОтелРезультатыЭкспорта.Ошибка();
    КонецЕсли;
    Возврат ОтелРезультатыЭкспорта.Успех();
КонецФункции

// Экспортер сообщает о неудаче результатом Ложь или неуспешным ОтелРезультатЭкспорта.
// Неопределено (экспортер без результата) считается успехом.
//
// Параметры:
//   Результат - Булево, ОтелРезультатЭкспорта, Неопределено - результат Экспортировать
//
// Возвращаемое значение:
//   Булево
//
Функция ЭкспортНеУдался(Результат)
    Если Результат = Ложь Тогда
        Возврат Истина;
    КонецЕсли;
    Возврат ТипЗнч(Результат) = Тип("ОтелРезультатЭкспорта") И НЕ Результат.Успешно();
КонецФункции

Функция ИзвлечьЭлементыИзБуфера()
    Блокировка.Заблокировать();
    Попытка
        Если Буфер.Количество() = 0 Тогда
            Блокировка.Разблокировать();
            Возврат Неопределено;
        КонецЕсли;

        ЭлементыДляЭкспорта = Новый Массив();
        Количество = Буфер.Количество();
        Если Количество > МаксРазмерПакета Тогда
            Количество = МаксРазмерПакета;
        КонецЕсли;

        Для Инд = 0 По Количество - 1 Цикл
            ЭлементыДляЭкспорта.Добавить(Буфер[Инд]);
        КонецЦикла;

        НовыйБуфер = Новый Массив();
        Для Инд = Количество По Буфер.Количество() - 1 Цикл
            НовыйБуфер.Добавить(Буфер[Инд]);
        КонецЦикла;
        Буфер = НовыйБуфер;

        Блокировка.Разблокировать();
    Исключение
        Блокировка.Разблокировать();
        Возврат Неопределено;
    КонецПопытки;

    Возврат ЭлементыДляЭкспорта;
КонецФункции

Процедура ОстановитьФоновыйЭкспорт(ТаймаутМс)
    Если Обещание <> Неопределено Тогда
        Попытка
            Обещание.Получить(ТаймаутМс);
        Исключение
            Лог.Отладка("Таймаут ожидания фонового экспорта %1: %2", ИмяСигнала, ОписаниеОшибки());
        КонецПопытки;
        Обещание = Неопределено;
    КонецЕсли;
КонецПроцедуры

// Ждет интервал экспорта короткими паузами, чтобы закрытие процессора не ждало весь интервал.
//
// Возвращаемое значение:
//   Булево - Истина, если интервал истек; Ложь, если процессор закрыт
//
Функция ДождатьсяИнтервалаЭкспорта()
    ШагОжиданияМс = 50;
    ОкончаниеМс = ТекущаяУниверсальнаяДатаВМиллисекундах() + ИнтервалЭкспортаМс;
    Пока НЕ Закрыт.Получить() Цикл
        ОсталосьМс = ОкончаниеМс - ТекущаяУниверсальнаяДатаВМиллисекундах();
        Если ОсталосьМс <= 0 Тогда
            Возврат Истина;
        КонецЕсли;
        Приостановить(Мин(ОсталосьМс, ШагОжиданияМс));
    КонецЦикла;
    Возврат Ложь;
КонецФункции

// Приводит результат финального экспорта к результату закрытия.
//
// Параметры:
//   РезультатЭкспорта - ОтелРезультатЭкспорта - результат ЭкспортироватьВсеПакеты
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия
//
Функция РезультатФинальногоЭкспорта(РезультатЭкспорта)
    Если РезультатЭкспорта.ИстекТаймаут() Тогда
        Возврат ОтелРезультатыЗакрытия.Таймаут();
    КонецЕсли;
    Если НЕ РезультатЭкспорта.Успешно() Тогда
        Возврат ОтелРезультатыЗакрытия.Ошибка("Сбой финального экспорта");
    КонецЕсли;
    Возврат ОтелРезультатыЗакрытия.Успех();
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура УстановитьИмяСигнала(Значение)
    ИмяСигнала = Значение;
КонецПроцедуры

Процедура УстановитьИнтервалЭкспортаМс(Значение)
    ИнтервалЭкспортаМс = Значение;
КонецПроцедуры

Процедура УстановитьМаксРазмерБуфера(Значение)
    МаксРазмерБуфера = Значение;
КонецПроцедуры

Процедура УстановитьМаксРазмерПакета(Значение)
    МаксРазмерПакета = Значение;
КонецПроцедуры

Процедура УстановитьТаймаутЭкспортаМс(Значение)
    ТаймаутЭкспортаМс = Значение;
КонецПроцедуры

Процедура УстановитьЭкспортер(Значение)
    Экспортер = Значение;
КонецПроцедуры

// Базовый пакетный процессор (BatchProcessor).
// Содержит всю логику буферизации и фонового экспорта.
//
// Параметры:
//   Экспортер - Произвольный - экспортер данных
//   ИмяСигнала - Строка - название сигнала для логирования
//   МаксРазмерБуфера - Число - максимальный размер очереди
//   МаксРазмерПакета - Число - максимальный размер пакета
//   ИнтервалЭкспортаМс - Число - интервал экспорта в мс
//   ТаймаутЭкспортаМс - Число - таймаут экспорта в мс (по умолчанию 30000)
//
// BSLLS:MagicNumber-off
// BSLLS:NumberOfOptionalParams-off
Процедура ПриСозданииОбъекта(Экспортер, // BSLLS:NumberOfParams-off
        ИмяСигнала,
        МаксРазмерБуфера = 2048,
        МаксРазмерПакета = 512,
        ИнтервалЭкспортаМс = 5000,
        ТаймаутЭкспортаМс = 30000)
// BSLLS:MagicNumber-on
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry." + ИмяСигнала);
    УстановитьИмяСигнала(ИмяСигнала);
    УстановитьЭкспортер(Экспортер);
    УстановитьМаксРазмерБуфера(МаксРазмерБуфера);
    УстановитьМаксРазмерПакета(МаксРазмерПакета);
    УстановитьИнтервалЭкспортаМс(ИнтервалЭкспортаМс);
    УстановитьТаймаутЭкспортаМс(ТаймаутЭкспортаМс);
    Буфер = Новый Массив();
    Блокировка = Новый БлокировкаРесурса();
    БлокировкаЭкспорта = Новый БлокировкаРесурса();
    Закрыт = Новый АтомарноеБулево(Ложь);
    Обещание = Неопределено;
    КоличествоОтброшенных = 0;
КонецПроцедуры

#КонецОбласти
