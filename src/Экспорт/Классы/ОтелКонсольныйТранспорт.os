#Область ОписаниеПеременных

// Булево - признак закрытия транспорта
Перем Закрыт;
// БлокировкаРесурса - вывод одной отправки не перемежается с выводом других потоков
Перем Блокировка;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Выводит данные одной строкой OTLP JSON в стандартный вывод. Вывод не ждет сети, поэтому срок
// не используется.
//
// Параметры:
//   Путь - Строка - путь сигнала (например, "/v1/traces"); в вывод не попадает
//   Данные - Соответствие - данные в формате OTLP JSON
//   ТаймаутМс - Число - срок отправки в миллисекундах; 0 - без ограничения (необязательный)
//
// Возвращаемое значение:
//   Булево - Истина, если транспорт не закрыт
//
Функция Отправить(Путь, Данные, ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Текст = ЗаписьJSON.Закрыть();

	Блокировка.Заблокировать();
	Попытка
		Если Закрыт Тогда
			Блокировка.Разблокировать();
			Возврат Ложь;
		КонецЕсли;
		Сообщить(Текст);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Возврат Истина;
КонецФункции

// Завершает работу транспорта: следующие отправки ничего не выводят.
//
Процедура Закрыть() Экспорт
	Блокировка.Заблокировать();
	Закрыт = Истина;
	Блокировка.Разблокировать();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Консольный транспорт экспортеров OTLP (экспортер console): каждая отправка - одна строка OTLP JSON в
// стандартном выводе. Реализует тот же интерфейс Отправить(Путь, Данные, ТаймаутМс), что и
// ОтелHttpТранспорт и ОтелGrpcТранспорт.
//
// Конструктор.
//
Процедура ПриСозданииОбъекта()
	Закрыт = Ложь;
	Блокировка = Новый БлокировкаРесурса();
КонецПроцедуры

#КонецОбласти
