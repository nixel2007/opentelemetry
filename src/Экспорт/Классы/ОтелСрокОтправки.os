#Область ОписаниеПеременных

// Число - начало отсчета срока (ТекущаяУниверсальнаяДатаВМиллисекундах)
Перем НачалоМс;
// Число - срок в миллисекундах от начала отсчета; 0 - без ограничения
Перем ТаймаутМс;
// Число - число начатых попыток отправки
Перем Попыток;
// Строка - описание ошибки последней попытки; пусто, если ошибок не было
Перем ПоследняяОшибка;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Выбрасывает исключение, если срок истек. Этот метод СтратегияПовтора из resilience вызывает
// у сигнала прерывания перед каждой попыткой, после ошибки и во время паузы между попытками.
// Текст исключения говорит, истек ли срок до первой попытки или после попыток, и называет
// ошибку последней попытки.
//
Процедура ПроверитьПрерывание() Экспорт
    Если НЕ ОтелРезультатыЗакрытия.СрокИстек(НачалоМс, ТаймаутМс) Тогда
        Возврат;
    КонецЕсли;
    ПрошлоМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
    Если Попыток = 0 Тогда
        ВызватьИсключение СтрШаблон("Истек срок отправки %1 мс до первой попытки: подготовка запроса заняла %2 мс",
            ТаймаутМс, ПрошлоМс);
    КонецЕсли;
    Текст = СтрШаблон("Истек срок отправки %1 мс после попыток: %2, прошло %3 мс", ТаймаутМс, Попыток, ПрошлоМс);
    Если ПоследняяОшибка <> "" Тогда
        Текст = Текст + ", последняя ошибка: " + ПоследняяОшибка;
    КонецЕсли;
    ВызватьИсключение Текст;
КонецПроцедуры

// Отмечает начало очередной попытки отправки.
//
Процедура НачатьПопытку() Экспорт
    Попыток = Попыток + 1;
КонецПроцедуры

// Запоминает ошибку попытки отправки для текста исключения об истечении срока.
//
// Параметры:
//   Описание - Строка - краткое описание ошибки попытки
//
Процедура ЗапомнитьОшибкуПопытки(Описание) Экспорт
    ПоследняяОшибка = Описание;
КонецПроцедуры

// Возвращает время, оставшееся до срока.
//
// Возвращаемое значение:
//   Число - оставшееся время в мс, не меньше 1; 0, если срок не ограничен
//
Функция ОсталосьВремени() Экспорт
    Возврат ОтелРезультатыЗакрытия.ОставшеесяВремя(НачалоМс, ТаймаутМс);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Срок отправки OTLP - сигнал прерывания для СтратегияПовтора из resilience, который срабатывает
// по времени: после срока новая попытка не начинается, а пауза между попытками прерывается.
// Стратегия вызывает у сигнала только ПроверитьПрерывание. Когда у СигналПрерыванияОперации
// в resilience появится срок, класс заменяется им.
//
// Конструктор срока отправки.
//
// Параметры:
//   Таймаут - Число - срок в миллисекундах от текущего момента; 0 - без ограничения
//
Процедура ПриСозданииОбъекта(Таймаут)
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    ТаймаутМс = Таймаут;
    Попыток = 0;
    ПоследняяОшибка = "";
КонецПроцедуры

#КонецОбласти
