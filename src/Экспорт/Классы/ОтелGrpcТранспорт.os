// BSLLS:MissingSpace-off
#Использовать oint/api/grpc
// BSLLS:MissingSpace-on
#Использовать logos
#Использовать resilience

#Область ОписаниеПеременных

// Объект - gRPC-соединение с коллектором
Перем Соединение;
// Объект - логгер модуля
Перем Лог;
// Соответствие - маршруты OTLP-путей к именам gRPC-сервисов и методов
Перем ПутиСервисов;
// Число - таймаут вызова gRPC в миллисекундах
Перем Таймаут;
// ОтелКонвертерOtlpВProto - конвертер OTLP JSON в protobuf
Перем Конвертер;
// СтратегияПовтора - стратегия повторных попыток с экспоненциальной задержкой и jitter
Перем Повтор;
// ОтелНастройкиTls - настройки TLS для защищенных соединений
Перем НастройкиTlsТранспорта;
// Соответствие - метаданные gRPC, отправляемые с каждым вызовом
Перем МетаданныеТранспорта;
// Строка - адрес OTLP-коллектора со схемой http:// или https://
Перем АдресКоллектора;
// Строка - каталог с OTLP .proto файлами
Перем КаталогProtoФайлов;
// БлокировкаРесурса - защищает открытие соединения от параллельных отправок
Перем БлокировкаСоединения;
// Булево - транспорт закрыт, соединение больше не открывается
Перем Закрыт;
// Число - максимальный размер запроса в байтах до сжатия (Max Request Size)
Перем МаксРазмерЗапросаБайт;
// Соответствие - коды статуса gRPC в верхнем регистре без "_" и их повторяемость (Булево)
Перем КодыСтатуса;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает настройки TLS транспорта.
//
// Возвращаемое значение:
//   ОтелНастройкиTls, Неопределено - настройки TLS или Неопределено если не заданы
//
Функция ПолучитьНастройкиTls() Экспорт
    Возврат НастройкиTlsТранспорта;
КонецФункции

// Возвращает адрес коллектора, с которым соединяется транспорт.
//
// Возвращаемое значение:
//   Строка - адрес коллектора со схемой: https:// - соединение защищено TLS, http:// - без TLS
//
Функция Адрес() Экспорт
    Возврат АдресКоллектора;
КонецФункции

// Возвращает метаданные gRPC, отправляемые с каждым вызовом.
//
// Возвращаемое значение:
//   Соответствие - метаданные gRPC
//
Функция ПолучитьМетаданные() Экспорт
    Возврат МетаданныеТранспорта;
КонецФункции

// Возвращает максимальный размер запроса в байтах. Размер считается до сжатия,
// запрос больше лимита не отправляется. Лимит размера ответа задает клиент tonic внутри
// OPI_GRPC - 4 MiB, как по умолчанию в спецификации; настроить его нельзя
// (https://github.com/Bayselonarrend/OpenIntegrations/issues/113).
//
// Возвращаемое значение:
//   Число - по умолчанию 67108864 (64 MiB); 0 - без ограничения
//
Функция МаксРазмерЗапроса() Экспорт
    Возврат МаксРазмерЗапросаБайт;
КонецФункции

// Устанавливает максимальный размер запроса в байтах (до сжатия).
//
// Параметры:
//   Значение - Число - максимальный размер запроса в байтах; 0 - без ограничения
//
// Возвращаемое значение:
//   ОтелGrpcТранспорт - этот транспорт
//
Функция УстановитьМаксРазмерЗапроса(Значение) Экспорт
    МаксРазмерЗапросаБайт = Значение;
    Возврат ЭтотОбъект;
КонецФункции

// Отправляет данные на указанный путь OTLP-адреса.
// Данные передаются в формате OTLP JSON (camelCase ключи),
// транспорт автоматически конвертирует их в формат protobuf (snake_case ключи).
// Если соединение не открыто (коллектор был недоступен), оно открывается заново.
//
// Попытки и паузы между ними укладываются в срок: таймаут вызова не больше времени до срока,
// после срока новая попытка не начинается, а пауза прерывается.
//
// Ограничение OPI_GRPC: открытие соединения и переподключение внутри вызова сроком не ограничены,
// таймаута подключения у компоненты нет (https://github.com/Bayselonarrend/OpenIntegrations/issues/114).
// Сервер, который принял TCP-соединение и молчит при TLS-рукопожатии, держит отправку, пока не закроет
// соединение, а адрес, не отвечающий на TCP-подключение, - до системного таймаута подключения. До
// исправления в OPI_GRPC экспорт по gRPC не полностью выполняет требование спецификации
// Export MUST NOT block indefinitely.
//
// Параметры:
//   Путь - Строка - путь адреса (например, "/v1/traces")
//   Данные - Соответствие - данные для отправки в формате OTLP JSON
//   ТаймаутМс - Число - срок отправки в миллисекундах; 0 - без ограничения (необязательный)
//
// Возвращаемое значение:
//   Булево - Истина, если отправка успешна
//
Функция Отправить(Путь, Данные, ТаймаутМс = 0) Экспорт
    ПрефиксЛога = "OTLP gRPC ";
    Срок = Новый ОтелСрокОтправки(ТаймаутМс);
    Попытка
        НастройкиСервиса = ПутиСервисов.Получить(Путь);
        Если НастройкиСервиса = Неопределено Тогда
            Лог.Ошибка("OTLP gRPC: неизвестный путь " + Путь);
            Возврат Ложь;
        КонецЕсли;

        Если Закрыт Тогда
            Лог.Ошибка("OTLP gRPC: транспорт закрыт");
            Возврат Ложь;
        КонецЕсли;

        Если ЗапросПревышаетМаксимальныйРазмер(Путь, Данные) Тогда
            Возврат Ложь;
        КонецЕсли;

        ДанныеProto = Конвертер.Конвертировать(Данные);

        ПараметрыОперации = Новый Массив();
        ПараметрыОперации.Добавить(Путь);
        ПараметрыОперации.Добавить(ДанныеProto);
        ПараметрыОперации.Добавить(Срок);

        Возврат Повтор.Применить(Новый Действие(ЭтотОбъект, "ВыполнитьОднуПопытку"), ПараметрыОперации, Срок);
    Исключение
        Лог.Ошибка(ПрефиксЛога + Путь + ": " + ОписаниеОшибки());
        Возврат Ложь;
    КонецПопытки;
КонецФункции

// Закрывает gRPC-соединение. После закрытия отправка не открывает соединение заново.
//
Процедура Закрыть() Экспорт
    БлокировкаСоединения.Заблокировать();
    БылЗакрыт = Закрыт;
    Закрыт = Истина;
    ЗакрываемоеСоединение = Соединение;
    Соединение = Неопределено;
    БлокировкаСоединения.Разблокировать();

    Если ЗакрываемоеСоединение <> Неопределено И OPI_GRPC.ЭтоКоннектор(ЗакрываемоеСоединение) Тогда
        Попытка
            OPI_GRPC.ЗакрытьСоединение(ЗакрываемоеСоединение);
        Исключение
            Лог.Предупреждение("OTLP gRPC: ошибка при закрытии соединения: " + ОписаниеОшибки());
        КонецПопытки;
    КонецЕсли;
    Если НЕ БылЗакрыт Тогда
        Лог.Отладка("OTLP gRPC: транспорт закрыт");
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Выполняет одну попытку gRPC-вызова, при необходимости открывая соединение. Таймаут вызова не
// больше времени до срока отправки. Открытие соединения и переподключение внутри вызова этим
// таймаутом не ограничены (см. Отправить).
// Бросает исключение при временной ошибке (см. ОшибкаПовторяемая) и при недоступности коллектора.
// Если сервер прислал RetryInfo (OTLP/gRPC Throttling), исключение несет retry_delay в параметре:
// по нему стратегия повтора ждет перед следующей попыткой (см. РассчитатьЗадержкуRetryInfo). Если
// retry_delay не меньше времени до срока, повтор в срок не уложится и попытка возвращает Ложь сразу.
//
// Параметры:
//   Путь - Строка - путь адреса
//   ДанныеProto - Произвольный - данные в формате protobuf
//   Срок - ОтелСрокОтправки - срок отправки
//
// Возвращаемое значение:
//   Булево - Истина при успешном ответе, Ложь при неповторяемой ошибке, закрытом транспорте или
//       RetryInfo после срока
//
Функция ВыполнитьОднуПопытку(Путь, ДанныеProto, Срок) Экспорт
    ТекущееСоединение = ПолучитьСоединение();
    Если ТекущееСоединение = Неопределено Тогда
        Лог.Ошибка("OTLP gRPC: транспорт закрыт");
        Возврат Ложь;
    КонецЕсли;

    НастройкиСервиса = ПутиСервисов.Получить(Путь);
    Сервис = НастройкиСервиса.Получить("service");
    Метод = НастройкиСервиса.Получить("method");

    ТаймаутВызова = ОтелРезультатыЗакрытия.МеньшийТаймаут(Таймаут, Срок.ОсталосьВремени());
    Результат = OPI_GRPC.ВызватьМетод(ТекущееСоединение, Сервис, Метод, ДанныеProto, ТаймаутВызова);

    Успешно = Результат["result"];
    Если Успешно Тогда
        Возврат Истина;
    КонецЕсли;

    ОшибкаТекст = "";
    Попытка
        ОшибкаТекст = Результат["error"];
    Исключение
        ОшибкаТекст = "неизвестная ошибка";
    КонецПопытки;

    Если НЕ ОшибкаПовторяемая(ОшибкаТекст) Тогда
        Лог.Предупреждение("OTLP gRPC " + Путь + ": " + ОшибкаТекст);
        Возврат Ложь;
    КонецЕсли;

    ЗадержкаМс = ЗадержкаRetryInfo(ОшибкаТекст);
    Если ЗадержкаМс = Неопределено Тогда
        ВызватьИсключение "gRPC: " + ОшибкаТекст;
    КонецЕсли;
    ОсталосьМс = Срок.ОсталосьВремени();
    Если ОсталосьМс > 0 И ЗадержкаМс >= ОсталосьМс Тогда
        Код = КодСтатусаGrpc(ОшибкаТекст);
        Лог.Ошибка("OTLP gRPC %1: %2, повтор не раньше чем через %3 мс (RetryInfo), а до срока отправки %4 мс",
            Путь, Код, ЗадержкаМс, ОсталосьМс);
        Возврат Ложь;
    КонецЕсли;
    ВызватьИсключение Новый ИнформацияОбОшибке("gRPC: " + ОшибкаТекст, ЗадержкаМс);
КонецФункции

// Определяет, является ли ошибка gRPC-вызова временной (OTLP/gRPC): повторяются коды
// CANCELLED, DEADLINE_EXCEEDED, ABORTED, OUT_OF_RANGE, UNAVAILABLE и DATA_LOSS, а
// RESOURCE_EXHAUSTED - только если сервер вернул RetryInfo (восстановление возможно, см. ЗадержкаRetryInfo).
// Код берется из текста ошибки: tonic (OPI_GRPC) пишет "status: DeadlineExceeded, message: ...",
// допускается и запись DEADLINE_EXCEEDED.
//
// Параметры:
//   ТекстОшибки - Строка - текст ошибки вызова
//
// Возвращаемое значение:
//   Булево - Истина, если вызов следует повторить
//
Функция ОшибкаПовторяемая(Знач ТекстОшибки) Экспорт
    Код = КодСтатусаGrpc(ТекстОшибки);
    Если Код = "RESOURCEEXHAUSTED" Тогда
        Возврат ЗадержкаRetryInfo(ТекстОшибки) <> Неопределено;
    КонецЕсли;
    Возврат КодыСтатуса.Получить(Код) = Истина;
КонецФункции

// Возвращает задержку повтора из RetryInfo в деталях статуса gRPC (OTLP/gRPC Throttling). tonic
// (OPI_GRPC) пишет детали статуса - сериализованный google.rpc.Status - в текст ошибки списком байтов:
// "details: [8, 14, 18, ...]". RetryInfo ищется среди деталей статуса (google.protobuf.Any) по type_url.
//
// Параметры:
//   ТекстОшибки - Строка - текст ошибки вызова
//
// Возвращаемое значение:
//   Число, Неопределено - retry_delay в миллисекундах (0, если задержка не задана); Неопределено, если
//       сервер не прислал RetryInfo
//
Функция ЗадержкаRetryInfo(Знач ТекстОшибки) Экспорт
    Попытка
        Байты = БайтыДеталейСтатуса(ТекстОшибки);
        Возврат ЗадержкаRetryInfoСтатуса(Байты);
    Исключение
        // Детали статуса не разбираются как google.rpc.Status: RetryInfo в них нет
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

// Callback для СтратегияПовтора: задержка перед повтором по RetryInfo (OTLP/gRPC Throttling). Первый
// повтор ждет retry_delay, каждый следующий - вдвое дольше: если повторы тоже не проходят, задержка
// растет экспоненциально от retry_delay, как рекомендует описание RetryInfo.
//
// Параметры:
//   КонтекстПовтора - КонтекстПопыткиПовтора - контекст попытки повтора
//
// Возвращаемое значение:
//   Число, Неопределено - задержка в мс или Неопределено, если сервер не прислал RetryInfo с задержкой
//       (действует экспоненциальная задержка стратегии)
//
Функция РассчитатьЗадержкуRetryInfo(КонтекстПовтора) Экспорт
    ДанныеОшибки = КонтекстПовтора.ДанныеОшибки();
    Если ДанныеОшибки = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    ЗадержкаМс = ДанныеОшибки.Параметры;
    Если ТипЗнч(ЗадержкаМс) <> Тип("Число") ИЛИ ЗадержкаМс <= 0 Тогда
        Возврат Неопределено;
    КонецЕсли;
    Множитель = 2;
    Возврат ЗадержкаМс * Pow(Множитель, КонтекстПовтора.НомерПопытки());
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьТаймаут(Значение)
    Таймаут = Значение;
КонецПроцедуры

// Класс gRPC-транспорта для отправки телеметрии по протоколу OTLP.
//
// Обеспечивает отправку данных через gRPC
// на адресы OTLP-совместимых коллекторов (Grafana LGTM, OpenTelemetry Collector и т.д.).
// Использует библиотеку oint (OPI_GRPC) для gRPC-вызовов. Сжатие сообщений клиент OPI_GRPC
// не поддерживает (https://github.com/Bayselonarrend/OpenIntegrations/issues/112), данные
// отправляются без сжатия.
// Реализует тот же интерфейс Отправить(Путь, Данные, ТаймаутМс), что и ОтелHttpТранспорт,
// поэтому все существующие экспортеры (спаны, логи, метрики) работают с обоими транспортами.
//
// Конструктор gRPC-транспорта. Конструктор открывает соединение с коллектором; если коллектор
// недоступен, соединение откроется при отправке. Открытие соединения сроком не ограничено (см.
// Отправить): с сервером, который принял TCP-соединение и молчит при TLS-рукопожатии, конструктор
// ждет, пока сервер не закроет соединение.
//
// Параметры:
//   Адрес - Строка - адрес OTLP-коллектора (например, "http://localhost:4317"). Схема https -
//                    соединение защищено TLS, http - без TLS; адрес без схемы защищен TLS,
//                    если в настройках TLS не включен Insecure
//   НастройкиTls - ОтелНастройкиTls - настройки TLS (необязательный)
//   Метаданные - Соответствие - метаданные gRPC (необязательный)
//   КаталогProto - Строка - каталог с OTLP .proto файлами (необязательный, по умолчанию proto/ рядом с библиотекой)
//   Таймаут - Число - таймаут вызова в миллисекундах (необязательный, по умолчанию 10000)
//   НовыйМаксПопыток - Число - максимальное количество попыток отправки (необязательный, по умолчанию 3)
//
// BSLLS:NumberOfOptionalParams-off
// BSLLS:MagicNumber-off
Процедура ПриСозданииОбъекта(
        Адрес,
        НастройкиTls = Неопределено,
        Метаданные = Неопределено,
        КаталогProto = "",
        Таймаут = 10000,
        НовыйМаксПопыток = 3)
// BSLLS:MagicNumber-on
// BSLLS:NumberOfOptionalParams-on
    УстановитьТаймаут(Таймаут);
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.grpc");
    Конвертер = Новый ОтелКонвертерOtlpВProto();
    НастройкиTlsТранспорта = НастройкиTls;
    БлокировкаСоединения = Новый БлокировкаРесурса();
    Закрыт = Ложь;
    МаксРазмерЗапросаБайт = 67108864;

    БазоваяЗадержкаМс = 1000;
    Повтор = Новый СтратегияПовтора(НовыйМаксПопыток - 1, БазоваяЗадержкаМс)
        .УстановитьТипЗадержки(ТипыРасчетаЗадержки.Экспоненциальная)
        .ИспользоватьРазбросЗадержки(Истина)
        .УстановитьВычислениеЗадержки(Новый Действие(ЭтотОбъект, "РассчитатьЗадержкуRetryInfo"));

    Если КаталогProto = "" Тогда
        КаталогProto = ОпределитьКаталогProto();
    КонецЕсли;
    АдресКоллектора = АдресСоСхемой(Адрес, НастройкиTls);
    КаталогProtoФайлов = КаталогProto;

    ИнициализироватьПутиСервисов();
    ИнициализироватьКодыСтатуса();
    МетаданныеТранспорта = СформироватьМетаданные(Метаданные);
    ПроверитьНастройкиTls(НастройкиTls);

    ОшибкаСоединения = ОткрытьСоединение();
    Если ОшибкаСоединения <> "" Тогда
        Лог.Ошибка("OTLP gRPC: не удалось открыть соединение: %1. Соединение будет открыто при отправке",
            ОшибкаСоединения);
    КонецЕсли;
КонецПроцедуры

// Формирует метаданные вызова: пользовательский user-agent - идентификатор продукта
// перед стандартным user-agent экспортера. До сервера user-agent из метаданных пока не доходит:
// клиент tonic в OPI_GRPC ставит свой (tonic/0.13.1), а User-Agent канала OPI_GRPC задать не дает
// (https://github.com/Bayselonarrend/OpenIntegrations/issues/111).
//
// Параметры:
//   ИсходныеМетаданные - Соответствие, Неопределено - пользовательские метаданные
//
// Возвращаемое значение:
//   Соответствие - метаданные gRPC
//
Функция СформироватьМетаданные(ИсходныеМетаданные)
    Результат = Новый Соответствие();
    ИдентификаторПродукта = "";
    Если ИсходныеМетаданные <> Неопределено Тогда
        Для Каждого Элемент Из ИсходныеМетаданные Цикл
            Если НРег(Элемент.Ключ) = "user-agent" Тогда
                ИдентификаторПродукта = Элемент.Значение;
            Иначе
                Результат.Вставить(Элемент.Ключ, Элемент.Значение);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Результат.Вставить("user-agent", ОтелУтилиты.UserAgentЭкспортераOtlp(ИдентификаторПродукта));
    Возврат Результат;
КонецФункции

// Открывает соединение с коллектором. Исключение компоненты OPI_GRPC возвращается
// как текст ошибки: создание транспорта и отправка не выбрасывают исключений.
// Таймаута подключения у OPI_GRPC нет (https://github.com/Bayselonarrend/OpenIntegrations/issues/114):
// открытие соединения сроком не ограничено (см. Отправить).
//
// Возвращаемое значение:
//   Строка - текст ошибки или пустая строка, если соединение открыто
//
Функция ОткрытьСоединение()
    // OTLP Exporter / gRPC: спецификация требует трансформации endpoint в host:port,
    // только если underlying gRPC-клиент не поддерживает схемы http/https.
    // Используемый OPI_GRPC (tonic-based) принимает адрес именно в форме URL
    // со схемой http:// либо https:// (схема обязательна), поэтому адрес передается
    // без трансформации: адресу без схемы схему задает конструктор (см. АдресСоСхемой).
    Попытка
        Схема = СформироватьСхемуProto(КаталогProtoФайлов);
        Параметры = OPI_GRPC.ПолучитьПараметрыСоединения(АдресКоллектора, Схема, МетаданныеТранспорта);
        НастройкиTlsGrpc = НастройкиTlsСоединения();
        Результат = OPI_GRPC.ОткрытьСоединение(Параметры, НастройкиTlsGrpc);
    Исключение
        Соединение = Неопределено;
        Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;

    Если OPI_GRPC.ЭтоКоннектор(Результат) Тогда
        Соединение = Результат;
        Возврат "";
    КонецЕсли;

    Соединение = Неопределено;
    ОшибкаТекст = "";
    Попытка
        ОшибкаТекст = Результат["error"];
    Исключение
        ОшибкаТекст = "неизвестная ошибка";
    КонецПопытки;
    Возврат ОшибкаТекст;
КонецФункции

// Возвращает открытое соединение, открывая его при необходимости. Недоступность
// коллектора - временная ошибка: исключение передает попытку стратегии повтора.
//
// Возвращаемое значение:
//   Произвольный, Неопределено - соединение OPI_GRPC или Неопределено, если транспорт закрыт
//
Функция ПолучитьСоединение()
    БлокировкаСоединения.Заблокировать();
    Попытка
        ОшибкаСоединения = "";
        Если НЕ Закрыт И Соединение = Неопределено Тогда
            ОшибкаСоединения = ОткрытьСоединение();
        КонецЕсли;
        ТекущееСоединение = Соединение;
    Исключение
        БлокировкаСоединения.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
    БлокировкаСоединения.Разблокировать();

    Если ОшибкаСоединения <> "" Тогда
        ВызватьИсключение "OTLP gRPC: не удалось открыть соединение: " + ОшибкаСоединения;
    КонецЕсли;
    Возврат ТекущееСоединение;
КонецФункции

// OTLP/gRPC: клиент ограничивает размер запроса до сжатия. Protobuf занимает не больше
// 4 байт на символ JSON (упакованные double однозначных чисел: 2 символа "0," против 8 байт),
// поэтому точный размер считается кодировщиком protobuf, только если оценка превышает лимит.
//
// Параметры:
//   Путь - Строка - путь сигнала
//   Данные - Соответствие - данные в формате OTLP JSON
//
// Возвращаемое значение:
//   Булево - Истина, если запрос больше лимита (запрос не отправляется)
//
Функция ЗапросПревышаетМаксимальныйРазмер(Путь, Данные)
    // Лимит 0 - без ограничения
    Если МаксРазмерЗапросаБайт = 0 Тогда
        Возврат Ложь;
    КонецЕсли;
    ЗаписьJSON = Новый ЗаписьJSON();
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    БайтНаСимволJSON = 4;
    Если СтрДлина(ЗаписьJSON.Закрыть()) * БайтНаСимволJSON <= МаксРазмерЗапросаБайт Тогда
        Возврат Ложь;
    КонецЕсли;

    Размер = РазмерЗапросаProto(Путь, Данные);
    Если Размер <= МаксРазмерЗапросаБайт Тогда
        Возврат Ложь;
    КонецЕсли;
    Лог.Ошибка("OTLP gRPC %1: размер запроса %2 байт превышает максимальный %3 байт, данные отброшены",
        Путь, Формат(Размер, "ЧГ="), Формат(МаксРазмерЗапросаБайт, "ЧГ="));
    Возврат Истина;
КонецФункции

Функция РазмерЗапросаProto(Путь, Данные)
    Если Путь = "/v1/traces" Тогда
        Тело = ОтелПротоКодировщикTrace.ЗакодироватьTracesData(Данные);
    ИначеЕсли Путь = "/v1/logs" Тогда
        Тело = ОтелПротоКодировщикLogs.ЗакодироватьLogsData(Данные);
    Иначе
        Тело = ОтелПротоКодировщикMetrics.ЗакодироватьMetricsData(Данные);
    КонецЕсли;
    Возврат Тело.Размер();
КонецФункции

// Возвращает код статуса gRPC из текста ошибки в верхнем регистре без "_" (например,
// DEADLINEEXCEEDED): после "status:" или "code:", иначе первое слово текста.
//
// Параметры:
//   ТекстОшибки - Строка - текст ошибки вызова
//
// Возвращаемое значение:
//   Строка - код статуса или пустая строка, если код не распознан
//
Функция КодСтатусаGrpc(Знач ТекстОшибки)
    Текст = ВРег(СтрЗаменить(ТекстОшибки, "_", ""));
    Для Каждого Маркер Из СтрРазделить("STATUS:,CODE:", ",") Цикл
        Позиция = СтрНайти(Текст, Маркер);
        Если Позиция > 0 Тогда
            Код = ПервоеСлово(Сред(Текст, Позиция + СтрДлина(Маркер)));
            Если КодыСтатуса.Получить(Код) <> Неопределено Тогда
                Возврат Код;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Код = ПервоеСлово(Текст);
    Если КодыСтатуса.Получить(Код) <> Неопределено Тогда
        Возврат Код;
    КонецЕсли;
    Возврат "";
КонецФункции

Функция ПервоеСлово(Знач Текст)
    Буквы = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    Текст = СокрЛ(Текст);
    Длина = 0;
    Пока Длина < СтрДлина(Текст) И СтрНайти(Буквы, Сред(Текст, Длина + 1, 1)) > 0 Цикл
        Длина = Длина + 1;
    КонецЦикла;
    Возврат Лев(Текст, Длина);
КонецФункции

// Байты деталей статуса из текста ошибки tonic: "details: [8, 14, 18, ...]".
//
// Параметры:
//   ТекстОшибки - Строка - текст ошибки вызова
//
// Возвращаемое значение:
//   Массив из Число - байты сериализованного google.rpc.Status; пустой массив, если деталей нет
//
Функция БайтыДеталейСтатуса(ТекстОшибки)
    Байты = Новый Массив();
    Маркер = "details: [";
    Начало = СтрНайти(ТекстОшибки, Маркер);
    Если Начало = 0 Тогда
        Возврат Байты;
    КонецЕсли;
    Начало = Начало + СтрДлина(Маркер);
    Конец = СтрНайти(ТекстОшибки, "]", , Начало);
    Для Каждого Байт Из СтрРазделить(Сред(ТекстОшибки, Начало, Конец - Начало), ",", Ложь) Цикл
        Байты.Добавить(Число(СокрЛП(Байт)));
    КонецЦикла;
    Возврат Байты;
КонецФункции

// Ищет RetryInfo в деталях статуса: google.rpc.Status, поле 3 - details (google.protobuf.Any).
//
// Параметры:
//   Байты - Массив из Число - сериализованный google.rpc.Status
//
// Возвращаемое значение:
//   Число, Неопределено - retry_delay в миллисекундах; Неопределено, если RetryInfo нет
//
Функция ЗадержкаRetryInfoСтатуса(Байты)
    КлючДеталей = 26; // поле 3, тип LEN
    Позиция = 0;
    Пока Позиция < Байты.Количество() Цикл
        Ключ = ПрочитатьVarint(Байты, Позиция);
        Если Ключ <> КлючДеталей Тогда
            ПропуститьПоле(Байты, Позиция, Ключ);
            Продолжить;
        КонецЕсли;
        Длина = ПрочитатьVarint(Байты, Позиция);
        Задержка = ЗадержкаИзAny(Байты, Позиция, Позиция + Длина);
        Если Задержка <> Неопределено Тогда
            Возврат Задержка;
        КонецЕсли;
        Позиция = Позиция + Длина;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

// Возвращает retry_delay, если деталь статуса - RetryInfo: google.protobuf.Any, поле 1 - type_url,
// поле 2 - сериализованное сообщение.
//
// Параметры:
//   Байты - Массив из Число - сериализованный google.rpc.Status
//   Начало - Число - позиция Any
//   Конец - Число - позиция за Any
//
// Возвращаемое значение:
//   Число, Неопределено - retry_delay в миллисекундах; Неопределено, если деталь не RetryInfo
//
Функция ЗадержкаИзAny(Байты, Начало, Конец)
    КлючТипа = 10; // поле 1 (type_url), тип LEN
    КлючЗначения = 18; // поле 2 (value), тип LEN
    ТипДетали = "";
    НачалоЗначения = Конец;
    КонецЗначения = Конец;
    Позиция = Начало;
    Пока Позиция < Конец Цикл
        Ключ = ПрочитатьVarint(Байты, Позиция);
        Если Ключ = КлючТипа Тогда
            Длина = ПрочитатьVarint(Байты, Позиция);
            ТипДетали = СтрокаИзБайтов(Байты, Позиция, Позиция + Длина);
            Позиция = Позиция + Длина;
        ИначеЕсли Ключ = КлючЗначения Тогда
            Длина = ПрочитатьVarint(Байты, Позиция);
            НачалоЗначения = Позиция;
            КонецЗначения = Позиция + Длина;
            Позиция = КонецЗначения;
        Иначе
            ПропуститьПоле(Байты, Позиция, Ключ);
        КонецЕсли;
    КонецЦикла;
    Если НЕ СтрЗаканчиваетсяНа(ТипДетали, "/google.rpc.RetryInfo") Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат ЗадержкаИзRetryInfo(Байты, НачалоЗначения, КонецЗначения);
КонецФункции

// Возвращает retry_delay из google.rpc.RetryInfo: поле 1 - retry_delay (google.protobuf.Duration).
//
// Параметры:
//   Байты - Массив из Число - сериализованный google.rpc.Status
//   Начало - Число - позиция RetryInfo
//   Конец - Число - позиция за RetryInfo
//
// Возвращаемое значение:
//   Число - retry_delay в миллисекундах; 0, если задержка не задана
//
Функция ЗадержкаИзRetryInfo(Байты, Начало, Конец)
    КлючЗадержки = 10; // поле 1 (retry_delay), тип LEN
    Задержка = 0;
    Позиция = Начало;
    Пока Позиция < Конец Цикл
        Ключ = ПрочитатьVarint(Байты, Позиция);
        Если Ключ = КлючЗадержки Тогда
            Длина = ПрочитатьVarint(Байты, Позиция);
            Задержка = ДлительностьМс(Байты, Позиция, Позиция + Длина);
            Позиция = Позиция + Длина;
        Иначе
            ПропуститьПоле(Байты, Позиция, Ключ);
        КонецЕсли;
    КонецЦикла;
    Возврат Задержка;
КонецФункции

// Возвращает google.protobuf.Duration в миллисекундах: поле 1 - seconds, поле 2 - nanos. Доля миллисекунды
// округляется вверх: повтор не должен начаться раньше retry_delay.
//
// Параметры:
//   Байты - Массив из Число - сериализованный google.rpc.Status
//   Начало - Число - позиция Duration
//   Конец - Число - позиция за Duration
//
// Возвращаемое значение:
//   Число - длительность в миллисекундах
//
Функция ДлительностьМс(Байты, Начало, Конец)
    КлючСекунд = 8; // поле 1 (seconds), тип VARINT
    КлючНаносекунд = 16; // поле 2 (nanos), тип VARINT
    МиллисекундВСекунде = 1000;
    НаносекундВМиллисекунде = 1000000;
    Секунды = 0;
    Наносекунды = 0;
    Позиция = Начало;
    Пока Позиция < Конец Цикл
        Ключ = ПрочитатьVarint(Байты, Позиция);
        Если Ключ = КлючСекунд Тогда
            Секунды = ПрочитатьVarint(Байты, Позиция);
        ИначеЕсли Ключ = КлючНаносекунд Тогда
            Наносекунды = ПрочитатьVarint(Байты, Позиция);
        Иначе
            ПропуститьПоле(Байты, Позиция, Ключ);
        КонецЕсли;
    КонецЦикла;
    Возврат Секунды * МиллисекундВСекунде
        + Цел((Наносекунды + НаносекундВМиллисекунде - 1) / НаносекундВМиллисекунде);
КонецФункции

// Читает varint protobuf и сдвигает позицию за него.
//
// Параметры:
//   Байты - Массив из Число - сообщение protobuf
//   Позиция - Число - позиция varint, после чтения - позиция за ним
//
// Возвращаемое значение:
//   Число - значение varint
//
Функция ПрочитатьVarint(Байты, Позиция)
    ОснованиеVarint = 128;
    МаксБайтовVarint = 10;
    Значение = 0;
    Множитель = 1;
    Для Сдвиг = 0 По МаксБайтовVarint - 1 Цикл
        Байт = Байты[Позиция + Сдвиг];
        Значение = Значение + (Байт % ОснованиеVarint) * Множитель;
        Если Байт < ОснованиеVarint Тогда
            Позиция = Позиция + Сдвиг + 1;
            Возврат Значение;
        КонецЕсли;
        Множитель = Множитель * ОснованиеVarint;
    КонецЦикла;
    ВызватьИсключение "Некорректный varint protobuf";
КонецФункции

// Пропускает значение поля protobuf по типу из ключа поля.
//
// Параметры:
//   Байты - Массив из Число - сообщение protobuf
//   Позиция - Число - позиция значения поля, после пропуска - позиция за ним
//   Ключ - Число - ключ поля: номер поля * 8 + тип
//
Процедура ПропуститьПоле(Байты, Позиция, Ключ)
    ТиповВКлюче = 8;
    ТипVarint = 0;
    ТипI64 = 1;
    ТипLen = 2;
    ТипI32 = 5;
    БайтовI64 = 8;
    БайтовI32 = 4;
    ТипПоля = Ключ % ТиповВКлюче;
    Если ТипПоля = ТипVarint Тогда
        ПрочитатьVarint(Байты, Позиция);
    ИначеЕсли ТипПоля = ТипI64 Тогда
        Позиция = Позиция + БайтовI64;
    ИначеЕсли ТипПоля = ТипLen Тогда
        Длина = ПрочитатьVarint(Байты, Позиция);
        Позиция = Позиция + Длина;
    ИначеЕсли ТипПоля = ТипI32 Тогда
        Позиция = Позиция + БайтовI32;
    Иначе
        ВызватьИсключение СтрШаблон("Неподдерживаемый тип поля protobuf: %1", ТипПоля);
    КонецЕсли;
КонецПроцедуры

Функция СтрокаИзБайтов(Байты, Начало, Конец)
    Буквы = Новый Массив();
    Для Индекс = Начало По Конец - 1 Цикл
        Буквы.Добавить(Символ(Байты[Индекс]));
    КонецЦикла;
    Возврат СтрСоединить(Буквы);
КонецФункции

// Коды статуса gRPC и их повторяемость по спецификации OTLP/gRPC.
// RESOURCE_EXHAUSTED повторяется только с RetryInfo (см. ОшибкаПовторяемая).
//
Процедура ИнициализироватьКодыСтатуса()
    КодыСтатуса = Новый Соответствие();
    Повторяемые = "CANCELLED,DEADLINEEXCEEDED,ABORTED,OUTOFRANGE,UNAVAILABLE,DATALOSS";
    Для Каждого Код Из СтрРазделить(Повторяемые, ",") Цикл
        КодыСтатуса.Вставить(Код, Истина);
    КонецЦикла;
    Неповторяемые = "OK,UNKNOWN,INVALIDARGUMENT,NOTFOUND,ALREADYEXISTS,PERMISSIONDENIED,"
        + "RESOURCEEXHAUSTED,FAILEDPRECONDITION,UNIMPLEMENTED,INTERNAL,UNAUTHENTICATED";
    Для Каждого Код Из СтрРазделить(Неповторяемые, ",") Цикл
        КодыСтатуса.Вставить(Код, Ложь);
    КонецЦикла;
КонецПроцедуры

Функция СформироватьСхемуProto(КаталогProto)
    Схема = Новый Соответствие();

    ФайлыProto = Новый Массив();
    ФайлыProto.Добавить("opentelemetry/proto/common/v1/common.proto");
    ФайлыProto.Добавить("opentelemetry/proto/resource/v1/resource.proto");
    ФайлыProto.Добавить("opentelemetry/proto/trace/v1/trace.proto");
    ФайлыProto.Добавить("opentelemetry/proto/logs/v1/logs.proto");
    ФайлыProto.Добавить("opentelemetry/proto/metrics/v1/metrics.proto");
    ФайлыProto.Добавить("opentelemetry/proto/collector/trace/v1/trace_service.proto");
    ФайлыProto.Добавить("opentelemetry/proto/collector/logs/v1/logs_service.proto");
    ФайлыProto.Добавить("opentelemetry/proto/collector/metrics/v1/metrics_service.proto");

    Для Каждого ИмяФайла Из ФайлыProto Цикл
        ПолныйПуть = КаталогProto + "/" + ИмяФайла;
        Схема.Вставить(ИмяФайла, ПолныйПуть);
    КонецЦикла;

    Возврат Схема;
КонецФункции

Функция ОпределитьКаталогProto()
    // Ищем каталог proto относительно корня библиотеки
    КаталогБиблиотеки = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "..");
    КаталогПрото = ОбъединитьПути(КаталогБиблиотеки, "proto");

    Файл = Новый Файл(КаталогПрото);
    Если Файл.Существует() Тогда
        Возврат Файл.ПолноеИмя;
    КонецЕсли;

    Возврат КаталогПрото;
КонецФункции

Процедура ИнициализироватьПутиСервисов()
    ПутиСервисов = Новый Соответствие();

    КлючСервис = "service";
    КлючМетод = "method";
    ИмяМетодаЭкспорт = "Export";

    НастройкиТрассировки = Новый Соответствие();
    НастройкиТрассировки.Вставить(КлючСервис, "opentelemetry.proto.collector.trace.v1.TraceService");
    НастройкиТрассировки.Вставить(КлючМетод, ИмяМетодаЭкспорт);
    ПутиСервисов.Вставить("/v1/traces", НастройкиТрассировки);

    НастройкиЛогов = Новый Соответствие();
    НастройкиЛогов.Вставить(КлючСервис, "opentelemetry.proto.collector.logs.v1.LogsService");
    НастройкиЛогов.Вставить(КлючМетод, ИмяМетодаЭкспорт);
    ПутиСервисов.Вставить("/v1/logs", НастройкиЛогов);

    НастройкиМетрик = Новый Соответствие();
    НастройкиМетрик.Вставить(КлючСервис, "opentelemetry.proto.collector.metrics.v1.MetricsService");
    НастройкиМетрик.Вставить(КлючМетод, ИмяМетодаЭкспорт);
    ПутиСервисов.Вставить("/v1/metrics", НастройкиМетрик);
КонецПроцедуры

// OTLP Exporter / Insecure: опция действует только на адрес без схемы - без Insecure
// соединение защищено TLS, с Insecure - без TLS. Схема http или https важнее Insecure.
//
// Параметры:
//   Адрес - Строка - адрес коллектора
//   НастройкиTls - ОтелНастройкиTls, Неопределено - настройки TLS
//
// Возвращаемое значение:
//   Строка - адрес коллектора со схемой http:// или https://
//
Функция АдресСоСхемой(Адрес, НастройкиTls)
    Если СтрНайти(Адрес, "://") > 0 Тогда
        Возврат Адрес;
    КонецЕсли;
    Если НастройкиTls <> Неопределено И НастройкиTls.Insecure Тогда
        Возврат "http://" + Адрес;
    КонецЕсли;
    Возврат "https://" + Адрес;
КонецФункции

// Возвращает настройки TLS соединения в формате OPI_GRPC.ПолучитьНастройкиTls. Адрес https -
// TLS с проверкой сертификата сервера по системным и встроенным корневым сертификатам и файлу
// сертификата, адрес http - без TLS: настройки TLS компонента применяет к любому адресу.
//
// Возвращаемое значение:
//   Структура, Неопределено - настройки TLS или Неопределено для соединения без TLS
//
Функция НастройкиTlsСоединения()
    Если НЕ СтрНачинаетсяС(НРег(АдресКоллектора), "https://") Тогда
        Возврат Неопределено;
    КонецЕсли;
    ФайлСертификата = "";
    Если НастройкиTlsТранспорта <> Неопределено Тогда
        ФайлСертификата = НастройкиTlsТранспорта.ФайлСертификата;
    КонецЕсли;
    Возврат OPI_GRPC.ПолучитьНастройкиTls(Ложь, ФайлСертификата);
КонецФункции

// Предупреждает о настройках TLS, которые клиент OPI_GRPC не применяет.
//
// Параметры:
//   НастройкиTls - ОтелНастройкиTls, Неопределено - настройки TLS
//
Процедура ПроверитьНастройкиTls(НастройкиTls)
    Если НастройкиTls = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Если НастройкиTls.ФайлКлиентскогоКлюча <> "" ИЛИ НастройкиTls.ФайлКлиентскогоСертификата <> "" Тогда
        Лог.Предупреждение(
            "gRPC транспорт: mTLS (client certificate/key) не поддерживается библиотекой OPI_GRPC."
            + " Клиентский ключ и сертификат будут проигнорированы."
            + " Подробнее: https://github.com/Bayselonarrend/OpenIntegrations/issues/102");
    КонецЕсли;
КонецПроцедуры

#КонецОбласти
