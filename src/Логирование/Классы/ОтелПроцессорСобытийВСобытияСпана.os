#Использовать atomic
#Использовать logos

#Область ОписаниеПеременных

// АтомарноеБулево - Признак завершения работы процессора.
// После Закрыть() OnEmit (ПриПоявлении) игнорирует новые записи.
Перем Закрыт;

// Логгер logos - логгер для диагностических сообщений процессора
Перем Лог;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Переносит событие - запись лога с именем события - в событие текущего спана (OnEmit).
// По спецификации запись переносится, только если у нее непустое имя события, валидные
// TraceId и SpanId, в разрешенном контексте есть записываемый текущий спан и идентификаторы
// записи совпадают с его идентификаторами. Иначе процессор ничего не делает.
// Событие спана получает имя события записи, время записи (без него - время наблюдения)
// и все атрибуты записи. Запись продолжает путь по конвейеру: следующие процессоры
// получают ее как обычно.
// Ошибки переноса логируются и НЕ пробрасываются наверх.
//
// Параметры:
//   ЗаписьЛога - ОтелЗаписьЛога - запись лога
//   Контекст - Соответствие, Неопределено - разрешённый контекст из Logger.emit() (необязательный);
//       Неопределено - текущий контекст потока
//
Процедура ПриПоявлении(ЗаписьЛога, Контекст = Неопределено) Экспорт
    Если Закрыт.Получить() Тогда
        Возврат;
    КонецЕсли;
    Попытка
        ПеренестиСобытие(ЗаписьЛога, Контекст);
    Исключение
        Лог.Ошибка("Событие не перенесено в событие спана: %1", ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

// Проверяет, будет ли процессор обрабатывать запись лога с данными параметрами:
// без записываемого текущего спана в контексте процессору нечего делать.
// Пустое имя события означает, что оно не известно, и не отключает процессор.
// Реализация MUST NOT мутировать переданные объекты.
//
// Параметры:
//   Контекст - Соответствие, Неопределено - явный Context (необязательный);
//       Неопределено - текущий контекст потока
//   ОбластьИнструментирования - ОтелОбластьИнструментирования - scope логгера (необязательный)
//   СтепеньСерьезности - Число - номер серьезности записи (необязательный)
//   ИмяСобытия - Строка - имя события (необязательный)
//
// Возвращаемое значение:
//   Булево - Истина, если в контексте есть записываемый спан и процессор не закрыт
//
// BSLLS:NumberOfOptionalParams-off
// BSLLS:UnusedParameters-off
Функция Включен(
        Контекст = Неопределено,
        ОбластьИнструментирования = Неопределено,
        СтепеньСерьезности = 0,
        ИмяСобытия = "") Экспорт
// BSLLS:NumberOfOptionalParams-on
// BSLLS:UnusedParameters-on
    Если Закрыт.Получить() Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат ЗаписываемыйСпан(Контекст) <> Неопределено;
КонецФункции

// Принудительно отправляет накопленные данные. Буфера у процессора нет.
//
// Параметры:
//   ТаймаутМс - Число - таймаут в миллисекундах (0 - без ограничения)
//
// Возвращаемое значение:
//   ОтелРезультатЭкспорта - успех
//
Функция СброситьБуфер(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
    Возврат ОтелРезультатыЭкспорта.Успех();
КонецФункции

// Завершает работу процессора: следующие записи он не переносит.
//
// Параметры:
//   ТаймаутМс - Число - таймаут в миллисекундах (0 - без ограничения)
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия - успех
//
Функция Закрыть(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
    Закрыт.Установить(Истина);
    Возврат ОтелРезультатыЗакрытия.Успех();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПеренестиСобытие(ЗаписьЛога, Контекст)
    ИмяСобытия = ЗаписьЛога.ИмяСобытия();
    Если ПустаяСтрока(ИмяСобытия) Тогда
        Возврат;
    КонецЕсли;
    ИдТрассировки = ЗаписьЛога.ИдТрассировки();
    ИдСпана = ЗаписьЛога.ИдСпана();
    ДлинаИдТрассировки = 32;
    ДлинаИдСпана = 16;
    Если НЕ ОтелУтилиты.ЯвляетсяВалиднымИдентификатором(ИдТрассировки, ДлинаИдТрассировки)
        ИЛИ НЕ ОтелУтилиты.ЯвляетсяВалиднымИдентификатором(ИдСпана, ДлинаИдСпана) Тогда
        Возврат;
    КонецЕсли;

    Спан = ЗаписываемыйСпан(Контекст);
    Если Спан = Неопределено Тогда
        Возврат;
    КонецЕсли;
    КонтекстСпана = Спан.КонтекстСпана();
    Если КонтекстСпана.ИдТрассировки() <> ИдТрассировки ИЛИ КонтекстСпана.ИдСпана() <> ИдСпана Тогда
        Возврат;
    КонецЕсли;

    Время = ЗаписьЛога.Время();
    Если ПустаяСтрока(Время) Тогда
        Время = ЗаписьЛога.ВремяНаблюдения();
    КонецЕсли;
    Спан.ДобавитьСобытие(ИмяСобытия, ЗаписьЛога.Атрибуты(), Время);
КонецПроцедуры

// Возвращает текущий спан разрешенного контекста, если он записывается (IsRecording).
//
// Параметры:
//   Контекст - Соответствие, ФиксированноеСоответствие, Неопределено - контекст;
//       Неопределено - текущий контекст потока
//
// Возвращаемое значение:
//   ОтелСпан, Неопределено - записываемый спан или Неопределено
//
Функция ЗаписываемыйСпан(Контекст)
    Спан = ОтелКонтекст.СпанИзКонтекста(Контекст);
    Если Спан = Неопределено ИЛИ НЕ Спан.ЗаписьАктивна() Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат Спан;
КонецФункции

// Класс процессора записей логов, переносящего события в события спана
// (EventToSpanEventBridge, спецификация Logs SDK, статус Development).
//
// Для бэкендов и представлений, ориентированных на трассы: событие, записанное через
// Logs API (например, исключение по семантическим соглашениям exceptions-logs), видно
// и в событиях спана. Чтобы запись не только переносилась, но и экспортировалась логом,
// процессор ставят перед процессором экспорта. Настраиваемых параметров нет.
//
// Конструктор процессора.
//
&Реализует("ИнтерфейсПроцессорЛогов")
Процедура ПриСозданииОбъекта()
    Закрыт = Новый АтомарноеБулево(Ложь);
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.eventtospaneventbridge");
КонецПроцедуры

#КонецОбласти
