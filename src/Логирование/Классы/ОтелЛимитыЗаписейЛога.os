#Область ОписаниеПеременных

// Число - Максимальное количество атрибутов записи лога
Перем МаксАтрибутов;
// Число, Неопределено - Максимальная длина значения строкового атрибута (Неопределено - без ограничения)
Перем МаксДлинаЗначенияАтрибута;
// Число - Максимальная глубина вложенности массивов в значении атрибута
Перем МаксГлубинаЗначенияАтрибута;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает максимальное количество атрибутов записи лога.
//
// Возвращаемое значение:
//   Число
//
Функция МаксАтрибутов() Экспорт
    Возврат МаксАтрибутов;
КонецФункции

// Возвращает максимальную длину значения строкового атрибута (AttributeValueLengthLimit).
// Действует и на строки внутри массивов.
//
// Возвращаемое значение:
//   Число, Неопределено - лимит; Неопределено - без ограничения, 0 - строки усекаются до пустых
//
Функция МаксДлинаЗначенияАтрибута() Экспорт
    Возврат МаксДлинаЗначенияАтрибута;
КонецФункции

// Возвращает максимальную глубину значения атрибута (AttributeValueDepthLimit). Глубина
// верхнего значения - 1, массивы глубже лимита заменяются пустым значением.
//
// Возвращаемое значение:
//   Число - по умолчанию 64
//
Функция МаксГлубинаЗначенияАтрибута() Экспорт
    Возврат МаксГлубинаЗначенияАтрибута;
КонецФункции

// Устанавливает максимальное количество атрибутов записи лога.
//
// Параметры:
//   Значение - Число - максимальное количество атрибутов
//
// Возвращаемое значение:
//   ОтелЛимитыЗаписейЛога - ЭтотОбъект для цепочки вызовов
//
Функция УстановитьМаксАтрибутов(Значение) Экспорт
    МаксАтрибутов = Значение;
    Возврат ЭтотОбъект;
КонецФункции

// Устанавливает максимальную длину значения строкового атрибута.
//
// Параметры:
//   Значение - Число, Неопределено - лимит; Неопределено - без ограничения, 0 - нулевой лимит
//
// Возвращаемое значение:
//   ОтелЛимитыЗаписейЛога - ЭтотОбъект для цепочки вызовов
//
Функция УстановитьМаксДлинаЗначенияАтрибута(Значение) Экспорт
    МаксДлинаЗначенияАтрибута = Значение;
    Возврат ЭтотОбъект;
КонецФункции

// Устанавливает максимальную глубину значения атрибута.
//
// Параметры:
//   Значение - Число - лимит глубины, глубина верхнего значения - 1
//
// Возвращаемое значение:
//   ОтелЛимитыЗаписейЛога - ЭтотОбъект для цепочки вызовов
//
Функция УстановитьМаксГлубинаЗначенияАтрибута(Значение) Экспорт
    МаксГлубинаЗначенияАтрибута = Значение;
    Возврат ЭтотОбъект;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Класс лимитов записей лога (LogLimits) по спецификации OpenTelemetry.
// Аналог Java SDK: io.opentelemetry.sdk.logs.LogLimits
//
// Определяет ограничения на количество атрибутов, длину и глубину значений атрибутов
// в записи лога. Fluent API для конфигурации.
//
// Пример:
//   Лимиты = Новый ОтелЛимитыЗаписейЛога()
//       .УстановитьМаксАтрибутов(256)
//       .УстановитьМаксДлинаЗначенияАтрибута(2048);
//
Процедура ПриСозданииОбъекта()
    МаксАтрибутов = 128;
    МаксДлинаЗначенияАтрибута = Неопределено;
    МаксГлубинаЗначенияАтрибута = 64; // BSLLS:MagicNumber-off
КонецПроцедуры

#КонецОбласти
