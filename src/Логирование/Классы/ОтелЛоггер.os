#Область ОписаниеПеременных

// ОтелОбластьИнструментирования - область инструментирования
Перем ОбластьИнструментирования;
// ОтелРесурс - Ресурс, описывающий источник телеметрии
Перем Ресурс;
// ОтелПровайдерЛогирования - провайдер для динамического доступа к процессору
Перем Провайдер;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Создает новую запись лога.
//
// Возвращаемое значение:
//   ОтелЗаписьЛога
//
Функция СоздатьЗаписьЛога() Экспорт
    Если Провайдер <> Неопределено Тогда
        Возврат Новый ОтелЗаписьЛога(Провайдер.ЛимитыЗаписейЛога());
    КонецЕсли;
    Возврат Новый ОтелЗаписьЛога();
КонецФункции

// Проверяет, включен ли логгер.
// Вызывать Включен() необязательно: он не требуется перед Записать(), которая сама
// отбрасывает запись отключенного логгера. Это оптимизация, полезная, только когда
// построение записи дорогое, например тело или атрибуты вычисляются по данным из базы:
// тогда можно сначала вызвать Включен() и пропустить эту работу при Ложь. Дешевую
// запись можно сразу передавать в Записать().
// Потокобезопасность: метод безопасен для конкурентного использования.
//
// Результат не постоянен и может меняться со временем (регистрация процессоров,
// закрытие провайдера): сохраненное значение может устареть.
//
// По умолчанию возвращает Истина (если запись не отключена фильтрами процессоров),
// что соответствует поведению по спецификации.
//
// Спецификация: Enabled(Context, InstrumentationScope, SeverityNumber, EventName).
// Реализации процессоров MUST NOT мутировать переданные объекты;
// логгер передает процессорам защищенную копию ОбластиИнструментирования,
// чтобы модификации не утекали к вызывающей стороне.
//
// Параметры:
//   Контекст - Соответствие, Неопределено - явный контекст (необязательный).
//       Если не указан, используется текущий контекст потока.
//   ОбластьИнструментирования - ОтелОбластьИнструментирования - scope (необязательный).
//       Если не указан, используется scope логгера.
//   СтепеньСерьезности - Число - номер серьезности для фильтрации (необязательный)
//   ИмяСобытия - Строка - имя события для фильтрации (необязательный)
//
// Возвращаемое значение:
//   Булево - Истина если логгер может обрабатывать записи
//
// BSLLS:NumberOfOptionalParams-off
Функция Включен(
        Знач Контекст = Неопределено,
        Знач ОбластьИнструментирования = Неопределено,
        Знач СтепеньСерьезности = 0,
        Знач ИмяСобытия = "") Экспорт
// BSLLS:NumberOfOptionalParams-on
    Если Провайдер = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;
    Если Провайдер.Закрыт() Тогда
        Возврат Ложь;
    КонецЕсли;
    // Spec: when implicit Context is supported, Context is optional and unspecified -> current Context.
    // Изменения параметров внутри Enabled MUST NOT доходить до вызывающего: параметры
    // передаются по значению, явный изменяемый контекст - неизменяемой копией.
    РазрешенныйКонтекст = ?(Контекст = Неопределено, ОтелКонтекст.Текущий(), Контекст);
    Если ТипЗнч(РазрешенныйКонтекст) = Тип("Соответствие") Тогда
        РазрешенныйКонтекст = Новый ФиксированноеСоответствие(РазрешенныйКонтекст);
    КонецЕсли;
    Если НЕ Провайдер.Процессор().ЕстьПроцессоры() Тогда
        Возврат Ложь;
    КонецЕсли;
    ИсходнаяОбласть = ?(ОбластьИнструментирования = Неопределено,
        ЭтотОбъект.ОбластьИнструментирования(), ОбластьИнструментирования);
    ЗащищеннаяКопия = ЗащищеннаяКопияОбласти(ИсходнаяОбласть);
    Возврат Провайдер.Процессор().Включен(
        РазрешенныйКонтекст, ЗащищеннаяКопия, СтепеньСерьезности, ИмяСобытия);
КонецФункции

// Отправляет запись лога.
// Logger.emit() устанавливает scope, resource и trace context на записи,
// затем передает запись процессору.
// Потокобезопасность: метод безопасен для конкурентного использования.
//
// Параметры:
//   ЗаписьЛога - ОтелЗаписьЛога - запись лога для отправки
//   Контекст - Соответствие, Неопределено - явный контекст для trace correlation (необязательный).
//       Если не указан, используется текущий контекст потока.
//       "The trace context fields MUST be populated from the resolved Context
//       (either the explicitly passed Context or the current Context) when emitted."
//
Процедура Записать(ЗаписьЛога, Контекст = Неопределено) Экспорт
    ЗаписьЛога.УстановитьОбластьИнструментирования(ОбластьИнструментирования);
    ЗаписьЛога.УстановитьРесурс(Ресурс);

    // resolve Context and populate trace context fields at emit time
    РазрешенныйКонтекст = Контекст;
    Если РазрешенныйКонтекст = Неопределено Тогда
        РазрешенныйКонтекст = ОтелКонтекст.Текущий();
    КонецЕсли;
    КонтекстСпана = ВалидныйКонтекстСпана(РазрешенныйКонтекст);
    Если КонтекстСпана <> Неопределено Тогда
        ЗаписьЛога.УстановитьКонтекстТрассировки(
            КонтекстСпана.ИдТрассировки(), КонтекстСпана.ИдСпана());
        ЗаписьЛога.УстановитьФлагиТрассировки(КонтекстСпана.ФлагиТрассировки());
    КонецЕсли;
    // Сохраняем контекст в записи для Event Bridge (чтобы не зависеть от thread-local при batch-обработке)
    ЗаписьЛога.УстановитьКонтекст(РазрешенныйКонтекст);

    // Exception attribute handling
    ПрименитьАтрибутыИсключения(ЗаписьЛога);

    // SDK SHOULD set ObservedTimestamp to current time if not set
    Если ПустаяСтрока(ЗаписьЛога.ВремяНаблюдения()) Тогда
        ЗаписьЛога.УстановитьВремяНаблюдения(ОтелУтилиты.ТекущееВремяВНаносекундах());
    КонецЕсли;

    Если Провайдер <> Неопределено И НЕ Провайдер.Закрыт() Тогда
        Провайдер.Процессор().ПриПоявлении(ЗаписьЛога, РазрешенныйКонтекст);
    КонецЕсли;

    // LogRecord SHOULD be read-only after emit
    ЗаписьЛога.Зафиксировать();
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает область инструментирования логгера.
//
// Возвращаемое значение:
//   ОтелОбластьИнструментирования
//
Функция ОбластьИнструментирования() Экспорт
    Возврат ОбластьИнструментирования;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗащищеннаяКопияОбласти(Область)
    Если Область = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    КопияАтрибутов = Неопределено;
    ИсходныеАтрибуты = Область.Атрибуты();
    Если ИсходныеАтрибуты <> Неопределено Тогда
        КопияАтрибутов = Новый ОтелАтрибуты();
        Для Каждого КлючИЗначение Из ИсходныеАтрибуты.ВСоответствие() Цикл
            КопияАтрибутов.Установить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
        КонецЦикла;
    КонецЕсли;
    Возврат Новый ОтелОбластьИнструментирования(
        Область.Имя(), Область.Версия(), КопияАтрибутов, Область.АдресСхемы());
КонецФункции

// Возвращает контекст спана из явного (или текущего) контекста, если он валиден.
// Невалидный спан (нулевые TraceId и SpanId) не связывает запись с трассировкой.
//
// Параметры:
//   Контекст - ФиксированноеСоответствие, Соответствие, Неопределено - явный контекст;
//       Неопределено - текущий контекст потока
//
// Возвращаемое значение:
//   ОтелКонтекстСпана, Неопределено - валидный контекст спана или Неопределено
//
Функция ВалидныйКонтекстСпана(Контекст)
    РазрешенныйКонтекст = Контекст;
    Если РазрешенныйКонтекст = Неопределено Тогда
        РазрешенныйКонтекст = ОтелКонтекст.Текущий();
    КонецЕсли;
    Спан = ОтелКонтекст.СпанИзКонтекста(РазрешенныйКонтекст);
    Если Спан = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    КонтекстСпана = Спан.КонтекстСпана();
    Если НЕ КонтекстСпана.Валиден() Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат КонтекстСпана;
КонецФункции

Процедура ПрименитьАтрибутыИсключения(ЗаписьЛога)
    ИнфоОбИсключении = ЗаписьЛога.ИнформацияОбИсключении();
    Если ИнфоОбИсключении = Неопределено Тогда
        Возврат;
    КонецЕсли;
    УстановитьАтрибутИсключенияЕслиНеЗадан(ЗаписьЛога, "exception.message",
        ИнфоОбИсключении.Описание);
    ТипИсключения = ПолучитьТипИсключения(ИнфоОбИсключении);
    УстановитьАтрибутИсключенияЕслиНеЗадан(ЗаписьЛога, "exception.type", ТипИсключения);
    СтекВызовов = СформироватьСтекВызовов(ИнфоОбИсключении);
    УстановитьАтрибутИсключенияЕслиНеЗадан(ЗаписьЛога, "exception.stacktrace", СтекВызовов);
КонецПроцедуры

Процедура УстановитьАтрибутИсключенияЕслиНеЗадан(ЗаписьЛога, Ключ, Значение)
    Если ЗаписьЛога.Атрибуты().Получить(Ключ) = Неопределено Тогда
        ЗаписьЛога.УстановитьАтрибут(Ключ, Значение);
    КонецЕсли;
КонецПроцедуры

Функция ПолучитьТипИсключения(ИнфоОбИсключении)
    Попытка
        Если ИнфоОбИсключении.ИмяМодуля <> "" Тогда
            Возврат ИнфоОбИсключении.ИмяМодуля;
        КонецЕсли;
    Исключение // BSLLS:MissingCodeTryCatchEx-off BSLLS:CatchStatementWithoutExceptionVariable-off
    КонецПопытки;
    Возврат "RuntimeError";
КонецФункции

Функция СформироватьСтекВызовов(ИнфоОбИсключении)
    Попытка
        Стек = ИнфоОбИсключении.ПодробноеОписаниеОшибки();
        Если НЕ ПустаяСтрока(Стек) Тогда
            Возврат Стек;
        КонецЕсли;
    Исключение // BSLLS:MissingCodeTryCatchEx-off BSLLS:CatchStatementWithoutExceptionVariable-off
    КонецПопытки;
    Возврат ИнфоОбИсключении.Описание;
КонецФункции

Процедура УстановитьОбластьИнструментирования(Значение)
    ОбластьИнструментирования = Значение;
КонецПроцедуры

Процедура УстановитьПровайдер(Значение)
    Провайдер = Значение;
КонецПроцедуры

Процедура УстановитьРесурс(Значение)
    Ресурс = Значение;
КонецПроцедуры

// Класс логгера (Logger) по спецификации OpenTelemetry.
//
// Создает и отправляет записи логов.
// Получается из ОтелПровайдерЛогирования.
// Потокобезопасность: все методы безопасны для конкурентного использования.
//
// Конструктор логгера.
//
// Параметры:
//   ОбластьИнструментирования - ОтелОбластьИнструментирования - область инструментирования
//   Ресурс - ОтелРесурс - ресурс
//   Провайдер - ОтелПровайдерЛогирования - провайдер логирования (необязательный)
//
Процедура ПриСозданииОбъекта(ОбластьИнструментирования, Ресурс, Провайдер = Неопределено)
    УстановитьОбластьИнструментирования(ОбластьИнструментирования);
    УстановитьРесурс(Ресурс);
    УстановитьПровайдер(Провайдер);
КонецПроцедуры

#КонецОбласти
