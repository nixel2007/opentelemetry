#Использовать logos

#Область ОписаниеПеременных

// ОтелПровайдерТрассировки - провайдер трассировки SDK
Перем ПровайдерТрассировки;
// ОтелПровайдерЛогирования - провайдер логирования SDK
Перем ПровайдерЛогирования;
// ОтелПровайдерМетрик - провайдер метрик SDK
Перем ПровайдерМетрик;
// ОтелКомпозитныйПропагатор - пропагаторы контекста
Перем Пропагаторы;
// Число - таймаут закрытия в миллисекундах, если Закрыть вызван без таймаута (0 - без ограничения)
Перем ТаймаутЗакрытияМс;
// Объект - логгер (logos)
Перем Лог;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает провайдер трассировки.
//
// Возвращаемое значение:
//   ОтелПровайдерТрассировки - провайдер трассировки
//
Функция ПровайдерТрассировки() Экспорт
    Возврат ПровайдерТрассировки;
КонецФункции

// Возвращает провайдер логирования.
//
// Возвращаемое значение:
//   ОтелПровайдерЛогирования - провайдер логирования
//
Функция ПровайдерЛогирования() Экспорт
    Возврат ПровайдерЛогирования;
КонецФункции

// Возвращает провайдер метрик.
//
// Возвращаемое значение:
//   ОтелПровайдерМетрик - провайдер метрик
//
Функция ПровайдерМетрик() Экспорт
    Возврат ПровайдерМетрик;
КонецФункции

// Возвращает пропагаторы контекста.
//
// Возвращаемое значение:
//   ОтелКомпозитныйПропагатор, ОтелНоопПропагатор - пропагаторы контекста; no-op, если не заданы
//
Функция Пропагаторы() Экспорт
    Возврат Пропагаторы;
КонецФункции

// Shortcut: получить трассировщик.
// Аналог Java SDK: openTelemetry.getTracer("name")
//
// Параметры:
//   ИмяБиблиотеки - Строка - имя инструментирующей библиотеки
//   ВерсияБиблиотеки - Строка - версия (необязательный)
//
// Возвращаемое значение:
//   ОтелТрассировщик - трассировщик
//
Функция ПолучитьТрассировщик(ИмяБиблиотеки, ВерсияБиблиотеки = "") Экспорт
    Возврат ПровайдерТрассировки.ПолучитьТрассировщик(ИмяБиблиотеки, ВерсияБиблиотеки);
КонецФункции

// Shortcut: получить построитель трассировщика.
//
// Параметры:
//   ИмяБиблиотеки - Строка - имя инструментирующей библиотеки
//
// Возвращаемое значение:
//   ОтелПостроительТрассировщика - построитель трассировщика
//
Функция ПостроительТрассировщика(ИмяБиблиотеки) Экспорт
    Возврат ПровайдерТрассировки.ПостроительТрассировщика(ИмяБиблиотеки);
КонецФункции

// Shortcut: получить логгер.
//
// Параметры:
//   ИмяБиблиотеки - Строка - имя инструментирующей библиотеки
//   ВерсияБиблиотеки - Строка - версия (необязательный)
//
// Возвращаемое значение:
//   ОтелЛоггер - логгер
//
Функция ПолучитьЛоггер(ИмяБиблиотеки, ВерсияБиблиотеки = "") Экспорт
    Возврат ПровайдерЛогирования.ПолучитьЛоггер(ИмяБиблиотеки, ВерсияБиблиотеки);
КонецФункции

// Shortcut: получить построитель логгера.
//
// Параметры:
//   ИмяБиблиотеки - Строка - имя инструментирующей библиотеки
//
// Возвращаемое значение:
//   ОтелПостроительЛоггера - построитель логгера
//
Функция ПостроительЛоггера(ИмяБиблиотеки) Экспорт
    Возврат ПровайдерЛогирования.ПостроительЛоггера(ИмяБиблиотеки);
КонецФункции

// Shortcut: получить метр.
//
// Параметры:
//   ИмяБиблиотеки - Строка - имя инструментирующей библиотеки
//   ВерсияБиблиотеки - Строка - версия (необязательный)
//
// Возвращаемое значение:
//   ОтелМетр - метр
//
Функция ПолучитьМетр(ИмяБиблиотеки, ВерсияБиблиотеки = "") Экспорт
    Возврат ПровайдерМетрик.ПолучитьМетр(ИмяБиблиотеки, ВерсияБиблиотеки);
КонецФункции

// Shortcut: получить построитель метра.
//
// Параметры:
//   ИмяБиблиотеки - Строка - имя инструментирующей библиотеки
//
// Возвращаемое значение:
//   ОтелПостроительМетра - построитель метра
//
Функция ПостроительМетра(ИмяБиблиотеки) Экспорт
    Возврат ПровайдерМетрик.ПостроительМетра(ИмяБиблиотеки);
КонецФункции

// Принудительно отправляет все накопленные данные из всех провайдеров.
//
// Параметры:
//   ТаймаутМс - Число - таймаут в миллисекундах (0 - без ограничения)
//
// Возвращаемое значение:
//   ОтелРезультатЭкспорта - агрегированный результат сброса всех провайдеров
//
Функция СброситьБуфер(ТаймаутМс = 0) Экспорт
    Результаты = Новый Массив();
    Результаты.Добавить(ПровайдерТрассировки.СброситьБуфер(ТаймаутМс));
    Результаты.Добавить(ПровайдерЛогирования.СброситьБуфер(ТаймаутМс));
    Результаты.Добавить(ПровайдерМетрик.СброситьБуфер(ТаймаутМс));
    Возврат ОтелРезультатыЭкспорта.ОжидатьВсе(Результаты, ТаймаутМс);
КонецФункции

// Возвращает таймаут закрытия, который действует, если Закрыть вызван без таймаута.
//
// Возвращаемое значение:
//   Число - таймаут в миллисекундах (0 - без ограничения)
//
Функция ТаймаутЗакрытия() Экспорт
    Возврат ТаймаутЗакрытияМс;
КонецФункции

// Завершает работу всех провайдеров.
//
// Параметры:
//   ТаймаутМс - Число, Неопределено - таймаут завершения в миллисекундах (0 - без ограничения).
//       Если не задан, действует ТаймаутЗакрытия(): значение построителя, при автоконфигурации -
//       из OTEL_SDK_SHUTDOWN_TIMEOUT, иначе 30000.
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия - первый неуспешный результат или успешный результат
//
Функция Закрыть(Знач ТаймаутМс = Неопределено) Экспорт
    Если ТаймаутМс = Неопределено Тогда
        ТаймаутМс = ТаймаутЗакрытияМс;
    КонецЕсли;

    Результаты = Новый Массив;
    Попытка
        Результаты.Добавить(ПровайдерТрассировки.Закрыть(ТаймаутМс));
    Исключение
        Лог.Предупреждение("Ошибка закрытия провайдера трассировки: %1", ОписаниеОшибки());
        Результаты.Добавить(ОтелРезультатыЗакрытия.Ошибка(ОписаниеОшибки()));
    КонецПопытки;
    Попытка
        Результаты.Добавить(ПровайдерЛогирования.Закрыть(ТаймаутМс));
    Исключение
        Лог.Предупреждение("Ошибка закрытия провайдера логирования: %1", ОписаниеОшибки());
        Результаты.Добавить(ОтелРезультатыЗакрытия.Ошибка(ОписаниеОшибки()));
    КонецПопытки;
    Попытка
        Результаты.Добавить(ПровайдерМетрик.Закрыть(ТаймаутМс));
    Исключение
        Лог.Предупреждение("Ошибка закрытия провайдера метрик: %1", ОписаниеОшибки());
        Результаты.Добавить(ОтелРезультатыЗакрытия.Ошибка(ОписаниеОшибки()));
    КонецПопытки;

    Для Каждого Результат Из Результаты Цикл
        Если НЕ Результат.Успех Тогда
            Возврат Результат;
        КонецЕсли;
    КонецЦикла;
    Возврат ОтелРезультатыЗакрытия.Успех();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьПровайдерЛогирования(Значение)
    ПровайдерЛогирования = Значение;
КонецПроцедуры

Процедура УстановитьПровайдерМетрик(Значение)
    ПровайдерМетрик = Значение;
КонецПроцедуры

Процедура УстановитьПровайдерТрассировки(Значение)
    ПровайдерТрассировки = Значение;
КонецПроцедуры

Процедура УстановитьПропагаторы(Значение)
    Пропагаторы = Значение;
КонецПроцедуры

// No-op провайдеры и пропагатор заменяют не заданные при создании SDK (аналог Java
// OpenTelemetrySdkBuilder): shortcut-методы SDK, как и API без SDK, возвращают рабочие no-op
// объекты. Ресурс no-op провайдеров не читает переменные окружения.

Функция НоопПровайдерТрассировки()
    Провайдер = Новый ОтелПровайдерТрассировки(НоопРесурс(), , ОтелСэмплер.ВсегдаВыключен());
    Провайдер.УстановитьВключен(Ложь);
    Возврат Провайдер;
КонецФункции

Функция НоопПровайдерМетрик()
    Провайдер = Новый ОтелПровайдерМетрик(НоопРесурс());
    Провайдер.УстановитьВключен(Ложь);
    Возврат Провайдер;
КонецФункции

Функция НоопРесурс()
    Возврат Новый ОтелРесурс(Ложь, "", Истина);
КонецФункции

// Класс OpenTelemetry SDK - единая точка входа в телеметрию.
// Аналог Java SDK: OpenTelemetrySdk
//
// Агрегирует TracerProvider, LoggerProvider, MeterProvider и ContextPropagators.
// Предоставляет shortcut-методы для получения Tracer/Logger/Meter.
//
// Конструктор SDK. Вызывается из ОтелПостроительSdk.Построить(). Не заданные провайдеры и
// пропагаторы заменяются no-op.
//
// Параметры:
//   ПровайдерТрассировки - ОтелПровайдерТрассировки - провайдер трассировки (необязательный)
//   ПровайдерЛогирования - ОтелПровайдерЛогирования - провайдер логирования (необязательный)
//   ПровайдерМетрик - ОтелПровайдерМетрик - провайдер метрик (необязательный)
//   Пропагаторы - ОтелКомпозитныйПропагатор - пропагаторы контекста (необязательный)
//   НовыйТаймаутЗакрытияМс - Число - таймаут Закрыть без параметра в мс, 0 - без ограничения
//
// Пример:
//   Сдк = Новый ОтелПостроительSdk()
//       .УстановитьПровайдерТрассировки(ПровайдерТрассировки)
//       .УстановитьПровайдерМетрик(ПровайдерМетрик)
//       .Построить();
//
//   Трассировщик = Сдк.ПолучитьТрассировщик("мой-сервис");
//
// BSLLS:NumberOfOptionalParams-off
Процедура ПриСозданииОбъекта(
        ПровайдерТрассировки = Неопределено,
        ПровайдерЛогирования = Неопределено,
        ПровайдерМетрик = Неопределено,
        Пропагаторы = Неопределено,
        НовыйТаймаутЗакрытияМс = 30000) // BSLLS:MagicNumber-off
    Если ПровайдерТрассировки = Неопределено Тогда
        УстановитьПровайдерТрассировки(НоопПровайдерТрассировки());
    Иначе
        УстановитьПровайдерТрассировки(ПровайдерТрассировки);
    КонецЕсли;
    Если ПровайдерЛогирования = Неопределено Тогда
        УстановитьПровайдерЛогирования(Новый ОтелПровайдерЛогирования(НоопРесурс()));
    Иначе
        УстановитьПровайдерЛогирования(ПровайдерЛогирования);
    КонецЕсли;
    Если ПровайдерМетрик = Неопределено Тогда
        УстановитьПровайдерМетрик(НоопПровайдерМетрик());
    Иначе
        УстановитьПровайдерМетрик(ПровайдерМетрик);
    КонецЕсли;
    Если Пропагаторы = Неопределено Тогда
        УстановитьПропагаторы(Новый ОтелНоопПропагатор());
    Иначе
        УстановитьПропагаторы(Пропагаторы);
    КонецЕсли;
    ТаймаутЗакрытияМс = НовыйТаймаутЗакрытияМс;
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.sdk");
КонецПроцедуры

#КонецОбласти
