#Использовать logos

#Область ОписаниеПеременных

// ОтелАтрибуты - атрибуты ресурса
Перем Атрибуты;
// Строка - URL схемы ресурса
Перем АдресСхемы;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает атрибуты ресурса.
//
// Возвращаемое значение:
//   ОтелАтрибуты - атрибуты ресурса
//
Функция Атрибуты() Экспорт
    Возврат Атрибуты;
КонецФункции

// Возвращает URL схемы ресурса.
//
// Возвращаемое значение:
//   Строка - URL схемы или пустая строка
//
Функция АдресСхемы() Экспорт
    Возврат АдресСхемы;
КонецФункции

// Создает новый ресурс как результат слияния текущего с другим.
// Атрибуты другого ресурса имеют приоритет.
//
// Параметры:
//   ДругойРесурс - ОтелРесурс - ресурс для слияния
//
// Возвращаемое значение:
//   ОтелРесурс - новый ресурс
//
Функция Слить(ДругойРесурс) Экспорт
    КонфликтСхемы = НЕ ПустаяСтрока(АдресСхемы)
        И НЕ ПустаяСтрока(ДругойРесурс.АдресСхемы())
        И АдресСхемы <> ДругойРесурс.АдресСхемы();

    Если КонфликтСхемы Тогда
        Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.resource");
        Лог.Ошибка(
            "Конфликт Schema URL при слиянии ресурсов: '%1' и '%2'. Schema URL будет пустым",
            АдресСхемы, ДругойРесурс.АдресСхемы());
        НовыйАдресСхемы = "";
    ИначеЕсли ПустаяСтрока(АдресСхемы) Тогда
        НовыйАдресСхемы = ДругойРесурс.АдресСхемы();
    Иначе
        НовыйАдресСхемы = АдресСхемы;
    КонецЕсли;

    НовыйРесурс = Новый ОтелРесурс(Атрибуты, НовыйАдресСхемы);
    Для Каждого КлючИЗначение Из ДругойРесурс.Атрибуты().ВСоответствие() Цикл
        НовыйРесурс.Атрибуты().Установить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
    КонецЦикла;
    Возврат НовыйРесурс;
КонецФункции

// Возвращает построитель с атрибутами и адресом схемы этого ресурса.
// Аналог Java SDK: Resource.toBuilder()
//
// Возвращаемое значение:
//   ОтелПостроительРесурса - построитель, который начинается с копии ресурса
//
Функция ВПостроитель() Экспорт
    Возврат Новый ОтелПостроительРесурса()
        .УстановитьВсе(Атрибуты)
        .УстановитьАдресСхемы(АдресСхемы);
КонецФункции

// Преобразует ресурс в соответствие формата OTLP JSON.
//
// Возвращаемое значение:
//   Соответствие - {"attributes": [...]}
//
Функция ВСоответствиеOtlp() Экспорт
    Результат = Новый Соответствие();
    Результат.Вставить("attributes", Атрибуты.ВМассивOtlp());
    Результат.Вставить("droppedAttributesCount", 0);
    Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Класс описания ресурса (Resource) по спецификации OpenTelemetry.
// Аналог Java SDK: io.opentelemetry.sdk.resources.Resource
//
// Ресурс описывает сущность, производящую телеметрию: сервис, хост, процесс и т.д.
// Конструктор создает ресурс ровно из переданных атрибутов. Ресурс с атрибутами по умолчанию,
// атрибуты детекторов и окружения возвращает модуль ОтелРесурсы.
//
// Параметры:
//   НачальныеАтрибуты - ОтелАтрибуты, Соответствие, Неопределено - атрибуты ресурса;
//       копируются, по умолчанию ресурс пустой
//   НачальныйАдресСхемы - Строка - URL схемы ресурса (по умолчанию "")
//
Процедура ПриСозданииОбъекта(НачальныеАтрибуты = Неопределено, НачальныйАдресСхемы = "")
    Атрибуты = Новый ОтелАтрибуты();
    АдресСхемы = НачальныйАдресСхемы;

    Если НачальныеАтрибуты = Неопределено Тогда
        Возврат;
    ИначеЕсли ТипЗнч(НачальныеАтрибуты) = Тип("Соответствие") Тогда
        ИсходныеАтрибуты = НачальныеАтрибуты;
    Иначе
        ИсходныеАтрибуты = НачальныеАтрибуты.ВСоответствие();
    КонецЕсли;
    Для Каждого КлючИЗначение Из ИсходныеАтрибуты Цикл
        Атрибуты.Установить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
    КонецЦикла;
КонецПроцедуры

#КонецОбласти
