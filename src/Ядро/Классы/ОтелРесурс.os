#Использовать logos

#Область ОписаниеПеременных

// ОтелАтрибуты - атрибуты ресурса
Перем Атрибуты;
// Строка - URL схемы ресурса
Перем АдресСхемы;
// Массив из ОтелСущность - сущности ресурса (Entities); их атрибуты входят в атрибуты ресурса
Перем Сущности;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает атрибуты ресурса.
//
// Возвращаемое значение:
//   ОтелАтрибуты - атрибуты ресурса
//
Функция Атрибуты() Экспорт
    Возврат Атрибуты;
КонецФункции

// Возвращает URL схемы ресурса.
//
// Возвращаемое значение:
//   Строка - URL схемы или пустая строка
//
Функция АдресСхемы() Экспорт
    Возврат АдресСхемы;
КонецФункции

// Возвращает сущности ресурса (Entities, статус Development). Атрибуты сущностей входят в атрибуты
// ресурса.
//
// Возвращаемое значение:
//   ФиксированныйМассив из ОтелСущность
//
Функция Сущности() Экспорт
    Возврат Новый ФиксированныйМассив(Сущности);
КонецФункции

// Создает новый ресурс как результат слияния текущего с другим.
// Атрибуты другого ресурса имеют приоритет. Если у одного из ресурсов есть сущности, слияние идет
// по алгоритму модели данных ресурса (Resource Data Model, Merging Resources): сущности другого
// ресурса сливаются со сливаемыми сущностями текущего или заменяют сущности того же типа вместе с
// их атрибутами; сущность, атрибут которой перезаписан, теряет ссылку, но ее остальные атрибуты
// остаются атрибутами ресурса.
//
// Параметры:
//   ДругойРесурс - ОтелРесурс - ресурс для слияния
//
// Возвращаемое значение:
//   ОтелРесурс - новый ресурс
//
Функция Слить(ДругойРесурс) Экспорт
    КонфликтСхемы = НЕ ПустаяСтрока(АдресСхемы)
        И НЕ ПустаяСтрока(ДругойРесурс.АдресСхемы())
        И АдресСхемы <> ДругойРесурс.АдресСхемы();

    Если КонфликтСхемы Тогда
        Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.resource");
        Лог.Ошибка(
            "Конфликт Schema URL при слиянии ресурсов: '%1' и '%2'. Schema URL будет пустым",
            АдресСхемы, ДругойРесурс.АдресСхемы());
        НовыйАдресСхемы = "";
    ИначеЕсли ПустаяСтрока(АдресСхемы) Тогда
        НовыйАдресСхемы = ДругойРесурс.АдресСхемы();
    Иначе
        НовыйАдресСхемы = АдресСхемы;
    КонецЕсли;

    Если Сущности.Количество() > 0 ИЛИ ДругойРесурс.Сущности().Количество() > 0 Тогда
        Возврат СлитьССущностями(ДругойРесурс, НовыйАдресСхемы);
    КонецЕсли;

    НовыйРесурс = Новый ОтелРесурс(Истина, НовыйАдресСхемы);
    Для Каждого КлючИЗначение Из Атрибуты.ВСоответствие() Цикл
        НовыйРесурс.Атрибуты().Установить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
    КонецЦикла;
    Для Каждого КлючИЗначение Из ДругойРесурс.Атрибуты().ВСоответствие() Цикл
        НовыйРесурс.Атрибуты().Установить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
    КонецЦикла;
    Возврат НовыйРесурс;
КонецФункции

// Преобразует ресурс в соответствие формата OTLP JSON.
//
// Возвращаемое значение:
//   Соответствие - {"attributes": [...]}
//
Функция ВСоответствиеOtlp() Экспорт
    Результат = Новый Соответствие();
    Результат.Вставить("attributes", Атрибуты.ВМассивOtlp());
    Результат.Вставить("droppedAttributesCount", 0);
    Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьАдресСхемы(Значение)
    АдресСхемы = Значение;
КонецПроцедуры

// Сливает ресурсы по алгоритму модели данных ресурса (Merge behavior with Entities): сначала
// сущности другого ресурса, затем его атрибуты, не принадлежащие его сущностям.
//
// Параметры:
//   ДругойРесурс - ОтелРесурс - обновляющий ресурс
//   НовыйАдресСхемы - Строка - адрес схемы результата
//
// Возвращаемое значение:
//   ОтелРесурс - новый ресурс
//
Функция СлитьССущностями(ДругойРесурс, НовыйАдресСхемы)
    Состояние = Новый Структура("Атрибуты, Сущности", Новый Соответствие(), Новый Массив());
    Для Каждого КлючИЗначение Из Атрибуты.ВСоответствие() Цикл
        Состояние.Атрибуты.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
    КонецЦикла;
    Для Каждого Сущность Из Сущности Цикл
        Состояние.Сущности.Добавить(Сущность);
    КонецЦикла;

    СущностиДругого = ДругойРесурс.Сущности();
    Для Каждого Сущность Из СущностиДругого Цикл
        СлитьСущность(Состояние, Сущность);
    КонецЦикла;
    Для Каждого КлючИЗначение Из ДругойРесурс.Атрибуты().ВСоответствие() Цикл
        Если НЕ АтрибутСущностей(СущностиДругого, КлючИЗначение.Ключ) Тогда
            СлитьАтрибут(Состояние, КлючИЗначение.Ключ, КлючИЗначение.Значение);
        КонецЕсли;
    КонецЦикла;

    // Сущности результата не делят атрибуты, поэтому их вставка в пустой ресурс их не меняет
    НовыйРесурс = Новый ОтелРесурс(Истина, НовыйАдресСхемы, Истина, Состояние.Сущности);
    Для Каждого КлючИЗначение Из Состояние.Атрибуты Цикл
        НовыйРесурс.Атрибуты().Установить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
    КонецЦикла;
    Возврат НовыйРесурс;
КонецФункции

// Сливает сущность с ресурсом (Resource Data Model, Merging An Entity into a Resource): сливаемая
// сущность того же типа объединяет описание; несливаемая сущность того же типа удаляется вместе с
// атрибутами и заменяется; иначе сущность добавляется, перезаписывая атрибуты. Невалидная сущность
// пропускается с ошибкой в логе.
//
// Параметры:
//   Состояние - Структура - атрибуты (Соответствие) и сущности (Массив) ресурса (мутируется)
//   Сущность - ОтелСущность - сливаемая сущность
//
Процедура СлитьСущность(Состояние, Сущность)
    Если НЕ Сущность.Валидна() Тогда
        Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.resource");
        Лог.Ошибка("Сущность ресурса типа '%1' пропущена: тип не задан или нет идентифицирующих атрибутов",
            Сущность.ТипСущности());
        Возврат;
    КонецЕсли;
    Индекс = ИндексСущностиТипа(Состояние.Сущности, Сущность.ТипСущности());
    Если Индекс <> Неопределено И Состояние.Сущности[Индекс].МожноСлить(Сущность) Тогда
        Слитая = Состояние.Сущности[Индекс].Слить(Сущность);
        Состояние.Сущности[Индекс] = Слитая;
        ЗаписатьАтрибутыСущности(Состояние, Сущность.Описание(), Слитая);
        Возврат;
    КонецЕсли;
    Если Индекс <> Неопределено Тогда
        Для Каждого КлючИЗначение Из Состояние.Сущности[Индекс].Атрибуты() Цикл
            Состояние.Атрибуты.Удалить(КлючИЗначение.Ключ);
        КонецЦикла;
        Состояние.Сущности.Удалить(Индекс);
    КонецЕсли;
    Состояние.Сущности.Добавить(Сущность);
    ЗаписатьАтрибутыСущности(Состояние, Сущность.Атрибуты(), Сущность);
КонецПроцедуры

// Сливает атрибут с ресурсом (Resource Data Model, Merging Resource Attributes into a Resource):
// сущность, атрибут которой перезаписан, удаляется, ее остальные атрибуты остаются свободными.
//
// Параметры:
//   Состояние - Структура - атрибуты и сущности ресурса (мутируется)
//   Ключ - Строка - ключ атрибута
//   Значение - Произвольный - значение атрибута
//
Процедура СлитьАтрибут(Состояние, Ключ, Значение)
    ОтвязатьСущностиАтрибута(Состояние, Ключ, Неопределено);
    Состояние.Атрибуты.Вставить(Ключ, Значение);
КонецПроцедуры

// Записывает атрибуты сущности в атрибуты ресурса, отвязывая другие сущности от перезаписанных
// атрибутов.
//
// Параметры:
//   Состояние - Структура - атрибуты и сущности ресурса (мутируется)
//   АтрибутыСущности - Соответствие, ФиксированноеСоответствие - записываемые атрибуты
//   Владелец - ОтелСущность - сущность, которой принадлежат атрибуты
//
Процедура ЗаписатьАтрибутыСущности(Состояние, АтрибутыСущности, Владелец)
    Для Каждого КлючИЗначение Из АтрибутыСущности Цикл
        ОтвязатьСущностиАтрибута(Состояние, КлючИЗначение.Ключ, Владелец);
        Состояние.Атрибуты.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
    КонецЦикла;
КонецПроцедуры

// Удаляет из сущностей ресурса сущности, кроме владельца, которые ссылаются на атрибут: атрибут
// может принадлежать только одной сущности.
//
// Параметры:
//   Состояние - Структура - атрибуты и сущности ресурса (мутируется)
//   Ключ - Строка - ключ перезаписываемого атрибута
//   Владелец - ОтелСущность, Неопределено - новый владелец атрибута
//
Процедура ОтвязатьСущностиАтрибута(Состояние, Ключ, Владелец)
    Индекс = Состояние.Сущности.ВГраница();
    Пока Индекс >= 0 Цикл
        Сущность = Состояние.Сущности[Индекс];
        Если Сущность <> Владелец И Сущность.СодержитАтрибут(Ключ) Тогда
            Состояние.Сущности.Удалить(Индекс);
        КонецЕсли;
        Индекс = Индекс - 1;
    КонецЦикла;
КонецПроцедуры

Функция ИндексСущностиТипа(СписокСущностей, ТипСущности)
    Для Индекс = 0 По СписокСущностей.ВГраница() Цикл
        Если СписокСущностей[Индекс].ТипСущности() = ТипСущности Тогда
            Возврат Индекс;
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

Функция АтрибутСущностей(СписокСущностей, Ключ)
    Для Каждого Сущность Из СписокСущностей Цикл
        Если Сущность.СодержитАтрибут(Ключ) Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

// Класс описания ресурса (Resource) по спецификации OpenTelemetry.
//
// Ресурс описывает сущность, производящую телеметрию:
// сервис, хост, процесс и т.д.
//
// Конструктор ресурса.
// По умолчанию добавляет обязательные атрибуты: service.name, telemetry.sdk.*.
//
// Параметры:
//   БезУмолчаний - Булево - если Истина, не добавлять дефолтные атрибуты (по умолчанию Ложь)
//   АдресСхемы - Строка - URL схемы ресурса (по умолчанию "")
//   БезОкружения - Булево - если Истина, не читать OTEL_RESOURCE_ATTRIBUTES и OTEL_SERVICE_NAME
//       (файловая конфигурация: при OTEL_CONFIG_FILE остальные переменные игнорируются)
//   НачальныеСущности - Массив из ОтелСущность, Неопределено - сущности ресурса (Entities, статус
//       Development): ресурс создается как ресурс с атрибутами, слитый с ресурсом из этих сущностей
//
// BSLLS:NumberOfOptionalParams-off
Процедура ПриСозданииОбъекта(БезУмолчаний = Ложь, АдресСхемы = "", БезОкружения = Ложь,
        НачальныеСущности = Неопределено)
// BSLLS:NumberOfOptionalParams-on
    Атрибуты = Новый ОтелАтрибуты();
    Сущности = Новый Массив();
    УстановитьАдресСхемы(АдресСхемы);
    Если НЕ БезУмолчаний Тогда
        ЗаполнитьАтрибутыПоУмолчанию(НЕ БезОкружения);
    КонецЕсли;
    Если НачальныеСущности <> Неопределено Тогда
        ДобавитьНачальныеСущности(НачальныеСущности);
    КонецЕсли;
КонецПроцедуры

// Сливает сущности, переданные при создании, с атрибутами ресурса.
//
// Параметры:
//   НачальныеСущности - Массив из ОтелСущность - сущности
//
Процедура ДобавитьНачальныеСущности(НачальныеСущности)
    Состояние = Новый Структура("Атрибуты, Сущности", Новый Соответствие(), Сущности);
    Для Каждого КлючИЗначение Из Атрибуты.ВСоответствие() Цикл
        Состояние.Атрибуты.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
    КонецЦикла;
    Для Каждого Сущность Из НачальныеСущности Цикл
        СлитьСущность(Состояние, Сущность);
    КонецЦикла;
    Атрибуты = Новый ОтелАтрибуты();
    Для Каждого КлючИЗначение Из Состояние.Атрибуты Цикл
        Атрибуты.Установить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
    КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьАтрибутыПоУмолчанию(ЧитатьОкружение)
    Атрибуты.Установить("service.name", "unknown_service:oscript");
    Атрибуты.Установить("telemetry.sdk.name", "opentelemetry");
    Атрибуты.Установить("telemetry.sdk.version", ОтелУтилиты.ВерсияSDK());
    Атрибуты.Установить("telemetry.sdk.language", "oscript");

    Детекторы = Новый Массив;
    Детекторы.Добавить(Новый ОтелДетекторРесурсаХоста());
    Детекторы.Добавить(Новый ОтелДетекторРесурсаПроцесса());
    Детекторы.Добавить(Новый ОтелДетекторРесурсаПроцессора());

    РесурсДетекторов = Новый ОтелРесурс(Истина);
    Для Каждого Детектор Из Детекторы Цикл
        ОбнаруженныйРесурс = Детектор.Обнаружить();
        РесурсДетекторов = РесурсДетекторов.Слить(ОбнаруженныйРесурс);
    КонецЦикла;

    Для Каждого КлючИЗначение Из РесурсДетекторов.Атрибуты().ВСоответствие() Цикл
        Атрибуты.Установить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
    КонецЦикла;
    // Схема детекторов применяется, только если адрес схемы не задан явно
    Если ПустаяСтрока(АдресСхемы) И НЕ ПустаяСтрока(РесурсДетекторов.АдресСхемы()) Тогда
        УстановитьАдресСхемы(РесурсДетекторов.АдресСхемы());
    КонецЕсли;

    // Per OTel Resource SDK spec: MUST extract OTEL_RESOURCE_ATTRIBUTES и слить.
    // Применяется здесь, чтобы любая базовая инициализация ресурса (включая `Новый ОтелРесурс()`
    // без автоконфигурации) подхватывала переменные окружения по спеке.
    Если ЧитатьОкружение Тогда
        ПрименитьАтрибутыИзОкружения();
    КонецЕсли;
КонецПроцедуры

Процедура ПрименитьАтрибутыИзОкружения()
    СтрокаАтрибутов = ПрочитатьПеременнуюСреды("OTEL_RESOURCE_ATTRIBUTES");
    Если СтрокаАтрибутов <> Неопределено И СтрокаАтрибутов <> "" Тогда
        РазобранныеАтрибуты = РазобратьСтрокуАтрибутовРесурса(СтрокаАтрибутов);
        Если РазобранныеАтрибуты <> Неопределено Тогда
            Для Каждого КлючИЗначение Из РазобранныеАтрибуты Цикл
                Атрибуты.Установить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
            КонецЦикла;
        КонецЕсли;
    КонецЕсли;

    ИмяСервиса = ПрочитатьПеременнуюСреды("OTEL_SERVICE_NAME");
    Если ИмяСервиса <> Неопределено И ИмяСервиса <> "" Тогда
        Атрибуты.Установить("service.name", ИмяСервиса);
    КонецЕсли;
КонецПроцедуры

// Разбирает строку OTEL_RESOURCE_ATTRIBUTES в Соответствие.
// При любой ошибке (элемент не в формате ключ=значение, пустой ключ, сбой URL-декодирования)
// по спецификации Resource SDK §19/§20 возвращает Неопределено, отбрасывая значение
// переменной целиком и логируя ошибку. Пустые элементы (лишние запятые) пропускаются.
//
// Параметры:
//   СтрокаАтрибутов - Строка - сырое значение OTEL_RESOURCE_ATTRIBUTES
//
// Возвращаемое значение:
//   Соответствие, Неопределено - распарсенные пары ключ-значение или Неопределено при ошибке
//
Функция РазобратьСтрокуАтрибутовРесурса(Знач СтрокаАтрибутов)
    Результат = Новый Соответствие();
    Попытка
        Пары = СтрРазделить(СтрокаАтрибутов, ",", Ложь);
        Для Каждого Пара Из Пары Цикл
            Если ПустаяСтрока(Пара) Тогда
                Продолжить;
            КонецЕсли;
            ПозицияРавно = СтрНайти(Пара, "=");
            Ключ = "";
            Если ПозицияРавно > 0 Тогда
                Ключ = СокрЛП(Лев(Пара, ПозицияРавно - 1));
            КонецЕсли;
            Если Ключ = "" Тогда
                ВызватьИсключение СтрШаблон("элемент '%1' не в формате ключ=значение", СокрЛП(Пара));
            КонецЕсли;
            Значение = СокрЛП(Сред(Пара, ПозицияРавно + 1));
            Ключ = ОтелУтилиты.РаскодироватьURLСтрого(Ключ);
            Значение = ОтелУтилиты.РаскодироватьURLСтрого(Значение);
            Результат.Вставить(Ключ, Значение);
        КонецЦикла;
    Исключение
        Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.resource");
        Лог.Ошибка(
            "Не удалось разобрать OTEL_RESOURCE_ATTRIBUTES, значение игнорируется: %1",
            ОписаниеОшибки());
        Возврат Неопределено;
    КонецПопытки;
    Возврат Результат;
КонецФункции

// Безопасная обертка над встроенной ПолучитьПеременнуюСреды:
// возвращает Неопределено при ошибке (например, если переменная не задана и
// рантайм бросает исключение в каком-то окружении).
//
// Параметры:
//   Имя - Строка - имя переменной среды
//
// Возвращаемое значение:
//   Строка, Неопределено - значение переменной среды или Неопределено при ошибке
//
Функция ПрочитатьПеременнуюСреды(Имя)
    Попытка
        Возврат ПолучитьПеременнуюСреды(Имя);
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

#КонецОбласти
