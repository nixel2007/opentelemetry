#Область ОписаниеПеременных

// Строка - тип сущности (service, host, ...)
Перем ТипСущности;
// ФиксированноеСоответствие - идентифицирующие атрибуты (ID): ключ -> значение
Перем Идентификатор;
// ФиксированноеСоответствие - описательные атрибуты (Description): ключ -> значение
Перем Описание;
// Строка - адрес схемы атрибутов сущности
Перем АдресСхемы;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает тип сущности.
//
// Возвращаемое значение:
//   Строка - например "service" или "host"
//
Функция ТипСущности() Экспорт
    Возврат ТипСущности;
КонецФункции

// Возвращает идентифицирующие атрибуты сущности (ID).
//
// Возвращаемое значение:
//   ФиксированноеСоответствие - ключ -> значение
//
Функция Идентификатор() Экспорт
    Возврат Идентификатор;
КонецФункции

// Возвращает описательные атрибуты сущности (Description).
//
// Возвращаемое значение:
//   ФиксированноеСоответствие - ключ -> значение
//
Функция Описание() Экспорт
    Возврат Описание;
КонецФункции

// Возвращает адрес схемы атрибутов сущности.
//
// Возвращаемое значение:
//   Строка - адрес схемы или пустая строка
//
Функция АдресСхемы() Экспорт
    Возврат АдресСхемы;
КонецФункции

// Проверяет, что сущность валидна: тип не пустой, идентичность содержит хотя бы один атрибут.
//
// Возвращаемое значение:
//   Булево
//
Функция Валидна() Экспорт
    Возврат НЕ ПустаяСтрока(ТипСущности) И Идентификатор.Количество() > 0;
КонецФункции

// Проверяет, можно ли слить сущность с другой (Entity Data Model, Merging of Entities): совпадают
// тип, адрес схемы и идентичность - те же ключи с теми же значениями.
//
// Параметры:
//   Другая - ОтелСущность - сущность
//
// Возвращаемое значение:
//   Булево
//
Функция МожноСлить(Другая) Экспорт
    Если ТипСущности <> Другая.ТипСущности() ИЛИ АдресСхемы <> Другая.АдресСхемы() Тогда
        Возврат Ложь;
    КонецЕсли;
    ДругойИдентификатор = Другая.Идентификатор();
    Если Идентификатор.Количество() <> ДругойИдентификатор.Количество() Тогда
        Возврат Ложь;
    КонецЕсли;
    Для Каждого КлючИЗначение Из Идентификатор Цикл
        Значение = ДругойИдентификатор.Получить(КлючИЗначение.Ключ);
        Если Значение = Неопределено ИЛИ Значение <> КлючИЗначение.Значение Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

// Возвращает сущность, слитую с другой сливаемой сущностью (см. МожноСлить): описательные
// атрибуты объединяются, значения другой сущности приоритетнее.
//
// Параметры:
//   Другая - ОтелСущность - сливаемая сущность
//
// Возвращаемое значение:
//   ОтелСущность - новая сущность
//
Функция Слить(Другая) Экспорт
    НовоеОписание = Новый Соответствие(Описание);
    Для Каждого КлючИЗначение Из Другая.Описание() Цикл
        НовоеОписание.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
    КонецЦикла;
    Возврат Новый ОтелСущность(ТипСущности, Идентификатор, НовоеОписание, АдресСхемы);
КонецФункции

// Возвращает все атрибуты сущности: идентифицирующие и описательные.
//
// Возвращаемое значение:
//   Соответствие - ключ -> значение
//
Функция Атрибуты() Экспорт
    Результат = Новый Соответствие(Идентификатор);
    Для Каждого КлючИЗначение Из Описание Цикл
        Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Проверяет, ссылается ли сущность на атрибут ресурса с ключом.
//
// Параметры:
//   Ключ - Строка - ключ атрибута
//
// Возвращаемое значение:
//   Булево
//
Функция СодержитАтрибут(Ключ) Экспорт
    Возврат Идентификатор.Получить(Ключ) <> Неопределено ИЛИ Описание.Получить(Ключ) <> Неопределено;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает копию атрибутов в виде фиксированного соответствия.
//
// Параметры:
//   Атрибуты - Соответствие, Структура, ОтелАтрибуты, Неопределено - атрибуты
//
// Возвращаемое значение:
//   ФиксированноеСоответствие
//
Функция ФиксированныеАтрибуты(Атрибуты)
    Копия = Новый Соответствие();
    Если Атрибуты = Неопределено Тогда
        Возврат Новый ФиксированноеСоответствие(Копия);
    КонецЕсли;
    Источник = ?(ТипЗнч(Атрибуты) = Тип("ОтелАтрибуты"), Атрибуты.ВСоответствие(), Атрибуты);
    Для Каждого КлючИЗначение Из Источник Цикл
        Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
    КонецЦикла;
    Возврат Новый ФиксированноеСоответствие(Копия);
КонецФункции

// Сущность (Entity) ресурса по спецификации OpenTelemetry (статус Development): объект, с которым
// связана телеметрия, например сервис или хост. Идентифицирующие атрибуты задают идентичность
// сущности, описательные - дополнительные сведения. Атрибуты сущности входят в атрибуты ресурса.
//
// Параметры:
//   ИмяТипа - Строка - тип сущности, обязательный: "service", "host", ...
//   ИдентифицирующиеАтрибуты - Соответствие, Структура, ОтелАтрибуты - идентичность сущности,
//       хотя бы один атрибут
//   ОписательныеАтрибуты - Соответствие, Структура, ОтелАтрибуты, Неопределено - описание сущности
//   АдресСхемыАтрибутов - Строка - адрес схемы атрибутов сущности
//
Процедура ПриСозданииОбъекта(ИмяТипа, ИдентифицирующиеАтрибуты, ОписательныеАтрибуты = Неопределено,
        АдресСхемыАтрибутов = "")
    ТипСущности = ?(ТипЗнч(ИмяТипа) = Тип("Строка"), ИмяТипа, "");
    Идентификатор = ФиксированныеАтрибуты(ИдентифицирующиеАтрибуты);
    Описание = ФиксированныеАтрибуты(ОписательныеАтрибуты);
    АдресСхемы = ?(ТипЗнч(АдресСхемыАтрибутов) = Тип("Строка"), АдресСхемыАтрибутов, "");
КонецПроцедуры

#КонецОбласти
