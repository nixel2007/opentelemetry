#Область ОписаниеПеременных

// Соответствие - внутреннее хранилище пар ключ-значение атрибутов
Перем Данные;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Устанавливает значение атрибута по ключу.
//
// Параметры:
//   Ключ - Строка - имя атрибута
//   Значение - Произвольный - значение атрибута (строка, число, булево)
//
// Возвращаемое значение:
//   ОтелАтрибуты - ссылка на текущий объект для цепочки вызовов
//
Функция Установить(Ключ, Значение) Экспорт
    Данные.Вставить(Ключ, Значение);
    Возврат ЭтотОбъект;
КонецФункции

// Возвращает значение атрибута по ключу.
//
// Параметры:
//   Ключ - Строка - имя атрибута
//
// Возвращаемое значение:
//   Произвольный - значение атрибута или Неопределено
//
Функция Получить(Ключ) Экспорт
    Возврат Данные.Получить(Ключ);
КонецФункции

// Удаляет атрибут по ключу.
//
// Параметры:
//   Ключ - Строка - имя атрибута
//
Процедура Удалить(Ключ) Экспорт
    Данные.Удалить(Ключ);
КонецПроцедуры

// Возвращает количество атрибутов.
//
// Возвращаемое значение:
//   Число - количество атрибутов
//
Функция Количество() Экспорт
    Возврат Данные.Количество();
КонецФункции

// Возвращает внутреннее соответствие атрибутов.
//
// Возвращаемое значение:
//   Соответствие - внутреннее соответствие атрибутов
//
Функция ВСоответствие() Экспорт
    Возврат Данные;
КонецФункции

// Возвращает ключ набора атрибутов для сравнения и группировки: одинаковые наборы
// дают одинаковый ключ независимо от порядка добавления, разные - разный.
// Значение кодируется вместе с типом, поэтому строка "1" и число 1 различаются.
//
// Возвращаемое значение:
//   Строка - ключ набора (пустая строка для пустого набора)
//
Функция Ключ() Экспорт
    Ключи = Новый СписокЗначений();
    Для Каждого КлючИЗначение Из Данные Цикл
        Ключи.Добавить(КлючИЗначение.Ключ);
    КонецЦикла;
    Ключи.СортироватьПоЗначению();

    Части = Новый Массив();
    Для Каждого ЭлементКлюча Из Ключи Цикл
        Части.Добавить(ЧастьКлюча(ЭлементКлюча.Значение));
        Части.Добавить(ЧастьКлюча(ЗначениеВКлюч(Данные.Получить(ЭлементКлюча.Значение))));
    КонецЦикла;
    Возврат СтрСоединить(Части, "");
КонецФункции

// Преобразует атрибуты в массив формата OTLP JSON.
//
// Возвращаемое значение:
//   Массив - массив объектов {"key": "...", "value": {...}}
//
Функция ВМассивOtlp() Экспорт
    Результат = Новый Массив();
    Для Каждого КлючИЗначение Из Данные Цикл
        Элемент = Новый Соответствие();
        Элемент.Вставить("key", КлючИЗначение.Ключ);
        Элемент.Вставить("value", ОтелУтилиты.ЗначениеАтрибутаВФорматОтел(КлючИЗначение.Значение));
        Результат.Добавить(Элемент);
    КонецЦикла;
    Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Кодирует часть ключа с префиксом длины: разделители внутри ключей и значений
// не дают совпадения ключей разных наборов.
//
// Параметры:
//   Строка - Строка - часть ключа
//
// Возвращаемое значение:
//   Строка - часть ключа с префиксом длины
//
Функция ЧастьКлюча(Знач Строка)
    Возврат Формат(СтрДлина(Строка), "ЧН=0; ЧГ=") + ":" + Строка;
КонецФункции

// Кодирует значение атрибута для ключа набора вместе с его типом.
//
// Параметры:
//   Значение - Строка, Число, Булево, Массив - значение атрибута
//
// Возвращаемое значение:
//   Строка - закодированное значение
//
Функция ЗначениеВКлюч(Значение)
    Если ТипЗнч(Значение) = Тип("Массив") Тогда
        Элементы = Новый Массив();
        Для Каждого Элемент Из Значение Цикл
            Элементы.Добавить(ЧастьКлюча(ЗначениеВКлюч(Элемент)));
        КонецЦикла;
        Возврат "[" + СтрСоединить(Элементы, "") + "]";
    КонецЕсли;
    Возврат Строка(ТипЗнч(Значение)) + ":" + Строка(Значение);
КонецФункции

// Класс для хранения атрибутов (пар ключ-значение) телеметрии OpenTelemetry.
//
// Атрибуты используются для описания ресурсов, спанов, событий,
// записей логов и точек данных метрик.
//
Процедура ПриСозданииОбъекта()
    Данные = Новый Соответствие();
КонецПроцедуры

#КонецОбласти
