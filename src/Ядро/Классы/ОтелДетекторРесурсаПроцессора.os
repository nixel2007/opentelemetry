#Использовать cpuinfo
#Использовать logos

#Область ОписаниеПеременных

// Логгер logos - логгер для диагностических сообщений
Перем Лог;
// ИнформацияОПроцессоре, Неопределено - заданные сведения о процессоре; Неопределено - cpuinfo
// текущей машины
Перем ЗаданныеСведения;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Обнаруживает ресурс процессора. Сведения, которые cpuinfo не определил (неподдерживаемая
// платформа), в ресурс не попадают.
//
// Возвращаемое значение:
//   ОтелРесурс - ресурс с атрибутами процессора
//
Функция Обнаружить() Экспорт
    Атрибуты = Новый Соответствие();
    Попытка
        ИнфоЦПУ = ?(ЗаданныеСведения = Неопределено, Новый ИнформацияОПроцессоре(), ЗаданныеСведения);
        Если ЗначениеЗаполнено(ИнфоЦПУ.ИмяПроцессора) Тогда
            Атрибуты.Вставить("host.cpu.model.name", ИнфоЦПУ.ИмяПроцессора);
        КонецЕсли;
        Если ИнфоЦПУ.Архитектура <> Неопределено Тогда
            Атрибуты.Вставить("host.arch", ОпределитьАрхитектуру(ВРег(Строка(ИнфоЦПУ.Архитектура))));
        КонецЕсли;
    Исключение
        // По Resource SDK spec: ошибка во время детектирования SHOULD считаться ошибкой.
        Лог.Ошибка("cpuinfo недоступен: %1", ОписаниеОшибки());
    КонецПопытки;
    // Schema URL - версия semconv атрибутов host.*, у ресурса без атрибутов - пустой
    Возврат ОтелУтилиты.РесурсДетектора(Атрибуты, "https://opentelemetry.io/schemas/1.29.0");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Конструктор детектора ресурса процессора.
//
// Параметры:
//   СведенияОПроцессоре - ИнформацияОПроцессоре - сведения о процессоре (необязательный);
//       по умолчанию cpuinfo определяет их при каждом вызове Обнаружить()
//
Процедура ПриСозданииОбъекта(СведенияОПроцессоре = Неопределено)
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.resource.cpu");
    ЗаданныеСведения = СведенияОПроцессоре;
КонецПроцедуры

Функция ОпределитьАрхитектуру(ЗначениеАрхитектуры)
    // BSLLS:IfElseIfEndsWithElse-off
    Если ЗначениеАрхитектуры = "X64" Тогда
        Возврат "amd64";
    ИначеЕсли ЗначениеАрхитектуры = "X86" Тогда
        Возврат "x86";
    ИначеЕсли ЗначениеАрхитектуры = "ARM64" Тогда
        Возврат "arm64";
    ИначеЕсли ЗначениеАрхитектуры = "ARM" Тогда
        Возврат "arm32";
    КонецЕсли;

    Возврат НРег(ЗначениеАрхитектуры);
КонецФункции

#КонецОбласти
