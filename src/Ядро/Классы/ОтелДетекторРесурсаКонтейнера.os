#Использовать logos

#Область ОписаниеПеременных

// Логгер logos - логгер для диагностических сообщений
Перем Лог;
// Строка - путь к файлу cgroup процесса (cgroup v1 и cgroup v2 без собственного пространства имен)
Перем ПутьCgroup;
// Строка - путь к файлу mountinfo процесса (cgroup v2 с собственным пространством имен)
Перем ПутьMountinfo;
// Строка, Неопределено - тип ОС в значениях os.type; Неопределено - ОС текущей машины
Перем ЗаданныйТипОС;
// РегулярноеВыражение - идентификатор контейнера в пути cgroup: сегмент из 64 шестнадцатеричных
// символов, в том числе с префиксом среды (docker-, cri-containerd-, crio-, libpod-) и суффиксом .scope
Перем ШаблонИдВCgroup;
// РегулярноеВыражение - идентификатор контейнера в точке монтирования: каталог контейнера Docker
// (containers/<id>) или podman (containers/overlay-containers/<id>)
Перем ШаблонИдВMountinfo;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Обнаруживает ресурс контейнера: container.id процесса.
//
// Идентификатор определяется только на Linux: сначала из /proc/self/cgroup, затем из
// /proc/self/mountinfo, где при cgroup v2 с собственным пространством имен виден каталог
// контейнера. На Windows и macOS идентификатор контейнера изнутри процесса не определить:
// ресурс пустой.
//
// Возвращаемое значение:
//   ОтелРесурс - ресурс с атрибутом container.id; без атрибутов, если процесс не в контейнере
//
Функция Обнаружить() Экспорт
    Атрибуты = Новый Соответствие();
    Попытка
        Если ЭтоLinux() Тогда
            ИдКонтейнера = ИдИзCgroup();
            Если ИдКонтейнера = "" Тогда
                ИдКонтейнера = ИдИзMountinfo();
            КонецЕсли;
            Если ИдКонтейнера <> "" Тогда
                Атрибуты.Вставить("container.id", ИдКонтейнера);
            КонецЕсли;
        КонецЕсли;
    Исключение
        // По Resource SDK spec: ошибка во время детектирования SHOULD считаться ошибкой.
        Лог.Ошибка("Не удалось определить идентификатор контейнера: %1", ОписаниеОшибки());
    КонецПопытки;
    // Schema URL - версия semconv, как у остальных детекторов ресурса по умолчанию: ресурсы
    // с разными Schema URL при слиянии конфликтуют. У ресурса без атрибутов - пустой
    Возврат ОтелУтилиты.РесурсДетектора(Атрибуты, "https://opentelemetry.io/schemas/1.44.0");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Конструктор детектора ресурса контейнера.
//
// Параметры:
//   Cgroup - Строка - путь к файлу cgroup процесса (необязательный, по умолчанию /proc/self/cgroup)
//   Mountinfo - Строка - путь к файлу mountinfo процесса (необязательный, по умолчанию /proc/self/mountinfo)
//   ТипОС - Строка - тип ОС в значениях os.type: linux, windows, darwin (необязательный);
//       по умолчанию - ОС текущей машины
//
&Реализует("ИнтерфейсДетекторРесурса")
Процедура ПриСозданииОбъекта(Cgroup = "/proc/self/cgroup", Mountinfo = "/proc/self/mountinfo", ТипОС = Неопределено)
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.resource.container");
    ПутьCgroup = Cgroup;
    ПутьMountinfo = Mountinfo;
    ЗаданныйТипОС = ТипОС;
    ШаблонИдВCgroup = Новый РегулярноеВыражение("(?:^|/|-)([0-9a-f]{64})(?:\.scope)?(?=/|$)");
    ШаблонИдВMountinfo = Новый РегулярноеВыражение("/containers/(?:overlay-containers/)?([0-9a-f]{64})/");
КонецПроцедуры

Функция ЭтоLinux()
    Если ЗаданныйТипОС <> Неопределено Тогда
        Возврат ЗаданныйТипОС = "linux";
    КонецЕсли;
    СисИнфо = Новый СистемнаяИнформация();
    Возврат СтрНайти(НРег(Строка(СисИнфо.ТипПлатформы)), "linux") > 0;
КонецФункции

// Строка cgroup: <иерархия>:<контроллеры>:<путь>. Идентификатор - последний подходящий сегмент
// пути: у podman за каталогом контейнера бывает вложенный каталог (libpod-<id>.scope/container).
//
// Возвращаемое значение:
//   Строка - идентификатор контейнера; пустая строка - в cgroup его нет
//
Функция ИдИзCgroup()
    ИдКонтейнера = "";
    Cgroup = ДокументФайла(ПутьCgroup);
    Для НомерСтроки = 1 По Cgroup.КоличествоСтрок() Цикл
        СтрокаCgroup = Cgroup.ПолучитьСтроку(НомерСтроки);
        ПозицияКонтроллеров = СтрНайти(СтрокаCgroup, ":");
        ПозицияПути = СтрНайти(СтрокаCgroup, ":", , ПозицияКонтроллеров + 1);
        Если ПозицияКонтроллеров = 0 ИЛИ ПозицияПути = 0 Тогда
            Продолжить;
        КонецЕсли;
        Совпадения = ШаблонИдВCgroup.НайтиСовпадения(Сред(СтрокаCgroup, ПозицияПути + 1));
        Если Совпадения.Количество() > 0 Тогда
            ИдКонтейнера = Совпадения[Совпадения.Количество() - 1].Группы[1].Значение;
        КонецЕсли;
    КонецЦикла;
    Возврат ИдКонтейнера;
КонецФункции

// Каталог песочницы pod-а (sandboxes/<id>) не берется: это идентификатор pod-а, а не контейнера.
//
// Возвращаемое значение:
//   Строка - идентификатор контейнера; пустая строка - в точках монтирования его нет
//
Функция ИдИзMountinfo()
    Mountinfo = ДокументФайла(ПутьMountinfo);
    Для НомерСтроки = 1 По Mountinfo.КоличествоСтрок() Цикл
        Совпадения = ШаблонИдВMountinfo.НайтиСовпадения(Mountinfo.ПолучитьСтроку(НомерСтроки));
        Если Совпадения.Количество() > 0 Тогда
            Возврат Совпадения[0].Группы[1].Значение;
        КонецЕсли;
    КонецЦикла;
    Возврат "";
КонецФункции

// Параметры:
//   Путь - Строка - путь к файлу
//
// Возвращаемое значение:
//   ТекстовыйДокумент - содержимое файла; пустой документ - файла нет
//
Функция ДокументФайла(Путь)
    Документ = Новый ТекстовыйДокумент();
    Если Новый Файл(Путь).Существует() Тогда
        Документ.Прочитать(Путь, КодировкаТекста.UTF8);
    КонецЕсли;
    Возврат Документ;
КонецФункции

#КонецОбласти
