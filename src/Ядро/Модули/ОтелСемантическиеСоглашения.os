// BSLLS:MagicNumber-off
// Модуль констант семантических соглашений (Semantic Conventions) OpenTelemetry.
//
// Имена атрибутов и метрик, которыми инструментирования описывают обращения к базам данных,
// серверам, ошибки и код. Значения соответствуют semantic-conventions 1.30+ (стабильные db.*).
// Инструментирование, использующее эти функции вместо строковых литералов, не расходится
// с соглашениями и с другими инструментированиями в одном трейсе.

#Область ПрограммныйИнтерфейс

#Область БазыДанных

// Система управления базой данных: postgresql, sqlite и т.д.
//
// Возвращаемое значение:
//   Строка - db.system.name
//
Функция СистемаБД() Экспорт
    Возврат "db.system.name";
КонецФункции

// Пространство имен базы данных: имя базы, схема, путь к файлу.
//
// Возвращаемое значение:
//   Строка - db.namespace
//
Функция ПространствоИменБД() Экспорт
    Возврат "db.namespace";
КонецФункции

// Коллекция (таблица), к которой обращается запрос.
//
// Возвращаемое значение:
//   Строка - db.collection.name
//
Функция ИмяКоллекцииБД() Экспорт
    Возврат "db.collection.name";
КонецФункции

// Операция базы данных: SELECT, INSERT, COMMIT и т.д.
//
// Возвращаемое значение:
//   Строка - db.operation.name
//
Функция ИмяОперацииБД() Экспорт
    Возврат "db.operation.name";
КонецФункции

// Текст запроса с плейсхолдерами вместо значений параметров.
//
// Возвращаемое значение:
//   Строка - db.query.text
//
Функция ТекстЗапросаБД() Экспорт
    Возврат "db.query.text";
КонецФункции

// Число строк, возвращенных запросом.
//
// Возвращаемое значение:
//   Строка - db.response.returned_rows
//
Функция ВозвращенныеСтрокиБД() Экспорт
    Возврат "db.response.returned_rows";
КонецФункции

// Имя пула соединений.
//
// Возвращаемое значение:
//   Строка - db.client.connection.pool.name
//
Функция ИмяПулаСоединенийБД() Экспорт
    Возврат "db.client.connection.pool.name";
КонецФункции

// Состояние соединения в пуле: занято или свободно.
//
// Возвращаемое значение:
//   Строка - db.client.connection.state
//
Функция СостояниеСоединенияБД() Экспорт
    Возврат "db.client.connection.state";
КонецФункции

// Значение состояния соединения: занято потоком исполнения.
//
// Возвращаемое значение:
//   Строка - used
//
Функция СостояниеСоединенияИспользуется() Экспорт
    Возврат "used";
КонецФункции

// Значение состояния соединения: свободно в пуле.
//
// Возвращаемое значение:
//   Строка - idle
//
Функция СостояниеСоединенияСвободно() Экспорт
    Возврат "idle";
КонецФункции

#КонецОбласти

#Область СерверОшибкиКод

// Адрес сервера, к которому идет обращение.
//
// Возвращаемое значение:
//   Строка - server.address
//
Функция АдресСервера() Экспорт
    Возврат "server.address";
КонецФункции

// Порт сервера, к которому идет обращение.
//
// Возвращаемое значение:
//   Строка - server.port
//
Функция ПортСервера() Экспорт
    Возврат "server.port";
КонецФункции

// Тип ошибки, которой завершилась операция.
//
// Возвращаемое значение:
//   Строка - error.type
//
Функция ТипОшибки() Экспорт
    Возврат "error.type";
КонецФункции

// Пространство имен кода: класс или модуль, выполняющий операцию.
//
// Возвращаемое значение:
//   Строка - code.namespace
//
Функция ПространствоИменКода() Экспорт
    Возврат "code.namespace";
КонецФункции

// Имя функции или метода, выполняющего операцию.
//
// Возвращаемое значение:
//   Строка - code.function.name
//
Функция ИмяФункцииКода() Экспорт
    Возврат "code.function.name";
КонецФункции

#КонецОбласти

#Область МетрикиКлиентаБД

// Гистограмма длительности операций клиента базы данных, в секундах.
//
// Возвращаемое значение:
//   Строка - db.client.operation.duration
//
Функция МетрикаДлительностиОперацииБД() Экспорт
    Возврат "db.client.operation.duration";
КонецФункции

// Число соединений в пуле по состояниям.
//
// Возвращаемое значение:
//   Строка - db.client.connection.count
//
Функция МетрикаКоличестваСоединенийБД() Экспорт
    Возврат "db.client.connection.count";
КонецФункции

// Наибольшее число соединений, которое пул может держать.
//
// Возвращаемое значение:
//   Строка - db.client.connection.max
//
Функция МетрикаПределаСоединенийБД() Экспорт
    Возврат "db.client.connection.max";
КонецФункции

// Число запросов на соединение, ожидающих в очереди пула.
//
// Возвращаемое значение:
//   Строка - db.client.connection.pending_requests
//
Функция МетрикаОжидающихЗапросовСоединенийБД() Экспорт
    Возврат "db.client.connection.pending_requests";
КонецФункции

// Гистограмма времени получения соединения из пула, в секундах.
//
// Возвращаемое значение:
//   Строка - db.client.connection.wait_time
//
Функция МетрикаВремениОжиданияСоединенияБД() Экспорт
    Возврат "db.client.connection.wait_time";
КонецФункции

// Гистограмма времени открытия нового соединения, в секундах.
//
// Возвращаемое значение:
//   Строка - db.client.connection.create_time
//
Функция МетрикаВремениСозданияСоединенияБД() Экспорт
    Возврат "db.client.connection.create_time";
КонецФункции

// Число запросов на соединение, не дождавшихся его.
//
// Возвращаемое значение:
//   Строка - db.client.connection.timeouts
//
Функция МетрикаТаймаутовСоединенийБД() Экспорт
    Возврат "db.client.connection.timeouts";
КонецФункции

// Рекомендованные границы бакетов гистограммы db.client.operation.duration.
//
// Возвращаемое значение:
//   Массив из Число - Границы в секундах: 0.001, 0.005, 0.01, 0.05, 0.1, 0.5, 1, 5, 10.
//     Каждый вызов возвращает новый массив.
//
Функция ГраницыДлительностиОперацииБД() Экспорт
    Границы = Новый Массив;
    Границы.Добавить(0.001);
    Границы.Добавить(0.005);
    Границы.Добавить(0.01);
    Границы.Добавить(0.05);
    Границы.Добавить(0.1);
    Границы.Добавить(0.5);
    Границы.Добавить(1);
    Границы.Добавить(5);
    Границы.Добавить(10);
    Возврат Границы;
КонецФункции

#КонецОбласти

#КонецОбласти
