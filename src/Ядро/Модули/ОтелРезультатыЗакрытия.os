// Фабрика результатов операций Shutdown/ForceFlush по спецификации OpenTelemetry.
//
// Предоставляет фабричные методы для создания объектов ОтелРезультатЗакрытия,
// аналогично CompletableResultCode.ofSuccess/ofFailure из Java SDK,
// но применительно к завершающим операциям SDK (Shutdown, ForceFlush).

#Область ПрограммныйИнтерфейс

// Создает успешный результат закрытия.
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия - результат с Успех = Истина
//
Функция Успех() Экспорт
    Возврат Новый ОтелРезультатЗакрытия(Истина, "", Ложь);
КонецФункции

// Создает результат с ошибкой.
//
// Параметры:
//   Описание - Строка - описание ошибки
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия - результат с Успех = Ложь
//
Функция Ошибка(Описание) Экспорт
    Возврат Новый ОтелРезультатЗакрытия(Ложь, Описание, Ложь);
КонецФункции

// Создает результат, отражающий истечение таймаута операции.
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия - результат с Истекло = Истина и Успех = Ложь
//
Функция Таймаут() Экспорт
    Возврат Новый ОтелРезультатЗакрытия(Ложь, "Таймаут операции закрытия", Истина);
КонецФункции

// Закрывает компоненты (процессоры, читатели) в пределах общего срока и сводит результаты.
// Закрыть вызывается у каждого компонента, даже после исключения в предыдущем и после
// истечения срока (Shutdown MUST вызываться у всех): компоненту передается оставшееся
// время, после истечения срока - 1 мс, чтобы он завершился без ожидания.
//
// Параметры:
//   Компоненты - Массив - объекты с функцией Закрыть(ТаймаутМс)
//   ТаймаутМс - Число - общий срок в мс; 0 - без ограничения (Закрыть вызывается без параметров)
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия - ошибка, если хоть один компонент вернул ошибку или бросил
//       исключение; иначе таймаут, если истек срок или компонент вернул таймаут; иначе успех
//
Функция ЗакрытьВсе(Компоненты, ТаймаутМс) Экспорт
    Возврат ВызватьУВсех(Компоненты, "Закрыть", ТаймаутМс);
КонецФункции

// Вызывает метод (Закрыть, СброситьБуфер) у каждого компонента в пределах общего срока и
// сводит результаты. Метод вызывается у каждого компонента, даже после исключения в
// предыдущем и после истечения срока: компоненту передается оставшееся время, после
// истечения срока - 1 мс, чтобы он завершился без ожидания.
//
// Параметры:
//   Компоненты - Массив - процессоры или читатели
//   ИмяМетода - Строка - имя метода с первым параметром ТаймаутМс
//   ТаймаутМс - Число - общий срок в мс; 0 - без ограничения (метод вызывается без параметров)
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия - сведенный результат (см. Свести)
//
Функция ВызватьУВсех(Компоненты, ИмяМетода, ТаймаутМс) Экспорт
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Результаты = Новый Массив();
    Для Каждого Компонент Из Компоненты Цикл
        Результаты.Добавить(ВызватьВПределахСрока(Компонент, ИмяМетода, НачалоМс, ТаймаутМс));
    КонецЦикла;
    Возврат Свести(Результаты, СрокИстек(НачалоМс, ТаймаутМс));
КонецФункции

// Сбрасывает буфер компонента (экспортера) и закрывает его в пределах общего срока:
// Shutdown процессора MUST включать эффект ForceFlush. Закрыть вызывается и после ошибки
// или исключения при сбросе буфера.
//
// Параметры:
//   Компонент - Произвольный - объект с методами СброситьБуфер и Закрыть
//   ТаймаутМс - Число - общий срок в мс; 0 - без ограничения (методы вызываются без параметров)
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия - сведенный результат сброса буфера и закрытия (см. Свести)
//
Функция СброситьИЗакрыть(Компонент, ТаймаутМс) Экспорт
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Результаты = Новый Массив();
    Результаты.Добавить(ВызватьВПределахСрока(Компонент, "СброситьБуфер", НачалоМс, ТаймаутМс));
    Результаты.Добавить(ВызватьВПределахСрока(Компонент, "Закрыть", НачалоМс, ТаймаутМс));
    Возврат Свести(Результаты, СрокИстек(НачалоМс, ТаймаутМс));
КонецФункции

// Выполняет Shutdown экспортера простого процессора: в пределах срока дожидается текущего
// экспорта (блокировки экспорта), затем сбрасывает буфер экспортера и закрывает его. Если
// экспорт в другом потоке не завершился за срок, экспортер закрывается без сброса буфера.
//
// Параметры:
//   Экспортер - Произвольный - экспортер с методами СброситьБуфер и Закрыть
//   БлокировкаЭкспорта - ОтелБлокировкаСТаймаутом - блокировка, под которой идет экспорт
//   ТаймаутМс - Число - общий срок в мс; 0 - без ограничения
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия - таймаут, если экспорт не завершился за срок; иначе сведенный
//       результат сброса буфера и закрытия экспортера (см. СброситьИЗакрыть)
//
Функция ЗакрытьЭкспортерПослеЭкспорта(Экспортер, БлокировкаЭкспорта, ТаймаутМс) Экспорт
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Если НЕ БлокировкаЭкспорта.Захватить(ТаймаутМс) Тогда
        Результаты = Новый Массив();
        Результаты.Добавить(Таймаут());
        Результаты.Добавить(ВызватьВПределахСрока(Экспортер, "Закрыть", НачалоМс, ТаймаутМс));
        Возврат Свести(Результаты);
    КонецЕсли;
    Результат = СброситьИЗакрыть(Экспортер, ОставшеесяВремя(НачалоМс, ТаймаутМс));
    БлокировкаЭкспорта.Освободить();
    Возврат Результат;
КонецФункции

// Вызывает метод компонента и возвращает результат: значение функции или Неопределено
// у процедуры. Передается столько значений из Параметры, сколько параметров принимает
// метод компонента (пользовательский процессор или экспортер может не принимать таймаут).
//
// Параметры:
//   Компонент - Произвольный - объект с методом ИмяМетода
//   ИмяМетода - Строка - имя метода (Закрыть, СброситьБуфер)
//   Параметры - Массив - значения параметров по порядку (таймаут, признаки)
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия, ОтелРезультатЭкспорта, Булево, Неопределено - результат метода
//
Функция ВызватьМетод(Компонент, ИмяМетода, Параметры) Экспорт
    Рефлектор = Новый Рефлектор();
    КоличествоПараметров = Параметры.Количество();
    Метод = Рефлектор.ПолучитьТаблицуМетодов(Компонент).Найти(ИмяМетода, "Имя");
    Если Метод <> Неопределено Тогда
        КоличествоПараметров = Мин(КоличествоПараметров, Метод.КоличествоПараметров);
    КонецЕсли;
    Фактические = Новый Массив();
    Для Индекс = 0 По КоличествоПараметров - 1 Цикл
        Фактические.Добавить(Параметры[Индекс]);
    КонецЦикла;
    Возврат Рефлектор.ВызватьМетод(Компонент, ИмяМетода, Фактические);
КонецФункции

// Возвращает время, оставшееся до общего срока, не меньше 1 мс: компонент, получивший
// истекший срок, завершается без ожидания (0 у компонентов означает "без ограничения").
//
// Параметры:
//   НачалоМс - Число - начало операции (ТекущаяУниверсальнаяДатаВМиллисекундах)
//   ТаймаутМс - Число - общий срок в мс; 0 - без ограничения
//
// Возвращаемое значение:
//   Число - оставшееся время в мс, не меньше 1; 0, если срок не ограничен
//
Функция ОставшеесяВремя(НачалоМс, ТаймаутМс) Экспорт
    Если ТаймаутМс <= 0 Тогда
        Возврат 0;
    КонецЕсли;
    Возврат Макс(1, ТаймаутМс - (ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс));
КонецФункции

// Проверяет, истек ли общий срок операции.
//
// Параметры:
//   НачалоМс - Число - начало операции (ТекущаяУниверсальнаяДатаВМиллисекундах)
//   ТаймаутМс - Число - общий срок в мс; 0 - без ограничения
//
// Возвращаемое значение:
//   Булево - Истина, если срок ограничен и истек
//
Функция СрокИстек(НачалоМс, ТаймаутМс) Экспорт
    Возврат ТаймаутМс > 0 И ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс > ТаймаутМс;
КонецФункции

// Возвращает таймаут вызова в пределах срока операции: меньший из таймаута вызова и времени,
// оставшегося до срока.
//
// Параметры:
//   ТаймаутМс - Число - таймаут вызова в мс; 0 - без ограничения
//   СрокМс - Число - момент срока (ТекущаяУниверсальнаяДатаВМиллисекундах); 0 - без срока
//
// Возвращаемое значение:
//   Число, Неопределено - таймаут в мс (0 - без ограничения); Неопределено, если срок истек
//
Функция ТаймаутДоСрока(ТаймаутМс, СрокМс) Экспорт
    Если СрокМс <= 0 Тогда
        Возврат ТаймаутМс;
    КонецЕсли;
    Осталось = СрокМс - ТекущаяУниверсальнаяДатаВМиллисекундах();
    Если Осталось <= 0 Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если ТаймаутМс <= 0 Тогда
        Возврат Осталось;
    КонецЕсли;
    Возврат Мин(ТаймаутМс, Осталось);
КонецФункции

// Возвращает меньший из двух таймаутов; 0 и Неопределено означают "без ограничения".
//
// Параметры:
//   ТаймаутМс - Число, Неопределено - таймаут в мс
//   ДругойТаймаутМс - Число, Неопределено - таймаут в мс
//
// Возвращаемое значение:
//   Число - меньший из заданных таймаутов в мс; 0, если оба без ограничения
//
Функция МеньшийТаймаут(ТаймаутМс, ДругойТаймаутМс) Экспорт
    Если НЕ ЗначениеЗаполнено(ТаймаутМс) Тогда
        Возврат ?(ЗначениеЗаполнено(ДругойТаймаутМс), ДругойТаймаутМс, 0);
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(ДругойТаймаутМс) Тогда
        Возврат ТаймаутМс;
    КонецЕсли;
    Возврат Мин(ТаймаутМс, ДругойТаймаутМс);
КонецФункции

// Вызывает метод компонента с временем, оставшимся до общего срока, и перехватывает
// исключение: оно возвращается ошибкой, чтобы вызывающий продолжил закрытие остальных.
//
// Параметры:
//   Компонент - Произвольный - объект с методом ИмяМетода
//   ИмяМетода - Строка - имя метода (Закрыть, СброситьБуфер)
//   НачалоМс - Число - начало операции (ТекущаяУниверсальнаяДатаВМиллисекундах)
//   ТаймаутМс - Число - общий срок в мс; 0 - без ограничения (метод вызывается без параметров)
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия, ОтелРезультатЭкспорта, Булево, Неопределено - результат метода
//       или ошибка с описанием исключения
//
Функция ВызватьВПределахСрока(Компонент, ИмяМетода, НачалоМс, ТаймаутМс) Экспорт
    Параметры = Новый Массив();
    Если ТаймаутМс > 0 Тогда
        Параметры.Добавить(ОставшеесяВремя(НачалоМс, ТаймаутМс));
    КонецЕсли;
    Попытка
        Возврат ВызватьМетод(Компонент, ИмяМетода, Параметры);
    Исключение
        Возврат Ошибка(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
КонецФункции

// Сводит результаты операций над несколькими компонентами: ошибка, если среди них есть
// ошибка; иначе таймаут, если есть таймаут или истек общий срок; иначе успех.
// Результат, не являющийся результатом операции (Неопределено у процедуры), считается успехом.
//
// Параметры:
//   Результаты - Массив из ОтелРезультатЗакрытия, ОтелРезультатЭкспорта, Булево, Неопределено
//   ИстекСрок - Булево - истек ли общий срок операции (необязательный)
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия
//
Функция Свести(Результаты, ИстекСрок = Ложь) Экспорт
    Ошибки = Новый Массив();
    ЕстьТаймаут = ИстекСрок;
    Для Каждого Результат Из Результаты Цикл
        Если Результат = Ложь Тогда
            Ошибки.Добавить("операция вернула Ложь");
        ИначеЕсли НЕ ЭтоРезультатОперации(Результат) ИЛИ Результат.Успешно() Тогда
            Продолжить;
        ИначеЕсли Результат.ИстекТаймаут() Тогда
            ЕстьТаймаут = Истина;
        Иначе
            Ошибки.Добавить(ОписаниеОшибкиРезультата(Результат));
        КонецЕсли;
    КонецЦикла;
    Если Ошибки.Количество() > 0 Тогда
        Возврат Ошибка(СтрСоединить(Ошибки, "; "));
    КонецЕсли;
    Если ЕстьТаймаут Тогда
        Возврат Таймаут();
    КонецЕсли;
    Возврат Успех();
КонецФункции

// Закрывает транспорт экспортера, если транспорт создала библиотека (автоконфигурация, файл
// конфигурации), как Java SDK закрывает созданный им канал. Транспорт, переданный
// пользователем, остается открытым: его закрывает пользователь, транспорт может быть общим
// для нескольких экспортеров.
//
// Параметры:
//   ЗакрыватьТранспорт - Булево - транспорт создан библиотекой и закрывается вместе с экспортером
//   Транспорт - Произвольный - транспорт экспортера с процедурой Закрыть
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия - успех; ошибка, если закрытие транспорта бросило исключение
//
Функция ЗакрытьТранспортЭкспортера(ЗакрыватьТранспорт, Транспорт) Экспорт
    Если НЕ ЗакрыватьТранспорт Тогда
        Возврат Успех();
    КонецЕсли;
    Попытка
        Транспорт.Закрыть();
    Исключение
        Возврат Ошибка(ОписаниеОшибки());
    КонецПопытки;
    Возврат Успех();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоРезультатОперации(Результат)
    ТипРезультата = ТипЗнч(Результат);
    Возврат ТипРезультата = Тип("ОтелРезультатЗакрытия") ИЛИ ТипРезультата = Тип("ОтелРезультатЭкспорта");
КонецФункции

Функция ОписаниеОшибкиРезультата(Результат)
    Если ТипЗнч(Результат) = Тип("ОтелРезультатЭкспорта") Тогда
        Возврат "сбой экспорта";
    КонецЕсли;
    Если Результат.Описание() <> "" Тогда
        Возврат Результат.Описание();
    КонецЕсли;
    Возврат "ошибка операции";
КонецФункции

#КонецОбласти
