// BSLLS:CommentedCode-off
// Модуль глобального реестра OpenTelemetry (GlobalOpenTelemetry).
// Аналог Java SDK: GlobalOpenTelemetry
// BSLLS:CommentedCode-on
//
// Хранит единственный экземпляр ОтелSdk для всего приложения, а также глобальные
// провайдеры сигналов и пропагаторы, которые можно установить и без SDK.
// Потокобезопасен: использует АтомарнаяСсылка для защиты от гонок.
//
// Пример:
//   ОтелГлобальный.Установить(Сдк);
//   Трассировщик = ОтелГлобальный.ПолучитьТрассировщик("мой-сервис");

#Использовать atomic

#Область ОписаниеПеременных

Перем Экземпляр; // АтомарнаяСсылка<ОтелSdk>
Перем ГлобальныеПропагаторы; // АтомарнаяСсылка<ОтелКомпозитныйПропагатор>
Перем НоопСдкКэш; // АтомарнаяСсылка<ОтелSdk> - отдельный кэш noop-провайдеров,
                  // не занимает слот Экземпляр (см. ПолучитьАктивныйСдк).
Перем ПропагаторыПоУмолчаниюКэш; // АтомарнаяСсылка<ОтелНоопПропагатор> - кэш no-op пропагатора,
                                  // который API использует, пока пропагаторы не настроены явно.
Перем ГлобальныйПровайдерТрассировки; // АтомарнаяСсылка<ОтелПровайдерТрассировки> - явно установленный
Перем ГлобальныйПровайдерЛогирования; // АтомарнаяСсылка<ОтелПровайдерЛогирования> - явно установленный
Перем ГлобальныйПровайдерМетрик; // АтомарнаяСсылка<ОтелПровайдерМетрик> - явно установленный

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Устанавливает глобальный экземпляр OpenTelemetry SDK.
// Может быть вызван только один раз; повторный вызов вызывает исключение.
// Потокобезопасен: использует CAS (compare-and-set).
//
// Параметры:
//   Сдк - ОтелSdk - экземпляр SDK
//
Процедура Установить(Сдк) Экспорт
    Если НЕ Экземпляр.СравнитьИУстановить(Неопределено, Сдк) Тогда
        ВызватьИсключение "Глобальный экземпляр OpenTelemetry уже установлен. Используйте Сбросить() для сброса.";
    КонецЕсли;
КонецПроцедуры

// Возвращает глобальный экземпляр OpenTelemetry SDK.
//
// Возвращаемое значение:
//   ОтелSdk, Неопределено
//
Функция Получить() Экспорт
    Возврат Экземпляр.Получить();
КонецФункции

// Сбрасывает глобальный экземпляр и явно установленные провайдеры. Предназначен для тестов.
//
Процедура Сбросить() Экспорт
    Экземпляр.Установить(Неопределено);
    СброситьКэши();
КонецПроцедуры

// Закрывает SDK и сбрасывает глобальный экземпляр. Предназначен для тестов.
// Явно установленные провайдеры сбрасываются без закрытия: ими владеет вызывающий код.
//
Процедура СброситьИЗакрыть() Экспорт
    Сдк = Экземпляр.ПолучитьИУстановить(Неопределено);
    Если Сдк <> Неопределено Тогда
        Сдк.Закрыть();
    КонецЕсли;
    // Сброс всех кэшей, чтобы последующий вызов Получить() не вернул устаревшие значения
    СброситьКэши();
КонецПроцедуры

// Shortcut: получить трассировщик из глобального провайдера трассировки.
//
// Параметры:
//   ИмяБиблиотеки - Строка - имя инструментирующей библиотеки
//   ВерсияБиблиотеки - Строка - версия (необязательный)
//
// Возвращаемое значение:
//   ОтелТрассировщик
//
Функция ПолучитьТрассировщик(ИмяБиблиотеки, ВерсияБиблиотеки = "") Экспорт
    Возврат ПолучитьПровайдерТрассировки().ПолучитьТрассировщик(ИмяБиблиотеки, ВерсияБиблиотеки);
КонецФункции

// Shortcut: получить логгер из глобального провайдера логирования.
//
// Параметры:
//   ИмяБиблиотеки - Строка - имя инструментирующей библиотеки
//   ВерсияБиблиотеки - Строка - версия (необязательный)
//
// Возвращаемое значение:
//   ОтелЛоггер
//
Функция ПолучитьЛоггер(ИмяБиблиотеки, ВерсияБиблиотеки = "") Экспорт
    Возврат ПолучитьПровайдерЛогирования().ПолучитьЛоггер(ИмяБиблиотеки, ВерсияБиблиотеки);
КонецФункции

// Shortcut: получить метр из глобального провайдера метрик.
//
// Параметры:
//   ИмяБиблиотеки - Строка - имя инструментирующей библиотеки
//   ВерсияБиблиотеки - Строка - версия (необязательный)
//
// Возвращаемое значение:
//   ОтелМетр
//
Функция ПолучитьМетр(ИмяБиблиотеки, ВерсияБиблиотеки = "") Экспорт
    Возврат ПолучитьПровайдерМетрик().ПолучитьМетр(ИмяБиблиотеки, ВерсияБиблиотеки);
КонецФункции

// Устанавливает глобальный провайдер трассировки (global default TracerProvider).
// Может использоваться независимо от SDK: установленный провайдер важнее провайдера
// зарегистрированного SDK.
//
// Параметры:
//   Провайдер - ОтелПровайдерТрассировки - провайдер трассировки
//
Процедура УстановитьПровайдерТрассировки(Провайдер) Экспорт
    ГлобальныйПровайдерТрассировки.Установить(Провайдер);
КонецПроцедуры

// Возвращает глобальный провайдер трассировки: установленный через УстановитьПровайдерТрассировки,
// иначе провайдер зарегистрированного SDK, иначе no-op провайдер.
//
// Возвращаемое значение:
//   ОтелПровайдерТрассировки - провайдер трассировки (не Неопределено)
//
Функция ПолучитьПровайдерТрассировки() Экспорт
    Провайдер = ГлобальныйПровайдерТрассировки.Получить();
    Если Провайдер = Неопределено Тогда
        Провайдер = ПолучитьАктивныйСдк().ПровайдерТрассировки();
    КонецЕсли;
    Если Провайдер = Неопределено Тогда
        Провайдер = ПолучитьНоопСдк().ПровайдерТрассировки();
    КонецЕсли;
    Возврат Провайдер;
КонецФункции

// Устанавливает глобальный провайдер логирования (global default LoggerProvider).
// Может использоваться независимо от SDK: установленный провайдер важнее провайдера
// зарегистрированного SDK.
//
// Параметры:
//   Провайдер - ОтелПровайдерЛогирования - провайдер логирования
//
Процедура УстановитьПровайдерЛогирования(Провайдер) Экспорт
    ГлобальныйПровайдерЛогирования.Установить(Провайдер);
КонецПроцедуры

// Возвращает глобальный провайдер логирования: установленный через УстановитьПровайдерЛогирования,
// иначе провайдер зарегистрированного SDK, иначе no-op провайдер.
//
// Возвращаемое значение:
//   ОтелПровайдерЛогирования - провайдер логирования (не Неопределено)
//
Функция ПолучитьПровайдерЛогирования() Экспорт
    Провайдер = ГлобальныйПровайдерЛогирования.Получить();
    Если Провайдер = Неопределено Тогда
        Провайдер = ПолучитьАктивныйСдк().ПровайдерЛогирования();
    КонецЕсли;
    Если Провайдер = Неопределено Тогда
        Провайдер = ПолучитьНоопСдк().ПровайдерЛогирования();
    КонецЕсли;
    Возврат Провайдер;
КонецФункции

// Устанавливает глобальный провайдер метрик (global default MeterProvider).
// Может использоваться независимо от SDK: установленный провайдер важнее провайдера
// зарегистрированного SDK.
//
// Параметры:
//   Провайдер - ОтелПровайдерМетрик - провайдер метрик
//
Процедура УстановитьПровайдерМетрик(Провайдер) Экспорт
    ГлобальныйПровайдерМетрик.Установить(Провайдер);
КонецПроцедуры

// Возвращает глобальный провайдер метрик: установленный через УстановитьПровайдерМетрик,
// иначе провайдер зарегистрированного SDK, иначе no-op провайдер.
//
// Возвращаемое значение:
//   ОтелПровайдерМетрик - провайдер метрик (не Неопределено)
//
Функция ПолучитьПровайдерМетрик() Экспорт
    Провайдер = ГлобальныйПровайдерМетрик.Получить();
    Если Провайдер = Неопределено Тогда
        Провайдер = ПолучитьАктивныйСдк().ПровайдерМетрик();
    КонецЕсли;
    Если Провайдер = Неопределено Тогда
        Провайдер = ПолучитьНоопСдк().ПровайдерМетрик();
    КонецЕсли;
    Возврат Провайдер;
КонецФункции

// Устанавливает глобальные пропагаторы контекста.
// Может использоваться независимо от SDK.
//
// Параметры:
//   Пропагаторы - ОтелКомпозитныйПропагатор, ОтелНоопПропагатор - пропагаторы контекста
//
Процедура УстановитьПропагаторы(Пропагаторы) Экспорт
    ГлобальныеПропагаторы.Установить(Пропагаторы);
КонецПроцедуры

// Возвращает глобальные пропагаторы контекста.
// Если не установлены явно, возвращает пропагаторы из SDK. Если пропагаторы не настроены
// ни явно, ни в SDK, возвращает no-op пропагатор: API MUST использовать no-op пропагаторы,
// пока они не настроены явно. Автоконфигурация настраивает W3C Trace Context и W3C Baggage
// (OTEL_PROPAGATORS по умолчанию "tracecontext,baggage").
//
// Возвращаемое значение:
//   ОтелКомпозитныйПропагатор, ОтелНоопПропагатор - пропагаторы контекста
//
Функция ПолучитьПропагаторы() Экспорт
    Результат = ГлобальныеПропагаторы.Получить();
    Если Результат <> Неопределено Тогда
        Возврат Результат;
    КонецЕсли;

    Сдк = Экземпляр.Получить();
    Если Сдк <> Неопределено И Сдк.Пропагаторы() <> Неопределено Тогда
        Возврат Сдк.Пропагаторы();
    КонецЕсли;

    Возврат ПолучитьИлиСоздатьПропагаторыПоУмолчанию();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает установленный пользователем SDK, либо (если не установлен) - кэшированный
// noop-SDK с AlwaysOff семплером, провайдерами логирования/метрик без процессоров и
// читателей. Кэш хранится отдельно от слота глобального экземпляра, поэтому вызов
// shortcut-методов до ОтелSdk.Создать не блокирует последующую конфигурацию.
//
// Возвращаемое значение:
//   ОтелSdk - активный или noop-SDK
//
Функция ПолучитьАктивныйСдк()
    Сдк = Экземпляр.Получить();
    Если Сдк <> Неопределено Тогда
        Возврат Сдк;
    КонецЕсли;
    Возврат ПолучитьНоопСдк();
КонецФункции

// Возвращает кэшированный noop-SDK (см. ПолучитьАктивныйСдк).
//
// Возвращаемое значение:
//   ОтелSdk - noop-SDK
//
Функция ПолучитьНоопСдк()
    НоопСдк = НоопСдкКэш.Получить();
    Если НоопСдк <> Неопределено Тогда
        Возврат НоопСдк;
    КонецЕсли;

    // SDK без провайдеров состоит из no-op провайдеров
    Кандидат = Новый ОтелSdk();
    Если НЕ НоопСдкКэш.СравнитьИУстановить(Неопределено, Кандидат) Тогда
        Кандидат.Закрыть();
    КонецЕсли;
    Возврат НоопСдкКэш.Получить();
КонецФункции

// Возвращает кэшированный no-op пропагатор - пропагаторы API по умолчанию: спецификация
// OpenTelemetry требует no-op, пока пропагаторы не настроены явно.
// Кэш хранится отдельно и создается лениво при первом обращении.
//
// Возвращаемое значение:
//   ОтелНоопПропагатор - пропагатор по умолчанию
//
Функция ПолучитьИлиСоздатьПропагаторыПоУмолчанию()
    Кэш = ПропагаторыПоУмолчаниюКэш.Получить();
    Если Кэш <> Неопределено Тогда
        Возврат Кэш;
    КонецЕсли;

    ПропагаторыПоУмолчаниюКэш.СравнитьИУстановить(Неопределено, Новый ОтелНоопПропагатор());
    Возврат ПропагаторыПоУмолчаниюКэш.Получить();
КонецФункции

Процедура СброситьКэши()
    ГлобальныеПропагаторы.Установить(Неопределено);
    НоопСдкКэш.Установить(Неопределено);
    ПропагаторыПоУмолчаниюКэш.Установить(Неопределено);
    ГлобальныйПровайдерТрассировки.Установить(Неопределено);
    ГлобальныйПровайдерЛогирования.Установить(Неопределено);
    ГлобальныйПровайдерМетрик.Установить(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область Инициализация

Экземпляр = Новый АтомарнаяСсылка(Неопределено);
ГлобальныеПропагаторы = Новый АтомарнаяСсылка(Неопределено);
НоопСдкКэш = Новый АтомарнаяСсылка(Неопределено);
ПропагаторыПоУмолчаниюКэш = Новый АтомарнаяСсылка(Неопределено);
ГлобальныйПровайдерТрассировки = Новый АтомарнаяСсылка(Неопределено);
ГлобальныйПровайдерЛогирования = Новый АтомарнаяСсылка(Неопределено);
ГлобальныйПровайдерМетрик = Новый АтомарнаяСсылка(Неопределено);

#КонецОбласти
