// Фабрика ресурсов OpenTelemetry.
// Аналог статических методов Java SDK: Resource.empty(), Resource.getDefault(),
// а также ресурсов детекторов и окружения, которые в Java собирает autoconfigure.

#Использовать extends
#Использовать logos

#Область ПрограммныйИнтерфейс

// Возвращает пустой ресурс.
// Аналог Java SDK: Resource.empty()
//
// Возвращаемое значение:
//   ОтелРесурс - ресурс без атрибутов и адреса схемы
//
Функция Пустой() Экспорт
    Возврат Новый ОтелРесурс();
КонецФункции

// Возвращает ресурс с атрибутами, которые SDK MUST заполнять сам (Resource SDK,
// SDK-provided resource attributes): service.name и telemetry.sdk.*. Детекторов и окружения
// в нем нет. Этот ресурс получают провайдеры, которым ресурс не передан явно.
// Аналог Java SDK: Resource.getDefault()
//
// Возвращаемое значение:
//   ОтелРесурс - новый ресурс с атрибутами по умолчанию
//
Функция ПоУмолчанию() Экспорт
    Атрибуты = Новый Соответствие();
    Атрибуты.Вставить("service.name", "unknown_service:oscript");
    // semconv: имя opentelemetry зарезервировано за официальным SDK проекта OpenTelemetry
    Атрибуты.Вставить("telemetry.sdk.name", "oscript-opentelemetry");
    Атрибуты.Вставить("telemetry.sdk.version", ОтелУтилиты.ВерсияSDK());
    Атрибуты.Вставить("telemetry.sdk.language", "oscript");
    Возврат Новый ОтелРесурс(Атрибуты);
КонецФункции

// Возвращает новый массив детекторов по умолчанию: хоста, процесса, процессора, контейнера
// и экземпляра сервиса. Массив можно изменить и передать в ИзДетекторов, например чтобы
// убрать детектор или добавить свой.
//
// Возвращаемое значение:
//   Массив из ИнтерфейсДетекторРесурса - детекторы по умолчанию
//
Функция ДетекторыПоУмолчанию() Экспорт
    Детекторы = Новый Массив;
    Детекторы.Добавить(Новый ОтелДетекторРесурсаХоста());
    Детекторы.Добавить(Новый ОтелДетекторРесурсаПроцесса());
    Детекторы.Добавить(Новый ОтелДетекторРесурсаПроцессора());
    Детекторы.Добавить(Новый ОтелДетекторРесурсаКонтейнера());
    Детекторы.Добавить(Новый ОтелДетекторРесурсаЭкземпляраСервиса());
    Возврат Детекторы;
КонецФункции

// Возвращает слияние ресурсов детекторов в порядке коллекции: атрибут детектора, идущего позже,
// важнее. Без параметра - детекторы по умолчанию: хоста, процесса, процессора, контейнера
// и экземпляра сервиса. Адрес схемы - версия семантических соглашений детекторов.
// Каждый детектор должен объявлять &Реализует("ИнтерфейсДетекторРесурса") и реализовывать его,
// иначе вызывается исключение: это ошибка настройки, по Error handling SDK может завершиться
// с ошибкой при инициализации. Исключение в Обнаружить() не прерывает сбор ресурса: ошибка
// пишется в лог, детектор пропускается.
//
// Параметры:
//   Детекторы - Массив из ИнтерфейсДетекторРесурса, ФиксированныйМассив из ИнтерфейсДетекторРесурса,
//       Неопределено - детекторы ресурса (необязательный, по умолчанию детекторы по умолчанию)
//
// Возвращаемое значение:
//   ОтелРесурс - ресурс с атрибутами детекторов
//
Функция ИзДетекторов(Детекторы = Неопределено) Экспорт
    Если Детекторы = Неопределено Тогда
        Детекторы = ДетекторыПоУмолчанию();
    КонецЕсли;

    Валидатор = Новый ВалидаторРеализации();
    Ресурс = Пустой();
    Для Каждого Детектор Из Детекторы Цикл
        Валидатор.РеализуетИнтерфейс(Детектор, "ИнтерфейсДетекторРесурса", Истина);
        Попытка
            РесурсДетектора = Детектор.Обнаружить();
        Исключение
            Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.resource");
            Лог.Ошибка("Детектор ресурса %1 завершился с ошибкой, детектор пропущен: %2",
                Детектор, ОписаниеОшибки());
            Продолжить;
        КонецПопытки;
        Ресурс = Ресурс.Слить(РесурсДетектора);
    КонецЦикла;
    Возврат Ресурс;
КонецФункции

// Возвращает ресурс из переменных окружения: атрибуты OTEL_RESOURCE_ATTRIBUTES и имя
// сервиса OTEL_SERVICE_NAME, которое важнее service.name из OTEL_RESOURCE_ATTRIBUTES.
// По спецификации Resource SDK значение OTEL_RESOURCE_ATTRIBUTES с ошибкой (элемент не
// в формате ключ=значение, пустой ключ, сбой URL-декодирования) отбрасывается целиком,
// ошибка пишется в лог. Пустые элементы (лишние запятые) пропускаются.
//
// Возвращаемое значение:
//   ОтелРесурс - ресурс с атрибутами из окружения, без адреса схемы
//
Функция ИзОкружения() Экспорт
    Ресурс = Пустой();

    СтрокаАтрибутов = ПрочитатьПеременнуюСреды("OTEL_RESOURCE_ATTRIBUTES");
    Если ЗначениеЗаполнено(СтрокаАтрибутов) Тогда
        РазобранныеАтрибуты = РазобратьСтрокуАтрибутовРесурса(СтрокаАтрибутов);
        Если РазобранныеАтрибуты <> Неопределено Тогда
            Для Каждого КлючИЗначение Из РазобранныеАтрибуты Цикл
                Ресурс.Атрибуты().Установить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
            КонецЦикла;
        КонецЕсли;
    КонецЕсли;

    ИмяСервиса = ПрочитатьПеременнуюСреды("OTEL_SERVICE_NAME");
    Если ЗначениеЗаполнено(ИмяСервиса) Тогда
        Ресурс.Атрибуты().Установить("service.name", ИмяСервиса);
    КонецЕсли;

    Возврат Ресурс;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разбирает строку OTEL_RESOURCE_ATTRIBUTES в Соответствие.
//
// Параметры:
//   СтрокаАтрибутов - Строка - сырое значение OTEL_RESOURCE_ATTRIBUTES
//
// Возвращаемое значение:
//   Соответствие, Неопределено - пары ключ-значение или Неопределено при ошибке
//
Функция РазобратьСтрокуАтрибутовРесурса(Знач СтрокаАтрибутов)
    Результат = Новый Соответствие();
    Попытка
        Пары = СтрРазделить(СтрокаАтрибутов, ",", Ложь);
        Для Каждого Пара Из Пары Цикл
            Если ПустаяСтрока(Пара) Тогда
                Продолжить;
            КонецЕсли;
            ПозицияРавно = СтрНайти(Пара, "=");
            Ключ = "";
            Если ПозицияРавно > 0 Тогда
                Ключ = СокрЛП(Лев(Пара, ПозицияРавно - 1));
            КонецЕсли;
            Если Ключ = "" Тогда
                ВызватьИсключение СтрШаблон("элемент '%1' не в формате ключ=значение", СокрЛП(Пара));
            КонецЕсли;
            Значение = СокрЛП(Сред(Пара, ПозицияРавно + 1));
            Ключ = ОтелУтилиты.РаскодироватьURLСтрого(Ключ);
            Значение = ОтелУтилиты.РаскодироватьURLСтрого(Значение);
            Результат.Вставить(Ключ, Значение);
        КонецЦикла;
    Исключение
        Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.resource");
        Лог.Ошибка(
            "Не удалось разобрать OTEL_RESOURCE_ATTRIBUTES, значение игнорируется: %1",
            ОписаниеОшибки());
        Возврат Неопределено;
    КонецПопытки;
    Возврат Результат;
КонецФункции

// Безопасная обертка над встроенной ПолучитьПеременнуюСреды: возвращает Неопределено,
// если рантайм бросает исключение для незаданной переменной.
//
// Параметры:
//   Имя - Строка - имя переменной среды
//
// Возвращаемое значение:
//   Строка, Неопределено - значение переменной среды или Неопределено при ошибке
//
Функция ПрочитатьПеременнуюСреды(Имя)
    Попытка
        Возврат ПолучитьПеременнуюСреды(Имя);
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

#КонецОбласти
