#Использовать logos

#Область ОписаниеПеременных

// Строка - имя потока метрики
Перем Имя;
// Строка - описание потока метрики
Перем Описание;
// Строка - единица измерения
Перем ЕдиницаИзмерения;
// Строка - вид инструмента (Counter, Histogram, ...)
Перем ВидИнструмента;
// Объект - агрегатор потока
Перем Агрегатор;
// Булево - агрегатор отбрасывает измерения (Drop)
Перем Отбрасывание;
// ОтелОбработчикАтрибутов - фильтр атрибутов потока
Перем ОбработчикАтрибутов;
// Число - сколько наборов атрибутов получают свою серию до переполнения
Перем ЛимитМощности;
// Число - фильтр exemplars из ОтелФильтрЭкземпляров
Перем ФильтрЭкземпляров;
// Объект, Неопределено - фабрика резервуаров exemplars: у каждой серии свой резервуар
Перем ФабрикаРезервуаров;
// Объект, Неопределено - устаревший резервуар, общий для всех серий
Перем ОбщийРезервуар;
// Структура - текущий интервал сбора:
//   * Серии - Соответствие - ключ набора атрибутов -> серия
//   * Переполнение - Структура, Неопределено - серия переполнения
//   * ВремяСтарта - Число - начало интервала в наносекундах
Перем Интервал;
// БлокировкаРесурса - защищает интервал: запись, создание серий и начало нового интервала
Перем Блокировка;
// БлокировкаРесурса - сериализует сборы потока
Перем БлокировкаСбора;
// Объект - логгер
Перем Лог;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Хранилище - потокобезопасный объект: запись, сбор и очистка безопасны для
// конкурентного вызова. Каждое измерение попадает ровно в один интервал сбора.

// Записывает измерение в серию его набора атрибутов после фильтра потока. Новый набор
// сверх лимита мощности агрегируется в серии переполнения.
//
// Параметры:
//   Значение - Число - значение измерения
//   Атрибуты - ОтелАтрибуты, Неопределено - атрибуты измерения
//   Контекст - Соответствие, Неопределено - контекст измерения (для exemplars)
//
Процедура Записать(Знач Значение, Атрибуты = Неопределено, Контекст = Неопределено) Экспорт
    Если Отбрасывание Тогда
        Возврат;
    КонецЕсли;
    АтрибутыСерии = ОбработчикАтрибутов.Обработать(Атрибуты);
    Ключ = КлючНабора(АтрибутыСерии);
    ЗахватитьЭкземпляр = ЕстьРезервуар()
        И ОтелФильтрЭкземпляров.ДолженЗахватить(ФильтрЭкземпляров, Контекст);

    Блокировка.Заблокировать();
    Попытка
        Серия = СерияДляЗаписи(Ключ, АтрибутыСерии);
        Агрегатор.Записать(Серия.Аккумулятор, Значение);
        Если ЗахватитьЭкземпляр Тогда
            ПредложитьЭкземпляр(Серия, Значение, Атрибуты, Контекст);
        КонецЕсли;
    Исключение
        Блокировка.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
    Блокировка.Разблокировать();
КонецПроцедуры

// Собирает данные потока с временной агрегацией читателя. Дельта-сбор атомарно
// начинает новый интервал: измерения, записанные во время сбора, попадают в следующий.
// Кумулятивный сбор сохраняет серии и время старта. Exemplars относятся к интервалу
// между сборами.
//
// Параметры:
//   Ресурс - ОтелРесурс - ресурс
//   ОбластьИнструментирования - ОтелОбластьИнструментирования - область
//   Временность - Число - значение из ОтелВременнаяАгрегация
//   ВремяСбора - Строка, Неопределено - время сбора читателя в наносекундах: конец интервала
//       и начало следующего дельта-интервала; Неопределено - текущее время
//
// Возвращаемое значение:
//   ОтелДанныеМетрики, Неопределено - Неопределено, если точек нет
//
Функция Собрать(Ресурс, ОбластьИнструментирования, Временность, ВремяСбора = Неопределено) Экспорт
    Если Отбрасывание Тогда
        Возврат Неопределено;
    КонецЕсли;
    Дельта = (Временность = ОтелВременнаяАгрегация.Дельта());
    БлокировкаСбора.Заблокировать();
    Попытка
        Снимок = СнимокИнтервала(Дельта, Истина, ВремяСбора);
    Исключение
        БлокировкаСбора.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
    БлокировкаСбора.Разблокировать();

    Данные = СформироватьДанные(Ресурс, ОбластьИнструментирования, Имя, Описание, Снимок);
    Если Данные <> Неопределено Тогда
        Данные.УстановитьВременнуюАгрегацию(Временность);
    КонецЕсли;
    Возврат Данные;
КонецФункции

// Возвращает текущие данные потока, не начиная новый интервал и не сбрасывая exemplars.
// Используется прямым вызовом Собрать инструмента; интервал начинает ОчиститьТочкиДанных.
//
// Параметры:
//   Ресурс - ОтелРесурс - ресурс
//   ОбластьИнструментирования - ОтелОбластьИнструментирования - область
//   ИмяМетрики - Строка - имя метрики
//   ОписаниеМетрики - Строка - описание метрики
//
// Возвращаемое значение:
//   ОтелДанныеМетрики, Неопределено - Неопределено, если точек нет
//
Функция СобратьСнимок(Ресурс, ОбластьИнструментирования, ИмяМетрики, ОписаниеМетрики) Экспорт
    Если Отбрасывание Тогда
        Возврат Неопределено;
    КонецЕсли;
    Снимок = СнимокИнтервала(Ложь, Ложь, Неопределено);
    Возврат СформироватьДанные(Ресурс, ОбластьИнструментирования, ИмяМетрики, ОписаниеМетрики, Снимок);
КонецФункции

// Завершает интервал после сбора снимка: для дельта-временности начинается новый
// интервал без серий и exemplars, для кумулятивной сбрасываются только exemplars.
//
// Параметры:
//   Временность - Число, Неопределено - значение из ОтелВременнаяАгрегация; по умолчанию дельта
//
Процедура ОчиститьТочкиДанных(Временность = Неопределено) Экспорт
    Дельта = (Временность <> ОтелВременнаяАгрегация.Кумулятивная());
    Блокировка.Заблокировать();
    Попытка
        Если Дельта Тогда
            Интервал = НовыйИнтервал(ОтелУтилиты.ТекущееВремяВНаносекундах());
            ОчиститьОбщийРезервуар();
        Иначе
            ОбновитьРезервуарыИнтервала();
        КонецЕсли;
    Исключение
        Блокировка.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
    Блокировка.Разблокировать();
КонецПроцедуры

// Возвращает количество серий текущего интервала, включая серию переполнения.
//
// Возвращаемое значение:
//   Число
//
Функция КоличествоСерий() Экспорт
    Блокировка.Заблокировать();
    Количество = Интервал.Серии.Количество();
    Если Интервал.Переполнение <> Неопределено Тогда
        Количество = Количество + 1;
    КонецЕсли;
    Блокировка.Разблокировать();
    Возврат Количество;
КонецФункции

// Возвращает имя потока метрики.
//
// Возвращаемое значение:
//   Строка
//
Функция Имя() Экспорт
    Возврат Имя;
КонецФункции

// Возвращает описание потока метрики.
//
// Возвращаемое значение:
//   Строка
//
Функция Описание() Экспорт
    Возврат Описание;
КонецФункции

// Возвращает единицу измерения потока.
//
// Возвращаемое значение:
//   Строка
//
Функция ЕдиницаИзмерения() Экспорт
    Возврат ЕдиницаИзмерения;
КонецФункции

// Возвращает вид инструмента потока.
//
// Возвращаемое значение:
//   Строка - Counter, UpDownCounter, Histogram, Gauge, ExponentialHistogram
//
Функция Вид() Экспорт
    Возврат ВидИнструмента;
КонецФункции

// Возвращает признак агрегации Drop: поток отбрасывает измерения.
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоОтбрасывание() Экспорт
    Возврат Отбрасывание;
КонецФункции

// Возвращает агрегатор потока.
//
// Возвращаемое значение:
//   Объект
//
Функция Агрегатор() Экспорт
    Возврат Агрегатор;
КонецФункции

// Возвращает лимит мощности потока.
//
// Возвращаемое значение:
//   Число
//
Функция ЛимитМощности() Экспорт
    Возврат ЛимитМощности;
КонецФункции

// Устанавливает лимит мощности: сколько наборов атрибутов получают свою серию.
//
// Параметры:
//   Лимит - Число - лимит мощности
//
Процедура УстановитьЛимитМощности(Лимит) Экспорт
    ЛимитМощности = Лимит;
КонецПроцедуры

// Устанавливает фильтр атрибутов потока.
//
// Параметры:
//   РазрешенныеКлючи - Массив из Строка, Неопределено - allow-list
//   ИсключенныеКлючи - Массив из Строка, Неопределено - exclude-list
//
Процедура УстановитьФильтрАтрибутов(РазрешенныеКлючи, ИсключенныеКлючи) Экспорт
    ОбработчикАтрибутов = Новый ОтелОбработчикАтрибутов(РазрешенныеКлючи, ИсключенныеКлючи);
КонецПроцедуры

// Устанавливает фильтр exemplars. При фильтре ВсегдаВыключен резервуары серий не создаются
// (накладных расходов на exemplars нет), поэтому резервуары серий текущего интервала создаются
// заново по новому фильтру.
//
// Параметры:
//   Фильтр - Число - значение из ОтелФильтрЭкземпляров
//
Процедура УстановитьФильтрЭкземпляров(Фильтр) Экспорт
    Блокировка.Заблокировать();
    ФильтрЭкземпляров = Фильтр;
    Попытка
        ОбновитьРезервуарыИнтервала();
    Исключение
        Блокировка.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
    Блокировка.Разблокировать();
КонецПроцедуры

// Устанавливает фабрику резервуаров exemplars: каждая серия получает свой резервуар.
//
// Параметры:
//   Фабрика - Объект, Неопределено - объект с методом СоздатьРезервуар(); Неопределено - без exemplars
//
Процедура УстановитьФабрикуРезервуаров(Фабрика) Экспорт
    Блокировка.Заблокировать();
    ФабрикаРезервуаров = Фабрика;
    ОбщийРезервуар = Неопределено;
    Попытка
        ОбновитьРезервуарыИнтервала();
    Исключение
        Блокировка.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
    Блокировка.Разблокировать();
КонецПроцедуры

// Устанавливает один резервуар exemplars для всех серий потока.
// Устаревший способ: резервуар должен создаваться на серию (УстановитьФабрикуРезервуаров).
//
// Параметры:
//   Резервуар - Объект - резервуар exemplars
//
Процедура УстановитьРезервуарЭкземпляров(Резервуар) Экспорт
    Блокировка.Заблокировать();
    ОбщийРезервуар = Резервуар;
    ФабрикаРезервуаров = Неопределено;
    Блокировка.Разблокировать();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает серию для записи в текущем интервале. Вызывается под блокировкой.
//
// Параметры:
//   Ключ - Строка - ключ набора атрибутов серии
//   АтрибутыСерии - ОтелАтрибуты, Неопределено - атрибуты после фильтра потока
//
// Возвращаемое значение:
//   Структура - серия
//
Функция СерияДляЗаписи(Ключ, АтрибутыСерии)
    Серия = Интервал.Серии.Получить(Ключ);
    Если Серия <> Неопределено Тогда
        Возврат Серия;
    КонецЕсли;
    Если Интервал.Серии.Количество() >= ЛимитМощности Тогда
        Если Интервал.Переполнение = Неопределено Тогда
            Интервал.Переполнение = НоваяСерия(КлючПереполнения(), АтрибутыПереполнения());
        КонецЕсли;
        Возврат Интервал.Переполнение;
    КонецЕсли;
    Серия = НоваяСерия(Ключ, КопияАтрибутов(АтрибутыСерии));
    Интервал.Серии.Вставить(Ключ, Серия);
    Возврат Серия;
КонецФункции

Функция НоваяСерия(Ключ, АтрибутыСерии)
    Серия = Новый Структура("Ключ, Аккумулятор, Атрибуты, Резервуар");
    Серия.Ключ = Ключ;
    Серия.Аккумулятор = Агрегатор.СоздатьАккумулятор();
    Серия.Атрибуты = АтрибутыСерии;
    Серия.Резервуар = НовыйРезервуар();
    Возврат Серия;
КонецФункции

Функция НовыйИнтервал(ВремяСтарта)
    Возврат Новый Структура("Серии, Переполнение, ВремяСтарта", Новый Соответствие(), Неопределено, ВремяСтарта);
КонецФункции

// Возвращает серии интервала для формирования точек. Дельта-снимок начинает новый
// интервал: в старый больше никто не пишет. Кумулятивный снимок копирует список серий,
// а exemplars серий забирает под блокировкой. Exemplars общего резервуара забираются под
// блокировкой при любой временности.
//
// Параметры:
//   Дельта - Булево - начать новый интервал
//   СброситьЭкземпляры - Булево - для кумулятивного снимка начать новый интервал exemplars
//   ВремяСбора - Строка, Неопределено - время сбора; Неопределено - текущее время
//
// Возвращаемое значение:
//   Структура - снимок интервала:
//     * Серии - Массив из Структура - серии интервала
//     * Экземпляры - Массив из Массив - exemplars серии с тем же индексом
//     * ВремяСтарта - Число - начало интервала в наносекундах
//     * ВремяСбора - Число - время сбора в наносекундах
//
Функция СнимокИнтервала(Дельта, СброситьЭкземпляры, ВремяСбора)
    Снимок = Новый Структура("Серии, Экземпляры, ВремяСтарта, ВремяСбора", Новый Массив(), Новый Массив());
    Блокировка.Заблокировать();
    Попытка
        Снимок.ВремяСбора = ?(ВремяСбора = Неопределено, ОтелУтилиты.ТекущееВремяВНаносекундах(), ВремяСбора);
        Собираемый = Интервал;
        Если Дельта Тогда
            Интервал = НовыйИнтервал(Снимок.ВремяСбора);
        КонецЕсли;
        Снимок.ВремяСтарта = Собираемый.ВремяСтарта;
        Для Каждого КлючИСерия Из Собираемый.Серии Цикл
            Снимок.Серии.Добавить(КлючИСерия.Значение);
        КонецЦикла;
        Если Собираемый.Переполнение <> Неопределено Тогда
            Снимок.Серии.Добавить(Собираемый.Переполнение);
        КонецЕсли;
        // Резервуары серий дельта-интервала читаются после блокировки: в старый интервал больше
        // никто не пишет. Общий резервуар переходит в следующий интервал, поэтому его exemplars
        // забираются и сбрасываются под блокировкой
        ЭкземплярыПослеБлокировки = Дельта И ОбщийРезервуар = Неопределено;
        Если НЕ ЭкземплярыПослеБлокировки Тогда
            ЗабратьЭкземпляры(Снимок, СброситьЭкземпляры);
        КонецЕсли;
    Исключение
        Блокировка.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
    Блокировка.Разблокировать();
    Если ЭкземплярыПослеБлокировки Тогда
        ЗабратьЭкземпляры(Снимок, Ложь);
    КонецЕсли;
    Возврат Снимок;
КонецФункции

Процедура ЗабратьЭкземпляры(Снимок, СброситьЭкземпляры)
    Для Каждого Серия Из Снимок.Серии Цикл
        Снимок.Экземпляры.Добавить(ЭкземплярыСерии(Серия));
        // Серия без резервуара из-за сбоя фабрики тоже получает новый резервуар
        Если СброситьЭкземпляры Тогда
            Серия.Резервуар = НовыйРезервуар();
        КонецЕсли;
    КонецЦикла;
    Если СброситьЭкземпляры Тогда
        ОчиститьОбщийРезервуар();
    КонецЕсли;
КонецПроцедуры

Функция СформироватьДанные(Ресурс, ОбластьИнструментирования, ИмяМетрики, ОписаниеМетрики, Снимок)
    Точки = Новый Массив();
    Для Индекс = 0 По Снимок.Серии.ВГраница() Цикл
        Серия = Снимок.Серии[Индекс];
        АтрибутыOtlp = ?(Серия.Атрибуты = Неопределено, Новый Массив(), Серия.Атрибуты.ВМассивOtlp());
        Точка = Агрегатор.СформироватьТочкуДанных(Серия.Аккумулятор, Снимок.ВремяСтарта, Снимок.ВремяСбора,
            АтрибутыOtlp, Снимок.Экземпляры[Индекс]);
        Если Точка <> Неопределено Тогда
            Точки.Добавить(Точка);
        КонецЕсли;
    КонецЦикла;
    Если Точки.Количество() = 0 Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат Агрегатор.СформироватьДанныеМетрики(Ресурс, ОбластьИнструментирования,
        ИмяМетрики, ОписаниеМетрики, ЕдиницаИзмерения, Точки);
КонецФункции

// Возвращает exemplars серии. Сбой резервуара (исключение или результат, который нельзя обойти)
// логируется: точка данных серии выдается без exemplars. Неопределено вместо массива - exemplars нет.
//
// Параметры:
//   Серия - Структура - серия интервала
//
// Возвращаемое значение:
//   Массив из Соответствие - копия exemplars резервуара
//
Функция ЭкземплярыСерии(Серия)
    Резервуар = ?(Серия.Резервуар <> Неопределено, Серия.Резервуар, ОбщийРезервуар);
    Копия = Новый Массив();
    Если Резервуар = Неопределено Тогда
        Возврат Копия;
    КонецЕсли;
    Попытка
        Собранные = Резервуар.Собрать(Серия.Ключ);
        Если Собранные = Неопределено Тогда
            Возврат Копия;
        КонецЕсли;
        // Резервуар отдает свой массив: копия не меняется последующими измерениями
        Для Каждого Экземпляр Из Собранные Цикл
            Копия.Добавить(Экземпляр);
        КонецЦикла;
    Исключение
        Лог.Предупреждение("Exemplars потока метрики '%1' не собраны: ошибка резервуара: %2", Имя,
            ОписаниеОшибки());
        Возврат Новый Массив();
    КонецПопытки;
    Возврат Копия;
КонецФункции

// Заменяет резервуары серий текущего интервала новыми. Вызывается под блокировкой.
//
Процедура ОбновитьРезервуарыИнтервала()
    Для Каждого КлючИСерия Из Интервал.Серии Цикл
        КлючИСерия.Значение.Резервуар = НовыйРезервуар();
    КонецЦикла;
    Если Интервал.Переполнение <> Неопределено Тогда
        Интервал.Переполнение.Резервуар = НовыйРезервуар();
    КонецЕсли;
    ОчиститьОбщийРезервуар();
КонецПроцедуры

// Очищает общий резервуар потока. Вызывается под блокировкой. Резервуар, который не удалось
// очистить, отключается, чтобы следующие точки не получили exemplars прошлых интервалов: точки
// потока выдаются без exemplars. Сбой резервуара логируется.
//
Процедура ОчиститьОбщийРезервуар()
    Если ОбщийРезервуар = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Попытка
        ОбщийРезервуар.Очистить();
    Исключение
        Лог.Предупреждение("Резервуар exemplars потока метрики '%1' не очищен и отключен: %2", Имя,
            ОписаниеОшибки());
        ОбщийРезервуар = Неопределено;
    КонецПопытки;
КонецПроцедуры

// Возвращает новый резервуар серии. Сбой фабрики логируется: серия остается без резервуара до
// следующего интервала сбора, измерения агрегируются без exemplars.
//
// Возвращаемое значение:
//   Объект, Неопределено - резервуар; Неопределено - без exemplars
//
Функция НовыйРезервуар()
    Если ФабрикаРезервуаров = Неопределено ИЛИ ЭкземплярыВыключены() Тогда
        Возврат Неопределено;
    КонецЕсли;
    Попытка
        Возврат ФабрикаРезервуаров.СоздатьРезервуар();
    Исключение
        Лог.Предупреждение("Резервуар exemplars потока метрики '%1' не создан: %2", Имя, ОписаниеОшибки());
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

Функция ЕстьРезервуар()
    Если ЭкземплярыВыключены() Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат ФабрикаРезервуаров <> Неопределено ИЛИ ОбщийРезервуар <> Неопределено;
КонецФункции

// Проверяет, что сэмплирование exemplars выключено: фильтр ВсегдаВыключен.
//
// Возвращаемое значение:
//   Булево
//
Функция ЭкземплярыВыключены()
    Возврат ФильтрЭкземпляров = ОтелФильтрЭкземпляров.ВсегдаВыключен();
КонецФункции

// Предлагает измерение резервуару серии. Атрибуты серии переполнения не содержат
// атрибутов измерения, поэтому exemplar сохраняет их все как отфильтрованные.
//
// Параметры:
//   Серия - Структура - серия измерения
//   Значение - Число - значение измерения
//   АтрибутыИзмерения - ОтелАтрибуты, Неопределено - исходные атрибуты измерения
//   Контекст - Соответствие, Неопределено - контекст измерения
//
Процедура ПредложитьЭкземпляр(Серия, Значение, АтрибутыИзмерения, Контекст)
    Резервуар = ?(Серия.Резервуар <> Неопределено, Серия.Резервуар, ОбщийРезервуар);
    Если Резервуар = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Попытка
        Резервуар.Предложить(Серия.Ключ, Значение, АтрибутыИзмерения, Серия.Атрибуты,
            КонтекстСпанаИзмерения(Контекст), Неопределено, Контекст);
    Исключение
        Лог.Отладка("Ошибка при захвате exemplar: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

Функция КонтекстСпанаИзмерения(Контекст)
    Спан = ОтелКонтекст.СпанИзКонтекста(Контекст);
    Если Спан = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Кандидат = Спан.КонтекстСпана();
    Если Кандидат = Неопределено ИЛИ НЕ Кандидат.Валиден() Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат Кандидат;
КонецФункции

Функция КлючНабора(АтрибутыСерии)
    Если АтрибутыСерии = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Возврат АтрибутыСерии.Ключ();
КонецФункции

// Копирует атрибуты новой серии: вызывающий код может изменить свой объект после записи.
//
// Параметры:
//   Атрибуты - ОтелАтрибуты, Неопределено - атрибуты серии
//
// Возвращаемое значение:
//   ОтелАтрибуты, Неопределено
//
Функция КопияАтрибутов(Атрибуты)
    Если Атрибуты = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Копия = Новый ОтелАтрибуты();
    Для Каждого КлючИЗначение Из Атрибуты.ВСоответствие() Цикл
        Копия.Установить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
    КонецЦикла;
    Возврат Копия;
КонецФункции

// Ключ серии переполнения не совпадает с ключом набора атрибутов: ОтелАтрибуты.Ключ()
// начинается с длины первой части.
//
// Возвращаемое значение:
//   Строка
//
Функция КлючПереполнения()
    Возврат "__overflow__";
КонецФункции

Функция АтрибутыПереполнения()
    Атрибуты = Новый ОтелАтрибуты();
    Атрибуты.Установить("otel.metric.overflow", Истина);
    Возврат Атрибуты;
КонецФункции

// Хранилище потока метрики синхронного инструмента (metric stream storage): агрегирует
// измерения одного инструмента для одного читателя и одного View.
//
// Параметры:
//   ИмяПотока - Строка - имя потока метрики
//   ОписаниеПотока - Строка - описание потока метрики
//   ЕдиницаПотока - Строка - единица измерения
//   АгрегаторПотока - Объект - агрегатор (ОтелАгрегаторСуммы и др.)
//   Вид - Строка - вид инструмента (необязательный)
//
Процедура ПриСозданииОбъекта(ИмяПотока, ОписаниеПотока, ЕдиницаПотока, АгрегаторПотока, Вид = "")
    ЛимитМощностиПоУмолчанию = 2000;
    Имя = ИмяПотока;
    Описание = ОписаниеПотока;
    ЕдиницаИзмерения = ЕдиницаПотока;
    ВидИнструмента = Вид;
    Агрегатор = АгрегаторПотока;
    Отбрасывание = ОтелАгрегация.ЭтоАгрегаторОтбрасывания(АгрегаторПотока);
    ОбработчикАтрибутов = Новый ОтелОбработчикАтрибутов();
    ЛимитМощности = ЛимитМощностиПоУмолчанию;
    ФильтрЭкземпляров = ОтелФильтрЭкземпляров.ПоТрассировке();
    ФабрикаРезервуаров = Новый ОтелФабрикаПростыхРезервуаров(1);
    ОбщийРезервуар = Неопределено;
    Блокировка = Новый БлокировкаРесурса();
    БлокировкаСбора = Новый БлокировкаРесурса();
    Интервал = НовыйИнтервал(ОтелУтилиты.ТекущееВремяВНаносекундах());
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics");
КонецПроцедуры

#КонецОбласти
