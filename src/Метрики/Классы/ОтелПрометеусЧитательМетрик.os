// BSLLS:MagicNumber-off
#Использовать logos
#Использовать atomic
#Использовать prometheus

#Область ОписаниеПеременных

// Массив - Массив зарегистрированных объектов ОтелМетр
Перем Метры;
// Массив из ИнтерфейсПродюсерМетрик - продюсеры внешних метрик (MetricProducer)
Перем Продюсеры;
// БлокировкаРесурса - Блокировка для потокобезопасного доступа
Перем Блокировка;
// Объект - Логгер библиотеки logos
Перем Лог;
// РегулярноеВыражение - предкомпилированные регулярки для нормализации имен
Перем РВНедопустимые;
// РегулярноеВыражение - замена дублирующих подчеркиваний
Перем РВДубли;
// РегулярноеВыражение - удаление подчеркивания в конце
Перем РВХвост;
// РегулярноеВыражение - замена цифры в начале имени
Перем РВЦифра;
// ОтелФильтрМетрик - Фильтр метрик для Produce
Перем ФильтрМетрик;
// АтомарноеБулево - признак регистрации у провайдера
Перем Зарегистрирован;
// Соответствие - слова Prometheus для единиц UCUM (таблица спецификации совместимости)
Перем СловаЕдиниц;
// Соответствие - слова для единиц времени в знаменателе скорости ("per_second")
Перем СловаЕдиницВремени;
// РегулярноеВыражение - части единицы в фигурных скобках ({packet})
Перем РВСкобки;
// Число - лимит мощности (cardinality limit) по умолчанию
Перем ЛимитМощности;
// Соответствие - лимиты мощности по виду инструмента (ВидИнструмента -> Число)
Перем ЛимитыМощностиПоВиду;
// Соответствие - агрегации по умолчанию по виду инструмента (ВидИнструмента -> агрегация)
Перем АгрегацииПоВиду;
// АтомарноеБулево - признак завершения работы (Shutdown): после него сбор и сброс возвращают ошибку
Перем Закрыт;
// Структура, Неопределено - шаблоны атрибутов ресурса, копируемых в лейблы метрик
//   (resource_constant_labels): Включаемые (Массив из РегулярноеВыражение, Неопределено - все) и
//   Исключаемые (Массив из РегулярноеВыражение); Неопределено - атрибуты ресурса не копируются
Перем ШаблоныАтрибутовРесурса;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Регистрирует Meter для сбора метрик.
//
// Параметры:
//   Метр - ОтелМетр - объект Meter с инструментами
//
Процедура ДобавитьМетр(Метр) Экспорт
    Блокировка.Заблокировать();
    Попытка
        Метры.Добавить(Метр);
        Блокировка.Разблокировать();
    Исключение
        Блокировка.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

// Регистрирует продюсер внешних метрик (MetricProducer): его метрики, например сводки (Summary) из
// мостов к другим библиотекам метрик, выдаются вместе с метриками метров. Продюсер получает фильтр
// метрик читателя с предпочтительной кумулятивной временной агрегацией; его суммы и гистограммы с
// временной агрегацией Дельта пропускаются с предупреждением.
//
// Параметры:
//   Продюсер - ИнтерфейсПродюсерМетрик - продюсер метрик
//
Процедура ДобавитьПродюсер(Продюсер) Экспорт
    Блокировка.Заблокировать();
    Попытка
        Продюсеры.Добавить(Продюсер);
        Блокировка.Разблокировать();
    Исключение
        Блокировка.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

// Pull-based collection: конвертирует OTel метрики в Prometheus text format 0.0.4. Текст формирует
// библиотека prometheus (Prometheus.СериализоватьВТекст) из семейств СобратьСемейства.
//
// Параметры:
//   РезультатСбора - Произвольный - выходной параметр: ОтелРезультатЭкспорта - ошибка, если сбор
//       метра или инструмента завершился сбоем (их метрики не попадают в выдачу); иначе успех
//
// Возвращаемое значение:
//   Строка - текст метрик в формате Prometheus text/plain 0.0.4; пустая строка, если метрик нет
//
Функция СобратьВТексте(РезультатСбора = Неопределено) Экспорт
    Семейства = СобратьСемейства(РезультатСбора);
    Если Семейства.Количество() = 0 Тогда
        Возврат "";
    КонецЕсли;
    Возврат Prometheus.СериализоватьВТекст(Семейства);
КонецФункции

// Content-Type для HTTP ответа: тип контента выдачи библиотеки prometheus.
//
// Возвращаемое значение:
//   Строка
//
Функция ContentType() Экспорт
    Возврат Prometheus.ContentTypeМетрик();
КонецФункции

// Возвращает предпочтительную темпоральность для типа инструмента.
// Prometheus всегда использует кумулятивную темпоральность (cumulative).
//
// Параметры:
//   ТипИнструмента - Число - тип инструмента из ОтелТипИнструмента (не используется,
//       Prometheus всегда Cumulative)
//
// Возвращаемое значение:
//   Число - значение из ОтелВременнаяАгрегация
//
Функция ПолучитьВременнуюАгрегацию(ТипИнструмента = Неопределено) Экспорт // BSLLS:UnusedParameters-off
    Возврат ОтелВременнаяАгрегация.Кумулятивная();
КонецФункции

// Собирает все метрики как семейства text format 0.0.4 в промежуточном формате библиотеки
// prometheus: семейство - Имя, Тип, Справка, Сэмплы; сэмпл - ИмяСэмпла, Лейблы, Значение, у квантиля
// сводки еще Квантиль (уровень квантиля, по нему библиотека упорядочивает квантили серии). Имя
// семейства - имя метрики в строках HELP и TYPE, у счетчика оно совпадает с именем сэмпла (с
// суффиксом _total). Результат можно передать в Prometheus.СериализоватьВТекст. После Закрыть
// метрик нет, результат - ошибка.
//
// Параметры:
//   РезультатСбора - Произвольный - выходной параметр: ОтелРезультатЭкспорта - ошибка, если сбор
//       метра или инструмента завершился сбоем (их метрики не попадают в выдачу) или читатель
//       закрыт; иначе успех
//
// Возвращаемое значение:
//   Массив из Соответствие
//
Функция СобратьСемейства(РезультатСбора = Неопределено) Экспорт
    Если Закрыт.Получить() Тогда
        РезультатСбора = ОтелРезультатыЭкспорта.Ошибка();
        Возврат Новый Массив();
    КонецЕсли;
    Сбор = НовыйСбор();
    ВремяСбора = ОтелУтилиты.ТекущееВремяВНаносекундах();
    Ошибки = Новый Массив();
    Для Каждого Метр Из СнимокМетров() Цикл
        // Сбой сбора одного метра не лишает выдачу метрик остальных
        Попытка
            МетрОбласть = Метр.ОбластьИнструментирования();
            ЛейблыОбласти = ЛейблыОбласти(МетрОбласть);
            ДанныеМетра = Метр.СобратьДляЧитателя(ЭтотОбъект, ВремяСбора, Ошибки);
        Исключение
            Лог.Предупреждение("Ошибка сбора метрик: " + ОписаниеОшибки());
            Ошибки.Добавить(ОписаниеОшибки());
            Продолжить;
        КонецПопытки;
        ДобавитьДанныеМетра(Сбор, ДанныеМетра, МетрОбласть, ЛейблыОбласти);
    КонецЦикла;
    Для Каждого Продюсер Из СнимокПродюсеров() Цикл
        Для Каждого Данные Из ДанныеПродюсера(Продюсер, Ошибки) Цикл
            ДобавитьДанныеПродюсера(Сбор, Данные);
        КонецЦикла;
    КонецЦикла;
    РезультатСбора = ?(Ошибки.Количество() = 0, ОтелРезультатыЭкспорта.Успех(), ОтелРезультатыЭкспорта.Ошибка());
    Возврат СемействаСбора(Сбор);
КонецФункции

// Совместимость с интерфейсом MetricReader: запуск.
//
Процедура Запустить() Экспорт
КонецПроцедуры

// Совместимость с интерфейсом MetricReader: сброс буфера.
//
// Параметры:
//   ТаймаутМс - Число - таймаут в миллисекундах (0 - без ограничения)
//
// Возвращаемое значение:
//   ОтелРезультатЭкспорта - успех (Prometheus - pull-модель, выгружать нечего); ошибка после Закрыть
//
Функция СброситьБуфер(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
    Возврат РезультатСброса();
КонецФункции

// Совместимость с интерфейсом MetricReader: сброс буфера без очистки данных.
//
// Параметры:
//   ТаймаутМс - Число - таймаут в миллисекундах (не используется: экспорта нет)
//
// Возвращаемое значение:
//   ОтелРезультатЭкспорта - успех (Prometheus - pull-модель, выгружать нечего); ошибка после Закрыть
//
Функция СброситьБуферБезОчистки(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
    Возврат РезультатСброса();
КонецФункции

// Возвращает семейства метрик для реестра клиентской библиотеки prometheus: читатель
// регистрируется в CollectorRegistry как custom Collector и выдается вместе с метриками
// библиотеки (Реестр.Register(Читатель)).
//
// Возвращаемое значение:
//   Массив из Соответствие - семейства метрик (см. СобратьСемейства)
//
Функция Collect() Экспорт
    Возврат СобратьСемейства();
КонецФункции

// Включает копирование атрибутов ресурса в лейблы метрик (resource_constant_labels). По
// умолчанию атрибуты ресурса в лейблы метрик не копируются. Значения атрибута точки и атрибута
// ресурса с тем же именем лейбла склеиваются через ";" в порядке исходных ключей.
//
// Параметры:
//   Включаемые - Массив из Строка, Неопределено - шаблоны ключей включаемых атрибутов: "*" -
//       любые символы, "?" - один символ; Неопределено - все атрибуты
//   Исключаемые - Массив из Строка, Неопределено - шаблоны ключей исключаемых атрибутов,
//       приоритетнее включаемых
//
Процедура УстановитьАтрибутыРесурсаВЛейблах(Включаемые, Исключаемые = Неопределено) Экспорт
    Шаблоны = Новый Структура("Включаемые, Исключаемые", Неопределено, ВыраженияШаблонов(Исключаемые));
    Если Включаемые <> Неопределено Тогда
        Шаблоны.Включаемые = ВыраженияШаблонов(Включаемые);
    КонецЕсли;
    ШаблоныАтрибутовРесурса = Шаблоны;
КонецПроцедуры

// Устанавливает фильтр метрик для Collect/Produce.
//
// Параметры:
//   Значение - ОтелФильтрМетрик - фильтр метрик
//
Процедура УстановитьФильтрМетрик(Значение) Экспорт
    ФильтрМетрик = Значение;
КонецПроцедуры

// Завершает работу: очищает зарегистрированные метры и продюсеры. После закрытия сбор и сброс
// возвращают ошибку. Параметры совпадают с ОтелПериодическийЧитательМетрик.Закрыть.
//
// Параметры:
//   ТаймаутМс - Число - таймаут операции в миллисекундах (не используется: экспорта нет)
//   ОчищатьДанные - Булево - очищать ли данные (не используется: данные не буферизуются)
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия - успех; повторный вызов - ошибка "Reader закрыт"
//
Функция Закрыть(ТаймаутМс = 30000, ОчищатьДанные = Истина) Экспорт // BSLLS:UnusedParameters-off, MagicNumber-off
    Если НЕ Закрыт.СравнитьИУстановить(Ложь, Истина) Тогда
        Возврат ОтелРезультатыЗакрытия.Ошибка("Reader закрыт");
    КонецЕсли;
    Блокировка.Заблокировать();
    Попытка
        Метры = Новый Массив();
        Продюсеры = Новый Массив();
        Блокировка.Разблокировать();
    Исключение
        Блокировка.Разблокировать();
    КонецПопытки;
    Возврат ОтелРезультатыЗакрытия.Успех();
КонецФункции

// Возвращает лимит мощности (cardinality limit) читателя по умолчанию.
//
// Возвращаемое значение:
//   Число - лимит мощности (по умолчанию 2000)
//
Функция ЛимитМощности() Экспорт
    Возврат ЛимитМощности;
КонецФункции

// Возвращает лимит мощности читателя для вида инструмента: заданный для вида или общий.
//
// Параметры:
//   ВидИнструмента - Строка - вид инструмента ("Counter", "Histogram", ...)
//
// Возвращаемое значение:
//   Число
//
Функция ЛимитМощностиДляВида(ВидИнструмента) Экспорт
    Лимит = ЛимитыМощностиПоВиду.Получить(ВидИнструмента);
    Возврат ?(Лимит = Неопределено, ЛимитМощности, Лимит);
КонецФункции

// Устанавливает лимит мощности читателя для вида инструмента.
//
// Параметры:
//   ВидИнструмента - Строка - вид инструмента ("Counter", "Histogram", ...)
//   Лимит - Число - лимит мощности
//
Процедура УстановитьЛимитМощностиДляВида(ВидИнструмента, Лимит) Экспорт
    ЛимитыМощностиПоВиду.Вставить(ВидИнструмента, Лимит);
КонецПроцедуры

// Возвращает агрегацию гистограмм по умолчанию для этого читателя.
//
// Возвращаемое значение:
//   Строка, Соответствие - агрегация вида Histogram: заданная УстановитьАгрегациюПоУмолчанию
//       или "explicit_bucket_histogram"
//
Функция АгрегацияГистограммПоУмолчанию() Экспорт
    Агрегация = АгрегацииПоВиду.Получить("Histogram");
    Возврат ?(Агрегация = Неопределено, "explicit_bucket_histogram", Агрегация);
КонецФункции

// Возвращает агрегацию по умолчанию для вида инструмента (спецификация Prometheus-экспортера:
// агрегация по умолчанию настраивается функцией вида инструмента).
//
// Параметры:
//   ВидИнструмента - Строка - вид инструмента ("Counter", "Histogram", "Gauge", ...)
//
// Возвращаемое значение:
//   Строка, Соответствие - агрегация; "default" - агрегация спецификации для вида
//
Функция АгрегацияПоУмолчанию(ВидИнструмента) Экспорт
    Агрегация = АгрегацииПоВиду.Получить(ВидИнструмента);
    Возврат ?(Агрегация = Неопределено, "default", Агрегация);
КонецФункции

// Устанавливает агрегацию по умолчанию для вида инструмента.
//
// Параметры:
//   ВидИнструмента - Строка - вид инструмента ("Counter", "Histogram", "Gauge", ...)
//   Агрегация - Строка, Соответствие - агрегация (ОтелАгрегация.Сумма(), "drop", ...)
//
Процедура УстановитьАгрегациюПоУмолчанию(ВидИнструмента, Агрегация) Экспорт
    АгрегацииПоВиду.Вставить(ВидИнструмента, Агрегация);
КонецПроцедуры

// Возвращает временную агрегацию читателя: Prometheus принимает кумулятивные данные.
//
// Параметры:
//   ВидИнструмента - Строка - вид инструмента
//
// Возвращаемое значение:
//   Число - ОтелВременнаяАгрегация.Кумулятивная()
//
Функция ВременнаяАгрегацияДляВида(ВидИнструмента) Экспорт // BSLLS:UnusedParameters-off
    Возврат ОтелВременнаяАгрегация.Кумулятивная();
КонецФункции

// Регистрирует читатель у провайдера. MetricReader MUST NOT быть зарегистрирован у нескольких MeterProvider.
//
// Возвращаемое значение:
//   Булево - Истина, если регистрация успешна; Ложь, если уже зарегистрирован
//
Функция ЗарегистрироватьУПровайдера() Экспорт
    Если НЕ Зарегистрирован.СравнитьИУстановить(Ложь, Истина) Тогда
        Лог.Ошибка("MetricReader уже зарегистрирован у другого MeterProvider");
        Возврат Ложь;
    КонецЕсли;
    Возврат Истина;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает метрики продюсера. Сбой продюсера (исключение или статус ошибки) логируется и
// добавляется в ошибки сбора, метрики остальных источников выдаются.
//
// Параметры:
//   Продюсер - ИнтерфейсПродюсерМетрик - продюсер метрик
//   Ошибки - Массив - ошибки сбора (мутируется)
//
// Возвращаемое значение:
//   Массив из ОтелДанныеМетрики
//
Функция ДанныеПродюсера(Продюсер, Ошибки)
    Попытка
        Результат = Продюсер.Произвести(ФильтрДляПродюсера());
        // Старые реализации продюсеров возвращают массив метрик
        Если ТипЗнч(Результат) = Тип("Массив") Тогда
            Возврат Результат;
        КонецЕсли;
        Если Результат.Успех() Тогда
            Возврат Результат.Метрики;
        КонецЕсли;
        Лог.Предупреждение("MetricProducer вернул статус %1: %2", Результат.Статус, Результат.СообщениеОшибки);
        Ошибки.Добавить(Результат.СообщениеОшибки);
    Исключение
        Лог.Предупреждение("Ошибка продюсера метрик: %1", ОписаниеОшибки());
        Ошибки.Добавить(ОписаниеОшибки());
    КонецПопытки;
    Возврат Новый Массив();
КонецФункции

// Возвращает фильтр для продюсера: фильтр метрик читателя с предпочтительной кумулятивной
// временной агрегацией (Prometheus принимает только кумулятивные данные). Фильтр читателя без
// предпочтения или с предпочтением дельта-агрегации оборачивается, сам он не меняется.
//
// Возвращаемое значение:
//   ОтелФильтрМетрик
//
Функция ФильтрДляПродюсера()
    Кумулятивная = ОтелВременнаяАгрегация.Кумулятивная();
    Если ФильтрМетрик = Неопределено Тогда
        Фильтр = Новый ОтелФильтрМетрик();
    ИначеЕсли ФильтрМетрик.ПредпочтительнаяТемпоральность() = Кумулятивная Тогда
        Возврат ФильтрМетрик;
    Иначе
        Фильтр = Новый ОтелФильтрМетрик(Новый Действие(ФильтрМетрик, "ТестМетрики"),
            Новый Действие(ФильтрМетрик, "ТестАтрибутов"));
    КонецЕсли;
    Фильтр.УстановитьПредпочтительнуюТемпоральность(Кумулятивная);
    Возврат Фильтр;
КонецФункции

// Переводит метрику продюсера в семейства сбора: лейблы области берутся из ее области
// инструментирования.
//
// Параметры:
//   Сбор - Структура - состояние сбора (см. НовыйСбор)
//   Данные - ОтелДанныеМетрики - метрика продюсера
//
Процедура ДобавитьДанныеПродюсера(Сбор, Данные)
    ДанныеМетрики = Новый Массив();
    ДанныеМетрики.Добавить(Данные);
    Попытка
        Область = Данные.ОбластьИнструментирования();
        ЛейблыОбласти = ЛейблыОбласти(Область);
    Исключение
        Лог.Предупреждение("Метрика продюсера пропущена: ошибка перевода в формат Prometheus: %1",
            ОписаниеОшибки());
        Возврат;
    КонецПопытки;
    ДобавитьДанныеМетра(Сбор, ДанныеМетрики, Область, ЛейблыОбласти);
КонецПроцедуры

// Возвращает копию списка зарегистрированных продюсеров.
//
// Возвращаемое значение:
//   Массив из ИнтерфейсПродюсерМетрик
//
Функция СнимокПродюсеров()
    Снимок = Новый Массив();
    Блокировка.Заблокировать();
    Попытка
        Для Каждого Продюсер Из Продюсеры Цикл
            Снимок.Добавить(Продюсер);
        КонецЦикла;
    Исключение
        Блокировка.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
    Блокировка.Разблокировать();
    Возврат Снимок;
КонецФункции

// Возвращает имена метрики в выдаче: имя семейства (в строках HELP и TYPE), имена сэмплов и
// базовое имя для группировки семейств. В text format строки HELP и TYPE относятся к метрике с
// тем же именем, поэтому у счетчика имя семейства - имя сэмпла с суффиксом _total, у
// info-метрики - с суффиксом _info. Суффикс _info, который уже есть в имени info-метрики, не
// повторяется. Суффикс _total в имени счетчика отрезает БазовоеИмя: _total, оставшийся после
// него (имя requests_total_total), - часть имени и сохраняется.
//
// Параметры:
//   ИмяПром - Строка - базовое имя метрики (см. БазовоеИмя)
//   Вид - Строка - вид метрики Prometheus: counter, gauge, histogram, summary, unknown, info, stateset
//
// Возвращаемое значение:
//   Структура - имена:
//     * База - Строка - базовое имя для группировки семейств
//     * Семейство - Строка - имя семейства
//     * Значение - Строка - имя сэмпла значения (счетчик, датчик, info, квантиль сводки)
//     * Бакет, Сумма, Количество - Строка - имена сэмплов гистограммы и сводки
//     * Сэмплы - Массив из Строка - имена сэмплов, которые дает каждая точка метрики
//
Функция ИменаМетрики(Знач ИмяПром, Вид)
    Если Вид = "counter" Тогда
        СуффиксТипа = "_total";
    ИначеЕсли Вид = "info" Тогда
        СуффиксТипа = "_info";
        ИмяПром = БезСуффикса(ИмяПром, СуффиксТипа);
    Иначе
        СуффиксТипа = "";
    КонецЕсли;
    Имена = Новый Структура("База, Семейство, Значение, Бакет, Сумма, Количество");
    Имена.База = ИмяПром;
    Имена.Значение = ИмяПром + СуффиксТипа;
    Имена.Семейство = Имена.Значение;
    Гистограмма = Вид = "histogram";
    Если Гистограмма Тогда
        Имена.Бакет = ИмяПром + "_bucket";
    КонецЕсли;
    Если Гистограмма ИЛИ Вид = "summary" Тогда
        Имена.Сумма = ИмяПром + "_sum";
        Имена.Количество = ИмяПром + "_count";
    КонецЕсли;
    // Гистограмма не дает сэмпла с базовым именем, сводка дает его у квантилей
    Сэмплы = Новый Массив();
    Если НЕ Гистограмма Тогда
        Сэмплы.Добавить(Имена.Значение);
    КонецЕсли;
    Для Каждого Ключ Из СтрРазделить("Бакет,Сумма,Количество", ",") Цикл
        Если Имена[Ключ] <> Неопределено Тогда
            Сэмплы.Добавить(Имена[Ключ]);
        КонецЕсли;
    КонецЦикла;
    Имена.Вставить("Сэмплы", Сэмплы);
    Возврат Имена;
КонецФункции

// Возвращает вид метрики Prometheus: монотонная сумма - counter, гистограмма - histogram, сводка -
// summary, датчик и немонотонная сумма - по подсказке prometheus.type из метаданных метрики
// (Prometheus Compatibility, Gauges): unknown (и unkown), info, stateset, иначе gauge.
//
// Параметры:
//   Данные - ОтелДанныеМетрики - данные метрики
//
// Возвращаемое значение:
//   Строка - counter, gauge, histogram, summary, unknown, info или stateset
//
Функция ВидPrometheus(Данные)
    ТипМетрики = Данные.ТипМетрики();
    Если ТипМетрики = ОтелТипМетрики.Гистограмма() Тогда
        Возврат "histogram";
    КонецЕсли;
    Если ТипМетрики = ОтелТипМетрики.Сводка() Тогда
        Возврат "summary";
    КонецЕсли;
    Если ТипМетрики = ОтелТипМетрики.Сумма() И Данные.Монотонный() Тогда
        Возврат "counter";
    КонецЕсли;
    Подсказка = НРег(Строка(Данные.Метаданные().Получить("prometheus.type")));
    Если Подсказка = "unknown" ИЛИ Подсказка = "unkown" Тогда
        Возврат "unknown";
    ИначеЕсли Подсказка = "info" ИЛИ Подсказка = "stateset" Тогда
        Возврат Подсказка;
    Иначе
        Возврат "gauge";
    КонецЕсли;
КонецФункции

// Возвращает тип метрики в строке TYPE: text format не поддерживает unknown (выводится untyped),
// info (gauge с суффиксом _info) и stateset (gauge).
//
// Параметры:
//   Вид - Строка - вид метрики Prometheus
//
// Возвращаемое значение:
//   Строка
//
Функция ТипВТексте(Вид)
    Если Вид = "unknown" Тогда
        Возврат "untyped";
    ИначеЕсли Вид = "info" ИЛИ Вид = "stateset" Тогда
        Возврат "gauge";
    Иначе
        Возврат Вид;
    КонецЕсли;
КонецФункции

Функция БезСуффикса(Имя, Суффикс)
    // СтрЗаканчиваетсяНа не принимает пустую подстроку
    Если Суффикс <> "" И Имя <> Суффикс И СтрЗаканчиваетсяНа(Имя, Суффикс) Тогда
        Возврат Лев(Имя, СтрДлина(Имя) - СтрДлина(Суффикс));
    КонецЕсли;
    Возврат Имя;
КонецФункции

Функция ЧислоВТекст(Значение)
    Если ТипЗнч(Значение) <> Тип("Число") Тогда
        Возврат "0";
    КонецЕсли;
    Возврат СтрЗаменить(Формат(Значение, "ЧРД=.; ЧН=0; ЧГ="), " ", "");
КонецФункции

Процедура ОтфильтроватьТочкиДанных(Данные, МетрОбласть, ИмяМетрики, ТипМетрики, ЕдиницаИзмерения)
    ИсходныеТочки = Данные.ТочкиДанных();
    Индекс = ИсходныеТочки.ВГраница();
    Пока Индекс >= 0 Цикл
        ТочкаДанных = ИсходныеТочки[Индекс];
        Атрибуты = ТочкаДанных.Получить("attributes");
        Если Атрибуты = Неопределено Тогда
            Атрибуты = Новый Массив;
        КонецЕсли;
        Результат = ФильтрМетрик.ТестАтрибутов(
            МетрОбласть, ИмяМетрики, ТипМетрики, ЕдиницаИзмерения, Атрибуты);
        Если Результат = ОтелРезультатФильтраАтрибутов.Отбросить() Тогда
            ИсходныеТочки.Удалить(Индекс);
        КонецЕсли;
        Индекс = Индекс - 1;
    КонецЦикла;
КонецПроцедуры

Функция МетрикаОтброшена(Данные, МетрОбласть)
    Если ФильтрМетрик = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;

    РезультатФильтра = ФильтрМетрик.ТестМетрики(
        МетрОбласть, Данные.Имя(), Данные.ТипМетрики(), Данные.ЕдиницаИзмерения());
    Если РезультатФильтра = ОтелРезультатФильтраМетрик.Отбросить() Тогда
        Возврат Истина;
    КонецЕсли;
    Если РезультатФильтра = ОтелРезультатФильтраМетрик.ЧастичноеПринятие() Тогда
        ОтфильтроватьТочкиДанных(Данные, МетрОбласть, Данные.Имя(),
            Данные.ТипМетрики(), Данные.ЕдиницаИзмерения());
    КонецЕсли;
    Возврат Ложь;
КонецФункции

// Переводит данные метрики в семейство Prometheus и добавляет в него сэмплы точек.
//
// Параметры:
//   Сбор - Структура - состояние сбора (см. НовыйСбор)
//   Данные - ОтелДанныеМетрики - данные метрики
//   ДопЛейблы - Структура - дополнительные лейблы точек (см. ЛейблыТочки)
//
Процедура КонвертироватьИДобавить(Сбор, Данные, ДопЛейблы)
    Если Данные.ТочкиДанных().Количество() = 0 ИЛИ НЕ ТипМетрикиПоддерживается(Данные)
            ИЛИ ДельтаМетрикаОтброшена(Данные) Тогда
        Возврат;
    КонецЕсли;
    ИмяМетрики = Данные.Имя();
    Вид = ВидPrometheus(Данные);
    ИмяПром = БазовоеИмя(ИмяМетрики, Данные.ЕдиницаИзмерения(), Вид = "counter");
    Имена = ИменаМетрики(ИмяПром, Вид);
    Тип = ТипВТексте(Вид);
    Если ЕстьКонфликтТипа(Сбор, Имена, Тип) Тогда
        Возврат;
    КонецЕсли;

    ТочкиДанных = ТочкиНовыхСерий(Сбор.ВыведенныеСэмплы, Имена.Сэмплы, Данные.ТочкиДанных(), ДопЛейблы);
    Отброшено = Данные.ТочкиДанных().Количество() - ТочкиДанных.Количество();
    Если Отброшено > 0 Тогда
        Лог.Предупреждение(
            "Метрика '%1' (семейство '%3'): отброшено точек - %2, сэмплы с теми же именем"
            + " и метками уже есть в выдаче (например, одноименные после перевода"
            + " в Prometheus метрики одной области 'a.b' и 'a_b' или счетчик 'foo'"
            + " с единицей 'By' и датчик 'foo_bytes_total')",
            ИмяМетрики, Отброшено, Имена.Семейство);
    КонецЕсли;
    Если ТочкиДанных.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Сэмплы = СемействоМетрики(Сбор, Имена, Тип, Данные).Получить("Сэмплы");
    Для Каждого ТД Из ТочкиДанных Цикл
        ДобавитьСэмплыТочки(Сэмплы, ТД, Вид, Имена, ДопЛейблы);
    КонецЦикла;
КонецПроцедуры

// Проверяет, что тип метрики переводится в Prometheus: сумма, датчик, гистограмма или сводка.
// Метрика другого типа (экспоненциальная гистограмма) пропускается с предупреждением.
//
// Параметры:
//   Данные - ОтелДанныеМетрики - данные метрики
//
// Возвращаемое значение:
//   Булево
//
Функция ТипМетрикиПоддерживается(Данные)
    ТипМетрики = Данные.ТипМетрики();
    ИмяМетрики = Данные.Имя();
    Если ТипМетрики = ОтелТипМетрики.ЭкспоненциальнаяГистограмма() Тогда
        Лог.Предупреждение("Экспоненциальная гистограмма '%1' пропущена: не поддерживается Prometheus text format",
            ИмяМетрики);
        Возврат Ложь;
    КонецЕсли;
    Поддерживаемые = Новый Массив();
    Поддерживаемые.Добавить(ОтелТипМетрики.Сумма());
    Поддерживаемые.Добавить(ОтелТипМетрики.Датчик());
    Поддерживаемые.Добавить(ОтелТипМетрики.Гистограмма());
    Поддерживаемые.Добавить(ОтелТипМетрики.Сводка());
    Если Поддерживаемые.Найти(ТипМетрики) = Неопределено Тогда
        Лог.Предупреждение("Неизвестный тип метрики '%1' для '%2', метрика пропущена", ТипМетрики, ИмяМетрики);
        Возврат Ложь;
    КонецЕсли;
    Возврат Истина;
КонецФункции

// Проверяет, что сумма или гистограмма собрана с временной агрегацией Дельта, и пишет
// предупреждение (Prometheus Compatibility, Sums и Histograms): Prometheus принимает кумулятивные
// данные, дельта-гистограмму MUST отбросить, если ее не агрегируют в кумулятивную; дельта-сумму
// читатель тоже не агрегирует. Метрики SDK читатель собирает с кумулятивной агрегацией,
// дельта-данные может отдать только продюсер.
//
// Параметры:
//   Данные - ОтелДанныеМетрики - данные метрики
//
// Возвращаемое значение:
//   Булево - Истина, если метрику нужно пропустить
//
Функция ДельтаМетрикаОтброшена(Данные)
    Если Данные.ВременнаяАгрегация() <> ОтелВременнаяАгрегация.Дельта() Тогда
        Возврат Ложь;
    КонецЕсли;
    ТипМетрики = Данные.ТипМетрики();
    Если ТипМетрики <> ОтелТипМетрики.Сумма() И ТипМетрики <> ОтелТипМетрики.Гистограмма() Тогда
        Возврат Ложь;
    КонецЕсли;
    ИмяМетрики = Данные.Имя();
    Лог.Предупреждение("Метрика '%1' пропущена: временная агрегация Дельта, Prometheus принимает"
        + " только кумулятивные данные", ИмяМетрики);
    Возврат Истина;
КонецФункции

// Возвращает семейство метрики из сбора. Новое семейство получает HELP из описания метрики; у
// существующего семейства отличающееся описание метрики отбрасывается с предупреждением.
// Семейство ищется по базовому имени, затем по имени в строках HELP и TYPE: info-метрика x и
// датчик x_info имеют разные базовые имена, но в text format обе - gauge x_info, и второе
// семейство с тем же именем вытеснило бы первое.
//
// Параметры:
//   Сбор - Структура - состояние сбора (см. НовыйСбор)
//   Имена - Структура - имена метрики (см. ИменаМетрики)
//   Тип - Строка - тип в строке TYPE
//   Данные - ОтелДанныеМетрики - данные метрики
//
// Возвращаемое значение:
//   Соответствие - семейство
//
Функция СемействоМетрики(Сбор, Имена, Тип, Данные)
    Семейство = Сбор.СемействаПоИмени.Получить(Имена.База);
    Если Семейство = Неопределено Тогда
        Семейство = Сбор.СемействаПоИмениВТексте.Получить(Имена.Семейство);
    КонецЕсли;
    Если Семейство <> Неопределено Тогда
        ПредупредитьОбОтброшенномОписании(Семейство, Данные);
        Возврат Семейство;
    КонецЕсли;
    Семейство = Новый Соответствие();
    Семейство.Вставить("Имя", Имена.Семейство);
    Семейство.Вставить("Тип", Тип);
    Семейство.Вставить("Справка", Данные.Описание());
    Семейство.Вставить("Сэмплы", Новый Массив());
    Сбор.СемействаПоИмени.Вставить(Имена.База, Семейство);
    Сбор.СемействаПоИмениВТексте.Вставить(Имена.Семейство, Семейство);
    Возврат Семейство;
КонецФункции

// Добавляет сэмплы точки данных: значение, бакеты гистограммы или квантили сводки, сумму и
// количество; у info-метрики значение всегда 1. Exemplars не выводятся: text format их не
// поддерживает (Prometheus Compatibility: exemplars MUST отбрасываться, если формат их не
// поддерживает).
//
// Параметры:
//   Сэмплы - Массив - сэмплы семейства (мутируется)
//   ТД - Соответствие - точка данных
//   Вид - Строка - вид метрики Prometheus
//   Имена - Структура - имена метрики (см. ИменаМетрики)
//   ДопЛейблы - Структура - дополнительные лейблы точек (см. ЛейблыТочки)
//
Процедура ДобавитьСэмплыТочки(Сэмплы, ТД, Вид, Имена, ДопЛейблы)
    Лейблы = ЛейблыТочки(ТД, ДопЛейблы);
    Если Вид = "histogram" Тогда
        ДобавитьСэмплыГистограммы(Сэмплы, ТД, Имена, Лейблы);
    ИначеЕсли Вид = "summary" Тогда
        ДобавитьСэмплыСводки(Сэмплы, ТД, Имена, Лейблы);
    ИначеЕсли Вид = "info" Тогда
        ДобавитьСэмпл(Сэмплы, Имена.Значение, 1, Лейблы);
    Иначе
        ДобавитьСэмпл(Сэмплы, Имена.Значение, ТД.Получить("value"), Лейблы);
    КонецЕсли;
КонецПроцедуры

// Добавляет сэмплы гистограммы: бакеты _bucket с лейблом le и накопленным количеством (последний -
// +Inf), _sum и _count.
//
// Параметры:
//   Сэмплы - Массив - сэмплы семейства (мутируется)
//   ТД - Соответствие - точка данных гистограммы
//   Имена - Структура - имена метрики (см. ИменаМетрики)
//   Лейблы - Соответствие - лейблы точки
//
Процедура ДобавитьСэмплыГистограммы(Сэмплы, ТД, Имена, Лейблы)
    КоличестваБакетов = ТД.Получить("bucketCounts");
    Если КоличестваБакетов <> Неопределено Тогда
        Границы = ТД.Получить("explicitBounds");
        Если Границы = Неопределено Тогда
            Границы = Новый Массив();
        КонецЕсли;
        Накоплено = 0;
        Для Индекс = 0 По КоличестваБакетов.ВГраница() Цикл
            Накоплено = Накоплено + КоличестваБакетов[Индекс];
            ЛейблыБакета = СкопироватьЛейблы(Лейблы);
            ЛейблыБакета.Вставить("le", ?(Индекс < Границы.Количество(), Границы[Индекс], "+Inf"));
            ДобавитьСэмпл(Сэмплы, Имена.Бакет, Накоплено, ЛейблыБакета);
        КонецЦикла;
    КонецЕсли;
    ДобавитьСэмпл(Сэмплы, Имена.Сумма, ТД.Получить("sum"), Лейблы);
    ДобавитьСэмпл(Сэмплы, Имена.Количество, ТД.Получить("count"), Лейблы);
КонецПроцедуры

// Добавляет сэмплы сводки (Prometheus Compatibility, Summaries): квантили с лейблом quantile по
// возрастанию квантиля, _sum и _count. Сэмпл квантиля несет и уровень квантиля (поле Квантиль):
// по нему библиотека prometheus упорядочивает квантили серии, сэмпл квантиля без него она не
// выводит. Exemplars сводки отбрасываются.
//
// Параметры:
//   Сэмплы - Массив - сэмплы семейства (мутируется)
//   ТД - Соответствие - точка данных сводки
//   Имена - Структура - имена метрики (см. ИменаМетрики)
//   Лейблы - Соответствие - лейблы точки
//
Процедура ДобавитьСэмплыСводки(Сэмплы, ТД, Имена, Лейблы)
    Для Каждого Квантиль Из КвантилиПоВозрастанию(ТД.Получить("quantileValues")) Цикл
        Уровень = Квантиль.Получить("quantile");
        ЛейблыКвантиля = СкопироватьЛейблы(Лейблы);
        ЛейблыКвантиля.Вставить("quantile", Уровень);
        ДобавитьСэмпл(Сэмплы, Имена.Значение, Квантиль.Получить("value"), ЛейблыКвантиля, ЧислоИлиНоль(Уровень));
    КонецЦикла;
    ДобавитьСэмпл(Сэмплы, Имена.Сумма, ТД.Получить("sum"), Лейблы);
    ДобавитьСэмпл(Сэмплы, Имена.Количество, ТД.Получить("count"), Лейблы);
КонецПроцедуры

// Возвращает квантили точки сводки по возрастанию квантиля.
//
// Параметры:
//   Квантили - Массив из Соответствие, Неопределено - квантили: quantile и value
//
// Возвращаемое значение:
//   Массив из Соответствие
//
Функция КвантилиПоВозрастанию(Квантили)
    Результат = Новый Массив();
    Если Квантили = Неопределено Тогда
        Возврат Результат;
    КонецЕсли;
    Для Каждого Квантиль Из Квантили Цикл
        Уровень = ЧислоИлиНоль(Квантиль.Получить("quantile"));
        Индекс = 0;
        Пока Индекс < Результат.Количество() И ЧислоИлиНоль(Результат[Индекс].Получить("quantile")) <= Уровень Цикл
            Индекс = Индекс + 1;
        КонецЦикла;
        Результат.Вставить(Индекс, Квантиль);
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Добавляет сэмпл в семейство.
//
// Параметры:
//   Сэмплы - Массив - сэмплы семейства (мутируется)
//   ИмяСэмпла - Строка - имя сэмпла
//   Значение - Число - значение
//   Лейблы - Соответствие - лейблы
//   Квантиль - Число, Неопределено - уровень квантиля сводки
//
Процедура ДобавитьСэмпл(Сэмплы, ИмяСэмпла, Значение, Лейблы, Квантиль = Неопределено)
    Сэмпл = Новый Соответствие();
    Сэмпл.Вставить("ИмяСэмпла", ИмяСэмпла);
    Сэмпл.Вставить("Значение", Значение);
    Сэмпл.Вставить("Лейблы", Лейблы);
    Если Квантиль <> Неопределено Тогда
        Сэмпл.Вставить("Квантиль", Квантиль);
    КонецЕсли;
    Сэмплы.Добавить(Сэмпл);
КонецПроцедуры

// Приводит значение к числу: число - как есть, строка с числом - ее число, иначе 0.
//
// Параметры:
//   Значение - Произвольный - значение
//
// Возвращаемое значение:
//   Число
//
Функция ЧислоИлиНоль(Значение)
    Возврат Новый ОписаниеТипов("Число").ПривестиЗначение(Значение);
КонецФункции

// Пишет предупреждение, если описание метрики, добавляемой в существующее семейство, отличается
// от его HELP: у семейства одна строка HELP, описание метрики отбрасывается.
//
// Параметры:
//   Семейство - Соответствие - существующее семейство
//   Данные - ОтелДанныеМетрики - добавляемая метрика
//
Процедура ПредупредитьОбОтброшенномОписании(Семейство, Данные)
    Описание = Данные.Описание();
    Если Описание <> Семейство.Получить("Справка") Тогда
        Лог.Предупреждение("HELP семейства '%1' не изменен: описание '%2' метрики '%3' отличается и отброшено",
            Семейство.Получить("Имя"), Описание, Данные.Имя());
    КонецЕсли;
КонецПроцедуры

// Возвращает состояние одного сбора семейств.
//
// Возвращаемое значение:
//   Структура - состояние сбора:
//     * СемействаПоИмени - Соответствие - семейства по базовому имени, без суффикса _total
//     * СемействаПоИмениВТексте - Соответствие - семейства по имени в строках HELP и TYPE
//     * ВыведенныеСэмплы - Соответствие - ключи выведенных сэмплов: имя сэмпла и лейблы
//     * ЛейблыРесурсов - Соответствие - кэш лейблов ресурсов, копируемых в лейблы метрик
//
Функция НовыйСбор()
    Сбор = Новый Структура();
    Сбор.Вставить("СемействаПоИмени", Новый Соответствие());
    Сбор.Вставить("СемействаПоИмениВТексте", Новый Соответствие());
    Сбор.Вставить("ВыведенныеСэмплы", Новый Соответствие());
    Сбор.Вставить("ЛейблыРесурсов", Новый Соответствие());
    Возврат Сбор;
КонецФункции

// Возвращает копию списка зарегистрированных метров.
//
// Возвращаемое значение:
//   Массив из ОтелМетр
//
Функция СнимокМетров()
    Снимок = Новый Массив();
    Блокировка.Заблокировать();
    Попытка
        Для Каждого Метр Из Метры Цикл
            Снимок.Добавить(Метр);
        КонецЦикла;
    Исключение
        Блокировка.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
    Блокировка.Разблокировать();
    Возврат Снимок;
КонецФункции

// Переводит данные метра в семейства сбора. Метрика, перевод которой не удался, пропускается с
// предупреждением.
//
// Параметры:
//   Сбор - Структура - состояние сбора (см. НовыйСбор)
//   ДанныеМетра - Массив из ОтелДанныеМетрики - данные метра
//   МетрОбласть - ОтелОбластьИнструментирования - область метра
//   ЛейблыОбласти - Соответствие - группы лейблов otel_scope_* области (см. ЛейблыОбласти)
//
Процедура ДобавитьДанныеМетра(Сбор, ДанныеМетра, МетрОбласть, ЛейблыОбласти)
    Для Каждого Данные Из ДанныеМетра Цикл
        ИмяМетрики = "";
        Попытка
            ИмяМетрики = Данные.Имя();
            Ресурс = Данные.Ресурс();
            Если НЕ МетрикаОтброшена(Данные, МетрОбласть) Тогда
                КонвертироватьИДобавить(Сбор, Данные, ДопЛейблыМетрики(Сбор, ЛейблыОбласти, Ресурс));
            КонецЕсли;
        Исключение
            Лог.Предупреждение("Метрика '%1' пропущена: ошибка перевода в формат Prometheus: %2",
                ИмяМетрики, ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;
КонецПроцедуры

// Возвращает дополнительные лейблы точек метрики.
//
// Параметры:
//   Сбор - Структура - состояние сбора (см. НовыйСбор)
//   ЛейблыОбласти - Соответствие - группы лейблов otel_scope_* области (см. ЛейблыОбласти)
//   Ресурс - ОтелРесурс, Неопределено - ресурс метрики
//
// Возвращаемое значение:
//   Структура - см. ЛейблыТочки
//
Функция ДопЛейблыМетрики(Сбор, ЛейблыОбласти, Ресурс)
    Возврат Новый Структура("Области, Ресурса", ЛейблыОбласти, ЛейблыРесурсаДляМетрик(Ресурс, Сбор));
КонецФункции

// Возвращает семейства метрик сбора.
//
// Параметры:
//   Сбор - Структура - состояние сбора (см. НовыйСбор)
//
// Возвращаемое значение:
//   Массив из Соответствие
//
Функция СемействаСбора(Сбор)
    Результат = Новый Массив();
    Для Каждого КВ Из Сбор.СемействаПоИмени Цикл
        Результат.Добавить(КВ.Значение);
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Возвращает результат сброса буфера: успех, после закрытия - ошибка.
//
// Возвращаемое значение:
//   ОтелРезультатЭкспорта
//
Функция РезультатСброса()
    Если Закрыт.Получить() Тогда
        Возврат ОтелРезультатыЭкспорта.Ошибка();
    КонецЕсли;
    Возврат ОтелРезультатыЭкспорта.Успех();
КонецФункции

// Проверяет, что базовое имя и имя семейства (имя в строках HELP и TYPE) не заняты
// семейством другого типа. Имя семейства может совпасть при разных базовых именах: счетчик
// "foo" с единицей By выводится как foo_bytes_total, как и датчик "foo_bytes_total". Семейство
// с тем же базовым именем, но другим именем семейства (датчик "build" и info-метрика "build",
// которая в text format выводится как build_info) тоже конфликтует. При конфликте пишет
// предупреждение: вторая строка TYPE с тем же именем сделала бы вывод некорректным.
//
// Параметры:
//   Сбор - Структура - состояние сбора (см. НовыйСбор)
//   Имена - Структура - имена метрики (см. ИменаМетрики)
//   НовыйТип - Строка - тип метрики в строке TYPE
//
// Возвращаемое значение:
//   Булево - Истина, если метрику нужно пропустить
//
Функция ЕстьКонфликтТипа(Сбор, Имена, НовыйТип)
    ИмяКонфликта = Имена.База;
    Занявшее = Сбор.СемействаПоИмени.Получить(Имена.База);
    Если Занявшее = Неопределено Тогда
        ИмяКонфликта = Имена.Семейство;
        Занявшее = Сбор.СемействаПоИмениВТексте.Получить(ИмяКонфликта);
    КонецЕсли;
    Если Занявшее = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;
    СущТип = Занявшее.Получить("Тип");
    Если СущТип = НовыйТип И Занявшее.Получить("Имя") = Имена.Семейство Тогда
        Возврат Ложь;
    КонецЕсли;
    Лог.Предупреждение("Конфликт TYPE для '" + ИмяКонфликта
        + "': '" + СущТип + "' vs '" + НовыйТип + "'. Метрика пропущена.");
    Возврат Истина;
КонецФункции

// Возвращает точки, сэмплы которых (имя сэмпла и набор лейблов) еще не выведены, и
// запоминает их. Формат Prometheus требует уникального сочетания имени сэмпла и лейблов,
// а совпасть могут и сэмплы разных семейств: одноименные после перевода в Prometheus
// метрики одной области ("a.b" и "a_b"), счетчик "foo" с единицей By (сэмпл
// foo_bytes_total) и датчик "foo_bytes_total", гистограмма "lat" и датчик "lat_count".
// Спецификация совместимости с Prometheus требует не отбрасывать точки из-за
// конфликта UNIT/HELP, поэтому отбрасываются только точки уже выведенных сэмплов.
//
// Параметры:
//   ВыведенныеСэмплы - Соответствие - ключи выведенных сэмплов (мутируется)
//   ИменаСэмплов - Массив из Строка - имена сэмплов, которые дает каждая точка метрики
//   ТочкиДанных - Массив - точки данных метрики
//   ДопЛейблы - Структура - дополнительные лейблы точек (см. ЛейблыТочки)
//
// Возвращаемое значение:
//   Массив - точки данных, сэмплы которых еще не выведены
//
Функция ТочкиНовыхСерий(ВыведенныеСэмплы, ИменаСэмплов, ТочкиДанных, ДопЛейблы)
    НовыеТочки = Новый Массив();
    Для Каждого ТД Из ТочкиДанных Цикл
        Лейблы = ЛейблыТочки(ТД, ДопЛейблы);
        КлючСерии = СформироватьКлючСерии(Лейблы);
        КлючиСэмплов = Новый Массив();
        УжеВыведена = Ложь;
        Для Каждого ИмяСэмпла Из ИменаСэмплов Цикл
            КлючСэмпла = ИмяСэмпла + "{" + КлючСерии + "}";
            Если ВыведенныеСэмплы.Получить(КлючСэмпла) <> Неопределено Тогда
                УжеВыведена = Истина;
            КонецЕсли;
            КлючиСэмплов.Добавить(КлючСэмпла);
        КонецЦикла;
        Если УжеВыведена Тогда
            Продолжить;
        КонецЕсли;
        Для Каждого КлючСэмпла Из КлючиСэмплов Цикл
            ВыведенныеСэмплы.Вставить(КлючСэмпла, Истина);
        КонецЦикла;
        НовыеТочки.Добавить(ТД);
    КонецЦикла;
    Возврат НовыеТочки;
КонецФункции

// Строит однозначный ключ серии по набору лейблов: пары отсортированы по имени,
// значение предваряется длиной, поэтому разделители в значениях не дают коллизий.
//
// Параметры:
//   Лейблы - Соответствие - лейблы серии
//
// Возвращаемое значение:
//   Строка
//
Функция СформироватьКлючСерии(Лейблы)
    Пары = Новый СписокЗначений();
    Для Каждого КЗ Из Лейблы Цикл
        Значение = Строка(КЗ.Значение);
        Пары.Добавить(КЗ.Ключ + "=" + Формат(СтрДлина(Значение), "ЧН=0; ЧГ=") + ":" + Значение);
    КонецЦикла;
    Пары.СортироватьПоЗначению();
    Возврат СтрСоединить(Пары.ВыгрузитьЗначения(), ";");
КонецФункции

// Строит базовое имя метрики Prometheus по имени и единице метрики OTel (спецификация
// Prometheus and OpenMetrics Compatibility, разделы Metric Metadata и Sums): недопустимые символы
// имени заменяются на "_", единица переводится в слово Prometheus и добавляется суффиксом, если
// имя еще не оканчивается на нее. Суффиксов типа (_total, _info) в базовом
// имени нет: их добавляет ИменаМетрики. Имя и единица самой метрики OTel не меняются: перевод
// выполняется только здесь.
//
// Параметры:
//   ИмяМетрики - Строка - имя метрики OTel (с учетом View)
//   ЕдиницаИзмерения - Строка - единица UCUM
//   ЭтоСчетчик - Булево - монотонная сумма (Prometheus Counter)
//
// Возвращаемое значение:
//   Строка
//
Функция БазовоеИмя(ИмяМетрики, ЕдиницаИзмерения, ЭтоСчетчик)
    Имя = НормализоватьИмя(ИмяМетрики);
    СуффиксТипа = "_total";
    // Имя счетчика, уже оканчивающееся на _total, MUST остаться без изменений
    Если ЭтоСчетчик И СтрЗаканчиваетсяНа(Имя, СуффиксТипа) И Имя <> СуффиксТипа Тогда
        Имя = Лев(Имя, СтрДлина(Имя) - СтрДлина(СуффиксТипа));
    КонецЕсли;
    Суффикс = СуффиксЕдиницы(ЕдиницаИзмерения);
    Если Суффикс <> "" И Имя <> Суффикс И НЕ СтрЗаканчиваетсяНа(Имя, "_" + Суффикс) Тогда
        Имя = Имя + "_" + Суффикс;
    КонецЕсли;
    Возврат Имя;
КонецФункции

// Переводит единицу UCUM в суффикс имени Prometheus: части в фигурных скобках
// отбрасываются (MUST), единицы из таблицы спецификации заменяются словами (MUST),
// скорость "X/Y" становится "X_per_Y" (MUST для скоростей во времени).
// Безразмерная единица "1" суффикса не дает, прочие единицы используются как есть.
//
// Параметры:
//   ЕдиницаИзмерения - Строка - единица UCUM
//
// Возвращаемое значение:
//   Строка - суффикс без ведущего "_" или пустая строка
//
Функция СуффиксЕдиницы(ЕдиницаИзмерения)
    Если ТипЗнч(ЕдиницаИзмерения) <> Тип("Строка") Тогда
        Возврат "";
    КонецЕсли;
    БезСкобок = РВСкобки.Заменить(ЕдиницаИзмерения, "");
    Части = СтрРазделить(БезСкобок, "/");
    Результат = СловоЕдиницы(СокрЛП(Части[0]), СловаЕдиниц);
    Если Части.Количество() > 1 Тогда
        СловоЗнаменателя = СловоЗнаменателяСкорости(СокрЛП(Части[1]));
        Если СловоЗнаменателя <> "" Тогда
            Результат = ?(Результат = "", "", Результат + "_") + "per_" + СловоЗнаменателя;
        КонецЕсли;
    КонецЕсли;
    Результат = РВНедопустимые.Заменить(Результат, "_");
    Результат = РВДубли.Заменить(Результат, "_");
    Результат = РВХвост.Заменить(Результат, "");
    Пока СтрНачинаетсяС(Результат, "_") Цикл
        Результат = Сред(Результат, 2);
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Возвращает слово для знаменателя скорости: единицы времени в единственном числе
// ("m/s" -> "meters_per_second"), прочие единицы - как в числителе.
//
// Параметры:
//   Единица - Строка - единица UCUM знаменателя
//
// Возвращаемое значение:
//   Строка
//
Функция СловоЗнаменателяСкорости(Единица)
    Слово = СловаЕдиницВремени.Получить(Единица);
    Если Слово <> Неопределено Тогда
        Возврат Слово;
    КонецЕсли;
    Возврат СловоЕдиницы(Единица, СловаЕдиниц);
КонецФункции

// Возвращает слово Prometheus для единицы по словарю или саму единицу, если ее нет
// в словаре. Безразмерная "1" дает пустую строку.
//
// Параметры:
//   Единица - Строка - единица UCUM без фигурных скобок
//   Словарь - Соответствие - единица UCUM -> слово Prometheus
//
// Возвращаемое значение:
//   Строка
//
Функция СловоЕдиницы(Единица, Словарь)
    Если Единица = "" ИЛИ Единица = "1" Тогда
        Возврат "";
    КонецЕсли;
    Слово = Словарь.Получить(Единица);
    Возврат ?(Слово = Неопределено, Единица, Слово);
КонецФункции

// Возвращает лейблы точки: атрибуты точки, скопированные атрибуты ресурса и лейблы otel_scope_*
// области. Значения, ключи которых дали одно имя лейбла, склеиваются через ";" в порядке исходных
// ключей (спецификация совместимости, раздел Metric Attributes), в том числе атрибут точки с
// лейблом области или скопированным атрибутом ресурса; при равных ключах первым идет значение
// атрибута точки.
//
// Параметры:
//   ТД - Соответствие - точка данных
//   ДопЛейблы - Структура - дополнительные лейблы:
//     * Области - Соответствие - группы лейблов otel_scope_* области метра (см. СгруппироватьЛейблы)
//     * Ресурса - Соответствие - группы лейблов атрибутов ресурса, копируемых в лейблы метрик
//
// Возвращаемое значение:
//   Соответствие - лейблы
//
Функция ЛейблыТочки(ТД, ДопЛейблы)
    Группы = СгруппироватьЛейблы(ТД.Получить("attributes"), "");
    ДобавитьГруппы(Группы, ДопЛейблы.Ресурса);
    ДобавитьГруппы(Группы, ДопЛейблы.Области);
    Возврат СклеитьГруппы(Группы);
КонецФункции

// Возвращает группы лейблов атрибутов ресурса, выбранных для копирования в лейблы метрик.
//
// Параметры:
//   Ресурс - ОтелРесурс, Неопределено - ресурс метрики
//   Сбор - Структура - состояние сбора: кэш лейблов ресурсов ЛейблыРесурсов (мутируется)
//
// Возвращаемое значение:
//   Соответствие - группы лейблов (см. СгруппироватьЛейблы)
//
Функция ЛейблыРесурсаДляМетрик(Ресурс, Сбор)
    Шаблоны = ШаблоныАтрибутовРесурса;
    Если Шаблоны = Неопределено ИЛИ Ресурс = Неопределено Тогда
        Возврат Новый Соответствие();
    КонецЕсли;
    Лейблы = Сбор.ЛейблыРесурсов.Получить(Ресурс);
    Если Лейблы <> Неопределено Тогда
        Возврат Лейблы;
    КонецЕсли;
    Выбранные = Новый Массив();
    Для Каждого Атрибут Из Ресурс.Атрибуты().ВМассивOtlp() Цикл
        Если АтрибутРесурсаВыбран(Атрибут.Получить("key"), Шаблоны) Тогда
            Выбранные.Добавить(Атрибут);
        КонецЕсли;
    КонецЦикла;
    Лейблы = СгруппироватьЛейблы(Выбранные, "");
    Сбор.ЛейблыРесурсов.Вставить(Ресурс, Лейблы);
    Возврат Лейблы;
КонецФункции

// Проверяет, выбран ли атрибут ресурса шаблонами: подходит под включаемые (или они не заданы) и
// не подходит под исключаемые.
//
// Параметры:
//   Ключ - Строка - ключ атрибута
//   Шаблоны - Структура - см. ШаблоныАтрибутовРесурса
//
// Возвращаемое значение:
//   Булево
//
Функция АтрибутРесурсаВыбран(Ключ, Шаблоны)
    Если Шаблоны.Включаемые <> Неопределено И НЕ ПодходитПодШаблон(Ключ, Шаблоны.Включаемые) Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат НЕ ПодходитПодШаблон(Ключ, Шаблоны.Исключаемые);
КонецФункции

Функция ПодходитПодШаблон(Ключ, Выражения)
    Для Каждого Выражение Из Выражения Цикл
        Если Выражение.Совпадает(Ключ) Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

// Переводит шаблоны ключей ("*" - любые символы, "?" - один символ) в регулярные выражения.
//
// Параметры:
//   Шаблоны - Массив из Строка, Неопределено - шаблоны
//
// Возвращаемое значение:
//   Массив из РегулярноеВыражение
//
Функция ВыраженияШаблонов(Шаблоны)
    Выражения = Новый Массив();
    Если Шаблоны = Неопределено Тогда
        Возврат Выражения;
    КонецЕсли;
    Для Каждого Шаблон Из Шаблоны Цикл
        Части = Новый Массив();
        Для Позиция = 1 По СтрДлина(Шаблон) Цикл
            Символ = Сред(Шаблон, Позиция, 1);
            Если Символ = "*" Тогда
                Части.Добавить(".*");
            ИначеЕсли Символ = "?" Тогда
                Части.Добавить(".");
            ИначеЕсли СтрНайти("\.^$|()[]{}+", Символ) > 0 Тогда
                Части.Добавить("\" + Символ);
            Иначе
                Части.Добавить(Символ);
            КонецЕсли;
        КонецЦикла;
        Выражения.Добавить(Новый РегулярноеВыражение("^" + СтрСоединить(Части) + "$"));
    КонецЦикла;
    Возврат Выражения;
КонецФункции

// Строит лейблы области по спецификации совместимости с Prometheus (Instrumentation
// Scope): имя, версия, адрес схемы и атрибуты области с префиксом otel_scope_. Атрибут,
// который после префикса и перевода совпадает с otel_scope_name, otel_scope_version или
// otel_scope_schema_url, отбрасывается (MUST). Пустые имя, версия и адрес схемы лейблов не дают.
// Исходный ключ имени, версии и адреса схемы - имя их лейбла, атрибута - ключ с префиксом.
//
// Параметры:
//   Область - ОтелОбластьИнструментирования - область метра
//
// Возвращаемое значение:
//   Соответствие - группы лейблов otel_scope_* (см. СгруппироватьЛейблы)
//
Функция ЛейблыОбласти(Область)
    Зарезервированные = Новый Соответствие();
    Зарезервированные.Вставить("otel_scope_name", Область.Имя());
    Зарезервированные.Вставить("otel_scope_version", Область.Версия());
    Зарезервированные.Вставить("otel_scope_schema_url", Область.АдресСхемы());

    Группы = Новый Соответствие();
    АтрибутыОбласти = Область.Атрибуты();
    Если АтрибутыОбласти <> Неопределено Тогда
        ГруппыАтрибутов = СгруппироватьЛейблы(АтрибутыОбласти.ВМассивOtlp(), "otel_scope_");
        Для Каждого КЗ Из ГруппыАтрибутов Цикл
            Если НЕ ЕстьКлюч(Зарезервированные, КЗ.Ключ) Тогда
                Группы.Вставить(КЗ.Ключ, КЗ.Значение);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    Для Каждого КЗ Из Зарезервированные Цикл
        Если ЗначениеЗаполнено(КЗ.Значение) Тогда
            ДобавитьВГруппу(Группы, КЗ.Ключ, КЗ.Ключ, КЗ.Значение);
        КонецЕсли;
    КонецЦикла;
    Возврат Группы;
КонецФункции

Функция ЕстьКлюч(Соответствие, Ключ)
    Для Каждого КЗ Из Соответствие Цикл
        Если КЗ.Ключ = Ключ Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Функция СкопироватьЛейблы(Лейблы)
    Копия = Новый Соответствие();
    Для Каждого КВ Из Лейблы Цикл
        Копия.Вставить(КВ.Ключ, КВ.Значение);
    КонецЦикла;
    Возврат Копия;
КонецФункции

// Группирует атрибуты в формате OTLP по имени лейбла Prometheus (спецификация совместимости,
// раздел Metric Attributes): имя лейбла - нормализованный ключ с префиксом (см.
// НормализоватьИмяЛейбла), значение - представление AnyValue (см. ЗначениеЛейбла). Значения
// группы упорядочены по исходным ключам, СклеитьГруппы склеивает их через ";".
//
// Параметры:
//   МассивАтрибутов - Массив, Неопределено - атрибуты OTLP (key/value)
//   Префикс - Строка - префикс имени лейбла
//
// Возвращаемое значение:
//   Соответствие - имя лейбла -> Массив из Структура (Ключ - исходный ключ с префиксом,
//       Значение - значение лейбла)
//
Функция СгруппироватьЛейблы(МассивАтрибутов, Префикс)
    Группы = Новый Соответствие();
    Если МассивАтрибутов = Неопределено Тогда
        Возврат Группы;
    КонецЕсли;
    Для Каждого Атрибут Из МассивАтрибутов Цикл
        ИсходныйКлюч = Префикс + Атрибут.Получить("key");
        Значение = ЗначениеЛейбла(Атрибут.Получить("value"));
        ДобавитьВГруппу(Группы, НормализоватьИмяЛейбла(ИсходныйКлюч), ИсходныйКлюч, Значение);
    КонецЦикла;
    Возврат Группы;
КонецФункции

// Добавляет значение в группу лейбла по порядку исходного ключа: при равных ключах - после
// уже добавленных значений.
//
// Параметры:
//   Группы - Соответствие - группы лейблов (мутируется, см. СгруппироватьЛейблы)
//   ИмяЛейбла - Строка - имя лейбла
//   ИсходныйКлюч - Строка - исходный ключ значения
//   Значение - Строка - значение лейбла
//
Процедура ДобавитьВГруппу(Группы, ИмяЛейбла, ИсходныйКлюч, Значение)
    Группа = Группы.Получить(ИмяЛейбла);
    Если Группа = Неопределено Тогда
        Группа = Новый Массив();
        Группы.Вставить(ИмяЛейбла, Группа);
    КонецЕсли;
    ВставитьПоПорядкуКлюча(Группа, Новый Структура("Ключ, Значение", ИсходныйКлюч, Значение));
КонецПроцедуры

// Добавляет в группы лейблов значения других групп по порядку исходных ключей. Массивы
// добавляемых групп не меняются.
//
// Параметры:
//   Группы - Соответствие - группы лейблов (мутируется, см. СгруппироватьЛейблы)
//   Добавляемые - Соответствие - добавляемые группы лейблов
//
Процедура ДобавитьГруппы(Группы, Добавляемые)
    Для Каждого КЗ Из Добавляемые Цикл
        Для Каждого Элемент Из КЗ.Значение Цикл
            ДобавитьВГруппу(Группы, КЗ.Ключ, Элемент.Ключ, Элемент.Значение);
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

// Склеивает значения групп лейблов через ";" в порядке исходных ключей.
//
// Параметры:
//   Группы - Соответствие - группы лейблов (см. СгруппироватьЛейблы)
//
// Возвращаемое значение:
//   Соответствие - лейблы
//
Функция СклеитьГруппы(Группы)
    Лейблы = Новый Соответствие();
    Для Каждого КЗ Из Группы Цикл
        Значения = Новый Массив();
        Для Каждого Элемент Из КЗ.Значение Цикл
            Значения.Добавить(Элемент.Значение);
        КонецЦикла;
        Лейблы.Вставить(КЗ.Ключ, СтрСоединить(Значения, ";"));
    КонецЦикла;
    Возврат Лейблы;
КонецФункции

// Вставляет элемент в массив, упорядоченный по ключу в порядке кодов символов.
//
// Параметры:
//   Массив - Массив из Структура - элементы с полем Ключ (мутируется)
//   Элемент - Структура - вставляемый элемент
//
Процедура ВставитьПоПорядкуКлюча(Массив, Элемент)
    Индекс = 0;
    Пока Индекс < Массив.Количество() И СравнитьПоКодам(Массив[Индекс].Ключ, Элемент.Ключ) <= 0 Цикл
        Индекс = Индекс + 1;
    КонецЦикла;
    Массив.Вставить(Индекс, Элемент);
КонецПроцедуры

// Сравнивает строки по кодам символов, без учета правил сортировки языка.
//
// Параметры:
//   Первая - Строка
//   Вторая - Строка
//
// Возвращаемое значение:
//   Число - -1, 0 или 1
//
Функция СравнитьПоКодам(Первая, Вторая)
    Длина = Мин(СтрДлина(Первая), СтрДлина(Вторая));
    Для Позиция = 1 По Длина Цикл
        Разница = КодСимвола(Первая, Позиция) - КодСимвола(Вторая, Позиция);
        Если Разница <> 0 Тогда
            Возврат ?(Разница < 0, -1, 1);
        КонецЕсли;
    КонецЦикла;
    Разница = СтрДлина(Первая) - СтрДлина(Вторая);
    Если Разница = 0 Тогда
        Возврат 0;
    КонецЕсли;
    Возврат ?(Разница < 0, -1, 1);
КонецФункции

// Возвращает значение лейбла для AnyValue в формате OTLP по правилам представления AnyValue для
// протоколов вне OTLP (Common, AnyValue representation for non-OTLP protocols): строка - как
// есть, двоичные данные - base64, пустое значение - пустая строка, число и булево - JSON, массив -
// JSON-массив, отображение - JSON-объект.
//
// Параметры:
//   ЗначениеОбъект - Соответствие, Произвольный - AnyValue
//
// Возвращаемое значение:
//   Строка
//
Функция ЗначениеЛейбла(ЗначениеОбъект)
    Если ТипЗнч(ЗначениеОбъект) <> Тип("Соответствие") Тогда
        Возврат Строка(ЗначениеОбъект);
    КонецЕсли;
    Строковое = ЗначениеОбъект.Получить("stringValue");
    Если Строковое <> Неопределено Тогда
        Возврат Строковое;
    КонецЕсли;
    Байты = ЗначениеОбъект.Получить("bytesValue");
    Если Байты <> Неопределено Тогда
        Возврат БайтыВBase64(Байты);
    КонецЕсли;
    Если ЗначениеОбъект.Количество() = 0 Тогда
        // Пустое AnyValue: поле значения не заполнено
        Возврат "";
    КонецЕсли;
    Возврат ЗначениеВJSON(ЗначениеОбъект);
КонецФункции

// Возвращает JSON-значение AnyValue в формате OTLP по правилам для элементов массива и значений
// отображения: строка и двоичные данные (base64) - JSON-строка, пустое значение - null.
//
// Параметры:
//   ЗначениеОбъект - Соответствие, Произвольный - AnyValue
//
// Возвращаемое значение:
//   Строка
//
Функция ЗначениеВJSON(ЗначениеОбъект)
    Если ТипЗнч(ЗначениеОбъект) <> Тип("Соответствие") Тогда
        Возврат "null";
    КонецЕсли;
    Строковое = ЗначениеОбъект.Получить("stringValue");
    Если Строковое <> Неопределено Тогда
        Возврат СтрокаВJSON(Строковое);
    КонецЕсли;
    Числовое = ЗначениеОбъект.Получить("intValue");
    Если Числовое = Неопределено Тогда
        Числовое = ЗначениеОбъект.Получить("doubleValue");
    КонецЕсли;
    Если Числовое <> Неопределено Тогда
        Возврат ЧислоВТекст(Числовое);
    КонецЕсли;
    Булево = ЗначениеОбъект.Получить("boolValue");
    Если Булево <> Неопределено Тогда
        Возврат ?(Булево = Истина, "true", "false");
    КонецЕсли;
    Байты = ЗначениеОбъект.Получить("bytesValue");
    Если Байты <> Неопределено Тогда
        Возврат СтрокаВJSON(БайтыВBase64(Байты));
    КонецЕсли;
    ЗначениеМассива = ЗначениеОбъект.Получить("arrayValue");
    Если ЗначениеМассива <> Неопределено Тогда
        Возврат МассивВJSON(ЗначениеМассива.Получить("values"));
    КонецЕсли;
    ЗначениеОтображения = ЗначениеОбъект.Получить("kvlistValue");
    Если ЗначениеОтображения <> Неопределено Тогда
        Возврат ОтображениеВJSON(ЗначениеОтображения.Получить("values"));
    КонецЕсли;
    Возврат "null";
КонецФункции

Функция МассивВJSON(Значения)
    Элементы = Новый Массив();
    Если Значения <> Неопределено Тогда
        Для Каждого Элемент Из Значения Цикл
            Элементы.Добавить(ЗначениеВJSON(Элемент));
        КонецЦикла;
    КонецЕсли;
    Возврат "[" + СтрСоединить(Элементы, ",") + "]";
КонецФункции

// Возвращает JSON-объект отображения AnyValue (kvlistValue): ключи - JSON-строки, значения - по
// правилам ЗначениеВJSON.
//
// Параметры:
//   Пары - Массив из Соответствие, Неопределено - пары key/value
//
// Возвращаемое значение:
//   Строка
//
Функция ОтображениеВJSON(Пары)
    Элементы = Новый Массив();
    Если Пары <> Неопределено Тогда
        Для Каждого Пара Из Пары Цикл
            Ключ = СтрокаВJSON(Пара.Получить("key"));
            Элементы.Добавить(Ключ + ":" + ЗначениеВJSON(Пара.Получить("value")));
        КонецЦикла;
    КонецЕсли;
    Возврат "{" + СтрСоединить(Элементы, ",") + "}";
КонецФункции

// Возвращает base64 двоичных данных AnyValue: в OTLP JSON bytesValue уже строка base64.
//
// Параметры:
//   Байты - Строка, ДвоичныеДанные - значение bytesValue
//
// Возвращаемое значение:
//   Строка
//
Функция БайтыВBase64(Байты)
    Если ТипЗнч(Байты) = Тип("ДвоичныеДанные") Тогда
        Возврат Base64Строка(Байты);
    КонецЕсли;
    Возврат Строка(Байты);
КонецФункции

Функция СтрокаВJSON(Значение)
    Результат = СтрЗаменить(Строка(Значение), "\", "\\");
    Результат = СтрЗаменить(Результат, """", "\""");
    Результат = СтрЗаменить(Результат, Символы.ПС, "\n");
    Результат = СтрЗаменить(Результат, Символы.ВК, "\r");
    Результат = СтрЗаменить(Результат, Символы.Таб, "\t");
    Возврат """" + Результат + """";
КонецФункции

// Заполняет таблицу перевода единиц UCUM в слова Prometheus (спецификация
// Prometheus and OpenMetrics Compatibility, раздел Metric Metadata) и слова
// единиц времени для знаменателя скорости.
//
Процедура ЗаполнитьСловаЕдиниц()
    СловаЕдиниц = Новый Соответствие();
    СловаЕдиниц.Вставить("d", "days");
    СловаЕдиниц.Вставить("h", "hours");
    СловаЕдиниц.Вставить("min", "minutes");
    СловаЕдиниц.Вставить("s", "seconds");
    СловаЕдиниц.Вставить("ms", "milliseconds");
    СловаЕдиниц.Вставить("us", "microseconds");
    СловаЕдиниц.Вставить("ns", "nanoseconds");
    СловаЕдиниц.Вставить("By", "bytes");
    СловаЕдиниц.Вставить("KiBy", "kibibytes");
    СловаЕдиниц.Вставить("MiBy", "mebibytes");
    СловаЕдиниц.Вставить("GiBy", "gibibytes");
    СловаЕдиниц.Вставить("TiBy", "tebibytes");
    СловаЕдиниц.Вставить("kBy", "kilobytes");
    СловаЕдиниц.Вставить("MBy", "megabytes");
    СловаЕдиниц.Вставить("GBy", "gigabytes");
    СловаЕдиниц.Вставить("TBy", "terabytes");
    СловаЕдиниц.Вставить("m", "meters");
    СловаЕдиниц.Вставить("V", "volts");
    СловаЕдиниц.Вставить("A", "amperes");
    СловаЕдиниц.Вставить("J", "joules");
    СловаЕдиниц.Вставить("W", "watts");
    СловаЕдиниц.Вставить("g", "grams");
    СловаЕдиниц.Вставить("Cel", "celsius");
    СловаЕдиниц.Вставить("Hz", "hertz");
    СловаЕдиниц.Вставить("%", "percent");

    СловаЕдиницВремени = Новый Соответствие();
    СловаЕдиницВремени.Вставить("d", "day");
    СловаЕдиницВремени.Вставить("h", "hour");
    СловаЕдиницВремени.Вставить("min", "minute");
    СловаЕдиницВремени.Вставить("s", "second");
    СловаЕдиницВремени.Вставить("ms", "millisecond");
    СловаЕдиницВремени.Вставить("us", "microsecond");
    СловаЕдиницВремени.Вставить("ns", "nanosecond");
КонецПроцедуры

Функция НормализоватьИмя(Имя)
    Если Имя = "" Тогда
        Возврат "_";
    КонецЕсли;

    Результат = РВНедопустимые.Заменить(Имя, "_");
    Результат = РВДубли.Заменить(Результат, "_");
    Результат = РВХвост.Заменить(Результат, "");

    Если РВЦифра.Совпадает(Результат) Тогда
        Результат = "_" + Результат;
    КонецЕсли;

    Если Результат = "" Тогда
        Возврат "_";
    КонецЕсли;

    Возврат Результат;
КонецФункции

// Нормализует имя лейбла: в отличие от имени метрики, двоеточие в нем недопустимо
// ([a-zA-Z_][a-zA-Z0-9_]*) и тоже заменяется на "_".
//
// Параметры:
//   Имя - Строка - ключ атрибута с префиксом
//
// Возвращаемое значение:
//   Строка
//
Функция НормализоватьИмяЛейбла(Имя)
    Возврат НормализоватьИмя(СтрЗаменить(Имя, ":", "_"));
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Читатель метрик Prometheus (pull-модель) по спецификации OpenTelemetry.
// Конвертирует OTel метрики в семейства Prometheus text format 0.0.4, текст формирует библиотека
// prometheus. Имена переводятся по стратегии UnderscoreEscapingWithSuffixes: недопустимые символы
// заменяются на "_", добавляются суффиксы единиц и типа (_total).
//
// Конструктор. Инициализирует внутреннее состояние читателя.
//
Процедура ПриСозданииОбъекта()
    Метры = Новый Массив();
    Продюсеры = Новый Массив();
    Блокировка = Новый БлокировкаРесурса();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics");
    РВНедопустимые = Новый РегулярноеВыражение("[^a-zA-Z0-9_:]");
    РВДубли = Новый РегулярноеВыражение("_{2,}");
    РВХвост = Новый РегулярноеВыражение("_+$");
    РВЦифра = Новый РегулярноеВыражение("^[0-9]");
    РВСкобки = Новый РегулярноеВыражение("\{[^}]*\}");
    ФильтрМетрик = Неопределено;
    Зарегистрирован = Новый АтомарноеБулево(Ложь);
    Закрыт = Новый АтомарноеБулево(Ложь);
    ШаблоныАтрибутовРесурса = Неопределено;
    ЛимитМощности = 2000;
    ЛимитыМощностиПоВиду = Новый Соответствие();
    АгрегацииПоВиду = Новый Соответствие();
    ЗаполнитьСловаЕдиниц();
КонецПроцедуры

#КонецОбласти
