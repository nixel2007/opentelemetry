#Использовать atomic
#Использовать logos
#Использовать extends

#Область ОписаниеПеременных

// Строка - имя инструмента
Перем Имя;
// Строка - описание инструмента
Перем Описание;
// Строка - единица измерения
Перем ЕдиницаИзмерения;
// Массив из Структура - записи хранилищ потоков (см. ОтелПотокиМетрик.СоздатьХранилища).
//   Не изменяется после публикации: замена списка - новым массивом
Перем Хранилища;
// Структура, Неопределено - дескриптор инструмента для разрешения потоков метром
Перем Дескриптор;
// Массив, Неопределено - разрешенные ключи атрибутов (устаревшая настройка без метра)
Перем РазрешенныеКлючиАтрибутов;
// Массив, Неопределено - исключенные ключи атрибутов (устаревшая настройка без метра)
Перем ИсключенныеКлючиАтрибутов;
// Объект - логгер
Перем Лог;
// АтомарноеБулево - признак включенности
Перем Включен;
// АтомарноеБулево - разделяемый флаг включенности метра (ссылка из ОтелМетр)
Перем МетрВключен;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Instrument - потокобезопасный объект.
// Все публичные методы безопасны для параллельного вызова из нескольких потоков.

// Возвращает имя инструмента.
//
// Возвращаемое значение:
//   Строка
//
Функция Имя() Экспорт
    Возврат Имя;
КонецФункции

// Возвращает описание инструмента.
//
// Возвращаемое значение:
//   Строка
//
Функция Описание() Экспорт
    Возврат Описание;
КонецФункции

// Возвращает единицу измерения.
//
// Возвращаемое значение:
//   Строка
//
Функция ЕдиницаИзмерения() Экспорт
    Возврат ЕдиницаИзмерения;
КонецФункции

// Записывает значение с атрибутами во все потоки инструмента (по потоку на читателя и View).
// Вызывается из наследников (Счетчик, Датчик и т.д.).
//
// По спецификации OpenTelemetry Metrics API синхронные инструменты SHOULD NOT
// пробрасывать пользовательские исключения наружу: SDK перехватывает ошибки
// записи в агрегатор и логирует их, чтобы измерение не нарушало бизнес-поток
// вызывающего кода.
//
// Параметры:
//   Значение - Число - записываемое значение
//   Атрибуты - ОтелАтрибуты, Неопределено - атрибуты точки данных
//   Контекст - Соответствие, Неопределено - контекст для SpanContext
//
Процедура Записать(Знач Значение, Атрибуты = Неопределено, Контекст = Неопределено) Экспорт
    Если НЕ Включен.Получить() ИЛИ НЕ МетрВключен.Получить() Тогда
        Возврат;
    КонецЕсли;

    Если ТипЗнч(Значение) <> Тип("Число") Тогда
        Лог.Предупреждение("Записываемое значение не является числом: %1. Измерение проигнорировано", ТипЗнч(Значение));
        Возврат;
    КонецЕсли;

    Для Каждого Запись Из Хранилища Цикл
        Попытка
            Запись.Хранилище.Записать(Значение, Атрибуты, Контекст);
        Исключение
            Лог.Предупреждение("Ошибка записи значения в агрегатор: %1", ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;
КонецПроцедуры

// Собирает данные первого потока инструмента, не начиная новый интервал сбора.
// Читатели собирают потоки методом СобратьДляЧитателя.
//
// Параметры:
//   пРесурс - ОтелРесурс - ресурс телеметрии
//   пОбластьИнструментирования - ОтелОбластьИнструментирования - область
//   ИмяМетрики - Строка - имя метрики
//   ОписаниеМетрики - Строка - описание метрики
//
// Возвращаемое значение:
//   ОтелДанныеМетрики, Неопределено
//
Функция Собрать(пРесурс, пОбластьИнструментирования, ИмяМетрики, ОписаниеМетрики) Экспорт
    Текущие = Хранилища;
    Если Текущие.Количество() = 0 Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат Текущие[0].Хранилище.СобратьСнимок(пРесурс, пОбластьИнструментирования, ИмяМетрики, ОписаниеМетрики);
КонецФункции

// Собирает потоки инструмента для читателя с его временной агрегацией. Если у читателя
// нет своих потоков (метр создан без провайдера), собираются потоки метра без читателя.
//
// Параметры:
//   Читатель - Объект - читатель метрик
//   Ресурс - ОтелРесурс - ресурс телеметрии
//   ОбластьИнструментирования - ОтелОбластьИнструментирования - область
//   ВремяСбора - Строка, Неопределено - время сбора читателя в наносекундах
//
// Возвращаемое значение:
//   Массив из ОтелДанныеМетрики
//
Функция СобратьДляЧитателя(Читатель, Ресурс, ОбластьИнструментирования, ВремяСбора = Неопределено) Экспорт
    Результат = Новый Массив();
    Для Каждого Запись Из ОтелПотокиМетрик.ХранилищаЧитателя(Хранилища, Читатель) Цикл
        Временность = ОтелПотокиМетрик.ВременнаяАгрегацияЧитателя(Читатель, Запись.Хранилище.Вид());
        Данные = Запись.Хранилище.Собрать(Ресурс, ОбластьИнструментирования, Временность, ВремяСбора);
        Если Данные <> Неопределено Тогда
            Результат.Добавить(Данные);
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Завершает интервал сбора всех потоков после Собрать: для дельта-временности
// начинается новый интервал, для кумулятивной сбрасываются exemplars.
//
// Параметры:
//   Временность - Число - тип временной агрегации из ОтелВременнаяАгрегация (необязательный, по умолчанию дельта)
//
Процедура ОчиститьТочкиДанных(Временность = Неопределено) Экспорт
    Для Каждого Запись Из Хранилища Цикл
        Запись.Хранилище.ОчиститьТочкиДанных(Временность);
    КонецЦикла;
КонецПроцедуры

// Возвращает количество серий первого потока.
//
// Возвращаемое значение:
//   Число
//
Функция КоличествоСерий() Экспорт
    Текущие = Хранилища;
    Если Текущие.Количество() = 0 Тогда
        Возврат 0;
    КонецЕсли;
    Возврат Текущие[0].Хранилище.КоличествоСерий();
КонецФункции

// Устанавливает лимит мощности (cardinality limit) всех потоков.
//
// Параметры:
//   Лимит - Число - максимальное количество серий
//
Процедура УстановитьЛимитМощности(Лимит) Экспорт
    Для Каждого Запись Из Хранилища Цикл
        Запись.Хранилище.УстановитьЛимитМощности(Лимит);
    КонецЦикла;
КонецПроцедуры

// Устанавливает фильтр exemplars всех потоков.
//
// Параметры:
//   Фильтр - Число - значение из ОтелФильтрЭкземпляров
//
Процедура УстановитьФильтрЭкземпляров(Фильтр) Экспорт
    Для Каждого Запись Из Хранилища Цикл
        Запись.Хранилище.УстановитьФильтрЭкземпляров(Фильтр);
    КонецЦикла;
КонецПроцедуры

// Устанавливает фабрику резервуаров exemplars (per-timeseries) всех потоков.
// Каждый новый ключ атрибутов получает свой экземпляр резервуара через Фабрика.СоздатьРезервуар().
//
// Параметры:
//   Фабрика - ОтелФабрикаПростыхРезервуаров - фабрика резервуаров (ОтелФабрикаВыровненныхРезервуаровГистограммы и др.)
//
Процедура УстановитьФабрикуРезервуаров(Фабрика) Экспорт
    Для Каждого Запись Из Хранилища Цикл
        Запись.Хранилище.УстановитьФабрикуРезервуаров(Фабрика);
    КонецЦикла;
КонецПроцедуры

// Устанавливает резервуар экземпляров.
// Устаревший метод: Используйте УстановитьФабрикуРезервуаров для соответствия спецификации
//             (individual reservoirs MUST be instantiated per metric-timeseries).
//
// Параметры:
//   Резервуар - ОтелРезервуарЭкземпляров, ОтелВыровненныйРезервуарГистограммы - резервуар
//
Процедура УстановитьРезервуарЭкземпляров(Резервуар) Экспорт
    Лог.Предупреждение("Устаревший API УстановитьРезервуарЭкземпляров: используйте УстановитьФабрикуРезервуаров");
    Для Каждого Запись Из Хранилища Цикл
        Запись.Хранилище.УстановитьРезервуарЭкземпляров(Резервуар);
    КонецЦикла;
КонецПроцедуры

// Устанавливает разрешенные ключи атрибутов всех потоков.
//
// Параметры:
//   Ключи - Массив - массив строк
//
Процедура УстановитьРазрешенныеКлючиАтрибутов(Ключи) Экспорт
    РазрешенныеКлючиАтрибутов = Ключи;
    ОбновитьФильтрАтрибутов();
КонецПроцедуры

// Устанавливает массив исключенных ключей атрибутов всех потоков (exclude-list).
//
// Параметры:
//   Ключи - Массив - массив строк
//
Процедура УстановитьИсключенныеКлючиАтрибутов(Ключи) Экспорт
    ИсключенныеКлючиАтрибутов = Ключи;
    ОбновитьФильтрАтрибутов();
КонецПроцедуры

// Возвращает признак включенности инструмента.
// По спеке: MUST вернуть Ложь, если все представления используют Drop Aggregation;
// Ложь возвращает и инструмент no-op метра закрытого провайдера.
// Параметр Атрибуты зарезервирован для расширяемости (MUST принимать по спеке).
//
// Авторам инструментирующих библиотек СЛЕДУЕТ вызывать этот метод
// перед каждым вызовом Add()/Record(), чтобы получать актуальное значение
// и пропускать дорогостоящие вычисления атрибутов, если инструмент отключен.
// Возвращаемое значение может меняться со временем (через Отключить или
// регистрацию View), кэшировать его на длительное время не следует.
//
// Параметры:
//   Атрибуты - ОтелАтрибуты, Неопределено - зарезервировано для будущего использования
//
// Возвращаемое значение:
//   Булево
//
// BSLLS:UnusedParameters-off
Функция Включен(Атрибуты = Неопределено) Экспорт
// BSLLS:UnusedParameters-on
    Возврат МетрВключен.Получить() И Включен.Получить() И НЕ ВсеПотокиОтбрасывают();
КонецФункции

// Отключает инструмент.
//
Процедура Отключить() Экспорт
    Включен.Установить(Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает записи хранилищ потоков инструмента.
//
// Возвращаемое значение:
//   Массив из Структура
//
Функция Хранилища() Экспорт
    Возврат Хранилища;
КонецФункции

// Заменяет записи хранилищ потоков. Вызывается метром при создании инструмента
// и повторном разрешении потоков.
//
// Параметры:
//   Записи - Массив из Структура - записи хранилищ (см. ОтелПотокиМетрик.СоздатьХранилища)
//
Процедура УстановитьХранилища(Записи) Экспорт
    Хранилища = Записи;
КонецПроцедуры

// Возвращает дескриптор инструмента для разрешения потоков.
//
// Возвращаемое значение:
//   Структура, Неопределено
//
Функция Дескриптор() Экспорт
    Возврат Дескриптор;
КонецФункции

// Устанавливает дескриптор инструмента для разрешения потоков.
//
// Параметры:
//   Значение - Структура - дескриптор (см. ОтелПотокиМетрик.НовыйДескриптор)
//
Процедура УстановитьДескриптор(Значение) Экспорт
    Дескриптор = Значение;
КонецПроцедуры

// Устанавливает разделяемый флаг включенности метра.
// Передается из ОтелМетр при создании инструмента.
//
// Параметры:
//   Значение - АтомарноеБулево - разделяемый флаг метра
//
Процедура УстановитьМетрВключен(Значение) Экспорт
    МетрВключен = Значение;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбновитьФильтрАтрибутов()
    Для Каждого Запись Из Хранилища Цикл
        Запись.Хранилище.УстановитьФильтрАтрибутов(РазрешенныеКлючиАтрибутов, ИсключенныеКлючиАтрибутов);
    КонецЦикла;
КонецПроцедуры

Функция ВсеПотокиОтбрасывают()
    Текущие = Хранилища;
    Если Текущие.Количество() = 0 Тогда
        Возврат Ложь;
    КонецЕсли;
    Для Каждого Запись Из Текущие Цикл
        Если НЕ Запись.Хранилище.ЭтоОтбрасывание() Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

// Базовый синхронный инструмент метрик: проверяет измерение и записывает его во все
// потоки инструмента. Агрегация, лимит мощности, фильтр атрибутов и exemplars - в
// хранилищах потоков (ОтелХранилищеМетрики).
//
// Параметры:
//   ИмяИнструмента - Строка - имя инструмента
//   ОписаниеИнструмента - Строка - описание
//   Единица - Строка - единица измерения
//   Агрегатор - Объект, Неопределено - агрегатор единственного потока; Неопределено - потоки
//       задает метр (УстановитьХранилища)
//
&Реализует("ИнтерфейсИнструментМетрик")
Процедура ПриСозданииОбъекта(ИмяИнструмента, ОписаниеИнструмента, Единица, Агрегатор)
    Имя = ИмяИнструмента;
    Описание = ОписаниеИнструмента;
    ЕдиницаИзмерения = Единица;
    Хранилища = Новый Массив();
    Если Агрегатор <> Неопределено Тогда
        Хранилище = Новый ОтелХранилищеМетрики(Имя, Описание, ЕдиницаИзмерения, Агрегатор);
        Запись = ОтелПотокиМетрик.НоваяЗаписьХранилища(Хранилище);
        Хранилища.Добавить(Запись);
    КонецЕсли;
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry");
    Включен = Новый АтомарноеБулево(Истина);
    МетрВключен = Новый АтомарноеБулево(Истина);
КонецПроцедуры

#КонецОбласти
