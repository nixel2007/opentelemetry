#Область ОписаниеПеременных

// СинхронизированнаяКарта - задания callback-ов, не завершившиеся за таймаут:
//   регистрация callback-а -> ФоновоеЗадание
Перем ЗависшиеЗадания;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Исполнитель - потокобезопасный объект: методы безопасны для конкурентного вызова.

// Вызывает callback асинхронного инструмента с таймаутом (Metrics SDK: "The implementation
// SHOULD use a timeout to prevent indefinite callback execution"). См. ВызватьСТаймаутом.
//
// Параметры:
//   Регистрация - Структура - регистрация callback-а: Callback, Состояние
//   ТаймаутМс - Число - таймаут в миллисекундах; 0 - вызов в текущем потоке без таймаута
//   ИмяИнструмента - Строка - имя инструмента для сообщений лога
//   Лог - Объект - логгер
//
// Возвращаемое значение:
//   Массив, Неопределено - записи наблюдения; Неопределено при ошибке, таймауте или пропуске вызова
//
Функция ВыполнитьCallback(Регистрация, ТаймаутМс, ИмяИнструмента, Лог) Экспорт
    Описание = СтрШаблон("callback async-инструмента %1", ИмяИнструмента);
    Возврат ВызватьСТаймаутом("ВызватьCallback", Регистрация, ТаймаутМс, Описание, Лог);
КонецФункции

// Вызывает мульти-callback нескольких асинхронных инструментов с таймаутом. См. ВызватьСТаймаутом.
//
// Параметры:
//   Регистрация - Структура - регистрация мульти-callback-а: Callback, Инструменты, Состояние
//   ТаймаутМс - Число - таймаут в миллисекундах; 0 - вызов в текущем потоке без таймаута
//   Лог - Объект - логгер
//
// Возвращаемое значение:
//   Соответствие, Неопределено - наблюдения инструментов (см. ВызватьМультиCallback); Неопределено
//       при ошибке, таймауте или пропуске вызова
//
Функция ВыполнитьМультиCallback(Регистрация, ТаймаутМс, Лог) Экспорт
    Возврат ВызватьСТаймаутом("ВызватьМультиCallback", Регистрация, ТаймаутМс, "мульти-callback", Лог);
КонецФункции

// Служебный метод: точка входа фонового задания callback-а инструмента.
//
// Параметры:
//   Регистрация - Структура - регистрация callback-а: Callback, Состояние
//
// Возвращаемое значение:
//   Массив - записи наблюдения
//
Функция ВызватьCallback(Регистрация) Экспорт
    Наблюдение = Новый ОтелНаблюдениеМетрики();
    Если Регистрация.Состояние = Неопределено Тогда
        Регистрация.Callback.Выполнить(Наблюдение);
    Иначе
        Регистрация.Callback.Выполнить(Наблюдение, Регистрация.Состояние);
    КонецЕсли;
    Возврат Наблюдение.Записи();
КонецФункции

// Служебный метод: точка входа фонового задания мульти-callback-а. Наблюдение каждого инструмента
// доступно по самому инструменту (Metrics API: callback нескольких инструментов MUST различать
// инструмент каждого наблюдения) и по имени инструмента. Одноименные инструменты разного вида или
// единицы различаются только по инструменту: по имени доступно наблюдение первого из них.
//
// Параметры:
//   Регистрация - Структура - регистрация мульти-callback-а: Callback, Инструменты, Состояние
//
// Возвращаемое значение:
//   Соответствие - инструмент -> ОтелНаблюдениеМетрики и имя инструмента -> ОтелНаблюдениеМетрики
//
Функция ВызватьМультиCallback(Регистрация) Экспорт
    Наблюдения = Новый Соответствие();
    Для Каждого Инструмент Из Регистрация.Инструменты Цикл
        Наблюдение = Новый ОтелНаблюдениеМетрики();
        Наблюдения.Вставить(Инструмент, Наблюдение);
        ИмяИнструмента = Инструмент.Имя();
        Если Наблюдения.Получить(ИмяИнструмента) = Неопределено Тогда
            Наблюдения.Вставить(ИмяИнструмента, Наблюдение);
        КонецЕсли;
    КонецЦикла;
    Если Регистрация.Состояние = Неопределено Тогда
        Регистрация.Callback.Выполнить(Наблюдения);
    Иначе
        Регистрация.Callback.Выполнить(Наблюдения, Регистрация.Состояние);
    КонецЕсли;
    Возврат Наблюдения;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вызывает метод исполнителя для регистрации. При таймауте больше 0 метод выполняется в фоновом
// задании, которое ждут не дольше таймаута; при 0 - в текущем потоке. Ошибка callback-а и
// истекший таймаут пишут предупреждение в лог, измерения вызова отбрасываются.
//
// Платформенное ограничение OneScript: фоновое задание нельзя прервать
// (https://github.com/EvilBeaver/OneScript/issues/1672), после таймаута оно продолжает работу.
// Пока оно выполняется, callback этой регистрации не вызывается: следующий сбор пропускает его
// с предупреждением. Так callback не выполняется параллельно сам с собой после таймаута, а
// зависшие задания не копятся.
//
// Параметры:
//   ИмяМетода - Строка - метод исполнителя: ВызватьCallback или ВызватьМультиCallback
//   Регистрация - Структура - регистрация callback-а
//   ТаймаутМс - Число - таймаут в миллисекундах; 0 - без таймаута
//   Описание - Строка - описание callback-а для сообщений лога
//   Лог - Объект - логгер
//
// Возвращаемое значение:
//   Произвольный, Неопределено - результат метода; Неопределено при ошибке, таймауте или пропуске
//
Функция ВызватьСТаймаутом(ИмяМетода, Регистрация, ТаймаутМс, Описание, Лог)
    Если ТаймаутМс <= 0 Тогда
        Попытка
            Возврат Новый Действие(ЭтотОбъект, ИмяМетода).Выполнить(Регистрация);
        Исключение
            Лог.Предупреждение(СтрШаблон("Ошибка %1: %2", Описание, ОписаниеОшибки()));
            Возврат Неопределено;
        КонецПопытки;
    КонецЕсли;
    Если ЗаданиеВыполняется(Регистрация) Тогда
        Сообщение = СтрШаблон(
            "Вызов %1 пропущен: задание предыдущего вызова еще выполняется после таймаута", Описание);
        Лог.Предупреждение(Сообщение);
        Возврат Неопределено;
    КонецЕсли;

    Параметры = Новый Массив();
    Параметры.Добавить(Регистрация);
    Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, ИмяМетода, Параметры);
    Если НЕ Задание.ОжидатьЗавершения(ТаймаутМс) Тогда
        ЗависшиеЗадания.Вставить(Регистрация, Задание);
        Сообщение = СтрШаблон(
            "Таймаут %1 (%2 мс): измерения отброшены. Платформенное ограничение OneScript: задание"
            + " продолжит работу в фоне, до его завершения callback не вызывается"
            + " (см. https://github.com/EvilBeaver/OneScript/issues/1672).",
            Описание, ТаймаутМс);
        Лог.Предупреждение(Сообщение);
        Возврат Неопределено;
    КонецЕсли;
    Если Задание.Состояние <> СостояниеФоновогоЗадания.Завершено Тогда
        ОписаниеСбоя = "<нет>";
        Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
            ОписаниеСбоя = Задание.ИнформацияОбОшибке.Описание;
        КонецЕсли;
        Лог.Предупреждение(СтрШаблон("Ошибка %1: %2", Описание, ОписаниеСбоя));
        Возврат Неопределено;
    КонецЕсли;
    Возврат Задание.Результат;
КонецФункции

// Проверяет, выполняется ли задание регистрации, не завершившееся за таймаут. Завершившееся
// задание забывается.
//
// Параметры:
//   Регистрация - Структура - регистрация callback-а
//
// Возвращаемое значение:
//   Булево
//
Функция ЗаданиеВыполняется(Регистрация)
    Задание = ЗависшиеЗадания.ПолучитьИлиУмолчание(Регистрация, Неопределено);
    Если Задание = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;
    Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
        Возврат Истина;
    КонецЕсли;
    ЗависшиеЗадания.Удалить(Регистрация);
    Возврат Ложь;
КонецФункции

// Исполнитель callback-ов асинхронных инструментов и мульти-callback-ов: вызывает их с таймаутом
// и не запускает повторно callback, задание которого еще выполняется после таймаута.
//
Процедура ПриСозданииОбъекта()
    ЗависшиеЗадания = Новый СинхронизированнаяКарта(Новый КартаСоответствие());
КонецПроцедуры

#КонецОбласти
