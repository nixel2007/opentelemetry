#Использовать logos
#Использовать extends
#Использовать atomic

#Область ОписаниеПеременных

// ОтелОбластьИнструментирования - область инструментирования
Перем ОбластьИнструментирования;
// ОтелРесурс - Ресурс, описывающий источник телеметрии
Перем Ресурс;
// Массив - Массив зарегистрированных инструментов. Не изменяется после публикации:
//   регистрация заменяет его копией с новым инструментом
Перем Инструменты;
// БлокировкаРесурса - сериализует регистрацию инструментов и повторное разрешение потоков
Перем БлокировкаРегистрации;
// СинхронизированнаяКарта - Кэш инструментов по нормализованному имени
Перем ИнструментыПоИмени;
// СинхронизированнаяКарта - Дескрипторы инструментов по нормализованному имени
Перем ДескрипторыИнструментов;
// СинхронизированнаяКарта - Инструменты, созданные при конфликте вида или единицы измерения
//   с первой регистрацией имени (pass-through), по ключу "имя|вид|единица"
Перем ИнструментыПроходНасквозь;
// Число - Фильтр exemplars из ОтелФильтрЭкземпляров
Перем ФильтрЭкземпляров;
// Число - Лимит мощности (cardinality limit) потоков метра без читателей
Перем ЛимитМощности;
// Массив - Мульти-callback регистрации {Callback, Инструменты, Состояние}. Не изменяется
//   после публикации: регистрация и отмена заменяют его копией под БлокировкаРегистрации
Перем МультиОбратныеВызовы;
// Объект - Логгер библиотеки logos
Перем Лог;
// Массив - Зарегистрированные представления (Views) с селекторами
Перем Представления;
// Строка - Агрегация гистограмм по умолчанию потоков метра без читателей
//   (explicit_bucket_histogram или base2_exponential_bucket_histogram)
Перем АгрегацияГистограммПоУмолчанию;
// Булево - признак включенности метра: выключен у no-op метра закрытого провайдера
// Разделяемый объект АтомарноеБулево - инструменты хранят ссылку для динамической проверки Включен()
Перем МетрВключен;
// Массив - читатели метрик провайдера: у каждого свои потоки инструментов. Пустой - потоки
//   метра без читателя, их собирает любой читатель, которому передан метр
Перем Читатели;
// Соответствие - потоки по ключу "конвейер|имя потока" для предупреждений о конфликте
//   идентичности метрик. Изменяется под БлокировкаРегистрации
Перем ИменаПотоков;
// Соответствие - View, селектор которых уже проверен (ОтелПредставление -> Истина)
Перем ПроверенныеПредставления;
// Число - таймаут callback-ов асинхронных инструментов и мульти-callback-ов в миллисекундах
//   (0 - без таймаута). Изменяется под БлокировкаРегистрации
Перем ТаймаутОбратныхВызововМс;
// ОтелИсполнительОбратныхВызовов - вызывает мульти-callback-и с таймаутом
Перем Исполнитель;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Meter - потокобезопасный объект.
// Все публичные методы безопасны для параллельного вызова из нескольких потоков.

// Создает новый счетчик.
//
// По спецификации OpenTelemetry Metrics API имя инструмента MUST соответствовать
// регулярному выражению `[A-Za-z][A-Za-z0-9_./-]{0,254}`:
//   * Длина 1..255 символов.
//   * Первый символ - ASCII-буква.
//   * Допустимы ASCII-буквы, цифры, `_`, `.`, `/`, `-`.
// SDK SHOULD валидировать имя; невалидное имя приводит к логированию
// предупреждения и/или отклонению регистрации согласно политике SDK.
//
// Параметры:
//   Имя - Строка - имя счетчика (см. требования выше)
//   Описание - Строка - описание счетчика (по умолчанию "")
//   ЕдиницаИзмерения - Строка - единица измерения (по умолчанию "")
//   Совет - Структура, Неопределено - advisory-параметры (по умолчанию Неопределено)
//
// Возвращаемое значение:
//   ОтелСчетчик
//
Функция СоздатьСчетчик(Имя, Описание = "", ЕдиницаИзмерения = "", Совет = Неопределено) Экспорт
    Возврат СоздатьСинхронныйИнструмент("Counter", Имя, Описание, ЕдиницаИзмерения, Совет);
КонецФункции

// Создает новую гистограмму. Агрегация по умолчанию берется у читателя (явная или
// экспоненциальная гистограмма), вид инструмента всегда Histogram.
//
// Параметры:
//   Имя - Строка - имя гистограммы
//   Описание - Строка - описание гистограммы (по умолчанию "")
//   ЕдиницаИзмерения - Строка - единица измерения (по умолчанию "")
//   Совет - Структура, Неопределено - advisory-параметры (по умолчанию Неопределено)
//
// Возвращаемое значение:
//   ОтелГистограмма
//
Функция СоздатьГистограмму(Имя, Описание = "", ЕдиницаИзмерения = "", Совет = Неопределено) Экспорт
    Возврат СоздатьСинхронныйИнструмент("Histogram", Имя, Описание, ЕдиницаИзмерения, Совет);
КонецФункции

// Создает новую экспоненциальную гистограмму: инструмент с агрегацией
// base2_exponential_bucket_histogram по умолчанию и заданным числом бакетов.
//
// Параметры:
//   Имя - Строка - имя гистограммы
//   Описание - Строка - описание (по умолчанию "")
//   ЕдиницаИзмерения - Строка - единица измерения (по умолчанию "")
//   МаксБакетов - Число - максимальное количество бакетов (по умолчанию 160)
//
// Возвращаемое значение:
//   ОтелЭкспоненциальнаяГистограмма
//
// BSLLS:MagicNumber-off
Функция СоздатьЭкспоненциальнуюГистограмму(Имя, Описание = "", ЕдиницаИзмерения = "", МаксБакетов = 160) Экспорт
// BSLLS:MagicNumber-on
    АгрегацияИнструмента = ОтелАгрегация.ГистограммаЭкспоненциальная(МаксБакетов);
    Возврат СоздатьСинхронныйИнструмент("ExponentialHistogram", Имя, Описание, ЕдиницаИзмерения, Неопределено,
        АгрегацияИнструмента);
КонецФункции

// Создает новый реверсивный счетчик (UpDownCounter).
//
// Параметры:
//   Имя - Строка - имя счетчика
//   Описание - Строка - описание счетчика (по умолчанию "")
//   ЕдиницаИзмерения - Строка - единица измерения (по умолчанию "")
//   Совет - Структура, Неопределено - advisory-параметры (по умолчанию Неопределено)
//
// Возвращаемое значение:
//   ОтелРеверсивныйСчетчик
//
Функция СоздатьРеверсивныйСчетчик(Имя, Описание = "", ЕдиницаИзмерения = "", Совет = Неопределено) Экспорт
    Возврат СоздатьСинхронныйИнструмент("UpDownCounter", Имя, Описание, ЕдиницаИзмерения, Совет);
КонецФункции

// Создает новый датчик (Gauge).
//
// Параметры:
//   Имя - Строка - имя датчика
//   Описание - Строка - описание датчика (по умолчанию "")
//   ЕдиницаИзмерения - Строка - единица измерения (по умолчанию "")
//   Совет - Структура, Неопределено - advisory-параметры (по умолчанию Неопределено)
//
// Возвращаемое значение:
//   ОтелДатчик
//
Функция СоздатьДатчик(Имя, Описание = "", ЕдиницаИзмерения = "", Совет = Неопределено) Экспорт
    Возврат СоздатьСинхронныйИнструмент("Gauge", Имя, Описание, ЕдиницаИзмерения, Совет);
КонецФункции

// Создает наблюдаемый счетчик (ObservableCounter).
//
// Параметры:
//   Имя - Строка - имя инструмента
//   Callback - Действие, Массив, Неопределено - callback(-и) наблюдения (необязательный).
//       Принимаются: Неопределено (нет callback-ов), одиночный Действие,
//       Массив из Действие (N callback-ов, все регистрируются).
//       Требования к callback (Metrics API spec):
//       * SHOULD быть реентерабельным: SDK вызывает callback-и для каждого
//         MetricReader отдельно, в том числе параллельно из разных потоков.
//       * SHOULD NOT выполняться неограниченное время: без сетевых вызовов,
//         ожидания блокировок и тяжелого IO, иначе сбор метрик задерживается.
//       * SHOULD NOT делать дублирующие наблюдения (несколько измерений с одинаковыми
//         атрибутами) по всем callback-ам инструмента, включая callback-и
//         ЗарегистрироватьОбратныйВызов для нескольких инструментов.
//       * Для Counter возвращать абсолютное значение, не дельту (SDK вычитает дельту сам).
//       * SHOULD NOT пробрасывать исключения - SDK перехватывает ошибки callback,
//         логирует предупреждение и продолжает сбор по остальным callback-ам.
//       * Список callback-ов после регистрации в Meter рассматривается как immutable:
//         модификации возможны только через ДобавитьCallback / УдалитьCallback /
//         отписку регистрации (per Metrics API spec).
//   Описание - Строка - описание (необязательный)
//   ЕдиницаИзмерения - Строка - единица измерения (необязательный)
//   Совет - Структура, Неопределено - advisory-параметры (необязательный)
//
// Возвращаемое значение:
//   ОтелНаблюдаемыйСчетчик
//
// BSLLS:NumberOfOptionalParams-off
// BSLLS:LineLength-off
Функция СоздатьНаблюдаемыйСчетчик(Имя, Callback = Неопределено, Описание = "", ЕдиницаИзмерения = "", Совет = Неопределено) Экспорт
// BSLLS:LineLength-on
// BSLLS:NumberOfOptionalParams-on
    Возврат СоздатьАсинхронныйИнструмент("ObservableCounter", Имя, Callback, Описание, ЕдиницаИзмерения, Совет);
КонецФункции

// Создает наблюдаемый реверсивный счетчик (ObservableUpDownCounter).
//
// Параметры:
//   Имя - Строка - имя инструмента
//   Callback - Действие, Массив, Неопределено - callback(-и) наблюдения (необязательный).
//       Принимаются: Неопределено (нет callback-ов), одиночный Действие,
//       Массив из Действие (N callback-ов).
//       Требования к callback (Metrics API spec):
//       * SHOULD быть реентерабельным: SDK вызывает callback-и для каждого
//         MetricReader отдельно, в том числе параллельно из разных потоков.
//       * SHOULD NOT выполняться неограниченное время: без сетевых вызовов,
//         ожидания блокировок и тяжелого IO, иначе сбор метрик задерживается.
//       * SHOULD NOT делать дублирующие наблюдения (несколько измерений с одинаковыми
//         атрибутами) по всем callback-ам инструмента, включая callback-и
//         ЗарегистрироватьОбратныйВызов для нескольких инструментов.
//       * Возвращать абсолютное значение (SDK вычислит дельту/накопление).
//       * SHOULD NOT пробрасывать исключения - SDK перехватывает ошибки callback,
//         логирует предупреждение и продолжает сбор по остальным callback-ам.
//       * Список callback-ов после регистрации в Meter рассматривается как immutable:
//         модификации возможны только через ДобавитьCallback / УдалитьCallback /
//         отписку регистрации (per Metrics API spec).
//   Описание - Строка - описание (необязательный)
//   ЕдиницаИзмерения - Строка - единица измерения (необязательный)
//   Совет - Структура, Неопределено - advisory-параметры (необязательный)
//
// Возвращаемое значение:
//   ОтелНаблюдаемыйРеверсивныйСчетчик
//
// BSLLS:NumberOfOptionalParams-off
// BSLLS:LineLength-off
Функция СоздатьНаблюдаемыйРеверсивныйСчетчик(Имя, Callback = Неопределено, Описание = "", ЕдиницаИзмерения = "", Совет = Неопределено) Экспорт
// BSLLS:LineLength-on
// BSLLS:NumberOfOptionalParams-on
    Возврат СоздатьАсинхронныйИнструмент("ObservableUpDownCounter", Имя, Callback, Описание, ЕдиницаИзмерения, Совет);
КонецФункции

// Создает наблюдаемый датчик (ObservableGauge).
//
// Параметры:
//   Имя - Строка - имя инструмента
//   Callback - Действие, Массив, Неопределено - callback(-и) наблюдения (необязательный).
//       Принимаются: Неопределено, одиночный Действие, Массив из Действие.
//       Требования к callback (Metrics API spec):
//       * SHOULD быть реентерабельным: SDK вызывает callback-и для каждого
//         MetricReader отдельно, в том числе параллельно из разных потоков.
//       * SHOULD NOT выполняться неограниченное время: без сетевых вызовов,
//         ожидания блокировок и тяжелого IO, иначе сбор метрик задерживается.
//       * SHOULD NOT делать дублирующие наблюдения (несколько измерений с одинаковыми
//         атрибутами) по всем callback-ам инструмента, включая callback-и
//         ЗарегистрироватьОбратныйВызов для нескольких инструментов.
//       * Для Gauge достаточно возвращать текущее значение (последнее выигрывает).
//       * SHOULD NOT пробрасывать исключения - SDK перехватывает ошибки callback,
//         логирует предупреждение и продолжает сбор по остальным callback-ам.
//       * Список callback-ов после регистрации в Meter рассматривается как immutable:
//         модификации возможны только через ДобавитьCallback / УдалитьCallback /
//         отписку регистрации (per Metrics API spec).
//   Описание - Строка - описание (необязательный)
//   ЕдиницаИзмерения - Строка - единица измерения (необязательный)
//   Совет - Структура, Неопределено - подсказки SDK для агрегации (необязательный)
//
// Возвращаемое значение:
//   ОтелНаблюдаемыйДатчик - инструмент наблюдения
//
// BSLLS:NumberOfOptionalParams-off
// BSLLS:LineLength-off
Функция СоздатьНаблюдаемыйДатчик(Имя, Callback = Неопределено, Описание = "", ЕдиницаИзмерения = "", Совет = Неопределено) Экспорт
// BSLLS:LineLength-on
// BSLLS:NumberOfOptionalParams-on
    Возврат СоздатьАсинхронныйИнструмент("ObservableGauge", Имя, Callback, Описание, ЕдиницаИзмерения, Совет);
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Устанавливает признак включенности метра.
// Вызывается из ОтелПровайдерМетрик при создании no-op метра закрытого провайдера.
//
// Параметры:
//   Значение - Булево - признак включенности
//
Процедура УстановитьМетрВключен(Значение) Экспорт
    МетрВключен.Установить(Значение);
КонецПроцедуры

// Устанавливает читателей метрик провайдера: у каждого читателя свои потоки инструментов
// с его агрегацией, лимитом мощности и временной агрегацией. Вызывается провайдером
// до создания инструментов.
//
// Параметры:
//   Значение - Массив - читатели метрик
//
Процедура УстановитьЧитателей(Значение) Экспорт
    Читатели = Новый Массив();
    Если Значение <> Неопределено Тогда
        Для Каждого Читатель Из Значение Цикл
            Читатели.Добавить(Читатель);
        КонецЦикла;
    КонецЕсли;
    ОбновитьПотоки();
КонецПроцедуры

// Устанавливает зарегистрированные представления (Views) для метра и заново разрешает
// потоки созданных инструментов: потоки, конфигурация которых не изменилась, сохраняют данные.
//
// По спецификации Metrics SDK / View: если у View задано имя, то селектор SHOULD
// выбирать не более одного инструмента, иначе несколько инструментов будут
// переименованы в одно и то же имя метрики. На этапе регистрации SDK не может
// знать набор будущих инструментов, поэтому проверяется «узость» самого
// селектора: при заданном НовоеИмя селектор должен иметь точное имя инструмента
// (без "*" / Неопределено) - иначе в лог пишется предупреждение.
//
// Параметры:
//   Значение - Массив - массив пар {Селектор, Представление}
//
Процедура УстановитьПредставления(Значение) Экспорт
    Представления = ?(Значение = Неопределено, Новый Массив(), Значение);
    Для Каждого Пара Из Представления Цикл
        Представление = Пара.Получить("Представление");
        Селектор = Пара.Получить("Селектор");
        Если Представление = Неопределено ИЛИ Селектор = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        // Провайдер передает метру новый массив при каждой регистрации View:
        // селектор каждого View проверяется один раз
        Если ПроверенныеПредставления.Получить(Представление) = Неопределено Тогда
            ПроверенныеПредставления.Вставить(Представление, Истина);
            ПроверитьУзостьСелектораView(Селектор, Представление);
        КонецЕсли;
    КонецЦикла;
    ОбновитьПотоки();
КонецПроцедуры

// Устанавливает агрегацию гистограмм по умолчанию потоков метра без читателей.
// OTEL_EXPORTER_OTLP_METRICS_DEFAULT_HISTOGRAM_AGGREGATION
//
// Параметры:
//   Значение - Строка - "explicit_bucket_histogram" или "base2_exponential_bucket_histogram"
//
Процедура УстановитьАгрегациюГистограммПоУмолчанию(Значение) Экспорт
    АгрегацияГистограммПоУмолчанию = Значение;
    ОбновитьПотоки();
КонецПроцедуры

// Возвращает зарегистрированные представления (Views).
//
// Возвращаемое значение:
//   Массив из Соответствие
//
Функция ПолучитьПредставления() Экспорт
    Возврат Представления;
КонецФункции

// Возвращает все зарегистрированные инструменты.
//
// Возвращаемое значение:
//   Массив
//
Функция Инструменты() Экспорт
    Возврат Инструменты;
КонецФункции

// Возвращает ресурс, ассоциированный с метрикой.
//
// Возвращаемое значение:
//   ОтелРесурс
//
Функция Ресурс() Экспорт
    Возврат Ресурс;
КонецФункции

// Возвращает область инструментирования (InstrumentationScope).
//
// Возвращаемое значение:
//   ОтелОбластьИнструментирования
//
Функция ОбластьИнструментирования() Экспорт
    Возврат ОбластьИнструментирования;
КонецФункции

// Возвращает признак включенности метра: Ложь у no-op метра закрытого провайдера,
// который ведет себя как No-op Meter.
//
// Возвращаемое значение:
//   Булево
//
Функция Включен() Экспорт
    Возврат МетрВключен.Получить();
КонецФункции

// Устанавливает лимит мощности (cardinality limit) потоков метра без читателей для
// инструментов, создаваемых после вызова.
//
// Параметры:
//   Лимит - Число - максимальное количество уникальных серий атрибутов
//
Процедура УстановитьЛимитМощности(Лимит) Экспорт
    ЛимитМощности = Лимит;
КонецПроцедуры

// Возвращает таймаут callback-ов асинхронных инструментов и мульти-callback-ов метра.
//
// Возвращаемое значение:
//   Число - таймаут в миллисекундах; 0 - без таймаута
//
Функция ТаймаутОбратныхВызововМс() Экспорт
    Возврат ТаймаутОбратныхВызововМс;
КонецФункции

// Устанавливает таймаут callback-ов асинхронных инструментов метра и мульти-callback-ов
// (Metrics SDK: "The implementation SHOULD use a timeout to prevent indefinite callback
// execution"), по умолчанию 30000 мс. Применяется к созданным и создаваемым инструментам.
// Callback выполняется в фоновом задании; не завершившийся за таймаут callback не задерживает
// сбор, его измерения отбрасываются с предупреждением в логе. Фоновое задание нельзя прервать
// (https://github.com/EvilBeaver/OneScript/issues/1672): оно продолжает работу, и до его
// завершения callback не вызывается. При 0 callback-и выполняются в потоке сбора без таймаута.
//
// Параметры:
//   Значение - Число - таймаут в миллисекундах; 0 - без таймаута
//
Процедура УстановитьТаймаутОбратныхВызововМс(Значение) Экспорт
    БлокировкаРегистрации.Заблокировать();
    Попытка
        ТаймаутОбратныхВызововМс = Значение;
        ПрименитьТаймаутОбратныхВызовов(Инструменты);
    Исключение
        БлокировкаРегистрации.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
    БлокировкаРегистрации.Разблокировать();
КонецПроцедуры

// Устанавливает логгер (используется в тестах для инъекции мока).
//
// Параметры:
//   Значение - Объект - логгер с методами Отладка/Информация/Предупреждение/Ошибка
//
Процедура УстановитьЛог(Значение) Экспорт
    Лог = Значение;
КонецПроцедуры

// Собирает метрики метра для читателя: вызывает callback-и асинхронных инструментов и
// мульти-callback-и для этого сбора и собирает потоки читателя с одним временем сбора.
// Отключенный метр метрик не дает.
//
// Параметры:
//   Читатель - Объект - читатель метрик
//   ВремяСбора - Строка, Неопределено - время сбора в наносекундах; Неопределено - текущее
//   Ошибки - Массив, Неопределено - сбои сбора: сюда добавляются описания ошибок сбора инструментов
//       и callback-ов и результаты-таймауты callback-ов (см. ОтелРезультатыЭкспорта.РезультатСбора)
//
// Возвращаемое значение:
//   Массив из ОтелДанныеМетрики
//
Функция СобратьДляЧитателя(Читатель, ВремяСбора = Неопределено, Ошибки = Неопределено) Экспорт
    Результат = Новый Массив();
    Если НЕ Включен() Тогда
        Возврат Результат;
    КонецЕсли;
    Если ВремяСбора = Неопределено Тогда
        ВремяСбора = ОтелУтилиты.ТекущееВремяВНаносекундах();
    КонецЕсли;
    ВнешниеНаблюдения = НаблюденияМультиОбратныхВызовов(ВремяСбора, Ошибки);
    Для Каждого Инструмент Из Инструменты Цикл
        Попытка
            Если АсинхронныйИнструментМетра(Инструмент) Тогда
                Данные = Инструмент.СобратьДляЧитателя(Читатель, Ресурс, ОбластьИнструментирования, ВремяСбора,
                    ВнешниеНаблюдения.Получить(Инструмент), Ошибки);
            Иначе
                Данные = Инструмент.СобратьДляЧитателя(Читатель, Ресурс, ОбластьИнструментирования, ВремяСбора);
            КонецЕсли;
            Для Каждого ДанныеПотока Из Данные Цикл
                Результат.Добавить(ДанныеПотока);
            КонецЦикла;
        Исключение
            ОписаниеСбоя = ОписаниеОшибки();
            ИмяИнструмента = Инструмент.Имя();
            Сообщение = СтрШаблон("Ошибка сбора данных инструмента ""%1"": %2", ИмяИнструмента, ОписаниеСбоя);
            Лог.Предупреждение(Сообщение);
            Если Ошибки <> Неопределено Тогда
                Ошибки.Добавить(Сообщение);
            КонецЕсли;
        КонецПопытки;
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Заново разрешает потоки созданных инструментов после изменения конфигурации (Views,
// читатели, агрегация по умолчанию): новые потоки получают новые хранилища, неизменные
// сохраняют данные. Для новых потоков проверяется конфликт идентичности метрик.
//
Процедура ОбновитьПотоки() Экспорт
    БлокировкаРегистрации.Заблокировать();
    Попытка
        Контекст = КонтекстПотоков();
        ПрежниеХранилища = Новый Массив();
        Для Каждого Инструмент Из Инструменты Цикл
            Дескриптор = Инструмент.Дескриптор();
            Если Дескриптор = Неопределено Тогда
                Продолжить;
            КонецЕсли;
            Текущие = Инструмент.Хранилища();
            Для Каждого Запись Из Текущие Цикл
                ПрежниеХранилища.Добавить(Запись.Хранилище);
            КонецЦикла;
            Инструмент.УстановитьХранилища(ОтелПотокиМетрик.СоздатьХранилища(Контекст, Дескриптор, Текущие));
        КонецЦикла;
        ИменаПотоков = Новый Соответствие();
        Для Каждого Инструмент Из Инструменты Цикл
            ЗарегистрироватьИменаПотоков(Инструмент, ПрежниеХранилища);
        КонецЦикла;
    Исключение
        БлокировкаРегистрации.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
    БлокировкаРегистрации.Разблокировать();
КонецПроцедуры

// Регистрирует обратный вызов для наблюдения нескольких инструментов.
// По спеке OpenTelemetry мульти-callback MUST связываться с набором асинхронных
// инструментов этого же Meter: регистрация с синхронным или чужим инструментом
// отклоняется с предупреждением.
//
// Параметры:
//   Callback - Действие - обратный вызов. Вызывается с одним аргументом - Соответствие
//       наблюдений ОтелНаблюдениеМетрики: по инструменту и по имени инструмента, а если задано
//       Состояние - дополнительно вторым аргументом передается Состояние. Одноименные
//       инструменты разного вида или единицы различаются только по инструменту: по имени
//       доступно наблюдение первого из них.
//       Требования к callback (Metrics API spec):
//       * SHOULD быть реентерабельным: SDK вызывает callback-и для каждого
//         MetricReader отдельно, в том числе параллельно из разных потоков.
//       * SHOULD NOT выполняться неограниченное время: без сетевых вызовов,
//         ожидания блокировок и тяжелого IO, иначе сбор метрик задерживается.
//       * SHOULD NOT делать дублирующие наблюдения (несколько измерений с одинаковыми
//         атрибутами) по всем callback-ам инструмента: этого мульти-callback,
//         других мульти-callback-ов и callback-ов самого инструмента.
//       * SHOULD NOT пробрасывать исключения - SDK перехватит и залогирует.
//   НовыеИнструменты - Массив - массив наблюдаемых инструментов
//   Состояние - Произвольный, Неопределено - произвольное состояние, ассоциированное
//       с регистрацией. Прокидывается в callback на каждый вызов.
//
// Возвращаемое значение:
//   ОтелРегистрацияНаблюдателя - регистрация; Закрыть() отменяет ее. У отклоненной
//       регистрации Закрыть() ничего не делает
//
Функция ЗарегистрироватьОбратныйВызов(Callback, НовыеИнструменты, Состояние = Неопределено) Экспорт
    ОтклоненнаяРегистрация = Новый ОтелРегистрацияНаблюдателя(Неопределено, Неопределено);
    Если НовыеИнструменты = Неопределено ИЛИ НовыеИнструменты.Количество() = 0 Тогда
        Лог.Предупреждение(
            "Multi-instrument callback зарегистрирован без инструментов. Регистрация пропущена.");
        Возврат ОтклоненнаяРегистрация;
    КонецЕсли;
    ИнструментыРегистрации = Новый Массив();
    Для Каждого Инструмент Из НовыеИнструменты Цикл
        Если НЕ ПринадлежитМетру(Инструмент) Тогда
            Лог.Предупреждение(
                "Multi-instrument callback ссылается на инструмент, "
                + "не созданный этим Meter. Регистрация отклонена.");
            Возврат ОтклоненнаяРегистрация;
        КонецЕсли;
        Если НЕ ЭтоАсинхронныйИнструмент(Инструмент) Тогда
            ИмяИнструмента = Инструмент.Имя();
            Сообщение = СтрШаблон(
                "Multi-instrument callback ссылается на инструмент ""%1"", не асинхронный. "
                + "Регистрация отклонена.", ИмяИнструмента);
            Лог.Предупреждение(Сообщение);
            Возврат ОтклоненнаяРегистрация;
        КонецЕсли;
        // Повторно указанный инструмент получает наблюдения один раз
        Если ИнструментыРегистрации.Найти(Инструмент) = Неопределено Тогда
            ИнструментыРегистрации.Добавить(Инструмент);
        КонецЕсли;
    КонецЦикла;
    Регистрация = Новый Структура("Callback, Инструменты, Состояние", Callback, ИнструментыРегистрации, Состояние);
    ИзменитьМультиОбратныеВызовы(Регистрация, Истина);
    Возврат Новый ОтелРегистрацияНаблюдателя(ЭтотОбъект, Регистрация);
КонецФункции

// Отменяет регистрацию мульти-callback. Вызывается ОтелРегистрацияНаблюдателя.Закрыть().
//
// Параметры:
//   Регистрация - Структура - регистрация, созданная ЗарегистрироватьОбратныйВызов
//
Процедура УдалитьCallback(Регистрация) Экспорт
    ИзменитьМультиОбратныеВызовы(Регистрация, Ложь);
КонецПроцедуры

// Вызывает все зарегистрированные мульти-callback и передает их наблюдения инструментам
// для прямого вызова Собрать. Читатели получают наблюдения мульти-callback-ов своего
// сбора через СобратьДляЧитателя.
//
Процедура ВызватьМультиОбратныеВызовы() Экспорт
    // Список регистраций не изменяется после публикации: обход по снимку безопасен
    // при конкурентной регистрации и отмене
    Снимок = МультиОбратныеВызовы;
    Для Каждого Регистрация Из Снимок Цикл
        Для Каждого Инструмент Из Регистрация.Инструменты Цикл
            Инструмент.ОчиститьТочкиДанных();
        КонецЦикла;
    КонецЦикла;

    Для Каждого Регистрация Из Снимок Цикл
        ВыполнитьОднуРегистрацию(Регистрация);
    КонецЦикла;
КонецПроцедуры

// Отключает все инструменты метра.
//
Процедура ОтключитьИнструменты() Экспорт
    Для Каждого Инструмент Из Инструменты Цикл
        Попытка
            Инструмент.Отключить();
        Исключение // BSLLS:MissingCodeTryCatchEx-off
        КонецПопытки;
    КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создает синхронный инструмент: дескриптор, потоки для читателей метра и фасад вида.
//
// Параметры:
//   Вид - Строка - вид инструмента
//   Имя - Строка - имя инструмента
//   Описание - Строка - описание
//   ЕдиницаИзмерения - Строка - единица измерения
//   Совет - Структура, Неопределено - advisory-параметры
//   АгрегацияИнструмента - Соответствие, Неопределено - агрегация, заданная при создании инструмента
//
// Возвращаемое значение:
//   Объект - зарегистрированный инструмент
//
// BSLLS:NumberOfParams-off
Функция СоздатьСинхронныйИнструмент(Вид, Имя, Знач Описание, Знач ЕдиницаИзмерения, Знач Совет,
        АгрегацияИнструмента = Неопределено)
// BSLLS:NumberOfParams-on
    ВалидироватьИмяИнструмента(Имя);
    Описание = НормализоватьСтроку(Описание);
    ЕдиницаИзмерения = НормализоватьСтроку(ЕдиницаИзмерения);
    НормИмя = НРег(Имя);
    Существующий = НайтиЗарегистрированныйИнструмент(
        НормИмя, Вид, ЕдиницаИзмерения, Описание, Совет, Имя);
    Если Существующий <> Неопределено Тогда
        Возврат Существующий;
    КонецЕсли;
    ИмяИнструмента = ИмяПервойРегистрации(НормИмя, Имя);
    Совет = ПроверитьСовет(Совет, Вид);

    Дескриптор = ОтелПотокиМетрик.НовыйДескриптор(ИмяИнструмента, Описание, ЕдиницаИзмерения, Вид, Совет,
        АгрегацияИнструмента);
    Базовый = Новый ОтелБазовыйСинхронныйИнструмент(ИмяИнструмента, Описание, ЕдиницаИзмерения, Неопределено);
    Базовый.УстановитьМетрВключен(МетрВключен);
    Базовый.УстановитьДескриптор(Дескриптор);
    Базовый.УстановитьХранилища(ОтелПотокиМетрик.СоздатьХранилища(КонтекстПотоков(), Дескриптор));
    Инструмент = Новый ПостроительНаследника(НовыйФасад(Вид), Базовый).Построить();
    Возврат ЗарегистрироватьИнструмент(Инструмент, НормИмя, Вид, ЕдиницаИзмерения, Описание, Совет, Имя);
КонецФункции

// Создает асинхронный инструмент. Callback-и повторного создания идентичного инструмента
// регистрируются у ранее созданного экземпляра.
//
// Параметры:
//   Вид - Строка - вид инструмента
//   Имя - Строка - имя инструмента
//   Callback - Действие, Массив, Неопределено - callback-и
//   Описание - Строка - описание
//   ЕдиницаИзмерения - Строка - единица измерения
//   Совет - Структура, Неопределено - advisory-параметры
//
// Возвращаемое значение:
//   Объект - зарегистрированный инструмент
//
// BSLLS:NumberOfParams-off
Функция СоздатьАсинхронныйИнструмент(Вид, Имя, Callback, Знач Описание, Знач ЕдиницаИзмерения, Знач Совет)
// BSLLS:NumberOfParams-on
    ВалидироватьИмяИнструмента(Имя);
    Описание = НормализоватьСтроку(Описание);
    ЕдиницаИзмерения = НормализоватьСтроку(ЕдиницаИзмерения);
    НормИмя = НРег(Имя);
    Существующий = НайтиЗарегистрированныйИнструмент(
        НормИмя, Вид, ЕдиницаИзмерения, Описание, Совет, Имя);
    Если Существующий <> Неопределено Тогда
        ДобавитьCallbackСуществующему(Существующий, Callback);
        Возврат Существующий;
    КонецЕсли;
    ИмяИнструмента = ИмяПервойРегистрации(НормИмя, Имя);
    Совет = ПроверитьСовет(Совет, Вид);

    Дескриптор = ОтелПотокиМетрик.НовыйДескриптор(ИмяИнструмента, Описание, ЕдиницаИзмерения, Вид, Совет);
    Базовый = Новый ОтелБазовыйНаблюдаемыйИнструмент(ИмяИнструмента, Callback, Описание, ЕдиницаИзмерения,
        Неопределено);
    Базовый.УстановитьДескриптор(Дескриптор);
    Базовый.УстановитьХранилища(ОтелПотокиМетрик.СоздатьХранилища(КонтекстПотоков(), Дескриптор));
    Инструмент = Новый ПостроительНаследника(НовыйФасад(Вид), Базовый).Построить();
    Возврат ЗарегистрироватьАсинхронныйИнструмент(
        Инструмент, Callback, НормИмя, Вид, ЕдиницаИзмерения, Описание, Совет, Имя);
КонецФункции

Функция НовыйФасад(Вид)
    Если Вид = "Counter" Тогда
        Возврат Новый ОтелСчетчик();
    ИначеЕсли Вид = "UpDownCounter" Тогда
        Возврат Новый ОтелРеверсивныйСчетчик();
    ИначеЕсли Вид = "Gauge" Тогда
        Возврат Новый ОтелДатчик();
    ИначеЕсли Вид = "Histogram" Тогда
        Возврат Новый ОтелГистограмма();
    ИначеЕсли Вид = "ExponentialHistogram" Тогда
        Возврат Новый ОтелЭкспоненциальнаяГистограмма();
    ИначеЕсли Вид = "ObservableCounter" Тогда
        Возврат Новый ОтелНаблюдаемыйСчетчик();
    ИначеЕсли Вид = "ObservableUpDownCounter" Тогда
        Возврат Новый ОтелНаблюдаемыйРеверсивныйСчетчик();
    Иначе
        Возврат Новый ОтелНаблюдаемыйДатчик();
    КонецЕсли;
КонецФункции

// Возвращает контекст разрешения потоков с текущей конфигурацией метра.
//
// Возвращаемое значение:
//   Структура - см. ОтелПотокиМетрик.НовыйКонтекст
//
Функция КонтекстПотоков()
    Контекст = ОтелПотокиМетрик.НовыйКонтекст(ОбластьИнструментирования);
    Контекст.Представления = Представления;
    Контекст.Читатели = Читатели;
    Контекст.АгрегацияГистограммПоУмолчанию = АгрегацияГистограммПоУмолчанию;
    Контекст.ЛимитМощности = ЛимитМощности;
    Контекст.ФильтрЭкземпляров = ФильтрЭкземпляров;
    Контекст.Лог = Лог;
    Возврат Контекст;
КонецФункции

Функция АсинхронныйИнструментМетра(Инструмент)
    Дескриптор = Инструмент.Дескриптор();
    Возврат Дескриптор <> Неопределено И ОтелАгрегация.ЭтоАсинхронныйВид(Дескриптор.Вид);
КонецФункции

// Вызывает мульти-callback-и для сбора читателя и возвращает их наблюдения по инструментам.
// Наблюдения одного сбора получают время сбора и не попадают в сборы других читателей.
//
// Параметры:
//   ВремяСбора - Строка - время сбора в наносекундах
//   Сбои - Массив, Неопределено - сбои сбора (мутируется): ошибки и таймауты мульти-callback-ов
//
// Возвращаемое значение:
//   Соответствие - инструмент -> Массив из Структура("Записи, Время")
//
Функция НаблюденияМультиОбратныхВызовов(ВремяСбора, Сбои)
    Результат = Новый Соответствие();
    Для Каждого Регистрация Из МультиОбратныеВызовы Цикл
        Наблюдения = Исполнитель.ВыполнитьМультиCallback(Регистрация, ТаймаутОбратныхВызововМс, Лог, Сбои);
        Если Наблюдения <> Неопределено Тогда
            ДобавитьНаблюденияИнструментов(Результат, Регистрация.Инструменты, Наблюдения, ВремяСбора);
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Добавляет непустые наблюдения мульти-callback-а к группам наблюдений инструментов.
//
// Параметры:
//   Результат - Соответствие - инструмент -> Массив из Структура("Записи, Время")
//   Инструменты - Массив - инструменты регистрации
//   Наблюдения - Соответствие - инструмент -> ОтелНаблюдениеМетрики
//   ВремяСбора - Строка - время сбора в наносекундах
//
Процедура ДобавитьНаблюденияИнструментов(Результат, Инструменты, Наблюдения, ВремяСбора)
    Для Каждого Инструмент Из Инструменты Цикл
        Наблюдение = Наблюдения.Получить(Инструмент);
        Если Наблюдение = Неопределено ИЛИ Наблюдение.Количество() = 0 Тогда
            Продолжить;
        КонецЕсли;
        Группы = Результат.Получить(Инструмент);
        Если Группы = Неопределено Тогда
            Группы = Новый Массив();
            Результат.Вставить(Инструмент, Группы);
        КонецЕсли;
        Группа = Новый Структура("Записи, Время", Наблюдение.Записи(), ВремяСбора);
        Группы.Добавить(Группа);
    КонецЦикла;
КонецПроцедуры

// Активирует callback-контекст, вызывает callback, применяет наблюдения и сбрасывает контекст.
//
// Параметры:
//   Регистрация - Структура - регистрация с полями Инструменты, Callback, [Состояние]
//
Процедура ВыполнитьОднуРегистрацию(Регистрация)
    // Активируем callback-контекст: ДобавитьВнешниеНаблюдения принимает данные
    // только пока флаг Истина (см. спеку про async API outside callbacks).
    Для Каждого Инструмент Из Регистрация.Инструменты Цикл
        Инструмент.УстановитьВыполняетсяCallback(Истина);
    КонецЦикла;
    Попытка
        // Наблюдения одного callback-а MUST считаться одним моментом: у всех инструментов
        // регистрации одно время
        ВремяНаблюдения = ОтелУтилиты.ТекущееВремяВНаносекундах();
        Наблюдения = Исполнитель.ВыполнитьМультиCallback(Регистрация, ТаймаутОбратныхВызововМс, Лог);
        Если Наблюдения <> Неопределено Тогда
            ПередатьНаблюденияИнструментам(Регистрация.Инструменты, Наблюдения, ВремяНаблюдения);
        КонецЕсли;
    Исключение
        Лог.Предупреждение("Ошибка мульти-callback: " + ОписаниеОшибки());
    КонецПопытки;
    Для Каждого Инструмент Из Регистрация.Инструменты Цикл
        Инструмент.УстановитьВыполняетсяCallback(Ложь);
    КонецЦикла;
КонецПроцедуры

// Передает непустые наблюдения мульти-callback-а его инструментам для прямого вызова Собрать.
//
// Параметры:
//   Инструменты - Массив - инструменты регистрации
//   Наблюдения - Соответствие - инструмент -> ОтелНаблюдениеМетрики
//   ВремяНаблюдения - Строка - время наблюдений в наносекундах
//
Процедура ПередатьНаблюденияИнструментам(Инструменты, Наблюдения, ВремяНаблюдения)
    Для Каждого Инструмент Из Инструменты Цикл
        Наблюдение = Наблюдения.Получить(Инструмент);
        Если Наблюдение <> Неопределено И Наблюдение.Количество() > 0 Тогда
            Инструмент.ДобавитьВнешниеНаблюдения(Наблюдение, ВремяНаблюдения);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

// Устанавливает таймаут callback-ов метра асинхронным инструментам. Вызывается под
// БлокировкаРегистрации.
//
// Параметры:
//   СписокИнструментов - Массив - инструменты метра
//
Процедура ПрименитьТаймаутОбратныхВызовов(СписокИнструментов)
    Для Каждого Инструмент Из СписокИнструментов Цикл
        Если ЭтоАсинхронныйИнструмент(Инструмент) Тогда
            Инструмент.УстановитьТаймаутCallbackМс(ТаймаутОбратныхВызововМс);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

// Проверяет, что селектор View с заданным НовоеИмя достаточно «узкий».
// Спека (Metrics SDK / View): "if a name is provided the View SHOULD have
// an instrument selector that selects at most one instrument."
//
// Параметры:
//   Селектор - ОтелСелекторИнструментов - селектор View
//   Представление - ОтелПредставление - представление с (возможно) НовоеИмя
//
Процедура ПроверитьУзостьСелектораView(Селектор, Представление)
    Если Представление.НовоеИмя() = Неопределено Тогда
        Возврат;
    КонецЕсли;
    ИмяВСелекторе = Селектор.Имя();
    ШирокийСелектор = (ИмяВСелекторе = Неопределено ИЛИ ИмяВСелекторе = "*");
    Если ШирокийСелектор Тогда
        НовоеИмя = Представление.НовоеИмя();
        ИмяВСелектореСтрока = Строка(ИмяВСелекторе);
        Лог.Предупреждение(
            "View с НовоеИмя=%1 зарегистрирован с селектором без точного Имя инструмента"
            + " (Имя=%2). По спеке такой селектор SHOULD выбирать не более одного"
            + " инструмента; иначе несколько инструментов получат одно имя метрики.",
            НовоеИмя, ИмяВСелектореСтрока);
    КонецЕсли;
КонецПроцедуры

// Регистрирует имена потоков инструмента и предупреждает о конфликте идентичности метрик:
// два потока одного читателя с одним именем, если хотя бы один переименован View или оба
// принадлежат одному инструменту. Одноименные потоки разных инструментов без
// переименования - повторная регистрация инструмента, о ней предупреждает
// ПроверитьКонфликтДескриптора. Вызывается под БлокировкаРегистрации.
//
// Параметры:
//   Инструмент - Объект - инструмент
//   ПрежниеХранилища - Массив, Неопределено - хранилища до повторного разрешения потоков:
//       о конфликте потоков только из них повторно не предупреждается
//
Процедура ЗарегистрироватьИменаПотоков(Инструмент, ПрежниеХранилища = Неопределено)
    Для Каждого Запись Из Инструмент.Хранилища() Цикл
        Ключ = КлючКонвейера(Запись.Читатель) + "|" + НРег(Запись.Хранилище.Имя());
        Одноименные = ИменаПотоков.Получить(Ключ);
        Если Одноименные = Неопределено Тогда
            Одноименные = Новый Массив();
            ИменаПотоков.Вставить(Ключ, Одноименные);
        КонецЕсли;
        ПотокНовый = ПрежниеХранилища = Неопределено ИЛИ ПрежниеХранилища.Найти(Запись.Хранилище) = Неопределено;
        Для Каждого Другой Из Одноименные Цикл
            Конфликт = Другой.Инструмент = Инструмент ИЛИ Другой.Переименован ИЛИ Запись.Переименован;
            ДругойНовый = ПрежниеХранилища = Неопределено
                ИЛИ ПрежниеХранилища.Найти(Другой.Хранилище) = Неопределено;
            Если Конфликт И (ПотокНовый ИЛИ ДругойНовый) Тогда
                ПредупредитьОКонфликтеПотоков(Запись.Хранилище.Имя(), Другой.Инструмент.Имя(), Инструмент.Имя());
                Прервать;
            КонецЕсли;
        КонецЦикла;
        Одноименный = Новый Структура("Инструмент, Хранилище, Переименован",
            Инструмент, Запись.Хранилище, Запись.Переименован);
        Одноименные.Добавить(Одноименный);
    КонецЦикла;
КонецПроцедуры

Процедура ПредупредитьОКонфликтеПотоков(ИмяПотока, ИмяПервого, ИмяВторого)
    // Имя локальной переменной не должно совпадать с переменной модуля Инструменты
    ИменаИнструментов = ?(ИмяПервого = ИмяВторого, ИмяПервого, ИмяПервого + ", " + ИмяВторого);
    Лог.Предупреждение(
        "Конфликт идентичности метрик: несколько потоков получают имя '%1' (инструменты: %2)"
        + " из-за View с НовоеИмя или нескольких View. Потоки экспортируются как есть; уточните"
        + " селектор View (ТипИнструмента, ИмяМетра) или задайте каждому потоку отдельное НовоеИмя.",
        ИмяПотока, ИменаИнструментов);
КонецПроцедуры

Функция КлючКонвейера(Читатель)
    Если Читатель = Неопределено Тогда
        Возврат "0";
    КонецЕсли;
    Индекс = Читатели.Найти(Читатель);
    Возврат Формат(?(Индекс = Неопределено, -1, Индекс + 1), "ЧГ=; ЧН=0");
КонецФункции

Процедура УстановитьОбластьИнструментирования(Значение)
    ОбластьИнструментирования = Значение;
КонецПроцедуры

Процедура УстановитьРесурс(Значение)
    Ресурс = Значение;
КонецПроцедуры

Процедура УстановитьФильтрЭкземпляров(Значение)
    ФильтрЭкземпляров = Значение;
КонецПроцедуры

// Проверяет, что инструмент асинхронный (наблюдаемый). Используется для валидации
// Multi-instrument callback (см. спеку OpenTelemetry Metrics API).
//
// Параметры:
//   Инструмент - Произвольный - проверяемый инструмент
//
// Возвращаемое значение:
//   Булево - Истина для асинхронного инструмента
//
Функция ЭтоАсинхронныйИнструмент(Инструмент)
    Попытка
        Возврат Инструмент.ЭтоНаблюдаемыйИнструмент() = Истина;
    Исключение
        // У синхронных инструментов метода ЭтоНаблюдаемыйИнструмент нет
        Возврат Ложь;
    КонецПопытки;
КонецФункции

// Добавляет или удаляет регистрацию мульти-callback, заменяя список копией.
//
// Параметры:
//   Регистрация - Структура - регистрация мульти-callback
//   Добавить - Булево - Истина - добавить, Ложь - удалить
//
Процедура ИзменитьМультиОбратныеВызовы(Регистрация, Добавить)
    БлокировкаРегистрации.Заблокировать();
    Попытка
        НовыеРегистрации = Новый Массив();
        Для Каждого Существующая Из МультиОбратныеВызовы Цикл
            Если Существующая <> Регистрация Тогда
                НовыеРегистрации.Добавить(Существующая);
            КонецЕсли;
        КонецЦикла;
        Если Добавить Тогда
            НовыеРегистрации.Добавить(Регистрация);
        КонецЕсли;
        МультиОбратныеВызовы = НовыеРегистрации;
    Исключение
        БлокировкаРегистрации.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
    БлокировкаРегистрации.Разблокировать();
КонецПроцедуры

// Регистрирует callback-и, переданные при повторном создании идентичного асинхронного
// инструмента, у ранее созданного экземпляра: callback-и, переданные при создании,
// регистрируются навсегда, а данные идентичных инструментов агрегируются вместе.
//
// Параметры:
//   Инструмент - Произвольный - ранее созданный асинхронный инструмент
//   Callback - Действие, Массив, Неопределено - callback-и из повторного создания
//
Процедура ДобавитьCallbackСуществующему(Инструмент, Callback)
    Если Callback = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Если ТипЗнч(Callback) = Тип("Массив") Тогда
        Для Каждого Элемент Из Callback Цикл
            Инструмент.ДобавитьCallback(Элемент);
        КонецЦикла;
    Иначе
        Инструмент.ДобавитьCallback(Callback);
    КонецЕсли;
КонецПроцедуры

// Проверяет, был ли инструмент создан этим Meter.
//
// Параметры:
//   Инструмент - Произвольный - проверяемый инструмент
//
// Возвращаемое значение:
//   Булево - Истина, если инструмент создан этим Meter
//
Функция ПринадлежитМетру(Инструмент)
    Если Инструмент = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;
    Для Каждого Свой Из Инструменты Цикл
        Если Свой = Инструмент Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

// Конструктор метрики.
//
// Параметры:
//   ОбластьИнструментирования - ОтелОбластьИнструментирования - область
//   Ресурс - ОтелРесурс - ресурс
//   ФильтрЭкземпляров - Число - фильтр экземпляров (необязательный)
//
Процедура ПриСозданииОбъекта(ОбластьИнструментирования,
        Ресурс,
        ФильтрЭкземпляров = Неопределено)
    УстановитьОбластьИнструментирования(ОбластьИнструментирования);
    УстановитьРесурс(Ресурс);
    Инструменты = Новый Массив();
    БлокировкаРегистрации = Новый БлокировкаРесурса();
    ИнструментыПоИмени = Новый СинхронизированнаяКарта(Новый КартаСоответствие());
    ДескрипторыИнструментов = Новый СинхронизированнаяКарта(Новый КартаСоответствие());
    ИнструментыПроходНасквозь = Новый СинхронизированнаяКарта(Новый КартаСоответствие());
    Если ФильтрЭкземпляров = Неопределено Тогда
        УстановитьФильтрЭкземпляров(ОтелФильтрЭкземпляров.ПоТрассировке());
    Иначе
        УстановитьФильтрЭкземпляров(ФильтрЭкземпляров);
    КонецЕсли;
    ЛимитМощности = 2000;
    МультиОбратныеВызовы = Новый Массив();
    Представления = Новый Массив();
    АгрегацияГистограммПоУмолчанию = "explicit_bucket_histogram";
    МетрВключен = Новый АтомарноеБулево(Истина);
    Читатели = Новый Массив();
    ИменаПотоков = Новый Соответствие();
    ПроверенныеПредставления = Новый Соответствие();
    ТаймаутОбратныхВызововМс = 30000;
    Исполнитель = Новый ОтелИсполнительОбратныхВызовов();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics");
КонецПроцедуры

Функция НормализоватьСтроку(Значение)
    Если Значение = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Возврат Значение;
КонецФункции

// Валидирует имя инструмента по спецификации OpenTelemetry Metrics API.
//
// Имя инструмента MUST соответствовать regex `^[A-Za-z][A-Za-z0-9_./-]{0,254}$`:
//   * Длина 1..255 символов.
//   * Первый символ - ASCII-буква.
//   * Допустимы ASCII-буквы, цифры, `_`, `.`, `/`, `-`.
//
// Согласно спецификации (SHOULD) при невалидном имени SDK логирует
// предупреждение, но продолжает регистрацию инструмента: жесткое отклонение
// привело бы к молчаливой потере телеметрии в продакшене.
//
// Параметры:
//   Имя - Строка - имя инструмента
//
Процедура ВалидироватьИмяИнструмента(Имя)
    Если ИмяИнструментаВалидно(Имя) Тогда
        Возврат;
    КонецЕсли;
    Лог.Предупреждение(
        "Имя инструмента '%1' не соответствует спецификации OpenTelemetry"
        + " (regex [A-Za-z][A-Za-z0-9_./-]{0,254}). Инструмент будет создан, но"
        + " потребитель телеметрии может его отбросить.",
        Имя);
КонецПроцедуры

// BSLLS:MagicNumber-off
// Возвращает Истина если имя инструмента соответствует спецификации.
//
// Параметры:
//   Имя - Произвольный - проверяемое имя инструмента
//
// Возвращаемое значение:
//   Булево - Истина если имя валидно
//
Функция ИмяИнструментаВалидно(Имя)
    Если ТипЗнч(Имя) <> Тип("Строка") Тогда
        Возврат Ложь;
    КонецЕсли;
    Длина = СтрДлина(Имя);
    Если Длина = 0 ИЛИ Длина > 255 Тогда
        Возврат Ложь;
    КонецЕсли;
    ПервыйСимвол = Сред(Имя, 1, 1);
    Если НЕ СимволASCIIБуква(ПервыйСимвол) Тогда
        Возврат Ложь;
    КонецЕсли;
    Для Индекс = 2 По Длина Цикл
        Символ = Сред(Имя, Индекс, 1);
        Если НЕ СимволДопустимыйДляИмени(Символ) Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции
// BSLLS:MagicNumber-on

Функция СимволASCIIБуква(Символ)
    Код = КодСимвола(Символ);
    Возврат (Код >= КодСимвола("A") И Код <= КодСимвола("Z"))
        ИЛИ (Код >= КодСимвола("a") И Код <= КодСимвола("z"));
КонецФункции

Функция СимволASCIIЦифра(Символ)
    Код = КодСимвола(Символ);
    Возврат Код >= КодСимвола("0") И Код <= КодСимвола("9");
КонецФункции

Функция СимволДопустимыйДляИмени(Символ)
    Если СимволASCIIБуква(Символ) ИЛИ СимволASCIIЦифра(Символ) Тогда
        Возврат Истина;
    КонецЕсли;
    Возврат Символ = "_" ИЛИ Символ = "." ИЛИ Символ = "/" ИЛИ Символ = "-";
КонецФункции

// Возвращает ранее зарегистрированный инструмент для повторной регистрации имени
// или Неопределено, если нужно создать новый инструмент.
//
// По спецификации Metrics SDK (Duplicate instrument registration):
//   * при совпадении вида и единицы измерения возвращается инструмент первой
//     регистрации имени; конфликт описания, advisory или регистра имени логируется;
//   * при конфликте вида или единицы Meter MUST вернуть работающий инструмент
//     запрошенного вида, а SDK SHOULD экспортировать данные обоих инструментов
//     отдельными метриками (pass-through). Такой инструмент создается один раз
//     на сочетание имени, вида и единицы измерения.
//
// Параметры:
//   НормИмя - Строка - нормализованное (НРег) имя
//   Вид - Строка - вид инструмента (Counter, Histogram, ...)
//   ЕдиницаИзмерения - Строка - единица измерения
//   Описание - Строка - описание
//   Совет - Структура, Неопределено - advisory-параметры
//   ИсходноеИмя - Строка - имя в исходном регистре
//
// Возвращаемое значение:
//   Произвольный, Неопределено - ранее зарегистрированный инструмент
//
Функция НайтиЗарегистрированныйИнструмент(НормИмя, Вид, ЕдиницаИзмерения, Описание, Совет, ИсходноеИмя)
    Первый = ИнструментыПоИмени.ПолучитьИлиУмолчание(НормИмя, Неопределено);
    Если Первый = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    ПроверитьКонфликтДескриптора(НормИмя, Вид, ЕдиницаИзмерения, Описание, Совет, ИсходноеИмя);
    Если Не ЕстьНесовместимыйКонфликт(НормИмя, Вид, ЕдиницаИзмерения) Тогда
        Возврат Первый;
    КонецЕсли;
    Ключ = КлючПроходаНасквозь(НормИмя, Вид, ЕдиницаИзмерения);
    Возврат ИнструментыПроходНасквозь.ПолучитьИлиУмолчание(Ключ, Неопределено);
КонецФункции

// Возвращает имя для создаваемого инструмента: при повторной регистрации - имя
// первой регистрации (spec: при регистрации имени в другом регистре Meter MUST
// вернуть инструмент с первым встреченным именем).
//
// Параметры:
//   НормИмя - Строка - нормализованное (НРег) имя
//   Имя - Строка - запрошенное имя
//
// Возвращаемое значение:
//   Строка
//
Функция ИмяПервойРегистрации(НормИмя, Имя)
    Дескриптор = ДескрипторыИнструментов.ПолучитьИлиУмолчание(НормИмя, Неопределено);
    Если Дескриптор = Неопределено Тогда
        Возврат Имя;
    КонецЕсли;
    Возврат Дескриптор.Имя;
КонецФункции

// Регистрирует созданный инструмент и возвращает инструмент, который получит вызывающий.
// Первый инструмент имени и его дескриптор используются для проверки конфликтов
// последующих регистраций, инструмент, созданный при конфликте вида или единицы,
// запоминается по ключу pass-through.
//
// Meter потокобезопасен, а поиск и создание инструмента идут без блокировки, поэтому
// под блокировкой регистрации поиск повторяется: если инструмент той же идентичности
// уже зарегистрировал другой поток, возвращается он, а созданный экземпляр отбрасывается.
//
// Параметры:
//   Инструмент - Произвольный - созданный инструмент
//   НормИмя - Строка - нормализованное (НРег) имя
//   Вид - Строка - вид инструмента
//   ЕдиницаИзмерения - Строка - единица измерения
//   Описание - Строка - описание
//   Совет - Структура, Неопределено - advisory-параметры
//   ИсходноеИмя - Строка - имя в исходном регистре
//
// Возвращаемое значение:
//   Произвольный - зарегистрированный инструмент
//
Функция ЗарегистрироватьИнструмент(Инструмент, НормИмя, Вид, ЕдиницаИзмерения, Описание, Совет, ИсходноеИмя)
    БлокировкаРегистрации.Заблокировать();
    Попытка
        Зарегистрированный = ЗарегистрироватьПодБлокировкой(
            Инструмент, НормИмя, Вид, ЕдиницаИзмерения, Описание, Совет, ИсходноеИмя);
    Исключение
        БлокировкаРегистрации.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
    БлокировкаРегистрации.Разблокировать();
    Возврат Зарегистрированный;
КонецФункции

// Регистрирует созданный асинхронный инструмент. Если идентичный инструмент уже
// зарегистрировал другой поток, callback-и созданного экземпляра переносятся на него.
//
// Параметры:
//   Инструмент - Произвольный - созданный асинхронный инструмент
//   Callback - Действие, Массив, Неопределено - callback-и, переданные при создании
//   НормИмя - Строка - нормализованное (НРег) имя
//   Вид - Строка - вид инструмента
//   ЕдиницаИзмерения - Строка - единица измерения
//   Описание - Строка - описание
//   Совет - Структура, Неопределено - advisory-параметры
//   ИсходноеИмя - Строка - имя в исходном регистре
//
// Возвращаемое значение:
//   Произвольный - зарегистрированный инструмент
//
// BSLLS:NumberOfParams-off
Функция ЗарегистрироватьАсинхронныйИнструмент(Инструмент, Callback, НормИмя, Вид, ЕдиницаИзмерения, Описание, Совет,
        ИсходноеИмя)
// BSLLS:NumberOfParams-on
    Зарегистрированный = ЗарегистрироватьИнструмент(
        Инструмент, НормИмя, Вид, ЕдиницаИзмерения, Описание, Совет, ИсходноеИмя);
    Если Зарегистрированный <> Инструмент Тогда
        ДобавитьCallbackСуществующему(Зарегистрированный, Callback);
    КонецЕсли;
    Возврат Зарегистрированный;
КонецФункции

Функция ЗарегистрироватьПодБлокировкой(Инструмент, НормИмя, Вид, ЕдиницаИзмерения, Описание, Совет, ИсходноеИмя)
    Первый = ИнструментыПоИмени.ПолучитьИлиУмолчание(НормИмя, Неопределено);
    Если Первый = Неопределено Тогда
        ИнструментыПоИмени.Вставить(НормИмя, Инструмент);
        ЗарегистрироватьДескриптор(НормИмя, Вид, ЕдиницаИзмерения, Описание, Совет, ИсходноеИмя);
    ИначеЕсли НЕ ЕстьНесовместимыйКонфликт(НормИмя, Вид, ЕдиницаИзмерения) Тогда
        Возврат Первый;
    Иначе
        Ключ = КлючПроходаНасквозь(НормИмя, Вид, ЕдиницаИзмерения);
        Существующий = ИнструментыПроходНасквозь.ПолучитьИлиУмолчание(Ключ, Неопределено);
        Если Существующий <> Неопределено Тогда
            Возврат Существующий;
        КонецЕсли;
        ИнструментыПроходНасквозь.Вставить(Ключ, Инструмент);
    КонецЕсли;

    // Потоки разрешены вне блокировки: читатели и View могли измениться
    Дескриптор = Инструмент.Дескриптор();
    Если Дескриптор <> Неопределено Тогда
        Инструмент.УстановитьХранилища(
            ОтелПотокиМетрик.СоздатьХранилища(КонтекстПотоков(), Дескриптор, Инструмент.Хранилища()));
    КонецЕсли;
    ЗарегистрироватьИменаПотоков(Инструмент);
    // Таймаут устанавливается под блокировкой: не теряется при конкурентном изменении таймаута метра
    Если ЭтоАсинхронныйИнструмент(Инструмент) Тогда
        Инструмент.УстановитьТаймаутCallbackМс(ТаймаутОбратныхВызововМс);
    КонецЕсли;

    // Копирование при записи: читатели перебирают Инструменты() без блокировки
    НовыеИнструменты = Новый Массив();
    Для Каждого Ранее Из Инструменты Цикл
        НовыеИнструменты.Добавить(Ранее);
    КонецЦикла;
    НовыеИнструменты.Добавить(Инструмент);
    Инструменты = НовыеИнструменты;
    Возврат Инструмент;
КонецФункции

Функция КлючПроходаНасквозь(НормИмя, Вид, ЕдиницаИзмерения)
    Возврат НормИмя + "|" + Вид + "|" + ЕдиницаИзмерения;
КонецФункции

Процедура ЗарегистрироватьДескриптор(НормИмя, Вид, ЕдиницаИзмерения, Описание, Совет, ИсходноеИмя = Неопределено)
    Дескриптор = Новый Структура;
    Дескриптор.Вставить("Вид", Вид);
    Дескриптор.Вставить("ЕдиницаИзмерения", ЕдиницаИзмерения);
    Дескриптор.Вставить("Описание", Описание);
    Дескриптор.Вставить("Совет", Совет);
    Дескриптор.Вставить("Имя", ?(ИсходноеИмя = Неопределено, НормИмя, ИсходноеИмя));
    ДескрипторыИнструментов.Вставить(НормИмя, Дескриптор);
КонецПроцедуры

// Проверяет конфликт регистрации инструмента с уже существующим дескриптором.
//
// Поведение по спецификации OpenTelemetry Metrics API:
//   * Повторный вызов СоздатьXxx с теми же ключевыми параметрами (тип/вид
//     инструмента, единица измерения, описание, advisory) возвращает ранее
//     зарегистрированный экземпляр - это идемпотентный happy-path.
//   * Если ключевые параметры (тип/единица измерения/описание/advisory)
//     различаются, регистрация считается duplicate-with-conflict: SDK SHOULD
//     логировать предупреждение с рецептом разрешения конфликта. При конфликте
//     описания или advisory возвращается ранее зарегистрированный инструмент с
//     параметрами первой регистрации, при конфликте вида или единицы - отдельный
//     инструмент (см. НайтиЗарегистрированныйИнструмент).
//   * Конфликт по регистру в имени (case-only) логируется отдельно: первое
//     зарегистрированное имя считается каноническим.
//
// Параметры:
//   НормИмя - Строка - нормализованное (НРег) имя
//   Вид - Строка - тип/вид инструмента (Counter, Histogram, ...)
//   ЕдиницаИзмерения - Строка - единица измерения
//   Описание - Строка - описание
//   Совет - Структура, Неопределено - advisory-параметры
//   ИсходноеИмя - Строка, Неопределено - имя в исходном регистре
//
Процедура ПроверитьКонфликтДескриптора(НормИмя, Вид, ЕдиницаИзмерения, Описание, Совет, ИсходноеИмя = Неопределено)
    Существующий = ДескрипторыИнструментов.ПолучитьИлиУмолчание(НормИмя, Неопределено);
    Если Существующий = Неопределено Тогда
        Возврат;
    КонецЕсли;

    ЕстьКонфликтРегистра = ИсходноеИмя <> Неопределено
        И Существующий.Свойство("Имя")
        И Существующий.Имя <> Неопределено
        И Существующий.Имя <> ИсходноеИмя;
    Если ЕстьКонфликтРегистра Тогда
        Лог.Предупреждение(
            "Instrument name conflict (case-only): first='%1' new='%2'",
            Существующий.Имя, ИсходноеИмя);
    КонецЕсли;

    Конфликт = Новый Структура();
    Конфликт.Вставить("Вида", Существующий.Вид <> Вид);
    Конфликт.Вставить("Единиц", Существующий.ЕдиницаИзмерения <> ЕдиницаИзмерения);
    Конфликт.Вставить("Описания", Существующий.Описание <> Описание);
    Конфликт.Вставить("Совета", Не СоветыРавны(Существующий.Совет, Совет));

    // SHOULD: предупреждение выдается, только если конфликт не исправлен через View.
    // Инструменты разного вида или единицы экспортируются отдельными метриками:
    // View исправляет конфликт, если переименованием разводит их по разным именам.
    Если Конфликт.Вида ИЛИ Конфликт.Единиц Тогда
        Если КонфликтИсправленПереименованием(Существующий, Вид, ЕдиницаИзмерения) Тогда
            Возврат;
        КонецЕсли;
    КонецЕсли;

    // SHOULD: конфликт description можно избежать, задав description через View;
    // пропускаем предупреждение, если View с НовоеОписание уже определено для имени.
    ТолькоКонфликтОписания = Конфликт.Описания И НЕ Конфликт.Вида И НЕ Конфликт.Единиц И НЕ Конфликт.Совета;
    Если ТолькоКонфликтОписания И ОписаниеЗаданоЧерезView(НормИмя, Вид, ЕдиницаИзмерения) Тогда
        Возврат;
    КонецЕсли;

    ЕстьКонфликт = Конфликт.Вида ИЛИ Конфликт.Единиц ИЛИ Конфликт.Описания ИЛИ Конфликт.Совета;
    Если НЕ ЕстьКонфликт Тогда
        Возврат;
    КонецЕсли;
    ИмяДляЛога = ?(ИсходноеИмя = Неопределено, НормИмя, ИсходноеИмя);
    Запрошенный = Новый Структура("Вид, ЕдиницаИзмерения, Описание, Совет");
    Запрошенный.Вид = Вид;
    Запрошенный.ЕдиницаИзмерения = ЕдиницаИзмерения;
    Запрошенный.Описание = Описание;
    Запрошенный.Совет = Совет;
    Различия = РазличияРегистраций(Существующий, Запрошенный, Конфликт);
    Рецепт = ПостроитьРецептРазрешенияКонфликта(Конфликт, Существующий.Имя, Вид, ЕдиницаИзмерения);
    Сообщение = СтрШаблон(
        "Метр %1: попытка повторной регистрации инструмента '%2' с другими параметрами (%3). %4",
        ОбластьИнструментирования.Имя(), ИмяДляЛога, Различия, Рецепт);
    Лог.Предупреждение(Сообщение);
КонецПроцедуры

// Описывает различия параметров повторной регистрации с первой.
//
// Параметры:
//   Существующий - Структура - дескриптор первой регистрации
//   Запрошенный - Структура - параметры повторной регистрации (Вид, ЕдиницаИзмерения, Описание, Совет)
//   Конфликт - Структура - признаки конфликта: Вида, Единиц, Описания, Совета
//
// Возвращаемое значение:
//   Строка
//
Функция РазличияРегистраций(Существующий, Запрошенный, Конфликт)
    Части = Новый Массив();
    Если Конфликт.Вида Тогда
        Часть = СтрШаблон("вид: было %1, запрошено %2", Существующий.Вид, Запрошенный.Вид);
        Части.Добавить(Часть);
    КонецЕсли;
    Если Конфликт.Единиц Тогда
        Часть = СтрШаблон("единица: было '%1', запрошено '%2'",
            Существующий.ЕдиницаИзмерения, Запрошенный.ЕдиницаИзмерения);
        Части.Добавить(Часть);
    КонецЕсли;
    Если Конфликт.Описания Тогда
        Часть = СтрШаблон("описание: было '%1', запрошено '%2'", Существующий.Описание, Запрошенный.Описание);
        Части.Добавить(Часть);
    КонецЕсли;
    Если Конфликт.Совета Тогда
        БылСовет = ПредставлениеСовета(Существующий.Совет);
        ЗапрошенСовет = ПредставлениеСовета(Запрошенный.Совет);
        Часть = СтрШаблон("advisory: было %1, запрошено %2", БылСовет, ЗапрошенСовет);
        Части.Добавить(Часть);
    КонецЕсли;
    Возврат СтрСоединить(Части, "; ");
КонецФункции

Функция ПредставлениеСовета(Совет)
    Если ТипЗнч(Совет) <> Тип("Структура") Тогда
        Возврат "{}";
    КонецЕсли;
    Части = Новый Массив();
    Для Каждого КлючИЗначение Из Совет Цикл
        Если КлючИЗначение.Значение = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Если ТипЗнч(КлючИЗначение.Значение) = Тип("Массив") Тогда
            Элементы = Новый Массив();
            Для Каждого Элемент Из КлючИЗначение.Значение Цикл
                Элементы.Добавить(Строка(Элемент));
            КонецЦикла;
            Части.Добавить(КлючИЗначение.Ключ + "=[" + СтрСоединить(Элементы, ",") + "]");
        Иначе
            Части.Добавить(КлючИЗначение.Ключ + "=" + Строка(КлючИЗначение.Значение));
        КонецЕсли;
    КонецЦикла;
    Возврат "{" + СтрСоединить(Части, ", ") + "}";
КонецФункции

// Проверяет, разводит ли View по разным именам метрики первого инструмента имени
// и нового инструмента другого вида или единицы измерения.
//
// Параметры:
//   Существующий - Структура - дескриптор первой регистрации имени
//   Вид - Строка - вид нового инструмента
//   ЕдиницаИзмерения - Строка - единица измерения нового инструмента
//
// Возвращаемое значение:
//   Булево
//
Функция КонфликтИсправленПереименованием(Существующий, Вид, ЕдиницаИзмерения)
    ИмяПервой = ИмяМетрикиПослеView(Существующий.Имя, Существующий.Вид, Существующий.ЕдиницаИзмерения);
    ИмяНовой = ИмяМетрикиПослеView(Существующий.Имя, Вид, ЕдиницаИзмерения);
    Возврат НРег(ИмяПервой) <> НРег(ИмяНовой);
КонецФункции

// Возвращает имя метрики инструмента после применения View: НовоеИмя первого
// совпавшего View, иначе имя инструмента.
//
// Параметры:
//   ИмяИнструмента - Строка - имя инструмента
//   Вид - Строка - вид инструмента
//   ЕдиницаИзмерения - Строка - единица измерения инструмента
//
// Возвращаемое значение:
//   Строка
//
Функция ИмяМетрикиПослеView(ИмяИнструмента, Вид, ЕдиницаИзмерения)
    Представление = НайтиПредставление(ИмяИнструмента, Вид, ЕдиницаИзмерения);
    Если Представление = Неопределено ИЛИ Представление.НовоеИмя() = Неопределено Тогда
        Возврат ИмяИнструмента;
    КонецЕсли;
    Возврат Представление.НовоеИмя();
КонецФункции

// Проверяет, является ли конфликт несовместимым (вид или единица измерения отличаются).
// При несовместимом конфликте SDK SHOULD создать второй инструмент (pass-through),
// чтобы оба инструмента попадали в поток сбора и экспорта метрик.
//
// Параметры:
//   НормИмя - Строка - нормализованное (НРег) имя
//   Вид - Строка - тип/вид инструмента нового запроса
//   ЕдиницаИзмерения - Строка - единица измерения нового запроса
//
// Возвращаемое значение:
//   Булево - Истина, если конфликт несовместимый (нужен pass-through)
//
Функция ЕстьНесовместимыйКонфликт(НормИмя, Вид, ЕдиницаИзмерения)
    Существующий = ДескрипторыИнструментов.ПолучитьИлиУмолчание(НормИмя, Неопределено);
    Если Существующий = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат Существующий.Вид <> Вид ИЛИ Существующий.ЕдиницаИзмерения <> ЕдиницаИзмерения;
КонецФункции

Функция СоветыРавны(Совет1, Совет2)
    Если Совет1 = Неопределено И Совет2 = Неопределено Тогда
        Возврат Истина;
    КонецЕсли;

    Если Совет1 = Неопределено ИЛИ Совет2 = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;

    Границы1 = ПолучитьГраницыИзСовета(Совет1);
    Границы2 = ПолучитьГраницыИзСовета(Совет2);
    Если Не МассивыРавны(Границы1, Границы2) Тогда
        Возврат Ложь;
    КонецЕсли;

    Ключи1 = ПолучитьКлючиАтрибутовИзСовета(Совет1);
    Ключи2 = ПолучитьКлючиАтрибутовИзСовета(Совет2);
    Возврат МассивыРавны(Ключи1, Ключи2);
КонецФункции

Функция МассивыРавны(Массив1, Массив2)
    Если Массив1 = Неопределено И Массив2 = Неопределено Тогда
        Возврат Истина;
    КонецЕсли;

    Если Массив1 = Неопределено ИЛИ Массив2 = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;

    Если ТипЗнч(Массив1) <> Тип("Массив") ИЛИ ТипЗнч(Массив2) <> Тип("Массив") Тогда
        Возврат Массив1 = Массив2;
    КонецЕсли;

    Если Массив1.Количество() <> Массив2.Количество() Тогда
        Возврат Ложь;
    КонецЕсли;

    Для Сч = 0 По Массив1.Количество() - 1 Цикл
        Если Массив1[Сч] <> Массив2[Сч] Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

Функция ПолучитьГраницыИзСовета(Совет)
    Если Совет = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если ТипЗнч(Совет) = Тип("Структура") И Совет.Свойство("ГраницыГистограммы") Тогда
        Возврат Совет.ГраницыГистограммы;
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

Функция ПолучитьКлючиАтрибутовИзСовета(Совет)
    Если Совет = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если ТипЗнч(Совет) = Тип("Структура") И Совет.Свойство("КлючиАтрибутов") Тогда
        Возврат Совет.КлючиАтрибутов;
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

// Валидирует advisory-параметры инструмента. По спецификации Metrics SDK при
// невалидном параметре Meter SHOULD сообщить об ошибке и работать так, как если бы
// параметр не был задан: ГраницыГистограммы - массив чисел по строгому возрастанию,
// КлючиАтрибутов - массив строк. Невалидные поля очищаются (=Неопределено) в
// возвращаемой копии Совета. Совет не-Структура сбрасывается целиком.
//
// Параметры:
//   Совет - Структура, Неопределено - исходный advisory
//   ВидИнструмента - Строка - имя вида (Counter/Histogram/...) для логирования
//
// Возвращаемое значение:
//   Структура, Неопределено - очищенный Совет
//
Функция ПроверитьСовет(Совет, ВидИнструмента)
    Если Совет = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    Если ТипЗнч(Совет) <> Тип("Структура") Тогда
        Лог.Предупреждение("Advisory-параметры должны быть Структурой, проигнорированы. Вид: %1", ВидИнструмента);
        Возврат Неопределено;
    КонецЕсли;

    Очищенный = Новый Структура();
    Для Каждого Эл Из Совет Цикл
        Очищенный.Вставить(Эл.Ключ, Эл.Значение);
    КонецЦикла;

    Границы = ПолучитьГраницыИзСовета(Очищенный);
    Если Границы <> Неопределено И ТипЗнч(Границы) <> Тип("Массив") Тогда
        Лог.Предупреждение(
            "ГраницыГистограммы advisory должны быть Массивом, проигнорированы. Вид: %1",
            ВидИнструмента);
        Очищенный.Вставить("ГраницыГистограммы", Неопределено);
    ИначеЕсли Границы <> Неопределено И НЕ ГраницыВозрастают(Границы) Тогда
        Лог.Предупреждение(
            "ГраницыГистограммы advisory должны быть числами по строгому возрастанию, проигнорированы. Вид: %1",
            ВидИнструмента);
        Очищенный.Вставить("ГраницыГистограммы", Неопределено);
    Иначе // BSLLS:EmptyCodeBlock-off
        // границы валидны или не заданы
    КонецЕсли;

    Ключи = ПолучитьКлючиАтрибутовИзСовета(Очищенный);
    Если Ключи <> Неопределено И ТипЗнч(Ключи) <> Тип("Массив") Тогда
        Лог.Предупреждение(
            "КлючиАтрибутов advisory должны быть Массивом, проигнорированы. Вид: %1",
            ВидИнструмента);
        Очищенный.Вставить("КлючиАтрибутов", Неопределено);
    ИначеЕсли Ключи <> Неопределено И НЕ ВсеСтроки(Ключи) Тогда
        Лог.Предупреждение(
            "КлючиАтрибутов advisory должны быть строками, проигнорированы. Вид: %1",
            ВидИнструмента);
        Очищенный.Вставить("КлючиАтрибутов", Неопределено);
    Иначе // BSLLS:EmptyCodeBlock-off
        // ключи валидны или не заданы
    КонецЕсли;

    Возврат Очищенный;
КонецФункции

Функция ГраницыВозрастают(Границы)
    Предыдущая = Неопределено;
    Для Каждого Граница Из Границы Цикл
        Если ТипЗнч(Граница) <> Тип("Число") Тогда
            Возврат Ложь;
        КонецЕсли;
        Если Предыдущая <> Неопределено И Граница <= Предыдущая Тогда
            Возврат Ложь;
        КонецЕсли;
        Предыдущая = Граница;
    КонецЦикла;
    Возврат Истина;
КонецФункции

Функция ВсеСтроки(Значения)
    Для Каждого Значение Из Значения Цикл
        Если ТипЗнч(Значение) <> Тип("Строка") Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

Функция НайтиПредставление(ИмяИнструмента, ВидИнструмента, ЕдиницаИзмерения)
    Для Каждого Пара Из Представления Цикл
        Селектор = Пара.Получить("Селектор");
        Если СелекторВыбираетИнструмент(Селектор, ИмяИнструмента, ВидИнструмента, ЕдиницаИзмерения) Тогда
            Возврат Пара.Получить("Представление");
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

// Проверяет, выбирает ли селектор View инструмент этого метра. Селектору передаются
// все критерии спецификации: имя, вид и единица инструмента, имя, версия и адрес
// схемы метра.
//
// Параметры:
//   Селектор - ОтелСелекторИнструментов - селектор View
//   ИмяИнструмента - Строка - имя инструмента
//   ВидИнструмента - Строка - вид инструмента (Counter, Histogram, ...)
//   ЕдиницаИзмерения - Строка - единица измерения инструмента
//
// Возвращаемое значение:
//   Булево
//
Функция СелекторВыбираетИнструмент(Селектор, ИмяИнструмента, ВидИнструмента, ЕдиницаИзмерения)
    ИмяМетра = ОбластьИнструментирования.Имя();
    ВерсияМетра = ОбластьИнструментирования.Версия();
    АдресСхемыМетра = ОбластьИнструментирования.АдресСхемы();
    Возврат Селектор.Совпадает(
        ИмяИнструмента, ВидИнструмента, ИмяМетра, ЕдиницаИзмерения, ВерсияМетра, АдресСхемыМетра);
КонецФункции

// Возвращает Истина, если для инструмента (имя, вид, единица) определено View с НовоеОписание.
// Это позволяет ПроверитьКонфликтДескриптора пропускать предупреждение о конфликте
// description, когда пользователь явно задал желаемое описание через View
// (соответствует SHOULD из Metrics SDK §123).
//
// Параметры:
//   НормИмя - Строка - нормализованное имя инструмента
//   Вид - Строка - тип инструмента (Counter, Histogram, ...)
//   ЕдиницаИзмерения - Строка - единица измерения инструмента
//
// Возвращаемое значение:
//   Булево
//
Функция ОписаниеЗаданоЧерезView(НормИмя, Вид, ЕдиницаИзмерения)
    Для Каждого Пара Из Представления Цикл
        Селектор = Пара.Получить("Селектор");
        Представление = Пара.Получить("Представление");
        Если Представление = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Если Представление.НовоеОписание() = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Если СелекторВыбираетИнструмент(Селектор, НормИмя, Вид, ЕдиницаИзмерения) Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

// Строит рецепт разрешения конфликта повторной регистрации инструмента. По спецификации
// Metrics SDK (Duplicate instrument registration):
//   * при конфликте вида или единицы измерения данные обоих инструментов
//     экспортируются отдельными метриками (pass-through), рецепт - переименование через View;
//   * конфликт описания SHOULD разрешаться заданием описания через View;
//   * при конфликте advisory используются параметры первой регистрации: границы и ключи
//     атрибутов можно задать явно через View - настройки View приоритетнее advisory.
//
// Параметры:
//   Конфликт - Структура - признаки конфликта: Вида, Единиц, Описания, Совета
//   ИмяИнструмента - Строка - имя первой регистрации для вставки в рецепт
//   Вид - Строка - запрошенный вид инструмента
//   ЕдиницаИзмерения - Строка - запрошенная единица измерения
//
// Возвращаемое значение:
//   Строка
//
Функция ПостроитьРецептРазрешенияКонфликта(Конфликт, ИмяИнструмента, Вид, ЕдиницаИзмерения)
    ОтдельнаяМетрика = "Данные нового инструмента экспортируются отдельной метрикой с тем же именем.";
    Если Конфликт.Вида Тогда
        Возврат ОтдельнаяМетрика + СтрШаблон(
            " Чтобы разделить метрики, зарегистрируйте View с селектором Имя='%1',"
            + " ТипИнструмента='%2' и НовоеИмя='<уникальное_имя>'.",
            ИмяИнструмента, Вид);
    КонецЕсли;
    Если Конфликт.Единиц Тогда
        Возврат ОтдельнаяМетрика + СтрШаблон(
            " Чтобы разделить метрики, зарегистрируйте View с селектором Имя='%1',"
            + " Единица='%2' и НовоеИмя='<уникальное_имя>'.",
            ИмяИнструмента, ЕдиницаИзмерения);
    КонецЕсли;
    Рецепты = Новый Массив();
    Рецепты.Добавить("Возвращен ранее зарегистрированный инструмент с параметрами первой регистрации.");
    Если Конфликт.Описания Тогда
        Рецепты.Добавить("Чтобы избежать предупреждения, задайте Описание через View с НовоеОписание.");
    КонецЕсли;
    Если Конфликт.Совета Тогда
        РецептСовета = СтрШаблон("Чтобы задать границы гистограммы и ключи атрибутов явно,"
            + " зарегистрируйте View с селектором Имя='%1' и ГраницыГистограммы или"
            + " РазрешенныеКлючиАтрибутов: настройки View приоритетнее advisory.", ИмяИнструмента);
        Рецепты.Добавить(РецептСовета);
    КонецЕсли;
    Возврат СтрСоединить(Рецепты, " ");
КонецФункции

#КонецОбласти
