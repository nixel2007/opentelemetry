#Использовать logos
#Использовать extends

#Область ОписаниеПеременных

&Родитель
// ОтелБазовыйСинхронныйИнструмент - родительский объект (extends)
Перем Родитель;

// Объект - логгер (logos)
Перем Лог;

// Тип - тип Число: знак проверяется только у чисел, нечисло отклоняет базовый инструмент
Перем ТипЧисло;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Добавляет значение к счетчику.
//
// По спецификации OpenTelemetry Metrics API метод Counter.Add MUST принимать только
// неотрицательные значения (Counter монотонен). Сам API SHOULD NOT валидировать
// значение - это означает, что чистый API-прокси не должен отклонять значение.
// Однако в данном SDK API и SDK объединены в одном пакете: этот метод одновременно
// является и точкой входа API, и реализацией SDK-слоя. Валидация здесь выполняется
// именно на уровне SDK (не API-прокси), что полностью соответствует требованиям
// спецификации. Поведение SDK при отрицательном значении: записывается предупреждение
// в лог и значение игнорируется (точка данных не создается и не модифицируется).
// Для записи отрицательных значений используйте ОтелРеверсивныйСчетчик (UpDownCounter).
// Значение, не являющееся числом, игнорируется с предупреждением, исключение не бросается.
//
// Параметры:
//   Значение - Число - неотрицательное значение для добавления
//   Атрибуты - ОтелАтрибуты - атрибуты точки данных (необязательный)
//   Контекст - Соответствие, Неопределено - явный контекст (необязательный)
//
Процедура Добавить(Знач Значение, Атрибуты = Неопределено, Контекст = Неопределено) Экспорт
    Если ТипЗнч(Значение) = ТипЧисло И Значение < 0 Тогда
        Лог.Предупреждение(
            "ОтелСчетчик.Добавить вызван с отрицательным значением (%1) - игнорируется."
            + " По спецификации Counter принимает только non-negative значения.",
            Значение);
        Возврат;
    КонецЕсли;
    Родитель.Записать(Значение, Атрибуты, Контекст);
КонецПроцедуры

// Записывает значение так же, как Добавить. Метод базового инструмента доступен и у счетчика:
// без этой проверки отрицательное значение попало бы в монотонную сумму.
//
// Параметры:
//   Значение - Число - неотрицательное значение для добавления
//   Атрибуты - ОтелАтрибуты - атрибуты точки данных (необязательный)
//   Контекст - Соответствие, Неопределено - явный контекст (необязательный)
//
Процедура Записать(Знач Значение, Атрибуты = Неопределено, Контекст = Неопределено) Экспорт
    Добавить(Значение, Атрибуты, Контекст);
КонецПроцедуры

// Устанавливает логгер (используется в тестах для инъекции мока).
//
// Параметры:
//   Значение - Объект - логгер с методом Предупреждение
//
Процедура УстановитьЛог(Значение) Экспорт
    Лог = Значение;
КонецПроцедуры

// Возвращает вид инструмента.
//
// Возвращаемое значение:
//   Строка - "Counter"
//
Функция Вид() Экспорт
    Возврат "Counter";
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Класс счетчика (Counter) по спецификации OpenTelemetry.
// Thin facade - вся логика хранения в ОтелБазовыйСинхронныйИнструмент.
//
&Расширяет("ОтелБазовыйСинхронныйИнструмент")
Процедура ПриСозданииОбъекта()
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics");
    ТипЧисло = Тип("Число");
КонецПроцедуры

#КонецОбласти
