#Использовать logos

#Область ОписаниеПеременных

// Строка - имя потока метрики
Перем Имя;
// Строка - описание потока метрики
Перем Описание;
// Строка - единица измерения
Перем ЕдиницаИзмерения;
// Строка - вид инструмента (ObservableCounter, ObservableUpDownCounter, ObservableGauge)
Перем ВидИнструмента;
// Объект - агрегатор потока: складывает (сумма) или заменяет (последнее значение) наблюдения
//   наборов атрибутов, совпавших после фильтра
Перем Агрегатор;
// Булево - агрегатор отбрасывает наблюдения (Drop)
Перем Отбрасывание;
// ОтелОбработчикАтрибутов - фильтр атрибутов потока
Перем ОбработчикАтрибутов;
// Число - сколько наборов атрибутов получают свою серию до переполнения
Перем ЛимитМощности;
// Число - фильтр exemplars из ОтелФильтрЭкземпляров
Перем ФильтрЭкземпляров;
// Объект, Неопределено - фабрика резервуаров exemplars
Перем ФабрикаРезервуаров;
// Число - время создания потока в наносекундах: начало кумулятивных рядов
Перем ВремяСоздания;
// Число - время прошлого дельта-сбора: начало следующего дельта-интервала
Перем ВремяПрошлогоСбора;
// Соответствие - абсолютные значения сумм прошлого дельта-сбора по ключу набора атрибутов
Перем ПрошлыеЗначения;
// БлокировкаРесурса - сериализует сборы потока
Перем Блокировка;
// Объект - логгер
Перем Лог;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Хранилище - потокобезопасный объект: сборы сериализуются.

// Собирает данные потока из наблюдений callback-ов одного сбора. Наблюдения наборов,
// совпавших после фильтра атрибутов, агрегируются: суммы складываются, последнее
// значение заменяется. Лимит мощности отдает серии первым наблюденным наборам, остальные
// агрегируются в серии переполнения. Серии, не наблюдавшиеся в этом сборе, не выводятся.
// Для дельта-временности сумма считается от значения прошлого сбора.
//
// Параметры:
//   Группы - Массив из Структура - наблюдения по вызовам callback-ов:
//     * Записи - Массив из Соответствие - записи ОтелНаблюдениеМетрики.Записи()
//     * Время - Число, Неопределено - время наблюдений вызова в наносекундах
//   Ресурс - ОтелРесурс - ресурс
//   ОбластьИнструментирования - ОтелОбластьИнструментирования - область
//   Временность - Число - значение из ОтелВременнаяАгрегация
//   ВремяСбора - Число, Неопределено - время сбора в наносекундах; Неопределено - самое
//       позднее время групп наблюдений
//
// Возвращаемое значение:
//   ОтелДанныеМетрики, Неопределено - Неопределено, если точек нет
//
Функция Собрать(Группы, Ресурс, ОбластьИнструментирования, Временность, ВремяСбора = Неопределено) Экспорт
    Если Отбрасывание Тогда
        Возврат Неопределено;
    КонецЕсли;
    Блокировка.Заблокировать();
    Попытка
        Точки = СобратьТочки(Группы, Временность, ВремяСбора);
    Исключение
        Блокировка.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
    Блокировка.Разблокировать();

    Если Точки.Количество() = 0 Тогда
        Возврат Неопределено;
    КонецЕсли;
    Данные = Агрегатор.СформироватьДанныеМетрики(Ресурс, ОбластьИнструментирования,
        Имя, Описание, ЕдиницаИзмерения, Точки);
    Если Данные <> Неопределено Тогда
        Данные.УстановитьВременнуюАгрегацию(Временность);
    КонецЕсли;
    Возврат Данные;
КонецФункции

// Возвращает кумулятивные данные наблюдений под заданным именем, не меняя состояние
// дельта-сборов. Используется прямым вызовом Собрать инструмента.
//
// Параметры:
//   Группы - Массив из Структура - наблюдения по вызовам callback-ов (см. Собрать)
//   Ресурс - ОтелРесурс - ресурс
//   ОбластьИнструментирования - ОтелОбластьИнструментирования - область
//   ИмяМетрики - Строка - имя метрики
//   ОписаниеМетрики - Строка - описание метрики
//
// Возвращаемое значение:
//   ОтелДанныеМетрики, Неопределено - Неопределено, если точек нет
//
Функция СобратьСнимок(Группы, Ресурс, ОбластьИнструментирования, ИмяМетрики, ОписаниеМетрики) Экспорт
    Если Отбрасывание Тогда
        Возврат Неопределено;
    КонецЕсли;
    Блокировка.Заблокировать();
    Попытка
        Точки = СобратьТочки(Группы, ОтелВременнаяАгрегация.Кумулятивная(), Неопределено);
    Исключение
        Блокировка.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
    Блокировка.Разблокировать();
    Если Точки.Количество() = 0 Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат Агрегатор.СформироватьДанныеМетрики(Ресурс, ОбластьИнструментирования,
        ИмяМетрики, ОписаниеМетрики, ЕдиницаИзмерения, Точки);
КонецФункции

// Возвращает имя потока метрики.
//
// Возвращаемое значение:
//   Строка
//
Функция Имя() Экспорт
    Возврат Имя;
КонецФункции

// Возвращает описание потока метрики.
//
// Возвращаемое значение:
//   Строка
//
Функция Описание() Экспорт
    Возврат Описание;
КонецФункции

// Возвращает единицу измерения потока.
//
// Возвращаемое значение:
//   Строка
//
Функция ЕдиницаИзмерения() Экспорт
    Возврат ЕдиницаИзмерения;
КонецФункции

// Возвращает вид инструмента потока.
//
// Возвращаемое значение:
//   Строка
//
Функция Вид() Экспорт
    Возврат ВидИнструмента;
КонецФункции

// Возвращает признак агрегации Drop: поток отбрасывает наблюдения.
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоОтбрасывание() Экспорт
    Возврат Отбрасывание;
КонецФункции

// Возвращает агрегатор потока.
//
// Возвращаемое значение:
//   Объект
//
Функция Агрегатор() Экспорт
    Возврат Агрегатор;
КонецФункции

// Возвращает лимит мощности потока.
//
// Возвращаемое значение:
//   Число
//
Функция ЛимитМощности() Экспорт
    Возврат ЛимитМощности;
КонецФункции

// Устанавливает лимит мощности: сколько наборов атрибутов получают свою серию.
//
// Параметры:
//   Лимит - Число - лимит мощности
//
Процедура УстановитьЛимитМощности(Лимит) Экспорт
    ЛимитМощности = Лимит;
КонецПроцедуры

// Устанавливает фильтр атрибутов потока.
//
// Параметры:
//   РазрешенныеКлючи - Массив из Строка, Неопределено - allow-list
//   ИсключенныеКлючи - Массив из Строка, Неопределено - exclude-list
//
Процедура УстановитьФильтрАтрибутов(РазрешенныеКлючи, ИсключенныеКлючи) Экспорт
    ОбработчикАтрибутов = Новый ОтелОбработчикАтрибутов(РазрешенныеКлючи, ИсключенныеКлючи);
КонецПроцедуры

// Устанавливает фильтр exemplars.
//
// Параметры:
//   Фильтр - Число - значение из ОтелФильтрЭкземпляров
//
Процедура УстановитьФильтрЭкземпляров(Фильтр) Экспорт
    ФильтрЭкземпляров = Фильтр;
КонецПроцедуры

// Устанавливает фабрику резервуаров exemplars: у каждой серии сбора свой резервуар.
//
// Параметры:
//   Фабрика - Объект, Неопределено - объект с методом СоздатьРезервуар(); Неопределено - без exemplars
//
Процедура УстановитьФабрикуРезервуаров(Фабрика) Экспорт
    ФабрикаРезервуаров = Фабрика;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СобратьТочки(Группы, Временность, ВремяСбора)
    Сбор = СгруппироватьНаблюдения(Группы);
    Время = ВремяСбора;
    Если Время = Неопределено Тогда
        Время = Сбор.ПоследнееНаблюдение;
    КонецЕсли;
    Если Время = Неопределено Тогда
        Время = ОтелУтилиты.ТекущееВремяВНаносекундах();
    КонецЕсли;

    ЭтоДельта = (Временность = ОтелВременнаяАгрегация.Дельта());
    ЗначенияСбора = Новый Соответствие();
    Точки = ТочкиСерий(Сбор.Порядок, ЭтоДельта, Время, ЗначенияСбора);
    Если ЭтоДельта Тогда
        ПрошлыеЗначения = ЗначенияСбора;
        ВремяПрошлогоСбора = Время;
    КонецЕсли;
    Возврат Точки;
КонецФункции

// Группирует наблюдения сбора в серии по атрибутам после фильтра: серии в порядке первого
// наблюдения, overflow-серия последней.
//
// Параметры:
//   Группы - Массив из Структура - наблюдения (Записи, Время)
//
// Возвращаемое значение:
//   Структура - Серии, Порядок, Переполнение, ПоследнееНаблюдение
//
Функция СгруппироватьНаблюдения(Группы)
    Сбор = Новый Структура("Серии, Порядок, Переполнение, ПоследнееНаблюдение",
        Новый Соответствие(), Новый Массив());
    Для Каждого Группа Из Группы Цикл
        Если Позже(Группа.Время, Сбор.ПоследнееНаблюдение) Тогда
            Сбор.ПоследнееНаблюдение = Группа.Время;
        КонецЕсли;
        Для Каждого Запись Из Группа.Записи Цикл
            ДобавитьНаблюдение(Сбор, Запись, Группа.Время);
        КонецЦикла;
    КонецЦикла;
    Если Сбор.Переполнение <> Неопределено Тогда
        Сбор.Порядок.Добавить(Сбор.Переполнение);
    КонецЕсли;
    Возврат Сбор;
КонецФункции

// Формирует точки данных серий. Для дельта-суммы значение точки - разница с прошлым сбором.
//
// Параметры:
//   Серии - Массив из Структура - серии сбора
//   ЭтоДельта - Булево - дельта-временность
//   ВремяСбора - Строка - время сбора в наносекундах
//   ЗначенияСбора - Соответствие - сюда пишутся абсолютные значения сумм по ключам серий
//
// Возвращаемое значение:
//   Массив из Соответствие - точки данных
//
Функция ТочкиСерий(Серии, ЭтоДельта, ВремяСбора, ЗначенияСбора)
    ДельтаСуммы = ЭтоДельта И Агрегатор.ТипМетрики() = ОтелТипМетрики.Сумма();
    ВремяСтарта = ?(ЭтоДельта, ВремяПрошлогоСбора, ВремяСоздания);
    Точки = Новый Массив();
    Для Каждого Серия Из Серии Цикл
        ВремяТочки = ?(Серия.Время = Неопределено, ВремяСбора, Серия.Время);
        АтрибутыOtlp = ?(Серия.Атрибуты = Неопределено, Новый Массив(), Серия.Атрибуты.ВМассивOtlp());
        Точка = Агрегатор.СформироватьТочкуДанных(Серия.Аккумулятор, ВремяСтарта, ВремяТочки,
            АтрибутыOtlp, ЭкземплярыСерии(Серия));
        Если Точка = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Если ДельтаСуммы Тогда
            ПривестиКДельте(Точка, Серия.Ключ, ЗначенияСбора);
        КонецЕсли;
        Точки.Добавить(Точка);
    КонецЦикла;
    Возврат Точки;
КонецФункции

Процедура ДобавитьНаблюдение(Сбор, Запись, ВремяНаблюдения)
    АтрибутыЗаписи = Запись.Получить("attributes");
    АтрибутыСерии = ОбработчикАтрибутов.Обработать(АтрибутыЗаписи);
    Ключ = ?(АтрибутыСерии = Неопределено, "", АтрибутыСерии.Ключ());
    Серия = Сбор.Серии.Получить(Ключ);
    Если Серия = Неопределено Тогда
        Если Сбор.Серии.Количество() >= ЛимитМощности Тогда
            Если Сбор.Переполнение = Неопределено Тогда
                Сбор.Переполнение = НоваяСерия(КлючПереполнения(), АтрибутыПереполнения(), ВремяНаблюдения);
            КонецЕсли;
            Серия = Сбор.Переполнение;
        Иначе
            Серия = НоваяСерия(Ключ, КопияАтрибутов(АтрибутыСерии), ВремяНаблюдения);
            Сбор.Серии.Вставить(Ключ, Серия);
            Сбор.Порядок.Добавить(Серия);
        КонецЕсли;
    КонецЕсли;
    Значение = Запись.Получить("value");
    Агрегатор.Записать(Серия.Аккумулятор, Значение);
    Если Позже(ВремяНаблюдения, Серия.Время) Тогда
        Серия.Время = ВремяНаблюдения;
    КонецЕсли;
    ПредложитьЭкземпляр(Серия, Значение, АтрибутыЗаписи);
КонецПроцедуры

// Сравнивает время в наносекундах (строка цифр или число).
//
// Параметры:
//   Время - Строка, Число, Неопределено - проверяемое время
//   Отметка - Строка, Число, Неопределено - время для сравнения
//
// Возвращаемое значение:
//   Булево - Истина, если время задано и позже отметки или отметка не задана
//
Функция Позже(Время, Отметка)
    Если Время = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат Отметка = Неопределено ИЛИ Число(Время) > Число(Отметка);
КонецФункции

// Заменяет абсолютное значение суммы точки разницей с прошлым сбором и запоминает
// абсолютное значение для следующего сбора.
//
// Параметры:
//   Точка - Соответствие - точка данных суммы
//   Ключ - Строка - ключ набора атрибутов серии
//   ЗначенияСбора - Соответствие - абсолютные значения текущего сбора
//
Процедура ПривестиКДельте(Точка, Ключ, ЗначенияСбора)
    Абсолютное = Точка.Получить("value");
    ЗначенияСбора.Вставить(Ключ, Абсолютное);
    Прошлое = ПрошлыеЗначения.Получить(Ключ);
    Если Прошлое <> Неопределено Тогда
        Точка.Вставить("value", Абсолютное - Прошлое);
    КонецЕсли;
КонецПроцедуры

Функция НоваяСерия(Ключ, АтрибутыСерии, ВремяНаблюдения)
    Серия = Новый Структура("Ключ, Аккумулятор, Атрибуты, Время, Резервуар");
    Серия.Ключ = Ключ;
    Серия.Аккумулятор = Агрегатор.СоздатьАккумулятор();
    Серия.Атрибуты = АтрибутыСерии;
    Серия.Время = ВремяНаблюдения;
    // При выключенном сэмплировании exemplars резервуар не создается: накладных расходов нет
    Если ФабрикаРезервуаров <> Неопределено
            И ФильтрЭкземпляров <> ОтелФильтрЭкземпляров.ВсегдаВыключен() Тогда
        Серия.Резервуар = НовыйРезервуар();
    КонецЕсли;
    Возврат Серия;
КонецФункции

// Возвращает новый резервуар серии. Сбой фабрики логируется: точка серии выдается без exemplars.
//
// Возвращаемое значение:
//   Объект, Неопределено - резервуар; Неопределено - без exemplars
//
Функция НовыйРезервуар()
    Попытка
        Возврат ФабрикаРезервуаров.СоздатьРезервуар();
    Исключение
        Лог.Предупреждение("Резервуар exemplars потока метрики '%1' не создан: %2", Имя, ОписаниеОшибки());
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

Процедура ПредложитьЭкземпляр(Серия, Значение, АтрибутыЗаписи)
    Если Серия.Резервуар = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Попытка
        Если ОтелФильтрЭкземпляров.ДолженЗахватить(ФильтрЭкземпляров) Тогда
            Серия.Резервуар.Предложить(Серия.Ключ, Значение, АтрибутыЗаписи, Серия.Атрибуты);
        КонецЕсли;
    Исключение
        Лог.Отладка("Ошибка при захвате exemplar: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

// Возвращает exemplars серии. Сбой резервуара (исключение или результат, который нельзя обойти)
// логируется: точка данных серии выдается без exemplars. Неопределено вместо массива - exemplars нет.
//
// Параметры:
//   Серия - Структура - серия сбора
//
// Возвращаемое значение:
//   Массив из Соответствие - копия exemplars резервуара
//
Функция ЭкземплярыСерии(Серия)
    Копия = Новый Массив();
    Если Серия.Резервуар = Неопределено Тогда
        Возврат Копия;
    КонецЕсли;
    Попытка
        Собранные = Серия.Резервуар.Собрать(Серия.Ключ);
        Если Собранные = Неопределено Тогда
            Возврат Копия;
        КонецЕсли;
        Для Каждого Экземпляр Из Собранные Цикл
            Копия.Добавить(Экземпляр);
        КонецЦикла;
    Исключение
        Лог.Предупреждение("Exemplars потока метрики '%1' не собраны: ошибка резервуара: %2", Имя,
            ОписаниеОшибки());
        Возврат Новый Массив();
    КонецПопытки;
    Возврат Копия;
КонецФункции

// Копирует атрибуты серии: объект атрибутов наблюдения может использоваться вызывающим кодом.
//
// Параметры:
//   Атрибуты - ОтелАтрибуты, Неопределено - атрибуты серии
//
// Возвращаемое значение:
//   ОтелАтрибуты, Неопределено
//
Функция КопияАтрибутов(Атрибуты)
    Если Атрибуты = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Копия = Новый ОтелАтрибуты();
    Для Каждого КлючИЗначение Из Атрибуты.ВСоответствие() Цикл
        Копия.Установить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
    КонецЦикла;
    Возврат Копия;
КонецФункции

// Ключ серии переполнения не совпадает с ключом набора атрибутов: ОтелАтрибуты.Ключ()
// начинается с длины первой части.
//
// Возвращаемое значение:
//   Строка
//
Функция КлючПереполнения()
    Возврат "__overflow__";
КонецФункции

Функция АтрибутыПереполнения()
    Атрибуты = Новый ОтелАтрибуты();
    Атрибуты.Установить("otel.metric.overflow", Истина);
    Возврат Атрибуты;
КонецФункции

// Хранилище потока метрики асинхронного инструмента (metric stream storage): агрегирует
// наблюдения одного инструмента для одного читателя и одного View.
//
// Параметры:
//   ИмяПотока - Строка - имя потока метрики
//   ОписаниеПотока - Строка - описание потока метрики
//   ЕдиницаПотока - Строка - единица измерения
//   АгрегаторПотока - Объект - агрегатор (ОтелАгрегаторСуммы, ОтелАгрегаторПоследнегоЗначения, Drop)
//   Вид - Строка - вид инструмента (необязательный)
//
Процедура ПриСозданииОбъекта(ИмяПотока, ОписаниеПотока, ЕдиницаПотока, АгрегаторПотока, Вид = "")
    ЛимитМощностиПоУмолчанию = 2000;
    Имя = ИмяПотока;
    Описание = ОписаниеПотока;
    ЕдиницаИзмерения = ЕдиницаПотока;
    ВидИнструмента = Вид;
    Агрегатор = АгрегаторПотока;
    Отбрасывание = ОтелАгрегация.ЭтоАгрегаторОтбрасывания(АгрегаторПотока);
    ОбработчикАтрибутов = Новый ОтелОбработчикАтрибутов();
    ЛимитМощности = ЛимитМощностиПоУмолчанию;
    ФильтрЭкземпляров = ОтелФильтрЭкземпляров.ПоТрассировке();
    ФабрикаРезервуаров = Неопределено;
    ВремяСоздания = ОтелУтилиты.ТекущееВремяВНаносекундах();
    ВремяПрошлогоСбора = ВремяСоздания;
    ПрошлыеЗначения = Новый Соответствие();
    Блокировка = Новый БлокировкаРесурса();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics");
КонецПроцедуры

#КонецОбласти
