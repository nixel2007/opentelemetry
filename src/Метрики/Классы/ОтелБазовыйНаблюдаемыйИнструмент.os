#Использовать lambdas
#Использовать logos
#Использовать extends

#Область ОписаниеПеременных

// Строка - имя инструмента
Перем Имя;
// Строка - описание инструмента
Перем Описание;
// Строка - единица измерения
Перем ЕдиницаИзмерения;
// Массив из Структура - записи хранилищ потоков (см. ОтелПотокиМетрик.СоздатьХранилища).
//   Не изменяется после публикации: замена списка - новым массивом
Перем Хранилища;
// Структура, Неопределено - дескриптор инструмента для разрешения потоков метром
Перем Дескриптор;
// Массив - callback-и для наблюдаемого инструмента
Перем Действия;
// Массив из Структура("Записи, Время") - внешние наблюдения от мульти-callback-ов:
//   записи одного вызова мульти-callback и общее время этих наблюдений
Перем ВнешниеНаблюдения;
// БлокировкаРесурса - защищает Действия и ВнешниеНаблюдения при конкурентных вызовах
Перем Блокировка;
// АтомарноеБулево - флаг "выполняется callback".
// По спецификации Metrics SDK: "The implementation SHOULD disregard the use
// of asynchronous instrument APIs outside of registered callbacks." Поэтому
// ДобавитьВнешниеНаблюдения принимает данные только когда флаг установлен в
// Истина SDK-инфраструктурой (см. ВызватьCallbackи и
// ОтелМетр.ВызватьМультиОбратныеВызовы).
Перем ВыполняетсяCallback;
// Объект - логгер
Перем Лог;
// Число - таймаут выполнения callback в миллисекундах (0 = без таймаута, inline-вызов)
Перем ТаймаутCallbackМс;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Instrument - потокобезопасный объект.
// Все публичные методы безопасны для параллельного вызова из нескольких потоков:
// список callback-ов и внешние наблюдения защищены блокировкой, callback-и
// вызываются по снимку списка.

// Возвращает имя инструмента.
//
// Возвращаемое значение:
//   Строка
//
Функция Имя() Экспорт
    Возврат Имя;
КонецФункции

// Возвращает описание инструмента.
//
// Возвращаемое значение:
//   Строка
//
Функция Описание() Экспорт
    Возврат Описание;
КонецФункции

// Возвращает единицу измерения.
//
// Возвращаемое значение:
//   Строка
//
Функция ЕдиницаИзмерения() Экспорт
    Возврат ЕдиницаИзмерения;
КонецФункции

// Добавляет callback для наблюдения.
// Регистрирует дополнительный callback для async-инструмента.
//
// По спецификации OpenTelemetry Metrics API список callback-ов наблюдаемого
// инструмента, зафиксированный на момент регистрации в Meter, должен
// рассматриваться SDK как immutable: добавление и удаление callback-ов после
// создания инструмента осуществляется через API-методы (ДобавитьCallback /
// УдалитьCallback / отписка регистрации). Сам список действий контролируется
// SDK и не должен модифицироваться напрямую внешним кодом.
//
// Callback SHOULD NOT бросать исключения: если callback завершится ошибкой,
// SDK перехватит исключение, залогирует предупреждение и продолжит сбор по
// остальным callback-ам и инструментам.
//
// Таймаут callback (Metrics SDK SHOULD use a timeout to prevent indefinite
// callback execution): если установлен ТаймаутCallbackМс > 0, callback
// выполняется через ФоновыеЗадания.Выполнить + ОжидатьЗавершения(Таймаут).
// При истечении таймаута измерения отбрасываются, в лог пишется warning,
// сбор метрик продолжается.
//
// Платформенное ограничение OneScript: класс ФоновоеЗадание не имеет методов
// Прервать()/ОтменитьЗадание() (см. https://github.com/EvilBeaver/OneScript/issues/1672),
// поэтому при таймауте задание продолжит работу в фоне до собственного
// завершения. Это soft-timeout (как Future.get с таймаутом в Java SDK).
// Систематические таймауты приводят к накоплению зомби-заданий - это known
// limitation, при необходимости callback должен сам кооперативно проверять
// свое время выполнения.
//
// По спецификации Metrics API: реализация SHOULD позволять передать произвольное
// "состояние" (state), которое будет передано в callback при его вызове -
// что дает возможность регистрировать generic-callback'и без захвата контекста.
//
// Потокобезопасность: метод безопасен для конкурентного вызова.
//
// Параметры:
//   Callback - Действие - callback для наблюдения. Требования (Metrics API spec):
//       * SHOULD быть реентерабельным: SDK вызывает callback-и для каждого
//         MetricReader отдельно, в том числе параллельно из разных потоков.
//       * SHOULD NOT выполняться неограниченное время: без сетевых вызовов,
//         ожидания блокировок и тяжелого IO, иначе сбор метрик задерживается.
//       * SHOULD NOT делать дублирующие наблюдения (несколько измерений с одинаковыми
//         атрибутами) по всем callback-ам инструмента, включая callback-и
//         ОтелМетр.ЗарегистрироватьОбратныйВызов для нескольких инструментов.
//       * SHOULD NOT пробрасывать исключения - SDK перехватит и залогирует.
//       Если Состояние = Неопределено, callback вызывается с одним аргументом
//       (ОтелНаблюдениеМетрики); иначе с двумя (Наблюдение, Состояние).
//   Состояние - Произвольный, Неопределено - произвольное состояние, ассоциированное
//       с регистрацией. Прокидывается в callback на каждый вызов.
//
// Возвращаемое значение:
//   ОтелРегистрацияНаблюдателя - регистрация; Закрыть() отменяет ее (то же, что УдалитьCallback)
//
Функция ДобавитьCallback(Callback, Состояние = Неопределено) Экспорт
    Если Callback = Неопределено Тогда
        Возврат Новый ОтелРегистрацияНаблюдателя(Неопределено, Неопределено);
    КонецЕсли;
    Регистрация = СоздатьРегистрациюCallback(Callback, Состояние);
    Блокировка.Заблокировать();
    Попытка
        Если НайтиCallback(Callback) = Неопределено Тогда
            Действия.Добавить(Регистрация);
        КонецЕсли;
    Исключение
        Блокировка.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
    Блокировка.Разблокировать();
    Возврат Новый ОтелРегистрацияНаблюдателя(ЭтотОбъект, Callback);
КонецФункции

// Удаляет ранее зарегистрированный callback.
// Потокобезопасность: метод безопасен для конкурентного вызова.
//
// Параметры:
//   Callback - Действие - callback для удаления
//
Процедура УдалитьCallback(Callback) Экспорт
    Блокировка.Заблокировать();
    Попытка
        ИндексДляУдаления = НайтиCallback(Callback);
        Если ИндексДляУдаления <> Неопределено Тогда
            Действия.Удалить(ИндексДляУдаления);
        КонецЕсли;
    Исключение
        Блокировка.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
    Блокировка.Разблокировать();
КонецПроцедуры

// Добавляет внешние наблюдения от мульти-callback для прямого вызова Собрать.
//
// По спецификации Metrics SDK SDK SHOULD disregard использование async
// instrument API вне зарегистрированных callback-ов. Поэтому метод принимает
// данные только если флаг ВыполняетсяCallback установлен в Истина (это делает
// ВызватьCallbackи и ОтелМетр при диспетчеризации мульти-callback).
// При вызове вне callback наблюдения игнорируются с предупреждением в логе.
// Потокобезопасность: метод безопасен для конкурентного вызова.
//
// Параметры:
//   Наблюдение - ОтелНаблюдениеМетрики - наблюдение с записями
//   ВремяНаблюдения - Число, Неопределено - время наблюдений в наносекундах: общее для всех
//       инструментов одного вызова мульти-callback (наблюдения одного callback-а MUST
//       считаться одним моментом); Неопределено - текущее время (необязательный)
//
Процедура ДобавитьВнешниеНаблюдения(Наблюдение, ВремяНаблюдения = Неопределено) Экспорт
    Если НЕ ВыполняетсяCallback.Получить() Тогда
        Лог.Предупреждение(
            "Async-инструмент %1: попытка записать наблюдения вне callback-контекста"
            + " проигнорирована (Metrics SDK SHOULD disregard async API outside callbacks).",
            Имя);
        Возврат;
    КонецЕсли;
    Если ВремяНаблюдения = Неопределено Тогда
        ВремяНаблюдения = ОтелУтилиты.ТекущееВремяВНаносекундах();
    КонецЕсли;
    Группа = Новый Структура("Записи, Время", Наблюдение.Записи(), ВремяНаблюдения);
    Блокировка.Заблокировать();
    Попытка
        ВнешниеНаблюдения.Добавить(Группа);
    Исключение
        Блокировка.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
    Блокировка.Разблокировать();
КонецПроцедуры

// Устанавливает флаг "выполняется callback" для контекста мульти-callback.
// Вызывается ОтелМетр.ВызватьМультиОбратныеВызовы вокруг dispatch одного MultiCallback,
// чтобы ДобавитьВнешниеНаблюдения принимал результаты этого dispatch.
// Не предназначен для пользовательского кода.
//
// Параметры:
//   Значение - Булево - Истина перед dispatch, Ложь после
//
Процедура УстановитьВыполняетсяCallback(Значение) Экспорт
    ВыполняетсяCallback.Установить(Значение);
КонецПроцедуры

// Вызывает callback-и и собирает кумулятивные данные первого потока инструмента,
// включая внешние наблюдения мульти-callback-ов. Читатели собирают потоки методом
// СобратьДляЧитателя.
//
// Параметры:
//   пРесурс - ОтелРесурс - ресурс телеметрии
//   пОбластьИнструментирования - ОтелОбластьИнструментирования - область
//   ИмяМетрики - Строка - имя метрики
//   ОписаниеМетрики - Строка - описание метрики
//
// Возвращаемое значение:
//   ОтелДанныеМетрики, Неопределено
//
Функция Собрать(пРесурс, пОбластьИнструментирования, ИмяМетрики, ОписаниеМетрики) Экспорт
    Группы = ВызватьCallbackи(Неопределено);
    Для Каждого Группа Из ЗабратьВнешниеНаблюдения() Цикл
        Группы.Добавить(Группа);
    КонецЦикла;
    Текущие = Хранилища;
    Если Текущие.Количество() = 0 Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат Текущие[0].Хранилище.СобратьСнимок(Группы, пРесурс, пОбластьИнструментирования,
        ИмяМетрики, ОписаниеМетрики);
КонецФункции

// Вызывает callback-и инструмента для читателя и собирает его потоки с его временной
// агрегацией. Наблюдения callback-ов получают время сбора читателя и применяются только
// к потокам этого читателя.
//
// Параметры:
//   Читатель - Объект - читатель метрик
//   Ресурс - ОтелРесурс - ресурс телеметрии
//   ОбластьИнструментирования - ОтелОбластьИнструментирования - область
//   ВремяСбора - Строка, Неопределено - время сбора читателя в наносекундах
//   ВнешниеГруппы - Массив из Структура, Неопределено - наблюдения мульти-callback-ов этого сбора
//
// Возвращаемое значение:
//   Массив из ОтелДанныеМетрики
//
Функция СобратьДляЧитателя(Читатель, Ресурс, ОбластьИнструментирования, ВремяСбора = Неопределено,
        ВнешниеГруппы = Неопределено) Экспорт
    Результат = Новый Массив();
    Записи = ОтелПотокиМетрик.ХранилищаЧитателя(Хранилища, Читатель);
    Если НЕ ЕстьНеОтбрасывающий(Записи) Тогда
        Возврат Результат;
    КонецЕсли;
    Группы = ВызватьCallbackи(ВремяСбора);
    Если ВнешниеГруппы <> Неопределено Тогда
        Для Каждого Группа Из ВнешниеГруппы Цикл
            Группы.Добавить(Группа);
        КонецЦикла;
    КонецЕсли;
    Для Каждого Запись Из Записи Цикл
        Временность = ОтелПотокиМетрик.ВременнаяАгрегацияЧитателя(Читатель, Запись.Хранилище.Вид());
        Данные = Запись.Хранилище.Собрать(Группы, Ресурс, ОбластьИнструментирования, Временность, ВремяСбора);
        Если Данные <> Неопределено Тогда
            Результат.Добавить(Данные);
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Очищает внешние наблюдения.
//
// Параметры:
//   Временность - Число - тип временной агрегации из ОтелВременнаяАгрегация (необязательный, по умолчанию дельта)
//
Процедура ОчиститьТочкиДанных(Временность = Неопределено) Экспорт // BSLLS:UnusedParameters-off
    ЗабратьВнешниеНаблюдения();
КонецПроцедуры

// Возвращает признак того, что инструмент является наблюдаемым (асинхронным).
//
// Возвращаемое значение:
//   Булево - всегда Истина
//
Функция ЭтоНаблюдаемыйИнструмент() Экспорт
    Возврат Истина;
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает записи хранилищ потоков инструмента.
//
// Возвращаемое значение:
//   Массив из Структура
//
Функция Хранилища() Экспорт
    Возврат Хранилища;
КонецФункции

// Заменяет записи хранилищ потоков. Вызывается метром при создании инструмента
// и повторном разрешении потоков.
//
// Параметры:
//   Записи - Массив из Структура - записи хранилищ (см. ОтелПотокиМетрик.СоздатьХранилища)
//
Процедура УстановитьХранилища(Записи) Экспорт
    Хранилища = Записи;
КонецПроцедуры

// Возвращает дескриптор инструмента для разрешения потоков.
//
// Возвращаемое значение:
//   Структура, Неопределено
//
Функция Дескриптор() Экспорт
    Возврат Дескриптор;
КонецФункции

// Устанавливает дескриптор инструмента для разрешения потоков.
//
// Параметры:
//   Значение - Структура - дескриптор (см. ОтелПотокиМетрик.НовыйДескриптор)
//
Процедура УстановитьДескриптор(Значение) Экспорт
    Дескриптор = Значение;
КонецПроцедуры

// Устанавливает лимит мощности (cardinality limit) всех потоков.
// При превышении лимита SDK добавляет специальную точку данных с атрибутом
// otel.metric.overflow=true (per Metrics SDK spec).
//
// Параметры:
//   Лимит - Число - лимит мощности
//
Процедура УстановитьЛимитМощности(Лимит) Экспорт
    Для Каждого Запись Из Хранилища Цикл
        Запись.Хранилище.УстановитьЛимитМощности(Лимит);
    КонецЦикла;
КонецПроцедуры

// Устанавливает таймаут выполнения callback в миллисекундах.
// При значении > 0 callback запускается в фоновом задании, и SDK перестает
// ждать после истечения таймаута, отбрасывая измерения и логируя warning.
// При значении 0 (по умолчанию) callback выполняется inline без таймаута.
//
// Платформенное ограничение OneScript: фактического прерывания не происходит,
// зомби-задание остается в фоне до собственного завершения. См.
// https://github.com/EvilBeaver/OneScript/issues/1672.
//
// Параметры:
//   ТаймаутМс - Число - таймаут в миллисекундах (0 = без таймаута)
//
Процедура УстановитьТаймаутCallbackМс(ТаймаутМс) Экспорт
    ТаймаутCallbackМс = ТаймаутМс;
КонецПроцедуры

// Возвращает текущий таймаут выполнения callback в миллисекундах.
//
// Возвращаемое значение:
//   Число
//
Функция ТаймаутCallbackМс() Экспорт
    Возврат ТаймаутCallbackМс;
КонецФункции

// Служебный метод: выполняет одиночный callback и возвращает массив записей
// наблюдений. Используется как точка входа ФоновыеЗадания.Выполнить, поэтому
// помечен Экспорт. НЕ предназначен для прямого вызова из пользовательского кода.
//
// Параметры:
//   Регистрация - Структура - {Callback, Состояние}
//
// Возвращаемое значение:
//   Массив - Записи() из ОтелНаблюдениеМетрики
//
Функция ВыполнитьОдинCallback(Регистрация) Экспорт
    Наблюдение = Новый ОтелНаблюдениеМетрики();
    Если Регистрация.Состояние = Неопределено Тогда
        Регистрация.Callback.Выполнить(Наблюдение);
    Иначе
        Регистрация.Callback.Выполнить(Наблюдение, Регистрация.Состояние);
    КонецЕсли;
    Возврат Наблюдение.Записи();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вызывает callback-и инструмента по снимку списка и возвращает их наблюдения.
// Наблюдения одного вызова получают одно время: время сбора читателя или, если оно
// не задано, время вызова callback-а.
//
// Параметры:
//   ВремяСбора - Строка, Неопределено - время сбора читателя
//
// Возвращаемое значение:
//   Массив из Структура - группы наблюдений {Записи, Время}
//
Функция ВызватьCallbackи(ВремяСбора)
    Группы = Новый Массив();
    // Callback-и вызываются по снимку списка вне блокировки: callback может добавить
    // или удалить callback, а долгий callback не задерживает конкурентные вызовы
    СнимокДействий = СнимокCallback();
    ВыполняетсяCallback.Установить(Истина);
    Попытка
        Для Каждого ТекущаяРегистрация Из СнимокДействий Цикл
            ВремяНаблюдения = ?(ВремяСбора = Неопределено, ОтелУтилиты.ТекущееВремяВНаносекундах(), ВремяСбора);
            Записи = ВыполнитьCallbackСУчетомТаймаута(ТекущаяРегистрация);
            Если Записи <> Неопределено Тогда
                Группы.Добавить(Новый Структура("Записи, Время", Записи, ВремяНаблюдения));
            КонецЕсли;
        КонецЦикла;
    Исключение
        ВыполняетсяCallback.Установить(Ложь);
        ВызватьИсключение;
    КонецПопытки;
    ВыполняетсяCallback.Установить(Ложь);
    Возврат Группы;
КонецФункции

// Выполняет callback с учетом таймаута. При ТаймаутCallbackМс <= 0 - inline,
// иначе через ФоновыеЗадания.Выполнить + ОжидатьЗавершения. Возвращает
// Неопределено если callback упал или истек таймаут.
//
// Параметры:
//   Регистрация - Структура - регистрация callback с полями Callback и Состояние
//
// Возвращаемое значение:
//   Массив, Неопределено - наблюдения из callback или Неопределено при ошибке/таймауте
//
Функция ВыполнитьCallbackСУчетомТаймаута(Регистрация)
    Если ТаймаутCallbackМс <= 0 Тогда
        Попытка
            Возврат ВыполнитьОдинCallback(Регистрация);
        Исключение
            Лог.Предупреждение("Ошибка callback %1: %2", Имя, ОписаниеОшибки());
            Возврат Неопределено;
        КонецПопытки;
    КонецЕсли;

    Параметры = Новый Массив;
    Параметры.Добавить(Регистрация);
    Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ВыполнитьОдинCallback", Параметры);

    Если Задание.ОжидатьЗавершения(ТаймаутCallbackМс) Тогда
        Если Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
            Возврат Задание.Результат;
        Иначе
            ОписаниеОшибки = "<нет>";
            Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
                ОписаниеОшибки = Задание.ИнформацияОбОшибке.Описание;
            КонецЕсли;
            Лог.Предупреждение("Ошибка callback %1: %2", Имя, ОписаниеОшибки);
            Возврат Неопределено;
        КонецЕсли;
    КонецЕсли;

    Лог.Предупреждение(
        "Таймаут callback async-инструмента %1 (%2 мс): измерения отброшены."
        + " Платформенное ограничение OneScript: задание продолжит работу в фоне"
        + " (см. https://github.com/EvilBeaver/OneScript/issues/1672).",
        Имя, ТаймаутCallbackМс);
    Возврат Неопределено;
КонецФункции

Функция ЕстьНеОтбрасывающий(Записи)
    Для Каждого Запись Из Записи Цикл
        Если НЕ Запись.Хранилище.ЭтоОтбрасывание() Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

// Возвращает индекс регистрации callback в списке или Неопределено. Вызывается под блокировкой.
//
// Параметры:
//   Callback - Действие - искомый callback
//
// Возвращаемое значение:
//   Число, Неопределено
//
Функция НайтиCallback(Callback)
    Для Индекс = 0 По Действия.ВГраница() Цикл
        Если Действия[Индекс].Callback = Callback Тогда
            Возврат Индекс;
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

// Возвращает копию списка регистраций callback-ов.
//
// Возвращаемое значение:
//   Массив из Структура
//
Функция СнимокCallback()
    Блокировка.Заблокировать();
    Попытка
        Снимок = Новый Массив;
        Для Каждого Регистрация Из Действия Цикл
            Снимок.Добавить(Регистрация);
        КонецЦикла;
    Исключение
        Блокировка.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;
    Блокировка.Разблокировать();
    Возврат Снимок;
КонецФункции

// Забирает накопленные внешние наблюдения, оставляя пустой список.
//
// Возвращаемое значение:
//   Массив из Структура - внешние наблюдения по вызовам мульти-callback-ов:
//     * Записи - Массив - записи наблюдения
//     * Время - Число, Неопределено - время наблюдений в наносекундах
//
Функция ЗабратьВнешниеНаблюдения()
    Блокировка.Заблокировать();
    Забранные = ВнешниеНаблюдения;
    ВнешниеНаблюдения = Новый Массив;
    Блокировка.Разблокировать();
    Возврат Забранные;
КонецФункции

// Создает регистрацию callback'а с произвольным состоянием: callback и "Состояние" (state),
// прокидываемое в callback при вызове (Metrics API: generic callback с state-параметром).
//
// Параметры:
//   Callback - Действие - callback
//   Состояние - Произвольный - состояние регистрации
//
// Возвращаемое значение:
//   Структура - Callback, Состояние
//
Функция СоздатьРегистрациюCallback(Callback, Состояние)
    Возврат Новый Структура("Callback, Состояние", Callback, Состояние);
КонецФункции

// Базовый наблюдаемый инструмент метрик: callback-и и наблюдения мульти-callback-ов.
// Агрегация, лимит мощности и фильтр атрибутов - в хранилищах потоков
// (ОтелХранилищеНаблюдений).
//
// Параметры:
//   ИмяИнструмента - Строка - имя инструмента
//   Callback - Действие, Массив, Неопределено - callback или массив callback'ов
//   ОписаниеИнструмента - Строка - описание
//   Единица - Строка - единица измерения
//   Агрегатор - Объект, Неопределено - агрегатор единственного потока; Неопределено - потоки
//       задает метр (УстановитьХранилища)
//
&Реализует("ИнтерфейсИнструментМетрик")
Процедура ПриСозданииОбъекта(ИмяИнструмента, Callback, ОписаниеИнструмента, Единица, Агрегатор)
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics");
    Имя = ИмяИнструмента;
    Описание = ОписаниеИнструмента;
    ЕдиницаИзмерения = Единица;
    Хранилища = Новый Массив();
    Если Агрегатор <> Неопределено Тогда
        Хранилище = Новый ОтелХранилищеНаблюдений(Имя, Описание, ЕдиницаИзмерения, Агрегатор);
        Запись = ОтелПотокиМетрик.НоваяЗаписьХранилища(Хранилище);
        Хранилища.Добавить(Запись);
    КонецЕсли;
    Блокировка = Новый БлокировкаРесурса();
    Действия = Новый Массив;
    Если Callback <> Неопределено Тогда
        Если ТипЗнч(Callback) = Тип("Массив") Тогда
            Для Каждого Элемент Из Callback Цикл
                Если Элемент <> Неопределено Тогда
                    Действия.Добавить(СоздатьРегистрациюCallback(Элемент, Неопределено));
                КонецЕсли;
            КонецЦикла;
        Иначе
            Действия.Добавить(СоздатьРегистрациюCallback(Callback, Неопределено));
        КонецЕсли;
    КонецЕсли;
    ВнешниеНаблюдения = Новый Массив;
    ВыполняетсяCallback = Новый АтомарноеБулево(Ложь);
    ТаймаутCallbackМс = 0;
КонецПроцедуры

#КонецОбласти
