#Область ОписаниеПеременных

// Соответствие, Неопределено - разрешенные ключи (allow-list View или advisory Attributes)
Перем Разрешенные;
// Массив из РегулярноеВыражение - шаблоны разрешенных ключей
Перем ШаблоныРазрешенных;
// Соответствие, Неопределено - исключенные ключи (exclude-list View)
Перем Исключенные;
// Массив из РегулярноеВыражение - шаблоны исключенных ключей
Перем ШаблоныИсключенных;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает атрибуты измерения после фильтра потока: сначала остаются только
// разрешенные ключи (если allow-list задан), затем удаляются исключенные: ключ, совпавший
// с обоими списками, отбрасывается. Исходный объект атрибутов не изменяется.
//
// Параметры:
//   Атрибуты - ОтелАтрибуты, Неопределено - атрибуты измерения
//
// Возвращаемое значение:
//   ОтелАтрибуты, Неопределено - атрибуты серии; без фильтра возвращается исходный объект
//
Функция Обработать(Атрибуты) Экспорт
    Если Атрибуты = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если Разрешенные = Неопределено И Исключенные = Неопределено Тогда
        Возврат Атрибуты;
    КонецЕсли;
    Результат = Новый ОтелАтрибуты();
    Для Каждого КлючИЗначение Из Атрибуты.ВСоответствие() Цикл
        Если КлючСохраняется(КлючИЗначение.Ключ) Тогда
            Результат.Установить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Возвращает признак, что фильтр оставляет атрибуты без изменений.
//
// Возвращаемое значение:
//   Булево
//
Функция БезФильтра() Экспорт
    Возврат Разрешенные = Неопределено И Исключенные = Неопределено;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлючСохраняется(Ключ)
    Если Разрешенные <> Неопределено И НЕ КлючВСписке(Ключ, Разрешенные, ШаблоныРазрешенных) Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат Исключенные = Неопределено ИЛИ НЕ КлючВСписке(Ключ, Исключенные, ШаблоныИсключенных);
КонецФункции

Функция КлючВСписке(Ключ, Ключи, Шаблоны)
    Если Ключи.Получить(Ключ) <> Неопределено Тогда
        Возврат Истина;
    КонецЕсли;
    Для Каждого Шаблон Из Шаблоны Цикл
        Если Шаблон.Совпадает(Ключ) Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Функция МножествоКлючей(Ключи)
    Если Ключи = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Множество = Новый Соответствие();
    Для Каждого Ключ Из Ключи Цикл
        Множество.Вставить(Ключ, Истина);
    КонецЦикла;
    Возврат Множество;
КонецФункции

Функция ШаблоныКлючей(Ключи)
    Шаблоны = Новый Массив();
    Если Ключи = Неопределено Тогда
        Возврат Шаблоны;
    КонецЕсли;
    Для Каждого Ключ Из Ключи Цикл
        ЭтоШаблон = ТипЗнч(Ключ) = Тип("Строка") И (СтрНайти(Ключ, "*") > 0 ИЛИ СтрНайти(Ключ, "?") > 0);
        Если ЭтоШаблон Тогда
            Шаблоны.Добавить(ВыражениеШаблона(Ключ));
        КонецЕсли;
    КонецЦикла;
    Возврат Шаблоны;
КонецФункции

// Строит регулярное выражение шаблона ключа: ? - любой один символ, * - любое число любых
// символов, в том числе ни одного; остальные символы сравниваются как есть, с учетом регистра.
//
// Параметры:
//   Шаблон - Строка - шаблон ключа
//
// Возвращаемое значение:
//   РегулярноеВыражение
//
Функция ВыражениеШаблона(Шаблон)
    СлужебныеСимволы = "\.+()[]{}|^$";
    Части = Новый Массив();
    Для Позиция = 1 По СтрДлина(Шаблон) Цикл
        Символ = Сред(Шаблон, Позиция, 1);
        Если Символ = "*" Тогда
            Части.Добавить("[\s\S]*");
        ИначеЕсли Символ = "?" Тогда
            Части.Добавить("[\s\S]");
        ИначеЕсли СтрНайти(СлужебныеСимволы, Символ) > 0 Тогда
            Части.Добавить("\" + Символ);
        Иначе
            Части.Добавить(Символ);
        КонецЕсли;
    КонецЦикла;
    Выражение = Новый РегулярноеВыражение("\A" + СтрСоединить(Части) + "\z");
    Выражение.ИгнорироватьРегистр = Ложь;
    Возврат Выражение;
КонецФункции

// Фильтр атрибутов потока метрики (stream configuration attribute_keys и exclude-list).
// Ключ списка - точное значение или шаблон: ? - любой один символ, * - любое число любых
// символов, в том числе ни одного; ключи сравниваются с учетом регистра.
//
// Параметры:
//   РазрешенныеКлючи - Массив из Строка, Неопределено - allow-list: остальные ключи отбрасываются
//   ИсключенныеКлючи - Массив из Строка, Неопределено - exclude-list: эти ключи отбрасываются
//
Процедура ПриСозданииОбъекта(РазрешенныеКлючи = Неопределено, ИсключенныеКлючи = Неопределено)
    Разрешенные = МножествоКлючей(РазрешенныеКлючи);
    ШаблоныРазрешенных = ШаблоныКлючей(РазрешенныеКлючи);
    Исключенные = МножествоКлючей(ИсключенныеКлючи);
    ШаблоныИсключенных = ШаблоныКлючей(ИсключенныеКлючи);
КонецПроцедуры

#КонецОбласти
