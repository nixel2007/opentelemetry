#Использовать async
#Использовать logos
#Использовать atomic

#Область ОписаниеПеременных

// Произвольный - Экспортер метрик
Перем Экспортер;
// Массив - Массив зарегистрированных объектов ОтелМетр
Перем Метры;          // Массив ОтелМетр
// Массив - Массив зарегистрированных продюсеров метрик
Перем Продюсеры;
// БлокировкаРесурса - Блокировка для потокобезопасного доступа
Перем Блокировка;
// Число - Интервал экспорта в миллисекундах
Перем ИнтервалЭкспортаМс;
// АтомарноеБулево - Признак завершения работы читателя
Перем Закрыт;
// Обещание - Обещание фонового задания периодического экспорта
Перем Обещание;
// Объект - Логгер библиотеки logos
Перем Лог;
// ОтелФильтрМетрик - Фильтр метрик для Produce
Перем ФильтрМетрик;
// Число - лимит мощности (cardinality limit) по умолчанию
Перем ЛимитМощности;
// Соответствие - лимиты мощности по виду инструмента (ВидИнструмента -> Число)
Перем ЛимитыМощностиПоВиду;
// Соответствие - селектор агрегации по умолчанию (ВидИнструмента -> Строка агрегации)
Перем СелекторАгрегации;
// АтомарноеБулево - признак регистрации у провайдера
Перем Зарегистрирован;
// БлокировкаРесурса - сериализует сборы: callback-и и дельта-интервалы одного сбора
//   завершаются до начала следующего, экспорт идет в порядке сборов
Перем БлокировкаСбора;
// Число - таймаут одного вызова Экспортировать в миллисекундах (exportTimeoutMillis); 0 - без ограничения
Перем ТаймаутЭкспортаМс;
// Число - максимальное число точек данных в одном вызове Экспортировать (maxExportBatchSize);
//   0 - без ограничения
Перем МаксРазмерПакетаЭкспорта;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Регистрирует Meter для периодического сбора метрик.
//
// Параметры:
//   Метр - ОтелМетр - объект Meter с инструментами
//
Процедура ДобавитьМетр(Метр) Экспорт
    Блокировка.Заблокировать();
    Попытка
        Метры.Добавить(Метр);
        Блокировка.Разблокировать();
    Исключение
        Блокировка.Разблокировать();
    КонецПопытки;
КонецПроцедуры

// Регистрирует продюсер внешних метрик.
//
// Параметры:
//   Продюсер - ИнтерфейсПродюсерМетрик - продюсер метрик
//
Процедура ДобавитьПродюсер(Продюсер) Экспорт
    Блокировка.Заблокировать();
    Попытка
        Продюсеры.Добавить(Продюсер);
        Блокировка.Разблокировать();
    Исключение
        Блокировка.Разблокировать();
    КонецПопытки;
КонецПроцедуры

// Запускает периодический сбор и экспорт метрик в фоновом задании.
//
Процедура Запустить() Экспорт
    Если Обещание <> Неопределено Тогда
        Возврат;
    КонецЕсли;

    Делегат = Новый Действие(ЭтотОбъект, "ПериодическийСбор");
    Обещание = Обещания.ВыполнитьДелегат(Делегат, Новый Массив, Истина);
КонецПроцедуры

// Метод фонового задания: по истечении каждого интервала собирает и экспортирует метрики.
// Завершается при закрытии читателя; финальный сбор выполняет Закрыть.
//
Процедура ПериодическийСбор() Экспорт
    Пока ДождатьсяИнтервалаСбора() Цикл
        СобратьИЭкспортировать();
    КонецЦикла;
КонецПроцедуры

// Принудительно собирает и экспортирует все метрики.
// После Закрыть() возвращает результат с признаком ошибки и не выполняет сбор.
//
// Параметры:
//   ТаймаутМс - Число - таймаут в миллисекундах (0 - без ограничения)
//
// Возвращаемое значение:
//   ОтелРезультатЭкспорта - результат операции
//
Функция СброситьБуфер(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
    Если Закрыт.Получить() Тогда
        Лог.Отладка("СброситьБуфер вызван после Закрыть() - сбор пропущен");
        Возврат ОтелРезультатыЭкспорта.Ошибка();
    КонецЕсли;
    Возврат СобратьИЭкспортировать(Истина, ТаймаутМс);
КонецФункции

// Принудительно собирает и экспортирует метрики. Оставлен для совместимости: у каждого
// читателя свои потоки, сбор одного читателя не влияет на данные других.
// После Закрыть() возвращает ошибку.
//
// Параметры:
//   ТаймаутМс - Число - таймаут экспорта в миллисекундах (0 - без ограничения)
//
// Возвращаемое значение:
//   ОтелРезультатЭкспорта - результат операции
//
Функция СброситьБуферБезОчистки(ТаймаутМс = 0) Экспорт
    Если Закрыт.Получить() Тогда
        Лог.Отладка("СброситьБуферБезОчистки вызван после Закрыть() - сбор пропущен");
        Возврат ОтелРезультатыЭкспорта.Ошибка();
    КонецЕсли;
    Возврат СобратьИЭкспортировать(Ложь, ТаймаутМс);
КонецФункции

// Завершает работу читателя и возвращает результат.
//
// Параметры:
//   ТаймаутМс - Число - таймаут операции в миллисекундах
//   ОчищатьДанные - Булево - не используется: оставлен для совместимости, у каждого читателя
//       свои потоки
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия - результат закрытия
//
// BSLLS:UnusedParameters-off
Функция Закрыть(ТаймаутМс = 30000, ОчищатьДанные = Истина) Экспорт // BSLLS:MagicNumber-off
// BSLLS:UnusedParameters-on
    Если НЕ Закрыт.СравнитьИУстановить(Ложь, Истина) Тогда
        Возврат ОтелРезультатыЗакрытия.Ошибка("Reader закрыт");
    КонецЕсли;
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Результаты = Новый Массив();
    Попытка
        Если Обещание <> Неопределено Тогда
            Попытка
                Обещание.Получить(ОтелРезультатыЗакрытия.ОставшеесяВремя(НачалоМс, ТаймаутМс));
            Исключение
                Лог.Отладка("Таймаут ожидания фонового экспорта: %1", ОписаниеОшибки());
            КонецПопытки;
            Обещание = Неопределено;
        КонецЕсли;
        // Shutdown включает эффект ForceFlush: финальный сбор и экспорт в пределах оставшегося времени
        Результаты.Добавить(
            СобратьИЭкспортировать(Истина, ОтелРезультатыЗакрытия.ОставшеесяВремя(НачалоМс, ТаймаутМс)));
    Исключение
        Результаты.Добавить(ОтелРезультатыЗакрытия.Ошибка(ОписаниеОшибки()));
    КонецПопытки;
    Если Экспортер <> Неопределено Тогда
        Результаты.Добавить(ОтелРезультатыЗакрытия.ВызватьВПределахСрока(Экспортер, "Закрыть", НачалоМс, ТаймаутМс));
    КонецЕсли;
    Возврат ОтелРезультатыЗакрытия.Свести(Результаты, ОтелРезультатыЗакрытия.СрокИстек(НачалоМс, ТаймаутМс));
КонецФункции

// ForceFlush читателя: собирает и экспортирует метрики, затем вызывает ForceFlush
// экспортера - и после истечения срока. Повторные вызовы после Закрыть() возвращают ошибку.
//
// Параметры:
//   ТаймаутМс - Число - таймаут операции в миллисекундах (0 - без ограничения)
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия - ошибка, если сбор, экспорт или ForceFlush экспортера завершились
//       сбоем; иначе таймаут, если истек срок или экспортер сообщил о таймауте; иначе успех
//
Функция ПринудительноВыгрузитьСРезультатом(ТаймаутМс = 30000) Экспорт // BSLLS:MagicNumber-off
    Если Закрыт.Получить() Тогда
        Возврат ОтелРезультатыЗакрытия.Ошибка("Reader закрыт");
    КонецЕсли;
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Результаты = Новый Массив();
    Попытка
        Результаты.Добавить(СброситьБуфер(ОтелРезультатыЗакрытия.ОставшеесяВремя(НачалоМс, ТаймаутМс)));
    Исключение
        Результаты.Добавить(ОтелРезультатыЗакрытия.Ошибка(ОписаниеОшибки()));
    КонецПопытки;

    // Спека SDK: Reader.ForceFlush SHOULD still call ForceFlush on the configured exporter
    // even if the timeout has passed - вызываем независимо от исхода СброситьБуфер.
    Если Экспортер <> Неопределено Тогда
        Результаты.Добавить(СброситьБуферЭкспортера(НачалоМс, ТаймаутМс));
    КонецЕсли;
    Возврат ОтелРезультатыЗакрытия.Свести(Результаты, ОтелРезультатыЗакрытия.СрокИстек(НачалоМс, ТаймаутМс));
КонецФункции

// Устанавливает фильтр метрик для Collect/Produce.
//
// Параметры:
//   Значение - ОтелФильтрМетрик - фильтр метрик
//
Процедура УстановитьФильтрМетрик(Значение) Экспорт
    ФильтрМетрик = Значение;
КонецПроцедуры

// Возвращает таймаут одного вызова Экспортировать (exportTimeoutMillis,
// OTEL_METRIC_EXPORT_TIMEOUT). Экспорт получает меньший из этого таймаута и срока сброса.
//
// Возвращаемое значение:
//   Число - таймаут в миллисекундах; 0 - без ограничения
//
Функция ТаймаутЭкспортаМс() Экспорт
    Возврат ТаймаутЭкспортаМс;
КонецФункции

// Устанавливает таймаут одного вызова Экспортировать (exportTimeoutMillis).
//
// Параметры:
//   Значение - Число - таймаут в миллисекундах; 0 - без ограничения
//
Процедура УстановитьТаймаутЭкспортаМс(Значение) Экспорт
    ТаймаутЭкспортаМс = Значение;
КонецПроцедуры

// Возвращает максимальное число точек данных в одном вызове Экспортировать (maxExportBatchSize).
//
// Возвращаемое значение:
//   Число - 0 - без ограничения
//
Функция МаксРазмерПакетаЭкспорта() Экспорт
    Возврат МаксРазмерПакетаЭкспорта;
КонецФункции

// Устанавливает максимальное число точек данных в одном вызове Экспортировать
// (maxExportBatchSize). Данные сбора делятся на полные пакеты этого размера, точки одной
// метрики могут попасть в разные пакеты; пакеты экспортируются последовательно.
//
// Параметры:
//   Значение - Число - максимальное число точек; 0 - без ограничения
//
Процедура УстановитьМаксРазмерПакетаЭкспорта(Значение) Экспорт
    МаксРазмерПакетаЭкспорта = Значение;
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает лимит мощности (cardinality limit), настроенный для этого читателя.
//
// Возвращаемое значение:
//   Число - лимит мощности (по умолчанию 2000)
//
Функция ЛимитМощности() Экспорт
    Возврат ЛимитМощности;
КонецФункции

// Возвращает лимит мощности читателя для вида инструмента: заданный для вида или общий.
//
// Параметры:
//   ВидИнструмента - Строка - вид инструмента ("Counter", "Histogram", ...)
//
// Возвращаемое значение:
//   Число
//
Функция ЛимитМощностиДляВида(ВидИнструмента) Экспорт
    Лимит = ЛимитыМощностиПоВиду.Получить(ВидИнструмента);
    Возврат ?(Лимит = Неопределено, ЛимитМощности, Лимит);
КонецФункции

// Устанавливает лимит мощности читателя для вида инструмента.
//
// Параметры:
//   ВидИнструмента - Строка - вид инструмента ("Counter", "Histogram", ...)
//   Лимит - Число - лимит мощности
//
Процедура УстановитьЛимитМощностиДляВида(ВидИнструмента, Лимит) Экспорт
    ЛимитыМощностиПоВиду.Вставить(ВидИнструмента, Лимит);
КонецПроцедуры

// Возвращает агрегацию гистограмм по умолчанию для этого читателя.
//
// Возвращаемое значение:
//   Строка - "explicit_bucket_histogram" или "base2_exponential_bucket_histogram"
//
Функция АгрегацияГистограммПоУмолчанию() Экспорт
    Возврат СелекторАгрегации["Histogram"];
КонецФункции

// Возвращает агрегацию по умолчанию для указанного вида инструмента.
// По спецификации: MetricReader предоставляет конфигурируемую агрегацию по типу инструмента.
//
// Параметры:
//   ВидИнструмента - Строка - вид инструмента ("Counter", "Histogram", "Gauge", и т.д.)
//
// Возвращаемое значение:
//   Строка - агрегация ("sum", "last_value", "explicit_bucket_histogram", "drop", ...)
//
Функция АгрегацияПоУмолчанию(ВидИнструмента) Экспорт
    Результат = СелекторАгрегации[ВидИнструмента];
    Если Результат = Неопределено Тогда
        Возврат "default";
    КонецЕсли;
    Возврат Результат;
КонецФункции

// Устанавливает агрегацию по умолчанию для указанного вида инструмента.
//
// Параметры:
//   ВидИнструмента - Строка - вид инструмента ("Counter", "Histogram", "Gauge", и т.д.)
//   Агрегация - Строка - агрегация ("sum", "last_value", "explicit_bucket_histogram", "drop", ...)
//
Процедура УстановитьАгрегациюПоУмолчанию(ВидИнструмента, Агрегация) Экспорт
    СелекторАгрегации[ВидИнструмента] = Агрегация;
КонецПроцедуры

// Возвращает временную агрегацию читателя для вида инструмента: ее задает селектор
// экспортера. Экспортер без ПолучитьВременнуюАгрегацию получает кумулятивную.
//
// Параметры:
//   ВидИнструмента - Строка - вид инструмента ("Counter", "ObservableGauge", ...)
//
// Возвращаемое значение:
//   Число - значение из ОтелВременнаяАгрегация
//
Функция ВременнаяАгрегацияДляВида(ВидИнструмента) Экспорт
    ТипИнструмента = ОтелСелекторВременнойАгрегации.ТипИнструментаДляВида(ВидИнструмента);
    Попытка
        Возврат Экспортер.ПолучитьВременнуюАгрегацию(ТипИнструмента);
    Исключение
        Возврат ОтелВременнаяАгрегация.Кумулятивная();
    КонецПопытки;
КонецФункции

// Регистрирует читатель у провайдера.
// По спеке MetricReader MUST NOT быть зарегистрирован более чем у одного MeterProvider.
//
// Возвращаемое значение:
//   Булево - Истина если регистрация успешна, Ложь если уже зарегистрирован
//
Функция ЗарегистрироватьУПровайдера() Экспорт
    Если НЕ Зарегистрирован.СравнитьИУстановить(Ложь, Истина) Тогда
        Лог.Ошибка("MetricReader уже зарегистрирован у другого MeterProvider");
        Возврат Ложь;
    КонецЕсли;
    Возврат Истина;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ждет интервал сбора короткими паузами, чтобы закрытие читателя не ждало весь интервал.
//
// Возвращаемое значение:
//   Булево - Истина, если интервал истек; Ложь, если читатель закрыт
//
Функция ДождатьсяИнтервалаСбора()
    ШагОжиданияМс = 50;
    ОкончаниеМс = ТекущаяУниверсальнаяДатаВМиллисекундах() + ИнтервалЭкспортаМс;
    Пока НЕ Закрыт.Получить() Цикл
        ОсталосьМс = ОкончаниеМс - ТекущаяУниверсальнаяДатаВМиллисекундах();
        Если ОсталосьМс <= 0 Тогда
            Возврат Истина;
        КонецЕсли;
        Приостановить(Мин(ОсталосьМс, ШагОжиданияМс));
    КонецЦикла;
    Возврат Ложь;
КонецФункции

// Собирает метрики читателя и экспортирует их. Сборы сериализуются: callback-и и
// дельта-интервалы одного сбора завершаются до начала следующего, данные сборов
// передаются экспортеру в порядке сборов.
//
// Параметры:
//   ОчищатьДанные - Булево - не используется: дельта-интервал начинается при сборе
//   ТаймаутМс - Число - таймаут экспорта в миллисекундах (0 = без ограничения)
//
// Возвращаемое значение:
//   ОтелРезультатЭкспорта
//
// BSLLS:UnusedParameters-off
Функция СобратьИЭкспортировать(ОчищатьДанные = Истина, ТаймаутМс = 0)
// BSLLS:UnusedParameters-on
    БлокировкаСбора.Заблокировать();
    Попытка
        Результат = СобратьИЭкспортироватьПоследовательно(ТаймаутМс);
    Исключение
        БлокировкаСбора.Разблокировать();
        Лог.Ошибка("Ошибка при сборе метрик: %1", ОписаниеОшибки());
        Возврат ОтелРезультатыЭкспорта.Ошибка();
    КонецПопытки;
    БлокировкаСбора.Разблокировать();
    Возврат Результат;
КонецФункции

Функция СобратьИЭкспортироватьПоследовательно(ТаймаутМс)
    Блокировка.Заблокировать();
    Попытка
        КопияМетров = Новый Массив();
        Для Каждого Метр Из Метры Цикл
            КопияМетров.Добавить(Метр);
        КонецЦикла;
        Блокировка.Разблокировать();
    Исключение
        Блокировка.Разблокировать();
        ВызватьИсключение;
    КонецПопытки;

    МассивДанных = Новый Массив();
    Ошибки = Новый Массив();
    ВремяСбора = ОтелУтилиты.ТекущееВремяВНаносекундах();
    Для Каждого Метр Из КопияМетров Цикл
        Попытка
            СобратьДанныеМетра(Метр, МассивДанных, ВремяСбора, Ошибки);
        Исключение
            Лог.Предупреждение("Ошибка сбора метрик: %1", ОписаниеОшибки());
            Ошибки.Добавить(ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;

    СобратьДанныеПродюсеров(МассивДанных);
    БылаОшибкаСбора = Ошибки.Количество() > 0;

    Если МассивДанных.Количество() = 0 Тогда
        Если БылаОшибкаСбора Тогда
            Возврат ОтелРезультатыЭкспорта.Ошибка();
        КонецЕсли;
        Возврат ОтелРезультатыЭкспорта.Успех();
    КонецЕсли;

    Возврат ВыполнитьЭкспорт(МассивДанных, БылаОшибкаСбора, ТаймаутМс);
КонецФункции

// Экспортирует данные сбора: пакетами не больше МаксРазмерПакетаЭкспорта точек, последовательно.
// Каждый вызов Экспортировать ограничен таймаутом экспорта и оставшимся сроком; после
// истечения срока оставшиеся пакеты не экспортируются.
//
// Параметры:
//   МассивДанных - Массив из ОтелДанныеМетрики - данные сбора
//   БылаОшибкаСбора - Булево - сбор метра или инструмента завершился сбоем
//   ТаймаутМс - Число - срок в миллисекундах (0 - без ограничения)
//
// Возвращаемое значение:
//   ОтелРезультатЭкспорта - ошибка, если сбор или экспорт пакета завершились сбоем; иначе
//       таймаут, если экспорт не уложился в срок; иначе успех
//
Функция ВыполнитьЭкспорт(МассивДанных, БылаОшибкаСбора, ТаймаутМс = 0)
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Результаты = Новый Массив();
    Если БылаОшибкаСбора Тогда
        Результаты.Добавить(ОтелРезультатыЭкспорта.Ошибка());
    КонецЕсли;
    // Первый пакет получает весь срок, следующие - оставшееся время
    СрокПакета = ТаймаутМс;
    ПервыйПакет = Истина;
    Для Каждого Пакет Из РазбитьНаПакеты(МассивДанных) Цикл
        Если НЕ ПервыйПакет И ОтелРезультатыЗакрытия.СрокИстек(НачалоМс, ТаймаутМс) Тогда
            Результаты.Добавить(ОтелРезультатыЭкспорта.Таймаут());
            Прервать;
        КонецЕсли;
        Результаты.Добавить(ЭкспортироватьПакет(Пакет, ТаймаутВызоваЭкспорта(СрокПакета)));
        ПервыйПакет = Ложь;
        СрокПакета = ОтелРезультатыЗакрытия.ОставшеесяВремя(НачалоМс, ТаймаутМс);
    КонецЦикла;
    Возврат ОтелРезультатыЭкспорта.ИзРезультатаЗакрытия(ОтелРезультатыЗакрытия.Свести(Результаты));
КонецФункции

// Экспортирует пакет данных. Неуспешный экспорт, занявший весь таймаут, считается таймаутом.
//
// Параметры:
//   Пакет - Массив из ОтелДанныеМетрики - пакет данных
//   ТаймаутЭкспорта - Число - таймаут вызова в миллисекундах (0 - без ограничения)
//
// Возвращаемое значение:
//   ОтелРезультатЭкспорта
//
Функция ЭкспортироватьПакет(Пакет, ТаймаутЭкспорта)
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Попытка
        Блокировка.Заблокировать();
        Попытка
            Результат = Экспортер.Экспортировать(Пакет, ТаймаутЭкспорта);
        Исключение
            Блокировка.Разблокировать();
            ВызватьИсключение;
        КонецПопытки;
        Блокировка.Разблокировать();
    Исключение
        Лог.Предупреждение("Ошибка экспорта метрики: %1", ОписаниеОшибки());
        Возврат ОтелРезультатыЭкспорта.Ошибка();
    КонецПопытки;
    Если РезультатУспешен(Результат) Тогда
        Возврат ОтелРезультатыЭкспорта.Успех();
    КонецЕсли;
    ИстекТаймаут = ТипЗнч(Результат) = Тип("ОтелРезультатЭкспорта") И Результат.ИстекТаймаут();
    Если ИстекТаймаут ИЛИ ОтелРезультатыЗакрытия.СрокИстек(НачалоМс, ТаймаутЭкспорта) Тогда
        Возврат ОтелРезультатыЭкспорта.Таймаут();
    КонецЕсли;
    Возврат ОтелРезультатыЭкспорта.Ошибка();
КонецФункции

Функция РезультатУспешен(Результат)
    Если ТипЗнч(Результат) = Тип("Булево") Тогда
        Возврат Результат;
    КонецЕсли;
    Если ТипЗнч(Результат) = Тип("ОтелРезультатЭкспорта") ИЛИ ТипЗнч(Результат) = Тип("ОтелРезультатЗакрытия") Тогда
        Возврат Результат.Успешно();
    КонецЕсли;
    Возврат Ложь;
КонецФункции

// Возвращает таймаут вызова Экспортировать: меньший из срока и таймаута экспорта читателя.
//
// Параметры:
//   СрокМс - Число - оставшийся срок в миллисекундах (0 - без ограничения)
//
// Возвращаемое значение:
//   Число - таймаут в миллисекундах (0 - без ограничения)
//
Функция ТаймаутВызоваЭкспорта(СрокМс)
    Если СрокМс <= 0 Тогда
        Возврат ТаймаутЭкспортаМс;
    КонецЕсли;
    Если ТаймаутЭкспортаМс <= 0 Тогда
        Возврат СрокМс;
    КонецЕсли;
    Возврат Мин(СрокМс, ТаймаутЭкспортаМс);
КонецФункции

// Делит данные сбора на полные пакеты по МаксРазмерПакетаЭкспорта точек: точки одной метрики
// могут попасть в разные пакеты, последний пакет может быть неполным.
//
// Параметры:
//   МассивДанных - Массив из ОтелДанныеМетрики - данные сбора
//
// Возвращаемое значение:
//   Массив из Массив - пакеты данных
//
Функция РазбитьНаПакеты(МассивДанных)
    Пакеты = Новый Массив();
    Если МаксРазмерПакетаЭкспорта <= 0 Тогда
        Пакеты.Добавить(МассивДанных);
        Возврат Пакеты;
    КонецЕсли;
    Пакет = Новый Массив();
    ТочекВПакете = 0;
    Для Каждого Данные Из МассивДанных Цикл
        Точки = Данные.ТочкиДанных();
        Если Точки.Количество() = 0 Тогда
            Пакет.Добавить(Данные);
            Продолжить;
        КонецЕсли;
        Начало = 0;
        Пока Начало < Точки.Количество() Цикл
            Число = Мин(МаксРазмерПакетаЭкспорта - ТочекВПакете, Точки.Количество() - Начало);
            Пакет.Добавить(ЧастьДанных(Данные, Начало, Число));
            ТочекВПакете = ТочекВПакете + Число;
            Начало = Начало + Число;
            Если ТочекВПакете = МаксРазмерПакетаЭкспорта Тогда
                Пакеты.Добавить(Пакет);
                Пакет = Новый Массив();
                ТочекВПакете = 0;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Если Пакет.Количество() > 0 Тогда
        Пакеты.Добавить(Пакет);
    КонецЕсли;
    Возврат Пакеты;
КонецФункции

// Возвращает данные метрики с частью точек: копию с той же идентичностью и временной агрегацией.
//
// Параметры:
//   Данные - ОтелДанныеМетрики - данные метрики
//   Начало - Число - индекс первой точки
//   Число - Число - количество точек
//
// Возвращаемое значение:
//   ОтелДанныеМетрики
//
Функция ЧастьДанных(Данные, Начало, Число)
    Точки = Данные.ТочкиДанных();
    Если Начало = 0 И Число = Точки.Количество() Тогда
        Возврат Данные;
    КонецЕсли;
    ТочкиЧасти = Новый Массив();
    Для Индекс = Начало По Начало + Число - 1 Цикл
        ТочкиЧасти.Добавить(Точки[Индекс]);
    КонецЦикла;
    Часть = Новый ОтелДанныеМетрики(Данные.Ресурс(), Данные.ОбластьИнструментирования(), Данные.Имя(),
        Данные.Описание(), Данные.ЕдиницаИзмерения(), Данные.ТипМетрики(), ТочкиЧасти,
        Данные.Монотонный(), Данные.ТипЗначения());
    Часть.УстановитьВременнуюАгрегацию(Данные.ВременнаяАгрегация());
    Возврат Часть;
КонецФункции

// Возвращает фильтр для передачи MetricProducer с проставленной
// предпочтительной AggregationTemporality читателя (Metrics SDK §126).
// Если входной фильтр уже имеет hint темпоральности, возвращается как есть.
//
// Параметры:
//   ИсходныйФильтр - ОтелФильтрМетрик, Неопределено - фильтр, заданный пользователем
//
// Возвращаемое значение:
//   ОтелФильтрМетрик, Неопределено - фильтр с hint темпоральности
//
Функция ОбогатитьФильтрПредпочтительнойТемпоральностью(ИсходныйФильтр)
    ТипИнструментаПоУмолчанию = "Counter";
    Попытка
        ПредпочтительнаяТемпоральность = Экспортер.ПолучитьВременнуюАгрегацию(ТипИнструментаПоУмолчанию);
    Исключение
        ПредпочтительнаяТемпоральность = Неопределено;
    КонецПопытки;

    Если ИсходныйФильтр = Неопределено Тогда
        Если ПредпочтительнаяТемпоральность = Неопределено Тогда
            Возврат Неопределено;
        КонецЕсли;
        НовыйФильтр = Новый ОтелФильтрМетрик();
        НовыйФильтр.УстановитьПредпочтительнуюТемпоральность(ПредпочтительнаяТемпоральность);
        Возврат НовыйФильтр;
    КонецЕсли;

    Если ИсходныйФильтр.ПредпочтительнаяТемпоральность() = Неопределено
            И ПредпочтительнаяТемпоральность <> Неопределено Тогда
        ИсходныйФильтр.УстановитьПредпочтительнуюТемпоральность(ПредпочтительнаяТемпоральность);
    КонецЕсли;
    Возврат ИсходныйФильтр;
КонецФункции

// Собирает потоки метра этого читателя: имена, агрегацию и временную агрегацию потоков
// задают View и настройки читателя, фильтр метрик читателя применяется к результату.
//
// Параметры:
//   Метр - ОтелМетр - метр
//   МассивДанных - Массив - сюда добавляются данные метрик
//   ВремяСбора - Строка - время сбора в наносекундах
//   Ошибки - Массив - сюда добавляются описания ошибок сбора
//
Процедура СобратьДанныеМетра(Метр, МассивДанных, ВремяСбора, Ошибки)
    МетрОбласть = Метр.ОбластьИнструментирования();
    Для Каждого Данные Из Метр.СобратьДляЧитателя(ЭтотОбъект, ВремяСбора, Ошибки) Цикл
        Если НЕ МетрикаОтброшена(Данные, МетрОбласть, Данные.Имя()) Тогда
            МассивДанных.Добавить(Данные);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ОтфильтроватьТочкиДанных(Данные, МетрОбласть, ИмяМетрики)
    ИсходныеТочки = Данные.ТочкиДанных();
    Индекс = ИсходныеТочки.ВГраница();
    Пока Индекс >= 0 Цикл
        ТочкаДанных = ИсходныеТочки[Индекс];
        Атрибуты = ТочкаДанных.Получить("attributes");
        Если Атрибуты = Неопределено Тогда
            Атрибуты = Новый Массив;
        КонецЕсли;
        Результат = ФильтрМетрик.ТестАтрибутов(
            МетрОбласть, ИмяМетрики, Данные.ТипМетрики(), Данные.ЕдиницаИзмерения(), Атрибуты);
        Если Результат = ОтелРезультатФильтраАтрибутов.Отбросить() Тогда
            ИсходныеТочки.Удалить(Индекс);
        КонецЕсли;
        Индекс = Индекс - 1;
    КонецЦикла;
КонецПроцедуры

Функция МетрикаОтброшена(Данные, МетрОбласть, ИмяМетрики)
    Если ФильтрМетрик = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;

    РезультатФильтра = ФильтрМетрик.ТестМетрики(
        МетрОбласть, ИмяМетрики, Данные.ТипМетрики(), Данные.ЕдиницаИзмерения());
    Если РезультатФильтра = ОтелРезультатФильтраМетрик.Отбросить() Тогда
        Возврат Истина;
    КонецЕсли;
    Если РезультатФильтра = ОтелРезультатФильтраМетрик.ЧастичноеПринятие() Тогда
        ОтфильтроватьТочкиДанных(Данные, МетрОбласть, ИмяМетрики);
    КонецЕсли;
    Возврат Ложь;
КонецФункции

Процедура СобратьДанныеПродюсеров(МассивДанных)
    Блокировка.Заблокировать();
    Попытка
        КопияПродюсеров = Новый Массив();
        Для Каждого Продюсер Из Продюсеры Цикл
            КопияПродюсеров.Добавить(Продюсер);
        КонецЦикла;
        Блокировка.Разблокировать();
    Исключение
        Блокировка.Разблокировать();
        Возврат;
    КонецПопытки;

    Для Каждого Продюсер Из КопияПродюсеров Цикл
        Попытка
            ФильтрДляПродюсера = ОбогатитьФильтрПредпочтительнойТемпоральностью(ФильтрМетрик);
            РезультатПродюсера = Продюсер.Произвести(ФильтрДляПродюсера);
            // Совместимость: на случай старых реализаций продюсеров,
            // возвращающих просто Массив, обрабатываем оба варианта.
            Если ТипЗнч(РезультатПродюсера) = Тип("Массив") Тогда
                ДанныеПродюсера = РезультатПродюсера;
            Иначе
                Если НЕ РезультатПродюсера.Успех() Тогда
                    Лог.Предупреждение(
                        "MetricProducer вернул статус %1: %2",
                        РезультатПродюсера.Статус, РезультатПродюсера.СообщениеОшибки);
                    Продолжить;
                КонецЕсли;
                ДанныеПродюсера = РезультатПродюсера.Метрики;
            КонецЕсли;
            Для Каждого Данные Из ДанныеПродюсера Цикл
                МассивДанных.Добавить(Данные);
            КонецЦикла;
        Исключение
            Лог.Предупреждение("Ошибка продюсера метрик: %1", ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;
КонецПроцедуры

Процедура УстановитьИнтервалЭкспортаМс(Значение)
    ИнтервалЭкспортаМс = Значение;
КонецПроцедуры

Процедура УстановитьЭкспортер(Значение)
    Экспортер = Значение;
КонецПроцедуры

// Класс периодического читателя метрик (PeriodicMetricReader) по спецификации OpenTelemetry.
//
// Периодически собирает метрики из Meter и экспортирует их через экспортер.
// Использует Обещания для асинхронной работы.
//
// Конструктор периодического читателя метрик.
//
// Параметры:
//   Экспортер - ОтелЭкспортерМетрик - экспортер метрик
//   ИнтервалЭкспортаМс - Число - интервал сбора/экспорта в мс (по умолчанию 60000)
//   НовыйЛимитМощности - Число - лимит мощности (cardinality limit), по умолчанию 2000
//   НоваяАгрегацияГистограмм - Строка - агрегация гистограмм по умолчанию (необязательный)
//
// BSLLS:MagicNumber-off
Процедура ПриСозданииОбъекта(
        Экспортер,
        ИнтервалЭкспортаМс = 60000,
        НовыйЛимитМощности = 2000,
        НоваяАгрегацияГистограмм = "explicit_bucket_histogram")
// BSLLS:MagicNumber-on
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics");
    УстановитьЭкспортер(Экспортер);
    УстановитьИнтервалЭкспортаМс(ИнтервалЭкспортаМс);
    Метры = Новый Массив();
    Продюсеры = Новый Массив();
    Блокировка = Новый БлокировкаРесурса();
    Закрыт = Новый АтомарноеБулево(Ложь);
    Обещание = Неопределено;
    ФильтрМетрик = Неопределено;
    ЛимитМощности = НовыйЛимитМощности;
    ЛимитыМощностиПоВиду = Новый Соответствие();
    Зарегистрирован = Новый АтомарноеБулево(Ложь);
    БлокировкаСбора = Новый БлокировкаРесурса();
    ТаймаутЭкспортаМс = 30000;
    МаксРазмерПакетаЭкспорта = 0;
    ИнициализироватьСелекторАгрегации(НоваяАгрегацияГистограмм);
КонецПроцедуры

Процедура ИнициализироватьСелекторАгрегации(АгрегацияГистограмм)
    АгрегацияСуммы = "sum";
    АгрегацияПоследнегоЗначения = "last_value";
    СелекторАгрегации = Новый Соответствие();
    СелекторАгрегации.Вставить("Counter", АгрегацияСуммы);
    СелекторАгрегации.Вставить("UpDownCounter", АгрегацияСуммы);
    СелекторАгрегации.Вставить("Histogram", АгрегацияГистограмм);
    СелекторАгрегации.Вставить("ExponentialHistogram", "base2_exponential_bucket_histogram");
    СелекторАгрегации.Вставить("Gauge", АгрегацияПоследнегоЗначения);
    СелекторАгрегации.Вставить("ObservableCounter", АгрегацияСуммы);
    СелекторАгрегации.Вставить("ObservableUpDownCounter", АгрегацияСуммы);
    СелекторАгрегации.Вставить("ObservableGauge", АгрегацияПоследнегоЗначения);
КонецПроцедуры

// Вызывает ForceFlush экспортера: ПринудительноВыгрузитьСРезультатом, а у экспортера, который
// реализует только ИнтерфейсЭкспортерМетрик, - СброситьБуфер. Экспортер получает оставшееся
// время, после истечения срока - 1 мс. Исключение экспортера возвращается ошибкой.
//
// Параметры:
//   НачалоМс - Число - начало операции (ТекущаяУниверсальнаяДатаВМиллисекундах)
//   ТаймаутМс - Число - общий срок в мс; 0 - без ограничения
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия, ОтелРезультатЭкспорта, Булево, Неопределено - результат экспортера
//
Функция СброситьБуферЭкспортера(НачалоМс, ТаймаутМс)
    Рефлектор = Новый Рефлектор();
    ИмяМетода = ?(Рефлектор.МетодСуществует(Экспортер, "ПринудительноВыгрузитьСРезультатом"),
        "ПринудительноВыгрузитьСРезультатом", "СброситьБуфер");
    Возврат ОтелРезультатыЗакрытия.ВызватьВПределахСрока(Экспортер, ИмяМетода, НачалоМс, ТаймаутМс);
КонецФункции

#КонецОбласти
