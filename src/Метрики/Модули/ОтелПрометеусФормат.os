// Форматы выдачи Prometheus-экспортера: text format 0.0.4 и 1.0.0, OpenMetrics 1.0.0 (и 0.0.1),
// экранирование имен по схемам Prometheus (underscores, dots, values, allow-utf-8) и согласование
// формата по заголовку Accept (Prometheus Content Negotiation).
//
// Формат - Структура:
//   * Тип - Строка - "text" или "openmetrics"
//   * Версия - Строка - версия формата: "0.0.4" или "1.0.0" для text, "0.0.1" или "1.0.0" для openmetrics
//   * Экранирование - Строка - схема экранирования имен: underscores, dots, values или allow-utf-8
//     (allow-utf-8 - только в форматах версии 1.0.0)
//   * ТипКонтента - Строка - значение Content-Type ответа
//
// Семейство - Соответствие или Структура с полями Имя, Тип, Справка, Сэмплы и необязательным
// Единица (выводится в # UNIT OpenMetrics, если имя семейства оканчивается на _<единица>). Сэмпл -
// ИмяСэмпла, Лейблы (Соответствие), Значение и необязательный Экземпляр (exemplar OpenMetrics:
// Лейблы, Значение, Время - время в секундах или Неопределено).

#Область ПрограммныйИнтерфейс

// Возвращает формат по умолчанию: text 0.0.4 с экранированием underscores. Используется, если
// заголовка Accept нет или ни один запрошенный формат не поддерживается.
//
// Возвращаемое значение:
//   Структура - формат (см. описание модуля)
//
Функция ФорматПоУмолчанию() Экспорт
    Возврат НовыйФормат("text", "0.0.4", "underscores");
КонецФункции

// Выбирает формат выдачи по заголовку Accept: поддерживаемый формат с наибольшим весом q, при
// равных весах - указанный раньше. Параметр escaping задает схему экранирования имен; allow-utf-8
// допустим только в форматах версии 1.0.0. Если заголовка нет или ни один формат не подошел -
// формат по умолчанию.
//
// Параметры:
//   Accept - Строка, Неопределено - значение заголовка Accept
//
// Возвращаемое значение:
//   Структура - формат (см. описание модуля)
//
Функция ВыбратьФормат(Accept) Экспорт
    Лучший = Неопределено;
    ЛучшийВес = 0;
    Если ТипЗнч(Accept) = Тип("Строка") Тогда
        Для Каждого Диапазон Из СтрРазделить(Accept, ",", Ложь) Цикл
            Кандидат = ФорматДиапазона(Диапазон);
            Если Кандидат <> Неопределено И Кандидат.Вес > ЛучшийВес Тогда
                Лучший = Кандидат.Формат;
                ЛучшийВес = Кандидат.Вес;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Возврат ?(Лучший = Неопределено, ФорматПоУмолчанию(), Лучший);
КонецФункции

// Возвращает текст выдачи семейств метрик в формате выдачи. Семейства выводятся по возрастанию
// имени, сэмплы гистограммы - сериями: бакеты по возрастанию le, _sum, _count, _created. В
// OpenMetrics выводятся # UNIT и exemplars, выдача завершается # EOF.
//
// Параметры:
//   Семейства - Массив из Соответствие - семейства метрик (см. описание модуля)
//   Формат - Структура - формат выдачи (см. описание модуля)
//
// Возвращаемое значение:
//   Строка - выдача; пустая строка, если text-формат не содержит семейств
//
Функция ТекстВыдачи(Семейства, Формат) Экспорт
    Строки = Новый Массив();
    Для Каждого Семейство Из УпорядоченныеСемейства(Семейства) Цикл
        ДобавитьСтрокиСемейства(Строки, Семейство, Формат);
    КонецЦикла;
    Если Формат.Тип = "openmetrics" Тогда
        Строки.Добавить("# EOF");
    КонецЕсли;
    Если Строки.Количество() = 0 Тогда
        Возврат "";
    КонецЕсли;
    Возврат СтрСоединить(Строки, Символы.ПС) + Символы.ПС;
КонецФункции

// Экранирует имя метрики по схеме Prometheus.
//
// Параметры:
//   Имя - Строка - имя метрики
//   Экранирование - Строка - underscores, dots, values или allow-utf-8
//
// Возвращаемое значение:
//   Строка
//
Функция ЭкранироватьИмяМетрики(Имя, Экранирование) Экспорт
    Возврат ЭкранироватьИмя(Имя, Экранирование, Истина);
КонецФункции

// Экранирует имя лейбла по схеме Prometheus. В отличие от имени метрики, двоеточие в имени
// лейбла недопустимо.
//
// Параметры:
//   Имя - Строка - имя лейбла
//   Экранирование - Строка - underscores, dots, values или allow-utf-8
//
// Возвращаемое значение:
//   Строка
//
Функция ЭкранироватьИмяЛейбла(Имя, Экранирование) Экспорт
    Возврат ЭкранироватьИмя(Имя, Экранирование, Ложь);
КонецФункции

// Проверяет, что имя метрики допустимо в классическом формате: [a-zA-Z_:][a-zA-Z0-9_:]*.
//
// Параметры:
//   Имя - Строка - имя метрики
//
// Возвращаемое значение:
//   Булево
//
Функция ИмяМетрикиКлассическое(Имя) Экспорт
    Возврат ИмяКлассическое(Имя, Истина);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Согласование

Функция НовыйФормат(ТипФормата, Версия, Экранирование)
    ПоУмолчанию = "underscores";
    Схема = ?(ТипЗнч(Экранирование) = Тип("Строка"), НРег(Экранирование), ПоУмолчанию);
    // UTF-8 имена допустимы только в форматах версии 1.0.0
    Если СтрРазделить(ПоУмолчанию + ",dots,values,allow-utf-8", ",").Найти(Схема) = Неопределено
            ИЛИ Схема = "allow-utf-8" И Версия <> "1.0.0" Тогда
        Схема = ПоУмолчанию;
    КонецЕсли;
    ТипМедиа = ?(ТипФормата = "openmetrics", "application/openmetrics-text", "text/plain");
    ТипКонтента = ТипМедиа + "; version=" + Версия + "; charset=utf-8";
    Если Версия = "1.0.0" ИЛИ Схема <> ПоУмолчанию Тогда
        ТипКонтента = ТипКонтента + "; escaping=" + Схема;
    КонецЕсли;
    Формат = Новый Структура("Тип, Версия, Экранирование", ТипФормата, Версия, Схема);
    Формат.Вставить("ТипКонтента", ТипКонтента);
    Возврат Формат;
КонецФункции

// Возвращает формат, соответствующий диапазону медиа-типов заголовка Accept, и его вес.
//
// Параметры:
//   Диапазон - Строка - диапазон: медиа-тип и параметры через ";"
//
// Возвращаемое значение:
//   Структура, Неопределено - Формат и Вес; Неопределено, если формат не поддерживается или вес 0
//
Функция ФорматДиапазона(Диапазон)
    Части = СтрРазделить(Диапазон, ";");
    Параметры = ПараметрыДиапазона(Части);
    Вес = ВесДиапазона(Параметры.Получить("q"));
    Если Вес <= 0 Тогда
        Возврат Неопределено;
    КонецЕсли;
    ТипМедиа = НРег(СокрЛП(Части[0]));
    Формат = ФорматТипаМедиа(ТипМедиа, Параметры.Получить("version"), Параметры.Получить("escaping"));
    Если Формат = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат Новый Структура("Формат, Вес", Формат, Вес);
КонецФункции

// Возвращает формат для медиа-типа диапазона и его параметров version и escaping. Без version
// OpenMetrics - версии 0.0.1, text - 0.0.4.
//
// Параметры:
//   ТипМедиа - Строка - медиа-тип в нижнем регистре
//   Версия - Строка, Неопределено - параметр version
//   Экранирование - Строка, Неопределено - параметр escaping
//
// Возвращаемое значение:
//   Структура, Неопределено - формат; Неопределено, если медиа-тип или версия не поддерживаются
//
Функция ФорматТипаМедиа(ТипМедиа, Версия, Экранирование)
    Если ТипМедиа = "application/openmetrics-text" Тогда
        ТипФормата = "openmetrics";
        ВерсияФормата = ?(Версия = Неопределено, "0.0.1", Версия);
        Поддерживаемые = "0.0.1,1.0.0";
    ИначеЕсли ТипМедиа = "text/plain" Тогда
        ТипФормата = "text";
        ВерсияФормата = ?(Версия = Неопределено, "0.0.4", Версия);
        Поддерживаемые = "0.0.4,1.0.0";
    ИначеЕсли ТипМедиа = "*/*" ИЛИ ТипМедиа = "text/*" Тогда
        Возврат ФорматПоУмолчанию();
    Иначе
        Возврат Неопределено;
    КонецЕсли;
    Если СтрРазделить(Поддерживаемые, ",").Найти(ВерсияФормата) = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат НовыйФормат(ТипФормата, ВерсияФормата, Экранирование);
КонецФункции

Функция ПараметрыДиапазона(Части)
    Параметры = Новый Соответствие();
    Для Индекс = 1 По Части.ВГраница() Цикл
        Параметр = Части[Индекс];
        Равно = СтрНайти(Параметр, "=");
        Если Равно > 0 Тогда
            Значение = СтрЗаменить(СокрЛП(Сред(Параметр, Равно + 1)), """", "");
            Параметры.Вставить(НРег(СокрЛП(Лев(Параметр, Равно - 1))), Значение);
        КонецЕсли;
    КонецЦикла;
    Возврат Параметры;
КонецФункции

Функция ВесДиапазона(Значение)
    Если Значение = Неопределено Тогда
        Возврат 1;
    КонецЕсли;
    // Нераспознанный вес приводится к 0: диапазон не принимается
    Возврат Новый ОписаниеТипов("Число").ПривестиЗначение(Значение);
КонецФункции

#КонецОбласти

#Область Сериализация

// Возвращает семейства по возрастанию имени; из семейств с одинаковым именем остается последнее.
//
// Параметры:
//   Семейства - Массив - семейства
//
// Возвращаемое значение:
//   Массив
//
Функция УпорядоченныеСемейства(Семейства)
    Результат = Новый Массив();
    Если ТипЗнч(Семейства) <> Тип("Массив") Тогда
        Возврат Результат;
    КонецЕсли;
    ПоИмени = Новый Соответствие();
    Для Каждого Семейство Из Семейства Цикл
        ПоИмени.Вставить(СтрокаПоля(Семейство, "Имя", ""), Семейство);
    КонецЦикла;
    Имена = Новый СписокЗначений();
    Для Каждого КЗ Из ПоИмени Цикл
        Имена.Добавить(КЗ.Ключ);
    КонецЦикла;
    Имена.СортироватьПоЗначению(НаправлениеСортировки.Возр);
    Для Каждого Имя Из Имена.ВыгрузитьЗначения() Цикл
        Результат.Добавить(ПоИмени.Получить(Имя));
    КонецЦикла;
    Возврат Результат;
КонецФункции

Процедура ДобавитьСтрокиСемейства(Строки, Семейство, Формат)
    Сэмплы = ЗначениеПоля(Семейство, "Сэмплы", Новый Массив());
    Если ТипЗнч(Сэмплы) <> Тип("Массив") Тогда
        Возврат;
    КонецЕсли;
    ОткрытыеМетрики = Формат.Тип = "openmetrics";
    Имя = СтрокаПоля(Семейство, "Имя", "");
    Тип = СтрокаПоля(Семейство, "Тип", "untyped");
    Справка = СтрокаПоля(Семейство, "Справка", "");
    Единица = СтрокаПоля(Семейство, "Единица", "");
    ИмяВМетаданных = ИмяВВыдаче(Имя, Формат);
    Если НЕ ПустаяСтрока(Справка) Тогда
        Строки.Добавить("# HELP " + ИмяВМетаданных + " " + ЭкранироватьСправку(Справка, ОткрытыеМетрики));
    КонецЕсли;
    Строки.Добавить("# TYPE " + ИмяВМетаданных + " " + Тип);
    Если ОткрытыеМетрики И НЕ ПустаяСтрока(Единица) И СтрЗаканчиваетсяНа(Имя, "_" + Единица) Тогда
        Строки.Добавить("# UNIT " + ИмяВМетаданных + " " + Единица);
    КонецЕсли;
    Для Каждого Сэмпл Из УпорядоченныеСэмплы(Сэмплы, Тип) Цикл
        Строки.Добавить(СтрокаСэмпла(Сэмпл, Имя, Формат));
    КонецЦикла;
КонецПроцедуры

// Упорядочивает сэмплы гистограммы и резюме по сериям (в порядке первого появления серии):
// бакеты по возрастанию le (квантили по возрастанию quantile), затем _sum, _count и _created.
// Сэмплы остальных типов выводятся как есть.
//
// Параметры:
//   Сэмплы - Массив - сэмплы семейства
//   Тип - Строка - тип семейства
//
// Возвращаемое значение:
//   Массив
//
Функция УпорядоченныеСэмплы(Сэмплы, Тип)
    Если Тип = "histogram" Тогда
        СлужебныйЛейбл = "le";
    ИначеЕсли Тип = "summary" Тогда
        СлужебныйЛейбл = "quantile";
    Иначе
        Возврат Сэмплы;
    КонецЕсли;
    Результат = Новый Массив();
    Для Каждого СэмплыСерии Из СерииСэмплов(Сэмплы, СлужебныйЛейбл) Цикл
        Для Каждого Сэмпл Из УпорядоченныеСэмплыСерии(СэмплыСерии, СлужебныйЛейбл) Цикл
            Результат.Добавить(Сэмпл);
        КонецЦикла;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция СерииСэмплов(Сэмплы, СлужебныйЛейбл)
    Серии = Новый Массив();
    ИндексыСерий = Новый Соответствие();
    Для Каждого Сэмпл Из Сэмплы Цикл
        ЛейблыСерии = Новый Соответствие();
        Для Каждого КЗ Из ЛейблыСэмпла(Сэмпл) Цикл
            Если КЗ.Ключ <> СлужебныйЛейбл Тогда
                ЛейблыСерии.Вставить(КЗ.Ключ, КЗ.Значение);
            КонецЕсли;
        КонецЦикла;
        КлючСерии = ЛейблыСтрокой(ЛейблыСерии, ФорматПоУмолчанию());
        Индекс = ИндексыСерий.Получить(КлючСерии);
        Если Индекс = Неопределено Тогда
            Индекс = Серии.Количество();
            Серии.Добавить(Новый Массив());
            ИндексыСерий.Вставить(КлючСерии, Индекс);
        КонецЕсли;
        Серии[Индекс].Добавить(Сэмпл);
    КонецЦикла;
    Возврат Серии;
КонецФункции

// Упорядочивает сэмплы одной серии: сэмплы со служебным лейблом по возрастанию его значения
// (бакет +Inf - последним), затем _sum, _count и _created. Из сэмплов с одинаковым значением
// служебного лейбла или суффиксом остается последний.
//
// Параметры:
//   Сэмплы - Массив - сэмплы серии
//   СлужебныйЛейбл - Строка - le или quantile
//
// Возвращаемое значение:
//   Массив
//
Функция УпорядоченныеСэмплыСерии(Сэмплы, СлужебныйЛейбл)
    ПоГранице = Новый Соответствие();
    БезГраницы = Неопределено;
    Суффиксные = Новый Соответствие();
    Для Каждого Сэмпл Из Сэмплы Цикл
        Граница = ЛейблыСэмпла(Сэмпл).Получить(СлужебныйЛейбл);
        Если Граница = "+Inf" Тогда
            БезГраницы = Сэмпл;
        ИначеЕсли Граница <> Неопределено Тогда
            ПоГранице.Вставить(ЧислоСэмпла(Граница), Сэмпл);
        Иначе
            Суффиксные.Вставить(СуффиксСерии(СтрокаПоля(Сэмпл, "ИмяСэмпла", "")), Сэмпл);
        КонецЕсли;
    КонецЦикла;
    Результат = СэмплыПоВозрастаниюГраницы(ПоГранице);
    Если БезГраницы <> Неопределено Тогда
        Результат.Добавить(БезГраницы);
    КонецЕсли;
    Для Каждого Суффикс Из СуффиксыСерии() Цикл
        Сэмпл = Суффиксные.Получить(Суффикс);
        Если Сэмпл <> Неопределено Тогда
            Результат.Добавить(Сэмпл);
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Возвращает сэмплы по возрастанию значения служебного лейбла.
//
// Параметры:
//   ПоГранице - Соответствие - значение служебного лейбла (Число) -> сэмпл
//
// Возвращаемое значение:
//   Массив
//
Функция СэмплыПоВозрастаниюГраницы(ПоГранице)
    Границы = Новый СписокЗначений();
    Для Каждого КЗ Из ПоГранице Цикл
        Границы.Добавить(КЗ.Ключ);
    КонецЦикла;
    Границы.СортироватьПоЗначению(НаправлениеСортировки.Возр);
    Результат = Новый Массив();
    Для Каждого Граница Из Границы.ВыгрузитьЗначения() Цикл
        Результат.Добавить(ПоГранице.Получить(Граница));
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Возвращает суффикс сэмпла серии гистограммы или резюме без служебного лейбла.
//
// Параметры:
//   ИмяСэмпла - Строка - имя сэмпла
//
// Возвращаемое значение:
//   Строка - _sum, _count, _created или пустая строка
//
Функция СуффиксСерии(ИмяСэмпла)
    Для Каждого Суффикс Из СуффиксыСерии() Цикл
        Если СтрЗаканчиваетсяНа(ИмяСэмпла, Суффикс) Тогда
            Возврат Суффикс;
        КонецЕсли;
    КонецЦикла;
    Возврат "";
КонецФункции

Функция СуффиксыСерии()
    Возврат СтрРазделить("_sum,_count,_created", ",");
КонецФункции

Функция СтрокаСэмпла(Сэмпл, ИмяСемейства, Формат)
    ИмяСэмпла = СтрокаПоля(Сэмпл, "ИмяСэмпла", ИмяСемейства);
    ЛейблыВСтроке = ЛейблыСтрокой(ЛейблыСэмпла(Сэмпл), Формат);
    Если Формат.Экранирование = "allow-utf-8" И НЕ ИмяКлассическое(ИмяСэмпла, Истина) Тогда
        Начало = "{" + ВКавычках(ИмяСэмпла) + ?(ЛейблыВСтроке = "", "", "," + ЛейблыВСтроке) + "}";
    Иначе
        Начало = ИмяСэмпла + ?(ЛейблыВСтроке = "", "", "{" + ЛейблыВСтроке + "}");
    КонецЕсли;
    Результат = Начало + " " + ЧислоВТекст(ЗначениеПоля(Сэмпл, "Значение", 0));
    Экземпляр = ЗначениеПоля(Сэмпл, "Экземпляр", Неопределено);
    Если Формат.Тип = "openmetrics" И Экземпляр <> Неопределено Тогда
        Результат = Результат + " # " + СтрокаЭкземпляра(Экземпляр, Формат);
    КонецЕсли;
    Возврат Результат;
КонецФункции

// Возвращает exemplar OpenMetrics: {лейблы} значение [время].
//
// Параметры:
//   Экземпляр - Структура, Соответствие - Лейблы, Значение, Время (секунды или Неопределено)
//   Формат - Структура - формат выдачи
//
// Возвращаемое значение:
//   Строка
//
Функция СтрокаЭкземпляра(Экземпляр, Формат)
    Лейблы = ЗначениеПоля(Экземпляр, "Лейблы", Новый Соответствие());
    Значение = ЗначениеПоля(Экземпляр, "Значение", 0);
    Результат = "{" + ЛейблыСтрокой(Лейблы, Формат) + "} " + ЧислоВТекст(Значение);
    Время = ЗначениеПоля(Экземпляр, "Время", Неопределено);
    Если Время <> Неопределено Тогда
        Результат = Результат + " " + ЧислоВТекст(Время);
    КонецЕсли;
    Возврат Результат;
КонецФункции

// Возвращает лейблы через запятую в порядке возрастания строк "имя=значение".
//
// Параметры:
//   Лейблы - Соответствие - лейблы
//   Формат - Структура - формат выдачи: при allow-utf-8 имена вне классического формата в кавычках
//
// Возвращаемое значение:
//   Строка
//
Функция ЛейблыСтрокой(Лейблы, Формат)
    Если ТипЗнч(Лейблы) <> Тип("Соответствие") Тогда
        Возврат "";
    КонецЕсли;
    ОписаниеСтроки = Новый ОписаниеТипов("Строка");
    Части = Новый СписокЗначений();
    Для Каждого КЗ Из Лейблы Цикл
        Значение = ОписаниеСтроки.ПривестиЗначение(КЗ.Значение);
        Имя = КЗ.Ключ;
        Если Формат.Экранирование = "allow-utf-8" И НЕ ИмяКлассическое(Имя, Ложь) Тогда
            Имя = ВКавычках(Имя);
        КонецЕсли;
        Части.Добавить(Имя + "=""" + ЭкранироватьЗначениеЛейбла(Значение) + """");
    КонецЦикла;
    Части.СортироватьПоЗначению(НаправлениеСортировки.Возр);
    Возврат СтрСоединить(Части.ВыгрузитьЗначения(), ",");
КонецФункции

Функция ЛейблыСэмпла(Сэмпл)
    Лейблы = ЗначениеПоля(Сэмпл, "Лейблы", Неопределено);
    Возврат ?(ТипЗнч(Лейблы) = Тип("Соответствие"), Лейблы, Новый Соответствие());
КонецФункции

Функция ИмяВВыдаче(Имя, Формат)
    Если Формат.Экранирование = "allow-utf-8" И НЕ ИмяКлассическое(Имя, Истина) Тогда
        Возврат ВКавычках(Имя);
    КонецЕсли;
    Возврат Имя;
КонецФункции

Функция ВКавычках(Имя)
    Возврат """" + ЭкранироватьЗначениеЛейбла(Имя) + """";
КонецФункции

Функция ЭкранироватьЗначениеЛейбла(Значение)
    Результат = СтрЗаменить(Значение, "\", "\\");
    Результат = СтрЗаменить(Результат, Символы.ПС, "\n");
    Возврат СтрЗаменить(Результат, """", "\""");
КонецФункции

Функция ЭкранироватьСправку(Справка, ОткрытыеМетрики)
    Результат = СтрЗаменить(Справка, "\", "\\");
    Результат = СтрЗаменить(Результат, Символы.ПС, "\n");
    Если ОткрытыеМетрики Тогда
        Результат = СтрЗаменить(Результат, """", "\""");
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ЧислоВТекст(Значение)
    Возврат Формат(ЧислоСэмпла(Значение), "ЧРД=.; ЧН=0; ЧГ=0");
КонецФункции

Функция ЧислоСэмпла(Значение)
    Приведенное = Новый ОписаниеТипов("Число").ПривестиЗначение(Значение);
    Возврат ?(ТипЗнч(Приведенное) = Тип("Число"), Приведенное, 0);
КонецФункции

Функция ЗначениеПоля(Объект, Ключ, ПоУмолчанию)
    Если ТипЗнч(Объект) = Тип("Соответствие") Тогда
        Значение = Объект.Получить(Ключ);
    ИначеЕсли ТипЗнч(Объект) = Тип("Структура") И Объект.Свойство(Ключ) Тогда
        Значение = Объект[Ключ];
    Иначе
        Значение = Неопределено;
    КонецЕсли;
    Возврат ?(Значение = Неопределено, ПоУмолчанию, Значение);
КонецФункции

Функция СтрокаПоля(Объект, Ключ, ПоУмолчанию)
    Значение = Новый ОписаниеТипов("Строка").ПривестиЗначение(ЗначениеПоля(Объект, Ключ, ПоУмолчанию));
    Возврат ?(ТипЗнч(Значение) = Тип("Строка"), Значение, ПоУмолчанию);
КонецФункции

#КонецОбласти

#Область Экранирование

// Экранирует имя по схеме Prometheus: underscores - недопустимые символы заменяются на "_" (имя
// классического формата не меняется); dots - "_" на "__", "." на "_dot_", прочие недопустимые на
// "__"; values - имя классического формата не меняется, иначе префикс "U__", "_" на "__",
// недопустимый символ на "_<код символа в hex>_"; allow-utf-8 - без изменений.
//
// Параметры:
//   Имя - Строка - имя
//   Экранирование - Строка - схема экранирования
//   ЭтоМетрика - Булево - имя метрики (двоеточие допустимо) или лейбла
//
// Возвращаемое значение:
//   Строка
//
Функция ЭкранироватьИмя(Имя, Экранирование, ЭтоМетрика)
    Если Экранирование = "allow-utf-8" Тогда
        Возврат Имя;
    КонецЕсли;
    Классическое = ИмяКлассическое(Имя, ЭтоМетрика);
    Если Классическое И Экранирование <> "dots" Тогда
        Возврат Имя;
    КонецЕсли;
    Части = Новый Массив();
    Если Экранирование = "values" Тогда
        Части.Добавить("U__");
    КонецЕсли;
    Позиция = 1;
    Пока Позиция <= СтрДлина(Имя) Цикл
        Символ = СимволИмени(Имя, Позиция);
        Экранированный = ЭкранированныйСимвол(Символ, Позиция = 1, Экранирование, ЭтоМетрика);
        Части.Добавить(Экранированный);
        Позиция = Позиция + СтрДлина(Символ);
    КонецЦикла;
    Возврат СтрСоединить(Части);
КонецФункции

// Коды символов UTF-16 и шестнадцатеричная запись
// BSLLS:MagicNumber-off

// Возвращает символ имени в позиции; символ вне BMP - суррогатной парой UTF-16 целиком.
//
// Параметры:
//   Имя - Строка - имя
//   Позиция - Число - позиция символа
//
// Возвращаемое значение:
//   Строка - один символ или суррогатная пара
//
Функция СимволИмени(Имя, Позиция)
    Если ЭтоСуррогатнаяПара(Имя, Позиция) Тогда
        Возврат Сред(Имя, Позиция, 2);
    КонецЕсли;
    Возврат Сред(Имя, Позиция, 1);
КонецФункции

// Экранирует один символ имени по схеме.
//
// Параметры:
//   Символ - Строка - символ (или суррогатная пара)
//   Первый - Булево - символ первый в имени: цифра в начале имени недопустима
//   Экранирование - Строка - схема экранирования
//   ЭтоМетрика - Булево - имя метрики (двоеточие допустимо) или лейбла
//
// Возвращаемое значение:
//   Строка
//
Функция ЭкранированныйСимвол(Символ, Первый, Экранирование, ЭтоМетрика)
    Если Экранирование = "underscores" Тогда
        Возврат ?(СимволКлассический(Символ, Первый, ЭтоМетрика), Символ, "_");
    КонецЕсли;
    Если Символ = "_" Тогда
        Возврат "__";
    КонецЕсли;
    Если Экранирование = "dots" И Символ = "." Тогда
        Возврат "_dot_";
    КонецЕсли;
    Если СимволКлассический(Символ, Первый, ЭтоМетрика) Тогда
        Возврат Символ;
    КонецЕсли;
    Возврат ?(Экранирование = "dots", "__", "_" + НРег(ЧислоВШестнадцатеричное(КодСимволаИмени(Символ))) + "_");
КонецФункции

Функция ИмяКлассическое(Имя, ЭтоМетрика)
    Если Имя = "" Тогда
        Возврат Ложь;
    КонецЕсли;
    Для Позиция = 1 По СтрДлина(Имя) Цикл
        Если НЕ СимволКлассический(Сред(Имя, Позиция, 1), Позиция = 1, ЭтоМетрика) Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

Функция СимволКлассический(Символ, Первый, ЭтоМетрика)
    Код = КодСимвола(Символ);
    Буква = (Код >= КодСимвола("a") И Код <= КодСимвола("z")) ИЛИ (Код >= КодСимвола("A") И Код <= КодСимвола("Z"));
    Цифра = Код >= КодСимвола("0") И Код <= КодСимвола("9");
    Возврат СтрДлина(Символ) = 1
        И (Буква ИЛИ Символ = "_" ИЛИ (ЭтоМетрика И Символ = ":") ИЛИ (Цифра И НЕ Первый));
КонецФункции

// Проверяет, что в позиции имени стоит суррогатная пара UTF-16: старший суррогат D800-DBFF и
// младший DC00-DFFF.
//
// Параметры:
//   Имя - Строка - имя
//   Позиция - Число - позиция старшего суррогата
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоСуррогатнаяПара(Имя, Позиция)
    Если Позиция >= СтрДлина(Имя) Тогда
        Возврат Ложь;
    КонецЕсли;
    Старший = КодСимвола(Имя, Позиция);
    Младший = КодСимвола(Имя, Позиция + 1);
    Возврат Старший >= 55296 И Старший <= 56319 И Младший >= 56320 И Младший <= 57343;
КонецФункции

// Возвращает код символа имени; у суррогатной пары - код символа вне BMP.
//
// Параметры:
//   Символ - Строка - символ или суррогатная пара
//
// Возвращаемое значение:
//   Число
//
Функция КодСимволаИмени(Символ)
    Если СтрДлина(Символ) = 1 Тогда
        Возврат КодСимвола(Символ);
    КонецЕсли;
    Возврат (КодСимвола(Символ, 1) - 55296) * 1024 + (КодСимвола(Символ, 2) - 56320) + 65536;
КонецФункции

Функция ЧислоВШестнадцатеричное(Число)
    Цифры = "0123456789ABCDEF";
    Остаток = Число;
    Результат = "";
    Пока Остаток > 0 Цикл
        Результат = Сред(Цифры, Остаток % 16 + 1, 1) + Результат;
        Остаток = Цел(Остаток / 16);
    КонецЦикла;
    Возврат ?(Результат = "", "0", Результат);
КонецФункции

#КонецОбласти

#КонецОбласти
