// Разрешение потоков метрики (metric streams) инструмента по спецификации OpenTelemetry
// Metrics SDK (Measurement processing): для каждого читателя (MetricReader) каждый
// совпавший View дает свой поток; без совпавших View - поток по умолчанию с агрегацией,
// лимитом мощности и резервуаром exemplars читателя и advisory-параметрами инструмента.

#Использовать logos

#Область ПрограммныйИнтерфейс

// Создает контекст разрешения потоков метра.
//
// Параметры:
//   Область - ОтелОбластьИнструментирования - область метра (критерии meter_* селекторов)
//
// Возвращаемое значение:
//   Структура - контекст:
//     * Представления - Массив из Соответствие - пары {Селектор, Представление} в порядке регистрации
//     * Читатели - Массив - читатели метрик провайдера; пустой - неявный конвейер метра
//     * АгрегацияГистограммПоУмолчанию - Строка - агрегация гистограмм неявного конвейера
//     * ЛимитМощности - Число - лимит мощности неявного конвейера
//     * ФильтрЭкземпляров - Число - фильтр exemplars из ОтелФильтрЭкземпляров
//     * Область - ОтелОбластьИнструментирования - область метра
//     * Лог - Объект - логгер
//
Функция НовыйКонтекст(Область) Экспорт
    ЛимитМощностиПоУмолчанию = 2000;
    Контекст = Новый Структура();
    Контекст.Вставить("Представления", Новый Массив());
    Контекст.Вставить("Читатели", Новый Массив());
    Контекст.Вставить("АгрегацияГистограммПоУмолчанию", "explicit_bucket_histogram");
    Контекст.Вставить("ЛимитМощности", ЛимитМощностиПоУмолчанию);
    Контекст.Вставить("ФильтрЭкземпляров", ОтелФильтрЭкземпляров.ПоТрассировке());
    Контекст.Вставить("Область", Область);
    Контекст.Вставить("Лог", Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics"));
    Возврат Контекст;
КонецФункции

// Создает дескриптор инструмента для разрешения потоков.
//
// Параметры:
//   Имя - Строка - имя инструмента (первой регистрации)
//   Описание - Строка - описание инструмента
//   ЕдиницаИзмерения - Строка - единица измерения
//   Вид - Строка - вид инструмента (Counter, Histogram, ObservableGauge, ...)
//   Совет - Структура, Неопределено - проверенные advisory-параметры
//   АгрегацияИнструмента - Строка, Соответствие, Неопределено - агрегация, заданная при создании
//       инструмента, вместо агрегации читателя по умолчанию (экспоненциальная гистограмма с
//       заданными бакетами)
//
// Возвращаемое значение:
//   Структура - дескриптор с полями параметров
//
// BSLLS:NumberOfOptionalParams-off
Функция НовыйДескриптор(Имя, Описание, ЕдиницаИзмерения, Вид, Совет = Неопределено,
        АгрегацияИнструмента = Неопределено) Экспорт
// BSLLS:NumberOfOptionalParams-on
    Дескриптор = Новый Структура();
    Дескриптор.Вставить("Имя", Имя);
    Дескриптор.Вставить("Описание", Описание);
    Дескриптор.Вставить("ЕдиницаИзмерения", ЕдиницаИзмерения);
    Дескриптор.Вставить("Вид", Вид);
    Дескриптор.Вставить("Совет", Совет);
    Дескриптор.Вставить("АгрегацияИнструмента", АгрегацияИнструмента);
    Возврат Дескриптор;
КонецФункции

// Создает запись хранилища потока инструмента.
//
// Параметры:
//   Хранилище - ОтелХранилищеМетрики, ОтелХранилищеНаблюдений - хранилище потока
//   Читатель - Объект, Неопределено - читатель потока; Неопределено - неявный конвейер
//   Поток - Структура, Неопределено - разрешенный поток (Представления, Подпись, Переименован);
//       Неопределено - поток без View
//
// Возвращаемое значение:
//   Структура - запись хранилища (см. СоздатьХранилища)
//
Функция НоваяЗаписьХранилища(Хранилище, Читатель = Неопределено, Поток = Неопределено) Экспорт
    Запись = Новый Структура("Читатель, Хранилище, Представления, Подпись, Переименован");
    Запись.Читатель = Читатель;
    Запись.Хранилище = Хранилище;
    Если Поток = Неопределено Тогда
        Запись.Представления = Новый Массив();
        Запись.Подпись = "";
        Запись.Переименован = Ложь;
    Иначе
        Запись.Представления = Поток.Представления;
        Запись.Подпись = Поток.Подпись;
        Запись.Переименован = Поток.Переименован;
    КонецЕсли;
    Возврат Запись;
КонецФункции

// Создает хранилища потоков инструмента для всех читателей контекста. Хранилище из
// текущих переиспользуется, если поток не изменился: тот же читатель, те же View и
// та же конфигурация - данные потока при повторном разрешении не теряются.
//
// Параметры:
//   Контекст - Структура - контекст (см. НовыйКонтекст)
//   Дескриптор - Структура - дескриптор инструмента (см. НовыйДескриптор)
//   Текущие - Массив из Структура, Неопределено - текущие записи хранилищ инструмента
//
// Возвращаемое значение:
//   Массив из Структура - записи хранилищ:
//     * Читатель - Объект, Неопределено - читатель потока; Неопределено - неявный конвейер
//     * Хранилище - ОтелХранилищеМетрики, ОтелХранилищеНаблюдений - хранилище потока
//     * Представления - Массив из ОтелПредставление - View потока
//     * Подпись - Строка - конфигурация потока для сравнения при повторном разрешении
//     * Переименован - Булево - имя потока задано View и отличается от имени инструмента
//
Функция СоздатьХранилища(Контекст, Дескриптор, Текущие = Неопределено) Экспорт
    Результат = Новый Массив();
    Совпавшие = СовпавшиеПредставления(Контекст, Дескриптор);
    Для Каждого Читатель Из КонвейерыКонтекста(Контекст) Цикл
        Для Каждого Поток Из ПотокиЧитателя(Контекст, Дескриптор, Читатель, Совпавшие) Цикл
            Запись = НайтиТекущуюЗапись(Текущие, Читатель, Поток);
            Если Запись = Неопределено Тогда
                Хранилище = СоздатьХранилище(Контекст, Дескриптор, Поток);
                Запись = НоваяЗаписьХранилища(Хранилище, Читатель, Поток);
            КонецЕсли;
            Результат.Добавить(Запись);
        КонецЦикла;
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Возвращает записи хранилищ читателя. Если у читателя нет своих потоков (метр создан
// без провайдера), возвращаются потоки без читателя.
//
// Параметры:
//   Записи - Массив из Структура - записи хранилищ инструмента
//   Читатель - Объект, Неопределено - читатель
//
// Возвращаемое значение:
//   Массив из Структура
//
Функция ХранилищаЧитателя(Записи, Читатель) Экспорт
    Свои = Новый Массив();
    БезЧитателя = Новый Массив();
    Для Каждого Запись Из Записи Цикл
        Если Запись.Читатель = Читатель Тогда
            Свои.Добавить(Запись);
        ИначеЕсли Запись.Читатель = Неопределено Тогда
            БезЧитателя.Добавить(Запись);
        Иначе // BSLLS:EmptyCodeBlock-off
            // поток другого читателя
        КонецЕсли;
    КонецЦикла;
    Возврат ?(Свои.Количество() > 0, Свои, БезЧитателя);
КонецФункции

// Возвращает временную агрегацию читателя для вида инструмента. Читатель без метода
// ВременнаяАгрегацияДляВида получает кумулятивную (значение по умолчанию спецификации).
//
// Параметры:
//   Читатель - Объект, Неопределено - читатель
//   Вид - Строка - вид инструмента
//
// Возвращаемое значение:
//   Число - значение из ОтелВременнаяАгрегация
//
Функция ВременнаяАгрегацияЧитателя(Читатель, Вид) Экспорт
    Если Читатель = Неопределено Тогда
        Возврат ОтелВременнаяАгрегация.Кумулятивная();
    КонецЕсли;
    Попытка
        Временность = Читатель.ВременнаяАгрегацияДляВида(Вид);
    Исключение
        Временность = Неопределено;
    КонецПопытки;
    Если Временность = ОтелВременнаяАгрегация.Дельта() Тогда
        Возврат Временность;
    КонецЕсли;
    Возврат ОтелВременнаяАгрегация.Кумулятивная();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КонвейерыКонтекста(Контекст)
    Если Контекст.Читатели.Количество() > 0 Тогда
        Возврат Контекст.Читатели;
    КонецЕсли;
    Неявный = Новый Массив();
    Неявный.Добавить(Неопределено);
    Возврат Неявный;
КонецФункции

Функция СовпавшиеПредставления(Контекст, Дескриптор)
    Результат = Новый Массив();
    Область = Контекст.Область;
    Для Каждого Пара Из Контекст.Представления Цикл
        Селектор = Пара.Получить("Селектор");
        Представление = Пара.Получить("Представление");
        Если Селектор = Неопределено ИЛИ Представление = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Если Селектор.Совпадает(Дескриптор.Имя, Дескриптор.Вид, Область.Имя(), Дескриптор.ЕдиницаИзмерения,
                Область.Версия(), Область.АдресСхемы()) Тогда
            Результат.Добавить(Представление);
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Возвращает потоки инструмента для одного читателя.
//
// Параметры:
//   Контекст - Структура - контекст
//   Дескриптор - Структура - дескриптор инструмента
//   Читатель - Объект, Неопределено - читатель
//   Совпавшие - Массив из ОтелПредставление - View, совпавшие с инструментом
//
// Возвращаемое значение:
//   Массив из Структура - потоки
//
Функция ПотокиЧитателя(Контекст, Дескриптор, Читатель, Совпавшие)
    Потоки = Новый Массив();
    Для Каждого Представление Из Совпавшие Цикл
        Поток = ПотокПредставления(Контекст, Дескриптор, Читатель, Представление);
        Если Поток <> Неопределено Тогда
            Потоки.Добавить(Поток);
        КонецЕсли;
    КонецЦикла;
    Если Потоки.Количество() = 0 Тогда
        Поток = НачальныйПоток(Дескриптор);
        ЗавершитьПоток(Контекст, Дескриптор, Читатель, Поток);
        Потоки.Добавить(Поток);
    КонецЕсли;
    Возврат Потоки;
КонецФункции

// Поток одного View. View, применение которого дает семантическую ошибку, пропускается
// целиком с предупреждением.
//
// Параметры:
//   Контекст - Структура - контекст
//   Дескриптор - Структура - дескриптор инструмента
//   Читатель - Объект, Неопределено - читатель
//   Представление - ОтелПредставление - View
//
// Возвращаемое значение:
//   Структура, Неопределено - поток; Неопределено - View пропущен
//
Функция ПотокПредставления(Контекст, Дескриптор, Читатель, Представление)
    Поток = НачальныйПоток(Дескриптор);
    Если НЕ ПрименитьАгрегацию(Контекст, Дескриптор, Поток, Представление) Тогда
        Возврат Неопределено;
    КонецЕсли;
    ПрименитьНастройкиПредставления(Контекст, Дескриптор, Поток, Представление);
    Поток.Разрешенные = Представление.РазрешенныеКлючиАтрибутов();
    Поток.Исключенные = Представление.ИсключенныеКлючиАтрибутов();
    ЗавершитьПоток(Контекст, Дескриптор, Читатель, Поток);
    Возврат Поток;
КонецФункции

Функция НачальныйПоток(Дескриптор)
    Поток = Новый Структура();
    Поток.Вставить("Имя", Дескриптор.Имя);
    Поток.Вставить("Описание", Дескриптор.Описание);
    Поток.Вставить("Переименован", Ложь);
    Поток.Вставить("Агрегация", Неопределено);
    Поток.Вставить("АгрегацияИзПредставления", Ложь);
    Поток.Вставить("ГраницыПредставления", Неопределено);
    Поток.Вставить("Разрешенные", Неопределено);
    Поток.Вставить("Исключенные", Неопределено);
    Поток.Вставить("ЛимитМощности", Неопределено);
    Поток.Вставить("ФабрикаРезервуаров", Неопределено);
    Поток.Вставить("Представления", Новый Массив());
    Поток.Вставить("Подпись", "");
    Возврат Поток;
КонецФункции

// Применяет агрегацию View к потоку. Неизвестная агрегация и агрегация, несовместимая
// с видом инструмента, - семантическая ошибка: пишется предупреждение, агрегация потока
// не меняется.
//
// Параметры:
//   Контекст - Структура - контекст
//   Дескриптор - Структура - дескриптор инструмента
//   Поток - Структура - поток
//   Представление - ОтелПредставление - View
//
// Возвращаемое значение:
//   Булево - Ложь при семантической ошибке
//
Функция ПрименитьАгрегацию(Контекст, Дескриптор, Поток, Представление)
    Конфигурация = Представление.Агрегация();
    Если Конфигурация = Неопределено Тогда
        Возврат Истина;
    КонецЕсли;
    Агрегация = ОтелАгрегация.Нормализовать(Конфигурация);
    Если Агрегация = Неопределено Тогда
        ПредставлениеАгрегации = Строка(Конфигурация);
        Сообщение = СтрШаблон(
            "View задает неизвестную агрегацию '%1' для инструмента '%2' (семантическая ошибка):"
            + " агрегация View не применяется", ПредставлениеАгрегации, Дескриптор.Имя);
        Контекст.Лог.Предупреждение(Сообщение);
        Возврат Ложь;
    КонецЕсли;
    Если НЕ ОтелАгрегация.СовместимаСВидом(Агрегация, Дескриптор.Вид) Тогда
        Сообщение = СтрШаблон(
            "View задает агрегацию '%1', несовместимую с инструментом '%2' вида %3 (семантическая"
            + " ошибка): агрегация View не применяется", Агрегация.Тип, Дескриптор.Имя, Дескриптор.Вид);
        Контекст.Лог.Предупреждение(Сообщение);
        Возврат Ложь;
    КонецЕсли;
    Если Агрегация.Тип <> ОтелАгрегация.ПоУмолчанию() Тогда
        Поток.Агрегация = Агрегация;
        Поток.АгрегацияИзПредставления = Истина;
    КонецЕсли;
    Возврат Истина;
КонецФункции

// Применяет имя, описание, границы гистограммы, лимит мощности и резервуар View.
// Резервуар, который не является фабрикой, отклоняется с ошибкой: резервуар
// создается на каждую серию.
//
// Параметры:
//   Контекст - Структура - контекст
//   Дескриптор - Структура - дескриптор инструмента
//   Поток - Структура - поток
//   Представление - ОтелПредставление - View
//
Процедура ПрименитьНастройкиПредставления(Контекст, Дескриптор, Поток, Представление)
    Поток.Представления.Добавить(Представление);
    Если Представление.НовоеИмя() <> Неопределено Тогда
        Поток.Имя = Представление.НовоеИмя();
        Поток.Переименован = НРег(Поток.Имя) <> НРег(Дескриптор.Имя);
    КонецЕсли;
    Если Представление.НовоеОписание() <> Неопределено Тогда
        Поток.Описание = Представление.НовоеОписание();
    КонецЕсли;
    Если Представление.ГраницыГистограммы() <> Неопределено Тогда
        Поток.ГраницыПредставления = Представление.ГраницыГистограммы();
    КонецЕсли;
    Если Представление.ЛимитМощностиАгрегации() <> Неопределено Тогда
        Поток.ЛимитМощности = Представление.ЛимитМощностиАгрегации();
    КонецЕсли;
    Резервуар = Представление.РезервуарЭкземпляров();
    Если Резервуар = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Если ЭтоФабрикаРезервуаров(Резервуар) Тогда
        Поток.ФабрикаРезервуаров = Резервуар;
    Иначе
        Сообщение = СтрШаблон(
            "Резервуар exemplars View для инструмента '%1' не является фабрикой (нет метода"
            + " СоздатьРезервуар): резервуар создается на каждую серию, используется резервуар"
            + " по умолчанию", Дескриптор.Имя);
        Контекст.Лог.Ошибка(Сообщение);
    КонецЕсли;
КонецПроцедуры

// Заполняет аспекты потока, не заданные View: агрегацию читателя по виду инструмента,
// границы из advisory-параметров, лимит мощности читателя и резервуар exemplars по умолчанию
// для агрегации.
//
// Параметры:
//   Контекст - Структура - контекст
//   Дескриптор - Структура - дескриптор инструмента
//   Читатель - Объект, Неопределено - читатель
//   Поток - Структура - поток
//
Процедура ЗавершитьПоток(Контекст, Дескриптор, Читатель, Поток)
    Если Поток.Агрегация = Неопределено Тогда
        Поток.Агрегация = АгрегацияЧитателя(Контекст, Дескриптор, Читатель);
    КонецЕсли;
    Поток.Агрегация = ОтелАгрегация.РазрешитьПоУмолчанию(Поток.Агрегация, Дескриптор.Вид);
    Если Поток.Агрегация.Тип = "explicit_bucket_histogram" И Поток.Агрегация.Границы = Неопределено Тогда
        Поток.Агрегация = КопияАгрегации(Поток.Агрегация);
        Поток.Агрегация.Границы = ГраницыПотока(Поток, Дескриптор);
    КонецЕсли;
    Если Поток.ЛимитМощности = Неопределено Тогда
        Поток.ЛимитМощности = ЛимитМощностиЧитателя(Контекст, Читатель, Дескриптор.Вид);
    КонецЕсли;
    Поток.Подпись = ПодписьПотока(Поток);
КонецПроцедуры

// Возвращает границы явной гистограммы потока без заданных агрегацией границ: границы View;
// иначе advisory-границы, если агрегацию задал не View (агрегация View их не использует).
//
// Параметры:
//   Поток - Структура - поток
//   Дескриптор - Структура - дескриптор инструмента
//
// Возвращаемое значение:
//   Массив из Число, Неопределено - границы; Неопределено - границы по умолчанию
//
Функция ГраницыПотока(Поток, Дескриптор)
    Если Поток.ГраницыПредставления <> Неопределено Тогда
        Возврат Поток.ГраницыПредставления;
    КонецЕсли;
    Если Поток.АгрегацияИзПредставления Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат ЗначениеСовета(Дескриптор, "ГраницыГистограммы");
КонецФункции

// Возвращает агрегацию читателя по умолчанию для вида инструмента. Агрегация, заданная при
// создании инструмента, имеет приоритет. Неявный конвейер берет агрегацию гистограмм из контекста.
//
// Параметры:
//   Контекст - Структура - контекст
//   Дескриптор - Структура - дескриптор инструмента
//   Читатель - Объект, Неопределено - читатель
//
// Возвращаемое значение:
//   Структура - нормализованная агрегация
//
Функция АгрегацияЧитателя(Контекст, Дескриптор, Читатель)
    Если Дескриптор.АгрегацияИнструмента <> Неопределено Тогда
        АгрегацияИнструмента = ОтелАгрегация.Нормализовать(Дескриптор.АгрегацияИнструмента);
        Если АгрегацияИнструмента <> Неопределено Тогда
            Возврат АгрегацияИнструмента;
        КонецЕсли;
    КонецЕсли;
    Конфигурация = Неопределено;
    Если Читатель = Неопределено Тогда
        Если Дескриптор.Вид = "Histogram" Тогда
            Конфигурация = Контекст.АгрегацияГистограммПоУмолчанию;
        КонецЕсли;
    Иначе
        Попытка
            Конфигурация = Читатель.АгрегацияПоУмолчанию(Дескриптор.Вид);
        Исключение
            Конфигурация = Неопределено;
        КонецПопытки;
    КонецЕсли;
    Агрегация = ОтелАгрегация.Нормализовать(Конфигурация);
    Если Агрегация = Неопределено ИЛИ НЕ ОтелАгрегация.СовместимаСВидом(Агрегация, Дескриптор.Вид) Тогда
        ПредставлениеАгрегации = Строка(Конфигурация);
        Сообщение = СтрШаблон("Агрегация читателя '%1' для вида %2 не применима, используется"
            + " агрегация по умолчанию", ПредставлениеАгрегации, Дескриптор.Вид);
        Контекст.Лог.Предупреждение(Сообщение);
        Возврат ОтелАгрегация.Нормализовать(Неопределено);
    КонецЕсли;
    Возврат Агрегация;
КонецФункции

// Возвращает лимит мощности читателя для вида инструмента.
//
// Параметры:
//   Контекст - Структура - контекст
//   Читатель - Объект, Неопределено - читатель
//   Вид - Строка - вид инструмента
//
// Возвращаемое значение:
//   Число
//
Функция ЛимитМощностиЧитателя(Контекст, Читатель, Вид)
    Если Читатель = Неопределено Тогда
        Возврат Контекст.ЛимитМощности;
    КонецЕсли;
    Попытка
        Возврат Читатель.ЛимитМощностиДляВида(Вид);
    Исключение
        Попытка
            Возврат Читатель.ЛимитМощности();
        Исключение
            Возврат Контекст.ЛимитМощности;
        КонецПопытки;
    КонецПопытки;
КонецФункции

Функция СоздатьХранилище(Контекст, Дескриптор, Поток)
    Агрегатор = ОтелАгрегация.СоздатьАгрегаторПотока(Поток.Агрегация, Дескриптор.Вид);
    Если ОтелАгрегация.ЭтоАсинхронныйВид(Дескриптор.Вид) Тогда
        Хранилище = Новый ОтелХранилищеНаблюдений(Поток.Имя, Поток.Описание, Дескриптор.ЕдиницаИзмерения,
            Агрегатор, Дескриптор.Вид);
    Иначе
        Хранилище = Новый ОтелХранилищеМетрики(Поток.Имя, Поток.Описание, Дескриптор.ЕдиницаИзмерения,
            Агрегатор, Дескриптор.Вид);
    КонецЕсли;
    Хранилище.УстановитьЛимитМощности(Поток.ЛимитМощности);
    Хранилище.УстановитьФильтрАтрибутов(Поток.Разрешенные, Поток.Исключенные);
    Хранилище.УстановитьФильтрЭкземпляров(Контекст.ФильтрЭкземпляров);
    Фабрика = Поток.ФабрикаРезервуаров;
    Если Фабрика = Неопределено Тогда
        Фабрика = ОтелАгрегация.ФабрикаРезервуаровПоУмолчанию(Поток.Агрегация, Агрегатор);
    КонецЕсли;
    Хранилище.УстановитьФабрикуРезервуаров(Фабрика);
    Возврат Хранилище;
КонецФункции

Функция НайтиТекущуюЗапись(Текущие, Читатель, Поток)
    Если Текущие = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Для Каждого Запись Из Текущие Цикл
        Если Запись.Читатель = Читатель И Запись.Подпись = Поток.Подпись
                И ТеЖеПредставления(Запись.Представления, Поток.Представления) Тогда
            Возврат Запись;
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

Функция ТеЖеПредставления(Первые, Вторые)
    Если Первые.Количество() <> Вторые.Количество() Тогда
        Возврат Ложь;
    КонецЕсли;
    Для Индекс = 0 По Первые.ВГраница() Цикл
        Если Первые[Индекс] <> Вторые[Индекс] Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

Функция ПодписьПотока(Поток)
    Части = Новый Массив();
    Части.Добавить(Поток.Имя);
    Части.Добавить(Поток.Описание);
    Части.Добавить(Поток.Агрегация.Тип);
    Части.Добавить(СписокВСтроку(Поток.Агрегация.Границы));
    ФорматЧисла = "ЧГ=; ЧН=0";
    Части.Добавить(Формат(Поток.Агрегация.МаксБакетов, ФорматЧисла));
    Части.Добавить(Формат(Поток.Агрегация.МаксШкала, ФорматЧисла));
    Части.Добавить(Строка(Поток.Агрегация.ЗаписыватьМинМакс));
    Части.Добавить(СписокВСтроку(Поток.Разрешенные));
    Части.Добавить(СписокВСтроку(Поток.Исключенные));
    Части.Добавить(Формат(Поток.ЛимитМощности, ФорматЧисла));
    Возврат СтрСоединить(Части, "|");
КонецФункции

Функция СписокВСтроку(Значения)
    Если Значения = Неопределено Тогда
        Возврат "-";
    КонецЕсли;
    Части = Новый Массив();
    Для Каждого Значение Из Значения Цикл
        Части.Добавить(Строка(Значение));
    КонецЦикла;
    Возврат "[" + СтрСоединить(Части, ",") + "]";
КонецФункции

Функция ЗначениеСовета(Дескриптор, Имя)
    Совет = Дескриптор.Совет;
    Если ТипЗнч(Совет) <> Тип("Структура") Тогда
        Возврат Неопределено;
    КонецЕсли;
    Значение = Неопределено;
    Совет.Свойство(Имя, Значение);
    Возврат Значение;
КонецФункции

Функция КопияАгрегации(Агрегация)
    Копия = Новый Структура();
    Для Каждого КлючИЗначение Из Агрегация Цикл
        Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
    КонецЦикла;
    Возврат Копия;
КонецФункции

Функция ЭтоФабрикаРезервуаров(Объект)
    Попытка
        Объект.СоздатьРезервуар();
        Возврат Истина;
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

#КонецОбласти
