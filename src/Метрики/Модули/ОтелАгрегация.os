// Модуль стратегий агрегации (Aggregation) по спецификации OpenTelemetry.
// Аналог Java SDK: io.opentelemetry.sdk.metrics.Aggregation
//
// Определяет, как измерения агрегируются в метрики.
// Используется в ОтелПредставление для переопределения стратегии агрегации.

#Область ПрограммныйИнтерфейс

// Возвращает агрегацию по умолчанию для инструмента.
// Аналог Java SDK: Aggregation.defaultAggregation()
//
// Возвращаемое значение:
//   Строка - "default"
//
Функция ПоУмолчанию() Экспорт
    Возврат "default";
КонецФункции

// Возвращает агрегацию суммирования.
// Аналог Java SDK: Aggregation.sum()
//
// Возвращаемое значение:
//   Строка - "sum"
//
Функция Сумма() Экспорт
    Возврат "sum";
КонецФункции

// Возвращает агрегацию последнего значения.
// Аналог Java SDK: Aggregation.lastValue()
//
// Возвращаемое значение:
//   Строка - "last_value"
//
Функция ПоследнееЗначение() Экспорт
    Возврат "last_value";
КонецФункции

// Возвращает агрегацию, которая отбрасывает все измерения.
// Аналог Java SDK: Aggregation.drop()
//
// Возвращаемое значение:
//   Строка - "drop"
//
Функция Отбросить() Экспорт
    Возврат "drop";
КонецФункции

// Возвращает агрегацию гистограммы с явными границами бакетов.
// Аналог Java SDK: Aggregation.explicitBucketHistogram(bucketBoundaries)
//
// Параметры:
//   Границы - Массив из Число - границы бакетов (необязательный)
//
// Возвращаемое значение:
//   Соответствие - {Тип: "explicit_bucket_histogram", Границы: Массив}
//
Функция ГистограммаСЯвнымиГраницами(Границы = Неопределено) Экспорт
    Результат = Новый Соответствие();
    Результат.Вставить("Тип", "explicit_bucket_histogram");
    Если Границы <> Неопределено Тогда
        Результат.Вставить("Границы", Границы);
    КонецЕсли;
    Возврат Результат;
КонецФункции

// Возвращает агрегацию экспоненциальной гистограммы с логарифмическими бакетами.
// Аналог Java SDK: Aggregation.base2ExponentialBucketHistogram(maxBuckets, maxScale)
//
// Параметры:
//   МаксБакетов - Число - максимальное количество бакетов (по умолчанию 160)
//
// Возвращаемое значение:
//   Соответствие - {Тип: "exponential_histogram", МаксБакетов: Число}
//
Функция ГистограммаЭкспоненциальная(МаксБакетов = 160) Экспорт
    Результат = Новый Соответствие();
    Результат.Вставить("Тип", "exponential_histogram");
    Результат.Вставить("МаксБакетов", МаксБакетов);
    Возврат Результат;
КонецФункции

// Создает агрегатор на основе параметров конфигурации из View.
// Используется в ОтелМетр при создании инструментов для применения агрегации из View.
//
// Параметры:
//   Параметры - Строка, Соответствие - конфигурация агрегации из ОтелАгрегация:
//       "sum"           → ОтелАгрегаторСуммы
//       "last_value"    → ОтелАгрегаторПоследнегоЗначения
//       "drop"          → ОтелАгрегаторDrop
//       "default"       → Неопределено (использовать дефолт инструмента)
//       Соответствие{Тип: "explicit_bucket_histogram", Границы: Массив}
//                       → ОтелАгрегаторГистограммы(Границы)
//       Соответствие{Тип: "exponential_histogram", МаксБакетов: Число}
//                       → ОтелАгрегаторЭкспоненциальнойГистограммы(МаксБакетов)
//   АгрегаторБаза - ОтелБазовыйАгрегатор - базовый агрегатор с метаданными инструмента
//
// Возвращаемое значение:
//   Объект - построенный агрегатор через ПостроительНаследника
//   Неопределено - если Параметры = "default" или Неопределено (вызывающий использует дефолт)
//
// BSLLS:MagicNumber-off
Функция СоздатьАгрегаторИзКонфигурации(Параметры, АгрегаторБаза) Экспорт

    Если Параметры = Неопределено ИЛИ Параметры = "default" Тогда
        Возврат Неопределено;
    КонецЕсли;

    // Тип точек определяет агрегация, а не вид инструмента: гистограмма с агрегацией Sum
    // дает точки суммы, счетчик с LastValue - датчика. Иначе экспортер сериализует точки
    // по типу инструмента и не находит в них нужных полей
    Если Параметры = "sum" Тогда
        Возврат Новый ПостроительНаследника(Новый ОтелАгрегаторСуммы(),
            БазаДляТипа(АгрегаторБаза, ОтелТипМетрики.Сумма(), СуммаМонотонна(АгрегаторБаза))).Построить();
    КонецЕсли;

    Если Параметры = "last_value" Тогда
        Возврат Новый ПостроительНаследника(Новый ОтелАгрегаторПоследнегоЗначения(),
            БазаДляТипа(АгрегаторБаза, ОтелТипМетрики.Датчик(), Ложь)).Построить();
    КонецЕсли;

    Если Параметры = "drop" Тогда
        Возврат Новый ПостроительНаследника(
            Новый ОтелАгрегаторDrop(), АгрегаторБаза).Построить();
    КонецЕсли;

    Если ТипЗнч(Параметры) = Тип("Соответствие") Тогда
        Возврат СоздатьАгрегаторГистограммы(Параметры, АгрегаторБаза);
    КонецЕсли;

    // Неизвестный тип агрегации - возвращаем Неопределено, вызывающий использует дефолт
    Возврат Неопределено;

КонецФункции
// BSLLS:MagicNumber-on

// Приводит конфигурацию агрегации (строку или Соответствие из функций модуля) к одному
// виду. Строки читателя "explicit_bucket_histogram" и "base2_exponential_bucket_histogram"
// равнозначны конфигурациям гистограмм без параметров.
//
// Параметры:
//   Агрегация - Строка, Соответствие, Структура, Неопределено - конфигурация агрегации;
//       Неопределено - агрегация по умолчанию
//
// Возвращаемое значение:
//   Структура, Неопределено - Неопределено для неизвестной или некорректной конфигурации:
//     * Тип - Строка - default, sum, last_value, drop, explicit_bucket_histogram,
//         base2_exponential_bucket_histogram
//     * Границы - Массив из Число, Неопределено - границы явной гистограммы
//     * МаксБакетов - Число - максимум бакетов экспоненциальной гистограммы
//     * МаксШкала - Число - максимальная шкала экспоненциальной гистограммы
//
Функция Нормализовать(Агрегация) Экспорт
    Если Агрегация = Неопределено Тогда
        Возврат НоваяАгрегация(ПоУмолчанию());
    КонецЕсли;
    Если ТипЗнч(Агрегация) = Тип("Структура") Тогда
        Возврат ?(Агрегация.Свойство("Тип"), Агрегация, Неопределено);
    КонецЕсли;
    Если ТипЗнч(Агрегация) = Тип("Строка") Тогда
        ТипАгрегации = ТипАгрегацииИзИмени(Агрегация);
        Возврат ?(ТипАгрегации = Неопределено, Неопределено, НоваяАгрегация(ТипАгрегации));
    КонецЕсли;
    Если ТипЗнч(Агрегация) = Тип("Соответствие") Тогда
        Возврат НормализоватьСоответствие(Агрегация);
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

// Возвращает агрегацию с конкретным типом: агрегация по умолчанию заменяется агрегацией
// вида инструмента (спецификация Metrics SDK, Default Aggregation).
//
// Параметры:
//   Агрегация - Структура - нормализованная агрегация
//   Вид - Строка - вид инструмента
//
// Возвращаемое значение:
//   Структура - нормализованная агрегация с конкретным типом
//
Функция РазрешитьПоУмолчанию(Агрегация, Вид) Экспорт
    Если Агрегация.Тип <> ПоУмолчанию() Тогда
        Возврат Агрегация;
    КонецЕсли;
    Результат = НоваяАгрегация(ТипАгрегацииДляВида(Вид));
    Результат.Границы = Агрегация.Границы;
    Возврат Результат;
КонецФункции

// Проверяет, что агрегацию можно применить к виду инструмента без семантической ошибки:
// гистограммные агрегации не применяются к асинхронным инструментам.
//
// Параметры:
//   Агрегация - Структура - нормализованная агрегация
//   Вид - Строка - вид инструмента
//
// Возвращаемое значение:
//   Булево
//
Функция СовместимаСВидом(Агрегация, Вид) Экспорт
    ЭтоГистограмма = Агрегация.Тип = ЯвнаяГистограмма() ИЛИ Агрегация.Тип = ЭкспоненциальнаяГистограмма();
    Возврат НЕ (ЭтоГистограмма И ЭтоАсинхронныйВид(Вид));
КонецФункции

// Создает агрегатор потока по нормализованной агрегации и виду инструмента: вид задает
// монотонность суммы, тип значения и сбор sum гистограмм (sum не собирается для
// инструментов, записывающих отрицательные значения).
//
// Параметры:
//   Агрегация - Структура - нормализованная агрегация
//   Вид - Строка - вид инструмента
//
// Возвращаемое значение:
//   Объект - агрегатор
//
Функция СоздатьАгрегаторПотока(Агрегация, Вид) Экспорт
    Конкретная = РазрешитьПоУмолчанию(Агрегация, Вид);
    ТипЗначения = ТипЗначенияДляВида(Вид);
    СобиратьSum = НЕ ЗаписываетОтрицательные(Вид);
    Если Конкретная.Тип = Сумма() Тогда
        База = Новый ОтелБазовыйАгрегатор(ОтелТипМетрики.Сумма(), НЕ ЗаписываетОтрицательные(Вид), ТипЗначения);
        Возврат Новый ПостроительНаследника(Новый ОтелАгрегаторСуммы(), База).Построить();
    КонецЕсли;
    Если Конкретная.Тип = ПоследнееЗначение() Тогда
        База = Новый ОтелБазовыйАгрегатор(ОтелТипМетрики.Датчик(), Ложь, ТипЗначения);
        Возврат Новый ПостроительНаследника(Новый ОтелАгрегаторПоследнегоЗначения(), База).Построить();
    КонецЕсли;
    Если Конкретная.Тип = ЯвнаяГистограмма() Тогда
        База = Новый ОтелБазовыйАгрегатор(ОтелТипМетрики.Гистограмма(), Ложь, "double");
        Агрегатор = Новый ОтелАгрегаторГистограммы(Конкретная.Границы, СобиратьSum);
        Возврат Новый ПостроительНаследника(Агрегатор, База).Построить();
    КонецЕсли;
    Если Конкретная.Тип = ЭкспоненциальнаяГистограмма() Тогда
        База = Новый ОтелБазовыйАгрегатор(ОтелТипМетрики.ЭкспоненциальнаяГистограмма(), Ложь, "double");
        Агрегатор = Новый ОтелАгрегаторЭкспоненциальнойГистограммы(
            Конкретная.МаксБакетов, Конкретная.МаксШкала, 0, СобиратьSum);
        Возврат Новый ПостроительНаследника(Агрегатор, База).Построить();
    КонецЕсли;
    База = Новый ОтелБазовыйАгрегатор(ОтелТипМетрики.Сумма(), Ложь, ТипЗначения);
    Возврат Новый ПостроительНаследника(Новый ОтелАгрегаторDrop(), База).Построить();
КонецФункции

// Возвращает фабрику резервуаров exemplars по умолчанию для агрегации (спецификация
// Metrics SDK, Exemplar defaults): явной гистограмме из нескольких бакетов - резервуар,
// выровненный по бакетам; экспоненциальной - простой размера min(20, МаксБакетов);
// остальным - простой размера 1; Drop - без резервуара.
//
// Параметры:
//   Агрегация - Структура - нормализованная агрегация с конкретным типом
//   Агрегатор - Объект - агрегатор потока (границы явной гистограммы после нормализации)
//
// Возвращаемое значение:
//   Объект, Неопределено - фабрика резервуаров
//
Функция ФабрикаРезервуаровПоУмолчанию(Агрегация, Агрегатор) Экспорт
    МаксРазмерЭкспоненциальной = 20;
    Если Агрегация.Тип = Отбросить() Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если Агрегация.Тип = ЯвнаяГистограмма() И Агрегатор.Границы().Количество() > 0 Тогда
        Возврат Новый ОтелФабрикаВыровненныхРезервуаровГистограммы(Агрегатор.Границы());
    КонецЕсли;
    Если Агрегация.Тип = ЭкспоненциальнаяГистограмма() Тогда
        Возврат Новый ОтелФабрикаПростыхРезервуаров(Мин(МаксРазмерЭкспоненциальной, Агрегация.МаксБакетов));
    КонецЕсли;
    Возврат Новый ОтелФабрикаПростыхРезервуаров(1);
КонецФункции

// Проверяет, что инструмент вида может записывать отрицательные значения.
//
// Параметры:
//   Вид - Строка - вид инструмента
//
// Возвращаемое значение:
//   Булево
//
Функция ЗаписываетОтрицательные(Вид) Экспорт
    Возврат Вид = "UpDownCounter" ИЛИ Вид = "Gauge"
        ИЛИ Вид = "ObservableUpDownCounter" ИЛИ Вид = "ObservableGauge";
КонецФункции

// Проверяет, что вид инструмента асинхронный.
//
// Параметры:
//   Вид - Строка - вид инструмента
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоАсинхронныйВид(Вид) Экспорт
    Возврат Вид = "ObservableCounter" ИЛИ Вид = "ObservableUpDownCounter" ИЛИ Вид = "ObservableGauge";
КонецФункции

// Проверяет, что агрегатор отбрасывает измерения (агрегация Drop). Агрегатор, не
// унаследованный от ОтелБазовыйАгрегатор, считается не отбрасывающим.
//
// Параметры:
//   Агрегатор - Объект - агрегатор потока
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоАгрегаторОтбрасывания(Агрегатор) Экспорт
    Попытка
        Возврат Агрегатор.ЭтоОтбрасывание() = Истина;
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЯвнаяГистограмма()
    Возврат "explicit_bucket_histogram";
КонецФункции

Функция ЭкспоненциальнаяГистограмма()
    Возврат "base2_exponential_bucket_histogram";
КонецФункции

Функция НоваяАгрегация(ТипАгрегации)
    Агрегация = Новый Структура("Тип, Границы, МаксБакетов, МаксШкала");
    Агрегация.Тип = ТипАгрегации;
    // BSLLS:MagicNumber-off - значения по умолчанию спецификации: 160 бакетов, шкала 20
    Агрегация.МаксБакетов = 160;
    Агрегация.МаксШкала = 20;
    // BSLLS:MagicNumber-on
    Возврат Агрегация;
КонецФункции

// Нормализует агрегацию, заданную Соответствием (формат ОтелАгрегация).
//
// Параметры:
//   Агрегация - Соответствие - конфигурация агрегации
//
// Возвращаемое значение:
//   Структура, Неопределено - см. Нормализовать
//
Функция НормализоватьСоответствие(Агрегация)
    ТипАгрегации = ТипАгрегацииИзИмени(Агрегация.Получить("Тип"));
    Если ТипАгрегации = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Результат = НоваяАгрегация(ТипАгрегации);
    Если ТипАгрегации = ЯвнаяГистограмма() Тогда
        Результат.Границы = Агрегация.Получить("Границы");
        Возврат ?(ГраницыКорректны(Результат.Границы), Результат, Неопределено);
    КонецЕсли;
    Если ТипАгрегации = ЭкспоненциальнаяГистограмма() Тогда
        ЗаполнитьПараметрыЭкспоненциальной(Результат, Агрегация);
        ПараметрыКорректны = Результат.МаксБакетов > 0 И Результат.МаксШкала >= -10;
        Возврат ?(ПараметрыКорректны, Результат, Неопределено);
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ТипАгрегацииИзИмени(Имя)
    Если ТипЗнч(Имя) <> Тип("Строка") Тогда
        Возврат Неопределено;
    КонецЕсли;
    ТипБезПараметров = Имя = ПоУмолчанию() ИЛИ Имя = Сумма() ИЛИ Имя = ПоследнееЗначение() ИЛИ Имя = Отбросить();
    Если ТипБезПараметров ИЛИ Имя = ЯвнаяГистограмма() Тогда
        Возврат Имя;
    КонецЕсли;
    Если Имя = ЭкспоненциальнаяГистограмма() ИЛИ Имя = "exponential_histogram" Тогда
        Возврат ЭкспоненциальнаяГистограмма();
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

Функция ГраницыКорректны(Границы)
    Если Границы = Неопределено Тогда
        Возврат Истина;
    КонецЕсли;
    Если ТипЗнч(Границы) <> Тип("Массив") Тогда
        Возврат Ложь;
    КонецЕсли;
    Для Каждого Граница Из Границы Цикл
        Если ТипЗнч(Граница) <> Тип("Число") Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

Процедура ЗаполнитьПараметрыЭкспоненциальной(Результат, Агрегация)
    МаксБакетов = Агрегация.Получить("МаксБакетов");
    Если МаксБакетов <> Неопределено Тогда
        Результат.МаксБакетов = ?(ТипЗнч(МаксБакетов) = Тип("Число"), МаксБакетов, 0);
    КонецЕсли;
    МаксШкала = Агрегация.Получить("МаксШкала");
    Если МаксШкала <> Неопределено Тогда
        Результат.МаксШкала = ?(ТипЗнч(МаксШкала) = Тип("Число"), МаксШкала, -100);
    КонецЕсли;
КонецПроцедуры

// Возвращает тип агрегации по умолчанию для вида инструмента.
//
// Параметры:
//   Вид - Строка - вид инструмента
//
// Возвращаемое значение:
//   Строка
//
Функция ТипАгрегацииДляВида(Вид)
    Если Вид = "Gauge" ИЛИ Вид = "ObservableGauge" Тогда
        Возврат ПоследнееЗначение();
    КонецЕсли;
    Если Вид = "Histogram" Тогда
        Возврат ЯвнаяГистограмма();
    КонецЕсли;
    Если Вид = "ExponentialHistogram" Тогда
        Возврат ЭкспоненциальнаяГистограмма();
    КонецЕсли;
    Возврат Сумма();
КонецФункции

Функция ТипЗначенияДляВида(Вид)
    СинхронныйСчетчик = Вид = "Counter" ИЛИ Вид = "UpDownCounter";
    АсинхронныйСчетчик = Вид = "ObservableCounter" ИЛИ Вид = "ObservableUpDownCounter";
    Возврат ?(СинхронныйСчетчик ИЛИ АсинхронныйСчетчик, "int", "double");
КонецФункции

// Создает агрегатор явной или экспоненциальной гистограммы по конфигурации из View.
//
// Параметры:
//   Параметры - Соответствие - {Тип, Границы} или {Тип, МаксБакетов}
//   АгрегаторБаза - ОтелБазовыйАгрегатор - базовый агрегатор инструмента
//
// Возвращаемое значение:
//   Объект - агрегатор или Неопределено для неизвестного типа
//
Функция СоздатьАгрегаторГистограммы(Параметры, АгрегаторБаза)
    ТипАгрегации = Параметры.Получить("Тип");

    Если ТипАгрегации = "explicit_bucket_histogram" Тогда
        Границы = Параметры.Получить("Границы");
        НеМонотонноеСумма = (АгрегаторБаза.ТипМетрики() = ОтелТипМетрики.Сумма())
            И НЕ АгрегаторБаза.Монотонный();
        Возврат Новый ПостроительНаследника(
            Новый ОтелАгрегаторГистограммы(Границы, НЕ НеМонотонноеСумма),
            БазаДляТипа(АгрегаторБаза, ОтелТипМетрики.Гистограмма(), Ложь)).Построить();
    КонецЕсли;

    Если ТипАгрегации = "exponential_histogram" Тогда
        МаксБакетов = Параметры.Получить("МаксБакетов");
        Если МаксБакетов = Неопределено Тогда
            МаксБакетов = 160; // BSLLS:MagicNumber-off
        КонецЕсли;
        Возврат Новый ПостроительНаследника(
            Новый ОтелАгрегаторЭкспоненциальнойГистограммы(МаксБакетов),
            БазаДляТипа(АгрегаторБаза, ОтелТипМетрики.ЭкспоненциальнаяГистограмма(), Ложь)).Построить();
    КонецЕсли;

    Возврат Неопределено;
КонецФункции

// Сумма значений Counter и Histogram монотонна: их значения неотрицательны.
//
// Параметры:
//   АгрегаторБаза - ОтелБазовыйАгрегатор - базовый агрегатор инструмента
//
// Возвращаемое значение:
//   Булево
//
Функция СуммаМонотонна(АгрегаторБаза)
    ТипМетрики = АгрегаторБаза.ТипМетрики();
    Возврат ТипМетрики = ОтелТипМетрики.Гистограмма()
        ИЛИ (ТипМетрики = ОтелТипМетрики.Сумма() И АгрегаторБаза.Монотонный());
КонецФункции

// Возвращает базовый агрегатор с типом метрики агрегации. Если тип совпадает с типом
// инструмента, возвращается исходный базовый агрегатор.
//
// Параметры:
//   АгрегаторБаза - ОтелБазовыйАгрегатор - базовый агрегатор инструмента
//   ТипМетрики - Строка - тип метрики из ОтелТипМетрики, который дает агрегация
//   Монотонный - Булево - монотонность для нового типа
//
// Возвращаемое значение:
//   ОтелБазовыйАгрегатор
//
Функция БазаДляТипа(АгрегаторБаза, ТипМетрики, Монотонный)
    Если АгрегаторБаза.ТипМетрики() = ТипМетрики Тогда
        Возврат АгрегаторБаза;
    КонецЕсли;
    Возврат Новый ОтелБазовыйАгрегатор(ТипМетрики, Монотонный, АгрегаторБаза.ТипЗначения());
КонецФункции

#КонецОбласти
