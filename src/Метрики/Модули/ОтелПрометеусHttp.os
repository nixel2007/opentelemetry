// HTTP-сервер Prometheus-экспортера (ОтелПрометеусЧитательМетрик.ЗапуститьСервер): разбор
// запроса, формирование ответа и ограничение клиентов хостом.

#Область ПрограммныйИнтерфейс

// Разбирает HTTP-запрос: строку запроса и заголовки. Повторяющиеся заголовки объединяются через
// запятую (RFC 9110).
//
// Параметры:
//   Текст - Строка - текст запроса: строка запроса и заголовки
//
// Возвращаемое значение:
//   Структура - запрос:
//     * Метод - Строка - метод в верхнем регистре (GET, HEAD, ...); пустой, если строка запроса не разобрана
//     * Путь - Строка - путь без строки параметров
//     * Заголовки - Соответствие - имя заголовка в нижнем регистре -> значение
//
Функция РазобратьЗапрос(Текст) Экспорт
    Запрос = Новый Структура("Метод, Путь, Заголовки", "", "", Новый Соответствие());
    Строки = СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС);
    ЧастиСтрокиЗапроса = СтрРазделить(Строки[0], " ", Ложь);
    Если ЧастиСтрокиЗапроса.Количество() > 1 Тогда
        Запрос.Метод = ВРег(ЧастиСтрокиЗапроса[0]);
        Путь = ЧастиСтрокиЗапроса[1];
        НачалоПараметров = СтрНайти(Путь, "?");
        Если НачалоПараметров > 0 Тогда
            Путь = Лев(Путь, НачалоПараметров - 1);
        КонецЕсли;
        Запрос.Путь = Путь;
    КонецЕсли;
    Для Индекс = 1 По Строки.ВГраница() Цикл
        ТекстЗаголовка = Строки[Индекс];
        Если ТекстЗаголовка = "" Тогда
            Прервать;
        КонецЕсли;
        ДобавитьЗаголовок(Запрос.Заголовки, ТекстЗаголовка);
    КонецЦикла;
    Возврат Запрос;
КонецФункции

// Формирует HTTP-ответ: строку состояния, заголовки Content-Type, Content-Length (длина тела в
// байтах UTF-8) и Connection: close, затем тело. Ответ 405 содержит заголовок Allow.
//
// Параметры:
//   КодСостояния - Число - код состояния HTTP
//   ТипКонтента - Строка - значение Content-Type
//   Тело - Строка - тело ответа
//   БезТела - Булево - ответ на HEAD: заголовки без тела
//
// Возвращаемое значение:
//   ДвоичныеДанные
//
Функция ОтветHttp(КодСостояния, ТипКонтента, Тело, БезТела = Ложь) Экспорт
    ДанныеТела = ПолучитьДвоичныеДанныеИзСтроки(Тело, "UTF-8");
    ВКПС = Символы.ВК + Символы.ПС;
    Заголовки = "HTTP/1.1 " + Формат(КодСостояния, "ЧГ=") + " " + ТекстСостояния(КодСостояния) + ВКПС
        + "Content-Type: " + ТипКонтента + ВКПС
        + "Content-Length: " + Формат(ДанныеТела.Размер(), "ЧН=0; ЧГ=") + ВКПС;
    Если КодСостояния = КодМетодНеПоддерживается() Тогда
        Заголовки = Заголовки + "Allow: GET, HEAD" + ВКПС;
    КонецЕсли;
    Заголовки = Заголовки + "Connection: close" + ВКПС + ВКПС;
    Части = Новый Массив();
    Части.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Заголовки, "UTF-8"));
    Если НЕ БезТела Тогда
        Части.Добавить(ДанныеТела);
    КонецЕсли;
    Возврат СоединитьДвоичныеДанные(Части);
КонецФункции

// Проверяет, разрешено ли клиенту получать метрики при заданном хосте. TCPСервер OneScript
// принимает подключения на всех интерфейсах, поэтому локальный хост (localhost, 127.x.x.x, ::1)
// разрешает только локальных клиентов; остальные хосты клиентов не ограничивают.
//
// Параметры:
//   Хост - Строка - хост экспортера
//   УдаленныйУзел - Строка - адрес клиента с портом: 127.0.0.1:5000 или [::1]:5000
//
// Возвращаемое значение:
//   Булево
//
Функция КлиентРазрешен(Хост, УдаленныйУзел) Экспорт
    Если НЕ ЭтоЛокальныйХост(Хост) Тогда
        Возврат Истина;
    КонецЕсли;
    Возврат ЭтоЛокальныйАдрес(АдресУзла(УдаленныйУзел));
КонецФункции

// Проверяет, что хост - локальный адрес: localhost, 127.x.x.x или ::1.
//
// Параметры:
//   Хост - Строка - хост
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоЛокальныйХост(Хост) Экспорт
    Имя = НРег(СокрЛП(Хост));
    Возврат Имя = "localhost" ИЛИ ЭтоЛокальныйАдрес(СтрЗаменить(СтрЗаменить(Имя, "[", ""), "]", ""));
КонецФункции

// Проверяет, что хост означает все интерфейсы: пустой, *, 0.0.0.0 или ::.
//
// Параметры:
//   Хост - Строка - хост
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоЛюбойАдрес(Хост) Экспорт
    Имя = СокрЛП(Хост);
    // BSLLS:UsingHardcodeNetworkAddress-off
    Возврат Имя = "" ИЛИ Имя = "*" ИЛИ Имя = "0.0.0.0" ИЛИ Имя = "::" ИЛИ Имя = "[::]";
    // BSLLS:UsingHardcodeNetworkAddress-on
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьЗаголовок(Заголовки, ТекстЗаголовка)
    Разделитель = СтрНайти(ТекстЗаголовка, ":");
    Если Разделитель = 0 Тогда
        Возврат;
    КонецЕсли;
    Имя = НРег(СокрЛП(Лев(ТекстЗаголовка, Разделитель - 1)));
    Значение = СокрЛП(Сред(ТекстЗаголовка, Разделитель + 1));
    Прежнее = Заголовки.Получить(Имя);
    Если Прежнее <> Неопределено Тогда
        Значение = Прежнее + "," + Значение;
    КонецЕсли;
    Заголовки.Вставить(Имя, Значение);
КонецПроцедуры

Функция ТекстСостояния(КодСостояния)
    Тексты = Новый Соответствие();
    Тексты.Вставить(200, "OK");
    Тексты.Вставить(400, "Bad Request");
    Тексты.Вставить(404, "Not Found");
    Тексты.Вставить(КодМетодНеПоддерживается(), "Method Not Allowed");
    Тексты.Вставить(406, "Not Acceptable");
    Текст = Тексты.Получить(КодСостояния);
    Возврат ?(Текст = Неопределено, "Internal Server Error", Текст);
КонецФункции

Функция КодМетодНеПоддерживается()
    Возврат 405;
КонецФункции

// Проверяет, что адрес - loopback: 127.x.x.x, ::1 или IPv4-mapped ::ffff:127.x.x.x.
//
// Параметры:
//   Адрес - Строка - IP-адрес без порта
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоЛокальныйАдрес(Адрес)
    // BSLLS:UsingHardcodeNetworkAddress-off
    Возврат СтрНачинаетсяС(Адрес, "127.") ИЛИ Адрес = "::1" ИЛИ СтрНачинаетсяС(Адрес, "::ffff:127.");
    // BSLLS:UsingHardcodeNetworkAddress-on
КонецФункции

// Возвращает адрес узла без порта: 127.0.0.1:5000 -> 127.0.0.1, [::1]:5000 -> ::1.
//
// Параметры:
//   Узел - Строка - адрес с портом
//
// Возвращаемое значение:
//   Строка
//
Функция АдресУзла(Узел)
    Если СтрНачинаетсяС(Узел, "[") Тогда
        Конец = СтрНайти(Узел, "]");
        Адрес = ?(Конец > 0, Лев(Узел, Конец - 1), Узел);
        Возврат СтрЗаменить(Адрес, "[", "");
    КонецЕсли;
    Разделитель = СтрНайти(Узел, ":", НаправлениеПоиска.СКонца);
    Возврат ?(Разделитель > 0, Лев(Узел, Разделитель - 1), Узел);
КонецФункции

#КонецОбласти
