// BSLLS:MagicNumber-off
// Модуль фильтрации экземпляров (ExemplarFilter) по спецификации OpenTelemetry.
//
// Определяет, когда захватывать экземпляры (exemplars) для метрик.
// По умолчанию используется стратегия ПоТрассировке (traceBased).

#Область ПрограммныйИнтерфейс

// Всегда захватывать экземпляры.
//
// Возвращаемое значение:
//   Число - константа фильтра
//
Функция ВсегдаВключен() Экспорт
    Возврат 1;
КонецФункции

// Никогда не захватывать экземпляры.
//
// Возвращаемое значение:
//   Число - константа фильтра
//
Функция ВсегдаВыключен() Экспорт
    Возврат 2;
КонецФункции

// Захватывать экземпляры только при наличии активного сэмплированного спана.
// Это значение по умолчанию.
//
// Возвращаемое значение:
//   Число - константа фильтра
//
Функция ПоТрассировке() Экспорт
    Возврат 3;
КонецФункции

// Проверяет, нужно ли захватывать экземпляр по текущему фильтру.
// Для ПоТрассировке измерение подходит, если записано в контексте сэмплированного спана:
// явного контекста измерения, а если он не передан - текущего контекста.
//
// Параметры:
//   Фильтр - Число - значение фильтра из констант модуля
//   Контекст - Соответствие, Неопределено - контекст измерения (необязательный)
//
// Возвращаемое значение:
//   Булево
//
Функция ДолженЗахватить(Фильтр, Контекст = Неопределено) Экспорт
    Если Фильтр = ВсегдаВыключен() Тогда
        Возврат Ложь;
    КонецЕсли;

    Если Фильтр = ВсегдаВключен() Тогда
        Возврат Истина;
    КонецЕсли;

    // ПоТрассировке - спан контекста измерения валиден и сэмплирован
    Попытка
        Спан = ОтелКонтекст.СпанИзКонтекста(Контекст);
        Если Спан = Неопределено Тогда
            Возврат Ложь;
        КонецЕсли;
        КонтекстСпана = Спан.КонтекстСпана();
        Возврат КонтекстСпана.Валиден() И (КонтекстСпана.ФлагиТрассировки() % 2) = 1;
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

#КонецОбласти
