// BSLLS:UnusedLocalVariable-off
// BSLLS:ExportVariables-off
// Конфигурация периодического читателя метрик (PeriodicMetricReader).
//
// Соответствует секции meter_provider.readers[].periodic.

#Область ОписаниеПеременных

// interval - Число - интервал сбора метрик в миллисекундах
Перем Интервал Экспорт;

// timeout - Число - таймаут экспорта в миллисекундах
Перем Таймаут Экспорт;

// exporter - ОтелКонфигурацияЭкспортераOtlpHttp, ОтелКонфигурацияЭкспортераOtlpGrpc,
// ОтелКонфигурацияКомпонента - конфигурация экспортера; экспортер, которого нет в SDK, -
// ОтелКонфигурацияКомпонента
Перем Экспортер Экспорт;

// producers - Массив из ОтелКонфигурацияКомпонента - продюсеры метрик
Перем Продюсеры Экспорт;

// cardinality_limits - ОтелКонфигурацияЛимитовМощности/Неопределено - лимиты мощности по видам
// инструментов; Неопределено - лимит 2000 для всех видов
Перем ЛимитыМощности Экспорт;

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()
	Интервал = 60000;
	Таймаут = 30000;
	Экспортер = Неопределено;
	Продюсеры = Новый Массив;
	ЛимитыМощности = Неопределено;
КонецПроцедуры

#КонецОбласти
