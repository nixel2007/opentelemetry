// BSLLS:UnusedLocalVariable-off
// BSLLS:ExportVariables-off
// Конфигурация агрегации потока метрики.
//
// Соответствует секции meter_provider.views[].stream.aggregation. Union-тип: тип определяется полем
// Тип. Для explicit_bucket_histogram используются Границы и ЗаписыватьМинМакс, для
// base2_exponential_bucket_histogram - МаксШкала, МаксРазмер и ЗаписыватьМинМакс; остальные типы
// параметров не имеют.

#Область ОписаниеПеременных

// Строка - тип агрегации: "default", "drop", "explicit_bucket_histogram",
//   "base2_exponential_bucket_histogram", "last_value", "sum"
Перем Тип Экспорт;

// boundaries - Массив из Число/Неопределено - границы бакетов явной гистограммы; Неопределено -
// границы по умолчанию
Перем Границы Экспорт;

// record_min_max - Булево - записывать min и max гистограммы
Перем ЗаписыватьМинМакс Экспорт;

// max_scale - Число - максимальная шкала экспоненциальной гистограммы, от -10 до 20
Перем МаксШкала Экспорт;

// max_size - Число - максимальное число бакетов экспоненциальной гистограммы, не меньше 2
Перем МаксРазмер Экспорт;

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()
	Тип = "default";
	Границы = Неопределено;
	ЗаписыватьМинМакс = Истина;
	МаксШкала = 20;
	МаксРазмер = 160;
КонецПроцедуры

#КонецОбласти
