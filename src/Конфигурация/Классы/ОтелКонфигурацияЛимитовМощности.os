// BSLLS:UnusedLocalVariable-off
// BSLLS:ExportVariables-off
// Конфигурация лимитов мощности (cardinality limits) читателя метрик.
//
// Соответствует секции meter_provider.readers[].periodic.cardinality_limits. Лимит вида
// инструмента: Число - лимит; Неопределено - не задан, действует ПоУмолчанию.

#Область ОписаниеПеременных

// default - Число - лимит мощности для видов инструментов без своего лимита
Перем ПоУмолчанию Экспорт;

// counter - Число/Неопределено - лимит мощности счетчиков
Перем Счетчик Экспорт;

// up_down_counter - Число/Неопределено - лимит мощности реверсивных счетчиков
Перем РеверсивныйСчетчик Экспорт;

// histogram - Число/Неопределено - лимит мощности гистограмм
Перем Гистограмма Экспорт;

// gauge - Число/Неопределено - лимит мощности датчиков
Перем Датчик Экспорт;

// observable_counter - Число/Неопределено - лимит мощности наблюдаемых счетчиков
Перем НаблюдаемыйСчетчик Экспорт;

// observable_up_down_counter - Число/Неопределено - лимит мощности наблюдаемых реверсивных счетчиков
Перем НаблюдаемыйРеверсивныйСчетчик Экспорт;

// observable_gauge - Число/Неопределено - лимит мощности наблюдаемых датчиков
Перем НаблюдаемыйДатчик Экспорт;

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()
	ПоУмолчанию = 2000;
	Счетчик = Неопределено;
	РеверсивныйСчетчик = Неопределено;
	Гистограмма = Неопределено;
	Датчик = Неопределено;
	НаблюдаемыйСчетчик = Неопределено;
	НаблюдаемыйРеверсивныйСчетчик = Неопределено;
	НаблюдаемыйДатчик = Неопределено;
КонецПроцедуры

#КонецОбласти
