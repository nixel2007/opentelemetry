// BSLLS:UnusedLocalVariable-off
// BSLLS:ExportVariables-off
// Конфигурация компонента SDK по имени (SDK extension component).
//
// Компонент задан в файле ключом-именем со свойствами под ним: пропагатор (- tracecontext:), генератор
// ID (random:), а также компонент, которого нет в SDK, - пользовательский экспортер, процессор,
// сэмплер, pull-экспортер или продюсер метрик. Разбор сохраняет такой компонент в общем виде - имя и
// свойства как в файле (Configuration SDK, Parse). Фабрика создает встроенный компонент по имени, а
// компонент, которого нет в SDK, - провайдером компонента, зарегистрированным с его типом и именем
// (ОтелКонфигурационнаяФабрика.ЗарегистрироватьПровайдерКомпонента); без провайдера - исключение
// (Configuration SDK, Create).

#Область ОписаниеПеременных

// Строка - имя компонента: ключ в файле, например "tracecontext", "random", "my_exporter"
Перем Имя Экспорт;

// Соответствие, Неопределено - свойства компонента из файла; Неопределено - ключ без значения (null)
Перем Свойства Экспорт;

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()
	Имя = "";
	Свойства = Неопределено;
КонецПроцедуры

#КонецОбласти
