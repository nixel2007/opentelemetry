// BSLLS:UnusedLocalVariable-off
// BSLLS:ExportVariables-off
// Конфигурация компонента SDK по имени (SDK extension component).
//
// Компонент задан в файле ключом-именем со свойствами под ним: пропагатор (- tracecontext:), генератор
// ID (random:), а также компонент, которого нет в SDK, - экспортер console, пользовательский экспортер
// или сэмплер. Разбор сохраняет такой компонент в общем виде - имя и свойства как в файле
// (Configuration SDK, Parse), фабрика создает встроенный компонент по имени, а на компонент, которого
// нет в SDK, выбрасывает исключение (Configuration SDK, Create).

#Область ОписаниеПеременных

// Строка - имя компонента: ключ в файле, например "tracecontext", "console", "my_exporter"
Перем Имя Экспорт;

// Соответствие, Неопределено - свойства компонента из файла; Неопределено - ключ без значения (null)
Перем Свойства Экспорт;

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()
	Имя = "";
	Свойства = Неопределено;
КонецПроцедуры

#КонецОбласти
