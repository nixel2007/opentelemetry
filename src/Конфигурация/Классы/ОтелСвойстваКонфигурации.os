// Свойства компонента из файла конфигурации (ConfigProperties, спецификация Configuration API).
//
// Представляет узел-соответствие YAML: свойства, которые фабрика передает провайдеру компонента
// (PluginComponentProvider) в СоздатьКомпонент. Значение читается методом своего типа: значение
// другого типа, отсутствующее свойство и свойство со значением null дают значение по умолчанию.
// Вложенные соответствия читаются как ОтелСвойстваКонфигурации. Узел неизменяемый: при создании он
// копируется в фиксированные коллекции, и изменения исходных данных свойства не меняют.

#Область ОписаниеПеременных

// ФиксированноеСоответствие - узел: ключ - имя свойства, значение - скаляр, ФиксированныйМассив,
// ФиксированноеСоответствие или Неопределено (null). Карты collectionos не подходят: они не хранят
// Неопределено, а свойство со значением null нужно отличать от отсутствующего
Перем Узел;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает строковое значение свойства.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет, оно null или не строка
//
// Возвращаемое значение:
//   Строка, Произвольный - значение свойства или ПоУмолчанию
//
Функция ПолучитьСтроку(Имя, ПоУмолчанию = Неопределено) Экспорт
	Значение = Узел.Получить(Имя);
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), Значение, ПоУмолчанию);
КонецФункции

// Возвращает булево значение свойства.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет, оно null или не булево
//
// Возвращаемое значение:
//   Булево, Произвольный - значение свойства или ПоУмолчанию
//
Функция ПолучитьБулево(Имя, ПоУмолчанию = Неопределено) Экспорт
	Значение = Узел.Получить(Имя);
	Возврат ?(ТипЗнч(Значение) = Тип("Булево"), Значение, ПоУмолчанию);
КонецФункции

// Возвращает целочисленное значение свойства.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет, оно null или не целое число
//
// Возвращаемое значение:
//   Число, Произвольный - значение свойства или ПоУмолчанию
//
Функция ПолучитьЦелое(Имя, ПоУмолчанию = Неопределено) Экспорт
	Значение = Узел.Получить(Имя);
	Возврат ?(ЭтоЦелое(Значение), Значение, ПоУмолчанию);
КонецФункции

// Возвращает числовое значение свойства: целое или дробное.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет, оно null или не число
//
// Возвращаемое значение:
//   Число, Произвольный - значение свойства или ПоУмолчанию
//
Функция ПолучитьЧисло(Имя, ПоУмолчанию = Неопределено) Экспорт
	Значение = Узел.Получить(Имя);
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, ПоУмолчанию);
КонецФункции

// Возвращает вложенные свойства: значение свойства - соответствие.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет, оно null или не соответствие
//
// Возвращаемое значение:
//   ОтелСвойстваКонфигурации, Произвольный - вложенные свойства или ПоУмолчанию
//
Функция ПолучитьСвойства(Имя, ПоУмолчанию = Неопределено) Экспорт
	Значение = Узел.Получить(Имя);
	Если ТипЗнч(Значение) <> Тип("ФиксированноеСоответствие") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Новый ОтелСвойстваКонфигурации(Значение);
КонецФункции

// Возвращает массив строк: значение свойства - последовательность строк.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет, оно null, не последовательность или
//     в ней есть элемент не строка
//
// Возвращаемое значение:
//   Массив из Строка, Произвольный - новый массив значений или ПоУмолчанию
//
Функция ПолучитьМассивСтрок(Имя, ПоУмолчанию = Неопределено) Экспорт
	Возврат МассивСкаляров(Имя, "Строка", ПоУмолчанию);
КонецФункции

// Возвращает массив булевых значений: значение свойства - последовательность булевых значений.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет, оно null, не последовательность или
//     в ней есть элемент не булево
//
// Возвращаемое значение:
//   Массив из Булево, Произвольный - новый массив значений или ПоУмолчанию
//
Функция ПолучитьМассивБулево(Имя, ПоУмолчанию = Неопределено) Экспорт
	Возврат МассивСкаляров(Имя, "Булево", ПоУмолчанию);
КонецФункции

// Возвращает массив целых чисел: значение свойства - последовательность целых чисел.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет, оно null, не последовательность или
//     в ней есть элемент не целое число
//
// Возвращаемое значение:
//   Массив из Число, Произвольный - новый массив значений или ПоУмолчанию
//
Функция ПолучитьМассивЦелых(Имя, ПоУмолчанию = Неопределено) Экспорт
	Возврат МассивСкаляров(Имя, "Целое", ПоУмолчанию);
КонецФункции

// Возвращает массив чисел: значение свойства - последовательность чисел.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет, оно null, не последовательность или
//     в ней есть элемент не число
//
// Возвращаемое значение:
//   Массив из Число, Произвольный - новый массив значений или ПоУмолчанию
//
Функция ПолучитьМассивЧисел(Имя, ПоУмолчанию = Неопределено) Экспорт
	Возврат МассивСкаляров(Имя, "Число", ПоУмолчанию);
КонецФункции

// Возвращает массив вложенных свойств: значение свойства - последовательность соответствий.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет, оно null, не последовательность или
//     в ней есть элемент не соответствие
//
// Возвращаемое значение:
//   Массив из ОтелСвойстваКонфигурации, Произвольный - вложенные свойства или ПоУмолчанию
//
Функция ПолучитьМассивСвойств(Имя, ПоУмолчанию = Неопределено) Экспорт

	Значение = Узел.Получить(Имя);
	Если ТипЗнч(Значение) <> Тип("ФиксированныйМассив") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Элемент Из Значение Цикл
		Если ТипЗнч(Элемент) <> Тип("ФиксированноеСоответствие") Тогда
			Возврат ПоУмолчанию;
		КонецЕсли;
		Результат.Добавить(Новый ОтелСвойстваКонфигурации(Элемент));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает имена всех заданных свойств, в том числе свойств со значением null.
//
// Возвращаемое значение:
//   Массив из Строка - имена свойств
//
Функция Ключи() Экспорт
	Результат = Новый Массив;
	Для Каждого Свойство Из Узел Цикл
		Результат.Добавить(Свойство.Ключ);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Проверяет, что свойство задано, в том числе со значением null.
//
// Параметры:
//   Имя - Строка - имя свойства
//
// Возвращаемое значение:
//   Булево - Истина, если свойство задано
//
Функция Содержит(Имя) Экспорт
	// Получить не отличает null от отсутствующего свойства: ключ ищется среди заданных
	Для Каждого Свойство Из Узел Цикл
		Если Свойство.Ключ = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Проверяет, что свойство задано со значением null: отличает null от свойства, которого нет.
//
// Параметры:
//   Имя - Строка - имя свойства
//
// Возвращаемое значение:
//   Булево - Истина, если свойство задано и его значение null
//
Функция ЭтоNull(Имя) Экспорт
	Возврат Узел.Получить(Имя) = Неопределено И Содержит(Имя);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МассивСкаляров(Имя, ТипЭлемента, ПоУмолчанию)

	Значение = Узел.Получить(Имя);
	Если ТипЗнч(Значение) <> Тип("ФиксированныйМассив") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Элемент Из Значение Цикл
		Если Не ЗначениеТипа(Элемент, ТипЭлемента) Тогда
			Возврат ПоУмолчанию;
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЗначениеТипа(Значение, ТипЭлемента)
	Если ТипЭлемента = "Целое" Тогда
		Возврат ЭтоЦелое(Значение);
	КонецЕсли;
	Возврат ТипЗнч(Значение) = Тип(ТипЭлемента);
КонецФункции

Функция ЭтоЦелое(Значение)
	Возврат ТипЗнч(Значение) = Тип("Число") И Цел(Значение) = Значение;
КонецФункции

// Возвращает неизменяемую копию значения узла: соответствия и массивы на всех уровнях копируются
// в фиксированные коллекции.
//
// Параметры:
//   Значение - Произвольный - значение узла
//
// Возвращаемое значение:
//   Произвольный - ФиксированноеСоответствие, ФиксированныйМассив или скаляр как есть
//
Функция Неизменяемое(Значение)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Соответствие") Или ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		Возврат Новый ФиксированноеСоответствие(НеизменяемыеЗначения(Значение));
	КонецЕсли;

	Если ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Элементы = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Элементы.Добавить(Неизменяемое(Элемент));
		КонецЦикла;
		Возврат Новый ФиксированныйМассив(Элементы);
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Возвращает соответствие с неизменяемыми копиями значений.
//
// Параметры:
//   ДанныеУзла - Соответствие, ФиксированноеСоответствие - узел
//
// Возвращаемое значение:
//   Соответствие
//
Функция НеизменяемыеЗначения(ДанныеУзла)
	Результат = Новый Соответствие;
	Для Каждого Свойство Из ДанныеУзла Цикл
		Результат.Вставить(Свойство.Ключ, Неизменяемое(Свойство.Значение));
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Параметры:
//   ДанныеУзла - Соответствие, ФиксированноеСоответствие, Неопределено - узел-соответствие из файла;
//     Неопределено - компонент без свойств (ключ без значения)
//
Процедура ПриСозданииОбъекта(ДанныеУзла)

	Значения = Новый Соответствие;
	ТипУзла = ТипЗнч(ДанныеУзла);
	Если ТипУзла = Тип("Соответствие") Или ТипУзла = Тип("ФиксированноеСоответствие") Тогда
		Значения = НеизменяемыеЗначения(ДанныеУзла);
	КонецЕсли;
	Узел = Новый ФиксированноеСоответствие(Значения);

КонецПроцедуры

#КонецОбласти
