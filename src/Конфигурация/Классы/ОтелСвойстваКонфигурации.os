#Использовать collectionos

// Свойства компонента из файла конфигурации (ConfigProperties, спецификация Configuration API).
//
// Представляет узел-соответствие YAML: свойства, которые фабрика передает провайдеру компонента
// (PluginComponentProvider) в СоздатьКомпонент. Значение читается типизированным геттером:
// - свойства нет - геттер возвращает значение по умолчанию;
// - свойство задано со значением null - геттер возвращает Null;
// - значение не того типа - исключение с именем свойства и ожидаемым типом (Configuration SDK,
//   Create Component: свойство не того типа - ошибка).
// Вложенные соответствия читаются как ОтелСвойстваКонфигурации. Узел неизменяемый: при создании он
// копируется в фиксированные коллекции collectionos, изменения исходных данных свойства не меняют.

#Область ОписаниеПеременных

// ФиксированнаяКарта - узел: ключ - имя свойства, значение - скаляр, ФиксированныйСписок,
// ФиксированнаяКарта или Null (свойство со значением null)
Перем Узел;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает строковое значение свойства.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет
//
// Возвращаемое значение:
//   Строка, Null, Произвольный - значение свойства; Null - свойство со значением null; ПоУмолчанию -
//     свойства нет
//
Функция ПолучитьСтроку(Имя, ПоУмолчанию = Неопределено) Экспорт
	Возврат ЗначениеТипа(Имя, "Строка", ПоУмолчанию);
КонецФункции

// Возвращает булево значение свойства.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет
//
// Возвращаемое значение:
//   Булево, Null, Произвольный - значение свойства; Null - свойство со значением null; ПоУмолчанию -
//     свойства нет
//
Функция ПолучитьБулево(Имя, ПоУмолчанию = Неопределено) Экспорт
	Возврат ЗначениеТипа(Имя, "Булево", ПоУмолчанию);
КонецФункции

// Возвращает целочисленное значение свойства.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет
//
// Возвращаемое значение:
//   Число, Null, Произвольный - значение свойства; Null - свойство со значением null; ПоУмолчанию -
//     свойства нет
//
Функция ПолучитьЦелое(Имя, ПоУмолчанию = Неопределено) Экспорт
	Возврат ЗначениеТипа(Имя, "Целое", ПоУмолчанию);
КонецФункции

// Возвращает числовое значение свойства: целое или дробное.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет
//
// Возвращаемое значение:
//   Число, Null, Произвольный - значение свойства; Null - свойство со значением null; ПоУмолчанию -
//     свойства нет
//
Функция ПолучитьЧисло(Имя, ПоУмолчанию = Неопределено) Экспорт
	Возврат ЗначениеТипа(Имя, "Число", ПоУмолчанию);
КонецФункции

// Возвращает вложенные свойства: значение свойства - соответствие.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет
//
// Возвращаемое значение:
//   ОтелСвойстваКонфигурации, Null, Произвольный - вложенные свойства; Null - свойство со значением
//     null; ПоУмолчанию - свойства нет
//
Функция ПолучитьСвойства(Имя, ПоУмолчанию = Неопределено) Экспорт

	Значение = Узел.ПолучитьИлиУмолчание(Имя, ПоУмолчанию);
	Если Значение = Null Или Не Узел.СодержитКлюч(Имя) Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("ФиксированнаяКарта") Тогда
		ВызватьИсключение ТекстОшибкиТипа(Имя, "соответствие");
	КонецЕсли;
	Возврат Новый ОтелСвойстваКонфигурации(Значение);

КонецФункции

// Возвращает массив строк: значение свойства - последовательность строк.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет
//
// Возвращаемое значение:
//   Массив из Строка, Null, Произвольный - новый массив значений; Null - свойство со значением null;
//     ПоУмолчанию - свойства нет
//
Функция ПолучитьМассивСтрок(Имя, ПоУмолчанию = Неопределено) Экспорт
	Возврат МассивСкаляров(Имя, "Строка", "последовательность строк", ПоУмолчанию);
КонецФункции

// Возвращает массив булевых значений: значение свойства - последовательность булевых значений.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет
//
// Возвращаемое значение:
//   Массив из Булево, Null, Произвольный - новый массив значений; Null - свойство со значением null;
//     ПоУмолчанию - свойства нет
//
Функция ПолучитьМассивБулево(Имя, ПоУмолчанию = Неопределено) Экспорт
	Возврат МассивСкаляров(Имя, "Булево", "последовательность булевых значений", ПоУмолчанию);
КонецФункции

// Возвращает массив целых чисел: значение свойства - последовательность целых чисел.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет
//
// Возвращаемое значение:
//   Массив из Число, Null, Произвольный - новый массив значений; Null - свойство со значением null;
//     ПоУмолчанию - свойства нет
//
Функция ПолучитьМассивЦелых(Имя, ПоУмолчанию = Неопределено) Экспорт
	Возврат МассивСкаляров(Имя, "Целое", "последовательность целых чисел", ПоУмолчанию);
КонецФункции

// Возвращает массив чисел: значение свойства - последовательность чисел.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет
//
// Возвращаемое значение:
//   Массив из Число, Null, Произвольный - новый массив значений; Null - свойство со значением null;
//     ПоУмолчанию - свойства нет
//
Функция ПолучитьМассивЧисел(Имя, ПоУмолчанию = Неопределено) Экспорт
	Возврат МассивСкаляров(Имя, "Число", "последовательность чисел", ПоУмолчанию);
КонецФункции

// Возвращает массив вложенных свойств: значение свойства - последовательность соответствий.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ПоУмолчанию - Произвольный - значение, если свойства нет
//
// Возвращаемое значение:
//   Массив из ОтелСвойстваКонфигурации, Null, Произвольный - вложенные свойства; Null - свойство со
//     значением null; ПоУмолчанию - свойства нет
//
Функция ПолучитьМассивСвойств(Имя, ПоУмолчанию = Неопределено) Экспорт

	ОписаниеТипа = "последовательность соответствий";
	Значение = Узел.ПолучитьИлиУмолчание(Имя, ПоУмолчанию);
	Если Значение = Null Или Не Узел.СодержитКлюч(Имя) Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("ФиксированныйСписок") Тогда
		ВызватьИсключение ТекстОшибкиТипа(Имя, ОписаниеТипа);
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Элемент Из Значение.ВМассив() Цикл
		Если ТипЗнч(Элемент) <> Тип("ФиксированнаяКарта") Тогда
			ВызватьИсключение ТекстОшибкиТипа(Имя, ОписаниеТипа);
		КонецЕсли;
		Результат.Добавить(Новый ОтелСвойстваКонфигурации(Элемент));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает имена всех заданных свойств, в том числе свойств со значением null.
//
// Возвращаемое значение:
//   Массив из Строка - имена свойств
//
Функция Ключи() Экспорт
	Возврат Узел.Ключи().ВМассив();
КонецФункции

// Проверяет, что свойство задано, в том числе со значением null.
//
// Параметры:
//   Имя - Строка - имя свойства
//
// Возвращаемое значение:
//   Булево - Истина, если свойство задано
//
Функция Содержит(Имя) Экспорт
	Возврат Узел.СодержитКлюч(Имя);
КонецФункции

// Проверяет, что свойство задано со значением null: отличает null от свойства, которого нет.
//
// Параметры:
//   Имя - Строка - имя свойства
//
// Возвращаемое значение:
//   Булево - Истина, если свойство задано и его значение null
//
Функция ЭтоNull(Имя) Экспорт
	Возврат Узел.ПолучитьИлиУмолчание(Имя, Неопределено) = Null;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает скалярное значение свойства с проверкой типа.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ТипЗначения - Строка - "Строка", "Булево", "Число" или "Целое"
//   ПоУмолчанию - Произвольный - значение, если свойства нет
//
// Возвращаемое значение:
//   Произвольный - значение свойства, Null или ПоУмолчанию
//
Функция ЗначениеТипа(Имя, ТипЗначения, ПоУмолчанию)

	Значение = Узел.ПолучитьИлиУмолчание(Имя, ПоУмолчанию);
	Если Значение = Null Или Не Узел.СодержитКлюч(Имя) Тогда
		Возврат Значение;
	КонецЕсли;
	Если Не ЭтоЗначениеТипа(Значение, ТипЗначения) Тогда
		ВызватьИсключение ТекстОшибкиТипа(Имя, ОписаниеСкалярногоТипа(ТипЗначения));
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Возвращает массив скаляров свойства-последовательности с проверкой типа элементов.
//
// Параметры:
//   Имя - Строка - имя свойства
//   ТипЭлемента - Строка - "Строка", "Булево", "Число" или "Целое"
//   ОписаниеТипа - Строка - ожидаемый тип для текста ошибки
//   ПоУмолчанию - Произвольный - значение, если свойства нет
//
// Возвращаемое значение:
//   Массив, Null, Произвольный - новый массив значений, Null или ПоУмолчанию
//
Функция МассивСкаляров(Имя, ТипЭлемента, ОписаниеТипа, ПоУмолчанию)

	Значение = Узел.ПолучитьИлиУмолчание(Имя, ПоУмолчанию);
	Если Значение = Null Или Не Узел.СодержитКлюч(Имя) Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("ФиксированныйСписок") Тогда
		ВызватьИсключение ТекстОшибкиТипа(Имя, ОписаниеТипа);
	КонецЕсли;

	Результат = Значение.ВМассив();
	Для Каждого Элемент Из Результат Цикл
		Если Не ЭтоЗначениеТипа(Элемент, ТипЭлемента) Тогда
			ВызватьИсключение ТекстОшибкиТипа(Имя, ОписаниеТипа);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЭтоЗначениеТипа(Значение, ТипЗначения)
	Если ТипЗначения = "Целое" Тогда
		Возврат ТипЗнч(Значение) = Тип("Число") И Цел(Значение) = Значение;
	КонецЕсли;
	Возврат ТипЗнч(Значение) = Тип(ТипЗначения);
КонецФункции

Функция ОписаниеСкалярногоТипа(ТипЗначения)
	Описания = Новый Соответствие;
	Описания.Вставить("Строка", "строка");
	Описания.Вставить("Булево", "булево");
	Описания.Вставить("Число", "число");
	Описания.Вставить("Целое", "целое число");
	Возврат Описания.Получить(ТипЗначения);
КонецФункции

Функция ТекстОшибкиТипа(Имя, ОписаниеТипа)
	Возврат СтрШаблон("Свойство ""%1"": ожидается %2", Имя, ОписаниеТипа);
КонецФункции

// Возвращает неизменяемую копию значения узла: соответствия - ФиксированнаяКарта, последовательности -
// ФиксированныйСписок, null (Неопределено из разбора YAML) - Null.
//
// Параметры:
//   Значение - Произвольный - значение узла
//
// Возвращаемое значение:
//   Произвольный - ФиксированнаяКарта, ФиксированныйСписок, Null или скаляр как есть
//
Функция Неизменяемое(Значение)

	ТипЗначения = ТипЗнч(Значение);

	Если Значение = Неопределено Тогда
		Возврат Null;
	ИначеЕсли ТипЗначения = Тип("Соответствие") Или ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		Возврат НеизменяемаяКарта(Значение);
	ИначеЕсли ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Список = Новый СписокМассив();
		Для Каждого Элемент Из Значение Цикл
			Список.Добавить(Неизменяемое(Элемент));
		КонецЦикла;
		Возврат Новый ФиксированныйСписок(Список);
	Иначе
		Возврат Значение;
	КонецЕсли;

КонецФункции

// Возвращает неизменяемую карту узла.
//
// Параметры:
//   ДанныеУзла - Соответствие, ФиксированноеСоответствие - узел
//
// Возвращаемое значение:
//   ФиксированнаяКарта
//
Функция НеизменяемаяКарта(ДанныеУзла)
	Карта = Новый КартаСоответствие();
	Для Каждого Свойство Из ДанныеУзла Цикл
		Карта.Вставить(Свойство.Ключ, Неизменяемое(Свойство.Значение));
	КонецЦикла;
	Возврат Новый ФиксированнаяКарта(Карта);
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Параметры:
//   ДанныеУзла - Соответствие, ФиксированноеСоответствие, ФиксированнаяКарта, Неопределено - узел из
//     файла; ФиксированнаяКарта - вложенный узел, уже неизменяемый; Неопределено - компонент без
//     свойств (ключ без значения)
//
Процедура ПриСозданииОбъекта(ДанныеУзла)

	ТипУзла = ТипЗнч(ДанныеУзла);
	Если ТипУзла = Тип("ФиксированнаяКарта") Тогда
		Узел = ДанныеУзла;
	ИначеЕсли ТипУзла = Тип("Соответствие") Или ТипУзла = Тип("ФиксированноеСоответствие") Тогда
		Узел = НеизменяемаяКарта(ДанныеУзла);
	Иначе
		Узел = Новый ФиксированнаяКарта();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
