// BSLLS:UnusedLocalVariable-off
// BSLLS:ExportVariables-off
// Конфигурация экспортера OTLP gRPC (OtlpGrpc).
//
// Общая для всех сигналов. Для метрик дополнительно заполняются
// ПредпочтениеВременнойАгрегации и АгрегацияГистограммПоУмолчанию.

#Область ОписаниеПеременных

// endpoint - Строка - адрес коллектора без пути сигнала: сервис сигнала gRPC выбирает сам
// Например: http://localhost:4317
Перем Адрес Экспорт;

// compression - Строка - алгоритм сжатия ("gzip", "none")
Перем Сжатие Экспорт;

// timeout - Число - таймаут в миллисекундах
Перем Таймаут Экспорт;

// headers - Массив из Структура("Имя, Значение") - метаданные gRPC
Перем Заголовки Экспорт;

// headers_list - Строка - метаданные в формате "key=val,key=val" (для миграции с env vars)
Перем СписокЗаголовков Экспорт;

// temporality_preference - Строка - предпочтение временной агрегации для метрик
// Значения: "cumulative", "delta", "low_memory"
Перем ПредпочтениеВременнойАгрегации Экспорт;

// default_histogram_aggregation - Строка - агрегация гистограмм по умолчанию для метрик
// Значения: "explicit_bucket_histogram", "base2_exponential_bucket_histogram"
Перем АгрегацияГистограммПоУмолчанию Экспорт;

// max_request_size - Число - максимальный размер сообщения запроса до сжатия в байтах; 0 - без ограничения
Перем МаксРазмерЗапроса Экспорт;

// max_response_size - Число - максимальный размер ответа в байтах. Клиент OPI_GRPC принимает ответ не
// больше 4 MiB, другой лимит задать нельзя
Перем МаксРазмерОтвета Экспорт;

// tls - ОтелНастройкиTls/Неопределено - файлы сертификата сервера (ca_file), клиентского ключа (key_file)
// и сертификата (cert_file), Insecure (insecure) - соединение без TLS с адресом без схемы; Неопределено -
// настройки TLS по умолчанию
Перем НастройкиTls Экспорт;

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()
	Адрес = "";
	Сжатие = "";
	Таймаут = 10000;
	Заголовки = Новый Массив;
	СписокЗаголовков = "";
	ПредпочтениеВременнойАгрегации = "";
	АгрегацияГистограммПоУмолчанию = "";
	МаксРазмерЗапроса = 67108864;
	МаксРазмерОтвета = 4194304;
	НастройкиTls = Неопределено;
КонецПроцедуры

#КонецОбласти
