// BSLLS:UnusedLocalVariable-off
// BSLLS:ExportVariables-off
// Конфигурация селектора инструментов представления (View).
//
// Соответствует секции meter_provider.views[].selector. Критерий со значением Неопределено не
// задан: ему соответствуют все инструменты. Инструмент выбирается, если соответствует всем заданным
// критериям.

#Область ОписаниеПеременных

// instrument_name - Строка/Неопределено - имя инструмента; "*" - все инструменты
Перем ИмяИнструмента Экспорт;

// instrument_type - Строка/Неопределено - вид инструмента: "counter", "gauge", "histogram",
//   "observable_counter", "observable_gauge", "observable_up_down_counter", "up_down_counter"
Перем ТипИнструмента Экспорт;

// unit - Строка/Неопределено - единица измерения инструмента
Перем Единица Экспорт;

// meter_name - Строка/Неопределено - имя метра, создавшего инструмент
Перем ИмяМетра Экспорт;

// meter_version - Строка/Неопределено - версия метра
Перем ВерсияМетра Экспорт;

// meter_schema_url - Строка/Неопределено - адрес схемы метра
Перем АдресСхемыМетра Экспорт;

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()
	ИмяИнструмента = Неопределено;
	ТипИнструмента = Неопределено;
	Единица = Неопределено;
	ИмяМетра = Неопределено;
	ВерсияМетра = Неопределено;
	АдресСхемыМетра = Неопределено;
КонецПроцедуры

#КонецОбласти
