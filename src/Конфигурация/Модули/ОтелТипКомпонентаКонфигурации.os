// Типы компонентов SDK, которые файл конфигурации создает через провайдеры компонентов
// (PluginComponentProvider, спецификация Configuration SDK, Supported SDK plugin components).
//
// Значение типа - имя типа схемы конфигурации. Тип и имя компонента задают провайдер при регистрации
// в ОтелКонфигурационнаяФабрика.ЗарегистрироватьПровайдерКомпонента.

#Область ПрограммныйИнтерфейс

// Пропагатор (TextMapPropagator): элемент propagator.composite или имя из propagator.composite_list.
//
// Возвращаемое значение:
//   Строка - тип компонента
//
Функция Пропагатор() Экспорт
	Возврат "TextMapPropagator";
КонецФункции

// Экспортер спанов (SpanExporter): exporter процессора спанов.
//
// Возвращаемое значение:
//   Строка - тип компонента
//
Функция ЭкспортерСпанов() Экспорт
	Возврат "SpanExporter";
КонецФункции

// Процессор спанов (SpanProcessor): элемент tracer_provider.processors.
//
// Возвращаемое значение:
//   Строка - тип компонента
//
Функция ПроцессорСпанов() Экспорт
	Возврат "SpanProcessor";
КонецФункции

// Сэмплер (Sampler): tracer_provider.sampler и сэмплеры, вложенные в parent_based и always_record.
//
// Возвращаемое значение:
//   Строка - тип компонента
//
Функция Сэмплер() Экспорт
	Возврат "Sampler";
КонецФункции

// Генератор идентификаторов (IdGenerator): tracer_provider.id_generator.
//
// Возвращаемое значение:
//   Строка - тип компонента
//
Функция ГенераторИд() Экспорт
	Возврат "IdGenerator";
КонецФункции

// Pull-читатель метрик (PullMetricExporter): exporter читателя pull. Провайдер возвращает читатель
// метрик, например ОтелПрометеусЧитательМетрик.
//
// Возвращаемое значение:
//   Строка - тип компонента
//
Функция ЧитательМетрикPull() Экспорт
	Возврат "PullMetricExporter";
КонецФункции

// Экспортер метрик (PushMetricExporter): exporter периодического читателя.
//
// Возвращаемое значение:
//   Строка - тип компонента
//
Функция ЭкспортерМетрик() Экспорт
	Возврат "PushMetricExporter";
КонецФункции

// Продюсер метрик (MetricProducer): элемент producers читателя.
//
// Возвращаемое значение:
//   Строка - тип компонента
//
Функция ПродюсерМетрик() Экспорт
	Возврат "MetricProducer";
КонецФункции

// Экспортер записей лога (LogRecordExporter): exporter процессора записей лога.
//
// Возвращаемое значение:
//   Строка - тип компонента
//
Функция ЭкспортерЗаписейЛога() Экспорт
	Возврат "LogRecordExporter";
КонецФункции

// Процессор записей лога (LogRecordProcessor): элемент logger_provider.processors.
//
// Возвращаемое значение:
//   Строка - тип компонента
//
Функция ПроцессорЗаписейЛога() Экспорт
	Возврат "LogRecordProcessor";
КонецФункции

#КонецОбласти
