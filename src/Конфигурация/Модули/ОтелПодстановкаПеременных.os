// Модуль подстановки переменных окружения в файле конфигурации.
//
// Реализует спецификацию Configuration Data Model / Environment variable substitution:
// https://opentelemetry.io/docs/specs/otel/configuration/data-model/#environment-variable-substitution
//
// Синтаксис:
//   ${VAR}           - значение переменной окружения VAR
//   ${VAR:-default}  - значение по умолчанию, если переменная не задана или пустая
//   ${env:VAR}       - то же с префиксом env:
//   $$               - экранирование: в значение попадает один символ $
//
// Имя переменной - латинские буквы, цифры и _, первый символ не цифра. Ссылка другого вида
// (например ${VAR:?error}, ${1VAR} или ${sys:prop}) в значении - ошибка разбора.

#Использовать oscript-yaml

// РегулярноеВыражение - ENV-SUBSTITUTION: имя переменной и необязательное значение по умолчанию
Перем ШаблонПодстановкиОкружения;

#Область ПрограммныйИнтерфейс

// Разбирает YAML-текст файла конфигурации с подстановкой переменных окружения.
//
// Подстановка выполняется только в скалярных значениях: ключи и комментарии не меняются. Тип узла
// определяется после подстановки: скаляр без кавычек получает тип по значению (число, булево,
// null), как значение, записанное в файле, а скаляр в кавычках остается строкой. Подставленное
// значение не добавляет в документ конструкций YAML: коллекция, якорь или комментарий из значения
// переменной остается строкой.
//
// Скаляр без кавычек и блочный скаляр (| или >) парсер YAML возвращает одинаково, поэтому значение
// блочного скаляра, целиком состоящее из подстановки, тоже получает тип по значению.
//
// Параметры:
//   Текст - Строка - YAML-текст
//
// Возвращаемое значение:
//   Произвольный - разобранный документ: Соответствие, Массив или скалярное значение
//
Функция ПрочитатьYaml(Знач Текст) Экспорт

	Контекст = Новый Структура("Метка, Подстановки", НоваяМетка(Текст), Новый Массив);
	ТекстСМаркерами = ТекстСМаркерами(Текст, Контекст);

	Парсер = Новый ПарсерYaml;
	Документ = Парсер.ПрочитатьYaml(ТекстСМаркерами);

	Если Контекст.Подстановки.Количество() = 0 Тогда
		Возврат Документ;
	КонецЕсли;

	Возврат РазрешитьМаркеры(Документ, Контекст, "");

КонецФункции

// Подставляет переменные окружения в строке по тем же правилам. Результат - строка: тип значения не
// определяется.
//
// Параметры:
//   Строка - Строка - исходная строка со ссылками ${...}
//
// Возвращаемое значение:
//   Строка - строка с подставленными значениями
//
Функция ПодставитьВСтроке(Знач Строка) Экспорт

	Результат = Новый Массив;
	Для Каждого Часть Из ЧастиТекста(Строка) Цикл
		Если Часть.Вид = "Текст" Тогда
			Результат.Добавить(Часть.Текст);
			Продолжить;
		КонецЕсли;
		Подстановка = НоваяПодстановка(Часть);
		Если Подстановка.Ошибка <> "" Тогда
			ВызватьИсключение СтрШаблон("Некорректная ссылка на переменную окружения %1: %2",
				Подстановка.Исходный, Подстановка.Ошибка);
		КонецЕсли;
		Результат.Добавить(Подстановка.Значение);
	КонецЦикла;

	Возврат СтрСоединить(Результат);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разбор текста

// Делит текст на обычный текст, экранирования $$ и ссылки ${...}. По спецификации экранирование
// находится слева направо раньше ссылки: ссылка не содержит $$. Ссылка не переходит на следующую
// строку текста.
//
// Параметры:
//   Текст - Строка - исходный текст
//
// Возвращаемое значение:
//   Массив из Структура - части с полями Вид ("Текст", "Экранирование", "Ссылка") и Текст
//
Функция ЧастиТекста(Знач Текст)

	Части = Новый Массив;
	НачалоТекста = 1;
	Позиция = НайтиДоллар(Текст, 1);

	Пока Позиция > 0 Цикл

		Следующий = Сред(Текст, Позиция + 1, 1);
		ДлинаЧасти = 0;
		Если Следующий = "$" Тогда
			Вид = "Экранирование";
			ДлинаЧасти = СтрДлина("$$");
		ИначеЕсли Следующий = "{" Тогда
			Вид = "Ссылка";
			КонецСсылки = КонецСсылки(Текст, Позиция + СтрДлина("${"));
			ДлинаЧасти = ?(КонецСсылки = 0, 0, КонецСсылки - Позиция + 1);
		Иначе
			Вид = "Текст";
		КонецЕсли;

		Если ДлинаЧасти = 0 Тогда
			Позиция = НайтиДоллар(Текст, Позиция + 1);
			Продолжить;
		КонецЕсли;

		ДобавитьТекст(Части, Сред(Текст, НачалоТекста, Позиция - НачалоТекста));
		Части.Добавить(Новый Структура("Вид, Текст", Вид, Сред(Текст, Позиция, ДлинаЧасти)));
		НачалоТекста = Позиция + ДлинаЧасти;
		Позиция = НайтиДоллар(Текст, НачалоТекста);

	КонецЦикла;

	ДобавитьТекст(Части, Сред(Текст, НачалоТекста));

	Возврат Части;

КонецФункции

Функция НайтиДоллар(Знач Текст, Знач НачальнаяПозиция)
	Если НачальнаяПозиция > СтрДлина(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат СтрНайти(Текст, "$", , НачальнаяПозиция);
КонецФункции

// Находит закрывающую скобку ссылки: содержимое ссылки непустое, без перевода строки и без $$.
//
// Параметры:
//   Текст - Строка - исходный текст
//   НачалоСодержимого - Число - позиция после ${
//
// Возвращаемое значение:
//   Число - позиция закрывающей скобки или 0, если ссылки нет
//
Функция КонецСсылки(Знач Текст, Знач НачалоСодержимого)

	Если НачалоСодержимого > СтрДлина(Текст) Тогда
		Возврат 0;
	КонецЕсли;

	ПозицияСкобки = СтрНайти(Текст, "}", , НачалоСодержимого);
	Если ПозицияСкобки <= НачалоСодержимого Тогда
		Возврат 0;
	КонецЕсли;

	Содержимое = Сред(Текст, НачалоСодержимого, ПозицияСкобки - НачалоСодержимого);
	Если СтрНайти(Содержимое, Символы.ПС) > 0 ИЛИ СтрНайти(Содержимое, Символы.ВК) > 0
		ИЛИ СтрНайти(Содержимое, "$$") > 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ПозицияСкобки;

КонецФункции

Процедура ДобавитьТекст(Части, Знач Текст)
	Если Текст <> "" Тогда
		Части.Добавить(Новый Структура("Вид, Текст", "Текст", Текст));
	КонецЕсли;
КонецПроцедуры

// Создает описание подстановки части текста: экранирование дает $, ссылка - значение переменной
// окружения или текст ошибки, если ссылка не соответствует синтаксису.
//
// Параметры:
//   Часть - Структура - часть текста вида "Экранирование" или "Ссылка"
//
// Возвращаемое значение:
//   Структура - Исходный (текст части), Значение (Строка), Ошибка (Строка, пустая без ошибки)
//
Функция НоваяПодстановка(Знач Часть)

	Подстановка = Новый Структура("Исходный, Значение, Ошибка", Часть.Текст, "", "");
	Если Часть.Вид = "Экранирование" Тогда
		Подстановка.Значение = "$";
		Возврат Подстановка;
	КонецЕсли;

	// Содержимое ссылки - текст между открывающей и закрывающей скобками
	Содержимое = Сред(Часть.Текст, СтрДлина("${") + 1, СтрДлина(Часть.Текст) - СтрДлина("${}"));
	ПодстановкаОкружения = ПодстановкаОкружения(Содержимое);
	Если ПодстановкаОкружения = Неопределено Тогда
		Подстановка.Ошибка = "ожидается ${ИМЯ}, ${ИМЯ:-значение по умолчанию} или ${env:ИМЯ}, где ИМЯ"
			+ " из латинских букв, цифр и _ и начинается не с цифры; другие префиксы не поддерживаются";
	Иначе
		Подстановка.Значение = ЗначениеПеременной(ПодстановкаОкружения);
	КонецЕсли;

	Возврат Подстановка;

КонецФункции

// Возвращает ENV-SUBSTITUTION ссылки: содержимое без префикса или с префиксом env.
//
// Параметры:
//   Содержимое - Строка - содержимое ссылки между ${ и }
//
// Возвращаемое значение:
//   Строка, Неопределено - имя переменной с необязательным :-значением или Неопределено
//
Функция ПодстановкаОкружения(Знач Содержимое)

	Если ШаблонПодстановкиОкружения.Совпадает(Содержимое) Тогда
		Возврат Содержимое;
	КонецЕсли;

	ПрефиксEnv = "env:";
	БезПрефикса = Сред(Содержимое, СтрДлина(ПрефиксEnv) + 1);
	Если СтрНачинаетсяС(Содержимое, ПрефиксEnv) И ШаблонПодстановкиОкружения.Совпадает(БезПрефикса) Тогда
		Возврат БезПрефикса;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Значение переменной окружения из ENV-SUBSTITUTION: значение по умолчанию подставляется, если
// переменная не задана или пустая; без значения по умолчанию - пустая строка.
//
// Параметры:
//   ПодстановкаОкружения - Строка - ИМЯ или ИМЯ:-значение по умолчанию
//
// Возвращаемое значение:
//   Строка - значение для подстановки
//
Функция ЗначениеПеременной(Знач ПодстановкаОкружения)

	РазделительУмолчания = ":-";
	ПозицияУмолчания = СтрНайти(ПодстановкаОкружения, РазделительУмолчания);
	Если ПозицияУмолчания = 0 Тогда
		Имя = ПодстановкаОкружения;
		ЗначениеПоУмолчанию = "";
	Иначе
		Имя = Лев(ПодстановкаОкружения, ПозицияУмолчания - 1);
		ЗначениеПоУмолчанию = Сред(ПодстановкаОкружения, ПозицияУмолчания + СтрДлина(РазделительУмолчания));
	КонецЕсли;

	Значение = ПолучитьПеременнуюСреды(Имя);
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

// Маркеры подстановок
//
// Перед разбором YAML каждая подстановка заменяется маркером: Метка_Номер_\x41''_. Парсер
// обрабатывает хвост маркера по правилам стиля скаляра: в двойных кавычках \x41 - экранирование
// буквы A, в одинарных кавычках '' - экранирование кавычки, в скаляре без кавычек хвост не меняется.
// По хвосту после разбора видно, был ли скаляр в кавычках, а подставленное значение не участвует
// в разборе YAML и не может добавить в документ структуру.

Функция ТекстСМаркерами(Знач Текст, Контекст)

	Результат = Новый Массив;
	НомераПодстановок = Новый Соответствие;

	Для Каждого Часть Из ЧастиТекста(Текст) Цикл
		Если Часть.Вид = "Текст" Тогда
			Результат.Добавить(Часть.Текст);
			Продолжить;
		КонецЕсли;
		Номер = НомераПодстановок.Получить(Часть.Текст);
		Если Номер = Неопределено Тогда
			Номер = Контекст.Подстановки.Количество();
			Контекст.Подстановки.Добавить(НоваяПодстановка(Часть));
			НомераПодстановок.Вставить(Часть.Текст, Номер);
		КонецЕсли;
		Результат.Добавить(Контекст.Метка + "_" + Формат(Номер, "ЧН=0; ЧГ=0") + ХвостМаркераБезКавычек());
	КонецЦикла;

	Возврат СтрСоединить(Результат);

КонецФункции

// Метка маркеров, которой нет в тексте.
//
// Параметры:
//   Текст - Строка - исходный текст
//
// Возвращаемое значение:
//   Строка - метка из латинских букв и цифр
//
Функция НоваяМетка(Знач Текст)
	Метка = "";
	Пока Метка = "" ИЛИ СтрНайти(Текст, Метка) > 0 Цикл
		Метка = "otelsubst" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	КонецЦикла;
	Возврат Метка;
КонецФункции

Функция ХвостМаркераБезКавычек()
	Возврат "_\x41''_";
КонецФункции

Функция ХвостМаркераВДвойныхКавычках()
	Возврат "_A''_";
КонецФункции

Функция ХвостМаркераВОдинарныхКавычках()
	Возврат "_\x41'_";
КонецФункции

// Заменяет маркеры в разобранном документе: в ключах - исходным текстом (ключи не подставляются),
// в скалярных значениях - значениями подстановок.
//
// Параметры:
//   Значение - Произвольный - узел разобранного документа
//   Контекст - Структура - метка и подстановки
//   Путь - Строка - путь до узла для текста ошибки
//
// Возвращаемое значение:
//   Произвольный - узел с подстановками
//
Функция РазрешитьМаркеры(Знач Значение, Контекст, Знач Путь)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Соответствие") Тогда
		Возврат РазрешитьМаркерыОтображения(Значение, Контекст, Путь);
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Возврат РазрешитьМаркерыПоследовательности(Значение, Контекст, Путь);
	ИначеЕсли ТипЗначения = Тип("Строка") И СтрНайти(Значение, Контекст.Метка) > 0 Тогда
		Возврат ЗначениеСкаляраСПодстановкой(Значение, Контекст, Путь);
	Иначе
		Возврат Значение;
	КонецЕсли;

КонецФункции

Функция РазрешитьМаркерыОтображения(Знач Отображение, Контекст, Знач Путь)

	Результат = Новый Соответствие;
	Для Каждого КлючЗначение Из Отображение Цикл
		Ключ = КлючЗначение.Ключ;
		Если ТипЗнч(Ключ) = Тип("Строка") Тогда
			Ключ = ИсходныйТекст(Ключ, Контекст);
		КонецЕсли;
		ПутьЗначения = ?(Путь = "", Строка(Ключ), Путь + "." + Строка(Ключ));
		Результат.Вставить(Ключ, РазрешитьМаркеры(КлючЗначение.Значение, Контекст, ПутьЗначения));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция РазрешитьМаркерыПоследовательности(Знач Последовательность, Контекст, Знач Путь)

	Результат = Новый Массив;
	Для Индекс = 0 По Последовательность.ВГраница() Цикл
		ПутьЭлемента = СтрШаблон("%1[%2]", Путь, Формат(Индекс, "ЧН=0; ЧГ=0"));
		Результат.Добавить(РазрешитьМаркеры(Последовательность[Индекс], Контекст, ПутьЭлемента));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ИсходныйТекст(Знач Строка, Контекст)

	Если СтрНайти(Строка, Контекст.Метка) = 0 Тогда
		Возврат Строка;
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Часть Из ЧастиСМаркерами(Строка, Контекст) Цикл
		Если ТипЗнч(Часть) = Тип("Строка") Тогда
			Результат.Добавить(Часть);
		Иначе
			Результат.Добавить(Часть.Подстановка.Исходный);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Результат);

КонецФункции

// Значение скаляра после подстановки. Значение скаляра в кавычках - строка, значение скаляра без
// кавычек получает тип по значению (см. ЗначениеСкаляраБезКавычек).
//
// Параметры:
//   Строка - Строка - значение скаляра с маркерами
//   Контекст - Структура - метка и подстановки
//   Путь - Строка - путь до значения для текста ошибки
//
// Возвращаемое значение:
//   Произвольный - значение скаляра
//
Функция ЗначениеСкаляраСПодстановкой(Знач Строка, Контекст, Знач Путь)

	Результат = Новый Массив;
	ВКавычках = Ложь;

	Для Каждого Часть Из ЧастиСМаркерами(Строка, Контекст) Цикл
		Если ТипЗнч(Часть) = Тип("Строка") Тогда
			Результат.Добавить(Часть);
			Продолжить;
		КонецЕсли;
		Подстановка = Часть.Подстановка;
		Если Подстановка.Ошибка <> "" Тогда
			ВызватьИсключение СтрШаблон("Некорректная ссылка на переменную окружения %1 в значении %2: %3",
				Подстановка.Исходный, ?(Путь = "", "документа", Путь), Подстановка.Ошибка);
		КонецЕсли;
		ВКавычках = Часть.ВКавычках;
		Результат.Добавить(Подстановка.Значение);
	КонецЦикла;

	Значение = СтрСоединить(Результат);
	Если ВКавычках Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ЗначениеСкаляраБезКавычек(Значение);

КонецФункции

// Делит строку на текст и маркеры подстановок.
//
// Параметры:
//   Строка - Строка - строка с маркерами
//   Контекст - Структура - метка и подстановки
//
// Возвращаемое значение:
//   Массив - элементы: Строка (текст) или Структура маркера с полями Подстановка и ВКавычках
//
Функция ЧастиСМаркерами(Знач Строка, Контекст)

	Части = Новый Массив;
	НачалоМаркера = СтрДлина(Контекст.Метка + "_");
	Позиция = 1;
	ПозицияМетки = СтрНайти(Строка, Контекст.Метка + "_");

	Пока ПозицияМетки > 0 Цикл

		НачалоНомера = ПозицияМетки + НачалоМаркера;
		КонецНомера = СтрНайти(Строка, "_", , НачалоНомера);
		Номер = Число(Сред(Строка, НачалоНомера, КонецНомера - НачалоНомера));
		Хвост = Сред(Строка, КонецНомера);
		Если СтрНачинаетсяС(Хвост, ХвостМаркераБезКавычек()) Тогда
			ДлинаХвоста = СтрДлина(ХвостМаркераБезКавычек());
			ВКавычках = Ложь;
		ИначеЕсли СтрНачинаетсяС(Хвост, ХвостМаркераВОдинарныхКавычках()) Тогда
			ДлинаХвоста = СтрДлина(ХвостМаркераВОдинарныхКавычках());
			ВКавычках = Истина;
		Иначе
			ДлинаХвоста = СтрДлина(ХвостМаркераВДвойныхКавычках());
			ВКавычках = Истина;
		КонецЕсли;

		Если ПозицияМетки > Позиция Тогда
			Части.Добавить(Сред(Строка, Позиция, ПозицияМетки - Позиция));
		КонецЕсли;
		Части.Добавить(Новый Структура("Подстановка, ВКавычках", Контекст.Подстановки[Номер], ВКавычках));

		Позиция = КонецНомера + ДлинаХвоста;
		ПозицияМетки = ?(Позиция > СтрДлина(Строка), 0, СтрНайти(Строка, Контекст.Метка + "_", , Позиция));

	КонецЦикла;

	Если Позиция <= СтрДлина(Строка) Тогда
		Части.Добавить(Сред(Строка, Позиция));
	КонецЕсли;

	Возврат Части;

КонецФункции

// Значение скаляра без кавычек после подстановки. Пробелы по краям отбрасываются, как у скаляра без
// кавычек в файле. Пустое значение, ~ и null - null; число и булево определяет парсер YAML, как для
// значения в файле. Значение с пробелами внутри и значение, которое начинается не с буквы, цифры,
// знака, точки или ~, - строка: значение переменной не добавляет конструкций YAML (коллекций,
// якорей, алиасов, тегов, директив, комментариев).
//
// Параметры:
//   Значение - Строка - значение после подстановки
//
// Возвращаемое значение:
//   Строка, Число, Булево, Неопределено - значение скаляра
//
Функция ЗначениеСкаляраБезКавычек(Знач Значение)

	Значение = СокрЛП(Значение);
	Если Значение = "" ИЛИ Значение = "~" ИЛИ НРег(Значение) = "null" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ЕстьПробельныеСимволы(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	ПервыйСимвол = Лев(Значение, 1);
	Если СтрНайти("+-.", ПервыйСимвол) = 0 И Не ЭтоБуква(ПервыйСимвол) И Не ЭтоЦифра(ПервыйСимвол) Тогда
		Возврат Значение;
	КонецЕсли;

	Парсер = Новый ПарсерYaml;
	Попытка
		Прочитанное = Парсер.ПрочитатьYaml(Значение);
	Исключение
		// Значение, которое парсер не разбирает как скаляр, остается строкой
		Возврат Значение;
	КонецПопытки;

	ТипПрочитанного = ТипЗнч(Прочитанное);
	Если ТипПрочитанного = Тип("Число") ИЛИ ТипПрочитанного = Тип("Булево") Тогда
		Возврат Прочитанное;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция ЕстьПробельныеСимволы(Знач Значение)
	Возврат СтрНайти(Значение, " ") > 0 ИЛИ СтрНайти(Значение, Символы.Таб) > 0
		ИЛИ СтрНайти(Значение, Символы.ПС) > 0 ИЛИ СтрНайти(Значение, Символы.ВК) > 0;
КонецФункции

Функция ЭтоБуква(Знач Символ)
	Возврат ВРег(Символ) <> НРег(Символ);
КонецФункции

Функция ЭтоЦифра(Знач Символ)
	Возврат Символ >= "0" И Символ <= "9";
КонецФункции

#КонецОбласти

ШаблонПодстановкиОкружения = Новый РегулярноеВыражение("^[A-Za-z_][A-Za-z0-9_]*(:-.*)?$");
ШаблонПодстановкиОкружения.ИгнорироватьРегистр = Ложь;
ШаблонПодстановкиОкружения.Многострочный = Ложь;
