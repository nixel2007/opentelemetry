// Модуль автоконфигурации OpenTelemetry из переменных окружения и configor.
//
// Читает стандартные переменные окружения OTel (OTEL_SERVICE_NAME, OTEL_EXPORTER_OTLP_ENDPOINT и т.д.)
// через менеджер параметров configor.
//
// Переменные окружения (OTEL_*), преобразуются в ключи с префиксом otel.:
//   OTEL_SDK_DISABLED -> otel.sdk.disabled (true/false, по умолчанию false)
//   OTEL_SERVICE_NAME -> otel.service.name
//   OTEL_RESOURCE_ATTRIBUTES -> otel.resource.attributes (key1=value1,key2=value2)
//   OTEL_EXPORTER_OTLP_ENDPOINT -> otel.exporter.otlp.endpoint
//   OTEL_EXPORTER_OTLP_PROTOCOL -> otel.exporter.otlp.protocol (http/protobuf, http/json, grpc)
//   OTEL_EXPORTER_OTLP_HEADERS -> otel.exporter.otlp.headers (key1=value1,key2=value2)
//   OTEL_EXPORTER_OTLP_COMPRESSION -> otel.exporter.otlp.compression (gzip, none)
//   OTEL_TRACES_EXPORTER -> otel.traces.exporter (otlp, none)
//   OTEL_LOGS_EXPORTER -> otel.logs.exporter (otlp, none)
//   OTEL_METRICS_EXPORTER -> otel.metrics.exporter (otlp, none)
//   OTEL_TRACES_SAMPLER -> otel.traces.sampler (always_on, always_off, traceidratio, parentbased_always_on, etc.)
//   OTEL_TRACES_SAMPLER_ARG -> otel.traces.sampler.arg
//   OTEL_BSP_MAX_QUEUE_SIZE -> otel.bsp.max.queue.size
//   OTEL_BSP_SCHEDULE_DELAY -> otel.bsp.schedule.delay
//   OTEL_BSP_MAX_EXPORT_BATCH_SIZE -> otel.bsp.max.export.batch.size
//   OTEL_BSP_EXPORT_TIMEOUT -> otel.bsp.export.timeout
//   OTEL_EXPORTER_OTLP_TIMEOUT -> otel.exporter.otlp.timeout
//   Per-signal переопределения (TRACES/LOGS/METRICS заменяют общую конфигурацию):
//   OTEL_EXPORTER_OTLP_TRACES_ENDPOINT -> otel.exporter.otlp.traces.endpoint
//   OTEL_EXPORTER_OTLP_TRACES_HEADERS -> otel.exporter.otlp.traces.headers
//   OTEL_EXPORTER_OTLP_TRACES_PROTOCOL -> otel.exporter.otlp.traces.protocol
//   OTEL_EXPORTER_OTLP_TRACES_COMPRESSION -> otel.exporter.otlp.traces.compression
//   OTEL_EXPORTER_OTLP_TRACES_TIMEOUT -> otel.exporter.otlp.traces.timeout
//   OTEL_EXPORTER_OTLP_LOGS_ENDPOINT -> otel.exporter.otlp.logs.endpoint
//   OTEL_EXPORTER_OTLP_LOGS_HEADERS -> otel.exporter.otlp.logs.headers
//   OTEL_EXPORTER_OTLP_LOGS_PROTOCOL -> otel.exporter.otlp.logs.protocol
//   OTEL_EXPORTER_OTLP_LOGS_COMPRESSION -> otel.exporter.otlp.logs.compression
//   OTEL_EXPORTER_OTLP_LOGS_TIMEOUT -> otel.exporter.otlp.logs.timeout
//   OTEL_EXPORTER_OTLP_METRICS_ENDPOINT -> otel.exporter.otlp.metrics.endpoint
//   OTEL_EXPORTER_OTLP_METRICS_HEADERS -> otel.exporter.otlp.metrics.headers
//   OTEL_EXPORTER_OTLP_METRICS_PROTOCOL -> otel.exporter.otlp.metrics.protocol
//   OTEL_EXPORTER_OTLP_METRICS_COMPRESSION -> otel.exporter.otlp.metrics.compression
//   OTEL_EXPORTER_OTLP_METRICS_TIMEOUT -> otel.exporter.otlp.metrics.timeout
//   OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE ->
//       otel.exporter.otlp.metrics.temporality.preference
//       (cumulative, delta, lowmemory)
//   OTEL_EXPORTER_OTLP_METRICS_DEFAULT_HISTOGRAM_AGGREGATION ->
//       otel.exporter.otlp.metrics.default.histogram.aggregation
//       (explicit_bucket_histogram, base2_exponential_bucket_histogram)
//   OTEL_PROPAGATORS -> otel.propagators (tracecontext, baggage, b3, b3multi, none;
//                                          по умолчанию tracecontext,baggage;
//                                          b3/b3multi требуют установки пакета opentelemetry-propagator-b3)
//   OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT -> otel.attribute.value.length.limit (число, по умолчанию без ограничения)
//   OTEL_ATTRIBUTE_COUNT_LIMIT -> otel.attribute.count.limit (число, по умолчанию 128)
//   OTEL_SPAN_ATTRIBUTE_VALUE_LENGTH_LIMIT -> otel.span.attribute.value.length.limit (переопределение для спанов)
//   OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT -> otel.span.attribute.count.limit (переопределение для спанов)
//   OTEL_SPAN_EVENT_COUNT_LIMIT -> otel.span.event.count.limit (число, по умолчанию 128)
//   OTEL_SPAN_LINK_COUNT_LIMIT -> otel.span.link.count.limit (число, по умолчанию 128)
//   OTEL_EVENT_ATTRIBUTE_COUNT_LIMIT -> otel.event.attribute.count.limit (число, по умолчанию 128)
//   OTEL_LINK_ATTRIBUTE_COUNT_LIMIT -> otel.link.attribute.count.limit (число, по умолчанию 128)
//   OTEL_LOGRECORD_ATTRIBUTE_COUNT_LIMIT -> otel.logrecord.attribute.count.limit
//       (переопределение для логов)
//   OTEL_LOGRECORD_ATTRIBUTE_VALUE_LENGTH_LIMIT -> otel.logrecord.attribute.value.length.limit
//       (переопределение для логов)
//   TLS-параметры OTLP экспортера (общие и per-signal):
//   OTEL_EXPORTER_OTLP_CERTIFICATE -> otel.exporter.otlp.certificate
//   OTEL_EXPORTER_OTLP_CLIENT_KEY -> otel.exporter.otlp.client.key
//   OTEL_EXPORTER_OTLP_CLIENT_CERTIFICATE -> otel.exporter.otlp.client.certificate
//   OTEL_EXPORTER_OTLP_INSECURE -> otel.exporter.otlp.insecure
//   OTEL_EXPORTER_OTLP_TRACES_CERTIFICATE -> otel.exporter.otlp.traces.certificate
//   OTEL_EXPORTER_OTLP_TRACES_CLIENT_KEY -> otel.exporter.otlp.traces.client.key
//   OTEL_EXPORTER_OTLP_TRACES_CLIENT_CERTIFICATE -> otel.exporter.otlp.traces.client.certificate
//   OTEL_EXPORTER_OTLP_LOGS_CERTIFICATE -> otel.exporter.otlp.logs.certificate
//   OTEL_EXPORTER_OTLP_LOGS_CLIENT_KEY -> otel.exporter.otlp.logs.client.key
//   OTEL_EXPORTER_OTLP_LOGS_CLIENT_CERTIFICATE -> otel.exporter.otlp.logs.client.certificate
//   OTEL_EXPORTER_OTLP_METRICS_CERTIFICATE -> otel.exporter.otlp.metrics.certificate
//   OTEL_EXPORTER_OTLP_METRICS_CLIENT_KEY -> otel.exporter.otlp.metrics.client.key
//   OTEL_EXPORTER_OTLP_METRICS_CLIENT_CERTIFICATE -> otel.exporter.otlp.metrics.client.certificate

#Использовать configor
#Использовать logos

#Область ОписаниеПеременных

// МенеджерПараметров - кэшированный менеджер параметров конфигурации
Перем КэшМенеджер;
// ОтелРесурс - кэшированный ресурс, созданный при инициализации
Перем КэшРесурс;
// Логгер модуля автоконфигурации
Перем Лог;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Инициализирует OpenTelemetry SDK из менеджера параметров и регистрирует глобально.
// Создает провайдеры трассировки, логирования и метрик, собирает SDK и регистрирует его.
// Если otel.sdk.disabled = true, создает SDK в NoOp-режиме (без экспортеров, always_off семплер).
//
// Параметры:
//   МенеджерПараметров - МенеджерПараметров - менеджер параметров (необязательный, по умолчанию из ENV)
//
// Возвращаемое значение:
//   ОтелSdk - настроенный и глобально зарегистрированный экземпляр SDK
//
Функция Инициализировать(МенеджерПараметров = Неопределено) Экспорт

    // Если МенеджерПараметров не передан, проверяем OTEL_CONFIG_FILE.
    // По спецификации: когда OTEL_CONFIG_FILE задана, все остальные OTEL_* env vars игнорируются.
    // OTEL_EXPERIMENTAL_CONFIG_FILE поддерживается как deprecated fallback.
    Если МенеджерПараметров = Неопределено Тогда
        ПутьКФайлуКонфигурации = ПолучитьПеременнуюСреды("OTEL_CONFIG_FILE");
        ИмяПеременной = "OTEL_CONFIG_FILE";
        Если ПутьКФайлуКонфигурации = Неопределено ИЛИ ПутьКФайлуКонфигурации = "" Тогда
            ПутьКФайлуКонфигурации = ПолучитьПеременнуюСреды("OTEL_EXPERIMENTAL_CONFIG_FILE");
            Если ПутьКФайлуКонфигурации <> Неопределено И ПутьКФайлуКонфигурации <> "" Тогда
                ИмяПеременной = "OTEL_EXPERIMENTAL_CONFIG_FILE";
                Лог.Предупреждение(
                    "OTEL_EXPERIMENTAL_CONFIG_FILE устарела, используйте OTEL_CONFIG_FILE");
            КонецЕсли;
        КонецЕсли;
        Если ПутьКФайлуКонфигурации <> Неопределено И ПутьКФайлуКонфигурации <> "" Тогда
            Лог.Информация("Обнаружена %1 = %2, используется файловая конфигурация",
                ИмяПеременной, ПутьКФайлуКонфигурации);
            Модель = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлуКонфигурации);
            Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);
            ОтелГлобальный.Установить(Sdk);
            Возврат Sdk;
        КонецЕсли;
    КонецЕсли;

    СброситьКэш();
    КэшМенеджер = ПодготовитьМенеджер(МенеджерПараметров);

    Если Отключен(КэшМенеджер) Тогда
        Возврат ИнициализироватьНоопСдк();
    КонецЕсли;

    Возврат Новый ОтелПостроительSdk()
        .УстановитьПровайдерТрассировки(СоздатьПровайдерТрассировки())
        .УстановитьПровайдерЛогирования(СоздатьПровайдерЛогирования())
        .УстановитьПровайдерМетрик(СоздатьПровайдерМетрик())
        .УстановитьПропагаторы(СоздатьПропагаторы())
        .УстановитьТаймаутЗакрытия(ТаймаутЗакрытияИзКонфигурации(КэшМенеджер))
        .ПостроитьИЗарегистрироватьГлобально();
КонецФункции

// Создает менеджер параметров по умолчанию (из переменных окружения с префиксом OTEL_).
//
// Возвращаемое значение:
//   МенеджерПараметров - менеджер параметров из переменных окружения
//
Функция СоздатьМенеджерПараметровПоУмолчанию() Экспорт
    Менеджер = Новый МенеджерПараметров();
    ПровайдерENV = Новый ПровайдерПараметровENV();
    Менеджер.ДобавитьПровайдерПараметров(ПровайдерENV, 1);
    Менеджер.Прочитать();
    Возврат Менеджер;
КонецФункции

// Создает ресурс из менеджера параметров.
//
// Создает ресурс на основе менеджера параметров с учетом OTEL_RESOURCE_ATTRIBUTES
// и опционального пользовательского ресурса.
//
// По спеке OpenTelemetry Resource SDK:
//   - SDK MUST извлечь OTEL_RESOURCE_ATTRIBUTES и слить с user-provided.
//   - При конфликте ключей user-provided имеет приоритет над env.
//
// Параметры:
//   МенеджерПараметров - МенеджерПараметров, Неопределено - менеджер параметров
//   ПользовательскийРесурс - ОтелРесурс, Неопределено - ресурс, переданный пользователем
//
// Возвращаемое значение:
//   ОтелРесурс - ресурс с атрибутами из конфигурации (env + user, user > env)
//
Функция СоздатьРесурс(МенеджерПараметров = Неопределено, ПользовательскийРесурс = Неопределено) Экспорт
    Менеджер = РазрешитьМенеджер(МенеджерПараметров);

    Ресурс = Новый ОтелРесурс();

    // OTEL_RESOURCE_ATTRIBUTES -> otel.resource.attributes
    // Формат: key1=value1,key2=value2
    // Применяются первыми, чтобы OTEL_SERVICE_NAME мог перекрыть service.name
    // По спеке: при ошибке (например, декодирования) значение отбрасывается целиком,
    // ошибка логируется, SDK продолжает работу.
    АтрибутыРесурса = Менеджер.Параметр("otel.resource.attributes");
    Если АтрибутыРесурса <> Неопределено И АтрибутыРесурса <> "" Тогда
        Попытка
            Пары = ОтелКонфигурационнаяФабрика.РазобратьАтрибутыРесурса(АтрибутыРесурса);
            Для Каждого Пара Из Пары Цикл
                Ресурс.Атрибуты().Установить(Пара.Ключ, Пара.Значение);
            КонецЦикла;
        Исключение
            Лог.Ошибка("Не удалось разобрать OTEL_RESOURCE_ATTRIBUTES, значение игнорируется: %1",
                ОписаниеОшибки());
        КонецПопытки;
    КонецЕсли;

    // OTEL_SERVICE_NAME перекрывает service.name из OTEL_RESOURCE_ATTRIBUTES.
    // Пустое значение равносильно незаданному (спецификация переменных окружения)
    ИмяСервиса = Менеджер.Параметр("otel.service.name");
    Если ИмяСервиса <> Неопределено И ИмяСервиса <> "" Тогда
        Ресурс.Атрибуты().Установить("service.name", ИмяСервиса);
    КонецЕсли;

    // Пользовательский ресурс перезаписывает env-атрибуты при конфликте
    // (Слить: атрибуты ДругойРесурс имеют приоритет).
    Если ПользовательскийРесурс <> Неопределено Тогда
        Возврат Ресурс.Слить(ПользовательскийРесурс);
    КонецЕсли;

    Возврат Ресурс;
КонецФункции

// Создает транспорт из менеджера параметров.
// Для grpc - ОтелGrpcТранспорт (порт 4317), для http/json - ОтелHttpТранспорт (порт 4318).
//
// Параметры:
//   МенеджерПараметров - МенеджерПараметров - менеджер параметров (необязательный)
//
// Возвращаемое значение:
//   ОтелHttpТранспорт, ОтелGrpcТранспорт - транспорт для отправки телеметрии
//
Функция СоздатьТранспорт(МенеджерПараметров = Неопределено) Экспорт
    Менеджер = РазрешитьМенеджер(МенеджерПараметров);

    // OTEL_EXPORTER_OTLP_HEADERS -> otel.exporter.otlp.headers
    // Формат: key1=value1,key2=value2
    Заголовки = Неопределено;
    СтрокаЗаголовков = Менеджер.Параметр("otel.exporter.otlp.headers");
    Если СтрокаЗаголовков <> Неопределено И СтрокаЗаголовков <> "" Тогда
        Заголовки = РазобратьПарыКлючЗначение(СтрокаЗаголовков);
    КонецЕсли;

    // OTEL_EXPORTER_OTLP_COMPRESSION -> otel.exporter.otlp.compression
    // Значения: gzip, none (по умолчанию none)
    ЗначениеСжатия = Менеджер.Параметр("otel.exporter.otlp.compression");
    Компрессия = НормализоватьСжатие(ЗначениеСжатия);

    Протокол = НормализоватьПротоколOtlp(
        ПараметрИлиУмолчание(Менеджер, "otel.exporter.otlp.protocol", "http/protobuf"));

    ТаймаутПоУмолчаниюМс = 10000;
    ЗначениеТаймаута = ПараметрИлиУмолчание(
        Менеджер, "otel.exporter.otlp.timeout", "10000");
    ТаймаутМс = БезопасноеЧисло(
        ЗначениеТаймаута,
        ТаймаутПоУмолчаниюМс,
        "otel.exporter.otlp.timeout");
    МиллисекундВСекунде = 1000;
    ТаймаутСек = ТаймаутМс / МиллисекундВСекунде;

    Если Протокол = "grpc" Тогда
        АдресПоУмолчанию = "http://localhost:4317";
        Адрес = ПроверенныйАдрес(
            ПараметрИлиУмолчание(Менеджер, "otel.exporter.otlp.endpoint", АдресПоУмолчанию), Протокол);
        Если Адрес = Неопределено Тогда
            Возврат Неопределено;
        КонецЕсли;
        ПредупредитьОСжатииGrpc(Компрессия);
        НастройкиTls = СоздатьНастройкиTlsДляСигнала(Менеджер, "");
        Возврат Новый ОтелGrpcТранспорт(Адрес, НастройкиTls, Заголовки, , ТаймаутМс);
    КонецЕсли;

    АдресПоУмолчанию = "http://localhost:4318";
    Адрес = ПараметрИлиУмолчание(Менеджер, "otel.exporter.otlp.endpoint", АдресПоУмолчанию);
    РазобранныйАдрес = РазобратьСхемуURL(Адрес);
    Если РазобранныйАдрес = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат Новый ОтелHttpТранспорт(РазобранныйАдрес.Адрес, Заголовки, ТаймаутСек, , Компрессия, , Протокол, "");
КонецФункции

// Создает настроенный провайдер трассировки.
//
// Параметры:
//   МенеджерПараметров - МенеджерПараметров - менеджер параметров (необязательный)
//
// Возвращаемое значение:
//   ОтелПровайдерТрассировки - настроенный провайдер трассировки
//
Функция СоздатьПровайдерТрассировки(МенеджерПараметров = Неопределено) Экспорт
    Менеджер = РазрешитьМенеджер(МенеджерПараметров);

    Ресурс = ПолучитьРесурс(Менеджер);

    // Сэмплер и лимиты действуют и без экспортера: решение сэмплера задает флаг sampled,
    // который передается дальше, а спаны получают процессоры, добавленные в коде

    // Определяем стратегию семплирования
    СтратегияСэмплирования = Неопределено;
    ДоляСэмплирования = 1.0;
    КорневаяСтратегия = Неопределено;

    ИмяСэмплера = Менеджер.Параметр("otel.traces.sampler");
    Если ИмяСэмплера = Неопределено ИЛИ ИмяСэмплера = "" Тогда
        // default sampler MUST be ParentBased(root=AlwaysOn)
        СтратегияСэмплирования = ОтелСэмплер.НаОсновеРодителя();
        КорневаяСтратегия = ОтелСэмплер.ВсегдаВключен();
    Иначе
        ИмяСэмплераНорм = НРег(ИмяСэмплера);
        КлючАргументаСэмплера = "otel.traces.sampler.arg";
        ДоляСэмплированияПоУмолчанию = 1.0;
        ПроверитьЛишнийАргументСэмплера(Менеджер, ИмяСэмплераНорм, КлючАргументаСэмплера);
        // BSLLS:IfElseDuplicatedCodeBlock-off
        Если ИмяСэмплераНорм = "always_on" Тогда
            СтратегияСэмплирования = ОтелСэмплер.ВсегдаВключен();
        ИначеЕсли ИмяСэмплераНорм = "always_off" Тогда
            СтратегияСэмплирования = ОтелСэмплер.ВсегдаВыключен();
        ИначеЕсли ИмяСэмплераНорм = "traceidratio" Тогда
            СтратегияСэмплирования = ОтелСэмплер.ПоДолеТрассировок();
            ДоляСэмплирования = ДоляСэмплированияИзАргумента(
                Менеджер, КлючАргументаСэмплера, ДоляСэмплированияПоУмолчанию);
        ИначеЕсли ИмяСэмплераНорм = "parentbased_always_on" Тогда
            СтратегияСэмплирования = ОтелСэмплер.НаОсновеРодителя();
            КорневаяСтратегия = ОтелСэмплер.ВсегдаВключен();
        ИначеЕсли ИмяСэмплераНорм = "parentbased_always_off" Тогда
            СтратегияСэмплирования = ОтелСэмплер.НаОсновеРодителя();
            КорневаяСтратегия = ОтелСэмплер.ВсегдаВыключен();
        ИначеЕсли ИмяСэмплераНорм = "parentbased_traceidratio" Тогда
            СтратегияСэмплирования = ОтелСэмплер.НаОсновеРодителя();
            КорневаяСтратегия = ОтелСэмплер.ПоДолеТрассировок();
            ДоляСэмплирования = ДоляСэмплированияИзАргумента(
                Менеджер, КлючАргументаСэмплера, ДоляСэмплированияПоУмолчанию);
        ИначеЕсли ИмяСэмплераНорм = "jaeger_remote" ИЛИ ИмяСэмплераНорм = "parentbased_jaeger_remote" Тогда
            Лог.Предупреждение(
                "Сэмплер ""%1"" не поддерживается в данной реализации,"
                    + " используется parentbased_always_on",
                ИмяСэмплера);
            СтратегияСэмплирования = ОтелСэмплер.НаОсновеРодителя();
            КорневаяСтратегия = ОтелСэмплер.ВсегдаВключен();
        Иначе
            Лог.Предупреждение(
                "Нераспознанное значение otel.traces.sampler ""%1"","
                    + " используется parentbased_always_on",
                ИмяСэмплера);
            СтратегияСэмплирования = ОтелСэмплер.НаОсновеРодителя();
            КорневаяСтратегия = ОтелСэмплер.ВсегдаВключен();
        КонецЕсли;
        // BSLLS:IfElseDuplicatedCodeBlock-on
    КонецЕсли;

    ЛимитыСпана = СоздатьЛимитыСпана(Менеджер);
    Процессор = ПакетныйПроцессорСпанов(Менеджер);

    Возврат Новый ОтелПровайдерТрассировки(
        Ресурс, Процессор,
        СтратегияСэмплирования, ДоляСэмплирования,
        КорневаяСтратегия, ЛимитыСпана);
КонецФункции

// Создает настроенный провайдер логирования.
//
// Параметры:
//   МенеджерПараметров - МенеджерПараметров - менеджер параметров (необязательный)
//
// Возвращаемое значение:
//   ОтелПровайдерЛогирования - настроенный провайдер логирования
//
Функция СоздатьПровайдерЛогирования(МенеджерПараметров = Неопределено) Экспорт
    Менеджер = РазрешитьМенеджер(МенеджерПараметров);

    Ресурс = ПолучитьРесурс(Менеджер);

    // Лимиты действуют и без экспортера: записи получают процессоры, добавленные в коде
    ЛимитыЗаписейЛога = СоздатьЛимитыЗаписейЛога(Менеджер);
    Процессор = ПакетныйПроцессорЛогов(Менеджер);

    Возврат Новый ОтелПровайдерЛогирования(Ресурс, Процессор, ЛимитыЗаписейЛога);
КонецФункции

// Создает настроенный провайдер метрик.
//
// Параметры:
//   МенеджерПараметров - МенеджерПараметров - менеджер параметров (необязательный)
//
// Возвращаемое значение:
//   ОтелПровайдерМетрик - настроенный провайдер метрик
//
Функция СоздатьПровайдерМетрик(МенеджерПараметров = Неопределено) Экспорт
    Менеджер = РазрешитьМенеджер(МенеджерПараметров);

    Ресурс = ПолучитьРесурс(Менеджер);
    ФильтрЭкземпляров = ФильтрЭкземпляровИзКонфигурации(Менеджер);

    ЭкспортерИмя = НормализоватьИмяЭкспортера(
        ПараметрИлиУмолчание(Менеджер, "otel.metrics.exporter", "otlp"), "otel.metrics.exporter");
    Если ЭкспортерИмя = "none" Тогда
        Возврат Новый ОтелПровайдерМетрик(Ресурс, , ФильтрЭкземпляров);
    КонецЕсли;

    ДанныеТранспорта = СоздатьТранспортДляСигнала(Менеджер, "metrics");
    Если ДанныеТранспорта.Транспорт = Неопределено Тогда
        Возврат Новый ОтелПровайдерМетрик(Ресурс, , ФильтрЭкземпляров);
    КонецЕсли;

    // Определяем селектор временной агрегации
    ЗначениеПредпочтения = ПараметрИлиУмолчание(Менеджер,
        "otel.exporter.otlp.metrics.temporality.preference",
        "cumulative");
    ПредпочтениеВременнойАгрегации = СтрЗаменить(НРег(ЗначениеПредпочтения), "_", "");
    Если ПредпочтениеВременнойАгрегации = "delta" Тогда
        Селектор = ОтелСелекторВременнойАгрегации.ПредпочтительноДельта();
    ИначеЕсли ПредпочтениеВременнойАгрегации = "lowmemory" Тогда
        Селектор = ОтелСелекторВременнойАгрегации.НизкоеПотреблениеПамяти();
    Иначе
        Если ПредпочтениеВременнойАгрегации <> "cumulative" Тогда
            Лог.Предупреждение(
                "Нераспознанное значение otel.exporter.otlp.metrics.temporality.preference: %1,"
                    + " используется cumulative",
                ЗначениеПредпочтения);
        КонецЕсли;
        Селектор = ОтелСелекторВременнойАгрегации.ВсегдаКумулятивная();
    КонецЕсли;

    // Агрегация гистограмм - настройка OTLP-экспортера: читатель берет ее у экспортера
    ЗначениеАгрегации = ПараметрИлиУмолчание(Менеджер,
        "otel.exporter.otlp.metrics.default.histogram.aggregation",
        "explicit_bucket_histogram");
    АгрегацияГистограмм = НормализоватьАгрегациюГистограмм(ЗначениеАгрегации);
    // Транспорт создан автоконфигурацией: экспортер закрывает его вместе с собой
    Экспортер = Новый ОтелЭкспортерМетрик(ДанныеТранспорта.Транспорт, Селектор,
        ДанныеТранспорта.ПутьСигнала, ДанныеТранспорта.ТаймаутМс, АгрегацияГистограмм, Истина);

    ИнтервалЭкспортаМетрикПоУмолчаниюМс = 60000;
    ЗначениеИнтервала = ПараметрИлиУмолчание(Менеджер,
        "otel.metric.export.interval", "60000");
    ИнтервалЭкспортаМс = БезопасноеЧисло(
        ЗначениеИнтервала,
        ИнтервалЭкспортаМетрикПоУмолчаниюМс,
        "otel.metric.export.interval");
    ТаймаутЭкспортаМетрикПоУмолчаниюМс = 30000;
    ЗначениеТаймаута = ПараметрИлиУмолчание(Менеджер,
        "otel.metric.export.timeout", "30000");
    ТаймаутЭкспортаМс = БезопасноеЧисло(
        ЗначениеТаймаута,
        ТаймаутЭкспортаМетрикПоУмолчаниюМс,
        "otel.metric.export.timeout");
    ЛимитМощностиПоУмолчанию = 2000;
    Читатель = Новый ОтелПериодическийЧитательМетрик(Экспортер, ИнтервалЭкспортаМс, ЛимитМощностиПоУмолчанию);
    Читатель.УстановитьТаймаутЭкспортаМс(ТаймаутЭкспортаМс);
    Читатель.Запустить();

    Провайдер = Новый ОтелПровайдерМетрик(Ресурс, Читатель, ФильтрЭкземпляров);
    Провайдер.УстановитьАгрегациюГистограммПоУмолчанию(АгрегацияГистограмм);
    Возврат Провайдер;
КонецФункции

// Создает пропагаторы контекста из конфигурации.
// Читает otel.propagators (по умолчанию "tracecontext,baggage").
// Поддерживаемые значения: tracecontext, baggage, b3, b3multi, none.
// Для b3/b3multi требуется установка отдельного пакета opentelemetry-propagator-b3.
// "none" отключает пропагаторы; указанные вместе с ним значения игнорируются с предупреждением.
//
// Параметры:
//   МенеджерПараметров - МенеджерПараметров - менеджер параметров (необязательный)
//
// Возвращаемое значение:
//   ОтелКомпозитныйПропагатор, ОтелНоопПропагатор - пропагатор; для "none" - ОтелНоопПропагатор
//
Функция СоздатьПропагаторы(МенеджерПараметров = Неопределено) Экспорт
    Менеджер = РазрешитьМенеджер(МенеджерПараметров);

    СтрокаПропагаторов = Менеджер.Параметр("otel.propagators");
    Если СтрокаПропагаторов = Неопределено ИЛИ СтрокаПропагаторов = "" Тогда
        СтрокаПропагаторов = "tracecontext,baggage";
    КонецЕсли;

    ИменаПропагаторов = СтрРазделить(СтрокаПропагаторов, ",");

    СодержитNone = Ложь;
    Для Каждого Имя Из ИменаПропагаторов Цикл
        Если НРег(СокрЛП(Имя)) = "none" Тогда
            СодержитNone = Истина;
            Прервать;
        КонецЕсли;
    КонецЦикла;

    Если СодержитNone Тогда
        Если ИменаПропагаторов.Количество() > 1 Тогда
            Лог.Предупреждение(
                "otel.propagators ""%1"": ""none"" отключает пропагаторы, остальные значения игнорируются",
                СтрокаПропагаторов);
        КонецЕсли;
        // Без пропагатора SDK глобально действовали бы пропагаторы по умолчанию
        Возврат Новый ОтелНоопПропагатор();
    КонецЕсли;

    МассивПропагаторов = Новый Массив();
    ВиденныеИмена = Новый Соответствие();
    Для Каждого Имя Из ИменаПропагаторов Цикл
        ИмяОчищенное = НРег(СокрЛП(Имя));
        Если ВиденныеИмена.Получить(ИмяОчищенное) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;
        ВиденныеИмена.Вставить(ИмяОчищенное, Истина);
        ДобавитьПропагатор(МассивПропагаторов, ИмяОчищенное, СокрЛП(Имя));
    КонецЦикла;

    Возврат Новый ОтелКомпозитныйПропагатор(МассивПропагаторов);
КонецФункции

// Создает лимиты спана из менеджера параметров.
// Читает otel.span.attribute.count.limit (с фолбэком на otel.attribute.count.limit, по умолчанию 128)
// и otel.span.attribute.value.length.limit (с фолбэком на otel.attribute.value.length.limit,
// по умолчанию без ограничения).
//
// Параметры:
//   МенеджерПараметров - МенеджерПараметров - менеджер параметров (необязательный)
//
// Возвращаемое значение:
//   ОтелЛимитыСпана - лимиты спана из конфигурации
//
Функция СоздатьЛимитыСпана(МенеджерПараметров = Неопределено) Экспорт
    Менеджер = РазрешитьМенеджер(МенеджерПараметров);

    ЛимитАтрибутовПоУмолчанию = 128;

    // OTEL_SPAN_ATTRIBUTE_* перекрывают общие OTEL_ATTRIBUTE_*; некорректное
    // специфичное значение считается незаданным
    МаксАтрибутов = ЧислоСОткатом(Менеджер,
        "otel.span.attribute.count.limit", "otel.attribute.count.limit", ЛимитАтрибутовПоУмолчанию);
    МаксДлинаЗначения = ЧислоСОткатом(Менеджер,
        "otel.span.attribute.value.length.limit", "otel.attribute.value.length.limit", Неопределено);

    МаксСобытий = БезопасноеЧисло(
        Менеджер.Параметр("otel.span.event.count.limit"),
        ЛимитАтрибутовПоУмолчанию,
        "otel.span.event.count.limit");
    МаксЛинков = БезопасноеЧисло(
        Менеджер.Параметр("otel.span.link.count.limit"),
        ЛимитАтрибутовПоУмолчанию,
        "otel.span.link.count.limit");
    МаксАтрибутовНаСобытие = БезопасноеЧисло(
        Менеджер.Параметр("otel.event.attribute.count.limit"),
        ЛимитАтрибутовПоУмолчанию,
        "otel.event.attribute.count.limit");
    МаксАтрибутовНаЛинк = БезопасноеЧисло(
        Менеджер.Параметр("otel.link.attribute.count.limit"),
        ЛимитАтрибутовПоУмолчанию,
        "otel.link.attribute.count.limit");

    Возврат Новый ОтелЛимитыСпана()
        .УстановитьМаксАтрибутов(МаксАтрибутов)
        .УстановитьМаксДлинаЗначенияАтрибута(МаксДлинаЗначения)
        .УстановитьМаксСобытий(МаксСобытий)
        .УстановитьМаксЛинков(МаксЛинков)
        .УстановитьМаксАтрибутовНаСобытие(МаксАтрибутовНаСобытие)
        .УстановитьМаксАтрибутовНаЛинк(МаксАтрибутовНаЛинк);
КонецФункции

// Создает транспорт для конкретного сигнала с поддержкой per-signal переменных окружения.
// По спецификации OTel каждая конфигурационная опция OTLP экспортера MUST быть
// переопределяема per-signal вариантом (otel.exporter.otlp.{signal}.{option}).
// Для per-signal endpoint URL используется как есть (without modification).
// Если per-signal URL не содержит пути - добавляется корневой путь /.
//
// Параметры:
//   МенеджерПараметров - МенеджерПараметров - менеджер параметров
//   Сигнал - Строка - имя сигнала: "traces", "logs" или "metrics"
//
// Возвращаемое значение:
//   Структура - структура с ключами:
//     * Транспорт - ОтелHttpТранспорт, ОтелGrpcТранспорт - транспорт
//     * ПутьСигнала - Строка - путь для отправки данных ("" для per-signal endpoint, "/v1/{signal}" для generic)
//
Функция СоздатьТранспортДляСигнала(МенеджерПараметров, Знач Сигнал) Экспорт
    Менеджер = РазрешитьМенеджер(МенеджерПараметров);

    ПротоколGrpc = "grpc";
    ПрефиксСигнала = "otel.exporter.otlp." + Сигнал + ".";

    // Протокол и сжатие сигнала перекрывают общие; нераспознанное значение сигнала
    // считается незаданным
    НормализованныйПротокол = РаспознатьПротоколOtlp(Менеджер.Параметр(ПрефиксСигнала + "protocol"));
    Если НормализованныйПротокол = Неопределено Тогда
        НормализованныйПротокол = НормализоватьПротоколOtlp(
            ПараметрИлиУмолчание(Менеджер, "otel.exporter.otlp.protocol", "http/protobuf"));
    КонецЕсли;

    // Заголовки: per-signal перекрывает generic
    Заголовки = Неопределено;
    СтрокаЗаголовков = ПараметрСигналаИлиОбщий(
        Менеджер, Сигнал, "headers", "");
    Если СтрокаЗаголовков <> "" Тогда
        Заголовки = РазобратьПарыКлючЗначение(СтрокаЗаголовков);
    КонецЕсли;

    Сжатие = РаспознатьСжатие(Менеджер.Параметр(ПрефиксСигнала + "compression"));
    Если Сжатие = Неопределено Тогда
        Сжатие = РаспознатьСжатие(Менеджер.Параметр("otel.exporter.otlp.compression"));
    КонецЕсли;
    Компрессия = ?(Сжатие = "gzip", Сжатие, Неопределено);

    // Endpoint: проверяем per-signal первым
    КлючАдресаСигнала = "otel.exporter.otlp."
        + Сигнал + ".endpoint";
    АдресСигнала = Менеджер.Параметр(КлючАдресаСигнала);

    ЕстьАдресСигнала = АдресСигнала <> Неопределено
        И АдресСигнала <> "";

    Если ЕстьАдресСигнала И НормализованныйПротокол = ПротоколGrpc Тогда
        // gRPC: адрес сигнала - цель соединения, сервис сигнала выбирается по пути
        Адрес = АдресСигнала;
        ПутьСигнала = "/v1/" + Сигнал;
    ИначеЕсли ЕстьАдресСигнала Тогда
        // Per-signal: URL используется как есть; если нет пути - добавляем /
        Адрес = НормализоватьURLДляPerSignal(АдресСигнала);
        ПутьСигнала = "";
    Иначе
        // Generic: базовый URL + /v1/{signal}
        Если НормализованныйПротокол = ПротоколGrpc Тогда
            АдресПоУмолчанию = "http://localhost:4317";
        Иначе
            АдресПоУмолчанию = "http://localhost:4318";
        КонецЕсли;
        Адрес = ПараметрИлиУмолчание(Менеджер,
            "otel.exporter.otlp.endpoint",
            АдресПоУмолчанию);
        ПутьСигнала = "/v1/" + Сигнал;
    КонецЕсли;

    // Проверяем схему URL: http/https допустимы, иначе noop
    Адрес = ПроверенныйАдрес(Адрес, НормализованныйПротокол);
    Если Адрес = Неопределено Тогда
        Возврат Новый Структура("Транспорт, ПутьСигнала, ТаймаутМс",
            Неопределено, ПутьСигнала, 0);
    КонецЕсли;

    // Создаем транспорт
    ТаймаутТранспортаПоУмолчаниюМс = 10000;
    ТаймаутМс = ЧислоСОткатом(Менеджер,
        ПрефиксСигнала + "timeout", "otel.exporter.otlp.timeout", ТаймаутТранспортаПоУмолчаниюМс);
    МиллисекундВСекунде = 1000;
    ТаймаутСек = ТаймаутМс / МиллисекундВСекунде;

    Если НормализованныйПротокол = ПротоколGrpc Тогда
        ПредупредитьОСжатииGrpc(Компрессия);
        НастройкиTls = СоздатьНастройкиTlsДляСигнала(Менеджер, Сигнал);
        Транспорт = Новый ОтелGrpcТранспорт(Адрес, НастройкиTls, Заголовки, , ТаймаутМс);
    Иначе
        ПротоколHTTP = НормализованныйПротокол;
        Транспорт = Новый ОтелHttpТранспорт(
            Адрес, Заголовки, ТаймаутСек, , Компрессия,
            СоздатьНастройкиTlsДляСигнала(Менеджер, Сигнал), ПротоколHTTP, Сигнал);
    КонецЕсли;

    Возврат Новый Структура("Транспорт, ПутьСигнала, ТаймаутМс",
        Транспорт, ПутьСигнала, ТаймаутМс);
КонецФункции

// Создает лимиты записей лога из менеджера параметров.
// Читает otel.logrecord.attribute.count.limit (по умолчанию 128),
// с фолбэком на otel.attribute.count.limit (по умолчанию 128),
// и otel.logrecord.attribute.value.length.limit
// с фолбэком на otel.attribute.value.length.limit (по умолчанию без ограничения).
//
// Параметры:
//   МенеджерПараметров - МенеджерПараметров - менеджер параметров (необязательный)
//
// Возвращаемое значение:
//   ОтелЛимитыЗаписейЛога - лимиты записей лога из конфигурации
//
Функция СоздатьЛимитыЗаписейЛога(МенеджерПараметров = Неопределено) Экспорт
    Менеджер = РазрешитьМенеджер(МенеджерПараметров);

    ЛимитАтрибутовПоУмолчанию = 128;

    // OTEL_LOGRECORD_ATTRIBUTE_* перекрывают общие OTEL_ATTRIBUTE_*; некорректное
    // специфичное значение считается незаданным
    МаксАтрибутов = ЧислоСОткатом(Менеджер,
        "otel.logrecord.attribute.count.limit", "otel.attribute.count.limit", ЛимитАтрибутовПоУмолчанию);
    МаксДлинаЗначения = ЧислоСОткатом(Менеджер,
        "otel.logrecord.attribute.value.length.limit", "otel.attribute.value.length.limit", Неопределено);

    Возврат Новый ОтелЛимитыЗаписейЛога()
        .УстановитьМаксАтрибутов(МаксАтрибутов)
        .УстановитьМаксДлинаЗначенияАтрибута(МаксДлинаЗначения);
КонецФункции

// Разбирает строку формата key1=value1,key2=value2 в Соответствие.
// Делегирует выполнение в ОтелКонфигурационнаяФабрика.РазобратьПарыКлючЗначение.
//
// Параметры:
//   Строка - Строка - строка в формате key1=value1,key2=value2
//
// Возвращаемое значение:
//   Соответствие - разобранные пары ключ-значение
//
Функция РазобратьПарыКлючЗначение(Знач Строка) Экспорт
    Возврат ОтелКонфигурационнаяФабрика.РазобратьПарыКлючЗначение(Строка);
КонецФункции

// Разбирает OTLP endpoint URL и проверяет схему.
// Поддерживаемые схемы: http, https. При отсутствии схемы подставляется http://.
// Для неподдерживаемой схемы возвращает Неопределено и логирует ошибку.
//
// Примечание (OTLP Exporter / gRPC): спецификация говорит, что опция SHOULD принимать
// любые формы, поддерживаемые underlying gRPC-клиентом (например, dns:///, unix://,
// ipv4:host:port). Используемый нами OPI_GRPC (tonic-based) принимает только адреса
// в URI-форме со схемами http/https, поэтому фактический набор поддерживаемых схем
// уже совпадает с возможностями underlying-клиента. Адрес gRPC без схемы этой функцией
// не разбирается: схему ему задает транспорт по Insecure (см. ПроверенныйАдрес).
//
// Параметры:
//   Адрес - Строка - URL (например, "https://otel:4318", "otel:4318", "ftp://host")
//
// Возвращаемое значение:
//   Структура - { Адрес: Строка, Схема: Строка } или Неопределено если схема не поддерживается
//
Функция РазобратьСхемуURL(Знач Адрес) Экспорт
    ПозицияПротокола = СтрНайти(Адрес, "://");
    Если ПозицияПротокола = 0 Тогда
        Лог.Информация("OTLP endpoint ""%1"" без схемы, используется http://", Адрес);
        Возврат Новый Структура("Адрес, Схема", "http://" + Адрес, "http");
    КонецЕсли;

    Схема = НРег(Лев(Адрес, ПозицияПротокола - 1));
    Если Схема = "http" ИЛИ Схема = "https" Тогда
        Возврат Новый Структура("Адрес, Схема", Адрес, Схема);
    КонецЕсли;

    Лог.Ошибка("OTLP endpoint ""%1"": неподдерживаемая схема ""%2"", экспортер не будет создан",
        Адрес, Схема);
    Возврат Неопределено;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ===== ВНУТРЕННИЕ ФУНКЦИИ =====

// Создает пакетный процессор спанов с OTLP-экспортером по параметрам otel.traces.exporter и
// otel.bsp.* и запускает его фоновый экспорт.
//
// Параметры:
//   Менеджер - МенеджерПараметров - менеджер параметров
//
// Возвращаемое значение:
//   ОтелПакетныйПроцессорСпанов, Неопределено - процессор; Неопределено при экспортере none или
//       недоступном транспорте
//
Функция ПакетныйПроцессорСпанов(Менеджер)
    ЭкспортерИмя = НормализоватьИмяЭкспортера(
        ПараметрИлиУмолчание(Менеджер, "otel.traces.exporter", "otlp"), "otel.traces.exporter");
    Если ЭкспортерИмя = "none" Тогда
        Возврат Неопределено;
    КонецЕсли;

    ДанныеТранспорта = СоздатьТранспортДляСигнала(Менеджер, "traces");
    Если ДанныеТранспорта.Транспорт = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    // Транспорт создан автоконфигурацией: экспортер закрывает его вместе с собой
    Экспортер = Новый ОтелЭкспортерСпанов(
        ДанныеТранспорта.Транспорт, ДанныеТранспорта.ПутьСигнала, ДанныеТранспорта.ТаймаутМс, Истина);

    РазмерОчередиПоУмолчанию = 2048;
    РазмерПакетаПоУмолчанию = 512;
    ТаймаутЭкспортаПоУмолчаниюМс = 30000;
    ЗадержкаЭкспортаСпановПоУмолчаниюМс = 5000;

    ЗначениеОчереди = ПараметрИлиУмолчание(
        Менеджер, "otel.bsp.max.queue.size", "2048");
    МаксРазмерОчереди = ПоложительноеЧисло(
        ЗначениеОчереди,
        РазмерОчередиПоУмолчанию,
        "otel.bsp.max.queue.size");

    ЗначениеИнтервала = ПараметрИлиУмолчание(
        Менеджер, "otel.bsp.schedule.delay", "5000");
    ИнтервалЭкспорта = БезопасноеЧисло(
        ЗначениеИнтервала,
        ЗадержкаЭкспортаСпановПоУмолчаниюМс,
        "otel.bsp.schedule.delay");

    ЗначениеПакета = ПараметрИлиУмолчание(Менеджер,
        "otel.bsp.max.export.batch.size", "512");
    МаксРазмерПакета = ПоложительноеЧисло(
        ЗначениеПакета,
        РазмерПакетаПоУмолчанию,
        "otel.bsp.max.export.batch.size");
    МаксРазмерПакета = РазмерПакетаНеБольшеОчереди(
        МаксРазмерПакета, МаксРазмерОчереди, "otel.bsp");

    ЗначениеТаймаута = ПараметрИлиУмолчание(
        Менеджер, "otel.bsp.export.timeout", "30000");
    ТаймаутЭкспорта = БезопасноеЧисло(
        ЗначениеТаймаута,
        ТаймаутЭкспортаПоУмолчаниюМс,
        "otel.bsp.export.timeout");

    Базовый = Новый ОтелБазовыйПакетныйПроцессор(
        Экспортер, "traces", МаксРазмерОчереди, МаксРазмерПакета, ИнтервалЭкспорта, ТаймаутЭкспорта);
    Процессор = Новый ПостроительНаследника(Новый ОтелПакетныйПроцессорСпанов(), Базовый).Построить();
    Процессор.ЗапуститьФоновыйЭкспорт();
    Возврат Процессор;
КонецФункции

// Создает пакетный процессор записей логов с OTLP-экспортером по параметрам otel.logs.exporter и
// otel.blrp.* и запускает его фоновый экспорт.
//
// Параметры:
//   Менеджер - МенеджерПараметров - менеджер параметров
//
// Возвращаемое значение:
//   ОтелПакетныйПроцессорЛогов, Неопределено - процессор; Неопределено при экспортере none или
//       недоступном транспорте
//
Функция ПакетныйПроцессорЛогов(Менеджер)
    ЭкспортерИмя = НормализоватьИмяЭкспортера(
        ПараметрИлиУмолчание(Менеджер, "otel.logs.exporter", "otlp"), "otel.logs.exporter");
    Если ЭкспортерИмя = "none" Тогда
        Возврат Неопределено;
    КонецЕсли;

    ДанныеТранспорта = СоздатьТранспортДляСигнала(Менеджер, "logs");
    Если ДанныеТранспорта.Транспорт = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    // Транспорт создан автоконфигурацией: экспортер закрывает его вместе с собой
    Экспортер = Новый ОтелЭкспортерЛогов(
        ДанныеТранспорта.Транспорт, ДанныеТранспорта.ПутьСигнала, ДанныеТранспорта.ТаймаутМс, Истина);

    РазмерОчередиПоУмолчанию = 2048;
    РазмерПакетаПоУмолчанию = 512;
    ТаймаутЭкспортаПоУмолчаниюМс = 30000;
    ЗадержкаЭкспортаЛоговПоУмолчаниюМс = 1000;

    ЗначениеОчереди = ПараметрИлиУмолчание(
        Менеджер, "otel.blrp.max.queue.size", "2048");
    МаксРазмерОчереди = ПоложительноеЧисло(
        ЗначениеОчереди,
        РазмерОчередиПоУмолчанию,
        "otel.blrp.max.queue.size");

    ЗначениеИнтервала = ПараметрИлиУмолчание(
        Менеджер, "otel.blrp.schedule.delay", "1000");
    ИнтервалЭкспорта = БезопасноеЧисло(
        ЗначениеИнтервала,
        ЗадержкаЭкспортаЛоговПоУмолчаниюМс,
        "otel.blrp.schedule.delay");

    ЗначениеПакета = ПараметрИлиУмолчание(Менеджер,
        "otel.blrp.max.export.batch.size", "512");
    МаксРазмерПакета = ПоложительноеЧисло(
        ЗначениеПакета,
        РазмерПакетаПоУмолчанию,
        "otel.blrp.max.export.batch.size");
    МаксРазмерПакета = РазмерПакетаНеБольшеОчереди(
        МаксРазмерПакета, МаксРазмерОчереди, "otel.blrp");

    ЗначениеТаймаута = ПараметрИлиУмолчание(
        Менеджер, "otel.blrp.export.timeout", "30000");
    ТаймаутЭкспорта = БезопасноеЧисло(
        ЗначениеТаймаута,
        ТаймаутЭкспортаПоУмолчаниюМс,
        "otel.blrp.export.timeout");

    Базовый = Новый ОтелБазовыйПакетныйПроцессор(
        Экспортер, "logs", МаксРазмерОчереди, МаксРазмерПакета, ИнтервалЭкспорта, ТаймаутЭкспорта);
    Процессор = Новый ПостроительНаследника(Новый ОтелПакетныйПроцессорЛогов(), Базовый).Построить();
    Процессор.ЗапуститьФоновыйЭкспорт();
    Возврат Процессор;
КонецФункции

// Разрешает менеджер параметров: переданный > кэшированный > создать новый.
//
// Параметры:
//   МенеджерПараметров - МенеджерПараметров - менеджер параметров или Неопределено
//
// Возвращаемое значение:
//   МенеджерПараметров - разрешенный менеджер параметров
//
Функция РазрешитьМенеджер(МенеджерПараметров)
    Если МенеджерПараметров <> Неопределено Тогда
        Возврат ПодготовитьМенеджер(МенеджерПараметров);
    КонецЕсли;
    Если КэшМенеджер <> Неопределено Тогда
        Возврат КэшМенеджер;
    КонецЕсли;
    Возврат СоздатьМенеджерПараметровПоУмолчанию();
КонецФункции

// Обеспечивает чтение менеджера параметров.
//
// Параметры:
//   МенеджерПараметров - МенеджерПараметров - менеджер параметров для подготовки
//
// Возвращаемое значение:
//   МенеджерПараметров - подготовленный менеджер параметров
//
Функция ПодготовитьМенеджер(МенеджерПараметров)
    Если МенеджерПараметров = Неопределено Тогда
        Возврат СоздатьМенеджерПараметровПоУмолчанию();
    КонецЕсли;
    Если НЕ МенеджерПараметров.ЧтениеВыполнено() Тогда
        МенеджерПараметров.Прочитать();
    КонецЕсли;
    Возврат МенеджерПараметров;
КонецФункции

// Возвращает кэшированный ресурс или создает новый.
//
// Параметры:
//   Менеджер - МенеджерПараметров - менеджер параметров конфигурации
//
// Возвращаемое значение:
//   ОтелРесурс - ресурс телеметрии
//
Функция ПолучитьРесурс(Менеджер)
    Если КэшРесурс = Неопределено Тогда
        КэшРесурс = СоздатьРесурс(Менеджер);
    КонецЕсли;
    Возврат КэшРесурс;
КонецФункции

// Возвращает фильтр exemplars из otel.metrics.exemplar.filter. Пустое значение
// равносильно незаданному, о нераспознанном выводится предупреждение.
//
// Параметры:
//   Менеджер - МенеджерПараметров - менеджер параметров конфигурации
//
// Возвращаемое значение:
//   Число, Неопределено - константа ОтелФильтрЭкземпляров или Неопределено (фильтр по умолчанию)
//
Функция ФильтрЭкземпляровИзКонфигурации(Менеджер)
    Значение = Менеджер.Параметр("otel.metrics.exemplar.filter");
    Если Значение = Неопределено ИЛИ СокрЛП(Значение) = "" Тогда
        Возврат Неопределено;
    КонецЕсли;
    Фильтр = ОтелФильтрЭкземпляров.ИзСтроки(Значение);
    Если Фильтр = Неопределено Тогда
        Лог.Предупреждение("Нераспознанное значение otel.metrics.exemplar.filter ""%1"", игнорируется", Значение);
    КонецЕсли;
    Возврат Фильтр;
КонецФункции

// Возвращает таймаут закрытия SDK из otel.sdk.shutdown.timeout (Timeout: 0 - без ограничения).
//
// Параметры:
//   Менеджер - МенеджерПараметров - менеджер параметров конфигурации
//
// Возвращаемое значение:
//   Число - таймаут в миллисекундах
//
Функция ТаймаутЗакрытияИзКонфигурации(Менеджер)
    ТаймаутПоУмолчаниюМс = 30000;
    Возврат БезопасноеЧисло(Менеджер.Параметр("otel.sdk.shutdown.timeout"), ТаймаутПоУмолчаниюМс,
        "otel.sdk.shutdown.timeout");
КонецФункции

Функция Отключен(Менеджер)
    Значение = Менеджер.Параметр("otel.sdk.disabled");
    Если Значение = Неопределено ИЛИ Значение = "" Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат БезопасноеБулево(Значение, "otel.sdk.disabled");
КонецФункции

// Приводит протокол OTLP к нижнему регистру (значения enum читаются без учета регистра).
// Нераспознанное значение логируется, вместо него используется http/protobuf.
//
// Параметры:
//   Протокол - Строка - значение otel.exporter.otlp[.<сигнал>].protocol
//
// Возвращаемое значение:
//   Строка - "grpc", "http/protobuf" или "http/json"
//
Функция НормализоватьПротоколOtlp(Знач Протокол)
    НормализованныйПротокол = РаспознатьПротоколOtlp(Протокол);
    Возврат ?(НормализованныйПротокол = Неопределено, "http/protobuf", НормализованныйПротокол);
КонецФункции

// Распознает протокол OTLP без учета регистра. О нераспознанном значении выводит
// предупреждение: по спецификации оно игнорируется, как если бы не было задано.
//
// Параметры:
//   Протокол - Строка, Неопределено - значение otel.exporter.otlp[.<сигнал>].protocol
//
// Возвращаемое значение:
//   Строка, Неопределено - "grpc", "http/protobuf", "http/json" или Неопределено, если
//     значение не задано или не распознано
//
Функция РаспознатьПротоколOtlp(Знач Протокол)
    Если Протокол = Неопределено ИЛИ СокрЛП(Протокол) = "" Тогда
        Возврат Неопределено;
    КонецЕсли;
    НормализованныйПротокол = НРег(СокрЛП(Протокол));
    Если НормализованныйПротокол = "grpc"
        ИЛИ НормализованныйПротокол = "http/protobuf"
        ИЛИ НормализованныйПротокол = "http/json" Тогда
        Возврат НормализованныйПротокол;
    КонецЕсли;
    Лог.Предупреждение("Неизвестный протокол OTLP '%1', значение игнорируется", Протокол);
    Возврат Неопределено;
КонецФункции

// Читает долю сэмплирования из аргумента сэмплера. Некорректное значение (не число,
// вне диапазона [0; 1]) по спецификации логируется и игнорируется, как если бы
// аргумент не был задан.
//
// Параметры:
//   Менеджер - МенеджерПараметров - менеджер параметров конфигурации
//   КлючАргумента - Строка - ключ otel.traces.sampler.arg
//   Умолчание - Число - доля, если аргумент не задан или некорректен
//
// Возвращаемое значение:
//   Число - доля сэмплирования от 0 до 1
//
Функция ДоляСэмплированияИзАргумента(Менеджер, КлючАргумента, Умолчание)
    АргументСэмплера = ПараметрИлиУмолчание(Менеджер, КлючАргумента, "1.0");
    Доля = БезопасноеЧисло(АргументСэмплера, Умолчание, КлючАргумента, Ложь);
    Если Доля > 1 Тогда
        Лог.Предупреждение("Значение %1=%2 вне диапазона [0; 1], используется значение по умолчанию %3",
            КлючАргумента, АргументСэмплера, Умолчание);
        Возврат Умолчание;
    КонецЕсли;
    Возврат Доля;
КонецФункции

// Приводит агрегацию гистограмм по умолчанию к нижнему регистру. Нераспознанное
// значение логируется, вместо него используется explicit_bucket_histogram.
//
// Параметры:
//   Значение - Строка - значение otel.exporter.otlp.metrics.default.histogram.aggregation
//
// Возвращаемое значение:
//   Строка - "explicit_bucket_histogram" или "base2_exponential_bucket_histogram"
//
Функция НормализоватьАгрегациюГистограмм(Знач Значение)
    АгрегацияПоУмолчанию = "explicit_bucket_histogram";
    НормализованноеЗначение = НРег(СокрЛП(Значение));
    Если НормализованноеЗначение = АгрегацияПоУмолчанию
        ИЛИ НормализованноеЗначение = "base2_exponential_bucket_histogram" Тогда
        Возврат НормализованноеЗначение;
    КонецЕсли;
    Лог.Предупреждение(
        "Нераспознанное значение otel.exporter.otlp.metrics.default.histogram.aggregation: %1,"
            + " используется explicit_bucket_histogram",
        Значение);
    Возврат АгрегацияПоУмолчанию;
КонецФункции

// Возвращает сжатие OTLP по значению параметра: "gzip" или Неопределено (без сжатия).
// Значения gzip и none читаются без учета регистра; о нераспознанном значении
// выводится предупреждение, сжатие не используется.
//
// Параметры:
//   Значение - Строка, Неопределено - значение otel.exporter.otlp[.<сигнал>].compression
//
// Возвращаемое значение:
//   Строка, Неопределено - "gzip" или Неопределено
//
Функция НормализоватьСжатие(Знач Значение)
    Сжатие = РаспознатьСжатие(Значение);
    Возврат ?(Сжатие = "gzip", Сжатие, Неопределено);
КонецФункции

// Клиент OPI_GRPC не поддерживает сжатие
// (https://github.com/Bayselonarrend/OpenIntegrations/issues/112): о заданном для grpc сжатии
// выводит предупреждение, а не игнорирует его молча.
//
// Параметры:
//   Компрессия - Строка, Неопределено - "gzip" или Неопределено
//
Процедура ПредупредитьОСжатииGrpc(Компрессия)
    Если Компрессия <> Неопределено Тогда
        Лог.Предупреждение(
            "Сжатие OTLP '%1' для протокола grpc не поддерживается клиентом OPI_GRPC, данные отправляются без сжатия."
            + " Подробнее: https://github.com/Bayselonarrend/OpenIntegrations/issues/112",
            Компрессия);
    КонецЕсли;
КонецПроцедуры

// Распознает сжатие OTLP без учета регистра. О нераспознанном значении выводит
// предупреждение: по спецификации оно игнорируется, как если бы не было задано.
//
// Параметры:
//   Значение - Строка, Неопределено - значение otel.exporter.otlp[.<сигнал>].compression
//
// Возвращаемое значение:
//   Строка, Неопределено - "gzip", "none" или Неопределено, если значение не задано
//     или не распознано
//
Функция РаспознатьСжатие(Знач Значение)
    Если Значение = Неопределено ИЛИ СокрЛП(Значение) = "" Тогда
        Возврат Неопределено;
    КонецЕсли;
    НормализованноеЗначение = НРег(СокрЛП(Значение));
    Если НормализованноеЗначение = "gzip" ИЛИ НормализованноеЗначение = "none" Тогда
        Возврат НормализованноеЗначение;
    КонецЕсли;
    Лог.Предупреждение("Нераспознанное значение сжатия OTLP '%1', значение игнорируется", Значение);
    Возврат Неопределено;
КонецФункции

// Возвращает значение параметра или умолчание, если значение не задано или пустая строка.
// По спецификации OTel пустое значение переменной окружения эквивалентно неустановленному.
//
// Параметры:
//   Менеджер - МенеджерПараметров - менеджер параметров конфигурации
//   Ключ - Строка - ключ параметра
//   Умолчание - Произвольный - значение по умолчанию
//
// Возвращаемое значение:
//   Произвольный - значение параметра или умолчание
//
Функция ПараметрИлиУмолчание(Менеджер, Ключ, Умолчание)
    Значение = Менеджер.Параметр(Ключ);
    Если Значение = Неопределено ИЛИ Значение = "" Тогда
        Возврат Умолчание;
    КонецЕсли;
    Возврат Значение;
КонецФункции

// Безопасно преобразует строку в число.
// При невалидном значении логирует предупреждение и возвращает умолчание.
//
// Параметры:
//   Значение - Строка - строковое значение для преобразования
//   Умолчание - Число - значение по умолчанию при ошибке преобразования
//   ИмяПараметра - Строка - имя параметра для логирования
//   Целое - Булево - значение должно быть целым (Integer, Duration, Timeout спецификации)
//
// Возвращаемое значение:
//   Число - преобразованное число или умолчание
//
Функция БезопасноеЧисло(Знач Значение, Знач Умолчание, Знач ИмяПараметра, Знач Целое = Истина)
    Если Значение = Неопределено Или СокрЛП(Строка(Значение)) = "" Тогда
        Возврат Умолчание;
    КонецЕсли;
    Результат = Новый ОписаниеТипов("Число").ПривестиЗначение(Значение);
    // Нераспознанная строка приводится к 0, поэтому 0 допустим только для записи нуля
    Если Результат = 0 И НЕ ЭтоЗаписьНуля(СокрЛП(Строка(Значение))) Тогда
        Причина = "невалидное числовое значение";
    ИначеЕсли Результат < 0 Тогда
        Причина = "отрицательное числовое значение";
    ИначеЕсли Целое И Результат <> Цел(Результат) Тогда
        Причина = "значение должно быть целым числом";
    Иначе
        Возврат Результат;
    КонецЕсли;
    Лог.Предупреждение("Значение ""%1"" для %2 игнорируется (%3), используется значение по умолчанию %4",
        Значение, ИмяПараметра, Причина, Умолчание);
    Возврат Умолчание;
КонецФункции

// Возвращает целое значение специфичного параметра, а если оно не задано или некорректно -
// значение общего параметра, иначе умолчание. По спецификации некорректное значение
// считается незаданным, поэтому действует общая настройка.
//
// Параметры:
//   Менеджер - МенеджерПараметров - менеджер параметров конфигурации
//   КлючСпецифичный - Строка - ключ специфичного параметра (сигнала, спана, записи лога)
//   КлючОбщий - Строка - ключ общего параметра
//   Умолчание - Число - значение по умолчанию
//
// Возвращаемое значение:
//   Число
//
Функция ЧислоСОткатом(Менеджер, Знач КлючСпецифичный, Знач КлючОбщий, Знач Умолчание)
    ОбщееЗначение = БезопасноеЧисло(Менеджер.Параметр(КлючОбщий), Умолчание, КлючОбщий);
    Возврат БезопасноеЧисло(Менеджер.Параметр(КлючСпецифичный), ОбщееЗначение, КлючСпецифичный);
КонецФункции

// Проверяет, что строка - десятичная запись нуля: "0", "00", "0.00", "-0.0", ".0".
//
// Параметры:
//   Запись - Строка - строка без ведущих и завершающих пробелов
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоЗаписьНуля(Знач Запись)
    Если СтрНачинаетсяС(Запись, "-") ИЛИ СтрНачинаетсяС(Запись, "+") Тогда
        Запись = Прав(Запись, СтрДлина(Запись) - 1);
    КонецЕсли;
    БезТочки = СтрЗаменить(Запись, ".", "");
    Если БезТочки = "" ИЛИ СтрДлина(Запись) - СтрДлина(БезТочки) > 1 Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат СтрЗаменить(БезТочки, "0", "") = "";
КонецФункции

// Безопасно преобразует значение параметра, который должен быть целым числом больше нуля
// (размер очереди или пакета). Недопустимое значение (меньше 1 или дробное) по
// спецификации логируется и игнорируется: используется значение по умолчанию.
//
// Параметры:
//   Значение - Строка - строковое значение для преобразования
//   Умолчание - Число - значение по умолчанию
//   ИмяПараметра - Строка - имя env-переменной для логирования
//
// Возвращаемое значение:
//   Число - целое значение не меньше 1
//
Функция ПоложительноеЧисло(Знач Значение, Знач Умолчание, Знач ИмяПараметра)
    Результат = БезопасноеЧисло(Значение, Умолчание, ИмяПараметра);
    Если Результат < 1 ИЛИ Результат <> Цел(Результат) Тогда
        Лог.Предупреждение(
            "Значение ""%1"" для %2 должно быть целым числом больше нуля, используется значение по умолчанию %3",
            Значение, ИмяПараметра, Умолчание);
        Возврат Умолчание;
    КонецЕсли;
    Возврат Результат;
КонецФункции

// Проверяет, что размер пакета не больше размера очереди (требование спецификации:
// иначе пакет не наберется и выгрузка по заполнению очереди не сработает). Больший
// размер пакета логируется и заменяется размером очереди.
//
// Параметры:
//   РазмерПакета - Число - max.export.batch.size
//   РазмерОчереди - Число - max.queue.size
//   ПрефиксПараметров - Строка - префикс параметров процессора для логирования (otel.bsp, otel.blrp)
//
// Возвращаемое значение:
//   Число - размер пакета не больше размера очереди
//
Функция РазмерПакетаНеБольшеОчереди(Знач РазмерПакета, Знач РазмерОчереди, Знач ПрефиксПараметров)
    Если РазмерПакета <= РазмерОчереди Тогда
        Возврат РазмерПакета;
    КонецЕсли;
    Лог.Предупреждение("%1.max.export.batch.size (%2) больше %1.max.queue.size (%3), используется %3",
        ПрефиксПараметров, РазмерПакета, РазмерОчереди);
    Возврат РазмерОчереди;
КонецФункции

// Нормализует имя экспортера сигнала: если значение не "none" и не "otlp",
// логирует предупреждение и возвращает "otlp" (graceful ignore по спецификации Env Vars).
//
// Параметры:
//   Значение - Строка - сырое значение env-переменной
//   ИмяПараметра - Строка - имя env-переменной для логирования
//
// Возвращаемое значение:
//   Строка - "none" или "otlp" в нижнем регистре
//
Функция НормализоватьИмяЭкспортера(Знач Значение, Знач ИмяПараметра)
    ИмяНорм = НРег(СокрЛП(Строка(Значение)));
    Если ИмяНорм = "none" ИЛИ ИмяНорм = "otlp" Тогда
        Возврат ИмяНорм;
    КонецЕсли;
    Лог.Предупреждение(
        "Нераспознанное значение env-переменной %1: %2, используется ""otlp""",
        ИмяПараметра, Значение);
    Возврат "otlp";
КонецФункции

// Логирует предупреждение, если для типа сэмплера, не использующего аргумент,
// задана непустая otel.traces.sampler.arg (по спецификации MUST log + ignore).
//
// Параметры:
//   Менеджер - МенеджерПараметров - менеджер параметров
//   ИмяСэмплераНорм - Строка - нормализованное имя сэмплера
//   КлючАргументаСэмплера - Строка - имя env-переменной аргумента
//
Процедура ПроверитьЛишнийАргументСэмплера(Менеджер, Знач ИмяСэмплераНорм, Знач КлючАргументаСэмплера)
    СэмплерыСАргументом = "traceidratio,parentbased_traceidratio,jaeger_remote,parentbased_jaeger_remote";
    Если СтрНайти(СэмплерыСАргументом, ИмяСэмплераНорм) > 0 Тогда
        Возврат;
    КонецЕсли;
    СырыйАргумент = Менеджер.Параметр(КлючАргументаСэмплера);
    Если СырыйАргумент <> Неопределено И СырыйАргумент <> "" Тогда
        Лог.Предупреждение(
            "%1=%2 игнорируется: сэмплер %3 не использует аргумент",
            КлючАргументаСэмплера, СырыйАргумент, ИмяСэмплераНорм);
    КонецЕсли;
КонецПроцедуры

// Безопасно преобразует строковое значение env-переменной в булево по спецификации OTel.
// По спецификации: только "true" (case-insensitive) трактуется как Истина;
// все остальные значения, включая пустые и неустановленные, MUST трактоваться как Ложь.
// При невалидном (не "true"/"false") значении логируется предупреждение.
//
// Параметры:
//   Значение - Строка - строковое значение для преобразования
//   ИмяПараметра - Строка - имя env-переменной для логирования
//
// Возвращаемое значение:
//   Булево - распарсенное значение
//
Функция БезопасноеБулево(Знач Значение, Знач ИмяПараметра)
    ЗначениеСтрока = СокрЛП(Строка(Значение));
    Если ЗначениеСтрока = "" Тогда
        Возврат Ложь;
    КонецЕсли;
    НормализованноеЗначение = НРег(ЗначениеСтрока);
    Если НормализованноеЗначение = "true" Тогда
        Возврат Истина;
    ИначеЕсли НормализованноеЗначение = "false" Тогда
        Возврат Ложь;
    Иначе
        Лог.Предупреждение(
            "Невалидное boolean значение env-переменной %1: %2, трактуется как false по спецификации",
            ИмяПараметра, ЗначениеСтрока);
    КонецЕсли;
    Возврат Ложь;
КонецФункции

// Возвращает значение per-signal параметра или generic, или умолчание.
// Порядок: otel.exporter.otlp.{signal}.{suffix} -> otel.exporter.otlp.{suffix} -> умолчание
//
// Параметры:
//   Менеджер - МенеджерПараметров - менеджер параметров конфигурации
//   Сигнал - Строка - имя сигнала (traces, logs, metrics)
//   Суффикс - Строка - суффикс ключа параметра
//   Умолчание - Произвольный - значение по умолчанию
//
// Возвращаемое значение:
//   Произвольный - значение параметра или умолчание
//
Функция ПараметрСигналаИлиОбщий(Менеджер, Знач Сигнал, Знач Суффикс, Знач Умолчание)
    КлючСигнала = "otel.exporter.otlp." + Сигнал + "." + Суффикс;
    Значение = Менеджер.Параметр(КлючСигнала);
    Если Значение <> Неопределено И Значение <> "" Тогда
        Возврат Значение;
    КонецЕсли;

    Возврат ПараметрИлиУмолчание(Менеджер, "otel.exporter.otlp." + Суффикс, Умолчание);
КонецФункции

// Нормализует URL для per-signal endpoint.
// Если URL не содержит пути - добавляет корневой путь / (перед query, если он есть).
//
// Параметры:
//   Адрес - Строка - URL адрес для нормализации
//
// Возвращаемое значение:
//   Строка - нормализованный URL
//
Функция НормализоватьURLДляPerSignal(Знач Адрес)
    ПозицияПротокола = СтрНайти(Адрес, "://");
    Если ПозицияПротокола = 0 Тогда
        Возврат Адрес;
    КонецЕсли;

    ДлинаРазделителяПротокола = 3;
    НачалоХоста = ПозицияПротокола + ДлинаРазделителяПротокола;
    ЧастьПослеПротокола = Сред(Адрес, НачалоХоста);
    ПозицияСлеша = СтрНайти(ЧастьПослеПротокола, "/");
    ПозицияЗапроса = СтрНайти(ЧастьПослеПротокола, "?");
    Если ПозицияЗапроса > 0 И (ПозицияСлеша = 0 ИЛИ ПозицияЗапроса < ПозицияСлеша) Тогда
        НачалоЗапроса = НачалоХоста + ПозицияЗапроса - 1;
        Возврат Лев(Адрес, НачалоЗапроса - 1) + "/" + Сред(Адрес, НачалоЗапроса);
    КонецЕсли;
    Если ПозицияСлеша = 0 Тогда
        Возврат Адрес + "/";
    КонецЕсли;

    Возврат Адрес;
КонецФункции

// Проверяет схему адреса коллектора: допустимы http и https (см. РазобратьСхемуURL). Адресу
// HTTP без схемы подставляется http://, адрес gRPC без схемы возвращается как есть -
// OTLP Exporter / Insecure: защищенность такого соединения задает Insecure (см. ОтелGrpcТранспорт).
//
// Параметры:
//   Адрес - Строка - адрес коллектора
//   Протокол - Строка - нормализованный протокол OTLP
//
// Возвращаемое значение:
//   Строка, Неопределено - адрес или Неопределено, если схема не поддерживается
//
Функция ПроверенныйАдрес(Знач Адрес, Знач Протокол)
    Если Протокол = "grpc" И СтрНайти(Адрес, "://") = 0 Тогда
        Возврат Адрес;
    КонецЕсли;
    РазобранныйАдрес = РазобратьСхемуURL(Адрес);
    Если РазобранныйАдрес = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат РазобранныйАдрес.Адрес;
КонецФункции

Процедура СброситьКэш()
    КэшМенеджер = Неопределено;
    КэшРесурс = Неопределено;
КонецПроцедуры

// Создает настройки TLS для конкретного сигнала из менеджера параметров.
// Per-signal env перекрывает общий.
//
// Параметры:
//   Менеджер - МенеджерПараметров - менеджер параметров конфигурации
//   Сигнал - Строка - имя сигнала (traces, logs, metrics), пустая строка - только общие параметры
//
// Возвращаемое значение:
//   ОтелНастройкиTls, Неопределено - настройки TLS или Неопределено если ни одна не задана
//
Функция СоздатьНастройкиTlsДляСигнала(Менеджер, Сигнал)
    НастройкиTls = Новый ОтелНастройкиTls();

    НастройкиTls.ФайлСертификата = ПараметрСигналаИлиОбщий(Менеджер, Сигнал, "certificate", "");
    НастройкиTls.ФайлКлиентскогоКлюча = ПараметрСигналаИлиОбщий(Менеджер, Сигнал, "client.key", "");
    НастройкиTls.ФайлКлиентскогоСертификата = ПараметрСигналаИлиОбщий(
        Менеджер, Сигнал, "client.certificate", "");

    ЗначениеInsecure = ПараметрСигналаИлиОбщий(Менеджер, Сигнал, "insecure", "");
    Если ЗначениеInsecure <> "" Тогда
        КлючInsecure = ?(Сигнал = "", "otel.exporter.otlp.insecure", "otel.exporter.otlp." + Сигнал + ".insecure");
        НастройкиTls.Insecure = БезопасноеБулево(ЗначениеInsecure, КлючInsecure);
    КонецЕсли;

    Если НастройкиTls.Применен() Тогда
        Возврат НастройкиTls;
    КонецЕсли;

    Возврат Неопределено;
КонецФункции

Функция ИнициализироватьНоопСдк()
    Ресурс = Новый ОтелРесурс();

    ПровайдерТрассировки = Новый ОтелПровайдерТрассировки(Ресурс, , ОтелСэмплер.ВсегдаВыключен());
    ПровайдерЛогирования = Новый ОтелПровайдерЛогирования(Ресурс);
    ПровайдерМетрик = Новый ОтелПровайдерМетрик(Ресурс);

    // Отключение SDK не отменяет пропагаторы из OTEL_PROPAGATORS
    Возврат Новый ОтелПостроительSdk()
        .УстановитьПровайдерТрассировки(ПровайдерТрассировки)
        .УстановитьПровайдерЛогирования(ПровайдерЛогирования)
        .УстановитьПровайдерМетрик(ПровайдерМетрик)
        .УстановитьПропагаторы(СоздатьПропагаторы())
        .УстановитьТаймаутЗакрытия(ТаймаутЗакрытияИзКонфигурации(КэшМенеджер))
        .ПостроитьИЗарегистрироватьГлобально();
КонецФункции

// Создает пропагатор по имени и добавляет в массив. Имена разбирает
// ОтелКонфигурационнаяФабрика.РазрешитьПропагаторПоИмени - так же, как для файла конфигурации.
//
// Параметры:
//   МассивПропагаторов - Массив - массив для добавления созданного пропагатора
//   ИмяОчищенное - Строка - нормализованное имя пропагатора
//   ИсходноеИмя - Строка - имя, как его задал пользователь (для предупреждения)
//
Процедура ДобавитьПропагатор(МассивПропагаторов, ИмяОчищенное, ИсходноеИмя)
    Пропагатор = ОтелКонфигурационнаяФабрика.РазрешитьПропагаторПоИмени(ИмяОчищенное, ИсходноеИмя);
    Если Пропагатор <> Неопределено Тогда
        МассивПропагаторов.Добавить(Пропагатор);
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.config");
