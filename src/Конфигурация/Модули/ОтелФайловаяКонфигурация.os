// Модуль файловой конфигурации OpenTelemetry SDK.
//
// Читает YAML-файл конфигурации, выполняет подстановку переменных окружения, проверяет файл по
// схеме opentelemetry-configuration и возвращает типизированную дата-модель (ОтелКонфигурация).
//
// Спецификация:
//   https://opentelemetry.io/docs/specs/otel/configuration/sdk/#parse
//   https://opentelemetry.io/docs/specs/otel/configuration/data-model/

#Использовать jsonschema
#Использовать logos

// Логгер logos - логгер для диагностических сообщений
Перем Лог;
// Тип - тип Соответствие для проверок ТипЗнч()
Перем ТипСоответствие;
// Строка - версия схемы opentelemetry-configuration в Схема/opentelemetry_configuration.json
Перем ВерсияСхемы;
// Число - младшая версия схемы: file_format с большей младшей версией разбирается с предупреждением
Перем МладшаяВерсияСхемы;
// JsonSchemaValidator - валидатор схемы, создается при первом разборе
Перем КэшВалидатораСхемы;
// Массив из Строка - типы сэмплеров с моделью ОтелКонфигурацияСэмплера; сэмплер другого типа разбор
// сохраняет как ОтелКонфигурацияКомпонента
Перем ВстроенныеСэмплеры;

#Область ПрограммныйИнтерфейс

// Разбирает файл конфигурации и возвращает типизированную модель.
//
// Параметры:
//   ПутьКФайлу - Строка - путь к YAML-файлу конфигурации
//
// Возвращаемое значение:
//   ОтелКонфигурация - разобранная конфигурация
//
Функция Разобрать(Знач ПутьКФайлу) Экспорт

	Лог.Информация("Чтение файла конфигурации: %1", ПутьКФайлу);

	СырыеДанные = ПрочитатьЯМЛФайл(ПутьКФайлу);
	ФорматНовееСхемы = ПроверитьФорматФайла(СырыеДанные);
	ПроверитьПоСхеме(СырыеДанные, ФорматНовееСхемы);

	Возврат ЗаполнитьКонфигурацию(СырыеДанные);

КонецФункции

// Проверяет версию формата file_format по правилам версионирования схемы (VERSIONING.md
// opentelemetry-configuration): версия - MAJOR.MINOR с необязательной меткой (1.0, 1.0-rc.2), основная
// версия должна совпадать с основной версией схемы SDK. Модель с file_format проверяет и фабрика.
//
// Параметры:
//   ФорматФайла - Строка - значение file_format
//
// Возвращаемое значение:
//   Число - младшая версия формата
//
Функция ПроверитьВерсиюФормата(Знач ФорматФайла) Экспорт

	ЧастиВерсии = СтрРазделить(СтрРазделить(Строка(ФорматФайла), "-+")[0], ".");
	МладшаяВерсия = ?(ЧастиВерсии.Количество() > 1, ЧастиВерсии[1], "0");
	Если ЧастиВерсии[0] <> "1" ИЛИ Не ЭтоЦелоеБезЗнака(МладшаяВерсия) Тогда
		ВызватьИсключение СтрШаблон(
			"Неподдерживаемая версия формата файла: %1. Поддерживается 1.x",
			ФорматФайла
		);
	КонецЕсли;

	Возврат Число(МладшаяВерсия);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Чтение и валидация файла

Функция ПрочитатьЯМЛФайл(Знач ПутьКФайлу)

	ФайлКонфигурации = Новый Файл(ПутьКФайлу);
	Если Не ФайлКонфигурации.Существует() Тогда
		ВызватьИсключение СтрШаблон("Файл конфигурации не найден: %1", ПутьКФайлу);
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	СодержимоеФайла = Чтение.Прочитать();
	Чтение.Закрыть();

	// Подстановка переменных окружения выполняется при разборе: тип узла определяется после нее
	Результат = ОтелПодстановкаПеременных.ПрочитатьYaml(СодержимоеФайла);

	Если ТипЗнч(Результат) <> ТипСоответствие Тогда
		ВызватьИсключение "Файл конфигурации должен содержать YAML-документ верхнего уровня (mapping)";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Проверяет file_format по правилам версионирования схемы (VERSIONING.md opentelemetry-configuration):
// основная версия формата должна совпадать с основной версией схемы, более новая младшая версия
// допустима с предупреждением.
//
// Параметры:
//   Данные - Соответствие - разобранный файл
//
// Возвращаемое значение:
//   Булево - Истина, если младшая версия формата новее схемы
//
Функция ПроверитьФорматФайла(Знач Данные)

	ФорматФайла = ПолучитьЗначение(Данные, "file_format");

	Если Не ЗначениеЗаполнено(ФорматФайла) Тогда
		ВызватьИсключение "Обязательное поле file_format не указано в файле конфигурации";
	КонецЕсли;

	// По схеме file_format - строка, а 1.0 без кавычек YAML читает как число
	Если ТипЗнч(ФорматФайла) <> Тип("Строка") Тогда
		ВызватьИсключение СтрШаблон(
			"Ключ file_format должен быть строкой в кавычках, например file_format: ""1.0"", а не %1",
			ФорматФайла
		);
	КонецЕсли;

	Если ПроверитьВерсиюФормата(ФорматФайла) <= МладшаяВерсияСхемы Тогда
		Возврат Ложь;
	КонецЕсли;

	Лог.Предупреждение(
		"Версия формата файла %1 новее поддерживаемой %2: свойства, которых нет в схеме %2, пропускаются",
		ФорматФайла, ВерсияСхемы
	);
	Возврат Истина;

КонецФункции

Функция ЭтоЦелоеБезЗнака(Знач Строка)
	Если Строка = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Строка) Цикл
		Если СтрНайти("0123456789", Сред(Строка, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Проверяет файл по схеме opentelemetry-configuration (Configuration SDK / Parse): типы, обязательные
// свойства и ограничения значений. Для формата новее схемы свойства, которых нет в схеме, не ошибка:
// разбор пропускает их с предупреждением.
//
// Параметры:
//   Данные - Соответствие - разобранный файл
//   ФорматНовееСхемы - Булево - младшая версия file_format новее схемы
//
Процедура ПроверитьПоСхеме(Знач Данные, Знач ФорматНовееСхемы)

	Результат = ВалидаторСхемы().Проверить(Данные);
	Нарушения = Новый Массив;

	Для Каждого Ошибка Из Результат.Ошибки Цикл
		Если ФорматНовееСхемы И Ошибка.Ключевое = "additionalProperties" Тогда
			Лог.Предупреждение("Свойство %1 не описано схемой %2 и пропускается", Ошибка.Путь, ВерсияСхемы);
		Иначе
			Нарушения.Добавить(СтрШаблон("%1: %2", ?(Ошибка.Путь = "", "/", Ошибка.Путь), Ошибка.Сообщение));
		КонецЕсли;
	КонецЦикла;

	Если Нарушения.Количество() > 0 Тогда
		ВызватьИсключение СтрШаблон("Файл конфигурации не соответствует схеме opentelemetry-configuration %1:%2%3",
			ВерсияСхемы, Символы.ПС, СтрСоединить(Нарушения, Символы.ПС));
	КонецЕсли;

КонецПроцедуры

Функция ВалидаторСхемы()

	Если КэшВалидатораСхемы = Неопределено Тогда
		ПутьКСхеме = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "Схема", "opentelemetry_configuration.json");
		Чтение = Новый ЧтениеТекста(ПутьКСхеме, КодировкаТекста.UTF8);
		ТекстСхемы = Чтение.Прочитать();
		Чтение.Закрыть();
		КэшВалидатораСхемы = JsonSchema.Скомпилировать(ТекстСхемы);
	КонецЕсли;

	Возврат КэшВалидатораСхемы;

КонецФункции

// Заполнение корневой конфигурации

Функция ЗаполнитьКонфигурацию(Знач Данные)

	Конфигурация = Новый ОтелКонфигурация;
	Конфигурация.ФорматФайла = Строка(ПолучитьЗначение(Данные, "file_format"));
	Конфигурация.Отключен = ПолучитьБулево(Данные, "disabled", Ложь);

	РесурсДанные = ПолучитьЗначение(Данные, "resource");
	Если РесурсДанные <> Неопределено Тогда
		Конфигурация.Ресурс = ЗаполнитьРесурс(РесурсДанные);
	КонецЕсли;

	ЛимитыДанные = ПолучитьЗначение(Данные, "attribute_limits");
	Если ЛимитыДанные <> Неопределено Тогда
		Конфигурация.ЛимитыАтрибутов = ЗаполнитьЛимитыАтрибутов(ЛимитыДанные);
	КонецЕсли;

	ПропагаторДанные = ПолучитьЗначение(Данные, "propagator");
	Если ПропагаторДанные <> Неопределено Тогда
		Конфигурация.Пропагатор = ЗаполнитьПропагатор(ПропагаторДанные);
	КонецЕсли;

	ТрассировкаДанные = ПолучитьЗначение(Данные, "tracer_provider");
	Если ТрассировкаДанные <> Неопределено Тогда
		Конфигурация.ПровайдерТрассировки = ЗаполнитьПровайдерТрассировки(ТрассировкаДанные);
	КонецЕсли;

	МетрикиДанные = ПолучитьЗначение(Данные, "meter_provider");
	Если МетрикиДанные <> Неопределено Тогда
		Конфигурация.ПровайдерМетрик = ЗаполнитьПровайдерМетрик(МетрикиДанные);
	КонецЕсли;

	ЛогированиеДанные = ПолучитьЗначение(Данные, "logger_provider");
	Если ЛогированиеДанные <> Неопределено Тогда
		Конфигурация.ПровайдерЛогирования = ЗаполнитьПровайдерЛогирования(ЛогированиеДанные);
	КонецЕсли;

	Возврат Конфигурация;

КонецФункции

// Секция resource

Функция ЗаполнитьРесурс(Знач Данные)

	Ресурс = Новый ОтелКонфигурацияРесурса;
	Ресурс.СписокАтрибутов = ПолучитьСтроку(Данные, "attributes_list", "");
	Ресурс.АдресСхемы = ПолучитьСтроку(Данные, "schema_url", "");

	// Схема проверена: атрибут - объект с обязательными name и value
	АтрибутыДанные = ПолучитьЗначение(Данные, "attributes");
	Если АтрибутыДанные <> Неопределено Тогда
		Для Каждого ЭлементАтрибута Из АтрибутыДанные Цикл
			Имя = ЭлементАтрибута.Получить("name");
			Значение = ЭлементАтрибута.Получить("value");
			Ресурс.Атрибуты.Добавить(Новый Структура("Имя, Значение", Имя, Значение));
		КонецЦикла;
	КонецЕсли;

	Возврат Ресурс;

КонецФункции

// Секция attribute_limits

Функция ЗаполнитьЛимитыАтрибутов(Знач Данные)

	Лимиты = Новый ОтелКонфигурацияЛимитовАтрибутов;

	ЗначениеДлины = ПолучитьЗначение(Данные, "attribute_value_length_limit");
	Если ЗначениеДлины <> Неопределено Тогда
		Лимиты.МаксДлинаЗначенияАтрибута = Число(ЗначениеДлины);
	КонецЕсли;

	ЗначениеКоличества = ПолучитьЗначение(Данные, "attribute_count_limit");
	Если ЗначениеКоличества <> Неопределено Тогда
		Лимиты.МаксКоличествоАтрибутов = Число(ЗначениеКоличества);
	КонецЕсли;

	Возврат Лимиты;

КонецФункции

// Секция propagator

Функция ЗаполнитьПропагатор(Знач Данные)

	Пропагатор = Новый ОтелКонфигурацияПропагатора;
	Пропагатор.СписокСоставного = ПолучитьСтроку(Данные, "composite_list", "");

	// Схема проверена: элемент composite - объект с одним ключом, именем пропагатора
	СоставнойДанные = ПолучитьЗначение(Данные, "composite");
	Если СоставнойДанные <> Неопределено Тогда
		Для Каждого Элемент Из СоставнойДанные Цикл
			Пропагатор.Составной.Добавить(РазобратьКомпонент(Элемент));
		КонецЦикла;
	КонецЕсли;

	Возврат Пропагатор;

КонецФункции

// Секция tracer_provider

Функция ЗаполнитьПровайдерТрассировки(Знач Данные)

	Провайдер = Новый ОтелКонфигурацияПровайдераТрассировки;
	// schedule_delay по умолчанию для BatchSpanProcessor
	ЗадержкаОтправкиПоУмолчанию = 5000;

	// Схема проверена: processors - обязательный непустой массив
	Для Каждого ЭлементПроцессора Из Данные.Получить("processors") Цикл
		Провайдер.Процессоры.Добавить(РазобратьПроцессор(ЭлементПроцессора, ЗадержкаОтправкиПоУмолчанию));
	КонецЦикла;

	ЛимитыДанные = ПолучитьЗначение(Данные, "limits");
	Если ЛимитыДанные <> Неопределено Тогда
		Провайдер.Лимиты = ЗаполнитьЛимитыСпана(ЛимитыДанные);
	КонецЕсли;

	СэмплерДанные = ПолучитьЗначение(Данные, "sampler");
	Если СэмплерДанные <> Неопределено Тогда
		Провайдер.Сэмплер = РазобратьСэмплер(СэмплерДанные);
	КонецЕсли;

	// Схема проверена: id_generator - объект с одним ключом, именем генератора
	ГенераторДанные = ПолучитьЗначение(Данные, "id_generator");
	Если ГенераторДанные <> Неопределено Тогда
		Провайдер.ГенераторИд = РазобратьКомпонент(ГенераторДанные);
	КонецЕсли;

	Возврат Провайдер;

КонецФункции

Функция ЗаполнитьЛимитыСпана(Знач Данные)

	Лимиты = Новый ОтелКонфигурацияЛимитовСпана;

	ЗначениеДлины = ПолучитьЗначение(Данные, "attribute_value_length_limit");
	Если ЗначениеДлины <> Неопределено Тогда
		Лимиты.МаксДлинаЗначенияАтрибута = Число(ЗначениеДлины);
	КонецЕсли;

	ЗначениеКоличества = ПолучитьЗначение(Данные, "attribute_count_limit");
	Если ЗначениеКоличества <> Неопределено Тогда
		Лимиты.МаксКоличествоАтрибутов = Число(ЗначениеКоличества);
	КонецЕсли;

	ЗначениеСобытий = ПолучитьЗначение(Данные, "event_count_limit");
	Если ЗначениеСобытий <> Неопределено Тогда
		Лимиты.МаксСобытий = Число(ЗначениеСобытий);
	КонецЕсли;

	ЗначениеЛинков = ПолучитьЗначение(Данные, "link_count_limit");
	Если ЗначениеЛинков <> Неопределено Тогда
		Лимиты.МаксЛинков = Число(ЗначениеЛинков);
	КонецЕсли;

	ЗначениеАтрСобытий = ПолучитьЗначение(Данные, "event_attribute_count_limit");
	Если ЗначениеАтрСобытий <> Неопределено Тогда
		Лимиты.МаксАтрибутовНаСобытие = Число(ЗначениеАтрСобытий);
	КонецЕсли;

	ЗначениеАтрЛинков = ПолучитьЗначение(Данные, "link_attribute_count_limit");
	Если ЗначениеАтрЛинков <> Неопределено Тогда
		Лимиты.МаксАтрибутовНаЛинк = Число(ЗначениеАтрЛинков);
	КонецЕсли;

	Возврат Лимиты;

КонецФункции

// Сэмплер (union type)

Функция РазобратьСэмплер(Знач Данные)

	// Union type: схема проверена, у объекта ровно один ключ - тип сэмплера
	Компонент = РазобратьКомпонент(Данные);
	Если ВстроенныеСэмплеры.Найти(Компонент.Имя) = Неопределено Тогда
		Возврат Компонент;
	КонецЕсли;

	Сэмплер = Новый ОтелКонфигурацияСэмплера;
	Сэмплер.Тип = Компонент.Имя;
	Если Компонент.Свойства <> Неопределено Тогда
		РазобратьПараметрыСэмплера(Сэмплер, Компонент.Свойства);
	КонецЕсли;

	Возврат Сэмплер;

КонецФункции

// Заполняет параметры сэмплера из секции его типа: долю trace_id_ratio_based, вложенные сэмплеры
// parent_based и обернутый сэмплер always_record.
//
// Параметры:
//   Сэмплер           - ОтелКонфигурацияСэмплера - сэмплер с заполненным типом
//   ПараметрыСэмплера - Соответствие - параметры из конфигурационного файла
//
Процедура РазобратьПараметрыСэмплера(Сэмплер, ПараметрыСэмплера)

	Если Сэмплер.Тип = "trace_id_ratio_based" Тогда

		ДоляЗначение = ПолучитьЗначение(ПараметрыСэмплера, "ratio");
		Если ДоляЗначение <> Неопределено Тогда
			Сэмплер.Доля = Число(ДоляЗначение);
		КонецЕсли;

	ИначеЕсли Сэмплер.Тип = "parent_based" Тогда

		РазобратьПараметрыParentBased(Сэмплер, ПараметрыСэмплера);

	ИначеЕсли Сэмплер.Тип = "always_record" Тогда

		// Обернутый сэмплер always_record - поле Корневой, как root у parent_based
		КорневойДанные = ПолучитьЗначение(ПараметрыСэмплера, "root");
		Если КорневойДанные <> Неопределено Тогда
			Сэмплер.Корневой = РазобратьСэмплер(КорневойДанные);
		КонецЕсли;

	Иначе // BSLLS:EmptyCodeBlock-off
		// остальные типы сэмплеров параметров не имеют
	КонецЕсли;

КонецПроцедуры

// Заполняет поля сэмплера типа parent_based из параметров конфигурации.
//
// Параметры:
//   Сэмплер           - ОтелКонфигурацияСэмплера - сэмплер для заполнения
//   ПараметрыСэмплера - Соответствие - параметры из конфигурационного файла
//
Процедура РазобратьПараметрыParentBased(Сэмплер, ПараметрыСэмплера)

	КорневойДанные = ПолучитьЗначение(ПараметрыСэмплера, "root");
	Если КорневойДанные <> Неопределено Тогда
		Сэмплер.Корневой = РазобратьСэмплер(КорневойДанные);
	КонецЕсли;

	ДанныеУРС = ПолучитьЗначение(ПараметрыСэмплера, "remote_parent_sampled");
	Если ДанныеУРС <> Неопределено Тогда
		Сэмплер.УдаленныйРодительСэмплирован = РазобратьСэмплер(ДанныеУРС);
	КонецЕсли;

	ДанныеУРНС = ПолучитьЗначение(ПараметрыСэмплера, "remote_parent_not_sampled");
	Если ДанныеУРНС <> Неопределено Тогда
		Сэмплер.УдаленныйРодительНеСэмплирован = РазобратьСэмплер(ДанныеУРНС);
	КонецЕсли;

	ДанныеЛРС = ПолучитьЗначение(ПараметрыСэмплера, "local_parent_sampled");
	Если ДанныеЛРС <> Неопределено Тогда
		Сэмплер.ЛокальныйРодительСэмплирован = РазобратьСэмплер(ДанныеЛРС);
	КонецЕсли;

	ДанныеЛРНС = ПолучитьЗначение(ПараметрыСэмплера, "local_parent_not_sampled");
	Если ДанныеЛРНС <> Неопределено Тогда
		Сэмплер.ЛокальныйРодительНеСэмплирован = РазобратьСэмплер(ДанныеЛРНС);
	КонецЕсли;

КонецПроцедуры

// Секция meter_provider

Функция ЗаполнитьПровайдерМетрик(Знач Данные)

	Провайдер = Новый ОтелКонфигурацияПровайдераМетрик;
	Провайдер.ФильтрЭкземпляров = ПолучитьСтроку(Данные, "exemplar_filter", "trace_based");

	// Схема проверена: readers - обязательный непустой массив
	Для Каждого ЭлементЧитателя Из Данные.Получить("readers") Цикл
		Провайдер.Читатели.Добавить(РазобратьЧитатель(ЭлементЧитателя));
	КонецЦикла;

	Возврат Провайдер;

КонецФункции

Функция РазобратьЧитатель(Знач Данные)

	// Схема проверена: читатель - periodic или pull; встроенного pull-экспортера в SDK нет, pull-читатель
	// разбор сохраняет в общем виде
	ПериодическийДанные = ПолучитьЗначение(Данные, "periodic");
	Если ПериодическийДанные = Неопределено Тогда
		Возврат РазобратьКомпонент(Данные);
	КонецЕсли;

	Читатель = Новый ОтелКонфигурацияПериодическогоЧитателя;

	ЗначениеИнтервала = ПолучитьЗначение(ПериодическийДанные, "interval");
	Если ЗначениеИнтервала <> Неопределено Тогда
		Читатель.Интервал = Число(ЗначениеИнтервала);
	КонецЕсли;

	ЗначениеТаймаута = ПолучитьЗначение(ПериодическийДанные, "timeout");
	Если ЗначениеТаймаута <> Неопределено Тогда
		Читатель.Таймаут = Число(ЗначениеТаймаута);
	КонецЕсли;

	ЭкспортерДанные = ПолучитьЗначение(ПериодическийДанные, "exporter");
	Если ЭкспортерДанные <> Неопределено Тогда
		Читатель.Экспортер = РазобратьЭкспортер(ЭкспортерДанные);
	КонецЕсли;

	ПродюсерыДанные = ПолучитьЗначение(ПериодическийДанные, "producers");
	Если ПродюсерыДанные <> Неопределено Тогда
		Для Каждого ЭлементПродюсера Из ПродюсерыДанные Цикл
			Читатель.Продюсеры.Добавить(РазобратьКомпонент(ЭлементПродюсера));
		КонецЦикла;
	КонецЕсли;

	Возврат Читатель;

КонецФункции

// Секция logger_provider

Функция ЗаполнитьПровайдерЛогирования(Знач Данные)

	Провайдер = Новый ОтелКонфигурацияПровайдераЛогирования;
	// schedule_delay по умолчанию для BatchLogRecordProcessor
	ЗадержкаОтправкиПоУмолчанию = 1000;

	// Схема проверена: processors - обязательный непустой массив
	Для Каждого ЭлементПроцессора Из Данные.Получить("processors") Цикл
		Провайдер.Процессоры.Добавить(РазобратьПроцессор(ЭлементПроцессора, ЗадержкаОтправкиПоУмолчанию));
	КонецЦикла;

	ЛимитыДанные = ПолучитьЗначение(Данные, "limits");
	Если ЛимитыДанные <> Неопределено Тогда
		Провайдер.Лимиты = ЗаполнитьЛимитыАтрибутов(ЛимитыДанные);
	КонецЕсли;

	Возврат Провайдер;

КонецФункции

// Общие парсеры для процессоров и экспортеров

Функция РазобратьПроцессор(Знач Данные, Знач ЗадержкаОтправкиПоУмолчанию)

	// Схема проверена: у простого процессора обязательный exporter
	ПростойДанные = ПолучитьЗначение(Данные, "simple");
	Если ПростойДанные <> Неопределено Тогда
		Процессор = Новый ОтелКонфигурацияПростогоПроцессора;
		Процессор.Экспортер = РазобратьЭкспортер(ПростойДанные.Получить("exporter"));
		Возврат Процессор;
	КонецЕсли;

	// Процессор, которого нет в SDK, разбор сохраняет в общем виде
	ПакетныйДанные = ПолучитьЗначение(Данные, "batch");
	Если ПакетныйДанные = Неопределено Тогда
		Возврат РазобратьКомпонент(Данные);
	КонецЕсли;

	Процессор = Новый ОтелКонфигурацияПакетногоПроцессора;
	Процессор.ЗадержкаОтправки = ЗадержкаОтправкиПоУмолчанию;

	ЗначениеЗадержки = ПолучитьЗначение(ПакетныйДанные, "schedule_delay");
	Если ЗначениеЗадержки <> Неопределено Тогда
		Процессор.ЗадержкаОтправки = Число(ЗначениеЗадержки);
	КонецЕсли;

	ЗначениеТаймаута = ПолучитьЗначение(ПакетныйДанные, "export_timeout");
	Если ЗначениеТаймаута <> Неопределено Тогда
		Процессор.ТаймаутЭкспорта = Число(ЗначениеТаймаута);
	КонецЕсли;

	ЗначениеОчереди = ПолучитьЗначение(ПакетныйДанные, "max_queue_size");
	Если ЗначениеОчереди <> Неопределено Тогда
		Процессор.МаксРазмерОчереди = Число(ЗначениеОчереди);
	КонецЕсли;

	ЗначениеПакета = ПолучитьЗначение(ПакетныйДанные, "max_export_batch_size");
	Если ЗначениеПакета <> Неопределено Тогда
		Процессор.МаксРазмерПакета = Число(ЗначениеПакета);
	КонецЕсли;

	ЭкспортерДанные = ПолучитьЗначение(ПакетныйДанные, "exporter");
	Если ЭкспортерДанные <> Неопределено Тогда
		Процессор.Экспортер = РазобратьЭкспортер(ЭкспортерДанные);
	КонецЕсли;

	Возврат Процессор;

КонецФункции

Функция РазобратьЭкспортер(Знач Данные)

	// Ключ без значения (otlp_http:, otlp_grpc:) - экспортер с настройками по умолчанию
	Если ЕстьКлюч(Данные, "otlp_http") Тогда
		Возврат ЗаполнитьЭкспортерOtlp(Новый ОтелКонфигурацияЭкспортераOtlpHttp, Данные.Получить("otlp_http"));
	КонецЕсли;

	Если ЕстьКлюч(Данные, "otlp_grpc") Тогда
		Возврат ЗаполнитьЭкспортерOtlp(Новый ОтелКонфигурацияЭкспортераOtlpGrpc, Данные.Получить("otlp_grpc"));
	КонецЕсли;

	// Экспортер, которого нет в SDK (console, пользовательский), разбор сохраняет в общем виде
	Возврат РазобратьКомпонент(Данные);

КонецФункции

// Заполняет экспортер OTLP настройками из файла: у otlp_http и otlp_grpc общие ключи.
//
// Параметры:
//   Экспортер - ОтелКонфигурацияЭкспортераOtlpHttp, ОтелКонфигурацияЭкспортераOtlpGrpc - экспортер
//     с настройками по умолчанию
//   Параметры - Соответствие, Неопределено - настройки экспортера; Неопределено - ключ без значения
//
// Возвращаемое значение:
//   ОтелКонфигурацияЭкспортераOtlpHttp, ОтелКонфигурацияЭкспортераOtlpGrpc - заполненный экспортер
//
Функция ЗаполнитьЭкспортерOtlp(Экспортер, Знач Параметры)

	Если Параметры = Неопределено Тогда
		Возврат Экспортер;
	КонецЕсли;

	Экспортер.Адрес = ПолучитьСтроку(Параметры, "endpoint", "");
	Экспортер.Сжатие = ПолучитьСтроку(Параметры, "compression", "");
	Экспортер.СписокЗаголовков = ПолучитьСтроку(Параметры, "headers_list", "");
	Экспортер.ПредпочтениеВременнойАгрегации = ПолучитьСтроку(Параметры, "temporality_preference", "");
	Экспортер.АгрегацияГистограммПоУмолчанию = ПолучитьСтроку(Параметры, "default_histogram_aggregation", "");

	ЗначениеТаймаута = ПолучитьЗначение(Параметры, "timeout");
	Если ЗначениеТаймаута <> Неопределено Тогда
		Экспортер.Таймаут = Число(ЗначениеТаймаута);
	КонецЕсли;

	ЗаголовкиДанные = ПолучитьЗначение(Параметры, "headers");
	Если ЗаголовкиДанные <> Неопределено Тогда
		РазобратьЗаголовкиЭкспортера(ЗаголовкиДанные, Экспортер);
	КонецЕсли;

	Возврат Экспортер;

КонецФункции

Процедура РазобратьЗаголовкиЭкспортера(Знач ЗаголовкиДанные, Экспортер)

	// Схема проверена: у заголовка обязательные name и value; заголовок со значением null пропускается
	Для Каждого ЭлементЗаголовка Из ЗаголовкиДанные Цикл
		Значение = ЭлементЗаголовка.Получить("value");
		Если Значение <> Неопределено Тогда
			Имя = ЭлементЗаголовка.Получить("name");
			Экспортер.Заголовки.Добавить(Новый Структура("Имя, Значение", Имя, Значение));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Разбирает компонент, заданный ключом-именем со свойствами под ним: пропагатор, генератор ID или
// компонент, которого нет в SDK. Configuration SDK, Parse: такой компонент сохраняется в общем виде -
// имя и свойства как в файле.
//
// Параметры:
//   Данные - Соответствие - объект с одним ключом, именем компонента (схема проверена)
//
// Возвращаемое значение:
//   ОтелКонфигурацияКомпонента
//
Функция РазобратьКомпонент(Знач Данные)

	Компонент = Новый ОтелКонфигурацияКомпонента;
	Для Каждого КлючЗначение Из Данные Цикл
		Компонент.Имя = КлючЗначение.Ключ;
		Компонент.Свойства = КлючЗначение.Значение;
	КонецЦикла;

	Возврат Компонент;

КонецФункции

// Хелперы доступа к данным

// Проверяет, есть ли свойство в объекте YAML. Parse различает отсутствующее свойство и свойство со
// значением null, а ПолучитьЗначение в обоих случаях возвращает Неопределено.
//
// Параметры:
//   Данные - Соответствие, Произвольный - объект YAML
//   Ключ - Строка - имя свойства
//
// Возвращаемое значение:
//   Булево
//
Функция ЕстьКлюч(Знач Данные, Знач Ключ)

	Если ТипЗнч(Данные) <> ТипСоответствие Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого КлючЗначение Из Данные Цикл
		Если КлючЗначение.Ключ = Ключ Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ПолучитьЗначение(Знач Данные, Знач Ключ)

	Если ТипЗнч(Данные) <> ТипСоответствие Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Данные.Получить(Ключ);

КонецФункции

Функция ПолучитьСтроку(Знач Данные, Знач Ключ, Знач ЗначениеПоУмолчанию)

	Значение = ПолучитьЗначение(Данные, Ключ);
	Если Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

Функция ПолучитьБулево(Знач Данные, Знач Ключ, Знач ЗначениеПоУмолчанию)

	// Схема проверена: значение булево или null
	Значение = ПолучитьЗначение(Данные, Ключ);
	Если Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Возврат Значение;

КонецФункции

#КонецОбласти

Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.file-configuration");
ТипСоответствие = Тип("Соответствие");
ВерсияСхемы = "1.2";
МладшаяВерсияСхемы = 2;
ВстроенныеСэмплеры = СтрРазделить("always_on,always_off,trace_id_ratio_based,parent_based,always_record", ",");
