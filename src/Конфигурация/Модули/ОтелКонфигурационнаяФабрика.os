// Модуль-фабрика для создания OpenTelemetry SDK из конфигурационной модели ОтелКонфигурация.
// Аналог Java SDK: OpenTelemetryConfigurationFactory.
//
// Преобразует нормализованную модель (DTO) в рабочие объекты SDK:
// ОтелКонфигурация -> ОтелSdk (через ОтелПостроительSdk).
//
// Работает ТОЛЬКО с нормализованной моделью - никаких source-specific веток.
// Обе точки входа (файловая конфигурация и env vars) должны производить
// одинаковую каноническую форму модели перед вызовом этого модуля.
//

// Лог - логгер модуля
Перем Лог;
// Строка - имена встроенных экспортеров через запятую для текста ошибки
Перем ВстроенныеЭкспортеры;

#Область ПрограммныйИнтерфейс

// Создает полностью настроенный OpenTelemetry SDK из конфигурационной модели. Configuration SDK, Create:
// модель, в том числе собранная в коде, проверяется по схеме конфигурации до создания компонентов SDK
// (см. ОтелФайловаяКонфигурация.ПроверитьМодель): значение, недопустимое по схеме, - ошибка.
//
// Параметры:
//   Модель - ОтелКонфигурация - нормализованная конфигурационная модель
//
// Возвращаемое значение:
//   ОтелSdk - настроенный экземпляр SDK
//
Функция Создать(Модель) Экспорт

	// Configuration SDK, Create: file_format - обязательное свойство модели
	Если Не ЗначениеЗаполнено(Модель.ФорматФайла) Тогда
		ВызватьИсключение "Не задан обязательный file_format: заполните поле ФорматФайла модели, например ""1.0""";
	КонецЕсли;
	ОтелФайловаяКонфигурация.ПроверитьВерсиюФормата(Модель.ФорматФайла);
	ОтелФайловаяКонфигурация.ПроверитьМодель(Модель);
	ПолнаяМодель = КопияСоЗначениямиПоУмолчанию(Модель);

	Если ПолнаяМодель.Отключен Тогда
		Возврат СоздатьНоопSdk();
	КонецЕсли;

	Ресурс = ПостроитьРесурс(ПолнаяМодель.Ресурс);

	Построитель = Новый ОтелПостроительSdk();
	// Провайдеры, созданные до ошибки конфигурации, закрываются: ошибка не оставляет работающих
	// фоновых экспортов и транспортов
	Провайдеры = Новый Массив;
	Попытка

		Если ПолнаяМодель.ПровайдерТрассировки <> Неопределено Тогда
			ПровайдерТрассировки = ПостроитьПровайдерТрассировки(
				Ресурс, ПолнаяМодель.ПровайдерТрассировки, ПолнаяМодель.ЛимитыАтрибутов);
			Провайдеры.Добавить(ПровайдерТрассировки);
			Построитель.УстановитьПровайдерТрассировки(ПровайдерТрассировки);
		КонецЕсли;

		Если ПолнаяМодель.ПровайдерЛогирования <> Неопределено Тогда
			ПровайдерЛогирования = ПостроитьПровайдерЛогирования(
				Ресурс, ПолнаяМодель.ПровайдерЛогирования, ПолнаяМодель.ЛимитыАтрибутов);
			Провайдеры.Добавить(ПровайдерЛогирования);
			Построитель.УстановитьПровайдерЛогирования(ПровайдерЛогирования);
		КонецЕсли;

		Если ПолнаяМодель.ПровайдерМетрик <> Неопределено Тогда
			ПровайдерМетрик = ПостроитьПровайдерМетрик(
				Ресурс, ПолнаяМодель.ПровайдерМетрик);
			Провайдеры.Добавить(ПровайдерМетрик);
			Построитель.УстановитьПровайдерМетрик(ПровайдерМетрик);
		КонецЕсли;

		Построитель.УстановитьПропагаторы(ПостроитьПропагаторы(ПолнаяМодель.Пропагатор));

		Возврат Построитель.Построить();

	Исключение
		ЗакрытьСозданные(Провайдеры);
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

// Создает ресурс из конфигурации. Часть модели проверяется по схеме, как модель в Создать.
//
// Параметры:
//   КонфигРесурса - ОтелКонфигурацияРесурса, Неопределено - конфигурация ресурса
//
// Возвращаемое значение:
//   ОтелРесурс - ресурс с атрибутами
//
Функция СоздатьРесурс(КонфигРесурса = Неопределено) Экспорт

	Модель = МодельЧасти();
	Модель.Ресурс = КонфигРесурса;
	ОтелФайловаяКонфигурация.ПроверитьМодель(Модель);
	ПолнаяМодель = КопияСоЗначениямиПоУмолчанию(Модель);

	Возврат ПостроитьРесурс(ПолнаяМодель.Ресурс);

КонецФункции

// Создает провайдер трассировки из конфигурации. Части модели проверяются по схеме, как модель в Создать.
//
// Параметры:
//   Ресурс - ОтелРесурс - ресурс для провайдера
//   КонфигПровайдера - ОтелКонфигурацияПровайдераТрассировки - конфигурация провайдера
//   КонфигГлобЛимитов - ОтелКонфигурацияЛимитовАтрибутов, Неопределено - глобальные лимиты
//
// Возвращаемое значение:
//   ОтелПровайдерТрассировки - настроенный провайдер трассировки
//
Функция СоздатьПровайдерТрассировки(Ресурс, КонфигПровайдера, КонфигГлобЛимитов = Неопределено) Экспорт

	Модель = МодельЧасти();
	Модель.ПровайдерТрассировки = КонфигПровайдера;
	Модель.ЛимитыАтрибутов = КонфигГлобЛимитов;
	ОтелФайловаяКонфигурация.ПроверитьМодель(Модель);
	ПолнаяМодель = КопияСоЗначениямиПоУмолчанию(Модель);

	Возврат ПостроитьПровайдерТрассировки(Ресурс, ПолнаяМодель.ПровайдерТрассировки, ПолнаяМодель.ЛимитыАтрибутов);

КонецФункции

// Создает провайдер логирования из конфигурации. Части модели проверяются по схеме, как модель в Создать.
//
// Параметры:
//   Ресурс - ОтелРесурс - ресурс для провайдера
//   КонфигПровайдера - ОтелКонфигурацияПровайдераЛогирования - конфигурация провайдера
//   КонфигГлобЛимитов - ОтелКонфигурацияЛимитовАтрибутов, Неопределено - глобальные лимиты
//
// Возвращаемое значение:
//   ОтелПровайдерЛогирования - настроенный провайдер логирования
//
Функция СоздатьПровайдерЛогирования(Ресурс, КонфигПровайдера, КонфигГлобЛимитов = Неопределено) Экспорт

	Модель = МодельЧасти();
	Модель.ПровайдерЛогирования = КонфигПровайдера;
	Модель.ЛимитыАтрибутов = КонфигГлобЛимитов;
	ОтелФайловаяКонфигурация.ПроверитьМодель(Модель);
	ПолнаяМодель = КопияСоЗначениямиПоУмолчанию(Модель);

	Возврат ПостроитьПровайдерЛогирования(Ресурс, ПолнаяМодель.ПровайдерЛогирования, ПолнаяМодель.ЛимитыАтрибутов);

КонецФункции

// Создает провайдер метрик из конфигурации. Часть модели проверяется по схеме, как модель в Создать.
//
// Параметры:
//   Ресурс - ОтелРесурс - ресурс для провайдера
//   КонфигПровайдера - ОтелКонфигурацияПровайдераМетрик - конфигурация провайдера
//
// Возвращаемое значение:
//   ОтелПровайдерМетрик - настроенный провайдер метрик
//
Функция СоздатьПровайдерМетрик(Ресурс, КонфигПровайдера) Экспорт

	Модель = МодельЧасти();
	Модель.ПровайдерМетрик = КонфигПровайдера;
	ОтелФайловаяКонфигурация.ПроверитьМодель(Модель);
	ПолнаяМодель = КопияСоЗначениямиПоУмолчанию(Модель);

	Возврат ПостроитьПровайдерМетрик(Ресурс, ПолнаяМодель.ПровайдерМетрик);

КонецФункции

// Создает пропагаторы контекста из конфигурации. Часть модели проверяется по схеме, как модель в Создать.
// По спецификации: "none" не может использоваться совместно с другими пропагаторами. Пропагатор,
// которого нет в SDK, и b3 без пакета opentelemetry-propagator-b3 - ошибка (Configuration SDK, Create).
//
// Параметры:
//   КонфигПропагатора - ОтелКонфигурацияПропагатора, Неопределено - конфигурация пропагатора
//
// Возвращаемое значение:
//   ОтелКомпозитныйПропагатор, ОтелНоопПропагатор - пропагатор; без пропагаторов в конфигурации
//     и для "none" - ОтелНоопПропагатор
//
Функция СоздатьПропагаторы(КонфигПропагатора = Неопределено) Экспорт

	Модель = МодельЧасти();
	Модель.Пропагатор = КонфигПропагатора;
	ОтелФайловаяКонфигурация.ПроверитьМодель(Модель);
	ПолнаяМодель = КопияСоЗначениямиПоУмолчанию(Модель);

	Возврат ПостроитьПропагаторы(ПолнаяМодель.Пропагатор);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ===== ЧАСТИ SDK =====

// Возвращает модель, в которую функция части кладет свою часть для проверки по схеме: часть проверяется
// по тем же правилам и с тем же путем свойства, что и в модели, которую проверяет Создать.
//
// Возвращаемое значение:
//   ОтелКонфигурация - модель без секций
//
Функция МодельЧасти()

	Модель = Новый ОтелКонфигурация;
	Модель.ФорматФайла = "1.0";
	Возврат Модель;

КонецФункции

// Возвращает копию значения модели, в которой свойство со значением Неопределено получает значение по
// умолчанию - значение этого свойства у нового объекта того же класса. Configuration SDK, Create:
// свойство со значением null получает значение по умолчанию; в модели из кода null - Неопределено.
// Свойство без значения по умолчанию остается Неопределено - не задано. Модель, переданная фабрике, не
// меняется.
//
// Параметры:
//   Значение - Произвольный - значение модели: объект конфигурации, массив или значение свойства
//
// Возвращаемое значение:
//   Произвольный - копия объекта конфигурации или массива; другое значение - как есть
//
Функция КопияСоЗначениямиПоУмолчанию(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Копия = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Копия.Добавить(КопияСоЗначениямиПоУмолчанию(Элемент));
		КонецЦикла;
		Возврат Копия;
	КонецЕсли;

	// Объект конфигурации - класс модели или настройки TLS экспортера
	ИмяТипа = Строка(ТипЗнч(Значение));
	Если НЕ СтрНачинаетсяС(ИмяТипа, "ОтелКонфигурация") И ИмяТипа <> "ОтелНастройкиTls" Тогда
		Возврат Значение;
	КонецЕсли;

	Копия = Новый(ИмяТипа);
	Для Каждого Свойство Из Новый Рефлектор().ПолучитьТаблицуСвойств(Значение) Цикл
		ЗначениеСвойства = Значение[Свойство.Имя];
		Если ЗначениеСвойства <> Неопределено Тогда
			Копия[Свойство.Имя] = КопияСоЗначениямиПоУмолчанию(ЗначениеСвойства);
		КонецЕсли;
	КонецЦикла;

	Возврат Копия;

КонецФункции

// Строит ресурс из проверенной части модели.
//
// Параметры:
//   КонфигРесурса - ОтелКонфигурацияРесурса, Неопределено - конфигурация ресурса
//
// Возвращаемое значение:
//   ОтелРесурс - ресурс с атрибутами
//
Функция ПостроитьРесурс(КонфигРесурса)

	Если КонфигРесурса = Неопределено Тогда
		// При файловой конфигурации переменные окружения, кроме подставленных в файл, игнорируются
		Возврат Новый ОтелРесурс(Ложь, "", Истина);
	КонецЕсли;

	Ресурс = Новый ОтелРесурс(Ложь, КонфигРесурса.АдресСхемы, Истина);

	// Атрибуты из строки attributes_list в формате OTEL_RESOURCE_ATTRIBUTES. Configuration SDK, Create:
	// строка, которая не разбирается в этом формате, - ошибка (у переменной окружения значение с ошибкой
	// отбрасывается)
	Если КонфигРесурса.СписокАтрибутов <> "" Тогда
		Попытка
			Пары = РазобратьАтрибутыРесурса(КонфигРесурса.СписокАтрибутов);
		Исключение
			ВызватьИсключение СтрШаблон("Некорректный resource.attributes_list: %1", ИнформацияОбОшибке().Описание);
		КонецПопытки;
		Для Каждого КлючИЗначение Из Пары Цикл
			Ресурс.Атрибуты().Установить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

	// Атрибуты из структурированного массива (YAML формат). По схеме декларативной
	// конфигурации они приоритетнее записей attributes_list, поэтому применяются после
	Для Каждого Запись Из КонфигРесурса.Атрибуты Цикл
		// По описанию схемы запись со значением null пропускается
		Если Запись.Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПроверитьТипАтрибутаРесурса(Запись);
		Ресурс.Атрибуты().Установить(Запись.Имя, Запись.Значение);
	КонецЦикла;

	Возврат Ресурс;

КонецФункции

// Проверяет, что значение атрибута ресурса соответствует его типу: по описанию схемы тип значения
// должен соответствовать type, без type - string (Configuration SDK, Create: значение, недопустимое по
// описанию свойства, - ошибка).
//
// Параметры:
//   Запись - Структура - атрибут модели:
//     * Имя - Строка - имя атрибута
//     * Значение - Строка, Число, Булево, Массив - значение атрибута
//     * Тип - Строка, Неопределено - тип значения (необязательное свойство); Неопределено - string
//
Процедура ПроверитьТипАтрибутаРесурса(Знач Запись)

	ТипАтрибута = Неопределено;
	Запись.Свойство("Тип", ТипАтрибута);
	Если ТипАтрибута = Неопределено Тогда
		ТипАтрибута = "string";
	КонецЕсли;

	Если Не ЗначениеСоответствуетТипуАтрибута(Запись.Значение, ТипАтрибута) Тогда
		ВызватьИсключение СтрШаблон("Атрибут ресурса ""%1"": значение не соответствует типу %2",
			Запись.Имя, ТипАтрибута);
	КонецЕсли;

КонецПроцедуры

// Возвращает Истина, если значение соответствует типу атрибута схемы: string, bool, int (целое число),
// double (число), массив <тип>_array - непустой массив значений своего типа.
//
// Параметры:
//   Значение - Произвольный - значение атрибута
//   ТипАтрибута - Строка - тип атрибута схемы
//
// Возвращаемое значение:
//   Булево
//
Функция ЗначениеСоответствуетТипуАтрибута(Знач Значение, Знач ТипАтрибута)

	СуффиксМассива = "_array";
	Если СтрЗаканчиваетсяНа(ТипАтрибута, СуффиксМассива) Тогда
		ТипЭлемента = Лев(ТипАтрибута, СтрДлина(ТипАтрибута) - СтрДлина(СуффиксМассива));
		Возврат МассивСоответствуетТипуАтрибута(Значение, ТипЭлемента);
	КонецЕсли;

	Если ТипАтрибута = "string" Тогда
		Соответствует = ТипЗнч(Значение) = Тип("Строка");
	ИначеЕсли ТипАтрибута = "bool" Тогда
		Соответствует = ТипЗнч(Значение) = Тип("Булево");
	ИначеЕсли ТипАтрибута = "int" Тогда
		Соответствует = ТипЗнч(Значение) = Тип("Число") И Цел(Значение) = Значение;
	ИначеЕсли ТипАтрибута = "double" Тогда
		Соответствует = ТипЗнч(Значение) = Тип("Число");
	Иначе
		Соответствует = Ложь;
	КонецЕсли;
	Возврат Соответствует;

КонецФункции

// Возвращает Истина, если значение - непустой массив значений типа атрибута схемы.
//
// Параметры:
//   Значение - Произвольный - значение атрибута
//   ТипЭлемента - Строка - тип элемента: string, bool, int, double
//
// Возвращаемое значение:
//   Булево
//
Функция МассивСоответствуетТипуАтрибута(Знач Значение, Знач ТипЭлемента)

	Если ТипЗнч(Значение) <> Тип("Массив") ИЛИ Значение.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Элемент Из Значение Цикл
		Если Не ЗначениеСоответствуетТипуАтрибута(Элемент, ТипЭлемента) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Строит провайдер трассировки из проверенной части модели.
//
// Параметры:
//   Ресурс - ОтелРесурс - ресурс для провайдера
//   КонфигПровайдера - ОтелКонфигурацияПровайдераТрассировки - конфигурация провайдера
//   КонфигГлобЛимитов - ОтелКонфигурацияЛимитовАтрибутов, Неопределено - глобальные лимиты
//
// Возвращаемое значение:
//   ОтелПровайдерТрассировки - настроенный провайдер трассировки
//
Функция ПостроитьПровайдерТрассировки(Ресурс, КонфигПровайдера, КонфигГлобЛимитов)

	// Сначала части без фоновой работы: ошибка в них не оставляет запущенных процессоров
	// По умолчанию: parent_based(always_on)
	ВсегдаВключен = ОтелСэмплер.ВсегдаВключен();
	СэмплерПоУмолчанию = ОтелСэмплер.НаОсновеРодителя(ВсегдаВключен);
	Сэмплер = СоздатьСэмплер(КонфигПровайдера.Сэмплер, СэмплерПоУмолчанию);

	ЛимитыСпана = СоздатьЛимитыСпана(
		КонфигПровайдера.Лимиты, КонфигГлобЛимитов);

	ПроверитьГенераторИд(КонфигПровайдера.ГенераторИд);

	Процессор = СоздатьПроцессорыСпанов(КонфигПровайдера.Процессоры);

	Возврат Новый ОтелПровайдерТрассировки(Ресурс, Процессор, Сэмплер, ЛимитыСпана);

КонецФункции

// Строит провайдер логирования из проверенной части модели.
//
// Параметры:
//   Ресурс - ОтелРесурс - ресурс для провайдера
//   КонфигПровайдера - ОтелКонфигурацияПровайдераЛогирования - конфигурация провайдера
//   КонфигГлобЛимитов - ОтелКонфигурацияЛимитовАтрибутов, Неопределено - глобальные лимиты
//
// Возвращаемое значение:
//   ОтелПровайдерЛогирования - настроенный провайдер логирования
//
Функция ПостроитьПровайдерЛогирования(Ресурс, КонфигПровайдера, КонфигГлобЛимитов)

	ЛимитыЗаписейЛога = СоздатьЛимитыЗаписейЛога(
		КонфигПровайдера.Лимиты, КонфигГлобЛимитов);

	Процессор = СоздатьПроцессорыЛогов(КонфигПровайдера.Процессоры);

	Возврат Новый ОтелПровайдерЛогирования(
		Ресурс, Процессор, ЛимитыЗаписейЛога);

КонецФункции

// Строит провайдер метрик из проверенной части модели.
//
// Параметры:
//   Ресурс - ОтелРесурс - ресурс для провайдера
//   КонфигПровайдера - ОтелКонфигурацияПровайдераМетрик - конфигурация провайдера
//
// Возвращаемое значение:
//   ОтелПровайдерМетрик - настроенный провайдер метрик
//
Функция ПостроитьПровайдерМетрик(Ресурс, КонфигПровайдера)

	ФильтрЭкземпляров = РазрешитьФильтрЭкземпляров(
		КонфигПровайдера.ФильтрЭкземпляров);
	Представления = ПостроитьПредставления(КонфигПровайдера.Представления);

	// Читатели, созданные до ошибки конфигурации, закрываются: их фоновый сбор не остается работать
	МассивЧитателей = Новый Массив;
	Попытка
		Для Каждого КонфигЧитателя Из КонфигПровайдера.Читатели Цикл
			МассивЧитателей.Добавить(СоздатьЧитательМетрик(КонфигЧитателя));
		КонецЦикла;
	Исключение
		ЗакрытьСозданные(МассивЧитателей);
		ВызватьИсключение;
	КонецПопытки;

	// По схеме у провайдера хотя бы один читатель
	ОдинЧитатель = 1;
	Если МассивЧитателей.Количество() = ОдинЧитатель Тогда
		Провайдер = Новый ОтелПровайдерМетрик(Ресурс, МассивЧитателей[0], ФильтрЭкземпляров);
	Иначе
		Провайдер = Новый ОтелПровайдерМетрик(Ресурс, МассивЧитателей, ФильтрЭкземпляров);
	КонецЕсли;

	// Представления регистрируются до выдачи метров: они применяются ко всем инструментам провайдера
	Для Каждого ПараПредставления Из Представления Цикл
		Провайдер.ЗарегистрироватьПредставление(ПараПредставления.Селектор, ПараПредставления.Представление);
	КонецЦикла;

	Возврат Провайдер;

КонецФункции

// Строит представления (View) провайдера метрик из проверенной части модели.
//
// Параметры:
//   КонфигПредставлений - Массив из ОтелКонфигурацияПредставления - представления
//
// Возвращаемое значение:
//   Массив из Структура - пары представлений:
//     * Селектор - ОтелСелекторИнструментов - селектор инструментов
//     * Представление - ОтелПредставление - настройки потока метрики
//
Функция ПостроитьПредставления(КонфигПредставлений)

	Представления = Новый Массив;
	Для Каждого КонфигПредставления Из КонфигПредставлений Цикл
		Селектор = СоздатьСелекторИнструментов(КонфигПредставления.Селектор);
		Представление = СоздатьПредставление(КонфигПредставления.Поток);
		Представления.Добавить(Новый Структура("Селектор, Представление", Селектор, Представление));
	КонецЦикла;

	Возврат Представления;

КонецФункции

Функция СоздатьСелекторИнструментов(КонфигСелектора)

	// Критерий Неопределено не задан: ему соответствуют все инструменты
	ВидИнструмента = ВидИнструментаПоТипу(КонфигСелектора.ТипИнструмента);
	Возврат Новый ОтелСелекторИнструментов(КонфигСелектора.ИмяИнструмента, ВидИнструмента,
		КонфигСелектора.ИмяМетра, КонфигСелектора.Единица, КонфигСелектора.ВерсияМетра,
		КонфигСелектора.АдресСхемыМетра);

КонецФункции

// Возвращает вид инструмента SDK по типу инструмента схемы конфигурации (instrument_type).
//
// Параметры:
//   ТипИнструмента - Строка, Неопределено - тип инструмента схемы: counter, up_down_counter, histogram,
//     gauge, observable_counter, observable_up_down_counter, observable_gauge
//
// Возвращаемое значение:
//   Строка, Неопределено - вид инструмента SDK; Неопределено - тип не задан
//
Функция ВидИнструментаПоТипу(ТипИнструмента)

	ВидыИнструментов = Новый Соответствие;
	ВидыИнструментов.Вставить("counter", "Counter");
	ВидыИнструментов.Вставить("up_down_counter", "UpDownCounter");
	ВидыИнструментов.Вставить("histogram", "Histogram");
	ВидыИнструментов.Вставить("gauge", "Gauge");
	ВидыИнструментов.Вставить("observable_counter", "ObservableCounter");
	ВидыИнструментов.Вставить("observable_up_down_counter", "ObservableUpDownCounter");
	ВидыИнструментов.Вставить("observable_gauge", "ObservableGauge");

	Возврат ВидыИнструментов.Получить(ТипИнструмента);

КонецФункции

Функция СоздатьПредставление(КонфигПотока)

	// Настройка Неопределено не задана: поток берет ее у инструмента или читателя
	РазрешенныеКлючи = Неопределено;
	ИсключенныеКлючи = Неопределено;
	Если КонфигПотока.КлючиАтрибутов <> Неопределено Тогда
		РазрешенныеКлючи = КонфигПотока.КлючиАтрибутов.Включенные;
		ИсключенныеКлючи = КонфигПотока.КлючиАтрибутов.Исключенные;
	КонецЕсли;
	Агрегация = АгрегацияПотока(КонфигПотока.Агрегация);

	Возврат Новый ОтелПредставление(КонфигПотока.Имя, КонфигПотока.Описание, РазрешенныеКлючи, Неопределено,
		Агрегация, ИсключенныеКлючи, Неопределено, КонфигПотока.ЛимитМощностиАгрегации);

КонецФункции

// Возвращает агрегацию ОтелАгрегация по конфигурации агрегации потока.
//
// Параметры:
//   КонфигАгрегации - ОтелКонфигурацияАгрегации, Неопределено - конфигурация агрегации
//
// Возвращаемое значение:
//   Строка, Соответствие, Неопределено - агрегация; Неопределено - агрегация не задана
//
Функция АгрегацияПотока(КонфигАгрегации)

	Если КонфигАгрегации = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если КонфигАгрегации.Тип = "explicit_bucket_histogram" Тогда
		Возврат ОтелАгрегация.ГистограммаСЯвнымиГраницами(КонфигАгрегации.Границы,
			КонфигАгрегации.ЗаписыватьМинМакс);
	КонецЕсли;

	Если КонфигАгрегации.Тип = "base2_exponential_bucket_histogram" Тогда
		Возврат ОтелАгрегация.ГистограммаЭкспоненциальная(КонфигАгрегации.МаксРазмер,
			КонфигАгрегации.МаксШкала, КонфигАгрегации.ЗаписыватьМинМакс);
	КонецЕсли;

	// default, drop, sum и last_value - имена агрегаций ОтелАгрегация
	Возврат КонфигАгрегации.Тип;

КонецФункции

// Строит пропагаторы из проверенной части модели.
//
// Параметры:
//   КонфигПропагатора - ОтелКонфигурацияПропагатора, Неопределено - конфигурация пропагатора
//
// Возвращаемое значение:
//   ОтелКомпозитныйПропагатор, ОтелНоопПропагатор - пропагатор
//
Функция ПостроитьПропагаторы(КонфигПропагатора)

	ИменаПропагаторов = СобратьИменаПропагаторов(КонфигПропагатора);

	// схема файла конфигурации: без пропагаторов - noop (defaultBehavior секции propagator)
	Если ИменаПропагаторов.Количество() = 0 Тогда
		Возврат Новый ОтелНоопПропагатор();
	КонецЕсли;

	ПроверитьОграниченияNone(ИменаПропагаторов);

	// none отключает пропагацию: SDK получает noop-пропагатор, как и без пропагаторов
	// в конфигурации
	Если ИменаПропагаторов[0].Имя = "none" Тогда
		Возврат Новый ОтелНоопПропагатор();
	КонецЕсли;

	МассивПропагаторов = Новый Массив;
	ВиденныеИмена = Новый Соответствие;
	Для Каждого Пропагатор Из ИменаПропагаторов Цикл
		Если ВиденныеИмена.Получить(Пропагатор.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ВиденныеИмена.Вставить(Пропагатор.Имя, Истина);

		МассивПропагаторов.Добавить(СоздатьПропагатор(Пропагатор.Имя, Пропагатор.Исходное));
	КонецЦикла;

	Возврат Новый ОтелКомпозитныйПропагатор(МассивПропагаторов);

КонецФункции

// ===== ПРОЦЕССОРЫ СПАНОВ =====

Функция СоздатьПроцессорыСпанов(КонфигурацииПроцессоров)

	// Процессоры, созданные до ошибки конфигурации, закрываются: их фоновый экспорт не остается работать
	МассивПроцессоров = Новый Массив;
	Попытка
		Для Каждого КонфигПроцессора Из КонфигурацииПроцессоров Цикл
			МассивПроцессоров.Добавить(СоздатьПроцессорСпанов(КонфигПроцессора));
		КонецЦикла;
	Исключение
		ЗакрытьСозданные(МассивПроцессоров);
		ВызватьИсключение;
	КонецПопытки;

	// По схеме у провайдера хотя бы один процессор
	ОдинПроцессор = 1;
	Если МассивПроцессоров.Количество() = ОдинПроцессор Тогда
		Возврат МассивПроцессоров[0];
	КонецЕсли;

	Возврат Новый ОтелКомпозитныйПроцессорСпанов(МассивПроцессоров);

КонецФункции

Функция СоздатьПроцессорСпанов(КонфигПроцессора)

	ПроверитьВстроенныйКомпонент(КонфигПроцессора, "Процессор спанов", "batch, simple");

	Экспортер = СоздатьЭкспортерСпанов(КонфигПроцессора.Экспортер);
	Если ТипЗнч(КонфигПроцессора) = Тип("ОтелКонфигурацияПростогоПроцессора") Тогда
		Возврат Новый ОтелПростойПроцессорСпанов(Экспортер);
	КонецЕсли;

	Базовый = НовыйБазовыйПакетныйПроцессор(Экспортер, "traces", КонфигПроцессора);

	Процессор = Новый ПостроительНаследника(
		Новый ОтелПакетныйПроцессорСпанов(), Базовый).Построить();
	Процессор.ЗапуститьФоновыйЭкспорт();

	Возврат Процессор;

КонецФункции

Функция СоздатьЭкспортерСпанов(КонфигЭкспортера)

	ПроверитьВстроенныйКомпонент(КонфигЭкспортера, "Экспортер спанов", ВстроенныеЭкспортеры);

	// Транспорт создан фабрикой: экспортер закрывает его вместе с собой. timeout - срок каждого экспорта
	Транспорт = СоздатьТранспорт(КонфигЭкспортера, "traces");
	Возврат Новый ОтелЭкспортерСпанов(Транспорт, ПутьСигнала(КонфигЭкспортера, "traces"),
		ТаймаутЭкспорта(КонфигЭкспортера), Истина);

КонецФункции

// ===== ПРОЦЕССОРЫ ЛОГОВ =====

Функция СоздатьПроцессорыЛогов(КонфигурацииПроцессоров)

	// Процессоры, созданные до ошибки конфигурации, закрываются: их фоновый экспорт не остается работать
	МассивПроцессоров = Новый Массив;
	Попытка
		Для Каждого КонфигПроцессора Из КонфигурацииПроцессоров Цикл
			МассивПроцессоров.Добавить(СоздатьПроцессорЛогов(КонфигПроцессора));
		КонецЦикла;
	Исключение
		ЗакрытьСозданные(МассивПроцессоров);
		ВызватьИсключение;
	КонецПопытки;

	// По схеме у провайдера хотя бы один процессор
	ОдинПроцессор = 1;
	Если МассивПроцессоров.Количество() = ОдинПроцессор Тогда
		Возврат МассивПроцессоров[0];
	КонецЕсли;

	Возврат Новый ОтелКомпозитныйПроцессорЛогов(МассивПроцессоров);

КонецФункции

Функция СоздатьПроцессорЛогов(КонфигПроцессора)

	ПроверитьВстроенныйКомпонент(КонфигПроцессора, "Процессор записей лога", "batch, simple");

	Экспортер = СоздатьЭкспортерЛогов(КонфигПроцессора.Экспортер);
	Если ТипЗнч(КонфигПроцессора) = Тип("ОтелКонфигурацияПростогоПроцессора") Тогда
		Возврат Новый ОтелПростойПроцессорЛогов(Экспортер);
	КонецЕсли;

	Базовый = НовыйБазовыйПакетныйПроцессор(Экспортер, "logs", КонфигПроцессора);

	Процессор = Новый ПостроительНаследника(
		Новый ОтелПакетныйПроцессорЛогов(), Базовый).Построить();
	Процессор.ЗапуститьФоновыйЭкспорт();

	Возврат Процессор;

КонецФункции

// Создает основу пакетного процессора спанов или записей лога по секции batch. schedule_delay по
// умолчанию у BatchSpanProcessor - 5000 мс, у BatchLogRecordProcessor - 1000 мс.
//
// Параметры:
//   Экспортер - ОтелЭкспортерСпанов, ОтелЭкспортерЛогов - экспортер процессора
//   Сигнал - Строка - traces или logs
//   КонфигПроцессора - ОтелКонфигурацияПакетногоПроцессора - секция batch
//
// Возвращаемое значение:
//   ОтелБазовыйПакетныйПроцессор
//
Функция НовыйБазовыйПакетныйПроцессор(Экспортер, Сигнал, КонфигПроцессора)

	ЗадержкаОтправки = КонфигПроцессора.ЗадержкаОтправки;
	Если ЗадержкаОтправки = Неопределено Тогда
		ЗадержкаСпанов = 5000;
		ЗадержкаЗаписейЛога = 1000;
		ЗадержкаОтправки = ?(Сигнал = "logs", ЗадержкаЗаписейЛога, ЗадержкаСпанов);
	КонецЕсли;

	Возврат Новый ОтелБазовыйПакетныйПроцессор(Экспортер, Сигнал, КонфигПроцессора.МаксРазмерОчереди,
		КонфигПроцессора.МаксРазмерПакета, ЗадержкаОтправки, КонфигПроцессора.ТаймаутЭкспорта);

КонецФункции

Функция СоздатьЭкспортерЛогов(КонфигЭкспортера)

	ПроверитьВстроенныйКомпонент(КонфигЭкспортера, "Экспортер записей лога", ВстроенныеЭкспортеры);

	// Транспорт создан фабрикой: экспортер закрывает его вместе с собой. timeout - срок каждого экспорта
	Транспорт = СоздатьТранспорт(КонфигЭкспортера, "logs");
	Возврат Новый ОтелЭкспортерЛогов(Транспорт, ПутьСигнала(КонфигЭкспортера, "logs"),
		ТаймаутЭкспорта(КонфигЭкспортера), Истина);

КонецФункции

// ===== ТРАНСПОРТ =====

// Создает транспорт экспортера OTLP: для otlp_grpc - ОтелGrpcТранспорт, для otlp_http -
// ОтелHttpТранспорт с протоколом http/protobuf.
//
// Параметры:
//   КонфигЭкспортера - ОтелКонфигурацияЭкспортераOtlpHttp, ОтелКонфигурацияЭкспортераOtlpGrpc - экспортер
//   Сигнал - Строка - traces, logs или metrics
//
// Возвращаемое значение:
//   ОтелHttpТранспорт, ОтелGrpcТранспорт
//
Функция СоздатьТранспорт(КонфигЭкспортера, Знач Сигнал)

	// Экспортер console - экспортер OTLP, который выводит данные OTLP JSON в стандартный вывод
	Если ЭтоКонсольныйЭкспортер(КонфигЭкспортера) Тогда
		Возврат Новый ОтелКонсольныйТранспорт();
	КонецЕсли;

	// Значения по описанию свойств экспортера проверяются до создания транспорта
	ПроверитьАдресЭкспортера(КонфигЭкспортера);
	ПроверитьСжатие(КонфигЭкспортера);
	ПроверитьНастройкиTls(КонфигЭкспортера);
	Заголовки = СоздатьЗаголовки(КонфигЭкспортера);

	Если ЭтоЭкспортерOtlpGrpc(КонфигЭкспортера) Тогда
		Адрес = КонфигЭкспортера.Адрес;
		Если Адрес = "" Тогда
			Адрес = "http://localhost:4317";
		КонецЕсли;
		ПредупредитьОСжатииGrpc(КонфигЭкспортера.Сжатие);
		ПредупредитьОРазмереОтветаGrpc(КонфигЭкспортера.МаксРазмерОтвета);
		Возврат Новый ОтелGrpcТранспорт(Адрес, КонфигЭкспортера.НастройкиTls, Заголовки, , КонфигЭкспортера.Таймаут)
			.УстановитьМаксРазмерЗапроса(КонфигЭкспортера.МаксРазмерЗапроса);
	КонецЕсли;

	Адрес = КонфигЭкспортера.Адрес;
	Если Адрес = "" Тогда
		Адрес = "http://localhost:4318/v1/" + Сигнал;
	КонецЕсли;

	МиллисекундВСекунде = 1000;
	ТаймаутСек = КонфигЭкспортера.Таймаут / МиллисекундВСекунде;

	Компрессия = Неопределено;
	Если КонфигЭкспортера.Сжатие = "gzip" Тогда
		Компрессия = "gzip";
	КонецЕсли;

	// Значение encoding проверено схемой: protobuf (по умолчанию) или json
	Протокол = "http/protobuf";
	Если КонфигЭкспортера.Кодирование = "json" Тогда
		Протокол = "http/json";
	КонецЕсли;

	Возврат Новый ОтелHttpТранспорт(
		Адрес, Заголовки, ТаймаутСек, , Компрессия, КонфигЭкспортера.НастройкиTls, Протокол, Сигнал)
		.УстановитьМаксРазмерЗапроса(КонфигЭкспортера.МаксРазмерЗапроса)
		.УстановитьМаксРазмерОтвета(КонфигЭкспортера.МаксРазмерОтвета);

КонецФункции

// Проверяет адрес экспортера по описанию endpoint (Configuration SDK, Create: значение, недопустимое по
// описанию свойства, - ошибка). Адрес otlp_http - URL со схемой http или https, включая путь сигнала.
// Адрес otlp_grpc - URL со схемой http или https или адрес без схемы: защищенность такого соединения
// задает tls.insecure (OTLP Exporter, Insecure). Регистр схемы не учитывается, как в URL.
//
// Параметры:
//   КонфигЭкспортера - ОтелКонфигурацияЭкспортераOtlpHttp, ОтелКонфигурацияЭкспортераOtlpGrpc - экспортер
//
Процедура ПроверитьАдресЭкспортера(КонфигЭкспортера)

	Адрес = КонфигЭкспортера.Адрес;
	ПозицияСхемы = СтрНайти(Адрес, "://");
	ЭтоGrpc = ЭтоЭкспортерOtlpGrpc(КонфигЭкспортера);
	Если Адрес = "" ИЛИ ПозицияСхемы = 0 И ЭтоGrpc Тогда
		Возврат;
	КонецЕсли;

	Схема = ?(ПозицияСхемы = 0, "", НРег(Лев(Адрес, ПозицияСхемы - 1)));
	Если Схема = "http" ИЛИ Схема = "https" Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоGrpc Тогда
		ВызватьИсключение СтрШаблон(
			"Экспортер otlp_grpc: endpoint ""%1"" должен быть URL со схемой http или https или адресом без схемы",
			Адрес);
	КонецЕсли;
	ВызватьИсключение СтрШаблон(
		"Экспортер otlp_http: endpoint ""%1"" должен быть URL со схемой http или https", Адрес);

КонецПроцедуры

// Проверяет сжатие экспортера по описанию compression: известные значения gzip и none, другое - если SDK
// его поддерживает. SDK поддерживает только gzip и none, поэтому другое значение, в том числе в другом
// регистре, - ошибка (Configuration SDK, Create).
//
// Параметры:
//   КонфигЭкспортера - ОтелКонфигурацияЭкспортераOtlpHttp, ОтелКонфигурацияЭкспортераOtlpGrpc - экспортер
//
Процедура ПроверитьСжатие(КонфигЭкспортера)

	Сжатие = КонфигЭкспортера.Сжатие;
	Если Сжатие <> "" И Сжатие <> "none" И Сжатие <> "gzip" Тогда
		ВызватьИсключение СтрШаблон("Экспортер %1: сжатие ""%2"" не поддерживается. Поддерживаются: gzip, none",
			ИмяЭкспортера(КонфигЭкспортера), Сжатие);
	КонецЕсли;

КонецПроцедуры

Функция ИмяЭкспортера(КонфигЭкспортера)
	Возврат ?(ЭтоЭкспортерOtlpGrpc(КонфигЭкспортера), "otlp_grpc", "otlp_http");
КонецФункции

// Проверяет tls экспортера по описанию свойств (Configuration SDK, Create): клиентский ключ key_file и
// сертификат cert_file задаются только вместе, ca_file, key_file и cert_file - абсолютные пути к
// существующим файлам.
//
// Параметры:
//   КонфигЭкспортера - ОтелКонфигурацияЭкспортераOtlpHttp, ОтелКонфигурацияЭкспортераOtlpGrpc - экспортер
//
Процедура ПроверитьНастройкиTls(КонфигЭкспортера)

	НастройкиTls = КонфигЭкспортера.НастройкиTls;
	Если НастройкиTls = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Имя = ИмяЭкспортера(КонфигЭкспортера);
	ЗаданКлюч = НастройкиTls.ФайлКлиентскогоКлюча <> "";
	ЗаданСертификат = НастройкиTls.ФайлКлиентскогоСертификата <> "";
	Если ЗаданКлюч <> ЗаданСертификат Тогда
		ВызватьИсключение СтрШаблон("Экспортер %1: tls.key_file и tls.cert_file задаются только вместе", Имя);
	КонецЕсли;
	ПроверитьФайлTls(Имя, "ca_file", НастройкиTls.ФайлСертификата);
	ПроверитьФайлTls(Имя, "key_file", НастройкиTls.ФайлКлиентскогоКлюча);
	ПроверитьФайлTls(Имя, "cert_file", НастройкиTls.ФайлКлиентскогоСертификата);

КонецПроцедуры

Процедура ПроверитьФайлTls(Знач ИмяЭкспортера, Знач Ключ, Знач Путь)

	// Пустой путь - файл не задан
	Если Путь = "" Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЭтоАбсолютныйПуть(Путь) Тогда
		ВызватьИсключение СтрШаблон("Экспортер %1: tls.%2 ""%3"" должен быть абсолютным путем к файлу",
			ИмяЭкспортера, Ключ, Путь);
	КонецЕсли;
	// ЭтоФайл() несуществующего файла - исключение
	Файл = Новый Файл(Путь);
	Если НЕ Файл.Существует() ИЛИ НЕ Файл.ЭтоФайл() Тогда
		ВызватьИсключение СтрШаблон("Экспортер %1: файл tls.%2 ""%3"" не найден", ИмяЭкспортера, Ключ, Путь);
	КонецЕсли;

КонецПроцедуры

// Возвращает Истина для абсолютного пути: от корня (/etc/ca.pem), с буквой диска (C:\certs\ca.pem) или
// сетевого (\\server\certs\ca.pem).
//
// Параметры:
//   Путь - Строка - путь к файлу
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоАбсолютныйПуть(Знач Путь)

	ШаблонАбсолютногоПути = Новый РегулярноеВыражение("^(/|\\\\|[A-Za-z]:[\\/])");
	Возврат ШаблонАбсолютногоПути.Совпадает(Путь);

КонецФункции

// Возвращает путь, который экспортер передает транспорту: адрес otlp_http уже содержит путь сигнала,
// а gRPC-транспорт выбирает по пути сервис сигнала.
//
// Параметры:
//   КонфигЭкспортера - ОтелКонфигурацияЭкспортераOtlpHttp, ОтелКонфигурацияЭкспортераOtlpGrpc - экспортер
//   Сигнал - Строка - traces, logs или metrics
//
// Возвращаемое значение:
//   Строка - "/v1/<сигнал>" для otlp_grpc, "" для otlp_http
//
Функция ПутьСигнала(КонфигЭкспортера, Знач Сигнал)

	Если ЭтоЭкспортерOtlpGrpc(КонфигЭкспортера) Тогда
		Возврат "/v1/" + Сигнал;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ЭтоЭкспортерOtlpGrpc(КонфигЭкспортера)
	Возврат ТипЗнч(КонфигЭкспортера) = Тип("ОтелКонфигурацияЭкспортераOtlpGrpc");
КонецФункции

Функция ЭтоКонсольныйЭкспортер(КонфигЭкспортера)
	Возврат ТипЗнч(КонфигЭкспортера) = Тип("ОтелКонфигурацияКонсольногоЭкспортера");
КонецФункции

// Возвращает срок каждого экспорта: timeout экспортера OTLP; у console своего срока нет - вывод не
// ждет сети, срок экспорта по умолчанию 10000 мс.
//
// Параметры:
//   КонфигЭкспортера - Произвольный - конфигурация экспортера otlp_http, otlp_grpc или console
//
// Возвращаемое значение:
//   Число - срок экспорта, мс
//
Функция ТаймаутЭкспорта(КонфигЭкспортера)
	ТаймаутПоУмолчанию = 10000;
	Если ЭтоКонсольныйЭкспортер(КонфигЭкспортера) Тогда
		Возврат ТаймаутПоУмолчанию;
	КонецЕсли;
	Возврат КонфигЭкспортера.Таймаут;
КонецФункции

// Клиент OPI_GRPC не поддерживает сжатие
// (https://github.com/Bayselonarrend/OpenIntegrations/issues/112): о сжатии gzip у otlp_grpc выводит
// предупреждение, а не игнорирует его молча.
//
// Параметры:
//   Сжатие - Строка - compression экспортера otlp_grpc
//
Процедура ПредупредитьОСжатииGrpc(Знач Сжатие)

	Если Сжатие = "gzip" Тогда
		Лог.Предупреждение(
			"Сжатие '%1' экспортера otlp_grpc не поддерживается клиентом OPI_GRPC, данные отправляются без сжатия."
			+ " Подробнее: https://github.com/Bayselonarrend/OpenIntegrations/issues/112",
			Сжатие);
	КонецЕсли;

КонецПроцедуры

Процедура ПредупредитьОРазмереОтветаGrpc(Знач МаксРазмерОтвета)

	// Клиент OPI_GRPC принимает ответ не больше 4 MiB, другой лимит задать нельзя
	ЛимитОтветаКлиента = 4194304;
	Если МаксРазмерОтвета <> ЛимитОтветаКлиента Тогда
		ЗаданныйЛимит = Формат(МаксРазмерОтвета, "ЧГ=");
		ДействующийЛимит = Формат(ЛимитОтветаКлиента, "ЧГ=");
		Лог.Предупреждение(
			"max_response_size %1 экспортера otlp_grpc не поддерживается клиентом OPI_GRPC: он принимает ответ"
			+ " не больше %2 байт. Подробнее: https://github.com/Bayselonarrend/OpenIntegrations/issues/113",
			ЗаданныйЛимит, ДействующийЛимит);
	КонецЕсли;

КонецПроцедуры

Функция СоздатьЗаголовки(КонфигЭкспортера)

	Заголовки = Новый Соответствие;

	// Из строки в формате OTEL_EXPORTER_OTLP_HEADERS: key1=value1,key2=value2. Configuration SDK, Create:
	// строка, которая не разбирается в этом формате, - ошибка
	Если КонфигЭкспортера.СписокЗаголовков <> "" Тогда
		Попытка
			Пары = РазобратьПары(КонфигЭкспортера.СписокЗаголовков, Истина);
		Исключение
			ВызватьИсключение СтрШаблон("Экспортер %1: некорректный headers_list: %2",
				ИмяЭкспортера(КонфигЭкспортера), ИнформацияОбОшибке().Описание);
		КонецПопытки;
		Для Каждого КлючИЗначение Из Пары Цикл
			Заголовки.Вставить(
				КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

	// Из структурированного массива (YAML формат). По схеме файла конфигурации записи headers
	// приоритетнее записей headers_list, поэтому применяются после; запись со значением null
	// пропускается
	Для Каждого Запись Из КонфигЭкспортера.Заголовки Цикл
		Если Запись.Значение <> Неопределено Тогда
			Заголовки.Вставить(Запись.Имя, Запись.Значение);
		КонецЕсли;
	КонецЦикла;

	Если Заголовки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Заголовки;

КонецФункции

// ===== ЧИТАТЕЛЬ МЕТРИК =====

Функция СоздатьЧитательМетрик(КонфигЧитателя)

	// pull-читатель: встроенного pull-экспортера в SDK нет
	ПроверитьВстроенныйКомпонент(КонфигЧитателя, "Читатель метрик", "periodic");
	// Встроенных продюсеров метрик в SDK нет
	Если КонфигЧитателя.Продюсеры.Количество() > 0 Тогда
		ВызватьИсключение ТекстНеподдерживаемогоКомпонента("Продюсер метрик", КонфигЧитателя.Продюсеры[0].Имя);
	КонецЕсли;

	КонфигЭкспортера = КонфигЧитателя.Экспортер;
	ПроверитьВстроенныйКомпонент(КонфигЭкспортера, "Экспортер метрик", ВстроенныеЭкспортеры);

	Транспорт = СоздатьТранспорт(КонфигЭкспортера, "metrics");

	Селектор = РазрешитьСелекторВременнойАгрегации(
		КонфигЭкспортера.ПредпочтениеВременнойАгрегации);

	// Агрегация гистограмм - настройка OTLP-экспортера: читатель берет ее у экспортера
	АгрегацияГистограмм = КонфигЭкспортера.АгрегацияГистограммПоУмолчанию;
	Если АгрегацияГистограмм = "" Тогда
		АгрегацияГистограмм = "explicit_bucket_histogram";
	КонецЕсли;
	// Транспорт создан фабрикой: экспортер закрывает его вместе с собой. timeout - срок каждого экспорта
	Экспортер = Новый ОтелЭкспортерМетрик(Транспорт, Селектор, ПутьСигнала(КонфигЭкспортера, "metrics"),
		ТаймаутЭкспорта(КонфигЭкспортера), АгрегацияГистограмм, Истина);

	Читатель = НовыйПериодическийЧитатель(Экспортер, КонфигЧитателя);
	Читатель.Запустить();

	Возврат Читатель;

КонецФункции

// Создает периодический читатель с интервалом, сроком экспорта и лимитами мощности секции periodic.
// Лимит мощности вида инструмента - лимит вида из cardinality_limits, иначе default, иначе 2000.
//
// Параметры:
//   Экспортер - ОтелЭкспортерМетрик - экспортер читателя
//   КонфигЧитателя - ОтелКонфигурацияПериодическогоЧитателя - секция periodic
//
// Возвращаемое значение:
//   ОтелПериодическийЧитательМетрик - незапущенный читатель
//
Функция НовыйПериодическийЧитатель(Экспортер, КонфигЧитателя)

	ЛимитыМощности = КонфигЧитателя.ЛимитыМощности;
	Если ЛимитыМощности = Неопределено Тогда
		ЛимитыМощности = Новый ОтелКонфигурацияЛимитовМощности();
	КонецЕсли;

	Читатель = Новый ОтелПериодическийЧитательМетрик(Экспортер, КонфигЧитателя.Интервал, ЛимитыМощности.ПоУмолчанию);
	Читатель.УстановитьТаймаутЭкспортаМс(КонфигЧитателя.Таймаут);

	ЛимитыВидов = Новый Соответствие;
	ЛимитыВидов.Вставить("Counter", ЛимитыМощности.Счетчик);
	ЛимитыВидов.Вставить("UpDownCounter", ЛимитыМощности.РеверсивныйСчетчик);
	ЛимитыВидов.Вставить("Histogram", ЛимитыМощности.Гистограмма);
	ЛимитыВидов.Вставить("Gauge", ЛимитыМощности.Датчик);
	ЛимитыВидов.Вставить("ObservableCounter", ЛимитыМощности.НаблюдаемыйСчетчик);
	ЛимитыВидов.Вставить("ObservableUpDownCounter", ЛимитыМощности.НаблюдаемыйРеверсивныйСчетчик);
	ЛимитыВидов.Вставить("ObservableGauge", ЛимитыМощности.НаблюдаемыйДатчик);
	// Вид без своего лимита берет лимит читателя по умолчанию
	Для Каждого ЛимитВида Из ЛимитыВидов Цикл
		Если ЛимитВида.Значение <> Неопределено Тогда
			Читатель.УстановитьЛимитМощностиДляВида(ЛимитВида.Ключ, ЛимитВида.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Читатель;

КонецФункции

// ===== ЛИМИТЫ =====

Функция СоздатьЛимитыСпана(КонфигЛимитовСпана, КонфигГлобЛимитов)

	// Незаданная секция limits - лимиты по умолчанию схемы
	КонфигЛимитов = КонфигЛимитовСпана;
	Если КонфигЛимитов = Неопределено Тогда
		КонфигЛимитов = Новый ОтелКонфигурацияЛимитовСпана();
	КонецЕсли;

	Лимиты = Новый ОтелЛимитыСпана();
	УстановитьЛимитыАтрибутов(Лимиты, КонфигЛимитов, КонфигГлобЛимитов);
	Лимиты
		.УстановитьМаксСобытий(КонфигЛимитов.МаксСобытий)
		.УстановитьМаксЛинков(КонфигЛимитов.МаксЛинков)
		.УстановитьМаксАтрибутовНаСобытие(КонфигЛимитов.МаксАтрибутовНаСобытие)
		.УстановитьМаксАтрибутовНаЛинк(КонфигЛимитов.МаксАтрибутовНаЛинк);

	Возврат Лимиты;

КонецФункции

Функция СоздатьЛимитыЗаписейЛога(КонфигЛимитов, КонфигГлобЛимитов)

	Лимиты = Новый ОтелЛимитыЗаписейЛога();
	УстановитьЛимитыАтрибутов(Лимиты, КонфигЛимитов, КонфигГлобЛимитов);
	Возврат Лимиты;

КонецФункции

// Устанавливает лимиты атрибутов спана или записи лога. По схеме файла конфигурации лимит секции
// limits провайдера перекрывает лимит attribute_limits, а без обоих действует значение по умолчанию:
// 128 атрибутов, длина значения без ограничения, глубина значения 64.
//
// Параметры:
//   Лимиты - ОтелЛимитыСпана, ОтелЛимитыЗаписейЛога - лимиты SDK
//   КонфигЛимитов - ОтелКонфигурацияЛимитовСпана, ОтелКонфигурацияЛимитовАтрибутов, Неопределено -
//       секция limits провайдера
//   КонфигГлобЛимитов - ОтелКонфигурацияЛимитовАтрибутов, Неопределено - секция attribute_limits
//
Процедура УстановитьЛимитыАтрибутов(Лимиты, КонфигЛимитов, КонфигГлобЛимитов)

	// Незаданная секция - секция без лимитов
	ЛимитыПровайдера = КонфигЛимитов;
	Если ЛимитыПровайдера = Неопределено Тогда
		ЛимитыПровайдера = Новый ОтелКонфигурацияЛимитовАтрибутов();
	КонецЕсли;
	ОбщиеЛимиты = КонфигГлобЛимитов;
	Если ОбщиеЛимиты = Неопределено Тогда
		ОбщиеЛимиты = Новый ОтелКонфигурацияЛимитовАтрибутов();
	КонецЕсли;

	КоличествоПоУмолчанию = 128;
	ГлубинаПоУмолчанию = 64;
	МаксАтрибутов = ЛимитАтрибутов(ЛимитыПровайдера.МаксКоличествоАтрибутов,
		ОбщиеЛимиты.МаксКоличествоАтрибутов, КоличествоПоУмолчанию);
	МаксДлина = ЛимитАтрибутов(ЛимитыПровайдера.МаксДлинаЗначенияАтрибута,
		ОбщиеЛимиты.МаксДлинаЗначенияАтрибута, Неопределено);
	МаксГлубина = ЛимитАтрибутов(ЛимитыПровайдера.МаксГлубинаЗначенияАтрибута,
		ОбщиеЛимиты.МаксГлубинаЗначенияАтрибута, ГлубинаПоУмолчанию);

	Лимиты
		.УстановитьМаксАтрибутов(МаксАтрибутов)
		.УстановитьМаксДлинаЗначенияАтрибута(МаксДлина)
		.УстановитьМаксГлубинаЗначенияАтрибута(МаксГлубина);

КонецПроцедуры

Функция ЛимитАтрибутов(ЛимитПровайдера, ОбщийЛимит, ЛимитПоУмолчанию)

	// Неопределено - лимит в секции не задан
	Если ЛимитПровайдера <> Неопределено Тогда
		Возврат ЛимитПровайдера;
	ИначеЕсли ОбщийЛимит <> Неопределено Тогда
		Возврат ОбщийЛимит;
	Иначе
		Возврат ЛимитПоУмолчанию;
	КонецЕсли;

КонецФункции

// ===== СЭМПЛЕР =====

// Создает сэмплер из конфигурации. Сэмплеры, вложенные в parent_based, создаются так же,
// каждый со своими параметрами. Не заданный сэмплер заменяется сэмплером по умолчанию, сэмплер,
// которого нет в SDK, - ошибка (Configuration SDK, Create).
//
// Параметры:
//   КонфигСэмплера - ОтелКонфигурацияСэмплера, ОтелКонфигурацияКомпонента, Неопределено - конфигурация
//     сэмплера; ОтелКонфигурацияКомпонента - сэмплер, которого нет в SDK
//   Умолчание - ИнтерфейсСэмплер - сэмплер, если конфигурация не задана
//
// Возвращаемое значение:
//   ИнтерфейсСэмплер
//
Функция СоздатьСэмплер(КонфигСэмплера, Умолчание)

	Если КонфигСэмплера = Неопределено Тогда
		Возврат Умолчание;
	КонецЕсли;

	ВстроенныеСэмплеры = "always_on, always_off, trace_id_ratio_based, parent_based, always_record";
	ПроверитьВстроенныйКомпонент(КонфигСэмплера, "Сэмплер", ВстроенныеСэмплеры);
	Если КонфигСэмплера.Тип = "" Тогда
		Возврат Умолчание;
	КонецЕсли;

	// Тип - ключ схемы, регистр значим, как в файле
	Тип = КонфигСэмплера.Тип;

	Если Тип = "always_on" Тогда
		Сэмплер = ОтелСэмплер.ВсегдаВключен();
	ИначеЕсли Тип = "always_off" Тогда
		Сэмплер = ОтелСэмплер.ВсегдаВыключен();
	ИначеЕсли Тип = "trace_id_ratio_based" Тогда
		Сэмплер = ОтелСэмплер.ПоДолеТрассировок(КонфигСэмплера.Доля);
	ИначеЕсли Тип = "parent_based" Тогда
		Сэмплер = СоздатьСэмплерНаОсновеРодителя(КонфигСэмплера);
	ИначеЕсли Тип = "always_record" Тогда
		Сэмплер = СоздатьСэмплерВсегдаЗаписывать(КонфигСэмплера);
	Иначе
		ВызватьИсключение ТекстНеподдерживаемогоКомпонента("Сэмплер", КонфигСэмплера.Тип, ВстроенныеСэмплеры);
	КонецЕсли;
	Возврат Сэмплер;

КонецФункции

// Создает сэмплер parent_based. Корневой сэмплер и делегаты создаются из своих конфигураций;
// не заданные заменяются значениями по умолчанию: корневой и делегаты сэмплированного родителя -
// always_on, делегаты несэмплированного родителя - always_off.
//
// Параметры:
//   КонфигСэмплера - ОтелКонфигурацияСэмплера - конфигурация сэмплера parent_based
//
// Возвращаемое значение:
//   ОтелСэмплерНаОсновеРодителя
//
Функция СоздатьСэмплерНаОсновеРодителя(КонфигСэмплера)

	ВсегдаВключен = ОтелСэмплер.ВсегдаВключен();
	ВсегдаВыключен = ОтелСэмплер.ВсегдаВыключен();
	Корневой = СоздатьСэмплер(КонфигСэмплера.Корневой, ВсегдаВключен);
	УдаленныйСэмплирован = СоздатьСэмплер(КонфигСэмплера.УдаленныйРодительСэмплирован, ВсегдаВключен);
	УдаленныйНеСэмплирован = СоздатьСэмплер(КонфигСэмплера.УдаленныйРодительНеСэмплирован, ВсегдаВыключен);
	ЛокальныйСэмплирован = СоздатьСэмплер(КонфигСэмплера.ЛокальныйРодительСэмплирован, ВсегдаВключен);
	ЛокальныйНеСэмплирован = СоздатьСэмплер(КонфигСэмплера.ЛокальныйРодительНеСэмплирован, ВсегдаВыключен);
	Возврат ОтелСэмплер.НаОсновеРодителя(Корневой,
		УдаленныйСэмплирован, УдаленныйНеСэмплирован,
		ЛокальныйСэмплирован, ЛокальныйНеСэмплирован);

КонецФункции

// Создает сэмплер always_record. Обернутый сэмплер root обязателен по схеме конфигурации: модель без
// него не проходит проверку по схеме.
//
// Параметры:
//   КонфигСэмплера - ОтелКонфигурацияСэмплера - конфигурация сэмплера always_record
//
// Возвращаемое значение:
//   ОтелСэмплерВсегдаЗаписывать
//
Функция СоздатьСэмплерВсегдаЗаписывать(КонфигСэмплера)

	ВсегдаВключен = ОтелСэмплер.ВсегдаВключен();
	Корневой = СоздатьСэмплер(КонфигСэмплера.Корневой, ВсегдаВключен);
	Возврат ОтелСэмплер.ВсегдаЗаписывать(Корневой);

КонецФункции

// ===== ФИЛЬТРЫ И СЕЛЕКТОРЫ =====

// Значения перечислений проверены по схеме: другие значения, кроме пустой строки (не задано), не проходят
// проверку модели

Функция РазрешитьФильтрЭкземпляров(Знач ЗначениеФильтра)

	Если ЗначениеФильтра = "always_on" Тогда
		Возврат ОтелФильтрЭкземпляров.ВсегдаВключен();
	ИначеЕсли ЗначениеФильтра = "always_off" Тогда
		Возврат ОтелФильтрЭкземпляров.ВсегдаВыключен();
	Иначе
		// trace_based - значение по умолчанию
		Возврат ОтелФильтрЭкземпляров.ПоТрассировке();
	КонецЕсли;

КонецФункции

Функция РазрешитьСелекторВременнойАгрегации(Знач Предпочтение)

	Если Предпочтение = "delta" Тогда
		Возврат ОтелСелекторВременнойАгрегации.ПредпочтительноДельта();
	ИначеЕсли Предпочтение = "low_memory" Тогда
		Возврат ОтелСелекторВременнойАгрегации.НизкоеПотреблениеПамяти();
	Иначе
		// cumulative - значение по умолчанию
		Возврат ОтелСелекторВременнойАгрегации.ВсегдаКумулятивная();
	КонецЕсли;

КонецФункции

// ===== ПРОПАГАТОРЫ =====

// Собирает имена пропагаторов из composite, затем из composite_list.
//
// Параметры:
//   КонфигПропагатора - ОтелКонфигурацияПропагатора, Неопределено - секция propagator
//
// Возвращаемое значение:
//   Массив из Структура - имена по порядку:
//     * Имя - Строка - имя для выбора пропагатора: ключ composite как есть (ключи схемы различают
//         регистр), имя из composite_list в нижнем регистре (как значение OTEL_PROPAGATORS)
//     * Исходное - Строка - имя, как его задал пользователь, для текста ошибки
//
Функция СобратьИменаПропагаторов(КонфигПропагатора)

	ИменаПропагаторов = Новый Массив;

	Если КонфигПропагатора = Неопределено Тогда
		Возврат ИменаПропагаторов;
	КонецЕсли;

	Для Каждого Компонент Из КонфигПропагатора.Составной Цикл
		ИменаПропагаторов.Добавить(Новый Структура("Имя, Исходное", Компонент.Имя, Компонент.Имя));
	КонецЦикла;

	// Строка в формате OTEL_PROPAGATORS: tracecontext,baggage
	Для Каждого Часть Из СтрРазделить(КонфигПропагатора.СписокСоставного, ",", Ложь) Цикл
		Исходное = СокрЛП(Часть);
		Если Исходное <> "" Тогда
			ИменаПропагаторов.Добавить(Новый Структура("Имя, Исходное", НРег(Исходное), Исходное));
		КонецЕсли;
	КонецЦикла;

	Возврат ИменаПропагаторов;

КонецФункции

Процедура ПроверитьОграниченияNone(ИменаПропагаторов)

	СодержитNone = Ложь;
	Для Каждого Пропагатор Из ИменаПропагаторов Цикл
		Если Пропагатор.Имя = "none" Тогда
			СодержитNone = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ОдинПропагатор = 1;
	Если СодержитNone
		И ИменаПропагаторов.Количество() > ОдинПропагатор Тогда
		ВызватьИсключение
			"Значение ""none"" в конфигурации пропагаторов"
				+ " не может использоваться"
				+ " совместно с другими пропагаторами";
	КонецЕсли;

КонецПроцедуры

// Создает пропагатор по имени из OTEL_PROPAGATORS: tracecontext, baggage, b3, b3multi. Неизвестное
// имя и b3 без пакета opentelemetry-propagator-b3 логируются и пропускаются: переменная окружения с
// нераспознанным значением не должна мешать запуску. Пропагаторы файла конфигурации создает
// СоздатьПропагаторы: там такое имя - ошибка.
//
// Параметры:
//   Имя - Строка - имя пропагатора в нижнем регистре без пробелов по краям
//   ИсходноеИмя - Строка, Неопределено - имя, как его задал пользователь, для предупреждения
//     о неизвестном пропагаторе (необязательный, по умолчанию Имя)
//
// Возвращаемое значение:
//   Произвольный, Неопределено - пропагатор или Неопределено, если имя неизвестно
//     или пакет opentelemetry-propagator-b3 не установлен
//
Функция РазрешитьПропагаторПоИмени(Знач Имя, Знач ИсходноеИмя = Неопределено) Экспорт

	Попытка
		Пропагатор = НовыйВстроенныйПропагатор(Имя);
	Исключение
		Лог.Предупреждение("%1. Пропагатор пропущен", ИнформацияОбОшибке().Описание);
		Возврат Неопределено;
	КонецПопытки;

	Если Пропагатор = Неопределено Тогда
		Лог.Предупреждение(
			"Неизвестный пропагатор ""%1"", пропущен", ?(ИсходноеИмя = Неопределено, Имя, ИсходноеИмя));
	КонецЕсли;
	Возврат Пропагатор;

КонецФункции

// Создает пропагатор файла конфигурации по имени. Пропагатор, которого нет в SDK, и b3 без пакета
// opentelemetry-propagator-b3 - ошибка (Configuration SDK, Create).
//
// Параметры:
//   Имя - Строка - имя пропагатора
//   ИсходноеИмя - Строка - имя, как его задал пользователь, для текста ошибки
//
// Возвращаемое значение:
//   Произвольный - пропагатор
//
Функция СоздатьПропагатор(Знач Имя, Знач ИсходноеИмя)

	Пропагатор = НовыйВстроенныйПропагатор(Имя);
	Если Пропагатор = Неопределено Тогда
		ВызватьИсключение ТекстНеподдерживаемогоКомпонента(
			"Пропагатор", ИсходноеИмя, "tracecontext, baggage, b3, b3multi, none");
	КонецЕсли;
	Возврат Пропагатор;

КонецФункции

// Создает встроенный пропагатор по имени: tracecontext, baggage, b3, b3multi.
//
// Параметры:
//   Имя - Строка - имя пропагатора
//
// Возвращаемое значение:
//   Произвольный, Неопределено - пропагатор; Неопределено - пропагатора с таким именем в SDK нет
//
Функция НовыйВстроенныйПропагатор(Знач Имя)

	Если Имя = "tracecontext" Тогда
		Пропагатор = Новый ОтелW3CПропагатор();
	ИначеЕсли Имя = "baggage" Тогда
		Пропагатор = Новый ОтелW3CBaggageПропагатор();
	ИначеЕсли Имя = "b3" ИЛИ Имя = "b3multi" Тогда
		Пропагатор = НовыйПропагаторB3(Имя);
	Иначе
		Пропагатор = Неопределено;
	КонецЕсли;
	Возврат Пропагатор;

КонецФункции

// Создает B3-пропагатор по имени класса: ОтелB3Пропагатор поставляется отдельным пакетом
// opentelemetry-propagator-b3. Без пакета выбрасывает исключение с подсказкой, как его установить.
//
// Параметры:
//   ИмяПропагатора - Строка - "b3" (single-header) или "b3multi" (multi-header)
//
// Возвращаемое значение:
//   Произвольный - экземпляр ОтелB3Пропагатор
//
Функция НовыйПропагаторB3(Знач ИмяПропагатора)

	ПараметрыКонструктора = Новый Массив();
	Если ИмяПропагатора = "b3multi" Тогда
		ПараметрыКонструктора.Добавить("multi");
	Иначе
		ПараметрыКонструктора.Добавить("single");
	КонецЕсли;

	Попытка
		Возврат Новый("ОтелB3Пропагатор", ПараметрыКонструктора);
	Исключение
		ВызватьИсключение СтрШаблон(
			"Пропагатор ""%1"" недоступен: класс ОтелB3Пропагатор не найден."
				+ " Установите пакет opentelemetry-propagator-b3 (opm install"
				+ " opentelemetry-propagator-b3) и подключите #Использовать"
				+ " opentelemetry-propagator-b3",
			ИмяПропагатора);
	КонецПопытки;

КонецФункции

// ===== КОМПОНЕНТЫ =====

// Проверяет, что компонент встроен в SDK. Компонент, которого нет в SDK, разбор файла сохраняет как
// ОтелКонфигурацияКомпонента; Configuration SDK, Create: для такого компонента - ошибка.
//
// Параметры:
//   Конфиг - Произвольный - конфигурация компонента
//   ВидКомпонента - Строка - вид компонента для текста ошибки, например "Экспортер спанов"
//   Встроенные - Строка - имена встроенных компонентов этого вида через запятую
//
Процедура ПроверитьВстроенныйКомпонент(Конфиг, Знач ВидКомпонента, Знач Встроенные)

	Если ТипЗнч(Конфиг) = Тип("ОтелКонфигурацияКомпонента") Тогда
		ВызватьИсключение ТекстНеподдерживаемогоКомпонента(ВидКомпонента, Конфиг.Имя, Встроенные);
	КонецЕсли;

КонецПроцедуры

// Проверяет генератор ID: в SDK встроен только random - генератор по умолчанию.
//
// Параметры:
//   КонфигГенератора - ОтелКонфигурацияКомпонента, Неопределено - секция id_generator
//
Процедура ПроверитьГенераторИд(КонфигГенератора)

	Если КонфигГенератора <> Неопределено И КонфигГенератора.Имя <> "random" Тогда
		ВызватьИсключение ТекстНеподдерживаемогоКомпонента("Генератор ID", КонфигГенератора.Имя, "random");
	КонецЕсли;

КонецПроцедуры

// Возвращает текст ошибки о компоненте, которого нет в SDK.
//
// Параметры:
//   ВидКомпонента - Строка - вид компонента, например "Экспортер спанов"
//   Имя - Строка - имя компонента в конфигурации
//   Встроенные - Строка - имена встроенных компонентов этого вида через запятую; "" - встроенных нет
//
// Возвращаемое значение:
//   Строка
//
Функция ТекстНеподдерживаемогоКомпонента(Знач ВидКомпонента, Знач Имя, Знач Встроенные = "")

	Текст = СтрШаблон("%1 ""%2"" не поддерживается", ВидКомпонента, Имя);
	Если Встроенные = "" Тогда
		Возврат Текст + ": встроенных компонентов этого вида в SDK нет";
	КонецЕсли;
	Возврат СтрШаблон("%1. Поддерживаются: %2", Текст, Встроенные);

КонецФункции

// ===== УТИЛИТЫ =====

// Закрывает провайдеры, процессоры или читатели, созданные до ошибки конфигурации. Ошибка закрытия
// пишется в лог и не заменяет ошибку конфигурации.
//
// Параметры:
//   Компоненты - Массив - созданные компоненты с методом Закрыть
//
Процедура ЗакрытьСозданные(Компоненты)

	Для Каждого Компонент Из Компоненты Цикл
		Попытка
			Компонент.Закрыть();
		Исключение
			Лог.Предупреждение("Ошибка закрытия компонента после ошибки конфигурации: %1", ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Функция СоздатьНоопSdk()

	Ресурс = Новый ОтелРесурс(Ложь, "", Истина);

	СэмплерВыключен = ОтелСэмплер.ВсегдаВыключен();
	ПровайдерТрассировки = Новый ОтелПровайдерТрассировки(
		Ресурс, , СэмплерВыключен);
	ПровайдерЛогирования = Новый ОтелПровайдерЛогирования(Ресурс);
	ПровайдерМетрик = Новый ОтелПровайдерМетрик(Ресурс);
	ПровайдерМетрик.УстановитьВключен(Ложь);

	Возврат Новый ОтелПостроительSdk()
		.УстановитьПровайдерТрассировки(ПровайдерТрассировки)
		.УстановитьПровайдерЛогирования(ПровайдерЛогирования)
		.УстановитьПровайдерМетрик(ПровайдерМетрик)
		.Построить();

КонецФункции

// Разбирает строку формата key1=value1,key2=value2 в Соответствие.
// Некорректные последовательности percent-encoding остаются в значениях как есть.
//
// Параметры:
//   Строка - Строка - строка с парами ключ=значение через запятую
//
// Возвращаемое значение:
//   Соответствие - пары ключ-значение
//
Функция РазобратьПарыКлючЗначение(Знач Строка) Экспорт

	Возврат РазобратьПары(Строка, Ложь);

КонецФункции

// Разбирает значение OTEL_RESOURCE_ATTRIBUTES (формат key1=value1,key2=value2).
// По спецификации Resource SDK значение с ошибкой разбора отбрасывается целиком,
// поэтому функция выбрасывает исключение, если непустой элемент не в формате
// ключ=значение, ключ пустой или percent-encoding некорректен.
//
// Параметры:
//   Строка - Строка - строка с парами ключ=значение через запятую
//
// Возвращаемое значение:
//   Соответствие - пары ключ-значение
//
Функция РазобратьАтрибутыРесурса(Знач Строка) Экспорт

	Возврат РазобратьПары(Строка, Истина);

КонецФункции

Функция РазобратьПары(Знач Строка, Знач СтрогийРазбор)

	Результат = Новый Соответствие;

	Если Строка = Неопределено ИЛИ Строка = "" Тогда
		Возврат Результат;
	КонецЕсли;

	Пары = СтрРазделить(Строка, ",");
	Для Каждого Пара Из Пары Цикл
		ПозицияРавно = СтрНайти(Пара, "=");
		Ключ = "";
		Если ПозицияРавно > 0 Тогда
			Ключ = СокрЛП(Лев(Пара, ПозицияРавно - 1));
		КонецЕсли;
		Если Ключ = "" Тогда
			Если СтрогийРазбор И НЕ ПустаяСтрока(Пара) Тогда
				ВызватьИсключение СтрШаблон("Элемент '%1' не в формате ключ=значение", СокрЛП(Пара));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Значение = СокрЛП(Сред(Пара, ПозицияРавно + 1));
		Ключ = РаскодироватьЧастьПары(Ключ, СтрогийРазбор);
		Значение = РаскодироватьЧастьПары(Значение, СтрогийРазбор);
		Результат.Вставить(Ключ, Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция РаскодироватьЧастьПары(Знач Строка, Знач СтрогоеДекодирование)

	Если СтрогоеДекодирование Тогда
		Возврат ОтелУтилиты.РаскодироватьURLСтрого(Строка);
	КонецЕсли;
	Возврат РаскодироватьСтроку(Строка, СпособКодированияСтроки.КодировкаURL);

КонецФункции

#КонецОбласти

Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.config.factory");
ВстроенныеЭкспортеры = "otlp_http, otlp_grpc, console";
