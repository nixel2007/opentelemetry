&Тест
Процедура ДетекторХостаВозвращаетРесурс() Экспорт

    // Дано
    Детектор = Новый ОтелДетекторРесурсаХоста();

    // Когда
    Ресурс = Детектор.Обнаружить();

    // Тогда - должен вернуть ресурс с атрибутами хоста
    Ожидаем.Что(Ресурс).ИмеетТип("ОтелРесурс");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("host.name") <> Неопределено).Равно(Истина);
    Ожидаем.Что(Ресурс.Атрибуты().Получить("os.type") <> Неопределено).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ДетекторХостаНеСодержитДефолтов() Экспорт

    // Дано
    Детектор = Новый ОтелДетекторРесурсаХоста();

    // Когда
    Ресурс = Детектор.Обнаружить();

    // Тогда - детектор НЕ должен добавлять service.name и telemetry.sdk.*
    Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name")).Равно(Неопределено);
    Ожидаем.Что(Ресурс.Атрибуты().Получить("telemetry.sdk.name")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ДетекторПроцессаВозвращаетPID() Экспорт

    // Дано
    Детектор = Новый ОтелДетекторРесурсаПроцесса();

    // Когда
    Ресурс = Детектор.Обнаружить();

    // Тогда
    Ожидаем.Что(Ресурс).ИмеетТип("ОтелРесурс");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("process.pid") <> Неопределено).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ДетекторПроцессаНеСодержитДефолтов() Экспорт

    // Дано
    Детектор = Новый ОтелДетекторРесурсаПроцесса();

    // Когда
    Ресурс = Детектор.Обнаружить();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ДетекторПроцессораВозвращаетРесурс() Экспорт

    // Дано
    Детектор = Новый ОтелДетекторРесурсаПроцессора();

    // Когда
    Ресурс = Детектор.Обнаружить();

    // Тогда - должен вернуть ресурс с атрибутами процессора
    Ожидаем.Что(Ресурс).ИмеетТип("ОтелРесурс");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("host.cpu.model.name") <> Неопределено).Равно(Истина);
    Ожидаем.Что(Ресурс.Атрибуты().Получить("host.cpu.count") <> Неопределено).Равно(Истина);
    Ожидаем.Что(Ресурс.Атрибуты().Получить("host.arch") <> Неопределено).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ДетекторПроцессораНеСодержитДефолтов() Экспорт

    // Дано
    Детектор = Новый ОтелДетекторРесурсаПроцессора();

    // Когда
    Ресурс = Детектор.Обнаружить();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name")).Равно(Неопределено);

КонецПроцедуры

// Resource SDK / Detecting resource information from the environment: пустой Schema URL SHOULD
// использоваться, если детектор не заполнил ни одного известного атрибута (например, при сбое
// определения); детекторы строят ресурс через ОтелУтилиты.РесурсДетектора

&Тест
Процедура РесурсДетектораБезАтрибутовБезАдресаСхемы() Экспорт

    // Когда - детектор не определил ни одного атрибута
    Ресурс = ОтелУтилиты.РесурсДетектора(Новый Соответствие(), "https://opentelemetry.io/schemas/1.29.0");

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Количество()).Равно(0);
    Ожидаем.Что(Ресурс.АдресСхемы()).Равно("");

КонецПроцедуры

&Тест
Процедура РесурсДетектораСАтрибутамиПолучаетАдресСхемы() Экспорт

    // Дано
    Атрибуты = Новый Соответствие();
    Атрибуты.Вставить("host.name", "web-1");

    // Когда
    Ресурс = ОтелУтилиты.РесурсДетектора(Атрибуты, "https://opentelemetry.io/schemas/1.29.0");

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Количество()).Равно(1);
    Ожидаем.Что(Ресурс.Атрибуты().Получить("host.name")).Равно("web-1");
    Ожидаем.Что(Ресурс.АдресСхемы()).Равно("https://opentelemetry.io/schemas/1.29.0");

КонецПроцедуры

&Тест
Процедура ДетекторХостаВозвращаетSchemaUrlСемантическихСоглашений() Экспорт

    // Дано
    Детектор = Новый ОтелДетекторРесурсаХоста();

    // Когда
    Ресурс = Детектор.Обнаружить();

    // Тогда - спек Resource detector MUST устанавливать Schema URL равным версии semconv,
    // по которой определены атрибуты host.* и os.*.
    Ожидаем.Что(Ресурс.АдресСхемы()).Равно("https://opentelemetry.io/schemas/1.29.0");

КонецПроцедуры
