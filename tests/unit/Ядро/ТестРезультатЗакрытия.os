#Использовать "../../.."
#Использовать asserts

&Тест
Процедура Тест_УспешноеЗакрытие() Экспорт

    // Дано
    Результат = ОтелРезультатыЗакрытия.Успех();

    // Тогда
    Ожидаем.Что(Результат.Успешно()).Равно(Истина);
    Ожидаем.Что(Результат.ИстекТаймаут()).Равно(Ложь);
    Ожидаем.Что(Результат.Описание()).Равно("");
    Ожидаем.Что(Результат.Успех).Равно(Истина);

КонецПроцедуры

&Тест
Процедура Тест_СОшибкой() Экспорт

    // Дано
    ТестовоеСообщение = "что-то пошло не так";
    Результат = ОтелРезультатыЗакрытия.Ошибка(ТестовоеСообщение);

    // Тогда
    Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
    Ожидаем.Что(Результат.ИстекТаймаут()).Равно(Ложь);
    Ожидаем.Что(Результат.Описание()).Равно(ТестовоеСообщение);
    Ожидаем.Что(Результат.ОшибкаОписание).Равно(ТестовоеСообщение);

КонецПроцедуры

&Тест
Процедура Тест_ИзТаймаута() Экспорт

    // Дано
    Результат = ОтелРезультатыЗакрытия.Таймаут();

    // Тогда
    Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
    Ожидаем.Что(Результат.ИстекТаймаут()).Равно(Истина);
    Ожидаем.Что(Результат.Истекло).Равно(Истина);

КонецПроцедуры

&Тест
Процедура Тест_КонструкторПоУмолчанию() Экспорт

    // Дано
    Результат = Новый ОтелРезультатЗакрытия();

    // Тогда - по умолчанию успешный
    Ожидаем.Что(Результат.Успешно()).Равно(Истина);
    Ожидаем.Что(Результат.ИстекТаймаут()).Равно(Ложь);

КонецПроцедуры

// ЗакрытьВсе: Shutdown MUST вызываться у всех процессоров и читателей, SHOULD укладываться
// в таймаут и сообщать об успехе, ошибке или таймауте

&Тест
Процедура ЗакрытьВсеВызываетЗакрытьУВсехПослеИсключения() Экспорт

    // Дано - первый компонент бросает исключение
    Первый = КомпонентЗакрытия(Неопределено, 0, "сбой закрытия");
    Второй = КомпонентЗакрытия(ОтелРезультатыЗакрытия.Успех());

    // Когда
    Результат = ОтелРезультатыЗакрытия.ЗакрытьВсе(МассивИз(Первый, Второй), 5000);

    // Тогда - оба закрыты, исключение сообщено ошибкой
    Ожидаем.Что(Первый.Закрыт, "первый закрыт").ЭтоИстина();
    Ожидаем.Что(Второй.Закрыт, "второй закрыт").ЭтоИстина();
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
    Ожидаем.Что(Результат.ИстекТаймаут()).ЭтоЛожь();
    Ожидаем.Что(СтрНайти(Результат.Описание(), "сбой закрытия") > 0, Результат.Описание()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗакрытьВсеСообщаетОшибкуКомпонента() Экспорт

    // Дано - компонент вернул ошибку, не бросая исключения
    Первый = КомпонентЗакрытия(ОтелРезультатыЗакрытия.Ошибка("сбой финального экспорта"));
    Второй = КомпонентЗакрытия(ОтелРезультатыЗакрытия.Успех());

    // Когда
    Результат = ОтелРезультатыЗакрытия.ЗакрытьВсе(МассивИз(Первый, Второй), 5000);

    // Тогда
    Ожидаем.Что(Второй.Закрыт, "второй закрыт").ЭтоИстина();
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
    Ожидаем.Что(СтрНайти(Результат.Описание(), "сбой финального экспорта") > 0, Результат.Описание()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗакрытьВсеСообщаетТаймаутКомпонента() Экспорт

    // Дано
    Первый = КомпонентЗакрытия(ОтелРезультатыЗакрытия.Таймаут());
    Второй = КомпонентЗакрытия(Неопределено);

    // Когда
    Результат = ОтелРезультатыЗакрытия.ЗакрытьВсе(МассивИз(Первый, Второй), 5000);

    // Тогда
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
    Ожидаем.Что(Результат.ИстекТаймаут()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗакрытьВсеПередаетОставшеесяВремя() Экспорт

    // Дано
    Первый = КомпонентЗакрытия(ОтелРезультатыЗакрытия.Успех());
    Второй = КомпонентЗакрытия(ОтелРезультатыЗакрытия.Успех());

    // Когда
    Результат = ОтелРезультатыЗакрытия.ЗакрытьВсе(МассивИз(Первый, Второй), 5000);

    // Тогда - каждому компоненту передано время, оставшееся от общего срока
    Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
    Ожидаем.Что(Первый.ПереданныйТаймаут > 4000 И Первый.ПереданныйТаймаут <= 5000, Первый.ПереданныйТаймаут)
        .ЭтоИстина();
    Ожидаем.Что(Второй.ПереданныйТаймаут > 4000 И Второй.ПереданныйТаймаут <= 5000, Второй.ПереданныйТаймаут)
        .ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗакрытьВсеПослеИстеченияСрокаЗакрываетОстальные() Экспорт

    // Дано - первый компонент закрывается дольше общего срока
    Первый = КомпонентЗакрытия(ОтелРезультатыЗакрытия.Успех(), 300);
    Второй = КомпонентЗакрытия(ОтелРезультатыЗакрытия.Успех());

    // Когда
    Результат = ОтелРезультатыЗакрытия.ЗакрытьВсе(МассивИз(Первый, Второй), 100);

    // Тогда - второй все равно закрыт с минимальным временем, итог - таймаут
    Ожидаем.Что(Второй.Закрыт, "второй закрыт").ЭтоИстина();
    Ожидаем.Что(Второй.ПереданныйТаймаут).Равно(1);
    Ожидаем.Что(Результат.ИстекТаймаут()).ЭтоИстина();

КонецПроцедуры

Функция МассивИз(Первый, Второй)
    Результат = Новый Массив();
    Результат.Добавить(Первый);
    Результат.Добавить(Второй);
    Возврат Результат;
КонецФункции

Функция КомпонентЗакрытия(Результат, ЗадержкаМс = 0, ТекстИсключения = "")
    Текст = "Перем Результат Экспорт;
    |Перем ЗадержкаМс Экспорт;
    |Перем ТекстИсключения Экспорт;
    |Перем ПереданныйТаймаут Экспорт;
    |Перем Закрыт Экспорт;
    |Функция Закрыть(ТаймаутМс = 0) Экспорт
    |    Закрыт = Истина;
    |    ПереданныйТаймаут = ТаймаутМс;
    |    Если ЗадержкаМс > 0 Тогда
    |        Приостановить(ЗадержкаМс);
    |    КонецЕсли;
    |    Если ТекстИсключения <> """" Тогда
    |        ВызватьИсключение ТекстИсключения;
    |    КонецЕсли;
    |    Возврат Результат;
    |КонецФункции
    |Закрыт = Ложь;";
    Компонент = ЗагрузитьСценарийИзСтроки(Текст);
    Компонент.Результат = Результат;
    Компонент.ЗадержкаМс = ЗадержкаМс;
    Компонент.ТекстИсключения = ТекстИсключения;
    Возврат Компонент;
КонецФункции

&Тест
Процедура ЗакрытьВсеВызываетЗакрытьБезПараметровИПроцедуру() Экспорт

    // Дано - пользовательский компонент: Закрыть - процедура без параметров
    Компонент = ЗагрузитьСценарийИзСтроки("Перем Закрыт Экспорт;
    |Процедура Закрыть() Экспорт
    |    Закрыт = Истина;
    |КонецПроцедуры
    |Закрыт = Ложь;");
    Компоненты = Новый Массив();
    Компоненты.Добавить(Компонент);

    // Когда
    Результат = ОтелРезультатыЗакрытия.ЗакрытьВсе(Компоненты, 5000);

    // Тогда - вызов без лишних параметров, отсутствие результата - успех
    Ожидаем.Что(Компонент.Закрыт).ЭтоИстина();
    Ожидаем.Что(Результат.Успешно(), Результат.Описание()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СрокБезОграниченияНеИстекаетИОставляетНоль() Экспорт

    // Дано - операция началась секунду назад
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - 1000;

    // Когда / Тогда - срок 0 не ограничен: компоненту передается 0 ("без ограничения")
    Ожидаем.Что(ОтелРезультатыЗакрытия.ОставшеесяВремя(НачалоМс, 0)).Равно(0);
    Ожидаем.Что(ОтелРезультатыЗакрытия.СрокИстек(НачалоМс, 0)).ЭтоЛожь();
    Ожидаем.Что(ОтелРезультатыЗакрытия.ОставшеесяВремя(НачалоМс, 500)).Равно(1);
    Ожидаем.Что(ОтелРезультатыЗакрытия.СрокИстек(НачалоМс, 500)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТаймаутДоСрокаОграничиваетТаймаутВызова() Экспорт

    // Дано - до срока около 10 секунд
    СрокМс = ТекущаяУниверсальнаяДатаВМиллисекундах() + 10000;

    // Когда / Тогда - без срока таймаут вызова не меняется, со сроком - не больше времени до срока
    Ожидаем.Что(ОтелРезультатыЗакрытия.ТаймаутДоСрока(500, 0)).Равно(500);
    Ожидаем.Что(ОтелРезультатыЗакрытия.ТаймаутДоСрока(0, 0)).Равно(0);
    Ожидаем.Что(ОтелРезультатыЗакрытия.ТаймаутДоСрока(500, СрокМс)).Равно(500);
    Ожидаем.Что(ОтелРезультатыЗакрытия.ТаймаутДоСрока(30000, СрокМс)).Между(9000, 10000);
    Ожидаем.Что(ОтелРезультатыЗакрытия.ТаймаутДоСрока(0, СрокМс)).Между(9000, 10000);

    // Когда / Тогда - срок истек
    СрокМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - 1;
    Ожидаем.Что(ОтелРезультатыЗакрытия.ТаймаутДоСрока(500, СрокМс)).Равно(Неопределено);

КонецПроцедуры

// СброситьИЗакрыть: Shutdown процессора MUST включать эффект ForceFlush экспортера,
// экспортер закрывается и после сбоя сброса буфера

&Тест
Процедура СброситьИЗакрытьЗакрываетПослеИсключенияСбросаБуфера() Экспорт

    // Дано
    Экспортер = ЗагрузитьСценарийИзСтроки("Перем Закрыт Экспорт;
    |Процедура СброситьБуфер(ТаймаутМс = 0) Экспорт
    |    ВызватьИсключение ""сбой сброса буфера"";
    |КонецПроцедуры
    |Процедура Закрыть() Экспорт
    |    Закрыт = Истина;
    |КонецПроцедуры
    |Закрыт = Ложь;");

    // Когда
    Результат = ОтелРезультатыЗакрытия.СброситьИЗакрыть(Экспортер, 5000);

    // Тогда
    Ожидаем.Что(Экспортер.Закрыт, "экспортер закрыт").ЭтоИстина();
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
    Ожидаем.Что(СтрНайти(Результат.Описание(), "сбой сброса буфера") > 0, Результат.Описание()).ЭтоИстина();

КонецПроцедуры
