&Тест
Процедура ИзДетекторовДетекторБезАннотацииРеализуетВызываетИсключение() Экспорт

    // Дано - объект с методом Обнаружить, но без &Реализует("ИнтерфейсДетекторРесурса")
    Текст = "Функция Обнаружить() Экспорт
    |    Возврат Новый ОтелРесурс();
    |КонецФункции";
    Детекторы = Новый Массив;
    Детекторы.Добавить(ЗагрузитьСценарийИзСтроки(Текст));

    // Когда-Тогда
    ПараметрыМетода = Новый Массив;
    ПараметрыМетода.Добавить(Детекторы);
    Ожидаем.Что(ОтелРесурсы).Метод("ИзДетекторов", ПараметрыМетода)
        .ВыбрасываетИсключение("не объявляет &Реализует(""ИнтерфейсДетекторРесурса"")");

КонецПроцедуры

&Тест
Процедура ИзДетекторовПропускаетДетекторБезРесурсаИПишетОшибку() Экспорт

    // Дано - Обнаружить() возвращает не ОтелРесурс
    Текст = "&Реализует(""ИнтерфейсДетекторРесурса"")
    |Процедура ПриСозданииОбъекта()
    |КонецПроцедуры
    |Функция Обнаружить() Экспорт
    |    Возврат Неопределено;
    |КонецФункции";
    Детекторы = Новый Массив;
    Детекторы.Добавить(ЗагрузитьСценарийИзСтроки(Текст));
    Детекторы.Добавить(СоздатьТестовыйДетектор("app.region", "eu"));

    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.resource");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Ошибка);

    // Когда
    Попытка
        Ресурс = ОтелРесурсы.ИзДетекторов(Детекторы);
    Исключение
        ОтключитьАппендер(Лог, Аппендер);
        ВызватьИсключение;
    КонецПопытки;
    ОтключитьАппендер(Лог, Аппендер);

    // Тогда - остальные детекторы применены, ошибка в логе
    Ожидаем.Что(Ресурс.Атрибуты().Получить("app.region")).Равно("eu");
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "вернул не ОтелРесурс"), "ошибка в логе").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ИзДетекторовПропускаетДетекторСИсключениемИПишетОшибку() Экспорт

    // Дано - Resource SDK: ошибка при обнаружении - ошибка; Error handling: SDK не должен
    // ронять приложение из-за телеметрии, подавленная ошибка пишется в лог
    Текст = "&Реализует(""ИнтерфейсДетекторРесурса"")
    |Процедура ПриСозданииОбъекта()
    |КонецПроцедуры
    |Функция Обнаружить() Экспорт
    |    ВызватьИсключение ""сбой детектора"";
    |КонецФункции";
    Детекторы = Новый Массив;
    Детекторы.Добавить(ЗагрузитьСценарийИзСтроки(Текст));
    Детекторы.Добавить(СоздатьТестовыйДетектор("app.region", "eu"));

    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.resource");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Ошибка);

    // Когда
    Попытка
        Ресурс = ОтелРесурсы.ИзДетекторов(Детекторы);
    Исключение
        ОтключитьАппендер(Лог, Аппендер);
        ВызватьИсключение;
    КонецПопытки;
    ОтключитьАппендер(Лог, Аппендер);

    // Тогда - остальные детекторы применены, ошибка в логе
    Ожидаем.Что(Ресурс.Атрибуты().Получить("app.region")).Равно("eu");
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "сбой детектора"), "ошибка в логе").ЭтоИстина();

КонецПроцедуры

