&Тест
Процедура ПустойРесурсБезАтрибутовИАдресаСхемы() Экспорт

    // Когда
    Ресурс = ОтелРесурсы.Пустой();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Количество()).Равно(0);
    Ожидаем.Что(Ресурс.АдресСхемы()).Равно("");

КонецПроцедуры

&Тест
Процедура ПоУмолчаниюСодержитОбязательныеАтрибутыSdk() Экспорт

    // Когда
    Ресурс = ОтелРесурсы.ПоУмолчанию();

    // Тогда - Resource SDK: service.name и telemetry.sdk.* SDK MUST заполнять сам
    Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name")).Равно("unknown_service:oscript");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("telemetry.sdk.name")).Равно("oscript-opentelemetry");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("telemetry.sdk.version")).Равно(ОтелУтилиты.ВерсияSDK());
    Ожидаем.Что(Ресурс.Атрибуты().Получить("telemetry.sdk.language")).Равно("oscript");
    Ожидаем.Что(Ресурс.Атрибуты().Количество()).Равно(4);

КонецПроцедуры

&Тест
Процедура ПоУмолчаниюБезДетекторовИОкружения() Экспорт

    // Дано
    УстановитьПеременнуюСреды("OTEL_RESOURCE_ATTRIBUTES", "team=core");
    УстановитьПеременнуюСреды("OTEL_SERVICE_NAME", "my-service");

    // Когда
    Попытка
        Ресурс = ОтелРесурсы.ПоУмолчанию();
    Исключение
        СброситьОкружение();
        ВызватьИсключение;
    КонецПопытки;
    СброситьОкружение();

    // Тогда - как Resource.getDefault() в Java SDK
    Ожидаем.Что(Ресурс.Атрибуты().Получить("host.name")).Равно(Неопределено);
    Ожидаем.Что(Ресурс.Атрибуты().Получить("team")).Равно(Неопределено);
    Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name")).Равно("unknown_service:oscript");
    Ожидаем.Что(Ресурс.АдресСхемы()).Равно("");

КонецПроцедуры

&Тест
Процедура ПоУмолчаниюКаждыйРазНовыйРесурс() Экспорт

    // Дано
    Первый = ОтелРесурсы.ПоУмолчанию();
    Первый.Атрибуты().Установить("service.name", "изменен");

    // Когда
    Второй = ОтелРесурсы.ПоУмолчанию();

    // Тогда
    Ожидаем.Что(Второй.Атрибуты().Получить("service.name")).Равно("unknown_service:oscript");

КонецПроцедуры

&Тест
Процедура ИзДетекторовСодержитАтрибутыДетекторовПоУмолчанию() Экспорт

    // Когда
    Ресурс = ОтелРесурсы.ИзДетекторов();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("host.name") <> Неопределено).ЭтоИстина();
    Ожидаем.Что(Ресурс.Атрибуты().Получить("os.type") <> Неопределено).ЭтоИстина();
    Ожидаем.Что(Ресурс.Атрибуты().Получить("process.pid") <> Неопределено).ЭтоИстина();
    Ожидаем.Что(Ресурс.Атрибуты().Получить("service.instance.id")).Равно(ОтелУтилиты.ИдЭкземпляраСервиса());
    Ожидаем.Что(Ресурс.АдресСхемы()).Равно("https://opentelemetry.io/schemas/1.44.0");

