&Тест
Процедура ИзОкруженияДекодируетПроценты() Экспорт

    // Дано - значение со спецсимволами (percent-encoded) по спецификации Resource SDK
    УстановитьПеременнуюСреды("OTEL_RESOURCE_ATTRIBUTES", "label=hello%20world%2Cfoo");

    // Когда
    Попытка
        Ресурс = ОтелРесурсы.ИзОкружения();
    Исключение
        СброситьОкружение();
        ВызватьИсключение;
    КонецПопытки;
    СброситьОкружение();

    // Тогда - запятая в значении декодирована и разделителем не считается
    Ожидаем.Что(Ресурс.Атрибуты().Получить("label")).Равно("hello world,foo");

КонецПроцедуры

&Тест
Процедура ИзОкруженияОтбрасываетЗначениеСОшибкойДекодирования() Экспорт

    // Дано - Resource SDK: при ошибке декодирования значение переменной отбрасывается
    // целиком, ошибка сообщается
    УстановитьПеременнуюСреды("OTEL_RESOURCE_ATTRIBUTES", "a=%ZZ,b=1");
    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.resource");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Ошибка);

    // Когда
    Попытка
        Ресурс = ОтелРесурсы.ИзОкружения();
    Исключение
        ОтключитьАппендер(Лог, Аппендер);
        СброситьОкружение();
        ВызватьИсключение;
    КонецПопытки;
    ОтключитьАппендер(Лог, Аппендер);
    СброситьОкружение();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("a"), "атрибут с ошибкой").Равно(Неопределено);
    Ожидаем.Что(Ресурс.Атрибуты().Получить("b"), "остальные атрибуты значения").Равно(Неопределено);
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "OTEL_RESOURCE_ATTRIBUTES"), "ошибка в логе").ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("a=1,malformed_no_equals,c=2")
&ИсточникЗначение("a=1,=value,c=2")
Процедура ИзОкруженияОтбрасываетЗначениеСНекорректнымЭлементом(Значение) Экспорт

    // Дано - элемент без "=" или с пустым ключом: ошибка разбора, по спецификации
    // Resource SDK значение переменной отбрасывается целиком и ошибка сообщается
    УстановитьПеременнуюСреды("OTEL_RESOURCE_ATTRIBUTES", Значение);
    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.resource");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Ошибка);

    // Когда
    Попытка
        Ресурс = ОтелРесурсы.ИзОкружения();
    Исключение
        ОтключитьАппендер(Лог, Аппендер);
        СброситьОкружение();
        ВызватьИсключение;
    КонецПопытки;
    ОтключитьАппендер(Лог, Аппендер);
    СброситьОкружение();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("a"), "атрибут до некорректного элемента").Равно(Неопределено);
    Ожидаем.Что(Ресурс.Атрибуты().Получить("c"), "атрибут после некорректного элемента").Равно(Неопределено);
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "OTEL_RESOURCE_ATTRIBUTES"), "ошибка в логе").ЭтоИстина();

КонецПроцедуры

