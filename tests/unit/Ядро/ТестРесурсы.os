Процедура ПроверитьРесурсПоУмолчанию(Ресурс)
    Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name")).Равно("unknown_service:oscript");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("telemetry.sdk.name")).Равно("oscript-opentelemetry");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("host.name")).Равно(Неопределено);
КонецПроцедуры

Функция СоздатьТестовыйДетектор(Ключ1, Значение1, Ключ2 = "", Значение2 = "")
    Текст = "&Реализует(""ИнтерфейсДетекторРесурса"")
    |Процедура ПриСозданииОбъекта()
    |КонецПроцедуры
    |Функция Обнаружить() Экспорт
    |    Атрибуты = Новый Соответствие();
    |    Атрибуты.Вставить(""" + Ключ1 + """, """ + Значение1 + """);";
    Если ЗначениеЗаполнено(Ключ2) Тогда
        Текст = Текст + "
        |    Атрибуты.Вставить(""" + Ключ2 + """, """ + Значение2 + """);";
    КонецЕсли;
    Текст = Текст + "
    |    Возврат Новый ОтелРесурс(Атрибуты);
    |КонецФункции";
    Возврат ЗагрузитьСценарийИзСтроки(Текст);
КонецФункции

Процедура СброситьОкружение()
    УстановитьПеременнуюСреды("OTEL_RESOURCE_ATTRIBUTES", "");
    УстановитьПеременнуюСреды("OTEL_SERVICE_NAME", "");
КонецПроцедуры

Функция СоздатьТестовыйАппендер()
    Текст = "Перем События Экспорт;
    |Процедура ВывестиСобытие(Событие) Экспорт
    |    События.Добавить(Событие);
    |КонецПроцедуры
    |Процедура Закрыть() Экспорт
    |КонецПроцедуры
    |Процедура УстановитьСвойство(Имя, Значение) Экспорт
    |КонецПроцедуры
    |События = Новый Массив();";
    Возврат ЗагрузитьСценарийИзСтроки(Текст);
КонецФункции

Функция ЕстьСообщениеСТекстом(Аппендер, Текст)
    Для Каждого Событие Из Аппендер.События Цикл
        Если СтрНайти(Событие.ПолучитьСообщение(), Текст) > 0 Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Процедура ОтключитьАппендер(Лог, Аппендер)
    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);
КонецПроцедуры
