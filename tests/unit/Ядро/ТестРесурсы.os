&Тест
Процедура ИзДетекторовСливаетПереданныеДетекторыПоПорядку() Экспорт

    // Дано - второй детектор перекрывает общий атрибут первого
    Детекторы = Новый Массив;
    Детекторы.Добавить(СоздатьТестовыйДетектор("app.region", "eu", "app.zone", "a"));
    Детекторы.Добавить(СоздатьТестовыйДетектор("app.region", "us"));

    // Когда
    Ресурс = ОтелРесурсы.ИзДетекторов(Детекторы);

    // Тогда - встроенные детекторы не вызываются
    Ожидаем.Что(Ресурс.Атрибуты().Получить("app.region")).Равно("us");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("app.zone")).Равно("a");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("host.name")).Равно(Неопределено);

КонецПроцедуры

