&Тест
Процедура ДетекторВозвращаетUUID() Экспорт

    // Когда
    Ресурс = Новый ОтелДетекторРесурсаЭкземпляраСервиса().Обнаружить();

    // Тогда - semconv рекомендует SDK случайный UUID
    ИдЭкземпляра = Ресурс.Атрибуты().Получить("service.instance.id");
    Ожидаем.Что(ИдЭкземпляра).ИмеетТип("Строка");
    Ожидаем.Что(Строка(Новый УникальныйИдентификатор(ИдЭкземпляра))).Равно(ИдЭкземпляра);

КонецПроцедуры

&Тест
Процедура ИдЭкземпляраОдинНаПроцесс() Экспорт

    // Когда - два детектора в одном процессе
    Первый = Новый ОтелДетекторРесурсаЭкземпляраСервиса().Обнаружить();
    Второй = Новый ОтелДетекторРесурсаЭкземпляраСервиса().Обнаружить();

    // Тогда - экземпляр сервиса тот же
    Ожидаем.Что(Второй.Атрибуты().Получить("service.instance.id"))
        .Равно(Первый.Атрибуты().Получить("service.instance.id"));

КонецПроцедуры

&Тест
Процедура ДетекторНеСодержитДефолтов() Экспорт

    // Когда
    Ресурс = Новый ОтелДетекторРесурсаЭкземпляраСервиса().Обнаружить();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ДетекторВозвращаетSchemaUrlСемантическихСоглашений() Экспорт

    // Когда
    Ресурс = Новый ОтелДетекторРесурсаЭкземпляраСервиса().Обнаружить();

    // Тогда
    Ожидаем.Что(Ресурс.АдресСхемы()).Равно("https://opentelemetry.io/schemas/1.44.0");

КонецПроцедуры
