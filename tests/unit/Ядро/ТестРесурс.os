&Тест
Процедура КонструкторБезПараметровСоздаетПустойРесурс() Экспорт

    // Дано / Когда
    Ресурс = Новый ОтелРесурс();

    // Тогда - конструктор ничего не добавляет сам: ресурс по умолчанию - ОтелРесурсы.ПоУмолчанию()
    Ожидаем.Что(Ресурс.Атрибуты().Количество()).Равно(0);
    Ожидаем.Что(Ресурс.АдресСхемы()).Равно("");

КонецПроцедуры

&Тест
Процедура КонструкторСоздаетРесурсИзСоответствия() Экспорт

    // Дано
    Атрибуты = Новый Соответствие();
    Атрибуты.Вставить("service.name", "test");
    Атрибуты.Вставить("team", "core");

    // Когда
    Ресурс = Новый ОтелРесурс(Атрибуты, "https://example.com/schemas/1.0.0");

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name")).Равно("test");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("team")).Равно("core");
    Ожидаем.Что(Ресурс.Атрибуты().Количество()).Равно(2);
    Ожидаем.Что(Ресурс.АдресСхемы()).Равно("https://example.com/schemas/1.0.0");

КонецПроцедуры

&Тест
Процедура КонструкторСоздаетРесурсИзАтрибутов() Экспорт

    // Дано
    Атрибуты = Новый ОтелАтрибуты();
    Атрибуты.Установить("service.name", "test");

    // Когда
    Ресурс = Новый ОтелРесурс(Атрибуты);

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name")).Равно("test");
    Ожидаем.Что(Ресурс.АдресСхемы()).Равно("");

КонецПроцедуры

&Тест
Процедура КонструкторКопируетАтрибуты() Экспорт

    // Дано
    Атрибуты = Новый ОтелАтрибуты();
    Атрибуты.Установить("service.name", "test");
    Ресурс = Новый ОтелРесурс(Атрибуты);

    // Когда
    Атрибуты.Установить("service.name", "изменен");

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name")).Равно("test");

КонецПроцедуры

&Тест
Процедура КонструкторСБулевымПараметромПрежнейСигнатурыВыбрасываетИсключение() Экспорт

    // Дано - прежний конструктор ОтелРесурс(БезУмолчаний, АдресСхемы, БезОкружения)
    Параметры = Новый Массив();
    Параметры.Добавить(Истина);

    // Когда / Тогда - старый вызов не должен тихо создавать другой ресурс
    Ожидаем.Что(ЭтотОбъект).Метод("СоздатьРесурс", Параметры).ВыбрасываетИсключение("ОтелРесурсы");

КонецПроцедуры

&Тест
Процедура ВПостроительСохраняетАтрибутыИАдресСхемы() Экспорт

    // Дано
    Атрибуты = Новый Соответствие();
    Атрибуты.Вставить("service.name", "test");
    Ресурс = Новый ОтелРесурс(Атрибуты, "https://example.com/schemas/1.0.0");

    // Когда
    Результат = Ресурс.ВПостроитель()
        .Установить("team", "core")
        .Построить();

    // Тогда
    Ожидаем.Что(Результат.Атрибуты().Получить("service.name")).Равно("test");
    Ожидаем.Что(Результат.Атрибуты().Получить("team")).Равно("core");
    Ожидаем.Что(Результат.Атрибуты().Количество()).Равно(2);
    Ожидаем.Что(Результат.АдресСхемы()).Равно("https://example.com/schemas/1.0.0");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("team")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СлияниеРесурсов() Экспорт

    // Дано
    Ресурс1 = Новый ОтелРесурс();
    Ресурс1.Атрибуты().Установить("key1", "value1");
    Ресурс1.Атрибуты().Установить("shared", "from1");

    Ресурс2 = Новый ОтелРесурс();
    Ресурс2.Атрибуты().Установить("key2", "value2");
    Ресурс2.Атрибуты().Установить("shared", "from2");

    // Когда
    Результат = Ресурс1.Слить(Ресурс2);

    // Тогда
    Ожидаем.Что(Результат.Атрибуты().Получить("key1")).Равно("value1");
    Ожидаем.Что(Результат.Атрибуты().Получить("key2")).Равно("value2");
    Ожидаем.Что(Результат.Атрибуты().Получить("shared")).Равно("from2");

КонецПроцедуры

&Тест
Процедура ВСоответствиеOtlp() Экспорт

    // Дано
    Ресурс = Новый ОтелРесурс();
    Ресурс.Атрибуты().Установить("service.name", "test");

    // Когда
    Результат = Ресурс.ВСоответствиеOtlp();

    // Тогда
    Ожидаем.Что(Результат).ИмеетТип("Соответствие");
    МассивАтрибутов = Результат["attributes"];
    Ожидаем.Что(МассивАтрибутов).ИмеетТип("Массив");
    Ожидаем.Что(МассивАтрибутов).ИмеетДлину(1);
    Ожидаем.Что(МассивАтрибутов[0]["key"]).Равно("service.name");

КонецПроцедуры

&Тест
Процедура ТестСлитьДваРесурса() Экспорт

    // Дано
    Ресурс1 = Новый ОтелРесурс();
    Ресурс1.Атрибуты().Установить("key1", "val1");
    Ресурс1.Атрибуты().Установить("shared", "from_first");

    Ресурс2 = Новый ОтелРесурс();
    Ресурс2.Атрибуты().Установить("key2", "val2");
    Ресурс2.Атрибуты().Установить("shared", "from_second");

    // Когда
    Результат = Ресурс1.Слить(Ресурс2);

    // Тогда - другой ресурс побеждает при конфликте
    Ожидаем.Что(Результат.Атрибуты().Получить("key1")).Равно("val1");
    Ожидаем.Что(Результат.Атрибуты().Получить("key2")).Равно("val2");
    Ожидаем.Что(Результат.Атрибуты().Получить("shared")).Равно("from_second");

КонецПроцедуры

&Тест
Процедура ТестСлитьАдресСхемы() Экспорт

    // Если первый пустой - берем от второго
    Ресурс1 = Новый ОтелРесурс();
    Ресурс2 = Новый ОтелРесурс(Неопределено, "https://schema.example.com");

    Результат = Ресурс1.Слить(Ресурс2);
    Ожидаем.Что(Результат.АдресСхемы()).Равно("https://schema.example.com");

КонецПроцедуры

&Тест
Процедура ТестСлитьНеМутируетОригинал() Экспорт

    // Дано
    Ресурс1 = Новый ОтелРесурс();
    Ресурс1.Атрибуты().Установить("key1", "val1");

    Ресурс2 = Новый ОтелРесурс();
    Ресурс2.Атрибуты().Установить("key2", "val2");

    // Когда
    Результат = Ресурс1.Слить(Ресурс2);

    // Тогда - оригинал не изменен
    Ожидаем.Что(Ресурс1.Атрибуты().Получить("key2")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестOtlpDroppedAttributesCount() Экспорт

    // Дано
    Ресурс = Новый ОтелРесурс();
    Ресурс.Атрибуты().Установить("key", "value");

    // Когда
    Результат = Ресурс.ВСоответствиеOtlp();

    // Тогда - droppedAttributesCount всегда 0 (Resource не имеет лимитов)
    Ожидаем.Что(Результат.Получить("droppedAttributesCount")).Равно(0);
    Ожидаем.Что(Результат.Получить("attributes") <> Неопределено).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестСлитьКонфликтАдресСхемы() Экспорт

    // Дано - два ресурса с РАЗНЫМИ непустыми schemaUrl
    Ресурс1 = Новый ОтелРесурс(Неопределено, "https://schema1.example.com");
    Ресурс1.Атрибуты().Установить("k1", "v1");
    Ресурс2 = Новый ОтелРесурс(Неопределено, "https://schema2.example.com");
    Ресурс2.Атрибуты().Установить("k2", "v2");

    // Когда - per spec: если schemaUrl различаются, атрибуты объединяются, schema_url - пустой
    Результат = Ресурс1.Слить(Ресурс2);

    // Тогда - атрибуты объединяются (оба k1 и k2), schema_url пустой
    Ожидаем.Что(Результат.Атрибуты().Количество()).Равно(2);
    Ожидаем.Что(Результат.АдресСхемы()).Равно("");

КонецПроцедуры

&Тест
Процедура ТестСлитьОдинаковыеАдресСхемы() Экспорт

    // Дано - два ресурса с ОДИНАКОВЫМИ schemaUrl
    Ресурс1 = Новый ОтелРесурс(Неопределено, "https://schema.example.com");
    Ресурс1.Атрибуты().Установить("k1", "v1");
    Ресурс2 = Новый ОтелРесурс(Неопределено, "https://schema.example.com");
    Ресурс2.Атрибуты().Установить("k2", "v2");

    // Когда - одинаковые schemaUrl: слияние нормальное
    Результат = Ресурс1.Слить(Ресурс2);

    // Тогда
    Ожидаем.Что(Результат.АдресСхемы()).Равно("https://schema.example.com");
    Ожидаем.Что(Результат.Атрибуты().Получить("k1")).Равно("v1");
    Ожидаем.Что(Результат.Атрибуты().Получить("k2")).Равно("v2");

КонецПроцедуры

Процедура СоздатьРесурс(Параметр) Экспорт
    Ресурс = Новый ОтелРесурс(Параметр);
КонецПроцедуры
