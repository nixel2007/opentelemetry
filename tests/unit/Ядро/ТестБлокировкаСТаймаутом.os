// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать "../../.."
#Использовать asserts

// Блокировка для фонового задания
Перем БлокировкаДляФона;

&Тест
Процедура ЗахватитьСвободнуюБлокировку() Экспорт

    // Дано
    Блокировка = Новый ОтелБлокировкаСТаймаутом();

    // Когда / Тогда
    Ожидаем.Что(Блокировка.Захватить(100)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗахватитьЗанятуюБлокировкуСТаймаутом() Экспорт

    // Дано - блокировка занята
    Блокировка = Новый ОтелБлокировкаСТаймаутом();
    Блокировка.Захватить();

    // Когда
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Захвачена = Блокировка.Захватить(100);
    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;

    // Тогда - ожидание ограничено таймаутом
    Ожидаем.Что(Захвачена).ЭтоЛожь();
    Ожидаем.Что(ДлительностьМс >= 100 И ДлительностьМс < 500, ДлительностьМс).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗахватитьПослеОсвобожденияВДругомПотоке() Экспорт

    // Дано - блокировку держит фоновое задание 200 мс
    БлокировкаДляФона = Новый ОтелБлокировкаСТаймаутом();
    БлокировкаДляФона.Захватить();
    Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ОсвободитьЧерез200Мс");

    // Когда
    Захвачена = БлокировкаДляФона.Захватить(5000);
    Задание.ОжидатьЗавершения();

    // Тогда
    Ожидаем.Что(Захвачена).ЭтоИстина();

КонецПроцедуры

Процедура ОсвободитьЧерез200Мс() Экспорт
    Приостановить(200);
    БлокировкаДляФона.Освободить();
КонецПроцедуры
