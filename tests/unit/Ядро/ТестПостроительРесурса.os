&Тест
Процедура УстановкаАтрибута() Экспорт

    // Дано / Когда
    Ресурс = Новый ОтелПостроительРесурса()
        .Установить("service.name", "test")
        .Построить();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name")).Равно("test");

КонецПроцедуры

&Тест
Процедура УстановитьВсе() Экспорт

    // Дано
    Атрибуты = Новый ОтелАтрибуты();
    Атрибуты.Установить("k1", "v1");
    Атрибуты.Установить("k2", "v2");

    // Когда
    Ресурс = Новый ОтелПостроительРесурса()
        .УстановитьВсе(Атрибуты)
        .Построить();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("k1")).Равно("v1");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("k2")).Равно("v2");

КонецПроцедуры

&Тест
Процедура ЦепочкаFluent() Экспорт

    // Дано / Когда
    Ресурс = Новый ОтелПостроительРесурса()
        .Установить("service.name", "my-service")
        .Установить("service.version", "1.0.0")
        .Установить("deployment.environment.name", "production")
        .Построить();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name")).Равно("my-service");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("service.version")).Равно("1.0.0");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("deployment.environment.name")).Равно("production");

КонецПроцедуры

&Тест
Процедура ПостроительУстанавливаетАдресСхемы() Экспорт

    // Дано / Когда
    Ресурс = Новый ОтелПостроительРесурса()
        .УстановитьАдресСхемы("https://example.com/schemas/1.0.0")
        .Построить();

    // Тогда
    Ожидаем.Что(Ресурс.АдресСхемы()).Равно("https://example.com/schemas/1.0.0");

КонецПроцедуры

&Тест
Процедура ПостроительНачинаетСПустогоРесурса() Экспорт

    // Дано / Когда
    Ресурс = Новый ОтелПостроительРесурса()
        .Установить("team", "core")
        .Построить();

    // Тогда - как Resource.builder() в Java SDK: без атрибутов по умолчанию и детекторов
    Ожидаем.Что(Ресурс.Атрибуты().Количество()).Равно(1);
    Ожидаем.Что(Ресурс.АдресСхемы()).Равно("");

КонецПроцедуры

&Тест
Процедура ПостроительИзРесурсаПоУмолчанию() Экспорт

    // Дано / Когда
    Ресурс = ОтелРесурсы.ПоУмолчанию().ВПостроитель()
        .Установить("service.name", "my-service")
        .Построить();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name")).Равно("my-service");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("telemetry.sdk.name")).Равно("oscript-opentelemetry");

КонецПроцедуры
