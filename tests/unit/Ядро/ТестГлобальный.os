&Тест
Процедура ПолучитьПропагаторыБезИнициализацииВозвращаетDefaultComposite() Экспорт

    // Дано / Когда - без SDK возвращается default composite (W3C TC + W3C Baggage)
    // согласно спецификации OpenTelemetry.
    Результат = ОтелГлобальный.ПолучитьПропагаторы();

    // Тогда
    Ожидаем.Что(ТипЗнч(Результат)).Равно(Тип("ОтелКомпозитныйПропагатор"));

    // Повторный вызов возвращает тот же кэшированный экземпляр.
    Результат2 = ОтелГлобальный.ПолучитьПропагаторы();
    Ожидаем.Что(Результат2).Равно(Результат);

КонецПроцедуры

&Тест
Процедура УстановитьПропагаторыИПолучить() Экспорт

    // Дано - устанавливаем пропагаторы напрямую через УстановитьПропагаторы
    МокПропагатор = Новый Структура("Имя", "пропагатор-прямой");
    ОтелГлобальный.УстановитьПропагаторы(МокПропагатор);

    // Когда
    Результат = ОтелГлобальный.ПолучитьПропагаторы();

    // Тогда - возвращается именно установленный пропагатор (cache hit, line 134)
    Ожидаем.Что(Результат).Равно(МокПропагатор);

КонецПроцедуры

&Тест
Процедура СброситьИЗакрытьСSDK() Экспорт

    // Дано - устанавливаем реальный SDK
    Сдк = Новый ОтелSdk();
    ОтелГлобальный.Установить(Сдк);

    // Когда - сбрасываем и закрываем
    ОтелГлобальный.СброситьИЗакрыть();

    // Тогда - SDK закрыт, слот очищен
    Ожидаем.Что(ОтелГлобальный.Получить()).Равно(Неопределено);

КонецПроцедуры

// Trace/Logs/Metrics API: API SHOULD позволять установить и получить глобальный провайдер

&Тест
Процедура ГлобальныеПровайдерыБезИнициализацииНоопНеНеопределено() Экспорт

    // Дано / Когда
    ПровайдерТрассировки = ОтелГлобальный.ПолучитьПровайдерТрассировки();
    ПровайдерЛогирования = ОтелГлобальный.ПолучитьПровайдерЛогирования();
    ПровайдерМетрик = ОтелГлобальный.ПолучитьПровайдерМетрик();

    // Тогда - no-op провайдеры: спаны не записываются, слот SDK не занят
    Ожидаем.Что(ПровайдерТрассировки).ИмеетТип("ОтелПровайдерТрассировки");
    Ожидаем.Что(ПровайдерЛогирования).ИмеетТип("ОтелПровайдерЛогирования");
    Ожидаем.Что(ПровайдерМетрик).ИмеетТип("ОтелПровайдерМетрик");
    Спан = ПровайдерТрассировки.ПолучитьТрассировщик("тест").НачатьСпан("операция");
    Ожидаем.Что(Спан.ЗаписьАктивна()).ЭтоЛожь();
    Ожидаем.Что(ОтелГлобальный.Получить()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ГлобальныеПровайдерыИзЗарегистрированногоSdk() Экспорт

    // Дано
    ПровайдерТрассировки = Новый ОтелПровайдерТрассировки();
    ПровайдерЛогирования = Новый ОтелПровайдерЛогирования();
    ПровайдерМетрик = Новый ОтелПровайдерМетрик();

    // Когда
    ОтелГлобальный.Установить(Новый ОтелSdk(ПровайдерТрассировки, ПровайдерЛогирования, ПровайдерМетрик));

    // Тогда
    Ожидаем.Что(ОтелГлобальный.ПолучитьПровайдерТрассировки()).Равно(ПровайдерТрассировки);
    Ожидаем.Что(ОтелГлобальный.ПолучитьПровайдерЛогирования()).Равно(ПровайдерЛогирования);
    Ожидаем.Что(ОтелГлобальный.ПолучитьПровайдерМетрик()).Равно(ПровайдерМетрик);

КонецПроцедуры

