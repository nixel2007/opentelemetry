// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
#Использовать "../../.."
#Использовать asserts

// Идентификатор контейнера из 64 шестнадцатеричных символов, как его пишут Docker, containerd, CRI-O и podman
Перем ИдКонтейнера;
// Временный каталог с файлами cgroup и mountinfo теста
Перем Каталог;

&ПередКаждым
Процедура Подготовить() Экспорт
    ИдКонтейнера = "3c3a82d4f1d5b7a2e9c06e1f0b4a8d7c2e5f9a1b3d6c8e0f2a4b6d8e1c3f5a7b";
    Каталог = ОбъединитьПути(КаталогВременныхФайлов(), "otel-container-" + Новый УникальныйИдентификатор);
    СоздатьКаталог(Каталог);
КонецПроцедуры

&ПослеКаждого
Процедура Очистить() Экспорт
    УдалитьФайлы(Каталог);
КонецПроцедуры

&Тест
Процедура ИдИзCgroupV1Docker() Экспорт

    // Дано
    Cgroup = ФайлВКаталоге("cgroup",
        "12:memory:/docker/" + ИдКонтейнера + Символы.ПС
        + "11:cpu,cpuacct:/docker/" + ИдКонтейнера);

    // Когда
    Ресурс = Детектор(Cgroup, НетФайла()).Обнаружить();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("container.id")).Равно(ИдКонтейнера);

КонецПроцедуры

&Тест
Процедура ИдИзCgroupV1SystemdDocker() Экспорт

    // Дано - docker под systemd: docker-<id>.scope
    Cgroup = ФайлВКаталоге("cgroup", "1:name=systemd:/system.slice/docker-" + ИдКонтейнера + ".scope");

    // Когда
    Ресурс = Детектор(Cgroup, НетФайла()).Обнаружить();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("container.id")).Равно(ИдКонтейнера);

КонецПроцедуры

&Тест
Процедура ИдИзCgroupKubernetesContainerd() Экспорт

    // Дано - pod Kubernetes, containerd под systemd
    Cgroup = ФайлВКаталоге("cgroup",
        "0::/kubepods.slice/kubepods-burstable.slice/kubepods-burstable-pod8d1f6c2a_4b5e_4c3d_9e7f_1a2b3c4d5e6f.slice/"
        + "cri-containerd-" + ИдКонтейнера + ".scope");

    // Когда
    Ресурс = Детектор(Cgroup, НетФайла()).Обнаружить();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("container.id")).Равно(ИдКонтейнера);

КонецПроцедуры

&Тест
Процедура ИдИзCgroupKubernetesCgroupfs() Экспорт

    // Дано - pod Kubernetes, драйвер cgroupfs: идентификатор - последний сегмент без префикса
    Cgroup = ФайлВКаталоге("cgroup",
        "11:devices:/kubepods/burstable/pod8d1f6c2a-4b5e-4c3d-9e7f-1a2b3c4d5e6f/" + ИдКонтейнера);

    // Когда
    Ресурс = Детектор(Cgroup, НетФайла()).Обнаружить();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("container.id")).Равно(ИдКонтейнера);

КонецПроцедуры

&Тест
Процедура ИдИзCgroupCrioИPodman() Экспорт

    // Дано
    CgroupCrio = ФайлВКаталоге("cgroup-crio", "0::/kubepods.slice/crio-" + ИдКонтейнера + ".scope");
    CgroupPodman = ФайлВКаталоге("cgroup-podman", "0::/machine.slice/libpod-" + ИдКонтейнера + ".scope/container");

    // Когда
    РесурсCrio = Детектор(CgroupCrio, НетФайла()).Обнаружить();
    РесурсPodman = Детектор(CgroupPodman, НетФайла()).Обнаружить();

    // Тогда
    Ожидаем.Что(РесурсCrio.Атрибуты().Получить("container.id")).Равно(ИдКонтейнера);
    Ожидаем.Что(РесурсPodman.Атрибуты().Получить("container.id")).Равно(ИдКонтейнера);

КонецПроцедуры

&Тест
Процедура ИдИзMountinfoCgroupV2Docker() Экспорт

    // Дано - cgroup v2 с собственным пространством имен: в cgroup только корень
    Cgroup = ФайлВКаталоге("cgroup", "0::/");
    Mountinfo = ФайлВКаталоге("mountinfo",
        "1046 1020 0:61 / / rw,relatime master:315 - overlay overlay rw,lowerdir=/var/lib/docker/overlay2/l/A" + Символы.ПС
        + "1052 1046 254:1 /var/lib/docker/containers/" + ИдКонтейнера + "/resolv.conf /etc/resolv.conf rw,relatime - ext4 /dev/vda1 rw"
        + Символы.ПС
        + "1053 1046 254:1 /var/lib/docker/containers/" + ИдКонтейнера + "/hostname /etc/hostname rw,relatime - ext4 /dev/vda1 rw");

    // Когда
    Ресурс = Детектор(Cgroup, Mountinfo).Обнаружить();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("container.id")).Равно(ИдКонтейнера);

КонецПроцедуры

&Тест
Процедура ИдИзMountinfoPodman() Экспорт

    // Дано - podman: containers/overlay-containers/<id>/userdata
    Mountinfo = ФайлВКаталоге("mountinfo",
        "1340 1300 0:94 /containers/overlay-containers/" + ИдКонтейнера
        + "/userdata/hostname /etc/hostname rw,nosuid,nodev - tmpfs tmpfs rw");

    // Когда
    Ресурс = Детектор(НетФайла(), Mountinfo).Обнаружить();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("container.id")).Равно(ИдКонтейнера);

КонецПроцедуры

&Тест
Процедура ПесочницаKubernetesНеВыдаетсяЗаКонтейнер() Экспорт

    // Дано - в mountinfo pod-а с cgroup v2 виден только идентификатор песочницы pod-а, а не контейнера
    Mountinfo = ФайлВКаталоге("mountinfo",
        "2301 2280 254:1 /var/lib/containerd/io.containerd.grpc.v1.cri/sandboxes/" + ИдКонтейнера
        + "/hostname /etc/hostname rw,relatime - ext4 /dev/vda1 rw" + Символы.ПС
        + "2302 2280 254:1 /var/lib/kubelet/pods/8d1f6c2a-4b5e-4c3d-9e7f-1a2b3c4d5e6f/containers/app/0f1e2d3c"
        + " /dev/termination-log rw,relatime - ext4 /dev/vda1 rw");

    // Когда
    Ресурс = Детектор(ФайлВКаталоге("cgroup", "0::/"), Mountinfo).Обнаружить();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("container.id")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура CgroupПриоритетнееMountinfo() Экспорт

    // Дано
    ДругойИд = "a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90";
    Cgroup = ФайлВКаталоге("cgroup", "12:memory:/docker/" + ИдКонтейнера);
    Mountinfo = ФайлВКаталоге("mountinfo",
        "1053 1046 254:1 /var/lib/docker/containers/" + ДругойИд + "/hostname /etc/hostname rw - ext4 /dev/vda1 rw");

    // Когда
    Ресурс = Детектор(Cgroup, Mountinfo).Обнаружить();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Получить("container.id")).Равно(ИдКонтейнера);

КонецПроцедуры

&Тест
Процедура ВнеКонтейнераАтрибутаНет() Экспорт

    // Дано - процесс вне контейнера: в путях cgroup нет идентификатора из 64 шестнадцатеричных символов
    Cgroup = ФайлВКаталоге("cgroup",
        "4:memory:/process_api/01a16a07-24fa-76d4-8e93-09e0da3246b0/claude-code-bash" + Символы.ПС
        + "1:name=systemd:/user.slice/user-1000.slice/session-2.scope" + Символы.ПС
        + "0::/");
    Mountinfo = ФайлВКаталоге("mountinfo", "22 1 254:1 / / rw,relatime shared:1 - ext4 /dev/vda1 rw");

    // Когда
    Ресурс = Детектор(Cgroup, Mountinfo).Обнаружить();

    // Тогда - пустой ресурс и пустой Schema URL
    Ожидаем.Что(Ресурс.Атрибуты().Количество()).Равно(0);
    Ожидаем.Что(Ресурс.АдресСхемы()).Равно("");

КонецПроцедуры

&Тест
Процедура БезФайловАтрибутаНетИОшибкиНет() Экспорт

    // Когда - ни cgroup, ни mountinfo нет
    Ресурс = Детектор(НетФайла(), НетФайла()).Обнаружить();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура НаWindowsИдНеОпределяется() Экспорт

    // Дано - даже если файлы с идентификатором есть, на Windows их нет смысла читать
    Cgroup = ФайлВКаталоге("cgroup", "12:memory:/docker/" + ИдКонтейнера);

    // Когда
    Ресурс = Новый ОтелДетекторРесурсаКонтейнера(Cgroup, НетФайла(), "windows").Обнаружить();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура НаMacOSИдНеОпределяется() Экспорт

    // Дано
    Cgroup = ФайлВКаталоге("cgroup", "12:memory:/docker/" + ИдКонтейнера);

    // Когда
    Ресурс = Новый ОтелДетекторРесурсаКонтейнера(Cgroup, НетФайла(), "darwin").Обнаружить();

    // Тогда
    Ожидаем.Что(Ресурс.Атрибуты().Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура НайденныйИдСоSchemaUrlИБезДефолтов() Экспорт

    // Дано
    Cgroup = ФайлВКаталоге("cgroup", "12:memory:/docker/" + ИдКонтейнера);

    // Когда
    Ресурс = Детектор(Cgroup, НетФайла()).Обнаружить();

    // Тогда - Schema URL семантических соглашений, как у остальных детекторов, без service.name
    Ожидаем.Что(Ресурс.АдресСхемы()).Равно("https://opentelemetry.io/schemas/1.29.0");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name")).Равно(Неопределено);
    Ожидаем.Что(Ресурс.Атрибуты().Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ДетекторТекущейМашиныНеПадает() Экспорт

    // Когда - детектор с путями и платформой по умолчанию на машине, где идут тесты
    Ресурс = Новый ОтелДетекторРесурсаКонтейнера().Обнаружить();

    // Тогда - ресурс без атрибутов по умолчанию; container.id есть, только если тесты идут в контейнере
    Ожидаем.Что(Ресурс).ИмеетТип("ОтелРесурс");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура РесурсПоУмолчаниюВключаетДетекторКонтейнера() Экспорт

    // Дано
    Ожидаемый = Новый ОтелДетекторРесурсаКонтейнера().Обнаружить().Атрибуты().Получить("container.id");

    // Когда
    Ресурс = Новый ОтелРесурс();

    // Тогда - в контейнере атрибут есть в ресурсе по умолчанию, вне контейнера его нет нигде
    Ожидаем.Что(Ресурс.Атрибуты().Получить("container.id")).Равно(Ожидаемый);

КонецПроцедуры

Функция Детектор(ПутьCgroup, ПутьMountinfo)
    Возврат Новый ОтелДетекторРесурсаКонтейнера(ПутьCgroup, ПутьMountinfo, "linux");
КонецФункции

Функция ФайлВКаталоге(Имя, Содержимое)
    Путь = ОбъединитьПути(Каталог, Имя);
    Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8NoBOM);
    Запись.ЗаписатьСтроку(Содержимое);
    Запись.Закрыть();
    Возврат Путь;
КонецФункции

Функция НетФайла()
    Возврат ОбъединитьПути(Каталог, "нет-файла");
КонецФункции
