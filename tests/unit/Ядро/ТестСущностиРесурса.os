#Использовать "../../.."
#Использовать asserts

// Resource SDK / Merge: если у одного из ресурсов есть сущности (Entities), слияние идет по
// алгоритму модели данных ресурса (Resource Data Model, Merging Resources); примеры 1-3 - из
// спецификации

&Тест
Процедура СущностьЗаменяетСвободныйАтрибут() Экспорт

    // Дано - пример 1: у старого ресурса только атрибуты
    Старый = РесурсИзАтрибутов(Пары("host.name", "old-name", "env", "prod"));
    Сущности = Новый Массив();
    Сущности.Добавить(Новый ОтелСущность("host", Пары("host.id", "H1"), Пары("host.name", "new-name")));
    Сущности.Добавить(Новый ОтелСущность("service", Пары("service.name", "my-svc")));
    Обновляющий = Новый ОтелРесурс(Истина, "", Истина, Сущности);

    // Когда
    Результат = Старый.Слить(Обновляющий);

    // Тогда
    Ожидаем.Что(ТипыСущностей(Результат)).Равно("host,service");
    Ожидаем.Что(АтрибутыСтрокой(Результат)).Равно("env=prod;host.id=H1;host.name=new-name;service.name=my-svc");

КонецПроцедуры

&Тест
Процедура СвободныйАтрибутЗаменяетАтрибутСущности() Экспорт

    // Дано - пример 2: атрибут host.id обновляющего ресурса конфликтует с сущностью host
    Сущности = Новый Массив();
    Сущности.Добавить(Новый ОтелСущность("host", Пары("host.id", "H1"), Пары("host.name", "detected-name")));
    Сущности.Добавить(Новый ОтелСущность("process", Пары("process.pid", 12345)));
    Старый = Новый ОтелРесурс(Истина, "", Истина, Сущности);
    Обновляющий = РесурсИзАтрибутов(Пары("host.id", "h2", "env", "prod"));

    // Когда
    Результат = Старый.Слить(Обновляющий);

    // Тогда - сущность host удалена, ее остальные атрибуты остались свободными
    Ожидаем.Что(ТипыСущностей(Результат)).Равно("process");
    Ожидаем.Что(АтрибутыСтрокой(Результат)).Равно("env=prod;host.id=h2;host.name=detected-name;process.pid=12345");

КонецПроцедуры

&Тест
Процедура КонфликтыИдентичностиИАтрибутов() Экспорт

    // Дано - пример 3: host с другой идентичностью и атрибут env, занятый сущностью service
    Сущности = Новый Массив();
    Сущности.Добавить(Новый ОтелСущность("host", Пары("host.id", "H2")));
    Сущности.Добавить(Новый ОтелСущность("service", Пары("service.name", "S1"), Пары("env", "dev")));
    Старый = Новый ОтелРесурс(Истина, "", Истина, Сущности);
    НовыйХост = Новый ОтелСущность("host", Пары("host.id", "H1"), Пары("env", "prod"));
    Обновляющий = РесурсСоСущностью(НовыйХост);

    // Когда
    Результат = Старый.Слить(Обновляющий);

    // Тогда - старый host удален вместе с атрибутами, service потерял ссылку, но не атрибуты
    Ожидаем.Что(ТипыСущностей(Результат)).Равно("host");
    Ожидаем.Что(Результат.Сущности()[0].Идентификатор().Получить("host.id")).Равно("H1");
    Ожидаем.Что(АтрибутыСтрокой(Результат)).Равно("env=prod;host.id=H1;service.name=S1");

КонецПроцедуры

// Entity Data Model / Merging of Entities: сущности с одинаковыми типом, идентичностью и адресом
// схемы сливаются, описательные атрибуты новой сущности приоритетнее

&Тест
Процедура СовместимыеСущностиСливаютОписание() Экспорт

    // Дано
    СтарыйХост = Новый ОтелСущность("host", Пары("host.id", "H1"), Пары("host.name", "a", "os.type", "linux"));
    НовыйХост = Новый ОтелСущность("host", Пары("host.id", "H1"), Пары("host.name", "b"));
    Старый = РесурсСоСущностью(СтарыйХост);
    Обновляющий = РесурсСоСущностью(НовыйХост);

    // Когда
    Результат = Старый.Слить(Обновляющий);

    // Тогда
    Ожидаем.Что(ТипыСущностей(Результат)).Равно("host");
    Описание = Результат.Сущности()[0].Описание();
    Ожидаем.Что(Описание.Получить("host.name")).Равно("b");
    Ожидаем.Что(Описание.Получить("os.type")).Равно("linux");
    Ожидаем.Что(АтрибутыСтрокой(Результат)).Равно("host.id=H1;host.name=b;os.type=linux");

КонецПроцедуры

&Тест
Процедура СущностьСДругимАдресомСхемыЗаменяется() Экспорт

    // Дано - одинаковые тип и идентичность, но разные адреса схемы: слить нельзя
    Схема1 = "https://opentelemetry.io/schemas/1.24.0";
    Схема2 = "https://opentelemetry.io/schemas/1.26.0";
    СтарыйХост = Новый ОтелСущность("host", Пары("host.id", "H1"), Пары("host.name", "a"), Схема1);
    НовыйХост = Новый ОтелСущность("host", Пары("host.id", "H1"), Пары("os.type", "linux"), Схема2);
    Старый = РесурсСоСущностью(СтарыйХост);
    Обновляющий = РесурсСоСущностью(НовыйХост);

    // Когда
    Результат = Старый.Слить(Обновляющий);

    // Тогда - старая сущность удалена вместе с атрибутами
    Ожидаем.Что(ТипыСущностей(Результат)).Равно("host");
    Ожидаем.Что(Результат.Сущности()[0].АдресСхемы()).Равно(Схема2);
    Ожидаем.Что(АтрибутыСтрокой(Результат)).Равно("host.id=H1;os.type=linux");

КонецПроцедуры

&Тест
Процедура СлияниеНеМеняетИсходныеРесурсы() Экспорт

    // Дано
    Старый = РесурсСоСущностью(Новый ОтелСущность("host", Пары("host.id", "H1")));
    Обновляющий = РесурсИзАтрибутов(Пары("host.id", "h2"));

    // Когда
    Старый.Слить(Обновляющий);

    // Тогда
    Ожидаем.Что(ТипыСущностей(Старый)).Равно("host");
    Ожидаем.Что(АтрибутыСтрокой(Старый)).Равно("host.id=H1");

КонецПроцедуры

// Resource SDK / Create: ресурс с атрибутами и сущностями создается как ресурс с атрибутами,
// слитый с ресурсом из одних сущностей

&Тест
Процедура СущностиПриСозданииСливаютсяСАтрибутами() Экспорт

    // Дано - атрибут service.name по умолчанию и сущность service
    Сущности = Новый Массив();
    Сущности.Добавить(Новый ОтелСущность("service", Пары("service.name", "checkout")));

    // Когда
    Ресурс = Новый ОтелРесурс(Ложь, "", Истина, Сущности);

    // Тогда
    Ожидаем.Что(ТипыСущностей(Ресурс)).Равно("service");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name")).Равно("checkout");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("telemetry.sdk.name")).Равно("opentelemetry");

КонецПроцедуры

&Тест
Процедура ПостроительДобавляетСущностиПослеАтрибутов() Экспорт

    // Когда
    Ресурс = Новый ОтелПостроительРесурса()
        .Установить("service.name", "loose")
        .ДобавитьСущность(Новый ОтелСущность("service", Пары("service.name", "checkout")))
        .Построить();

    // Тогда
    Ожидаем.Что(ТипыСущностей(Ресурс)).Равно("service");
    Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name")).Равно("checkout");

КонецПроцедуры

// Entity Data Model: тип сущности обязателен, идентичность содержит хотя бы один атрибут

&Тест
Процедура НевалиднаяСущностьНеДобавляется() Экспорт

    // Дано
    Сущности = Новый Массив();
    Сущности.Добавить(Новый ОтелСущность("", Пары("a", "1")));
    Сущности.Добавить(Новый ОтелСущность("host", Новый Соответствие()));

    // Когда
    Ресурс = Новый ОтелРесурс(Истина, "", Истина, Сущности);

    // Тогда
    Ожидаем.Что(Сущности[0].Валидна()).ЭтоЛожь();
    Ожидаем.Что(Сущности[1].Валидна()).ЭтоЛожь();
    Ожидаем.Что(Ресурс.Сущности()).ИмеетДлину(0);
    Ожидаем.Что(Ресурс.Атрибуты().Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура МожноСлитьТолькоСОдинаковымиТипомИдентичностьюИСхемой() Экспорт

    // Дано
    Хост = Новый ОтелСущность("host", Пары("host.id", "H1"), Пары("host.name", "a"));

    // Когда / Тогда
    Ожидаем.Что(Хост.МожноСлить(Новый ОтелСущность("host", Пары("host.id", "H1"), Пары("host.name", "b")))).ЭтоИстина();
    Ожидаем.Что(Хост.МожноСлить(Новый ОтелСущность("host", Пары("host.id", "H2")))).ЭтоЛожь();
    Ожидаем.Что(Хост.МожноСлить(Новый ОтелСущность("host", Пары("host.id", "H1", "host.arch", "x86")))).ЭтоЛожь();
    Ожидаем.Что(Хост.МожноСлить(Новый ОтелСущность("service", Пары("host.id", "H1")))).ЭтоЛожь();
    Ожидаем.Что(Хост.МожноСлить(Новый ОтелСущность("host", Пары("host.id", "H1"), , "https://x"))).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ИдентичностьИОписаниеНеМеняютсяСнаружи() Экспорт

    // Дано
    Идентификатор = Пары("host.id", "H1");
    Хост = Новый ОтелСущность("host", Идентификатор);

    // Когда
    Идентификатор.Вставить("host.id", "H2");

    // Тогда
    Ожидаем.Что(Хост.Идентификатор().Получить("host.id")).Равно("H1");
    Ожидаем.Что(ТипЗнч(Хост.Идентификатор())).Равно(Тип("ФиксированноеСоответствие"));

КонецПроцедуры

Функция Пары(Ключ1, Значение1, Ключ2 = Неопределено, Значение2 = Неопределено)
    Результат = Новый Соответствие();
    Результат.Вставить(Ключ1, Значение1);
    Если Ключ2 <> Неопределено Тогда
        Результат.Вставить(Ключ2, Значение2);
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция РесурсИзАтрибутов(Атрибуты)
    Ресурс = Новый ОтелРесурс(Истина);
    Для Каждого КЗ Из Атрибуты Цикл
        Ресурс.Атрибуты().Установить(КЗ.Ключ, КЗ.Значение);
    КонецЦикла;
    Возврат Ресурс;
КонецФункции

Функция РесурсСоСущностью(Сущность)
    Сущности = Новый Массив();
    Сущности.Добавить(Сущность);
    Возврат Новый ОтелРесурс(Истина, "", Истина, Сущности);
КонецФункции

Функция ТипыСущностей(Ресурс)
    Типы = Новый Массив();
    Для Каждого Сущность Из Ресурс.Сущности() Цикл
        Типы.Добавить(Сущность.ТипСущности());
    КонецЦикла;
    Возврат СтрСоединить(Типы, ",");
КонецФункции

Функция АтрибутыСтрокой(Ресурс)
    Пары = Новый СписокЗначений();
    Для Каждого КЗ Из Ресурс.Атрибуты().ВСоответствие() Цикл
        Пары.Добавить(КЗ.Ключ + "=" + КЗ.Значение);
    КонецЦикла;
    Пары.СортироватьПоЗначению();
    Возврат СтрСоединить(Пары.ВыгрузитьЗначения(), ";");
КонецФункции
