&Тест
Процедура КлючиАтрибутовБазДанных() Экспорт

    Ожидаем.Что(ОтелСемантическиеСоглашения.СистемаБД()).Равно("db.system.name");
    Ожидаем.Что(ОтелСемантическиеСоглашения.ПространствоИменБД()).Равно("db.namespace");
    Ожидаем.Что(ОтелСемантическиеСоглашения.ИмяКоллекцииБД()).Равно("db.collection.name");
    Ожидаем.Что(ОтелСемантическиеСоглашения.ИмяОперацииБД()).Равно("db.operation.name");
    Ожидаем.Что(ОтелСемантическиеСоглашения.ТекстЗапросаБД()).Равно("db.query.text");
    Ожидаем.Что(ОтелСемантическиеСоглашения.ВозвращенныеСтрокиБД()).Равно("db.response.returned_rows");
    Ожидаем.Что(ОтелСемантическиеСоглашения.ИмяПулаСоединенийБД()).Равно("db.client.connection.pool.name");
    Ожидаем.Что(ОтелСемантическиеСоглашения.СостояниеСоединенияБД()).Равно("db.client.connection.state");
    Ожидаем.Что(ОтелСемантическиеСоглашения.СостояниеСоединенияИспользуется()).Равно("used");
    Ожидаем.Что(ОтелСемантическиеСоглашения.СостояниеСоединенияСвободно()).Равно("idle");

КонецПроцедуры

&Тест
Процедура КлючиАтрибутовСервераОшибокИКода() Экспорт

    Ожидаем.Что(ОтелСемантическиеСоглашения.АдресСервера()).Равно("server.address");
    Ожидаем.Что(ОтелСемантическиеСоглашения.ПортСервера()).Равно("server.port");
    Ожидаем.Что(ОтелСемантическиеСоглашения.ТипОшибки()).Равно("error.type");
    Ожидаем.Что(ОтелСемантическиеСоглашения.ПространствоИменКода()).Равно("code.namespace");
    Ожидаем.Что(ОтелСемантическиеСоглашения.ИмяФункцииКода()).Равно("code.function.name");

КонецПроцедуры

&Тест
Процедура ИменаМетрикКлиентаБазДанных() Экспорт

    Ожидаем.Что(ОтелСемантическиеСоглашения.МетрикаДлительностиОперацииБД()).Равно("db.client.operation.duration");
    Ожидаем.Что(ОтелСемантическиеСоглашения.МетрикаКоличестваСоединенийБД()).Равно("db.client.connection.count");
    Ожидаем.Что(ОтелСемантическиеСоглашения.МетрикаПределаСоединенийБД()).Равно("db.client.connection.max");
    Ожидаем.Что(ОтелСемантическиеСоглашения.МетрикаОжидающихЗапросовСоединенийБД()).Равно("db.client.connection.pending_requests");
    Ожидаем.Что(ОтелСемантическиеСоглашения.МетрикаВремениОжиданияСоединенияБД()).Равно("db.client.connection.wait_time");
    Ожидаем.Что(ОтелСемантическиеСоглашения.МетрикаВремениСозданияСоединенияБД()).Равно("db.client.connection.create_time");
    Ожидаем.Что(ОтелСемантическиеСоглашения.МетрикаТаймаутовСоединенийБД()).Равно("db.client.connection.timeouts");

КонецПроцедуры

&Тест
Процедура ГраницыБакетовДлительностиОперацииБД() Экспорт

    Границы = ОтелСемантическиеСоглашения.ГраницыДлительностиОперацииБД();

    Ожидаем.Что(Границы).ИмеетТип("Массив");
    Ожидаем.Что(Границы).ИмеетДлину(9);
    Ожидаем.Что(Границы[0]).Равно(0.001);
    Ожидаем.Что(Границы[8]).Равно(10);
    Для Индекс = 1 По Границы.ВГраница() Цикл
        Ожидаем.Что(Границы[Индекс] > Границы[Индекс - 1], "Границы возрастают").ЭтоИстина();
    КонецЦикла;

КонецПроцедуры

&Тест
Процедура ГраницыВозвращаютсяНовымМассивом() Экспорт

    Первые = ОтелСемантическиеСоглашения.ГраницыДлительностиОперацииБД();
    Первые.Добавить(100);

    Ожидаем.Что(ОтелСемантическиеСоглашения.ГраницыДлительностиОперацииБД(), "Вызывающий не может испортить константу").ИмеетДлину(9);

КонецПроцедуры
