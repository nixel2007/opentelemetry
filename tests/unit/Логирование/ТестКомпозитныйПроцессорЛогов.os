КонецПроцедуры

&Тест
Процедура ЗакрытьТаймаут() Экспорт
    // Дано - первый процессор медленный (больше таймаута)
    ПутьКФикстуре = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "МедленныйПроцессорЛогов.os");
    МедленныйПроцессор = ЗагрузитьСценарий(ПутьКФикстуре);
    МокПроцессор2 = Мок.Получить(Тип("ОтелПростойПроцессорЛогов"));
    Процессоры = Новый Массив();
    Процессоры.Добавить(МедленныйПроцессор);
    Процессоры.Добавить(МокПроцессор2);
    КомпозитныйПроцессор = Новый ОтелКомпозитныйПроцессорЛогов(Процессоры);

    // Когда - закрываем с таймаутом 1мс
    Результат = КомпозитныйПроцессор.Закрыть(1);

    // Тогда - превышен таймаут
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
КонецПроцедуры

&Тест
Процедура ЗакрытьИсключениеПроцессора() Экспорт
    // Дано - процессор бросает исключение в Закрыть
    МокПроцессор = Мок.Получить(Тип("ОтелПростойПроцессорЛогов"));
    МокПроцессор.Когда().Закрыть(Матчеры.ЛюбоеЗначение()).ТогдаВыбрасываетИсключение("тест: ошибка закрытия");
    МокПроцессор2 = Мок.Получить(Тип("ОтелПростойПроцессорЛогов"));
    Процессоры = Новый Массив();
    Процессоры.Добавить(МокПроцессор);
    Процессоры.Добавить(МокПроцессор2);
    КомпозитныйПроцессор = Новый ОтелКомпозитныйПроцессорЛогов(Процессоры);

    // Когда - не должно выбрасывать исключение
    Результат = КомпозитныйПроцессор.Закрыть();

    // Тогда - исключение сообщено ошибкой, второй процессор тоже вызван
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
    Ожидаем.Что(СтрНайти(Результат.Описание(), "тест: ошибка закрытия") > 0, Результат.Описание()).ЭтоИстина();
    МокПроцессор2.ПроверитьЧтоВызывалсяМетод().Закрыть(Матчеры.ЛюбоеЗначение());
КонецПроцедуры

&Тест
Процедура СброситьБуферТаймаут() Экспорт

    // Дано - первый процессор медленный при СброситьБуфер (200мс), таймаут 1мс
    ПутьКФикстуре = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "МедленныйПроцессорЛоговСброс.os");
    МедленныйПроцессор = ЗагрузитьСценарий(ПутьКФикстуре);
    МокПроцессор2 = Мок.Получить(Тип("ОтелПростойПроцессорЛогов"));
    Процессоры = Новый Массив();
    Процессоры.Добавить(МедленныйПроцессор);
    Процессоры.Добавить(МокПроцессор2);
    КомпозитныйПроцессор = Новый ОтелКомпозитныйПроцессорЛогов(Процессоры);

    // Когда - сбрасываем буфер с таймаутом 1мс
    Результат = КомпозитныйПроцессор.СброситьБуфер(1);

    // Тогда - превышен таймаут
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
КонецПроцедуры

// Shutdown SHOULD сообщать об успехе, ошибке или таймауте: композитный процессор сводит
// результаты дочерних процессоров и закрывает каждый из них

&Тест
Процедура ЗакрытьСообщаетОшибкуДочернегоПроцессора() Экспорт

    // Дано
    Сбойный = ДочернийПроцессорЛогов(ОтелРезультатыЗакрытия.Ошибка("сбой дочернего процессора"));
    Успешный = ДочернийПроцессорЛогов(ОтелРезультатыЗакрытия.Успех());
    Процессоры = Новый Массив();
    Процессоры.Добавить(Сбойный);
    Процессоры.Добавить(Успешный);
    Композитный = Новый ОтелКомпозитныйПроцессорЛогов(Процессоры);

    // Когда
    Результат = Композитный.Закрыть(5000);

    // Тогда
    Ожидаем.Что(Успешный.Закрыт, "второй закрыт").ЭтоИстина();
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
    Ожидаем.Что(СтрНайти(Результат.Описание(), "сбой дочернего процессора") > 0, Результат.Описание()).ЭтоИстина();

КонецПроцедуры

Функция ДочернийПроцессорЛогов(Результат)
    Процессор = ЗагрузитьСценарийИзСтроки("Перем Результат Экспорт;
    |Перем Закрыт Экспорт;
    |Процедура ПриПоявлении(ЗаписьЛога, Контекст = Неопределено) Экспорт
    |КонецПроцедуры
    |Функция СброситьБуфер(ТаймаутМс = 0) Экспорт
    |    Возврат ОтелРезультатыЭкспорта.Успех();
    |КонецФункции
    |Функция Закрыть(ТаймаутМс = 0) Экспорт
    |    Закрыт = Истина;
    |    Возврат Результат;
    |КонецФункции
    |Закрыт = Ложь;");
    Процессор.Результат = Результат;
    Возврат Процессор;
КонецФункции
