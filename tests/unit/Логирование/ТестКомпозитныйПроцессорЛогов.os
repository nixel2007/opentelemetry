&Тест
Процедура НулевойТаймаут() Экспорт

	// Дано
	МокПроцессор = Мок.Получить(Тип("ОтелПростойПроцессорЛогов"));
	Процессоры = Новый Массив();
	Процессоры.Добавить(МокПроцессор);
	КомпозитныйПроцессор = Новый ОтелКомпозитныйПроцессорЛогов(Процессоры);

	// Когда - закрытие с нулевым таймаутом
	Результат = КомпозитныйПроцессор.Закрыть(0);

	// Тогда - завершился успешно
	Ожидаем.Что(Результат.Успешно()).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ВключенИсключениеПроцессора() Экспорт
    // Дано - процессор не реализует Включен() - бросает исключение
    МокПроцессор = Мок.Получить(Тип("ОтелПростойПроцессорЛогов"));
    МокПроцессор.Когда().Включен(
        Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение(),
        Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение()
    ).ТогдаВыбрасываетИсключение("метод не реализован");
    Процессоры = Новый Массив();
    Процессоры.Добавить(МокПроцессор);
    КомпозитныйПроцессор = Новый ОтелКомпозитныйПроцессорЛогов(Процессоры);

    // Когда / Тогда - исключение поглощается, возвращает Истина
    Ожидаем.Что(КомпозитныйПроцессор.Включен()).Равно(Истина);
КонецПроцедуры

// Logs SDK / LogRecordProcessor Enabled: изменения параметров внутри Enabled MUST NOT доходить
// до вызывающего - композит не передает их следующим процессорам цепочки
&Тест
Процедура ИзмененияПараметровВключенНеВидныСледующимПроцессорам() Экспорт

    // Дано - первый процессор переприсваивает параметры и возвращает Ложь, второй запоминает полученные
    Изменяющий = ЗагрузитьСценарийИзСтроки("Функция Включен(Контекст, Область, Степень, ИмяСобытия) Экспорт
    |    Контекст = Новый Соответствие();
    |    Область = Неопределено;
    |    Степень = 99;
    |    ИмяСобытия = ""ИЗМЕНЕНО"";
    |    Возврат Ложь;
    |КонецФункции");
    Запоминающий = ЗагрузитьСценарийИзСтроки("Перем Полученные Экспорт;
    |Функция Включен(Контекст, Область, Степень, ИмяСобытия) Экспорт
    |    Полученные = Новый Структура(""Контекст, Область, Степень, ИмяСобытия"",
    |        Контекст, Область, Степень, ИмяСобытия);
    |    Возврат Истина;
    |КонецФункции");
    Процессоры = Новый Массив();
    Процессоры.Добавить(Изменяющий);
    Процессоры.Добавить(Запоминающий);
    КомпозитныйПроцессор = Новый ОтелКомпозитныйПроцессорЛогов(Процессоры);
    Контекст = Новый ФиксированноеСоответствие(Новый Соответствие());
    Область = Новый ОтелОбластьИнструментирования("test-lib");

    // Когда
    Включен = КомпозитныйПроцессор.Включен(Контекст, Область, ОтелСтепеньСерьезности.Info(), "событие");

    // Тогда - второй процессор получил исходные параметры
    Ожидаем.Что(Включен).ЭтоИстина();
    Ожидаем.Что(Запоминающий.Полученные.Контекст = Контекст, "контекст").ЭтоИстина();
    Ожидаем.Что(Запоминающий.Полученные.Область = Область, "область").ЭтоИстина();
    Ожидаем.Что(Запоминающий.Полученные.Степень).Равно(ОтелСтепеньСерьезности.Info());
    Ожидаем.Что(Запоминающий.Полученные.ИмяСобытия).Равно("событие");

КонецПроцедуры

&Тест
Процедура СброситьБуферОшибкаПроцессора() Экспорт
    // Дано - процессор возвращает Ошибка()
    МокПроцессор = Мок.Получить(Тип("ОтелПростойПроцессорЛогов"));
    МокПроцессор.Когда().СброситьБуфер(Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(ОтелРезультатыЭкспорта.Ошибка());
    Процессоры = Новый Массив();
    Процессоры.Добавить(МокПроцессор);
    КомпозитныйПроцессор = Новый ОтелКомпозитныйПроцессорЛогов(Процессоры);

    // Когда
    Результат = КомпозитныйПроцессор.СброситьБуфер();

    // Тогда - итоговый результат Ошибка
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
КонецПроцедуры

