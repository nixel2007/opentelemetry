// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать "../../.."
#Использовать asserts
#Использовать moskito

// Процессор для фонового задания экспорта
Перем ПроцессорДляФона;

&Тест
Процедура ОбработкаЗаписи() Экспорт

    // Дано
    ОтелКонтекст.Очистить();
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерЛогов"));
    Процессор = Новый ОтелПростойПроцессорЛогов(МокЭкспортер);
    Запись = Новый ОтелЗаписьЛога();
    Запись.УстановитьТело("test message");

    // Когда
    Процессор.ПриПоявлении(Запись);

    // Тогда - экспортер вызван с массивом записей
    МокЭкспортер.ПроверитьЧтоВызывалсяМетод().Экспортировать(
        Матчеры.ЛюбоеЗначение()
    );

    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура Закрыть() Экспорт

    // Дано
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерЛогов"));
    Процессор = Новый ОтелПростойПроцессорЛогов(МокЭкспортер);

    // Когда
    Процессор.Закрыть();

    // Тогда - per spec: Shutdown MUST call Exporter.Shutdown
    МокЭкспортер.ПроверитьЧтоВызывалсяМетод().Закрыть();

КонецПроцедуры

&Тест
Процедура ВключенВозвращаетИстину() Экспорт

    // Дано
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерЛогов"));
    Процессор = Новый ОтелПростойПроцессорЛогов(МокЭкспортер);

    // Когда / Тогда - по умолчанию процессор включен
    Ожидаем.Что(Процессор.Включен()).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ОшибкаЭкспортераНеПробрасывается() Экспорт

    // Дано - экспортер выбрасывает исключение
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерЛогов"));
    МокЭкспортер.Когда().Экспортировать(Матчеры.ЛюбоеЗначение())
        .ТогдаВыбрасываетИсключение("тест: ошибка экспорта логов");
    Процессор = Новый ОтелПростойПроцессорЛогов(МокЭкспортер);
    Запись = Новый ОтелЗаписьЛога();
    Запись.УстановитьТело("test message");

    // Когда / Тогда - вызов не должен пробрасывать исключение
    ИсключениеПойманоНеожиданно = Ложь;
    Попытка
        Процессор.ПриПоявлении(Запись);
    Исключение
        ИсключениеПойманоНеожиданно = Истина;
    КонецПопытки;
    Ожидаем.Что(ИсключениеПойманоНеожиданно).Равно(Ложь);

    // И повторный вызов также безопасен (блокировка корректно освобождена)
    Попытка
        Процессор.ПриПоявлении(Запись);
    Исключение
        ИсключениеПойманоНеожиданно = Истина;
    КонецПопытки;
    Ожидаем.Что(ИсключениеПойманоНеожиданно).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ЗакрытьУспех() Экспорт

    // Дано
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерЛогов"));
    Процессор = Новый ОтелПростойПроцессорЛогов(МокЭкспортер);

    // Когда
    Результат = Процессор.Закрыть();

    // Тогда
    Ожидаем.Что(Результат.Успешно()).Равно(Истина);
    МокЭкспортер.ПроверитьЧтоВызывалсяМетод().Закрыть();

КонецПроцедуры

&Тест
Процедура ЗакрытьДваждыИдемпотентно() Экспорт

    // Дано
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерЛогов"));
    Процессор = Новый ОтелПростойПроцессорЛогов(МокЭкспортер);

    // Когда
    Результат1 = Процессор.Закрыть();
    Результат2 = Процессор.Закрыть();

    // Тогда - оба успешны (идемпотентно)
    Ожидаем.Что(Результат1.Успешно()).Равно(Истина);
    Ожидаем.Что(Результат2.Успешно()).Равно(Истина);

КонецПроцедуры

&Тест
Процедура СтарыйЗакрытьРаботает() Экспорт

    // Дано
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерЛогов"));
    Процессор = Новый ОтелПростойПроцессорЛогов(МокЭкспортер);

    // Когда - старая процедура без возврата значения
    Процессор.Закрыть();

    // Тогда - экспортер закрыт
    МокЭкспортер.ПроверитьЧтоВызывалсяМетод().Закрыть();

КонецПроцедуры

&Тест
Процедура ПринудительноВыгрузитьСРезультатом() Экспорт

    // Дано
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерЛогов"));
    Процессор = Новый ОтелПростойПроцессорЛогов(МокЭкспортер);

    // Когда
    Результат = Процессор.ПринудительноВыгрузитьСРезультатом();

    // Тогда
    Ожидаем.Что(Результат.Успешно()).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ПринудительноВыгрузитьПослеЗакрытияВозвращаетОшибку() Экспорт

    // Дано
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерЛогов"));
    Процессор = Новый ОтелПростойПроцессорЛогов(МокЭкспортер);
    Процессор.Закрыть();

    // Когда
    Результат = Процессор.ПринудительноВыгрузитьСРезультатом();

    // Тогда
    Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
    Ожидаем.Что(Результат.Описание()).Равно("Процессор закрыт");

КонецПроцедуры

&Тест
Процедура ПриПоявленииБезЭкспортера() Экспорт
    // Дано - процессор без экспортера
    Процессор = Новый ОтелПростойПроцессорЛогов(Неопределено);
    Запись = Новый ОтелЗаписьЛога();

    // Когда / Тогда - не бросает исключение
    Процессор.ПриПоявлении(Запись);
КонецПроцедуры

&Тест
Процедура СброситьБуферБезЭкспортера() Экспорт
    // Дано
    Процессор = Новый ОтелПростойПроцессорЛогов(Неопределено);

    // Когда
    Результат = Процессор.СброситьБуфер();

    // Тогда - возвращает успех
    Ожидаем.Что(Результат.Успешно()).Равно(Истина);
КонецПроцедуры

&Тест
Процедура ЗакрытьБезЭкспортера() Экспорт
    // Дано
    Процессор = Новый ОтелПростойПроцессорЛогов(Неопределено);

    // Когда
    Результат = Процессор.Закрыть();

    // Тогда - возвращает успех
    Ожидаем.Что(Результат.Успешно()).Равно(Истина);
КонецПроцедуры

&Тест
Процедура ПриПоявленииПослеЗакрытияИгнорирует() Экспорт
    // Дано - spy-экспортер, считающий вызовы
    ТекстСпая =
        "Перем Вызовы Экспорт;" + Символы.ПС
        + "Процедура ПриСозданииОбъекта()" + Символы.ПС
        + "    Вызовы = 0;" + Символы.ПС
        + "КонецПроцедуры" + Символы.ПС
        + "Процедура Экспортировать(Записи) Экспорт" + Символы.ПС
        + "    Вызовы = Вызовы + 1;" + Символы.ПС
        + "КонецПроцедуры" + Символы.ПС
        + "Функция СброситьБуфер(ТаймаутМс = 0) Экспорт" + Символы.ПС
        + "    Возврат Неопределено;" + Символы.ПС
        + "КонецФункции" + Символы.ПС
        + "Функция Закрыть(ТаймаутМс = 30000) Экспорт" + Символы.ПС
        + "    Возврат Неопределено;" + Символы.ПС
        + "КонецФункции";
    СпайЭкспортер = ЗагрузитьСценарийИзСтроки(ТекстСпая);
    Процессор = Новый ОтелПростойПроцессорЛогов(СпайЭкспортер);
    Запись = Новый ОтелЗаписьЛога();
    Запись.УстановитьТело("test");
    Процессор.Закрыть();

    // Когда - вызов ПриПоявлении на закрытом процессоре
    Процессор.ПриПоявлении(Запись);

    // Тогда - экспортер НЕ должен быть вызван
    Ожидаем.Что(СпайЭкспортер.Вызовы).Равно(0);
КонецПроцедуры

&Тест
Процедура ЗакрытьЕслиЭкспортерВыбрасываетИсключение() Экспорт
    // Дано - экспортер выбрасывает исключение при закрытии
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерЛогов"));
    МокЭкспортер.Когда().Закрыть().ТогдаВыбрасываетИсключение("тест: ошибка закрытия");
    Процессор = Новый ОтелПростойПроцессорЛогов(МокЭкспортер);

    // Когда
    Результат = Процессор.Закрыть();

    // Тогда - возвращает ошибку вместо исключения
    Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
КонецПроцедуры

&Тест
Процедура ПринудительноВыгрузитьЕслиСброситьВызываетИсключение() Экспорт
    // Дано - экспортер выбрасывает исключение при СброситьБуфер
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерЛогов"));
    МокЭкспортер.Когда().СброситьБуфер(Матчеры.ЛюбоеЗначение())
        .ТогдаВыбрасываетИсключение("тест: ошибка сброса");
    Процессор = Новый ОтелПростойПроцессорЛогов(МокЭкспортер);

    // Когда
    Результат = Процессор.ПринудительноВыгрузитьСРезультатом();

    // Тогда - возвращает ошибку
    Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
КонецПроцедуры

&Тест
Процедура ПринудительноВыгрузитьЕслиТаймаут() Экспорт
    // Дано - экспортер возвращает таймаут
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерЛогов"));
    МокЭкспортер.Когда().СброситьБуфер(Матчеры.ЛюбоеЗначение())
        .ТогдаВозвращает(ОтелРезультатыЭкспорта.Таймаут());
    Процессор = Новый ОтелПростойПроцессорЛогов(МокЭкспортер);

    // Когда
    Результат = Процессор.ПринудительноВыгрузитьСРезультатом();

    // Тогда - возвращает ИзТаймаута
    Ожидаем.Что(Результат.ИстекТаймаут()).Равно(Истина);
КонецПроцедуры

&Тест
Процедура ПринудительноВыгрузитьЕслиОшибка() Экспорт
    // Дано - экспортер возвращает ошибку
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерЛогов"));
    МокЭкспортер.Когда().СброситьБуфер(Матчеры.ЛюбоеЗначение())
        .ТогдаВозвращает(ОтелРезультатыЭкспорта.Ошибка());
    Процессор = Новый ОтелПростойПроцессорЛогов(МокЭкспортер);

    // Когда
    Результат = Процессор.ПринудительноВыгрузитьСРезультатом();

    // Тогда - возвращает ошибку
    Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
КонецПроцедуры

// Logs SDK / Shutdown MUST включать эффект ForceFlush: буфер экспортера сбрасывается до его
// закрытия; ошибка закрытия экспортера сообщается в результате

&Тест
Процедура ЗакрытьСбрасываетБуферЭкспортераПередЗакрытием() Экспорт

    // Дано
    Экспортер = ЭкспортерЛоговСЖурналомВызовов(ОтелРезультатыЗакрытия.Успех());
    Процессор = Новый ОтелПростойПроцессорЛогов(Экспортер);

    // Когда
    Результат = Процессор.Закрыть(5000);

    // Тогда
    Ожидаем.Что(Результат.Успешно(), Результат.Описание()).ЭтоИстина();
    Ожидаем.Что(СтрСоединить(Экспортер.Вызовы, ",")).Равно("СброситьБуфер,Закрыть");

КонецПроцедуры

&Тест
Процедура ЗакрытьСообщаетОшибкуЗакрытияЭкспортера() Экспорт

    // Дано
    Экспортер = ЭкспортерЛоговСЖурналомВызовов(ОтелРезультатыЗакрытия.Ошибка("сбой закрытия экспортера"));
    Процессор = Новый ОтелПростойПроцессорЛогов(Экспортер);

    // Когда
    Результат = Процессор.Закрыть(5000);

    // Тогда
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
    Ожидаем.Что(СтрНайти(Результат.Описание(), "сбой закрытия экспортера") > 0, Результат.Описание()).ЭтоИстина();

КонецПроцедуры

// Shutdown SHOULD укладываться в таймаут: экспорт, зависший в другом потоке, не ждется
// дольше срока, экспортер закрывается

&Тест
Процедура ЗакрытьСоблюдаетТаймаутПриЗависшемЭкспорте() Экспорт

    // Дано - экспорт в другом потоке длится 1000 мс
    Экспортер = МедленныйЭкспортерЛогов(1000);
    ПроцессорДляФона = Новый ОтелПростойПроцессорЛогов(Экспортер);
    Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЭкспортироватьЗаписьВФоне");
    ДождатьсяНачалаЭкспорта(Экспортер);

    // Когда
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Результат = ПроцессорДляФона.Закрыть(100);
    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
    Задание.ОжидатьЗавершения();

    // Тогда - таймаут без ожидания экспорта, экспортер все равно закрыт
    Ожидаем.Что(Результат.ИстекТаймаут(), Результат.Описание()).ЭтоИстина();
    Ожидаем.Что(ДлительностьМс < 600, ДлительностьМс).ЭтоИстина();
    Ожидаем.Что(Экспортер.Закрыт, "экспортер закрыт").ЭтоИстина();

КонецПроцедуры

Процедура ЭкспортироватьЗаписьВФоне() Экспорт
    ПроцессорДляФона.ПриПоявлении(Новый ОтелЗаписьЛога());
КонецПроцедуры

Процедура ДождатьсяНачалаЭкспорта(Экспортер)
    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Пока НЕ Экспортер.НачатЭкспорт.Получить() Цикл
        Если ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало > 10000 Тогда
            ВызватьИсключение "Фоновый экспорт не начался за 10 с";
        КонецЕсли;
        Приостановить(5);
    КонецЦикла;
КонецПроцедуры

Функция МедленныйЭкспортерЛогов(ЗадержкаМс)
    Экспортер = ЗагрузитьСценарийИзСтроки("Перем ЗадержкаМс Экспорт;
    |Перем НачатЭкспорт Экспорт;
    |Перем Закрыт Экспорт;
    |Функция Экспортировать(Записи, Таймаут = Неопределено) Экспорт
    |    НачатЭкспорт.Установить(Истина);
    |    Приостановить(ЗадержкаМс);
    |    Возврат Истина;
    |КонецФункции
    |Функция СброситьБуфер(ТаймаутМс = 0) Экспорт
    |    Возврат ОтелРезультатыЭкспорта.Успех();
    |КонецФункции
    |Функция Закрыть() Экспорт
    |    Закрыт = Истина;
    |    Возврат ОтелРезультатыЗакрытия.Успех();
    |КонецФункции
    |Закрыт = Ложь;");
    Экспортер.ЗадержкаМс = ЗадержкаМс;
    Экспортер.НачатЭкспорт = Новый АтомарноеБулево(Ложь);
    Возврат Экспортер;
КонецФункции

Функция ЭкспортерЛоговСЖурналомВызовов(РезультатЗакрытия)
    Экспортер = ЗагрузитьСценарийИзСтроки("Перем Вызовы Экспорт;
    |Перем РезультатЗакрытия Экспорт;
    |Функция Экспортировать(Записи, Таймаут = Неопределено) Экспорт
    |    Вызовы.Добавить(""Экспортировать"");
    |    Возврат Истина;
    |КонецФункции
    |Функция СброситьБуфер(ТаймаутМс = 0) Экспорт
    |    Вызовы.Добавить(""СброситьБуфер"");
    |    Возврат ОтелРезультатыЭкспорта.Успех();
    |КонецФункции
    |Функция Закрыть(ТаймаутМс = 0) Экспорт
    |    Вызовы.Добавить(""Закрыть"");
    |    Возврат РезультатЗакрытия;
    |КонецФункции
    |Вызовы = Новый Массив();");
    Экспортер.РезультатЗакрытия = РезультатЗакрытия;
    Возврат Экспортер;
КонецФункции
