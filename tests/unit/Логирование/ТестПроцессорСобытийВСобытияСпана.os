#Использовать "../../.."
#Использовать asserts
#Использовать moskito

&Тест
Процедура СобытиеПереноситсяВСобытиеСпана() Экспорт

    // Дано
    Спан = НовыйСпан();
    Логгер = ЛоггерСПроцессорами(Новый ОтелПроцессорСобытийВСобытияСпана());
    Запись = Логгер.СоздатьЗаписьЛога()
        .УстановитьИмяСобытия("db.client.operation.exception")
        .УстановитьВремя("1700000000000000000")
        .УстановитьАтрибут("db.system.name", "sqlite");

    // Когда
    Логгер.Записать(Запись, КонтекстСоСпаном(Спан));

    // Тогда - одно событие спана: имя события, время записи, все атрибуты записи
    События = Спан.События();
    Ожидаем.Что(События.Количество()).Равно(1);
    Ожидаем.Что(События[0].Имя()).Равно("db.client.operation.exception");
    Ожидаем.Что(События[0].Время()).Равно("1700000000000000000");
    Ожидаем.Что(События[0].Атрибуты().Получить("db.system.name")).Равно("sqlite");

КонецПроцедуры

&Тест
Процедура АтрибутыИсключенияПереносятсяВСобытиеСпана() Экспорт

    // Дано
    Спан = НовыйСпан();
    Логгер = ЛоггерСПроцессорами(Новый ОтелПроцессорСобытийВСобытияСпана());
    Запись = Логгер.СоздатьЗаписьЛога().УстановитьИмяСобытия("exception");
    Попытка
        ВызватьИсключение "Недостаточно товара";
    Исключение
        Ошибка = ИнформацияОбОшибке();
        Запись.УстановитьИсключение(Ошибка);
    КонецПопытки;

    // Когда
    Логгер.Записать(Запись, КонтекстСоСпаном(Спан));

    // Тогда - атрибуты exception.*, которые SDK заполняет при записи, есть и в событии спана
    Атрибуты = Спан.События()[0].Атрибуты();
    Ожидаем.Что(Атрибуты.Получить("exception.message")).Равно(Ошибка.Описание);
    Ожидаем.Что(Атрибуты.Получить("exception.stacktrace")).Равно(ОтелУтилиты.СтекВызововИсключения(Ошибка));

КонецПроцедуры

&Тест
Процедура БезВремениЗаписиВремяНаблюдения() Экспорт

    // Дано - время записи, заданное при создании, очищено
    Спан = НовыйСпан();
    Логгер = ЛоггерСПроцессорами(Новый ОтелПроцессорСобытийВСобытияСпана());
    Запись = Логгер.СоздатьЗаписьЛога()
        .УстановитьИмяСобытия("exception")
        .УстановитьВремя("")
        .УстановитьВремяНаблюдения("1700000000000000001");

    // Когда
    Логгер.Записать(Запись, КонтекстСоСпаном(Спан));

    // Тогда
    Ожидаем.Что(Спан.События()[0].Время()).Равно("1700000000000000001");

КонецПроцедуры

&Тест
Процедура ЗаписьБезИмениСобытияНеПереносится() Экспорт

    // Дано
    Спан = НовыйСпан();
    Логгер = ЛоггерСПроцессорами(Новый ОтелПроцессорСобытийВСобытияСпана());
    Запись = Логгер.СоздатьЗаписьЛога().УстановитьТело("Заказ оформлен");

    // Когда
    Логгер.Записать(Запись, КонтекстСоСпаном(Спан));

    // Тогда
    Ожидаем.Что(Спан.События().Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура СобытиеБезСпанаНеПереносится() Экспорт

    // Дано
    ОтелКонтекст.Очистить();
    Процессор = Новый ОтелПроцессорСобытийВСобытияСпана();
    Логгер = ЛоггерСПроцессорами(Процессор);
    Запись = Логгер.СоздатьЗаписьЛога().УстановитьИмяСобытия("exception");

    // Когда - в текущем контексте нет спана
    Логгер.Записать(Запись);

    // Тогда - процессор ничего не делает и не бросает исключение
    Ожидаем.Что(Запись.ИмяСобытия()).Равно("exception");

КонецПроцедуры

&Тест
Процедура СобытиеЗавершенногоСпанаНеПереносится() Экспорт

    // Дано - спан в контексте завершен, IsRecording = false
    Спан = НовыйСпан();
    Контекст = КонтекстСоСпаном(Спан);
    Спан.Завершить();
    Логгер = ЛоггерСПроцессорами(Новый ОтелПроцессорСобытийВСобытияСпана());
    Запись = Логгер.СоздатьЗаписьЛога().УстановитьИмяСобытия("exception");

    // Когда
    Логгер.Записать(Запись, Контекст);

    // Тогда
    Ожидаем.Что(Спан.События().Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура СобытиеДругогоСпанаНеПереносится() Экспорт

    // Дано - идентификаторы записи не совпадают с текущим спаном контекста
    Спан = НовыйСпан();
    Процессор = Новый ОтелПроцессорСобытийВСобытияСпана();
    Запись = Новый ОтелЗаписьЛога()
        .УстановитьИмяСобытия("exception")
        .УстановитьКонтекстТрассировки(
            "0af7651916cd43dd8448eb211c80319c", "b7ad6b7169203331");

    // Когда
    Процессор.ПриПоявлении(Запись, КонтекстСоСпаном(Спан));

    // Тогда
    Ожидаем.Что(Спан.События().Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ЗаписьПослеПереносаПолучаютСледующиеПроцессоры() Экспорт

    // Дано
    Спан = НовыйСпан();
    МокПроцессор = Мок.Получить(Тип("ОтелПростойПроцессорЛогов"));
    Логгер = ЛоггерСПроцессорами(Новый ОтелПроцессорСобытийВСобытияСпана(), МокПроцессор);
    Запись = Логгер.СоздатьЗаписьЛога().УстановитьИмяСобытия("exception");

    // Когда
    Логгер.Записать(Запись, КонтекстСоСпаном(Спан));

    // Тогда - событие в спане, а запись дошла до процессора экспорта
    Ожидаем.Что(Спан.События().Количество()).Равно(1);
    МокПроцессор.ПроверитьЧтоВызывалсяМетод().ПриПоявлении(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение());

КонецПроцедуры

&Тест
Процедура ПослеЗакрытияСобытиеНеПереносится() Экспорт

    // Дано
    Спан = НовыйСпан();
    Процессор = Новый ОтелПроцессорСобытийВСобытияСпана();
    Логгер = ЛоггерСПроцессорами(Процессор);
    Запись = Логгер.СоздатьЗаписьЛога().УстановитьИмяСобытия("exception");

    // Когда
    Результат = Процессор.Закрыть();
    Процессор.ПриПоявлении(Запись, КонтекстСоСпаном(Спан));

    // Тогда
    Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
    Ожидаем.Что(Спан.События().Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ВключенТолькоСЗаписываемымСпаном() Экспорт

    // Дано
    Спан = НовыйСпан();
    Процессор = Новый ОтелПроцессорСобытийВСобытияСпана();
    КонтекстСпана = КонтекстСоСпаном(Спан);
    КонтекстБезСпана = Новый ФиксированноеСоответствие(Новый Соответствие());

    // Когда / Тогда - без записываемого спана процессору нечего делать
    Ожидаем.Что(Процессор.Включен(КонтекстСпана)).ЭтоИстина();
    Ожидаем.Что(Процессор.Включен(КонтекстБезСпана)).ЭтоЛожь();
    Спан.Завершить();
    Ожидаем.Что(Процессор.Включен(КонтекстСпана)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СброситьБуферУспешно() Экспорт

    // Дано
    Процессор = Новый ОтелПроцессорСобытийВСобытияСпана();

    // Когда
    Результат = Процессор.СброситьБуфер();

    // Тогда - буфера у процессора нет
    Ожидаем.Что(Результат.Успешно()).ЭтоИстина();

КонецПроцедуры

Функция НовыйСпан()
    Возврат Новый ОтелСпан("операция", Новый ОтелРесурс(), Новый ОтелОбластьИнструментирования("тест", "1.0"));
КонецФункции

Функция КонтекстСоСпаном(Спан)
    Возврат ОтелКонтекст.КонтекстСоСпаном(Новый ФиксированноеСоответствие(Новый Соответствие()), Спан);
КонецФункции

Функция ЛоггерСПроцессорами(Процессор, ВторойПроцессор = Неопределено)
    Провайдер = Новый ОтелПровайдерЛогирования(Новый ОтелРесурс(), Процессор);
    Если ВторойПроцессор <> Неопределено Тогда
        Провайдер.ДобавитьПроцессор(ВторойПроцессор);
    КонецЕсли;
    Возврат Провайдер.ПолучитьЛоггер("тест", "1.0");
КонецФункции
