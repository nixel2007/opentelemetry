&Тест
Процедура ПостроительСРесурсомИПроцессорами() Экспорт

    // Дано
    ОтелКонтекст.Очистить();
    Ресурс = Новый ОтелРесурс(Истина);
    Ресурс.Атрибуты().Установить("service.name", "тест-сервис");
    МокПроцессор1 = Мок.Получить(Тип("ОтелПростойПроцессорЛогов"));
    МокПроцессор2 = Мок.Получить(Тип("ОтелПростойПроцессорЛогов"));

    // Когда
    Провайдер = Новый ОтелПостроительПровайдераЛогирования()
        .УстановитьРесурс(Ресурс)
        .ДобавитьПроцессор(МокПроцессор1)
        .ДобавитьПроцессор(МокПроцессор2)
        .Построить();

    // Тогда
    Ожидаем.Что(Провайдер.Ресурс()).Равно(Ресурс);
    Провайдер.СброситьБуфер();
    МокПроцессор1.ПроверитьЧтоВызывалсяМетод().СброситьБуфер(Матчеры.ЛюбоеЗначение());
    МокПроцессор2.ПроверитьЧтоВызывалсяМетод().СброситьБуфер(Матчеры.ЛюбоеЗначение());

    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура ПостроительЛоггераFluentChain() Экспорт

    // Дано
    ОтелКонтекст.Очистить();
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерЛогирования(Ресурс);
    АтрибутыОбласти = Новый ОтелАтрибуты();
    АтрибутыОбласти.Установить("scope.key", "scope.value");

    // Когда - используем полный fluent chain построителя
    Логгер = Провайдер.ПостроительЛоггера("моя-библ")
        .УстановитьВерсию("2.0.0")
        .УстановитьАдресСхемы("https://schema.example.com")
        .УстановитьАтрибутыОбласти(АтрибутыОбласти)
        .Построить();

    // Тогда - scope данные доступны через запись лога
    Ожидаем.Что(Логгер <> Неопределено).Равно(Истина);
    Запись = Логгер.СоздатьЗаписьЛога();
    Логгер.Записать(Запись);
    Ожидаем.Что(Запись.ОбластьИнструментирования().Имя()).Равно("моя-библ");
    Ожидаем.Что(Запись.ОбластьИнструментирования().Версия()).Равно("2.0.0");
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Trace")
&ИсточникЗначение("Debug")
&ИсточникЗначение("Fatal")
Процедура ЛогированиеСРазнымиСтепенямиСерьезности(ИмяСтепени) Экспорт

    // Дано
    ОтелКонтекст.Очистить();
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерЛогирования(Ресурс);
    Логгер = Провайдер.ПолучитьЛоггер("библ", "1.0");

    // BSLLS:IfElseIfEndsWithElse-off
    Если ИмяСтепени = "Trace" Тогда
        Серьезность = ОтелСтепеньСерьезности.Trace();
        ОжидаемыйТекст = "TRACE";
    ИначеЕсли ИмяСтепени = "Debug" Тогда
        Серьезность = ОтелСтепеньСерьезности.Debug();
        ОжидаемыйТекст = "DEBUG";
    ИначеЕсли ИмяСтепени = "Fatal" Тогда
        Серьезность = ОтелСтепеньСерьезности.Fatal();
        ОжидаемыйТекст = "FATAL";
    КонецЕсли;

    // Когда
    Запись = Логгер.СоздатьЗаписьЛога();
    Запись.УстановитьСерьезность(Серьезность);

    // Тогда
    Ожидаем.Что(Запись.НомерСерьезности()).Равно(Серьезность);
    Ожидаем.Что(ОтелСтепеньСерьезности.ТекстСерьезности(Серьезность)).Равно(ОжидаемыйТекст);
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура ПолучитьЛоггерСПустымИменем() Экспорт
    // Дано
    ОтелКонтекст.Очистить();
    Ресурс = Новый ОтелРесурс(Истина);
    МокПроцессор = Мок.Получить(Тип("ОтелПростойПроцессорЛогов"));
    МокПроцессор.Когда().Включен().ТогдаВозвращает(Истина);
    Провайдер = Новый ОтелПровайдерЛогирования(Ресурс, МокПроцессор);

    // Когда - пустое имя
    Логгер = Провайдер.ПолучитьЛоггер("");

    // Тогда - возвращает рабочий логгер (MUST NOT return null)
    Ожидаем.Что(Логгер).Не_().Равно(Неопределено);

    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();
КонецПроцедуры

&Тест
Процедура ЗакрытьИдемпотентно() Экспорт

    // Дано - шпион-процессор со счётчиком вызовов Закрыть
    ТекстСпая = "
    |Перем КоличествоЗакрытий Экспорт;
    |Процедура ПриПоявлении(ЗаписьЛога) Экспорт // BSLLS:UnusedParameters-off
    |КонецПроцедуры
    |Функция Включен() Экспорт
    |    Возврат Истина;
    |КонецФункции
    |Процедура СброситьБуфер(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
    |КонецПроцедуры
    |Процедура Закрыть(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
    |    КоличествоЗакрытий = КоличествоЗакрытий + 1;
    |КонецПроцедуры
    |КоличествоЗакрытий = 0;";
    СпайПроцессор = ЗагрузитьСценарийИзСтроки(ТекстСпая);
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерЛогирования(Ресурс, СпайПроцессор);

    // Когда - несколько параллельных асинхронных вызовов + повторный синхронный
    Обещание1 = Провайдер.ЗакрытьАсинхронно();
    Обещание2 = Провайдер.ЗакрытьАсинхронно();
    Обещание1.Получить(5000);
    Обещание2.Получить(5000);
    Провайдер.Закрыть();

    // Тогда - Закрыть у процессора вызван ровно один раз (CAS-идемпотентность)
    Ожидаем.Что(СпайПроцессор.КоличествоЗакрытий).Равно(1);
    Ожидаем.Что(Провайдер.Закрыт()).Равно(Истина);

КонецПроцедуры

&Тест
