&Тест
Процедура ПолучитьЛоггер() Экспорт

    // Дано
    ОтелКонтекст.Очистить();
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерЛогирования(Ресурс);

    // Когда
    Логгер = Провайдер.ПолучитьЛоггер("my-lib", "1.0");

    // Тогда - проверяем scope через запись лога
    Ожидаем.Что(Логгер <> Неопределено).Равно(Истина);

    Запись = Логгер.СоздатьЗаписьЛога();
    Логгер.Записать(Запись);
    Ожидаем.Что(Запись.ОбластьИнструментирования().Имя()).Равно("my-lib");
    Ожидаем.Что(Запись.ОбластьИнструментирования().Версия()).Равно("1.0");

    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура КэшированиеЛоггеров() Экспорт

    // Дано
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерЛогирования(Ресурс);

    // Когда - запрашиваем одного и того же логгера дважды
    Логгер1 = Провайдер.ПолучитьЛоггер("cached-lib", "2.0");
    Логгер2 = Провайдер.ПолучитьЛоггер("cached-lib", "2.0");

    // Тогда - возвращается тот же объект
    Ожидаем.Что(Логгер1).Равно(Логгер2);

КонецПроцедуры

&Тест
Процедура ДобавлениеПроцессораВоВремяОбработкиЗаписиБезопасно() Экспорт

    // Дано - процессор, который при появлении записи добавляет в провайдер процессор-счетчик
    // (модель конкурентного ДобавитьПроцессор во время обработки записи)
    КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Провайдер = Новый ОтелПровайдерЛогирования(Новый ОтелРесурс(Истина));
    Счетчик = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "СчетчикПроцессораЛогов.os"));
    Добавляющий = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "ДобавляющийПроцессорЛогов.os"));
    Добавляющий.Провайдер = Провайдер;
    Добавляющий.ДобавляемыйПроцессор = Счетчик;
    Провайдер.ДобавитьПроцессор(Добавляющий);
    Логгер = Провайдер.ПолучитьЛоггер("тест");

    // Когда - первая запись добавляет счетчик, вторая проходит через него
    Логгер.Записать(Логгер.СоздатьЗаписьЛога());
    Логгер.Записать(Логгер.СоздатьЗаписьЛога());

    // Тогда - исключение не вылетело из Записать, счетчик получил только вторую запись
    Ожидаем.Что(Счетчик.КоличествоВызовов).Равно(1);

КонецПроцедуры

&Тест
Процедура ОбластьЛоггераСоздаетсяИзВсехПараметров() Экспорт

    // Дано - логгеры с одинаковыми именем и версией, но разными схемой или атрибутами
    Провайдер = Новый ОтелПровайдерЛогирования(Новый ОтелРесурс(Истина));
    АтрибутыV1 = Новый ОтелАтрибуты();
    АтрибутыV1.Установить("k", "v1");
    АтрибутыV2 = Новый ОтелАтрибуты();
    АтрибутыV2.Установить("k", "v2");

    // Когда
    Базовый = Провайдер.ПолучитьЛоггер("lib", "1.0", АтрибутыV1, "https://a");
    СДругойСхемой = Провайдер.ПолучитьЛоггер("lib", "1.0", АтрибутыV1, "https://b");
    СДругимиАтрибутами = Провайдер.ПолучитьЛоггер("lib", "1.0", АтрибутыV2, "https://a");
    Идентичный = Провайдер.ПолучитьЛоггер("lib", "1.0", АтрибутыV1, "https://a");

    // Тогда - область каждого логгера создана из переданных параметров
    Ожидаем.Что(СДругойСхемой.ОбластьИнструментирования().АдресСхемы()).Равно("https://b");
    Ожидаем.Что(СДругимиАтрибутами.ОбластьИнструментирования().Атрибуты().Получить("k")).Равно("v2");
    Ожидаем.Что(Идентичный).Равно(Базовый);

КонецПроцедуры

&Тест
Процедура ПередачаЛимитов() Экспорт

    // Дано - лимиты через построитель провайдера
    ОтелКонтекст.Очистить();
    Лимиты = Новый ОтелЛимитыЗаписейЛога()
        .УстановитьМаксАтрибутов(3);
    Провайдер = Новый ОтелПостроительПровайдераЛогирования()
        .УстановитьЛимитыЗаписейЛога(Лимиты)
        .Построить();

    // Когда
    Логгер = Провайдер.ПолучитьЛоггер("lib", "1.0");
    Запись = Логгер.СоздатьЗаписьЛога();
    Запись.УстановитьАтрибут("a", 1);
    Запись.УстановитьАтрибут("b", 2);
    Запись.УстановитьАтрибут("c", 3);
    Запись.УстановитьАтрибут("d", 4);

    // Тогда - лимит 3 передан через провайдер
    Ожидаем.Что(Запись.Атрибуты().Количество()).Равно(3);

    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура Закрыть() Экспорт

    // Дано
    МокПроцессор = Мок.Получить(Тип("ОтелПростойПроцессорЛогов"));
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерЛогирования(Ресурс, МокПроцессор);

    // Когда
    Провайдер.Закрыть();

    // Тогда - Закрыть вызван у процессора
    МокПроцессор.ПроверитьЧтоВызывалсяМетод().Закрыть(Матчеры.ЛюбоеЗначение());
    Ожидаем.Что(Провайдер.Закрыт()).Равно(Истина);

