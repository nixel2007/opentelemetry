&Тест
// BSLLS:Typo-off
Процедура ДобавленныйПроцессорВиденСуществующемуЛоггеру() Экспорт
// BSLLS:Typo-on

    // Дано - логгер создан ДО добавления процессора [318]
    ОтелКонтекст.Очистить();
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерЛогирования(Ресурс);
    Логгер = Провайдер.ПолучитьЛоггер("test-lib", "1.0");

    // Логгер выключен - нет процессоров
    Ожидаем.Что(Логгер.Включен()).Равно(Ложь);

    // Когда - добавляем процессор ПОСЛЕ создания логгера
    МокПроцессор = Мок.Получить(Тип("ОтелПростойПроцессорЛогов"));
    Провайдер.ДобавитьПроцессор(МокПроцессор);

    // Тогда - логгер видит новый процессор и включен
    Ожидаем.Что(Логгер.Включен()).Равно(Истина);

    // И запись обрабатывается новым процессором
    Запись = Логгер.СоздатьЗаписьЛога();
    Запись.УстановитьТело("test config propagation");
    Логгер.Записать(Запись);
    МокПроцессор.ПроверитьЧтоВызывалсяМетод().ПриПоявлении(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение());

    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура ЗаписатьСЯвнымКонтекстом() Экспорт

    // Дано - спан НЕ текущий, передаётся через явный контекст
    ОтелКонтекст.Очистить();
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0");
    Спан = Новый ОтелСпан("explicit-context-op", Ресурс, ОбластьИнструментирования);

    // Создаём контекст со спаном, но НЕ делаем его текущим
    ЯвныйКонтекст = ОтелКонтекст.КонтекстСоСпаном(Новый Соответствие(), Спан);

    Провайдер = Новый ОтелПровайдерЛогирования(Ресурс);
    Логгер = Провайдер.ПолучитьЛоггер("test-lib", "1.0");

    // Когда - записываем с явным контекстом
    Запись = Логгер.СоздатьЗаписьЛога();
    Логгер.Записать(Запись, ЯвныйКонтекст);

    // Тогда - trace context из явного контекста
    Ожидаем.Что(Запись.ИдТрассировки()).Равно(Спан.КонтекстСпана().ИдТрассировки());
    Ожидаем.Что(Запись.ИдСпана()).Равно(Спан.КонтекстСпана().ИдСпана());

    Спан.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура КонтекстРазрешаетсяПриEmitАНеПриСозданииЗаписи() Экспорт

    // Дано - создаём запись БЕЗ текущего спана, потом делаем спан текущим
    ОтелКонтекст.Очистить();
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерЛогирования(Ресурс);
    Логгер = Провайдер.ПолучитьЛоггер("test-lib", "1.0");

    Запись = Логгер.СоздатьЗаписьЛога();
    // На момент создания записи нет текущего спана
    Ожидаем.Что(Запись.ИдТрассировки()).Равно("");

    // Теперь создаём спан и делаем текущим
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0");
    Спан = Новый ОтелСпан("deferred-op", Ресурс, ОбластьИнструментирования);
    Область = Спан.СделатьТекущим();

    // Когда - emit в контексте спана
    Логгер.Записать(Запись);

    // Тогда - контекст разрешён при emit, а не при создании записи
    Ожидаем.Что(Запись.ИдТрассировки()).Равно(Спан.КонтекстСпана().ИдТрассировки());
    Ожидаем.Что(Запись.ИдСпана()).Равно(Спан.КонтекстСпана().ИдСпана());

    Область.Закрыть();
    Спан.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура ВключенПропускаетЛюбуюСерьезность() Экспорт

    // Дано
    ОтелКонтекст.Очистить();
    Провайдер = Новый ОтелПровайдерЛогирования(Новый ОтелРесурс(Истина));
    Провайдер.ДобавитьПроцессор(Новый ОтелПростойПроцессорЛогов(Неопределено));
    Область = Новый ОтелОбластьИнструментирования("тест", "1.0");
    Логгер = Новый ОтелЛоггер(Область, Новый ОтелРесурс(Истина), Провайдер);

    // Тогда - все серьезности проходят
    Ожидаем.Что(Логгер.Включен(, , ОтелСтепеньСерьезности.Debug())).ЭтоИстина();
    Ожидаем.Что(Логгер.Включен(, , ОтелСтепеньСерьезности.Error())).ЭтоИстина();

    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура ЗаписатьСНевалиднымСпаномВКонтекстеНеЗаполняетКонтекстТрассировки() Экспорт

    // Дано - текущим сделан невалидный спан (нулевые TraceId и SpanId)
    ОтелКонтекст.Очистить();
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерЛогирования(Ресурс);
    Логгер = Провайдер.ПолучитьЛоггер("test-lib", "1.0");
    Токен = ОтелКонтекст.СделатьСпанТекущим(ОтелСпаны.Невалидный());

    // Когда
    Запись = Логгер.СоздатьЗаписьЛога();
    Логгер.Записать(Запись);
    ОтелКонтекст.ОтсоединитьКонтекст(Токен);

    // Тогда - запись не связана с трассировкой
    Ожидаем.Что(Запись.ИдТрассировки()).Равно("");
    Ожидаем.Что(Запись.ИдСпана()).Равно("");

    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура ЗаписатьУстанавливаетАтрибутыИсключения() Экспорт

    // Дано
    ОтелКонтекст.Очистить();
    МокПроцессор = Мок.Получить(Тип("ОтелПростойПроцессорЛогов"));
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерЛогирования(Ресурс, МокПроцессор);
    Логгер = Провайдер.ПолучитьЛоггер("test-lib", "1.0");

    // Когда - создаем запись с исключением
    Запись = Логгер.СоздатьЗаписьЛога();
    Попытка
        ВызватьИсключение "Тестовая ошибка";
    Исключение
        Запись.УстановитьИсключение(ИнформацияОбОшибке());
    КонецПопытки;
    Логгер.Записать(Запись);

    // Тогда - атрибуты исключения установлены, тип у ошибки без кода errors не заполняется
    Ожидаем.Что(Запись.Атрибуты().Получить("exception.message")).Равно("Тестовая ошибка");
    Ожидаем.Что(Запись.Атрибуты().Получить("exception.stacktrace") <> Неопределено).Равно(Истина);
    Ожидаем.Что(Запись.Атрибуты().Получить("exception.type")).Равно(Неопределено);

    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура ЗаписатьАтрибутыПользователяПриоритетнееИсключения() Экспорт

    // Дано
    ОтелКонтекст.Очистить();
    МокПроцессор = Мок.Получить(Тип("ОтелПростойПроцессорЛогов"));
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерЛогирования(Ресурс, МокПроцессор);
    Логгер = Провайдер.ПолучитьЛоггер("test-lib", "1.0");

    // Когда - создаем запись с пользовательским exception.message И исключением
    Запись = Логгер.СоздатьЗаписьЛога();
    Запись.УстановитьАтрибут("exception.message", "Мое сообщение");
    Попытка
        ВызватьИсключение "SDK ошибка";
    Исключение
        Запись.УстановитьИсключение(ИнформацияОбОшибке());
    КонецПопытки;
    Логгер.Записать(Запись);

    // Тогда - пользовательский атрибут exception.message НЕ перезаписан
    Ожидаем.Что(Запись.Атрибуты().Получить("exception.message")).Равно("Мое сообщение");
    // Но exception.stacktrace установлен из SDK
    Ожидаем.Что(Запись.Атрибуты().Получить("exception.stacktrace") <> Неопределено).Равно(Истина);

    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура ЗаписатьТипИсключенияИзКодаОбернутойОшибки() Экспорт

    // Дано
    ОтелКонтекст.Очистить();
    МокПроцессор = Мок.Получить(Тип("ОтелПростойПроцессорЛогов"));
    Провайдер = Новый ОтелПровайдерЛогирования(Новый ОтелРесурс(Истина), МокПроцессор);
    Логгер = Провайдер.ПолучитьЛоггер("test-lib", "1.0");

    // Когда - ошибка без кода обернута ошибкой errors с кодом
    Запись = Логгер.СоздатьЗаписьЛога();
    Попытка
        Попытка
            ВызватьИсключение "Исходная ошибка";
        Исключение
            ВызватьИсключение ФабрикаОшибок.Обернуть(ИнформацияОбОшибке(), "config.invalid_port", "Некорректный порт");
        КонецПопытки;
    Исключение
        Запись.УстановитьИсключение(ИнформацияОбОшибке());
    КонецПопытки;
    Логгер.Записать(Запись);

    // Тогда - exception.type равен коду ошибки
    Ожидаем.Что(Запись.Атрибуты().Получить("exception.type")).Равно("config.invalid_port");

    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура ЗаписатьЯвныйТипИсключенияПриоритетнееКодаОшибки() Экспорт

    // Дано
    ОтелКонтекст.Очистить();
    МокПроцессор = Мок.Получить(Тип("ОтелПростойПроцессорЛогов"));
    Провайдер = Новый ОтелПровайдерЛогирования(Новый ОтелРесурс(Истина), МокПроцессор);
    Логгер = Провайдер.ПолучитьЛоггер("test-lib", "1.0");

    // Когда - у ошибки есть код, и тип задан атрибутом записи
    Запись = Логгер.СоздатьЗаписьЛога();
    Запись.УстановитьАтрибут("exception.type", "МойТип");
    Попытка
        ВызватьИсключение ФабрикаОшибок.Создать("config.invalid_port", "Некорректный порт");
    Исключение
        Запись.УстановитьИсключение(ИнформацияОбОшибке());
    КонецПопытки;
    Логгер.Записать(Запись);

    // Тогда - явный тип главнее
    Ожидаем.Что(Запись.Атрибуты().Получить("exception.type")).Равно("МойТип");

    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура ВключенПередаетВсеПараметрыПроцессору() Экспорт

    // Дано - spy-процессор, захватывающий переданные параметры Включен
    ТекстСпая = "
    |Перем ВизванВключен Экспорт;
    |Перем ЗахваченКонтекст Экспорт;
    |Перем ЗахваченнаяОбласть Экспорт;
    |Перем ЗахваченаяСерьезность Экспорт;
    |Перем ЗахваченноеИмяСобытия Экспорт;
    |Процедура ПриПоявлении(ЗаписьЛога, Контекст = Неопределено) Экспорт // BSLLS:UnusedParameters-off
    |КонецПроцедуры
    |Функция Включен(Контекст = Неопределено, ОбластьИнструментирования = Неопределено, СтепеньСерьезности = 0, ИмяСобытия = """") Экспорт
    |    ВизванВключен = Истина;
    |    ЗахваченКонтекст = Контекст;
    |    ЗахваченнаяОбласть = ОбластьИнструментирования;
    |    ЗахваченаяСерьезность = СтепеньСерьезности;
    |    ЗахваченноеИмяСобытия = ИмяСобытия;
    |    Возврат Истина;
    |КонецФункции
    |Процедура СброситьБуфер(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
    |КонецПроцедуры
    |Процедура Закрыть(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
    |КонецПроцедуры
    |ВизванВключен = Ложь;
    |ЗахваченноеИмяСобытия = """";
    |ЗахваченаяСерьезность = 0;";
    Спай = ЗагрузитьСценарийИзСтроки(ТекстСпая);
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерЛогирования(Ресурс, Спай);
    Логгер = Провайдер.ПолучитьЛоггер("my-lib", "1.0");

    // Когда
    Результат = Логгер.Включен(, , ОтелСтепеньСерьезности.Warn(), "event.x");

    // Тогда - процессор вызван с нужными параметрами; результат - Истина
    Ожидаем.Что(Результат).Равно(Истина);
    Ожидаем.Что(Спай.ВизванВключен).Равно(Истина);
    Ожидаем.Что(Спай.ЗахваченаяСерьезность).Равно(ОтелСтепеньСерьезности.Warn());
    Ожидаем.Что(Спай.ЗахваченноеИмяСобытия).Равно("event.x");
    Ожидаем.Что(Спай.ЗахваченнаяОбласть).Не_().Равно(Неопределено);
    Ожидаем.Что(Спай.ЗахваченнаяОбласть.Имя()).Равно("my-lib");

    Провайдер.Закрыть();

КонецПроцедуры

&Тест
Процедура ВключенКороткоеЗамыканиеПоПроцессорам() Экспорт

    // Дано - первый процессор возвращает Истина, второй - считает вызовы
    ТекстПервого = "
    |Процедура ПриПоявлении(ЗаписьЛога, Контекст = Неопределено) Экспорт // BSLLS:UnusedParameters-off
    |КонецПроцедуры
    |Функция Включен(Контекст = Неопределено, ОбластьИнструментирования = Неопределено, СтепеньСерьезности = 0, ИмяСобытия = """") Экспорт // BSLLS:UnusedParameters-off
    |    Возврат Истина;
    |КонецФункции
    |Процедура СброситьБуфер(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
    |КонецПроцедуры
    |Процедура Закрыть(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
    |КонецПроцедуры";
    ТекстВторого = "
    |Перем КоличествоВызовов Экспорт;
    |Процедура ПриПоявлении(ЗаписьЛога, Контекст = Неопределено) Экспорт // BSLLS:UnusedParameters-off
    |КонецПроцедуры
    |Функция Включен(Контекст = Неопределено, ОбластьИнструментирования = Неопределено, СтепеньСерьезности = 0, ИмяСобытия = """") Экспорт // BSLLS:UnusedParameters-off
    |    КоличествоВызовов = КоличествоВызовов + 1;
    |    Возврат Истина;
    |КонецФункции
    |Процедура СброситьБуфер(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
    |КонецПроцедуры
    |Процедура Закрыть(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
    |КонецПроцедуры
    |КоличествоВызовов = 0;";
    Первый = ЗагрузитьСценарийИзСтроки(ТекстПервого);
    Второй = ЗагрузитьСценарийИзСтроки(ТекстВторого);
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПостроительПровайдераЛогирования()
        .УстановитьРесурс(Ресурс)
        .ДобавитьПроцессор(Первый)
        .ДобавитьПроцессор(Второй)
        .Построить();
    Логгер = Провайдер.ПолучитьЛоггер("my-lib");

    // Когда
    Результат = Логгер.Включен();

    // Тогда - после Истина у первого, второй не вызван (short-circuit)
    Ожидаем.Что(Результат).Равно(Истина);
    Ожидаем.Что(Второй.КоличествоВызовов).Равно(0);

    Провайдер.Закрыть();

КонецПроцедуры

&Тест
Процедура ВключенМутацияОбластиНеПопадаетВCaller() Экспорт

    // Дано - процессор пытается мутировать переданную ему ОбластьИнструментирования
    ТекстМутирующего = "
    |Процедура ПриПоявлении(ЗаписьЛога, Контекст = Неопределено) Экспорт // BSLLS:UnusedParameters-off
    |КонецПроцедуры
    |Функция Включен(Контекст = Неопределено, ОбластьИнструментирования = Неопределено, СтепеньСерьезности = 0, ИмяСобытия = """") Экспорт // BSLLS:UnusedParameters-off
    |    Если ОбластьИнструментирования <> Неопределено И ОбластьИнструментирования.Атрибуты() <> Неопределено Тогда
    |        ОбластьИнструментирования.Атрибуты().Установить(""мутация"", ""утекла"");
    |    КонецЕсли;
    |    Возврат Истина;
    |КонецФункции
    |Процедура СброситьБуфер(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
    |КонецПроцедуры
    |Процедура Закрыть(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
    |КонецПроцедуры";
    МутирующийПроцессор = ЗагрузитьСценарийИзСтроки(ТекстМутирующего);
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерЛогирования(Ресурс, МутирующийПроцессор);
    АтрибутыОбласти = Новый ОтелАтрибуты();
    АтрибутыОбласти.Установить("исходный", "значение");
    Логгер = Провайдер.ПолучитьЛоггер("тест.библиотека", "1.0", АтрибутыОбласти);

    // Когда
    Логгер.Включен();

    // Тогда - caller-объект (scope) не мутирован; исходные атрибуты сохранены
    Ожидаем.Что(АтрибутыОбласти.Получить("мутация")).Равно(Неопределено);
    Ожидаем.Что(АтрибутыОбласти.Количество()).Равно(1);
    Ожидаем.Что(Логгер.ОбластьИнструментирования().Атрибуты().Получить("мутация")).Равно(Неопределено);

    Провайдер.Закрыть();

КонецПроцедуры

&Тест
Процедура СоздатьЗаписьЛогаБезПровайдера() Экспорт

    // Дано - логгер без провайдера
