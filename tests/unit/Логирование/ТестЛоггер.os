    // Тогда - запись создана без лимитов
    Ожидаем.Что(Запись).Не_().Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЗаписатьБезПровайдераНеПадает() Экспорт

    // Дано - логгер без провайдера
    ОтелКонтекст.Очистить();
    Область = Новый ОтелОбластьИнструментирования("test", "1.0");
    Ресурс = Новый ОтелРесурс();
    Логгер = Новый ОтелЛоггер(Область, Ресурс);

    // Когда - записываем лог без провайдера
    Запись = Логгер.СоздатьЗаписьЛога();
    Запись.УстановитьТело("тестовое тело");
    Логгер.Записать(Запись);

    // Тогда - запись зафиксирована (Записать не падает и вызывает Зафиксировать)
    Запись.УстановитьТело("не изменилось");
    Ожидаем.Что(Запись.Тело()).Равно("тестовое тело");

    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура ВключенСОбластьюНеопределено() Экспорт

    // Дано - spy-процессор, захватывающий переданную область
    ОтелКонтекст.Очистить();
    ТекстСпая = "
    |Перем ЗахваченнаяОбласть Экспорт;
    |Процедура ПриПоявлении(ЗаписьЛога, Контекст = Неопределено) Экспорт // BSLLS:UnusedParameters-off
    |КонецПроцедуры
    |Функция Включен(Контекст = Неопределено, ОбластьИнструментирования = Неопределено, СтепеньСерьезности = 0, ИмяСобытия = """") Экспорт // BSLLS:UnusedParameters-off
    |    ЗахваченнаяОбласть = ОбластьИнструментирования;
    |    Возврат Истина;
    |КонецФункции
    |Процедура СброситьБуфер(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
    |КонецПроцедуры
    |Процедура Закрыть(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
    |КонецПроцедуры
    |ЗахваченнаяОбласть = Неопределено;";
    Спай = ЗагрузитьСценарийИзСтроки(ТекстСпая);
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерЛогирования(Ресурс, Спай);
    // Создаем логгер с Неопределено областью инструментирования
    Логгер = Новый ОтелЛоггер(Неопределено, Ресурс, Провайдер);

    // Когда - вызываем Включен()
    Результат = Логгер.Включен();

    // Тогда - ЗащищеннаяКопияОбласти(Неопределено) вернула Неопределено → область передана Неопределено
    Ожидаем.Что(Результат).Равно(Истина);
    Ожидаем.Что(Спай.ЗахваченнаяОбласть).Равно(Неопределено);

    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура ВключенБезПровайдера() Экспорт

    // Дано - логгер создан без провайдера
    Область = Новый ОтелОбластьИнструментирования("test", "1.0");
    Ресурс = Новый ОтелРесурс();
    Логгер = Новый ОтелЛоггер(Область, Ресурс);

    // Тогда - Включен() возвращает Ложь (нет провайдера)
    Ожидаем.Что(Логгер.Включен()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ЗаписатьАтрибутыИсключенияСПустымМодулем() Экспорт

    // Дано - логгер с процессором
    ОтелКонтекст.Очистить();
    МокПроцессор = Мок.Получить(Тип("ОтелПростойПроцессорЛогов"));
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерЛогирования(Ресурс, МокПроцессор);
    Логгер = Провайдер.ПолучитьЛоггер("test-lib", "1.0");

    // Когда - создаем запись с фиктивным ErrorInfo с пустым ИмяМодуля и пустым стеком
    ФиктивноеИсключение = "
    |Перем Описание Экспорт;
    |Перем ИмяМодуля Экспорт;
    |Функция ПодробноеОписаниеОшибки() Экспорт
    |    Возврат """";
    |КонецФункции
    |Описание = ""исходное сообщение"";
    |ИмяМодуля = """";";
    ФиктивноеИнфо = ЗагрузитьСценарийИзСтроки(ФиктивноеИсключение);

    Запись = Логгер.СоздатьЗаписьЛога();
    Запись.УстановитьИсключение(ФиктивноеИнфо);
    Логгер.Записать(Запись);

    // Тогда - exception.type не заполнен (объект не ИнформацияОбОшибке), exception.stacktrace = описание (пустой стек)
    Ожидаем.Что(Запись.Атрибуты().Получить("exception.type")).Равно(Неопределено);
    Ожидаем.Что(Запись.Атрибуты().Получить("exception.stacktrace")).Равно("исходное сообщение");

    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

// Logs SDK / Enabled: изменения параметров внутри Enabled MUST NOT доходить до вызывающего
&Тест
Процедура ИзмененияПараметровВключенВПроцессореНеВидныВызывающему() Экспорт

    // Дано - процессор изменяет параметры Включен()
    КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Процессор = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "ИзменяющийПараметрыПроцессорЛогов.os"));
    Провайдер = Новый ОтелПровайдерЛогирования(Новый ОтелРесурс(Истина), Процессор);
    Логгер = Провайдер.ПолучитьЛоггер("test-lib", "1.0");
    Контекст = Новый Соответствие();
    СтепеньСерьезности = ОтелСтепеньСерьезности.Info();
    ИмяСобытия = "событие";

    // Когда
    Включен = Логгер.Включен(Контекст, , СтепеньСерьезности, ИмяСобытия);

    // Тогда - переменные и контекст вызывающего не изменились
    Ожидаем.Что(Включен).ЭтоИстина();
    Ожидаем.Что(СтепеньСерьезности).Равно(ОтелСтепеньСерьезности.Info());
    Ожидаем.Что(ИмяСобытия).Равно("событие");
    Ожидаем.Что(Контекст.Количество(), "ключей в контексте вызывающего").Равно(0);

    Провайдер.Закрыть();

КонецПроцедуры
