// OTLP Exporter / User Agent: пользовательский User-Agent - идентификатор продукта,
// итоговый заголовок включает стандартный User-Agent экспортера
&Тест
Процедура ПользовательскийUserAgentДобавляетсяПередСтандартным() Экспорт

    // Дано - идентификатор дистрибутива в заголовке, ключ в нижнем регистре (как из OTEL_EXPORTER_OTLP_HEADERS)
    КлючВНижнемРегистре = "user-agent";
    Заголовки = Новый Соответствие();
    Заголовки.Вставить(КлючВНижнемРегистре, "MyDistribution/1.2.3");

    // Когда
    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + Порт, Заголовки);

    // Тогда - один заголовок: идентификатор, затем стандартная строка экспортера
    ВсеЗаголовки = Транспорт.ПолучитьЗаголовки();
    Ожидаем.Что(ВсеЗаголовки.Получить("User-Agent"))
        .Равно("MyDistribution/1.2.3 OTel-OTLP-Exporter-OneScript/" + ОтелУтилиты.ВерсияSDK());
    Ожидаем.Что(ВсеЗаголовки.Получить(КлючВНижнемРегистре)).Равно(Неопределено);

КонецПроцедуры

// OTLP Exporter / Max Request Size и Max Response Size: 64 MiB и 4 MiB по умолчанию
&Тест
Процедура МаксимальныеРазмерыПоУмолчанию() Экспорт

    // Дано / Когда
    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + Порт);

    // Тогда
    Ожидаем.Что(Транспорт.МаксРазмерЗапроса()).Равно(67108864);
    Ожидаем.Что(Транспорт.МаксРазмерОтвета()).Равно(4194304);

КонецПроцедуры

&Тест
Процедура ЗапросБольшеМаксимальногоРазмераНеОтправляется() Экспорт

    // Дано - адрес отвечает 200, но лимит меньше размера запроса
    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + Порт, , , 1, , , "http/json")
        .УстановитьМаксРазмерЗапроса(10);
    Данные = Новый Соответствие();
    Данные.Вставить("resourceSpans", Новый Массив());
    Аппендер = НачатьЗахватЛога();

    // Когда
    Результат = Транспорт.Отправить("/v1/traces", Данные);

    // Тогда - запрос отброшен
    ЗакончитьЗахватЛога(Аппендер);
    Ожидаем.Что(Результат).Равно(Ложь);
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "превышает"), "сообщение о лимите").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЛимитРазмераЗапросаДействуетДоСжатия() Экспорт

    // Дано - запрос сжимается gzip намного меньше лимита, но без сжатия больше лимита
    Данные = Новый Соответствие();
    Данные.Вставить("resourceSpans", Новый Массив());
    Данные.Вставить("padding", СтрокаДлиной(2000));
    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + Порт, , , 1, "gzip", , "http/json")
        .УстановитьМаксРазмерЗапроса(1000);
    ТранспортСЗапасом = Новый ОтелHttpТранспорт("http://localhost:" + Порт, , , 1, "gzip", , "http/json")
        .УстановитьМаксРазмерЗапроса(100000);

    // Когда
    Результат = Транспорт.Отправить("/v1/gzip-traces", Данные);
    РезультатСЗапасом = ТранспортСЗапасом.Отправить("/v1/gzip-traces", Данные);

    // Тогда
    Ожидаем.Что(Результат, "размер до сжатия больше лимита").Равно(Ложь);
    Ожидаем.Что(РезультатСЗапасом, "размер до сжатия меньше лимита").Равно(Истина);

КонецПроцедуры

&Тест
Процедура ОтветБольшеМаксимальногоРазмераНеПринимается() Экспорт

    // Дано - адрес отвечает 200 с телом 2048 байт
    Данные = Новый Соответствие();
    Данные.Вставить("resourceSpans", Новый Массив());
    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + Порт, , , 1, , , "http/json")
        .УстановитьМаксРазмерОтвета(1024);
    ТранспортПоУмолчанию = Новый ОтелHttpТранспорт("http://localhost:" + Порт, , , 1, , , "http/json");

    // Когда
    Результат = Транспорт.Отправить("/big-response", Данные);
    РезультатПоУмолчанию = ТранспортПоУмолчанию.Отправить("/big-response", Данные);

    // Тогда
    Ожидаем.Что(Результат, "ответ больше лимита").Равно(Ложь);
    Ожидаем.Что(РезультатПоУмолчанию, "ответ меньше лимита по умолчанию").Равно(Истина);

КонецПроцедуры

// Сертификаты TLS (certificate, client key/certificate) HTTP-клиент OneScript не применяет:
// об этом предупреждение, а не молчаливое игнорирование
&Тест
Процедура СертификатыTlsНеПоддерживаютсяСПредупреждением() Экспорт

    // Дано
    НастройкиTls = Новый ОтелНастройкиTls();
    НастройкиTls.ФайлСертификата = "/etc/otel/ca.pem";
    Аппендер = НачатьЗахватЛога();

    // Когда
    Транспорт = Новый ОтелHttpТранспорт("https://localhost:1", , , , , НастройкиTls);

    // Тогда - предупреждение не утверждает проверку сертификата сервера: HTTP-клиент OneScript
    //   принимает по HTTPS любой сертификат
    ЗакончитьЗахватЛога(Аппендер);
    Ожидаем.Что(Транспорт.ПолучитьНастройкиTls()).Равно(НастройкиTls);
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "не поддерживаются"), "предупреждение").ЭтоИстина();
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "не проверяет сертификат сервера"), "без проверки сертификата")
        .ЭтоИстина();

КонецПроцедуры

Функция ДанныеСпанов()
    Данные = Новый Соответствие();
    Данные.Вставить("resourceSpans", Новый Массив());
    Возврат Данные;
КонецФункции

Функция СтрокаДлиной(Длина)
    Буквы = Новый Массив();
    Пока Буквы.Количество() < Длина Цикл
        Буквы.Добавить("a");
    КонецЦикла;
    Возврат СтрСоединить(Буквы);
КонецФункции

Функция НачатьЗахватЛога()
    Аппендер = СоздатьТестовыйАппендер();
    Логирование.ПолучитьЛог("oscript.lib.opentelemetry.transport")
        .ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);
    Возврат Аппендер;
КонецФункции

Процедура ЗакончитьЗахватЛога(Аппендер)
    Логирование.ПолучитьЛог("oscript.lib.opentelemetry.transport").УдалитьСпособВывода(Аппендер);
КонецПроцедуры

Функция СоздатьТестовыйАппендер()
    Текст = "Перем События Экспорт;
    |Процедура ВывестиСобытие(Событие) Экспорт
    |    События.Добавить(Событие);
    |КонецПроцедуры
    |Процедура Закрыть() Экспорт
    |КонецПроцедуры
    |Процедура УстановитьСвойство(Имя, Значение) Экспорт
    |КонецПроцедуры
    |События = Новый Массив();";
    Возврат ЗагрузитьСценарийИзСтроки(Текст);
КонецФункции

Функция ЕстьСообщениеСТекстом(Аппендер, Текст)
    Для Каждого Событие Из Аппендер.События Цикл
        Если СтрНайти(Событие.ПолучитьСообщение(), Текст) > 0 Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

// Закрытый транспорт не отправляет, как и gRPC-транспорт. Соединений между запросами
// HTTP-транспорт не держит, поэтому закрытие только запрещает отправку
&Тест
Процедура ЗакрытыйТранспортНеОтправляет() Экспорт

    // Дано - сервер принимает запросы
    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + Порт);
    Данные = Новый Соответствие();
    Данные.Вставить("resourceSpans", Новый Массив());

    // Когда - повторное закрытие без ошибки
    Транспорт.Закрыть();
    Транспорт.Закрыть();
    Результат = Транспорт.Отправить("/v1/traces", Данные);

    // Тогда
    Ожидаем.Что(Результат).Равно(Ложь);

КонецПроцедуры
