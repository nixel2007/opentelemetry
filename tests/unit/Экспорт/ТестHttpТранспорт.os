&Тест
Процедура ОтправитьСInsecureTls() Экспорт

    // OTLP Exporter / Insecure: опция относится только к gRPC - HTTP-транспорт с Insecure
    // отправляет как обычно
    НастройкиTls = Новый ОтелНастройкиTls();
    НастройкиTls.Insecure = Истина;

    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + Порт, , , , , НастройкиTls, "http/json");
    Данные = Новый Соответствие();
    Данные.Вставить("resourceSpans", Новый Массив());

    Результат = Транспорт.Отправить("/v1/traces", Данные);

    Ожидаем.Что(Результат).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ОтправитьСДвойнымСлешемВURL() Экспорт

    // Покрывает строку 156: устранение двойного слеша в URL (БазовыйURL оканчивается на "/")

    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + Порт + "/", , , , , , "http/json");
    Данные = Новый Соответствие();
    Данные.Вставить("resourceSpans", Новый Массив());

    // Путь начинается с "/" → итоговый URL содержал бы "//" → должен быть исправлен
    Результат = Транспорт.Отправить("/v1/traces", Данные);

    Ожидаем.Что(Результат).Равно(Истина);

КонецПроцедуры

// OTLP Exporter / Endpoint URLs for OTLP/HTTP: per-signal URL без пути получает корневой путь /,
// query остается после него
&Тест
Процедура PerSignalEndpointСQueryБезПутиПолучаетКорневойПуть() Экспорт

    // Дано - per-signal endpoint без пути, с query
    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.exporter.otlp.traces.endpoint", "http://localhost:" + Порт + "?token=1");
    Менеджер = Новый МенеджерПараметров();
    Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровСоответствие(Параметры));
    Менеджер.Прочитать();
    Результат = ОтелАвтоконфигурация.СоздатьТранспортДляСигнала(Менеджер, "traces");
    Данные = Новый Соответствие();
    Данные.Вставить("resourceSpans", Новый Массив());

    // Когда
    Отправлено = Результат.Транспорт.Отправить(Результат.ПутьСигнала, Данные);

    // Тогда - запрос ушел на /?token=1
    Ожидаем.Что(Отправлено).Равно(Истина);

КонецПроцедуры

