&Тест
Процедура КонструкторСТаймаутом() Экспорт

    // Дано / Когда
    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + Порт, , 5);

    // Тогда - объект создан, таймаут передается как задан
    Ожидаем.Что(Транспорт).Не_().Равно(Неопределено);
    Ожидаем.Что(Транспорт.Таймаут()).Равно(5);

КонецПроцедуры

// Common configuration / Timeout: 0 - без ограничения. 1connector считает 0 незаданным
// и ограничивает запрос 30 с, поэтому транспорт передает очень большой срок
&Тест
Процедура НулевойТаймаутБезОграничения() Экспорт

    // Дано / Когда
    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + Порт, , 0);

    // Тогда - 2^31-1 мс в секундах
    Ожидаем.Что(Транспорт.Таймаут()).Равно(2147483);

КонецПроцедуры

&Тест
Процедура ОтправитьСGzipСжатием() Экспорт

    // Дано - транспорт с gzip-компрессией
