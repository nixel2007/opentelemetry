// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать "../../.."
#Использовать asserts

Перем МокСервер;
Перем Порт;
Перем ЗависшийСервер;
Перем ПортЗависшегоСервера;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура ПередВсемиТестами() Экспорт
    Порт = 14318 + Цел(ТекущаяУниверсальнаяДата() - Дата(2025, 1, 1)) % 100;
    КаталогПроекта = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "..");
    ПутьСкрипта = ОбъединитьПути(КаталогПроекта, "tests", "helpers", "mock_otlp_server.py");
    МокСервер = СоздатьПроцесс("python3 " + ПутьСкрипта + " " + Порт, , Истина);
    МокСервер.Запустить();
    // Сервер принимает соединение и не отвечает
    ПортЗависшегоСервера = Порт + 500;
    ПутьЗависшегоСервера = ОбъединитьПути(КаталогПроекта, "tests", "helpers", "mock_hanging_tcp_server.py");
    ЗависшийСервер = СоздатьПроцесс("python3 " + ПутьЗависшегоСервера + " " + ПортЗависшегоСервера, , Истина);
    ЗависшийСервер.Запустить();
    Приостановить(1000);
КонецПроцедуры

&ПослеВсех
Процедура ПослеВсехТестов() Экспорт
    Если МокСервер <> Неопределено Тогда
        МокСервер.Завершить();
    КонецЕсли;
    Если ЗависшийСервер <> Неопределено Тогда
        ЗависшийСервер.Завершить();
    КонецЕсли;
КонецПроцедуры

&Тест
Процедура ОтправитьУспешно() Экспорт

    // Дано
    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + Порт);
    Данные = Новый Соответствие();
    Данные.Вставить("resourceSpans", Новый Массив());

    // Когда
    Результат = Транспорт.Отправить("/v1/traces", Данные);

    // Тогда
    Ожидаем.Что(Результат).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ОтправитьОшибкаСервера() Экспорт

    // Дано - адрес возвращает 500 (не retryable)
    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + Порт, , , 1);
    Данные = Новый Соответствие();

    // Когда
    Результат = Транспорт.Отправить("/error", Данные);

    // Тогда
    Ожидаем.Что(Результат).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ОтправитьСлишкомМногоЗапросовОднаПопытка() Экспорт

    // Дано - 429 с одной попыткой = не retryable (НомерПопытки = МаксПопыток)
    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + Порт, , , 1);
    Данные = Новый Соответствие();

    // Когда
    Результат = Транспорт.Отправить("/too-many", Данные);

    // Тогда - не retryable при одной попытке (53-54: лог + Ложь)
    Ожидаем.Что(Результат).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ОтправитьRetryИсчерпаныПопытки() Экспорт

    // Дано - 429 с двумя попытками: первая retry, вторая тоже 429 -> все попытки исчерпаны
    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + Порт, , , 2);
    Данные = Новый Соответствие();

    // Когда
    Результат = Транспорт.Отправить("/too-many", Данные);

    // Тогда - исчерпаны попытки (строка 57: Возврат Ложь)
    Ожидаем.Что(Результат).Равно(Ложь);

КонецПроцедуры

// Таймаут попытки не больше времени, оставшегося до срока отправки
&Тест
Процедура ТаймаутЗапросаОграниченСрокомОтправки() Экспорт

    // Дано - сервер принимает соединение и не отвечает; таймаут запроса 10 с, одна попытка
    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + ПортЗависшегоСервера, , 10, 1);
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

    // Когда
    Результат = Транспорт.Отправить("/v1/traces", ДанныеСпанов(), 2000);

    // Тогда
    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
    Ожидаем.Что(Результат).Равно(Ложь);
    Ожидаем.Что(ДлительностьМс < 4000, ДлительностьМс).ЭтоИстина();

КонецПроцедуры

// Повторы и паузы между ними не выходят за срок отправки
&Тест
Процедура ПовторыОграниченыСрокомОтправки() Экспорт

    // Дано - сервер всегда отвечает 429; до 10 попыток с экспоненциальной паузой от 1 с
    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + Порт, , 10, 10);
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

    // Когда
    Результат = Транспорт.Отправить("/too-many", ДанныеСпанов(), 2500);

    // Тогда - без срока 10 попыток заняли бы больше 8 минут
    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
    Ожидаем.Что(Результат).Равно(Ложь);
    Ожидаем.Что(ДлительностьМс < 4000, ДлительностьМс).ЭтоИстина();

КонецПроцедуры

// Retry-After дольше времени до срока: повторить в срок нельзя, отправка прекращается сразу
&Тест
Процедура RetryAfterДольшеСрокаПрекращаетОтправкуСразу() Экспорт

    // Дано - сервер отвечает 429 с Retry-After: 5, до срока 1,5 с
    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + Порт, , 10, 3);
    Аппендер = НачатьЗахватЛога();
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

    // Когда
    Результат = Транспорт.Отправить("/retry-after/5", ДанныеСпанов(), 1500);

    // Тогда - отправка не ждет срока
    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
    ЗакончитьЗахватЛога(Аппендер);
    Ожидаем.Что(Результат).Равно(Ложь);
    Ожидаем.Что(ДлительностьМс < 1000, ДлительностьМс).ЭтоИстина();
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "(Retry-After)"), "причина в логе").ЭтоИстина();

КонецПроцедуры

// Retry-After - число секунд или дата HTTP в любом из трех форматов RFC 7231 (7.1.1.1)
&ПараметризованныйТест
&ИсточникЗначение("imf")
&ИсточникЗначение("rfc850")
&ИсточникЗначение("asctime")
Процедура RetryAfterДатойДольшеСрокаПрекращаетОтправкуСразу(Формат) Экспорт

    // Дано - сервер отвечает 429 с Retry-After: дата через минуту, до срока 5 с
    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + Порт, , 10, 3);
    Аппендер = НачатьЗахватЛога();
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

    // Когда
    Результат = Транспорт.Отправить("/retry-after-date/" + Формат + "/60", ДанныеСпанов(), 5000);

    // Тогда
    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
    ЗакончитьЗахватЛога(Аппендер);
    Ожидаем.Что(Результат).Равно(Ложь);
    Ожидаем.Что(ДлительностьМс < 1000, ДлительностьМс).ЭтоИстина();
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "(Retry-After)"), "причина в логе").ЭтоИстина();

КонецПроцедуры

// OTLP/HTTP Throttling: The client SHOULD honour the value specified in the "Retry-After" header
&ПараметризованныйТест
&ИсточникЗначение("/retry-after/3|0")
&ИсточникЗначение("/retry-after-date/imf/4|10000")
Процедура RetryAfterДоСрокаСоблюдается(Случай) Экспорт

    // Дано - сервер отвечает 429 с Retry-After: 3 с или датой через 4 с (с точностью до секунды);
    //   две попытки, срок не ограничен или 10 с
    Части = СтрРазделить(Случай, "|");
    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + Порт, , 10, 2);
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

    // Когда
    Результат = Транспорт.Отправить(Части[0], ДанныеСпанов(), Число(Части[1]));

    // Тогда - вторая попытка не раньше Retry-After; без Retry-After пауза около 1 с
    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
    Ожидаем.Что(Результат).Равно(Ложь);
    Ожидаем.Что(ДлительностьМс >= 2500 И ДлительностьМс < 6000, ДлительностьМс).ЭтоИстина();

КонецПроцедуры

// RFC 7231 (7.1.1.1): двузначный год RFC 850 больше чем на 50 лет вперед - это прошлый век
&Тест
Процедура RetryAfterRfc850БольшеЧем50ЛетВпередиОтноситсяКПрошлому() Экспорт

    // Дано - Retry-After: дата через 60 лет в формате RFC 850, то есть та же дата 40 лет назад
    Транспорт = Новый ОтелHttpТранспорт("http://localhost:" + Порт, , 10, 2);
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

    // Когда
    Результат = Транспорт.Отправить("/retry-after-date/rfc850/1893456000", ДанныеСпанов(), 5000);

    // Тогда - прошедшая дата не задерживает повтор: обычная пауза перед второй попыткой
    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
    Ожидаем.Что(Результат).Равно(Ложь);
    Ожидаем.Что(ДлительностьМс >= 700, ДлительностьМс).ЭтоИстина();

КонецПроцедуры

