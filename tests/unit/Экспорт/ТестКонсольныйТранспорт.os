// ============================================================
// ОтелКонсольныйТранспорт - вывод данных OTLP JSON в стандартный вывод (экспортер console)
// ============================================================

&Тест
Процедура ОтправкаВыводитСтрокуOtlpJson() Экспорт

	// Дано - сценарий отправляет данные спанов в консольный транспорт
	ТелоСценария =
	"Данные = Новый Соответствие;
	|Данные.Вставить(""resourceSpans"", Новый Массив);
	|Данные.Вставить(""имя"", ""значение"");
	|Транспорт = Новый ОтелКонсольныйТранспорт();
	|Сообщить(""отправлено="" + ?(Транспорт.Отправить(""/v1/traces"", Данные), ""да"", ""нет""));";

	// Когда
	Строки = СтрокиВыводаСценария(ТелоСценария);

	// Тогда - одна строка JSON на отправку
	Ожидаем.Что(Строки).ИмеетДлину(2);
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Строки[0]);
	Прочитанные = ПрочитатьJSON(Чтение, Истина);
	Ожидаем.Что(Прочитанные.Получить("имя")).Равно("значение");
	Ожидаем.Что(Прочитанные.Получить("resourceSpans")).ИмеетДлину(0);
	Ожидаем.Что(Строки[1]).Равно("отправлено=да");

КонецПроцедуры

&Тест
Процедура ПослеЗакрытияНичегоНеВыводит() Экспорт

	// Дано
	ТелоСценария =
	"Транспорт = Новый ОтелКонсольныйТранспорт();
	|Транспорт.Закрыть();
	|Сообщить(""отправлено="" + ?(Транспорт.Отправить(""/v1/logs"", Новый Соответствие), ""да"", ""нет""));";

	// Когда
	Строки = СтрокиВыводаСценария(ТелоСценария);

	// Тогда
	Ожидаем.Что(Строки).ИмеетДлину(1);
	Ожидаем.Что(Строки[0]).Равно("отправлено=нет");

КонецПроцедуры

&Тест
Процедура ЭкспортерСпановСКонсольнымТранспортом() Экспорт

	// Дано - простой процессор с экспортером спанов OTLP и консольным транспортом
	ТелоСценария =
	"Экспортер = Новый ОтелЭкспортерСпанов(Новый ОтелКонсольныйТранспорт());
	|Провайдер = Новый ОтелПостроительПровайдераТрассировки()
	|	.ДобавитьПроцессор(Новый ОтелПростойПроцессорСпанов(Экспортер))
	|	.Построить();
	|Провайдер.ПолучитьТрассировщик(""console-test"").НачатьСпан(""операция"").Завершить();
	|Провайдер.Закрыть();";

	// Когда
	Строки = СтрокиВыводаСценария(ТелоСценария);

	// Тогда - спан выведен строкой OTLP JSON
	Ожидаем.Что(Строки).ИмеетДлину(1);
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Строки[0]);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Спан = Данные["resourceSpans"][0]["scopeSpans"][0]["spans"][0];
	Ожидаем.Что(Спан["name"]).Равно("операция");

КонецПроцедуры

#Область Служебные

// Запускает сценарий в отдельном процессе oscript и возвращает непустые строки его стандартного вывода.
Функция СтрокиВыводаСценария(ТелоСценария)

	КорневойКаталог = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "..")).ПолноеИмя;
	Каталог = ОбъединитьПути(КаталогВременныхФайлов(), "otel-console-transport-test");
	СоздатьКаталог(Каталог);
	ЗаписьКонфига = Новый ЗаписьТекста(ОбъединитьПути(Каталог, "oscript.cfg"), КодировкаТекста.UTF8NoBOM);
	ЗаписьКонфига.ЗаписатьСтроку("lib.additional=" + ОбъединитьПути(КорневойКаталог, "oscript_modules"));
	ЗаписьКонфига.Закрыть();
	ПутьСценария = ОбъединитьПути(Каталог, "scenario.os");
	ЗаписьСценария = Новый ЗаписьТекста(ПутьСценария, КодировкаТекста.UTF8);
	ЗаписьСценария.ЗаписатьСтроку("#Использовать """ + КорневойКаталог + """");
	ЗаписьСценария.ЗаписатьСтроку(ТелоСценария);
	ЗаписьСценария.Закрыть();

	Процесс = СоздатьПроцесс("oscript " + ПутьСценария, Каталог, Истина, Истина, КодировкаТекста.UTF8);
	Процесс.Запустить();
	Вывод = "";
	Пока НЕ Процесс.Завершен Цикл
		Вывод = Вывод + Процесс.ПотокВывода.Прочитать();
		Приостановить(50);
	КонецЦикла;
	Вывод = Вывод + Процесс.ПотокВывода.Прочитать();
	УдалитьФайлы(Каталог);

	Строки = Новый Массив;
	Для Каждого Строка Из СтрРазделить(Вывод, Символы.ПС, Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Строка)) Тогда
			Строки.Добавить(СокрЛП(Строка));
		КонецЕсли;
	КонецЦикла;
	Возврат Строки;

КонецФункции

#КонецОбласти
