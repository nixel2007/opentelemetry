&Тест
Процедура ПолучитьДвоичныеДанные_ДозаписьПослеПолучения() Экспорт
    // Дано
    Писатель = Новый ОтелПротоПисатель();
    Писатель.ЗаписатьUInt64Varint(1);
    Ожидаем.Что(БайтыСтрокой(Писатель)).Равно("1");

    // Когда - запись продолжается после получения данных
    Писатель.ЗаписатьUInt64Varint(2);

    // Тогда - данные содержат обе записи
    Ожидаем.Что(БайтыСтрокой(Писатель)).Равно("1,2");
КонецПроцедуры

&Тест
Процедура НачатьВложенное_СовпадаетСLengthDelimited() Экспорт
    // Дано
    Писатель = Новый ОтелПротоПисатель();

    // Когда - поле 2: вложенное сообщение с полем 1 varint 150
    Писатель.НачатьВложенное(2);
    Писатель.ЗаписатьТег(1, 0).ЗаписатьUInt64Varint(150);
    Писатель.ЗавершитьВложенное();

    // Тогда
    Ожидаем.Что(БайтыСтрокой(Писатель)).Равно("18,3,8,150,1");
КонецПроцедуры

&Тест
Процедура НачатьВложенное_ДваУровня() Экспорт
    // Дано
    Писатель = Новый ОтелПротоПисатель();
    Писатель.ЗаписатьТег(3, 0).ЗаписатьUInt64Varint(7);

    // Когда - поле 1 { поле 2 { поле 1 = "a" } поле 3 = 1 }
    Писатель.НачатьВложенное(1);
    Писатель.НачатьВложенное(2);
    Писатель.ЗаписатьТег(1, 2).ЗаписатьСтроку("a");
    Писатель.ЗавершитьВложенное();
    Писатель.ЗаписатьТег(3, 0).ЗаписатьUInt64Varint(1);
    Писатель.ЗавершитьВложенное();

    // Тогда
    Ожидаем.Что(БайтыСтрокой(Писатель)).Равно("24,7,10,7,18,3,10,1,97,24,1");
КонецПроцедуры

