&Тест
Процедура ЗаписатьSInt64Varint_ZigZag() Экспорт
    // Протокол buffers: sint32/sint64 кодируются zigzag - 0 -> 0, -1 -> 1, 1 -> 2, -2 -> 3
    Ожидаем.Что(БайтыSInt64Varint(0)).Равно("0");
    Ожидаем.Что(БайтыSInt64Varint(-1)).Равно("1");
    Ожидаем.Что(БайтыSInt64Varint(1)).Равно("2");
    Ожидаем.Что(БайтыSInt64Varint(-2)).Равно("3");
    Ожидаем.Что(БайтыSInt64Varint(2147483647)).Равно("254,255,255,255,15");
    Ожидаем.Что(БайтыSInt64Varint(-2147483648)).Равно("255,255,255,255,15");
КонецПроцедуры

Функция БайтыSInt64Varint(Значение)
    Писатель = Новый ОтелПротоПисатель();
    Писатель.ЗаписатьSInt64Varint(Значение);
    Байты = Новый Массив();
    Для Каждого Байт Из ДвоичныеДанныеВМассивБайт(Писатель.ПолучитьДвоичныеДанные()) Цикл
        Байты.Добавить(Формат(Байт, "ЧН=0; ЧГ="));
    КонецЦикла;
    Возврат СтрСоединить(Байты, ",");
КонецФункции

