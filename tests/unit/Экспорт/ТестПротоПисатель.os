&Тест
Процедура ЗаписатьLengthDelimited_ВложенноеСообщение() Экспорт
    // Дано - вложенное сообщение: поле 1 varint 150 (08 96 01)
    Вложенный = Новый ОтелПротоПисатель();
    Вложенный.ЗаписатьТег(1, 0).ЗаписатьUInt64Varint(150);

    // Когда - поле 2 length-delimited с вложенным сообщением
    Писатель = Новый ОтелПротоПисатель();
    Писатель.ЗаписатьТег(2, 2).ЗаписатьLengthDelimited(Вложенный.ПолучитьДвоичныеДанные());

    // Тогда
    Ожидаем.Что(БайтыСтрокой(Писатель)).Равно("18,3,8,150,1");
КонецПроцедуры

