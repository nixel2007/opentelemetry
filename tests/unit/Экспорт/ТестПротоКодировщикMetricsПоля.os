// Поля метрик в protobuf-кодировке OTLP: закодированные байты разбираются эталонным декодером
// (tests/helpers/proto_decoder.py)

&Тест
Процедура ПоляСводка_КвантилиСуммаКоличество() Экспорт

    // Дано
    Метрика = НоваяМетрика("rpc.duration");
    Метрика.Вставить("summary", СводкаOtlp());

    // Когда
    Байты = ОтелПротоКодировщикMetrics.ЗакодироватьMetricsData(УпаковатьМетрику(Метрика));
    Декодированные = ДекодироватьПротоБайты(Байты);

    // Тогда
    Точка = ПерваяМетрика(Декодированные)["summary"]["data_points"][0];
    Ожидаем.Что(Точка["start_time_unix_nano"]).Равно("1700000000000000000");
    Ожидаем.Что(Точка["time_unix_nano"]).Равно("1700000060000000000");
    Ожидаем.Что(Точка["count"]).Равно("12");
    Ожидаем.Что(Точка["sum"]).Равно(5.5);
    Ожидаем.Что(Точка["quantile_values"]).ИмеетДлину(2);
    Ожидаем.Что(Точка["quantile_values"][1]["quantile"]).Равно(0.99);
    Ожидаем.Что(Точка["quantile_values"][1]["value"]).Равно(0.9);
    Ожидаем.Что(Точка["attributes"][0]["key"]).Равно("rpc.method");

КонецПроцедуры

&Тест
Процедура ПоляМетрика_Метаданные() Экспорт

    // Дано - метаданные метрики (metric.metadata, поле 12)
    Значение = Новый Соответствие();
    Значение.Вставить("stringValue", "unknown");
    Элемент = Новый Соответствие();
    Элемент.Вставить("key", "prometheus.type");
    Элемент.Вставить("value", Значение);
    Метаданные = Новый Массив();
    Метаданные.Добавить(Элемент);
    Метрика = НоваяМетрика("build");
    Метрика.Вставить("summary", СводкаOtlp());
    Метрика.Вставить("metadata", Метаданные);

    // Когда
    Байты = ОтелПротоКодировщикMetrics.ЗакодироватьMetricsData(УпаковатьМетрику(Метрика));
    Декодированные = ДекодироватьПротоБайты(Байты);

    // Тогда
    МетаданныеProto = ПерваяМетрика(Декодированные)["metadata"];
    Ожидаем.Что(МетаданныеProto).ИмеетДлину(1);
    Ожидаем.Что(МетаданныеProto[0]["key"]).Равно("prometheus.type");
    Ожидаем.Что(МетаданныеProto[0]["value"]["string_value"]).Равно("unknown");

КонецПроцедуры

Функция НоваяМетрика(Имя)
    Метрика = Новый Соответствие();
    Метрика.Вставить("name", Имя);
    Метрика.Вставить("unit", "s");
    Возврат Метрика;
КонецФункции

Функция СводкаOtlp()
    Квантили = Новый Массив();
    Для Каждого Пара Из СтрРазделить("0.5:0.2,0.99:0.9", ",") Цикл
        Части = СтрРазделить(Пара, ":");
        Квантиль = Новый Соответствие();
        Квантиль.Вставить("quantile", Число(Части[0]));
        Квантиль.Вставить("value", Число(Части[1]));
        Квантили.Добавить(Квантиль);
    КонецЦикла;
    ЗначениеАтрибута = Новый Соответствие();
    ЗначениеАтрибута.Вставить("stringValue", "Get");
    Атрибут = Новый Соответствие();
    Атрибут.Вставить("key", "rpc.method");
    Атрибут.Вставить("value", ЗначениеАтрибута);
    Атрибуты = Новый Массив();
    Атрибуты.Добавить(Атрибут);
    Точка = Новый Соответствие();
    Точка.Вставить("attributes", Атрибуты);
    Точка.Вставить("startTimeUnixNano", "1700000000000000000");
    Точка.Вставить("timeUnixNano", "1700000060000000000");
    Точка.Вставить("count", "12");
    Точка.Вставить("sum", 5.5);
    Точка.Вставить("quantileValues", Квантили);
    Точки = Новый Массив();
    Точки.Добавить(Точка);
    Сводка = Новый Соответствие();
    Сводка.Вставить("dataPoints", Точки);
    Возврат Сводка;
КонецФункции

Функция УпаковатьМетрику(Метрика)
    Метрики = Новый Массив();
    Метрики.Добавить(Метрика);
    ОбластьМетрик = Новый Соответствие();
    ОбластьМетрик.Вставить("scope", Новый Соответствие());
    ОбластьМетрик.Вставить("metrics", Метрики);
    Области = Новый Массив();
    Области.Добавить(ОбластьМетрик);
    Ресурс = Новый Соответствие();
    Ресурс.Вставить("attributes", Новый Массив());
    РесурсныеМетрики = Новый Соответствие();
    РесурсныеМетрики.Вставить("resource", Ресурс);
    РесурсныеМетрики.Вставить("scopeMetrics", Области);
    Ресурсные = Новый Массив();
    Ресурсные.Добавить(РесурсныеМетрики);
    Данные = Новый Соответствие();
    Данные.Вставить("resourceMetrics", Ресурсные);
    Возврат Данные;
КонецФункции

Функция ПерваяМетрика(Декодированные)
    Возврат Декодированные["resource_metrics"][0]["scope_metrics"][0]["metrics"][0];
КонецФункции

Функция ДекодироватьПротоБайты(Байты)
    ВременныйФайл = ПолучитьИмяВременногоФайла("bin");
    Запись = Новый ЗаписьДанных(ВременныйФайл);
    Запись.Записать(Байты);
    Запись.Закрыть();

    КаталогПомощников = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "helpers");
    ПутьДекодера = ОбъединитьПути(КаталогПомощников, "proto_decoder.py");
    Процесс = СоздатьПроцесс("python3 " + ПутьДекодера + " metrics " + ВременныйФайл, , Истина, Истина);
    Процесс.Запустить();
    Пока НЕ Процесс.Завершен Цикл
        Приостановить(50);
    КонецЦикла;
    Вывод = "";
    Пока Процесс.ПотокВывода.ЕстьДанные Цикл
        Вывод = Вывод + Процесс.ПотокВывода.Прочитать();
    КонецЦикла;
    УдалитьФайлы(ВременныйФайл);

    Если Процесс.КодВозврата <> 0 Тогда
        ОшибкаДекодера = "";
        Пока Процесс.ПотокОшибок.ЕстьДанные Цикл
            ОшибкаДекодера = ОшибкаДекодера + Процесс.ПотокОшибок.Прочитать();
        КонецЦикла;
        ВызватьИсключение "proto_decoder.py завершился с кодом " + Процесс.КодВозврата + ": " + ОшибкаДекодера;
    КонецЕсли;

    Чтение = Новый ЧтениеJSON();
    Чтение.УстановитьСтроку(Вывод);
    Возврат ПрочитатьJSON(Чтение);
КонецФункции
