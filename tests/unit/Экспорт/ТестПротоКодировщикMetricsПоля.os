&Тест
Процедура ПоляHistogram_ОсновныеПоля() Экспорт
    СчетчикиБакетов = Новый Массив();
    СчетчикиБакетов.Добавить("5");
    СчетчикиБакетов.Добавить("10");
    СчетчикиБакетов.Добавить("3");
    ЯвныеГраницы = Новый Массив();
    ЯвныеГраницы.Добавить(10);
    ЯвныеГраницы.Добавить(100);
    ТочкаДанных = Новый Соответствие();
    ТочкаДанных.Вставить("startTimeUnixNano", "1000000000000000001");
    ТочкаДанных.Вставить("timeUnixNano", "2000000000000000001");
    ТочкаДанных.Вставить("count", "18");
    ТочкаДанных.Вставить("sum", 1234.5);
    ТочкаДанных.Вставить("min", 1.0);
    ТочкаДанных.Вставить("max", 500.0);
    ТочкаДанных.Вставить("bucketCounts", СчетчикиБакетов);
    ТочкаДанных.Вставить("explicitBounds", ЯвныеГраницы);
    ТочкаДанных.Вставить("attributes", Новый Массив());
    МассивТочек = Новый Массив();
    МассивТочек.Добавить(ТочкаДанных);
    Гистограмма = Новый Соответствие();
    Гистограмма.Вставить("dataPoints", МассивТочек);
    Гистограмма.Вставить("aggregationTemporality", 2);
    Метрика = Новый Соответствие();
    Метрика.Вставить("name", "request.duration");
    Метрика.Вставить("unit", "ms");
    Метрика.Вставить("histogram", Гистограмма);

    Результат = ОтелПротоКодировщикMetrics.ЗакодироватьMetricsData(УпаковатьВСтруктуруМетрик(Метрика));
    Декодировано = ДекодироватьПротоБайты(Результат);

    М = ПолучитьПервуюМетрику(Декодировано);
    ТочкаД = М["histogram"]["data_points"][0];

    // count как строка (uint64)
    Ожидаем.Что(ТочкаД["count"]).Равно("18");
    // sum как число
    Ожидаем.Что(ТочкаД["sum"]).Равно(1234.5);
    // min/max
    Ожидаем.Что(ТочкаД["min"]).Равно(1.0);
    Ожидаем.Что(ТочкаД["max"]).Равно(500.0);
    // Временны́е метки
    Ожидаем.Что(ТочкаД["start_time_unix_nano"]).Равно("1000000000000000001");
    Ожидаем.Что(ТочкаД["time_unix_nano"]).Равно("2000000000000000001");
    // bucketCounts как строки
    Ожидаем.Что(ТочкаД["bucket_counts"][0]).Равно("5");
    Ожидаем.Что(ТочкаД["bucket_counts"][1]).Равно("10");
    Ожидаем.Что(ТочкаД["bucket_counts"][2]).Равно("3");
    // explicitBounds
    Ожидаем.Что(ТочкаД["explicit_bounds"][0]).Равно(10.0);
    Ожидаем.Что(ТочкаД["explicit_bounds"][1]).Равно(100.0);
    // BSLLS:CommentedCode-off
    // aggregationTemporality = CUMULATIVE
    // BSLLS:CommentedCode-on
    Ожидаем.Что(М["histogram"]["aggregation_temporality"]).Равно("AGGREGATION_TEMPORALITY_CUMULATIVE");
КонецПроцедуры

&Тест
Процедура ПоляExponentialHistogram_ВсеПоляТочки() Экспорт
    Экземпляр = Новый Соответствие();
    Экземпляр.Вставить("timeUnixNano", "1500000000000000000");
    Экземпляр.Вставить("asDouble", 4.5);
    Экземпляры = Новый Массив();
    Экземпляры.Добавить(Экземпляр);
    Атрибуты = Новый Массив();
    Атрибуты.Добавить(СоздатьАтрибутСтроку("http.route", "/api"));
    ТочкаДанных = Новый Соответствие();
    ТочкаДанных.Вставить("startTimeUnixNano", "1000000000000000001");
    ТочкаДанных.Вставить("timeUnixNano", "2000000000000000001");
    ТочкаДанных.Вставить("count", "7");
    ТочкаДанных.Вставить("sum", 12.5);
    ТочкаДанных.Вставить("min", -2.0);
    ТочкаДанных.Вставить("max", 6.0);
    ТочкаДанных.Вставить("scale", -2);
    ТочкаДанных.Вставить("zeroCount", "1");
    ТочкаДанных.Вставить("zeroThreshold", 0.001);
    ТочкаДанных.Вставить("positive", БакетыЭкспоненциальнойГистограммы(-3, "1,0,2"));
    ТочкаДанных.Вставить("negative", БакетыЭкспоненциальнойГистограммы(2, "3"));
    ТочкаДанных.Вставить("attributes", Атрибуты);
    ТочкаДанных.Вставить("exemplars", Экземпляры);
    МассивТочек = Новый Массив();
    МассивТочек.Добавить(ТочкаДанных);
    ЭкспГистограмма = Новый Соответствие();
    ЭкспГистограмма.Вставить("dataPoints", МассивТочек);
    ЭкспГистограмма.Вставить("aggregationTemporality", 1);
    Метрика = Новый Соответствие();
    Метрика.Вставить("name", "request.latency");
    Метрика.Вставить("unit", "ms");
    Метрика.Вставить("exponentialHistogram", ЭкспГистограмма);

    Результат = ОтелПротоКодировщикMetrics.ЗакодироватьMetricsData(УпаковатьВСтруктуруМетрик(Метрика));
    Декодировано = ДекодироватьПротоБайты(Результат);

    М = ПолучитьПервуюМетрику(Декодировано);
    Ожидаем.Что(М["name"]).Равно("request.latency");
    Ожидаем.Что(М["exponential_histogram"]["aggregation_temporality"]).Равно("AGGREGATION_TEMPORALITY_DELTA");
    Точка = М["exponential_histogram"]["data_points"][0];
    Ожидаем.Что(Точка["start_time_unix_nano"]).Равно("1000000000000000001");
    Ожидаем.Что(Точка["time_unix_nano"]).Равно("2000000000000000001");
    Ожидаем.Что(Точка["count"]).Равно("7");
    Ожидаем.Что(Точка["sum"]).Равно(12.5);
    Ожидаем.Что(Точка["min"]).Равно(-2.0);
    Ожидаем.Что(Точка["max"]).Равно(6.0);
    Ожидаем.Что(Точка["scale"]).Равно(-2);
    Ожидаем.Что(Точка["zero_count"]).Равно("1");
    Ожидаем.Что(Точка["zero_threshold"]).Равно(0.001);
    Ожидаем.Что(Точка["positive"]["offset"]).Равно(-3);
    Ожидаем.Что(Точка["positive"]["bucket_counts"]).ИмеетДлину(3);
    Ожидаем.Что(Точка["positive"]["bucket_counts"][0]).Равно("1");
    Ожидаем.Что(Точка["positive"]["bucket_counts"][1]).Равно("0");
    Ожидаем.Что(Точка["positive"]["bucket_counts"][2]).Равно("2");
    Ожидаем.Что(Точка["negative"]["offset"]).Равно(2);
    Ожидаем.Что(Точка["negative"]["bucket_counts"]).ИмеетДлину(1);
    Ожидаем.Что(Точка["negative"]["bucket_counts"][0]).Равно("3");
    Ожидаем.Что(Точка["attributes"][0]["key"]).Равно("http.route");
    Ожидаем.Что(Точка["exemplars"][0]["as_double"]).Равно(4.5);
КонецПроцедуры

&Тест
Процедура ПоляExponentialHistogram_БольшиеЗначенияScaleИСмещения() Экспорт
    // sint32 кодируется zigzag: проверяем границы диапазона scale и смещений
    ТочкаДанных = Новый Соответствие();
    ТочкаДанных.Вставить("count", "0");
    ТочкаДанных.Вставить("scale", 20);
    ТочкаДанных.Вставить("zeroCount", "0");
    ТочкаДанных.Вставить("positive", БакетыЭкспоненциальнойГистограммы(-2147483648, "5"));
    ТочкаДанных.Вставить("negative", БакетыЭкспоненциальнойГистограммы(2147483647, "6"));
    ТочкаДанных.Вставить("attributes", Новый Массив());
    МассивТочек = Новый Массив();
    МассивТочек.Добавить(ТочкаДанных);
    ЭкспГистограмма = Новый Соответствие();
    ЭкспГистограмма.Вставить("dataPoints", МассивТочек);
    ЭкспГистограмма.Вставить("aggregationTemporality", 2);
    Метрика = Новый Соответствие();
    Метрика.Вставить("name", "edge");
    Метрика.Вставить("exponentialHistogram", ЭкспГистограмма);

    Результат = ОтелПротоКодировщикMetrics.ЗакодироватьMetricsData(УпаковатьВСтруктуруМетрик(Метрика));
    Декодировано = ДекодироватьПротоБайты(Результат);

    Точка = ПолучитьПервуюМетрику(Декодировано)["exponential_histogram"]["data_points"][0];
    Ожидаем.Что(Точка["scale"]).Равно(20);
    Ожидаем.Что(Точка["positive"]["offset"]).Равно(-2147483648);
    Ожидаем.Что(Точка["positive"]["bucket_counts"][0]).Равно("5");
    Ожидаем.Что(Точка["negative"]["offset"]).Равно(2147483647);
    Ожидаем.Что(Точка["negative"]["bucket_counts"][0]).Равно("6");
КонецПроцедуры

Функция БакетыЭкспоненциальнойГистограммы(Смещение, СчетчикиЧерезЗапятую)
    Счетчики = Новый Массив();
    Для Каждого Счетчик Из СтрРазделить(СчетчикиЧерезЗапятую, ",") Цикл
        Счетчики.Добавить(Счетчик);
    КонецЦикла;
    Бакеты = Новый Соответствие();
    Бакеты.Вставить("offset", Смещение);
    Бакеты.Вставить("bucketCounts", Счетчики);
    Возврат Бакеты;
КонецФункции

&Тест
Процедура ПоляScope_ИмяВерсия() Экспорт
    // Проверяем scope.name и scope.version в scopeMetrics
    ТочкаДанных = Новый Соответствие();
    ТочкаДанных.Вставить("timeUnixNano", 1000000000);
    ТочкаДанных.Вставить("asInt", "1");
    ТочкаДанных.Вставить("attributes", Новый Массив());
    МассивТочек = Новый Массив();
    МассивТочек.Добавить(ТочкаДанных);
    Сумма = Новый Соответствие();
    Сумма.Вставить("dataPoints", МассивТочек);
    Сумма.Вставить("aggregationTemporality", 2);
    Сумма.Вставить("isMonotonic", Истина);
    Метрика = Новый Соответствие();
    Метрика.Вставить("name", "counter");
    Метрика.Вставить("sum", Сумма);
    МассивМетрик = Новый Массив();
    МассивМетрик.Добавить(Метрика);
    Скоп = Новый Соответствие();
    Скоп.Вставить("name", "my.instrumentation");
    Скоп.Вставить("version", "2.0.0");
    ОбластьМетрик = Новый Соответствие();
    ОбластьМетрик.Вставить("scope", Скоп);
    ОбластьМетрик.Вставить("metrics", МассивМетрик);
    МассивОбластей = Новый Массив();
    МассивОбластей.Добавить(ОбластьМетрик);
    Ресурс = Новый Соответствие();
    Ресурс.Вставить("attributes", Новый Массив());
    РесурснаяМетрика = Новый Соответствие();
    РесурснаяМетрика.Вставить("resource", Ресурс);
    РесурснаяМетрика.Вставить("scopeMetrics", МассивОбластей);
    МассивРесурсных = Новый Массив();
    МассивРесурсных.Добавить(РесурснаяМетрика);
    Данные = Новый Соответствие();
    Данные.Вставить("resourceMetrics", МассивРесурсных);

    Результат = ОтелПротоКодировщикMetrics.ЗакодироватьMetricsData(Данные);
    Декодировано = ДекодироватьПротоБайты(Результат);

    Скоп2 = Декодировано["resource_metrics"][0]["scope_metrics"][0]["scope"];
    Ожидаем.Что(Скоп2["name"]).Равно("my.instrumentation");
    Ожидаем.Что(Скоп2["version"]).Равно("2.0.0");
КонецПроцедуры

// --- Тесты Summary и метаданных метрики ---

&Тест
Процедура ПоляSummary_КвантилиСуммаКоличество() Экспорт
    Метрика = Новый Соответствие();
    Метрика.Вставить("name", "rpc.duration");
    Метрика.Вставить("unit", "s");
    Метрика.Вставить("summary", СводкаOtlp());

    Результат = ОтелПротоКодировщикMetrics.ЗакодироватьMetricsData(УпаковатьВСтруктуруМетрик(Метрика));
    Декодировано = ДекодироватьПротоБайты(Результат);

    Точка = ПолучитьПервуюМетрику(Декодировано)["summary"]["data_points"][0];
    Ожидаем.Что(Точка["start_time_unix_nano"]).Равно("1700000000000000000");
    Ожидаем.Что(Точка["time_unix_nano"]).Равно("1700000060000000000");
    Ожидаем.Что(Точка["count"]).Равно("12");
    Ожидаем.Что(Точка["sum"]).Равно(5.5);
    Ожидаем.Что(Точка["quantile_values"]).ИмеетДлину(2);
    Ожидаем.Что(Точка["quantile_values"][1]["quantile"]).Равно(0.99);
    Ожидаем.Что(Точка["quantile_values"][1]["value"]).Равно(0.9);
    Ожидаем.Что(Точка["attributes"][0]["key"]).Равно("rpc.method");
КонецПроцедуры

&Тест
Процедура ПоляMetric_Метаданные() Экспорт
    Метаданные = Новый Массив();
    Метаданные.Добавить(СоздатьАтрибутСтроку("prometheus.type", "unknown"));
    Метрика = Новый Соответствие();
    Метрика.Вставить("name", "build");
    Метрика.Вставить("summary", СводкаOtlp());
    Метрика.Вставить("metadata", Метаданные);

    Результат = ОтелПротоКодировщикMetrics.ЗакодироватьMetricsData(УпаковатьВСтруктуруМетрик(Метрика));
    Декодировано = ДекодироватьПротоБайты(Результат);

    МетаданныеProto = ПолучитьПервуюМетрику(Декодировано)["metadata"];
    Ожидаем.Что(МетаданныеProto).ИмеетДлину(1);
    Ожидаем.Что(МетаданныеProto[0]["key"]).Равно("prometheus.type");
    Ожидаем.Что(МетаданныеProto[0]["value"]["string_value"]).Равно("unknown");
КонецПроцедуры

Функция СводкаOtlp()
    Квантили = Новый Массив();
    Для Каждого Пара Из СтрРазделить("0.5:0.2,0.99:0.9", ",") Цикл
        Части = СтрРазделить(Пара, ":");
        Квантиль = Новый Соответствие();
        Квантиль.Вставить("quantile", Число(Части[0]));
        Квантиль.Вставить("value", Число(Части[1]));
        Квантили.Добавить(Квантиль);
    КонецЦикла;
    Атрибуты = Новый Массив();
    Атрибуты.Добавить(СоздатьАтрибутСтроку("rpc.method", "Get"));
    Точка = Новый Соответствие();
    Точка.Вставить("attributes", Атрибуты);
    Точка.Вставить("startTimeUnixNano", "1700000000000000000");
    Точка.Вставить("timeUnixNano", "1700000060000000000");
    Точка.Вставить("count", "12");
    Точка.Вставить("sum", 5.5);
    Точка.Вставить("quantileValues", Квантили);
    Точки = Новый Массив();
    Точки.Добавить(Точка);
    Сводка = Новый Соответствие();
    Сводка.Вставить("dataPoints", Точки);
    Возврат Сводка;
КонецФункции
