#Использовать "../../.."
#Использовать asserts

&ТестовыйНабор
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&Тест
Процедура КодироватьСписокKeyValue_КаждыйЭлементОтдельнымПолем() Экспорт
    Писатель = Новый ОтелПротоПисатель();
    Атрибуты = Новый Массив();
    Атрибуты.Добавить(СтроковыйАтрибут("a", "x"));
    Атрибуты.Добавить(СтроковыйАтрибут("b", "y"));

    ОтелПротоЗначения.КодироватьСписокKeyValue(Писатель, Атрибуты, 3);

    Ожидаем.Что(БайтыСтрокой(Писатель)).Равно("26,8,10,1,97,18,3,10,1,120,26,8,10,1,98,18,3,10,1,121");
КонецПроцедуры

&Тест
Процедура КодироватьСписокKeyValue_БезСпискаНичегоНеПишет() Экспорт
    Писатель = Новый ОтелПротоПисатель();

    ОтелПротоЗначения.КодироватьСписокKeyValue(Писатель, Неопределено, 3);

    Ожидаем.Что(БайтыСтрокой(Писатель)).Равно("");
КонецПроцедуры

Функция СтроковыйАтрибут(Ключ, Значение)
    ЗначениеAny = Новый Соответствие();
    ЗначениеAny.Вставить("stringValue", Значение);
    Атрибут = Новый Соответствие();
    Атрибут.Вставить("key", Ключ);
    Атрибут.Вставить("value", ЗначениеAny);
    Возврат Атрибут;
КонецФункции

Функция БайтыСтрокой(Писатель)
    Данные = Писатель.ПолучитьДвоичныеДанные();
    Буфер = Новый БуферДвоичныхДанных(Данные.Размер());
    Поток = Данные.ОткрытьПотокДляЧтения();
    Поток.Прочитать(Буфер, 0, Данные.Размер());
    Поток.Закрыть();
    Байты = Новый Массив();
    Для Индекс = 0 По Буфер.Размер - 1 Цикл
        Байты.Добавить(Формат(Буфер.Получить(Индекс), "ЧН=0; ЧГ="));
    КонецЦикла;
    Возврат СтрСоединить(Байты, ",");
КонецФункции
