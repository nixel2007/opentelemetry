// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать "../../.."
#Использовать asserts

Перем МокСервер;
Перем ПортЗависшегоСервера;
Перем TlsСервер;
Перем ПортTlsСервера;
Перем ЖурналTlsСервера;
Перем СерверСтатусов;
Перем ПортСервераСтатусов;
Перем ЖурналСервераСтатусов;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура ПередВсемиТестами() Экспорт
    ПортЗависшегоСервера = 14317 + Цел(ТекущаяУниверсальнаяДата() - Дата(2025, 1, 1)) % 100;
    КаталогПроекта = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "..");
    КаталогПомощников = ОбъединитьПути(КаталогПроекта, "tests", "helpers");
    ПутьСкрипта = ОбъединитьПути(КаталогПомощников, "mock_hanging_tcp_server.py");
    МокСервер = СоздатьПроцесс("python3 " + ПутьСкрипта + " " + ПортЗависшегоСервера, , Истина);
    МокСервер.Запустить();

    // Журнал TLS-сервера живет до конца набора: удаляется перед каждым случаем и после всех тестов
    ПортTlsСервера = ПортЗависшегоСервера + 100;
    ЖурналTlsСервера = ОбъединитьПути(КаталогВременныхФайлов(),
        "otel-tls-probe-" + ПортСтрокой(ПортTlsСервера) + ".log");
    ПутьСкриптаTls = ОбъединитьПути(КаталогПомощников, "mock_tls_probe_server.py");
    КомандаTlsСервера = СтрШаблон("python3 ""%1"" %2 ""%3""",
        ПутьСкриптаTls, ПортСтрокой(ПортTlsСервера), ЖурналTlsСервера);
    TlsСервер = СоздатьПроцесс(КомандаTlsСервера, , Истина);
    TlsСервер.Запустить();

    // gRPC-сервер отвечает ошибкой со статусом из метаданных вызова и пишет журнал вызовов
    ПортСервераСтатусов = ПортЗависшегоСервера + 200;
    ЖурналСервераСтатусов = ОбъединитьПути(КаталогВременныхФайлов(),
        "otel-grpc-status-" + ПортСтрокой(ПортСервераСтатусов) + ".log");
    ОчиститьЖурналСервераСтатусов();
    ПутьСкриптаСтатусов = ОбъединитьПути(КаталогПомощников, "mock_grpc_status_server.py");
    КомандаСервераСтатусов = СтрШаблон("python3 ""%1"" %2 ""%3""",
        ПутьСкриптаСтатусов, ПортСтрокой(ПортСервераСтатусов), ЖурналСервераСтатусов);
    СерверСтатусов = СоздатьПроцесс(КомандаСервераСтатусов, , Истина);
    СерверСтатусов.Запустить();
    Приостановить(1000);
    ДождатьсяПорта(ПортСервераСтатусов);
КонецПроцедуры

&ПослеВсех
Процедура ПослеВсехТестов() Экспорт
    Если МокСервер <> Неопределено Тогда
        МокСервер.Завершить();
    КонецЕсли;
    Если TlsСервер <> Неопределено Тогда
        TlsСервер.Завершить();
    КонецЕсли;
    Если СерверСтатусов <> Неопределено Тогда
        СерверСтатусов.Завершить();
    КонецЕсли;
    ОчиститьЖурналTlsСервера();
    ОчиститьЖурналСервераСтатусов();
КонецПроцедуры

&Тест
Процедура КонструкторСНедоступнымАдресом() Экспорт

    // Дано / Когда - адрес недоступен, соединение не устанавливается
    Транспорт = Новый ОтелGrpcТранспорт("http://localhost:1");

    // Тогда - объект создан, соединение = Неопределено
    Ожидаем.Что(Транспорт).Не_().Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ОтправитьБезСоединения() Экспорт

    // Дано - соединение не установлено
    Транспорт = Новый ОтелGrpcТранспорт("http://localhost:1");

    // Когда
    Результат = Транспорт.Отправить("/v1/traces", Новый Соответствие());

    // Тогда
    Ожидаем.Что(Результат).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ОтправитьНеизвестныйПуть() Экспорт

    // Дано
    Транспорт = Новый ОтелGrpcТранспорт("http://localhost:1");

    // Когда - неизвестный путь
    Результат = Транспорт.Отправить("/unknown/path", Новый Соответствие());

    // Тогда
    Ожидаем.Что(Результат).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ЗакрытьБезСоединения() Экспорт

    // Дано
    Транспорт = Новый ОтелGrpcТранспорт("http://localhost:1");

    // Когда - закрытие без активного соединения
    Транспорт.Закрыть();

    // Тогда - без ошибок
    Ожидаем.Что(Истина).Равно(Истина);

КонецПроцедуры

&Тест
Процедура КонструкторСПользовательскимКаталогомProto() Экспорт

    // Дано - указываем каталог proto из проекта
    КаталогПроекта = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "..");
    КаталогProto = ОбъединитьПути(КаталогПроекта, "proto");

    // Когда
    Транспорт = Новый ОтелGrpcТранспорт("http://localhost:1", , , КаталогProto);

    // Тогда - объект создан
    Ожидаем.Что(Транспорт).Не_().Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура КонструкторСНесуществующимКаталогомProto() Экспорт

    // Дано - несуществующий каталог proto -> fallback
    Транспорт = Новый ОтелGrpcТранспорт("http://localhost:1", , , "/nonexistent/proto");

    // Тогда - объект создан (используется путь as-is)
    Ожидаем.Что(Транспорт).Не_().Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ВыставляетсяМетаданныеUserAgent() Экспорт

    // Дано / Когда
    Транспорт = Новый ОтелGrpcТранспорт("http://localhost:1");

    // Тогда - метаданные содержат user-agent в формате OTel-OTLP-Exporter-OneScript/<версия>
    Метаданные = Транспорт.ПолучитьМетаданные();
    Ожидаем.Что(Метаданные).Не_().Равно(Неопределено);
    ЗначениеUserAgent = Метаданные.Получить("user-agent");
    Ожидаем.Что(ЗначениеUserAgent).Не_().Равно(Неопределено);
    Ожидаем.Что(СтрНачинаетсяС(ЗначениеUserAgent, "OTel-OTLP-Exporter-OneScript/")).Равно(Истина);

КонецПроцедуры

&Тест
Процедура UserAgentДополняетКастомныеМетаданные() Экспорт

    // Дано - кастомные метаданные
    КастомныеМетаданные = Новый Соответствие();
    КастомныеМетаданные.Вставить("authorization", "Bearer abc");

    // Когда
    Транспорт = Новый ОтелGrpcТранспорт("http://localhost:1", , КастомныеМетаданные);

    // Тогда - кастомные метаданные сохранены, user-agent добавлен
    Метаданные = Транспорт.ПолучитьМетаданные();
    Ожидаем.Что(Метаданные.Получить("authorization")).Равно("Bearer abc");
    Ожидаем.Что(СтрНачинаетсяС(Метаданные.Получить("user-agent"), "OTel-OTLP-Exporter-OneScript/")).Равно(Истина);

КонецПроцедуры

// OTLP Exporter (gRPC): https-схема в endpoint поддерживается underlying gRPC-клиентом
// (OPI_GRPC, tonic-based) без отдельной трансформации.
&Тест
Процедура КонструкторПринимаетHttpsURL() Экспорт

    // Дано / Когда - https URL без отдельных настроек TLS
    Транспорт = Новый ОтелGrpcТранспорт("https://localhost:1");

    // Тогда - объект создан, без исключений на этапе конструктора
    Ожидаем.Что(Транспорт).Не_().Равно(Неопределено);

КонецПроцедуры

// OTLP Exporter / Insecure: опция действует только на endpoint без схемы - без Insecure
// соединение защищено TLS (https://), с Insecure - без TLS (http://); адрес со схемой не меняется
&ПараметризованныйТест
&ИсточникЗначение("localhost:1|нет|https://localhost:1")
&ИсточникЗначение("localhost:1|да|http://localhost:1")
&ИсточникЗначение("http://localhost:1|нет|http://localhost:1")
&ИсточникЗначение("https://localhost:1|да|https://localhost:1")
Процедура АдресБезСхемыПолучаетСхемуПоInsecure(Случай) Экспорт

    // Дано
    Части = СтрРазделить(Случай, "|");
    НастройкиTls = НастройкиTlsСлучая(Части[1] = "да", "");

    // Когда
    Транспорт = Новый ОтелGrpcТранспорт(Части[0], НастройкиTls, , , 1000, 1);

    // Тогда
    Ожидаем.Что(Транспорт.Адрес()).Равно(Части[2]);

КонецПроцедуры

// OTLP Exporter / Endpoint (OTLP/gRPC): схема https - защищенное соединение, схема http -
// незащищенное, обе важнее Insecure и файла сертификата; endpoint без схемы защищен TLS,
// если Insecure не включен
&ПараметризованныйТест
&ИсточникЗначение("https://localhost|нет|нет|tls")
&ИсточникЗначение("https://localhost|да|нет|tls")
&ИсточникЗначение("http://localhost|нет|нет|h2c")
&ИсточникЗначение("http://localhost|да|нет|h2c")
&ИсточникЗначение("http://localhost|нет|да|h2c")
&ИсточникЗначение("localhost|нет|нет|tls")
&ИсточникЗначение("localhost|да|нет|h2c")
Процедура TlsСоединенияЗадаютСхемаАдресаИInsecure(Случай) Экспорт

    // Дано
    Части = СтрРазделить(Случай, "|");
    ФайлСертификата = ?(Части[2] = "да", "/etc/otel/ca.pem", "");
    НастройкиTls = НастройкиTlsСлучая(Части[1] = "да", ФайлСертификата);
    ОчиститьЖурналTlsСервера();

    // Когда - транспорт открывает соединение при создании
    Транспорт = Новый ОтелGrpcТранспорт(Части[0] + ":" + ПортСтрокой(ПортTlsСервера), НастройкиTls, , , 1000, 1);
    Соединение = ПервоеСоединениеTlsСервера();
    Транспорт.Закрыть();

    // Тогда - сервер видит TLS-рукопожатие или HTTP/2 без TLS
    Ожидаем.Что(Лев(Соединение, 3), Случай).Равно(Части[3]);

КонецПроцедуры

// OTLP Exporter / Insecure: Insecure не отключает проверку сертификата сервера - защищенное
// соединение отклоняет самоподписанный сертификат тестового сервера
&ПараметризованныйТест
&ИсточникЗначение("https://localhost|нет")
&ИсточникЗначение("https://localhost|да")
&ИсточникЗначение("localhost|нет")
Процедура ЗащищенноеСоединениеПроверяетСертификатСервера(Случай) Экспорт

    // Дано
    Части = СтрРазделить(Случай, "|");
    НастройкиTls = НастройкиTlsСлучая(Части[1] = "да", "");
    ОчиститьЖурналTlsСервера();

    // Когда
    Транспорт = Новый ОтелGrpcТранспорт(Части[0] + ":" + ПортСтрокой(ПортTlsСервера), НастройкиTls, , , 1000, 1);
    Соединение = ПервоеСоединениеTlsСервера();
    Транспорт.Закрыть();

    // Тогда - клиент оборвал рукопожатие, не приняв сертификат
    Ожидаем.Что(Соединение, Случай).Равно("tls-failed");

КонецПроцедуры

// OTLP Exporter / User Agent: идентификатор продукта из метаданных user-agent добавляется
// перед стандартным user-agent экспортера, а не заменяется им
&Тест
Процедура ПользовательскийUserAgentДобавляетсяПередСтандартным() Экспорт

    // Дано - идентификатор дистрибутива в метаданных, ключ в произвольном регистре
    КлючВСмешанномРегистре = "User-Agent";
    КастомныеМетаданные = Новый Соответствие();
    КастомныеМетаданные.Вставить(КлючВСмешанномРегистре, "MyDistribution/1.2.3");

    // Когда
    Транспорт = Новый ОтелGrpcТранспорт("http://localhost:1", , КастомныеМетаданные);

    // Тогда - один user-agent: идентификатор, затем стандартная строка экспортера
    Метаданные = Транспорт.ПолучитьМетаданные();
    Ожидаем.Что(Метаданные.Получить("user-agent"))
        .Равно("MyDistribution/1.2.3 OTel-OTLP-Exporter-OneScript/" + ОтелУтилиты.ВерсияSDK());
    Ожидаем.Что(Метаданные.Получить(КлючВСмешанномРегистре)).Равно(Неопределено);

КонецПроцедуры

// OTLP/gRPC: повторяемые коды - CANCELLED, DEADLINE_EXCEEDED, ABORTED, OUT_OF_RANGE,
// UNAVAILABLE, DATA_LOSS; RESOURCE_EXHAUSTED - только если сервер вернул RetryInfo.
// tonic (OPI_GRPC) пишет код в CamelCase: "status: DeadlineExceeded, message: ...".
&ПараметризованныйТест
&ИсточникЗначение("status: Cancelled, message: Timeout expired, details: [], metadata: MetadataMap|да")
&ИсточникЗначение("status: DeadlineExceeded, message: deadline has elapsed|да")
&ИсточникЗначение("status: Aborted, message: aborted|да")
&ИсточникЗначение("status: OutOfRange, message: out of range|да")
&ИсточникЗначение("status: Unavailable, message: error trying to connect|да")
&ИсточникЗначение("status: DataLoss, message: data loss|да")
&ИсточникЗначение("DEADLINE_EXCEEDED: deadline exceeded|да")
&ИсточникЗначение("status: Unknown, message: service unavailable|нет")
&ИсточникЗначение("status: InvalidArgument, message: bad request|нет")
&ИсточникЗначение("status: Unauthenticated, message: token expired|нет")
&ИсточникЗначение("status: ResourceExhausted, message: message too large, details: []|нет")
&ИсточникЗначение("Property Ключ is not writable|нет")
Процедура ПовторяемостьОшибкиПоКодуСтатусаOtlp(Случай) Экспорт

    // Дано
    Части = СтрРазделить(Случай, "|");
    Транспорт = Новый ОтелGrpcТранспорт("http://localhost:1");

    // Когда
    Повторяемая = Транспорт.ОшибкаПовторяемая(Части[0]);

    // Тогда
    Ожидаем.Что(Повторяемая, Части[0]).Равно(Части[1] = "да");

КонецПроцедуры

// OTLP/gRPC: недоступность коллектора при создании транспорта - временная ошибка,
// отправка открывает соединение заново, а не отказывает до перезапуска
&Тест
Процедура ОтправкаОткрываетСоединениеЗаново() Экспорт

    // Дано - коллектор недоступен при создании транспорта
    Транспорт = Новый ОтелGrpcТранспорт("http://localhost:1", , , , 1000, 1);
    Аппендер = НачатьЗахватЛога();

    // Когда
    Результат = Транспорт.Отправить("/v1/traces", Новый Соответствие());

    // Тогда - при отправке была попытка открыть соединение
    ЗакончитьЗахватЛога(Аппендер);
    Ожидаем.Что(Результат).Равно(Ложь);
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "не удалось открыть соединение"), "попытка соединения")
        .ЭтоИстина();

КонецПроцедуры

// Исключение компоненты OPI_GRPC при открытии соединения (на движке 2.2 - "Property 'Ключ'
// is not writable" после установки TCP-соединения) не выбрасывается из конструктора:
// инициализация SDK не падает из-за экспорта телеметрии
&Тест
Процедура ИсключениеПриОткрытииСоединенияНеВыбрасывается() Экспорт

    // Дано - сервер принимает TCP-соединение, но не отвечает
    Адрес = "http://localhost:" + ПортЗависшегоСервера;

    // Когда
    Транспорт = Новый ОтелGrpcТранспорт(Адрес, , , , 1000, 1);

    // Тогда
    Ожидаем.Что(Транспорт).Не_().Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЗакрытыйТранспортНеОткрываетСоединение() Экспорт

    // Дано
    Транспорт = Новый ОтелGrpcТранспорт("http://localhost:1", , , , 1000, 1);
    Транспорт.Закрыть();
    Аппендер = НачатьЗахватЛога();

    // Когда
    Результат = Транспорт.Отправить("/v1/traces", Новый Соответствие());

    // Тогда
    ЗакончитьЗахватЛога(Аппендер);
    Ожидаем.Что(Результат).Равно(Ложь);
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "не удалось открыть соединение"), "попытка соединения")
        .ЭтоЛожь();

КонецПроцедуры

// OTLP Exporter / Max Request Size: по умолчанию 64 MiB, размер считается до сжатия
&Тест
Процедура МаксРазмерЗапросаПоУмолчанию() Экспорт

    // Дано / Когда
    Транспорт = Новый ОтелGrpcТранспорт("http://localhost:1");

    // Тогда
    Ожидаем.Что(Транспорт.МаксРазмерЗапроса()).Равно(67108864);

КонецПроцедуры

&Тест
Процедура ЗапросБольшеМаксимальногоРазмераНеОтправляется() Экспорт

    // Дано - лимит меньше размера запроса
    Транспорт = Новый ОтелGrpcТранспорт("http://localhost:1", , , , 1000, 1)
        .УстановитьМаксРазмерЗапроса(10);
    Аппендер = НачатьЗахватЛога();

    // Когда
    Результат = Транспорт.Отправить("/v1/traces", ДанныеСРесурсом());

    // Тогда - запрос отброшен до отправки, соединение не открывалось
    ЗакончитьЗахватЛога(Аппендер);
    Ожидаем.Что(Результат).Равно(Ложь);
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "превышает"), "сообщение о лимите").ЭтоИстина();
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "не удалось открыть соединение"), "попытка соединения")
        .ЭтоЛожь();

КонецПроцедуры

// Схема файла конфигурации: max_request_size 0 - размер запроса без ограничения
&Тест
Процедура МаксРазмерЗапросаНольБезОграничения() Экспорт

    // Дано - адрес недоступен
    Транспорт = Новый ОтелGrpcТранспорт("http://localhost:1", , , , 1000, 1)
        .УстановитьМаксРазмерЗапроса(0);
    Аппендер = НачатьЗахватЛога();

    // Когда
    Транспорт.Отправить("/v1/traces", ДанныеСРесурсом());

    // Тогда - лимит не отбросил запрос: транспорт пытался открыть соединение
    ЗакончитьЗахватЛога(Аппендер);
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "превышает"), "сообщение о лимите").ЭтоЛожь();
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "не удалось открыть соединение"), "попытка соединения")
        .ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТаймаутСрабатывает() Экспорт

    // Дано - зависший сервер (принимает соединение, но не отвечает)
    // и транспорт с таймаутом 1 с (1 попытка, без retry)
    ТаймаутМс = 1000;
    МаксПопыток = 1;
    Транспорт = Новый ОтелGrpcТранспорт(
        "http://localhost:" + ПортЗависшегоСервера, , , , ТаймаутМс, МаксПопыток);

    // Когда - отправка на зависший сервер
    Результат = Транспорт.Отправить("/v1/traces", Новый Соответствие());

    // Тогда - таймаут сработал, возврат Ложь (не завис на 10 сек)
    Ожидаем.Что(Результат).Равно(Ложь);

КонецПроцедуры

// Таймаут вызова не больше времени, оставшегося до срока отправки
&Тест
Процедура ТаймаутВызоваОграниченСрокомОтправки() Экспорт

    // Дано - сервер принимает соединение и не отвечает; таймаут вызова 10 с, одна попытка
    Транспорт = Новый ОтелGrpcТранспорт("http://localhost:" + ПортЗависшегоСервера, , , , 10000, 1);
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

    // Когда
    Результат = Транспорт.Отправить("/v1/traces", Новый Соответствие(), 1500);

    // Тогда
    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
    Ожидаем.Что(Результат).Равно(Ложь);
    Ожидаем.Что(ДлительностьМс < 3000, ДлительностьМс).ЭтоИстина();

КонецПроцедуры

// OTLP/gRPC Throttling: задержка повтора - retry_delay из RetryInfo. tonic (OPI_GRPC) пишет детали
// статуса - сериализованный google.rpc.Status - списком байтов: "details: [8, 14, 18, ...]"
&ПараметризованныйТест
&ИсточникЗначение("RESOURCE_EXHAUSTED;retry=2500|2500")
&ИсточникЗначение("UNAVAILABLE;retry=5000|5000")
&ИсточникЗначение("UNAVAILABLE;retry=300|300")
&ИсточникЗначение("UNAVAILABLE;quota;retry=1500|1500")
&ИсточникЗначение("RESOURCE_EXHAUSTED;quota|нет")
&ИсточникЗначение("RESOURCE_EXHAUSTED|нет")
&ИсточникЗначение("без деталей|нет")
&ИсточникЗначение("испорченные детали|нет")
Процедура ЗадержкаRetryInfoИзДеталейСтатуса(Случай) Экспорт

    // Дано
    Части = СтрРазделить(Случай, "|");
    Транспорт = Новый ОтелGrpcТранспорт("http://localhost:1");

    // Когда
    Задержка = Транспорт.ЗадержкаRetryInfo(ТекстОшибкиTonic(Части[0]));

    // Тогда
    Если Части[1] = "нет" Тогда
        Ожидаем.Что(Задержка, Случай).ЭтоНеопределено();
    Иначе
        Ожидаем.Что(Задержка, Случай).Равно(Число(Части[1]));
    КонецЕсли;

КонецПроцедуры

// OTLP/gRPC: RESOURCE_EXHAUSTED повторяется, только если сервер прислал RetryInfo
&ПараметризованныйТест
&ИсточникЗначение("RESOURCE_EXHAUSTED;retry=2500|да")
&ИсточникЗначение("RESOURCE_EXHAUSTED;quota|нет")
&ИсточникЗначение("RESOURCE_EXHAUSTED|нет")
Процедура ResourceExhaustedПовторяетсяТолькоСRetryInfo(Случай) Экспорт

    // Дано
    Части = СтрРазделить(Случай, "|");
    Транспорт = Новый ОтелGrpcТранспорт("http://localhost:1");

    // Когда
    Повторяемая = Транспорт.ОшибкаПовторяемая(ТекстОшибкиTonic(Части[0]));

    // Тогда
    Ожидаем.Что(Повторяемая, Случай).Равно(Части[1] = "да");

КонецПроцедуры

// OTLP/gRPC Throttling: следующая попытка не раньше retry_delay из RetryInfo
&Тест
Процедура RetryInfoЗадерживаетПовторНаRetryDelay() Экспорт

    // Дано - сервер отвечает UNAVAILABLE с RetryInfo 1500 мс
    Сценарий = "UNAVAILABLE;retry=1500;id=delay";
    Транспорт = ТранспортСервераСтатусов(Сценарий, 2);

    // Когда
    Результат = Транспорт.Отправить("/v1/traces", Новый Соответствие(), 10000);

    // Тогда
    Вызовы = ВызовыСервераСтатусов(Сценарий);
    Ожидаем.Что(Результат).Равно(Ложь);
    Ожидаем.Что(Вызовы.Количество(), "число вызовов").Равно(2);
    Пауза = Вызовы[1] - Вызовы[0];
    Ожидаем.Что(Пауза >= 1500, Пауза).ЭтоИстина();

КонецПроцедуры

// RetryInfo: если повторы тоже падают, задержка растет экспоненциально от retry_delay
&Тест
Процедура ПовторыСRetryInfoУдваиваютЗадержку() Экспорт

    // Дано - сервер на каждый вызов отвечает UNAVAILABLE с RetryInfo 300 мс
    Сценарий = "UNAVAILABLE;retry=300;id=backoff";
    Транспорт = ТранспортСервераСтатусов(Сценарий, 3);

    // Когда
    Транспорт.Отправить("/v1/traces", Новый Соответствие(), 10000);

    // Тогда - паузы 300 и 600 мс, а не собственная экспоненциальная задержка 1000 и 2000 мс
    Вызовы = ВызовыСервераСтатусов(Сценарий);
    Ожидаем.Что(Вызовы.Количество(), "число вызовов").Равно(3);
    ПерваяПауза = Вызовы[1] - Вызовы[0];
    ВтораяПауза = Вызовы[2] - Вызовы[1];
    Ожидаем.Что(ПерваяПауза >= 300 И ПерваяПауза < 700, ПерваяПауза).ЭтоИстина();
    Ожидаем.Что(ВтораяПауза >= 600 И ВтораяПауза < 1100, ВтораяПауза).ЭтоИстина();

КонецПроцедуры

// RetryInfo длиннее остатка срока: повтор в срок не уложится, отправка прекращается сразу
&Тест
Процедура RetryInfoДольшеСрокаПрекращаетОтправкуСразу() Экспорт

    // Дано - сервер просит повторить через 5 с, а срок отправки 2 с
    Сценарий = "UNAVAILABLE;retry=5000;id=deadline";
    Транспорт = ТранспортСервераСтатусов(Сценарий, 3);
    Аппендер = НачатьЗахватЛога();
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

    // Когда
    Результат = Транспорт.Отправить("/v1/traces", Новый Соответствие(), 2000);

    // Тогда
    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
    ЗакончитьЗахватЛога(Аппендер);
    Ожидаем.Что(Результат).Равно(Ложь);
    Ожидаем.Что(ДлительностьМс < 1000, ДлительностьМс).ЭтоИстина();
    Ожидаем.Что(ВызовыСервераСтатусов(Сценарий).Количество(), "число вызовов").Равно(1);
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "(RetryInfo)"), "сообщение о RetryInfo").ЭтоИстина();

КонецПроцедуры

// OTLP/gRPC: RESOURCE_EXHAUSTED с RetryInfo - временная перегрузка сервера, отправка повторяется
&Тест
Процедура ResourceExhaustedСRetryInfoПовторяетОтправку() Экспорт

    // Дано
    Сценарий = "RESOURCE_EXHAUSTED;retry=100;id=retry";
    Транспорт = ТранспортСервераСтатусов(Сценарий, 2);

    // Когда
    Результат = Транспорт.Отправить("/v1/traces", Новый Соответствие(), 10000);

    // Тогда
    Ожидаем.Что(Результат).Равно(Ложь);
    Ожидаем.Что(ВызовыСервераСтатусов(Сценарий).Количество(), "число вызовов").Равно(2);

КонецПроцедуры

Функция ДанныеСРесурсом()
    Значение = Новый Соответствие();
    Значение.Вставить("stringValue", "checkout");
    Атрибут = Новый Соответствие();
    Атрибут.Вставить("key", "service.name");
    Атрибут.Вставить("value", Значение);
    Атрибуты = Новый Массив();
    Атрибуты.Добавить(Атрибут);

    Ресурс = Новый Соответствие();
    Ресурс.Вставить("attributes", Атрибуты);
    ResourceSpans = Новый Соответствие();
    ResourceSpans.Вставить("resource", Ресурс);
    ResourceSpans.Вставить("scopeSpans", Новый Массив());
    МассивРесурсов = Новый Массив();
    МассивРесурсов.Добавить(ResourceSpans);

    Данные = Новый Соответствие();
    Данные.Вставить("resourceSpans", МассивРесурсов);
    Возврат Данные;
КонецФункции

Функция НастройкиTlsСлучая(Небезопасно, ФайлСертификата)
    Если НЕ Небезопасно И ФайлСертификата = "" Тогда
        Возврат Неопределено;
    КонецЕсли;
    НастройкиTls = Новый ОтелНастройкиTls();
    НастройкиTls.Insecure = Небезопасно;
    НастройкиTls.ФайлСертификата = ФайлСертификата;
    Возврат НастройкиTls;
КонецФункции

Процедура ОчиститьЖурналTlsСервера()
    Если Новый Файл(ЖурналTlsСервера).Существует() Тогда
        УдалитьФайлы(ЖурналTlsСервера);
    КонецЕсли;
КонецПроцедуры

// Возвращает, как началось первое соединение с тестовым TLS-сервером: h2c - без TLS,
// tls-ok - рукопожатие завершено, tls-failed - клиент отклонил сертификат сервера.
// Сервер пишет журнал после рукопожатия, поэтому журнал ожидается до 5 с.
//
// Возвращаемое значение:
//   Строка - вид первого соединения или пустая строка, если соединений не было
//
Функция ПервоеСоединениеTlsСервера()
    Срок = ТекущаяУниверсальнаяДатаВМиллисекундах() + 5000;
    Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Срок Цикл
        Если Новый Файл(ЖурналTlsСервера).Существует() Тогда
            Чтение = Новый ЧтениеТекста(ЖурналTlsСервера, КодировкаТекста.UTF8);
            Строка = Чтение.ПрочитатьСтроку();
            Чтение.Закрыть();
            Если Строка <> Неопределено Тогда
                Возврат Строка;
            КонецЕсли;
        КонецЕсли;
        Приостановить(100);
    КонецЦикла;
    Возврат "";
КонецФункции

// Текст ошибки OPI_GRPC (tonic 0.13.1) на ответ тестового сервера mock_grpc_status_server.py. Детали
// статуса - google.rpc.Status (code, message "test error", details) списком байтов; байты сняты с ответов
// сервера на вызов OPI_GRPC.ВызватьМетод.
//
// Параметры:
//   Сценарий - Строка - статус ответа сервера (x-otel-test-status), "без деталей" или "испорченные детали"
//
// Возвращаемое значение:
//   Строка - текст ошибки вызова
//
Функция ТекстОшибкиTonic(Сценарий)
    КодResourceExhausted = "ResourceExhausted";
    КодСтатуса = "Unavailable";
    ТестоваяОшибка = "18, 10, 116, 101, 115, 116, 32, 101, 114, 114, 111, 114";
    НачалоResourceExhausted = "8, 8, " + ТестоваяОшибка;
    НачалоUnavailable = "8, 14, " + ТестоваяОшибка;
    ТипRetryInfo = "10, 40, 116, 121, 112, 101, 46, 103, 111, 111, 103, 108, 101, 97, 112, 105, 115, 46, 99, 111, "
        + "109, 47, 103, 111, 111, 103, 108, 101, 46, 114, 112, 99, 46, 82, 101, 116, 114, 121, 73, 110, 102, 111";
    QuotaFailure = "26, 64, 10, 43, 116, 121, 112, 101, 46, 103, 111, 111, 103, 108, 101, 97, 112, 105, 115, 46, 99, "
        + "111, 109, 47, 103, 111, 111, 103, 108, 101, 46, 114, 112, 99, 46, 81, 117, 111, 116, 97, 70, 97, 105, 108, "
        + "117, 114, 101, 18, 17, 10, 15, 10, 6, 99, 108, 105, 101, 110, 116, 18, 5, 113, 117, 111, 116, 97";
    Если Сценарий = "RESOURCE_EXHAUSTED;retry=2500" Тогда
        КодСтатуса = КодResourceExhausted;
        Детали = НачалоResourceExhausted + ", 26, 54, " + ТипRetryInfo
            + ", 18, 10, 10, 8, 8, 2, 16, 128, 202, 181, 238, 1";
    ИначеЕсли Сценарий = "UNAVAILABLE;retry=5000" Тогда
        Детали = НачалоUnavailable + ", 26, 48, " + ТипRetryInfo + ", 18, 4, 10, 2, 8, 5";
    ИначеЕсли Сценарий = "UNAVAILABLE;retry=300" Тогда
        Детали = НачалоUnavailable + ", 26, 52, " + ТипRetryInfo
            + ", 18, 8, 10, 6, 16, 128, 198, 134, 143, 1";
    ИначеЕсли Сценарий = "UNAVAILABLE;quota;retry=1500" Тогда
        Детали = НачалоUnavailable + ", " + QuotaFailure + ", 26, 54, " + ТипRetryInfo
            + ", 18, 10, 10, 8, 8, 1, 16, 128, 202, 181, 238, 1";
    ИначеЕсли Сценарий = "RESOURCE_EXHAUSTED;quota" Тогда
        КодСтатуса = КодResourceExhausted;
        Детали = НачалоResourceExhausted + ", " + QuotaFailure;
    ИначеЕсли Сценарий = "RESOURCE_EXHAUSTED" Тогда
        КодСтатуса = КодResourceExhausted;
        Детали = НачалоResourceExhausted;
    ИначеЕсли Сценарий = "испорченные детали" Тогда
        Детали = "8, 14, 26, 200, 1";
    Иначе
        Детали = "";
    КонецЕсли;
    Возврат СтрШаблон("gRPC call failed: status: %1, message: ""test error"", details: [%2], "
        + "metadata: MetadataMap { headers: {""content-type"": ""application/grpc""} }", КодСтатуса, Детали);
КонецФункции

// Транспорт к тестовому серверу статусов: сервер отвечает на каждый вызов статусом из метаданных
// x-otel-test-status. Таймаут вызова 5 с.
//
// Параметры:
//   Сценарий - Строка - статус ответа сервера, например "UNAVAILABLE;retry=1500;id=..."
//   МаксПопыток - Число - максимальное количество попыток отправки
//
// Возвращаемое значение:
//   ОтелGrpcТранспорт - транспорт
//
Функция ТранспортСервераСтатусов(Сценарий, МаксПопыток)
    Метаданные = Новый Соответствие();
    Метаданные.Вставить("x-otel-test-status", Сценарий);
    Адрес = "http://localhost:" + ПортСтрокой(ПортСервераСтатусов);
    Возврат Новый ОтелGrpcТранспорт(Адрес, , Метаданные, , 5000, МаксПопыток);
КонецФункции

// Возвращает моменты вызовов тестового сервера статусов со сценарием (мс, монотонные часы сервера).
//
// Параметры:
//   Сценарий - Строка - статус ответа сервера (x-otel-test-status)
//
// Возвращаемое значение:
//   Массив из Число - моменты вызовов по порядку
//
Функция ВызовыСервераСтатусов(Сценарий)
    Вызовы = Новый Массив();
    Если НЕ Новый Файл(ЖурналСервераСтатусов).Существует() Тогда
        Возврат Вызовы;
    КонецЕсли;
    Чтение = Новый ЧтениеТекста(ЖурналСервераСтатусов, КодировкаТекста.UTF8);
    Строка = Чтение.ПрочитатьСтроку();
    Пока Строка <> Неопределено Цикл
        Части = СтрРазделить(Строка, Символы.Таб);
        Если Части[0] = Сценарий Тогда
            Вызовы.Добавить(Число(Части[1]));
        КонецЕсли;
        Строка = Чтение.ПрочитатьСтроку();
    КонецЦикла;
    Чтение.Закрыть();
    Возврат Вызовы;
КонецФункции

Функция ПортСтрокой(Порт)
    Возврат Формат(Порт, "ЧГ=");
КонецФункции

Процедура ОчиститьЖурналСервераСтатусов()
    Если Новый Файл(ЖурналСервераСтатусов).Существует() Тогда
        УдалитьФайлы(ЖурналСервераСтатусов);
    КонецЕсли;
КонецПроцедуры

// Ждет, пока тестовый сервер начнет принимать соединения, не дольше 10 с.
//
// Параметры:
//   Порт - Число - порт сервера
//
Процедура ДождатьсяПорта(Порт)
    Срок = ТекущаяУниверсальнаяДатаВМиллисекундах() + 10000;
    Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Срок Цикл
        Попытка
            Соединение = Новый TCPСоединение("localhost", Порт);
            Соединение.Закрыть();
            Возврат;
        Исключение
            Приостановить(200);
        КонецПопытки;
    КонецЦикла;
КонецПроцедуры

Функция НачатьЗахватЛога()
    Аппендер = СоздатьТестовыйАппендер();
    Логирование.ПолучитьЛог("oscript.lib.opentelemetry.grpc")
        .ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);
    Возврат Аппендер;
КонецФункции

Процедура ЗакончитьЗахватЛога(Аппендер)
    Логирование.ПолучитьЛог("oscript.lib.opentelemetry.grpc").УдалитьСпособВывода(Аппендер);
КонецПроцедуры

Функция СоздатьТестовыйАппендер()
    Текст = "Перем События Экспорт;
    |Процедура ВывестиСобытие(Событие) Экспорт
    |    События.Добавить(Событие);
    |КонецПроцедуры
    |Процедура Закрыть() Экспорт
    |КонецПроцедуры
    |Процедура УстановитьСвойство(Имя, Значение) Экспорт
    |КонецПроцедуры
    |События = Новый Массив();";
    Возврат ЗагрузитьСценарийИзСтроки(Текст);
КонецФункции

Функция ЕстьСообщениеСТекстом(Аппендер, Текст)
    Для Каждого Событие Из Аппендер.События Цикл
        Если СтрНайти(Событие.ПолучитьСообщение(), Текст) > 0 Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции
