// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать "../../.."
#Использовать asserts
#Использовать resilience

// ОтелСрокОтправки - сигнал прерывания для СтратегияПовтора из resilience, срабатывающий по сроку

&Тест
Процедура БезСрокаНеПрерывает() Экспорт

    // Дано
    Срок = Новый ОтелСрокОтправки(0);

    // Когда
    Срок.ПроверитьПрерывание();

    // Тогда - 0 у таймаутов означает "без ограничения"
    Ожидаем.Что(Срок.ОсталосьВремени()).Равно(0);

КонецПроцедуры

&Тест
Процедура ДоСрокаНеПрерывает() Экспорт

    // Дано
    Срок = Новый ОтелСрокОтправки(5000);

    // Когда
    Срок.ПроверитьПрерывание();
    ОсталосьМс = Срок.ОсталосьВремени();

    // Тогда
    Ожидаем.Что(ОсталосьМс > 4000 И ОсталосьМс <= 5000, ОсталосьМс).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПослеСрокаПрерывает() Экспорт

    // Дано
    Срок = Новый ОтелСрокОтправки(50);
    Приостановить(100);

    // Когда / Тогда
    Попытка
        Срок.ПроверитьПрерывание();
        Ожидаем.Что(Ложь).ЭтоИстина("Должно было быть исключение");
    Исключение
        Ожидаем.Что(ИнформацияОбОшибке().Описание).Содержит("Истек срок отправки");
    КонецПопытки;
    // Истекший срок - не меньше 1 мс: 0 означает "без ограничения"
    Ожидаем.Что(Срок.ОсталосьВремени()).Равно(1);

КонецПроцедуры

// Срок истек раньше первой попытки - сообщение говорит, что до отправки запроса дело не дошло
&Тест
Процедура ИстечениеДоПервойПопыткиВСообщении() Экспорт

    // Дано
    Срок = Новый ОтелСрокОтправки(50);
    Приостановить(100);

    // Когда
    ТекстОшибки = ТекстПрерывания(Срок);

    // Тогда
    Ожидаем.Что(ТекстОшибки).Содержит("Истек срок отправки 50 мс до первой попытки");
    Ожидаем.Что(ТекстОшибки).Содержит("подготовка запроса заняла");

КонецПроцедуры

// Срок истек после попыток - сообщение называет число попыток и последнюю ошибку
&Тест
Процедура ИстечениеПослеПопытокВСообщении() Экспорт

    // Дано
    Срок = Новый ОтелСрокОтправки(50);
    Срок.НачатьПопытку();
    Срок.ЗапомнитьОшибкуПопытки("connection refused");
    Срок.НачатьПопытку();
    Срок.ЗапомнитьОшибкуПопытки("HTTP 503");
    Приостановить(100);

    // Когда
    ТекстОшибки = ТекстПрерывания(Срок);

    // Тогда
    Ожидаем.Что(ТекстОшибки).Содержит("Истек срок отправки 50 мс после попыток: 2");
    Ожидаем.Что(ТекстОшибки).Содержит("последняя ошибка: HTTP 503");

КонецПроцедуры

Функция ТекстПрерывания(Срок)
    Попытка
        Срок.ПроверитьПрерывание();
    Исключение
        Возврат ИнформацияОбОшибке().Описание;
    КонецПопытки;
    Возврат "";
КонецФункции

// СтратегияПовтора проверяет срок перед попыткой и во время паузы между попытками
&Тест
Процедура ПовторыОстанавливаютсяНаСроке() Экспорт

    // Дано - операция всегда падает, 10 повторов с паузой от 1 с
    Повтор = Новый СтратегияПовтора(10, 1000);
    Срок = Новый ОтелСрокОтправки(1500);
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

    // Когда
    Попытка
        Повтор.Применить(Новый Действие(ЭтотОбъект, "ОперацияСОшибкой"), , Срок);
        ТекстОшибки = "";
    Исключение
        ТекстОшибки = ИнформацияОбОшибке().Описание;
    КонецПопытки;
    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;

    // Тогда - без срока 10 повторов заняли бы больше 10 с
    Ожидаем.Что(ТекстОшибки).Содержит("Истек срок отправки");
    Ожидаем.Что(ДлительностьМс >= 1400 И ДлительностьМс < 2500, ДлительностьМс).ЭтоИстина();

КонецПроцедуры

Процедура ОперацияСОшибкой() Экспорт
    ВызватьИсключение "сбой отправки";
КонецПроцедуры
