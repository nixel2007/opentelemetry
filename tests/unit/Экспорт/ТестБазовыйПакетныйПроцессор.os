// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать "../../.."
#Использовать asserts
#Использовать atomic
#Использовать moskito

// Состояние для фоновых заданий конкурентного закрытия
Перем Процессоры;
Перем Прибыло;
Перем Сорвано;

&Тест
Процедура КонкурентныйЗакрытьЗакрываетЭкспортерОдинРаз() Экспорт

    // Дано - процессоры, которые два фоновых задания закрывают одновременно
    // (все методы процессора MUST быть безопасны при конкурентном вызове)
    КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Экспортер = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "СчетчикЗакрытийЭкспортер.os"));
    КоличествоПроцессоров = 200;
    Процессоры = Новый Массив();
    Пока Процессоры.Количество() < КоличествоПроцессоров Цикл
        Процессоры.Добавить(Новый ОтелБазовыйПакетныйПроцессор(Экспортер, "тест"));
    КонецЦикла;
    Прибыло = Новый АтомарноеЧисло(0);
    Сорвано = Новый АтомарноеБулево(Ложь);

    // Когда
    КоличествоЗаданий = 2;
    Задания = Новый Массив();
    Пока Задания.Количество() < КоличествоЗаданий Цикл
        Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗакрытьПроцессорыОдновременно"));
    КонецЦикла;
    ФоновыеЗадания.ОжидатьВсе(Задания);

    // Тогда - экспортер каждого процессора закрыт один раз, успешен ровно один Закрыть
    УспешныхЗакрытий = 0;
    Для Каждого Задание Из Задания Цикл
        Ожидаем.Что(Задание.ИнформацияОбОшибке, "ошибка фонового задания").Равно(Неопределено);
        УспешныхЗакрытий = УспешныхЗакрытий + Задание.Результат;
    КонецЦикла;
    Ожидаем.Что(Сорвано.Получить(), "барьер фоновых заданий сорван").ЭтоЛожь();
    Ожидаем.Что(Экспортер.КоличествоЗакрытий.Получить(), "закрытий экспортера").Равно(КоличествоПроцессоров);
    Ожидаем.Что(УспешныхЗакрытий, "успешных Закрыть").Равно(КоличествоПроцессоров);

КонецПроцедуры

// Выполняется двумя фоновыми заданиями: на каждом процессоре задания встречаются
// на барьере и вызывают Закрыть одновременно. Барьер ограничен временем, а не числом
// витков: второе задание могло еще не получить процессорное время. Периодически
// задание уступает процессор, чтобы на одном ядре второе задание дошло до барьера.
Функция ЗакрытьПроцессорыОдновременно() Экспорт
    ТаймаутБарьераМс = 30000;
    ВитковДоУступки = 1000;
    Успешных = 0;
    Для Индекс = 0 По Процессоры.ВГраница() Цикл
        Прибыло.ИнкрементироватьИПолучить();
        Цель = 2 * (Индекс + 1);
        НачалоОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
        Витков = 0;
        Пока Прибыло.Получить() < Цель Цикл
            Витков = Витков + 1;
            Если Витков % ВитковДоУступки = 0 Тогда
                Приостановить(0);
            КонецЕсли;
            ОжиданиеМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжидания;
            Если ОжиданиеМс > ТаймаутБарьераМс Или Сорвано.Получить() Тогда
                Сорвано.Установить(Истина);
                Возврат Успешных;
            КонецЕсли;
        КонецЦикла;
        Если Процессоры[Индекс].Закрыть().Успешно() Тогда
            Успешных = Успешных + 1;
        КонецЕсли;
    КонецЦикла;
    Возврат Успешных;
КонецФункции

&Тест
Процедура ОбработатьКогдаЗакрыт() Экспорт

    // Дано - закрытый процессор (строки 43-44: ранний выход)
    Процессор = Новый ОтелБазовыйПакетныйПроцессор(Неопределено, "тест", 10, 5);
    Процессор.Закрыть();

    // Когда - обработка элемента на закрытом процессоре
    Процессор.Обработать("элемент");

    // Тогда - элемент не считается отброшенным (ранний выход до проверки буфера)
    Ожидаем.Что(Процессор.КоличествоОтброшенных()).Равно(0);

КонецПроцедуры

&Тест
Процедура ОбработатьПереполнениеБуфера() Экспорт

    // Дано - очередь и пакет размером 1: фоновое задание 500 мс экспортирует первый элемент,
    // второй элемент заполняет очередь
    Экспортер = СчитающийМедленныйЭкспортер();
    Процессор = Новый ОтелБазовыйПакетныйПроцессор(Экспортер, "тест", 1, 1);
    Процессор.Обработать("первый");
    ДождатьсяНачалаЭкспорта(Экспортер);
    Процессор.Обработать("второй");

    // Когда - добавляем элемент при полной очереди
    Процессор.Обработать("третий");

    // Тогда - элемент отброшен
    Ожидаем.Что(Процессор.КоличествоОтброшенных()).Равно(1);

    Процессор.Закрыть();

КонецПроцедуры

&Тест
Процедура КоличествоОтброшенных() Экспорт

    // Дано (строки 141-142: геттер КоличествоОтброшенных)
    Процессор = Новый ОтелБазовыйПакетныйПроцессор(Неопределено, "тест");

    // Когда / Тогда - начальное значение
    Ожидаем.Что(Процессор.КоличествоОтброшенных()).Равно(0);

    Процессор.Закрыть();

КонецПроцедуры

&Тест
Процедура ЗакрытьКогдаУжеЗакрыт() Экспорт

    // Дано - закрытый процессор (строки 88-89: идемпотентность)
    Процессор = Новый ОтелБазовыйПакетныйПроцессор(Неопределено, "тест");
    Процессор.Закрыть();

    // Когда - повторное закрытие
    Результат = Процессор.Закрыть();

    // Тогда - возвращает ошибку
    Ожидаем.Что(Результат.Успешно()).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ЗакрытьСОшибкойЭкспорта() Экспорт

    // Дано - экспортер выбрасывает исключение (строки 104-105)
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерСпанов"));
    МокЭкспортер.Когда().Экспортировать(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
        .ТогдаВыбрасываетИсключение("ошибка экспорта");
    Процессор = Новый ОтелБазовыйПакетныйПроцессор(МокЭкспортер, "тест", 2048, 512);
    Процессор.Обработать("элемент");

    // Когда
    Результат = Процессор.Закрыть();

    // Тогда - возвращает ошибку
    Ожидаем.Что(Результат.Успешно()).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ЗакрытьСТаймаутомЭкспорта() Экспорт

    // Дано - медленный экспортер (строки 101-102: таймаут при экспорте)
    ПутьКФикстуре = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "МедленныйЭкспортер.os");
    МедленныйЭкспортер = ЗагрузитьСценарий(ПутьКФикстуре);
    Процессор = Новый ОтелБазовыйПакетныйПроцессор(МедленныйЭкспортер, "тест", 2048, 512);
    Процессор.Обработать("элемент");

    // Когда - 1мс таймаут, экспортер спит 100мс
    Результат = Процессор.Закрыть(1);

    // Тогда - таймаут
    Ожидаем.Что(Результат.Успешно()).Равно(Ложь);

КонецПроцедуры

