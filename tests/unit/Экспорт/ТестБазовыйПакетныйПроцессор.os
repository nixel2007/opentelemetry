&Тест
Процедура СброситьБуферЖдетПакетИзвлеченныйКонкурентнымЭкспортом() Экспорт

    // Дано - фоновый сброс извлек пакет из буфера и экспортирует его 500 мс
    Экспортер = СчитающийМедленныйЭкспортер();
    Процессоры = Новый Массив();
    Процессоры.Добавить(Новый ОтелБазовыйПакетныйПроцессор(Экспортер, "тест", 2048, 512));
    Процессоры[0].Обработать("элемент");
    Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "СброситьБуферПервогоПроцессора");
    ДождатьсяНачалаЭкспорта(Экспортер);

    // Когда - буфер уже пуст, но пакет еще не отправлен
    Результат = Процессоры[0].СброситьБуфер(10000);
    ЭкспортированоКВозврату = Экспортер.Экспортировано.Получить();
    Задание.ОжидатьЗавершения();

    // Тогда - сброс вернулся только после отправки пакета
    Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
    Ожидаем.Что(ЭкспортированоКВозврату, "экспортировано к возврату СброситьБуфер").Равно(1);

КонецПроцедуры

&Тест
Процедура ЗакрытьЖдетПакетИзвлеченныйКонкурентнымЭкспортом() Экспорт

    // Дано - фоновый сброс извлек пакет из буфера и экспортирует его 500 мс
    Экспортер = СчитающийМедленныйЭкспортер();
    Процессоры = Новый Массив();
    Процессоры.Добавить(Новый ОтелБазовыйПакетныйПроцессор(Экспортер, "тест", 2048, 512));
    Процессоры[0].Обработать("элемент");
    Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "СброситьБуферПервогоПроцессора");
    ДождатьсяНачалаЭкспорта(Экспортер);

    // Когда
    РезультатЗакрытия = Процессоры[0].Закрыть(10000);
    Задание.ОжидатьЗавершения();

    // Тогда - экспортер закрыт после отправки пакета, элемент не потерян
    Ожидаем.Что(Задание.ИнформацияОбОшибке, "ошибка фонового задания").Равно(Неопределено);
    Ожидаем.Что(РезультатЗакрытия.Успешно()).ЭтоИстина();
    Ожидаем.Что(Задание.Результат.Успешно(), "результат фонового сброса").ЭтоИстина();
    Ожидаем.Что(Экспортер.Экспортировано.Получить(), "экспортировано").Равно(1);

КонецПроцедуры

Функция СчитающийМедленныйЭкспортер()
    Возврат ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "СчитающийМедленныйЭкспортер.os"));
КонецФункции

Функция СброситьБуферПервогоПроцессора() Экспорт
    Возврат Процессоры[0].СброситьБуфер();
КонецФункции

Процедура ДождатьсяНачалаЭкспорта(Экспортер)
    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Пока НЕ Экспортер.НачатЭкспорт.Получить() Цикл
        Если ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало > 10000 Тогда
            ВызватьИсключение "Фоновый экспорт не начался за 10 с";
        КонецЕсли;
        Приостановить(5);
    КонецЦикла;
КонецПроцедуры

&Тест
Процедура ЗапуститьФоновыйЭкспортДважды() Экспорт

    // Дано - процессор с коротким интервалом (строки 148-149: идемпотентность запуска)
    Процессор = Новый ОтелБазовыйПакетныйПроцессор(Неопределено, "тест", 2048, 512, 50);

    // Когда - дважды запускаем фоновый экспорт
    Процессор.ЗапуститьФоновыйЭкспорт();
    Процессор.ЗапуститьФоновыйЭкспорт(); // идемпотентный - второй вызов игнорируется

    // Тогда - закрытие проходит успешно
    Результат = Процессор.Закрыть();
    Ожидаем.Что(Результат.Успешно()).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ПринудительноВыгрузитьПустойБуфер() Экспорт

    // Дано - процессор без Обработать вызовов (пустой буфер, строка 133: Успешно)
    Процессор = Новый ОтелБазовыйПакетныйПроцессор(Неопределено, "тест");

    // Когда - форс-флаш на пустом буфере
    Результат = Процессор.ПринудительноВыгрузитьСРезультатом();

    // Тогда - успех (ЭкспортироватьВсеПакеты возвращает Успех при пустом буфере)
    Ожидаем.Что(Результат.Успешно()).Равно(Истина);

    Процессор.Закрыть();

КонецПроцедуры

&Тест
Процедура ПакетОграниченМаксРазмером() Экспорт

    // Дано - процессор с МаксРазмерПакета=2, добавляем 3 элемента (строки 235, 244-245)
    Процессор = Новый ОтелБазовыйПакетныйПроцессор(Неопределено, "тест", 2048, 2);
    Процессор.Обработать("элемент-1");
    Процессор.Обработать("элемент-2");
    Процессор.Обработать("элемент-3");

    // Когда - первая выгрузка берёт только 2 элемента, остаток в НовыйБуфер
    Результат = Процессор.ПринудительноВыгрузитьСРезультатом();

    // Тогда - все элементы обработаны, результат успешный
    Ожидаем.Что(Результат.Успешно()).Равно(Истина);

    Процессор.Закрыть();

КонецПроцедуры

// Shutdown SHOULD укладываться в таймаут и сообщать об успехе, ошибке или таймауте:
// ожидание фонового экспорта, финальный экспорт и закрытие экспортера идут в пределах
// одного срока, результат закрытия экспортера входит в результат

&Тест
Процедура ЗакрытьНеЖдетИнтервалФоновогоЭкспорта() Экспорт

    // Дано - фоновый экспорт ждет длинный интервал
    Процессор = Новый ОтелБазовыйПакетныйПроцессор(Неопределено, "тест", 2048, 512, 60000);
    Процессор.ЗапуститьФоновыйЭкспорт();
    Приостановить(50);

    // Когда
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Результат = Процессор.Закрыть(5000);
    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;

    // Тогда - фоновое задание остановлено без ожидания интервала, таймаута нет
    Ожидаем.Что(Результат.Успешно(), Результат.Описание()).ЭтоИстина();
    Ожидаем.Что(ДлительностьМс < 2000, ДлительностьМс).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗакрытьСообщаетОшибкуЗакрытияЭкспортера() Экспорт

    // Дано
    Экспортер = ЭкспортерСРезультатомЗакрытия(ОтелРезультатыЗакрытия.Ошибка("сбой закрытия экспортера"));
    Процессор = Новый ОтелБазовыйПакетныйПроцессор(Экспортер, "тест", 2048, 512);
    Процессор.Обработать("элемент");

    // Когда
    Результат = Процессор.Закрыть(5000);

    // Тогда
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
    Ожидаем.Что(СтрНайти(Результат.Описание(), "сбой закрытия экспортера") > 0, Результат.Описание()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗакрытьПередаетЭкспортеруОставшеесяВремя() Экспорт

    // Дано
    Экспортер = ЭкспортерСРезультатомЗакрытия(ОтелРезультатыЗакрытия.Успех());
    Процессор = Новый ОтелБазовыйПакетныйПроцессор(Экспортер, "тест", 2048, 512);

    // Когда
    Результат = Процессор.Закрыть(5000);

    // Тогда
    Ожидаем.Что(Результат.Успешно(), Результат.Описание()).ЭтоИстина();
    Ожидаем.Что(Экспортер.ПереданныйТаймаут > 4000 И Экспортер.ПереданныйТаймаут <= 5000, Экспортер.ПереданныйТаймаут)
        .ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗакрытьСообщаетТаймаутДолгогоЗакрытияЭкспортера() Экспорт

    // Дано - экспортер закрывается дольше срока
    Экспортер = ЭкспортерСРезультатомЗакрытия(ОтелРезультатыЗакрытия.Успех(), 300);
    Процессор = Новый ОтелБазовыйПакетныйПроцессор(Экспортер, "тест", 2048, 512);

    // Когда
    Результат = Процессор.Закрыть(100);

    // Тогда
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
    Ожидаем.Что(Результат.ИстекТаймаут()).ЭтоИстина();

КонецПроцедуры

// OnEnd/OnEmit SHOULD NOT блокировать вызывающий поток, End MUST NOT выполнять блокирующий
// ввод-вывод: экспорт выполняет фоновое задание, которое запускается с первым элементом;
// ForceFlush MUST соблюдать таймаут и при экспорте, идущем в другом потоке

&Тест
Процедура ОбработатьНеЭкспортируетВВызывающемПотоке() Экспорт

    // Дано - пакет из одного элемента, экспорт длится 500 мс
    Экспортер = СчитающийМедленныйЭкспортер();
    Процессор = Новый ОтелБазовыйПакетныйПроцессор(Экспортер, "тест", 2048, 1);

    // Когда
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Процессор.Обработать("элемент");
    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;

    // Тогда - вызывающий поток не ждал экспорт, полный пакет экспортировало фоновое задание
    Ожидаем.Что(ДлительностьМс < 300, ДлительностьМс).ЭтоИстина();
    ДождатьсяЭкспорта(Экспортер, 1);
    Процессор.Закрыть();

КонецПроцедуры

&Тест
Процедура ЭкспортПоИнтервалуБезЯвногоЗапускаФоновогоЭкспорта() Экспорт

    // Дано - интервал 100 мс, пакет не заполнен, ЗапуститьФоновыйЭкспорт не вызывался
    Экспортер = СчитающийМедленныйЭкспортер();
    Процессор = Новый ОтелБазовыйПакетныйПроцессор(Экспортер, "тест", 2048, 512, 100);

    // Когда
    Процессор.Обработать("элемент");

    // Тогда - элемент экспортирован по истечении интервала
    ДождатьсяЭкспорта(Экспортер, 1);
    Процессор.Закрыть();

КонецПроцедуры

&Тест
Процедура СброситьБуферСоблюдаетТаймаутПриКонкурентномЭкспорте() Экспорт

    // Дано - фоновый сброс экспортирует первый элемент 500 мс, в буфере второй
    Экспортер = СчитающийМедленныйЭкспортер();
    Процессоры = Новый Массив();
    Процессоры.Добавить(Новый ОтелБазовыйПакетныйПроцессор(Экспортер, "тест", 2048, 512));
    Процессоры[0].Обработать("первый");
    Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "СброситьБуферПервогоПроцессора");
    ДождатьсяНачалаЭкспорта(Экспортер);
    Процессоры[0].Обработать("второй");

    // Когда
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Результат = Процессоры[0].СброситьБуфер(100);
    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
    Задание.ОжидатьЗавершения();

    // Тогда - таймаут без ожидания конкурентного экспорта
    Ожидаем.Что(Результат.ИстекТаймаут()).ЭтоИстина();
    Ожидаем.Что(ДлительностьМс < 400, ДлительностьМс).ЭтоИстина();
    Процессоры[0].Закрыть();

КонецПроцедуры

Процедура ДождатьсяЭкспорта(Экспортер, Количество)
    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Пока Экспортер.Экспортировано.Получить() < Количество Цикл
        Если ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало > 3000 Тогда
            ВызватьИсключение СтрШаблон("За 3 с экспортировано %1 из %2", Экспортер.Экспортировано.Получить(),
                Количество);
        КонецЕсли;
        Приостановить(10);
    КонецЦикла;
КонецПроцедуры

Функция ЭкспортерСРезультатомЗакрытия(РезультатЗакрытия, ЗадержкаЗакрытияМс = 0)
    Экспортер = ЗагрузитьСценарийИзСтроки("Перем РезультатЗакрытия Экспорт;
    |Перем ЗадержкаЗакрытияМс Экспорт;
    |Перем ПереданныйТаймаут Экспорт;
    |Функция Экспортировать(Элементы, ТаймаутМс = Неопределено) Экспорт
    |    Возврат Истина;
    |КонецФункции
    |Процедура СброситьБуфер(ТаймаутМс = 0) Экспорт
    |КонецПроцедуры
    |Функция Закрыть(ТаймаутМс = 0) Экспорт
    |    ПереданныйТаймаут = ТаймаутМс;
    |    Если ЗадержкаЗакрытияМс > 0 Тогда
    |        Приостановить(ЗадержкаЗакрытияМс);
    |    КонецЕсли;
    |    Возврат РезультатЗакрытия;
    |КонецФункции");
    Экспортер.РезультатЗакрытия = РезультатЗакрытия;
    Экспортер.ЗадержкаЗакрытияМс = ЗадержкаЗакрытияМс;
    Возврат Экспортер;
КонецФункции
