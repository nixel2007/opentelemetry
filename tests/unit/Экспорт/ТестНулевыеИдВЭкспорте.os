// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// Сквозной регрессионный набор: ни один экспортированный OTLP-объект не содержит нулевых
// TraceId/SpanId, когда текущим сделан невалидный спан или извлечен traceparent с нулевыми ID.
//
// Проверка идет по итоговой выгрузке экспортеров, а не по отдельным классам, поэтому
// ловит утечку нулевых ID через любой путь: спаны (включая parentSpanId и линки), логи,
// экземпляры метрик. Точечные проверки путей создания спана - в ТестНевалидныйРодитель.
#Использовать "../../.."
#Использовать asserts

Перем НулевойИдСпана;

&Тест
Процедура СпаныПодНевалиднымСпаномЭкспортируютсяБезНулевыхИд() Экспорт

    // Дано - невалидный спан сделан текущим
    ОтелКонтекст.Очистить();
    Транспорт = Новый ОтелВПамятьТранспорт();
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина),
        Новый ОтелПростойПроцессорСпанов(Новый ОтелЭкспортерСпанов(Транспорт)));
    Трассировщик = Провайдер.ПолучитьТрассировщик("регрессия");
    НевалидныйСпан = ОтелСпаны.Невалидный();
    НевалидныйКонтекст = НевалидныйСпан.КонтекстСпана();
    Токен = ОтелКонтекст.СделатьСпанТекущим(НевалидныйСпан);

    // Когда - спаны создаются всеми путями
    Спаны = Новый Массив;
    Спаны.Добавить(Трассировщик.НачатьСпан("неявный-родитель"));
    Спаны.Добавить(Трассировщик.НачатьДочернийСпан("явный-спан", НевалидныйСпан));
    Спаны.Добавить(Трассировщик.НачатьДочернийСпан("явный-контекст", НевалидныйКонтекст));
    КонтекстСНевалиднымСпаном = ОтелКонтекст.Текущий();
    СпанПостроителя = Трассировщик.ПостроительСпана("построитель")
        .УстановитьРодителя(КонтекстСНевалиднымСпаном)
        .НачатьСпан();
    Спаны.Добавить(СпанПостроителя);
    СпанСЛинком = Трассировщик.ПостроительСпана("линк-без-атрибутов")
        .ДобавитьЛинк(НевалидныйКонтекст)
        .НачатьСпан();
    Спаны.Добавить(СпанСЛинком);
    ОтелКонтекст.ОтсоединитьКонтекст(Токен);
    Для Каждого Спан Из Спаны Цикл
        Спан.Завершить();
    КонецЦикла;
    Провайдер.Закрыть();

    // Тогда
    Отправленные = Транспорт.ПолучитьОтправленные();
    Ожидаем.Что(Отправленные.Количество(), "спаны экспортированы").Больше(0);
    Ожидаем.Что(СтрНайти(ВJSON(Отправленные), НулевойИдСпана), "нулевые ID в экспорте спанов").Равно(0);

КонецПроцедуры

&Тест
Процедура СпанПослеИзвлеченияНулевогоTraceparentКорневой() Экспорт

    // Дано - входящий traceparent с нулевыми ID
    ОтелКонтекст.Очистить();
    Транспорт = Новый ОтелВПамятьТранспорт();
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина),
        Новый ОтелПростойПроцессорСпанов(Новый ОтелЭкспортерСпанов(Транспорт)));
    Трассировщик = Провайдер.ПолучитьТрассировщик("регрессия");
    Носитель = Новый Соответствие;
    Носитель.Вставить("traceparent", "00-00000000000000000000000000000000-0000000000000000-01");
    Контекст = Новый ОтелW3CПропагатор().Извлечь(ОтелКонтекст.Текущий(), Носитель);

    // Когда
    Токен = ОтелКонтекст.ПрисоединитьКонтекст(Контекст);
    Спан = Трассировщик.НачатьСпан("входящий-запрос");
    ОтелКонтекст.ОтсоединитьКонтекст(Токен);
    Спан.Завершить();
    Провайдер.Закрыть();

    // Тогда - спан корневой, нулевых ID в экспорте нет
    Ожидаем.Что(Спан.ИдРодительскогоСпана()).Равно("");
    Ожидаем.Что(СтрНайти(ВJSON(Транспорт.ПолучитьОтправленные()), НулевойИдСпана)).Равно(0);

КонецПроцедуры

&Тест
Процедура ЛогиПодНевалиднымСпаномЭкспортируютсяБезНулевыхИд() Экспорт

    // Дано - невалидный спан сделан текущим
    ОтелКонтекст.Очистить();
    Транспорт = Новый ОтелВПамятьТранспорт();
    Провайдер = Новый ОтелПровайдерЛогирования(Новый ОтелРесурс(Истина),
        Новый ОтелПростойПроцессорЛогов(Новый ОтелЭкспортерЛогов(Транспорт)));
    Логгер = Провайдер.ПолучитьЛоггер("регрессия");
    Токен = ОтелКонтекст.СделатьСпанТекущим(ОтелСпаны.Невалидный());

    // Когда
    Запись = Логгер.СоздатьЗаписьЛога();
    Запись.УстановитьТело("запись под невалидным спаном");
    Логгер.Записать(Запись);
    ОтелКонтекст.ОтсоединитьКонтекст(Токен);
    Провайдер.Закрыть();

    // Тогда
    Отправленные = Транспорт.ПолучитьОтправленные();
    Ожидаем.Что(Отправленные.Количество(), "лог экспортирован").Больше(0);
    Ожидаем.Что(СтрНайти(ВJSON(Отправленные), НулевойИдСпана), "нулевые ID в экспорте логов").Равно(0);

КонецПроцедуры

&Тест
Процедура ЭкземплярыПодНевалиднымСпаномЭкспортируютсяБезНулевыхИд() Экспорт

    // Дано - фильтр экземпляров ВсегдаВключен, невалидный спан сделан текущим
    ОтелКонтекст.Очистить();
    Транспорт = Новый ОтелВПамятьТранспорт();
    Читатель = Новый ОтелПериодическийЧитательМетрик(Новый ОтелЭкспортерМетрик(Транспорт), 3600000);
    Провайдер = Новый ОтелПостроительПровайдераМетрик()
        .ЗарегистрироватьЧитатель(Читатель)
        .УстановитьФильтрЭкземпляров(ОтелФильтрЭкземпляров.ВсегдаВключен())
        .Построить();
    Счетчик = Провайдер.ПолучитьМетр("регрессия").СоздатьСчетчик("regression.counter");
    Токен = ОтелКонтекст.СделатьСпанТекущим(ОтелСпаны.Невалидный());

    // Когда
    Счетчик.Добавить(5);
    ОтелКонтекст.ОтсоединитьКонтекст(Токен);
    Провайдер.СброситьБуфер();
    Провайдер.Закрыть();

    // Тогда - экземпляр захвачен, но без нулевых ID
    Текст = ВJSON(Транспорт.ПолучитьОтправленные());
    Ожидаем.Что(СтрНайти(Текст, "exemplars"), "экземпляр захвачен").Больше(0);
    Ожидаем.Что(СтрНайти(Текст, НулевойИдСпана), "нулевые ID в экспорте метрик").Равно(0);

КонецПроцедуры

Функция ВJSON(Значение)
    Запись = Новый ЗаписьJSON();
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Значение);
    Возврат Запись.Закрыть();
КонецФункции

НулевойИдСпана = "0000000000000000";
