// Спецификация OTLP Metrics Exporter (LowMemory): Delta для синхронных Counter и Histogram,
// Cumulative для UpDownCounter, асинхронных Counter и UpDownCounter

&ПараметризованныйТест
&ИсточникЗначение("counter|Дельта")
&ИсточникЗначение("histogram|Дельта")
&ИсточникЗначение("up_down_counter|Кумулятивная")
&ИсточникЗначение("observable_counter|Кумулятивная")
&ИсточникЗначение("observable_up_down_counter|Кумулятивная")
Процедура НизкоеПотреблениеПамятиПоВидуИнструмента(Случай) Экспорт

    // Дано
    Части = СтрРазделить(Случай, "|");
    Селектор = ОтелСелекторВременнойАгрегации.НизкоеПотреблениеПамяти();

    // Когда
    Результат = Селектор.Применить(Части[0]);

    // Тогда
    Ожидаем.Что(Результат).Равно(ВременнаяАгрегацияПоИмени(Части[1]));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("counter|Дельта")
&ИсточникЗначение("observable_counter|Дельта")
&ИсточникЗначение("histogram|Дельта")
&ИсточникЗначение("up_down_counter|Кумулятивная")
&ИсточникЗначение("observable_up_down_counter|Кумулятивная")
Процедура ПредпочтительноДельтаПоВидуИнструмента(Случай) Экспорт

    // Дано
    Части = СтрРазделить(Случай, "|");
    Селектор = ОтелСелекторВременнойАгрегации.ПредпочтительноДельта();

    // Когда
    Результат = Селектор.Применить(Части[0]);

    // Тогда
    Ожидаем.Что(Результат).Равно(ВременнаяАгрегацияПоИмени(Части[1]));

КонецПроцедуры

Функция ВременнаяАгрегацияПоИмени(Имя)
    Если Имя = "Дельта" Тогда
        Возврат ОтелВременнаяАгрегация.Дельта();
    КонецЕсли;
    Возврат ОтелВременнаяАгрегация.Кумулятивная();
КонецФункции

&ПараметризованныйТест
&ИсточникЗначение("Counter|counter")
&ИсточникЗначение("UpDownCounter|up_down_counter")
&ИсточникЗначение("Histogram|histogram")
&ИсточникЗначение("ExponentialHistogram|histogram")
&ИсточникЗначение("Gauge|gauge")
&ИсточникЗначение("ObservableCounter|observable_counter")
&ИсточникЗначение("ObservableUpDownCounter|observable_up_down_counter")
&ИсточникЗначение("ObservableGauge|observable_gauge")
Процедура ТипИнструментаСелектораПоВиду(Случай) Экспорт

    // Дано
    Части = СтрРазделить(Случай, "|");

    // Когда
    Тип = ОтелСелекторВременнойАгрегации.ТипИнструментаДляВида(Части[0]);

    // Тогда
    Ожидаем.Что(Тип).Равно(Части[1]);

КонецПроцедуры
