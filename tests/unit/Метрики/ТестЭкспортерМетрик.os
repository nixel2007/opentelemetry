&Тест
Процедура ЭкспортСНеУказаннойТемпоральностьюСелектораВозвращаетЛожь() Экспорт

	// Дано - селектор экспортера не задает временную агрегацию для типа инструмента
	Транспорт = Новый ОтелВПамятьТранспорт();
	Селектор = ЗагрузитьСценарийИзСтроки("Функция Применить(ТипИнструмента) Экспорт
	|    Возврат ОтелВременнаяАгрегация.НеУказана();
	|КонецФункции");
	Экспортер = Новый ОтелЭкспортерМетрик(Транспорт, Селектор);
	МассивДанных = Новый Массив();
	МассивДанных.Добавить(СоздатьДанныеМетрикиСумма("test.metric", 10));

	// Когда
	Результат = Экспортер.Экспортировать(МассивДанных);

	// Тогда
	Ожидаем.Что(Результат).Равно(Ложь);
	Ожидаем.Что(Транспорт.ПолучитьОтправленные().Количество()).Равно(0);

КонецПроцедуры

