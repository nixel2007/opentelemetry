&Тест
Процедура ЭкспортПустогоМассиваВозвращаетУспех() Экспорт

	// Дано
	Транспорт = Новый ОтелВПамятьТранспорт();
	Экспортер = Новый ОтелЭкспортерМетрик(Транспорт);

	// Когда
	Результат = Экспортер.Экспортировать(Новый Массив());

	// Тогда - пустой массив → успех, транспорт не вызывается
	Ожидаем.Что(Результат).Равно(Истина);
	Ожидаем.Что(Транспорт.ПолучитьОтправленные().Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ЭкспортПослеЗакрытияВозвращаетЛожь() Экспорт

	// Дано
	Транспорт = Новый ОтелВПамятьТранспорт();
	Экспортер = Новый ОтелЭкспортерМетрик(Транспорт);
	Экспортер.Закрыть();

	// Когда - экспорт после закрытия (даже с пустым массивом - проверка Закрыт идёт первой)
	МассивДанных = Новый Массив();
	МассивДанных.Добавить(СоздатьДанныеМетрикиСумма("test.closed", 1));
	Результат = Экспортер.Экспортировать(МассивДанных);

	// Тогда
	Ожидаем.Что(Результат).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ЭкспортВалидныхДанныхМетрики() Экспорт

	// Дано
	Транспорт = Новый ОтелВПамятьТранспорт();
	Экспортер = Новый ОтелЭкспортерМетрик(Транспорт);
	МассивДанных = Новый Массив();
	МассивДанных.Добавить(СоздатьДанныеМетрикиСумма("test.counter", 42));

	// Когда
	Результат = Экспортер.Экспортировать(МассивДанных);

	// Тогда - транспорт получил данные по пути /v1/metrics
	Ожидаем.Что(Результат).Равно(Истина);
	Ожидаем.Что(Транспорт.ПолучитьОтправленные().Количество()).Равно(1);
	Ожидаем.Что(
		Транспорт.ПолучитьОтправленные()[0].Получить("Путь")
	).Равно("/v1/metrics");

КонецПроцедуры

&Тест
Процедура ВременнаяАгрегацияСобранныхДанныхПриоритетнееСелектора() Экспорт

	// Дано - читатель собрал поток кумулятивно (например, асинхронный счетчик при LowMemory),
	// а селектор экспортера по типу метрики дал бы дельту
	Транспорт = Новый ОтелВПамятьТранспорт();
	Экспортер = Новый ОтелЭкспортерМетрик(Транспорт, ОтелСелекторВременнойАгрегации.ПредпочтительноДельта());
	Данные = СоздатьДанныеМетрикиСумма("obs.counter", 42);
	Данные.УстановитьВременнуюАгрегацию(ОтелВременнаяАгрегация.Кумулятивная());
	МассивДанных = Новый Массив();
	МассивДанных.Добавить(Данные);

	// Когда
	Экспортер.Экспортировать(МассивДанных);

	// Тогда
	ДанныеOtlp = Транспорт.ПолучитьОтправленные()[0].Получить("Данные");
	МетрикаOtlp = ДанныеOtlp.Получить("resourceMetrics")[0].Получить("scopeMetrics")[0].Получить("metrics")[0];
	Ожидаем.Что(МетрикаOtlp.Получить("sum").Получить("aggregationTemporality"))
		.Равно(ОтелВременнаяАгрегация.Кумулятивная());

КонецПроцедуры

// У счетчика целочисленный тип значения, но Число OneScript одно для целых и дробных значений:
// дробное значение точки не округляется и выгружается как asDouble, целое - как asInt

&ПараметризованныйТест
&ИсточникЗначение("2.5|asDouble|asInt")
&ИсточникЗначение("-0.25|asDouble|asInt")
&ИсточникЗначение("42|asInt|asDouble")
Процедура ДробноеЗначениеСчетчикаНеОкругляется(Случай) Экспорт

	// Дано - значение|поле значения|отсутствующее поле
	Части = СтрРазделить(Случай, "|");
	Значение = Число(Части[0]);
	Транспорт = Новый ОтелВПамятьТранспорт();
	Экспортер = Новый ОтелЭкспортерМетрик(Транспорт);
	МассивДанных = Новый Массив();
	МассивДанных.Добавить(СоздатьДанныеМетрикиСумма("bytes.sent", Значение));

	// Когда
	Экспортер.Экспортировать(МассивДанных);

	// Тогда
	ДанныеOtlp = Транспорт.ПолучитьОтправленные()[0].Получить("Данные");
	МетрикаOtlp = ДанныеOtlp.Получить("resourceMetrics")[0].Получить("scopeMetrics")[0].Получить("metrics")[0];
	Точка = МетрикаOtlp.Получить("sum").Получить("dataPoints")[0];
	Ожидаем.Что(Число(Точка.Получить(Части[1]))).Равно(Значение);
	Ожидаем.Что(Точка.Получить(Части[2])).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЭкспортНеподдерживаемогоТипаМетрикиВозвращаетЛожь() Экспорт

