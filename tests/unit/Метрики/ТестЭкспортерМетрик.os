&Тест
Процедура ЭкспортДатчикаПропускаетПроверкуТемпоральности() Экспорт

	// Дано - ВалидироватьСовместимостьДанных: тип Датчик → Продолжить (пропуск проверки темпоральности)
	Транспорт = Новый ОтелВПамятьТранспорт();
	Экспортер = Новый ОтелЭкспортерМетрик(Транспорт);

	// Точка данных без Темпоральности - для Датчика проверка пропускается
	ТочкаДанных = Новый Соответствие;
	ТочкаДанных.Вставить("value", 99.5);
	ТочкаДанных.Вставить("timeUnixNano", "0");
	ТочкаДанных.Вставить("attributes", Новый Массив());
	ТочкиДанных = Новый Массив();
	ТочкиДанных.Добавить(ТочкаДанных);

	Данные = Новый ОтелДанныеМетрики(
		Новый ОтелРесурс(),
		Новый ОтелОбластьИнструментирования("test-lib", "1.0"),
		"test.gauge", "", "",
		ОтелТипМетрики.Датчик(),
		ТочкиДанных, Ложь, "double"
	);
	МассивДанных = Новый Массив();
	МассивДанных.Добавить(Данные);

	// Когда
	Результат = Экспортер.Экспортировать(МассивДанных);

	// Тогда - Датчик успешно экспортирован без проверки темпоральности
	Ожидаем.Что(Результат).Равно(Истина);
	Ожидаем.Что(Транспорт.ПолучитьОтправленные().Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ЭкспортСводки() Экспорт

	// Дано - Summary от продюсера метрик: временной агрегации у сводки нет
	Транспорт = Новый ОтелВПамятьТранспорт();
	Экспортер = Новый ОтелЭкспортерМетрик(Транспорт);
	МассивДанных = Новый Массив();
	МассивДанных.Добавить(СоздатьДанныеСводки("rpc.duration"));

	// Когда
	Результат = Экспортер.Экспортировать(МассивДанных);

	// Тогда - точка сводки в формате OTLP, метаданных у метрики нет
	Ожидаем.Что(Результат).Равно(Истина);
	МетрикаOtlp = ПерваяМетрикаOtlp(Транспорт);
	Сводка = МетрикаOtlp.Получить("summary");
	Ожидаем.Что(Сводка.Получить("aggregationTemporality")).Равно(Неопределено);
	ТочкаOtlp = Сводка.Получить("dataPoints")[0];
	Ожидаем.Что(ТочкаOtlp.Получить("count")).Равно("12");
	Ожидаем.Что(ТочкаOtlp.Получить("sum")).Равно(5.5);
	Ожидаем.Что(ТочкаOtlp.Получить("startTimeUnixNano")).Равно("1700000000000000000");
	Ожидаем.Что(ТочкаOtlp.Получить("timeUnixNano")).Равно("1700000060000000000");
	Ожидаем.Что(ТочкаOtlp.Получить("attributes")).ИмеетДлину(0);
	Квантили = ТочкаOtlp.Получить("quantileValues");
	Ожидаем.Что(Квантили).ИмеетДлину(2);
	Ожидаем.Что(Квантили[1].Получить("quantile")).Равно(0.99);
	Ожидаем.Что(Квантили[1].Получить("value")).Равно(0.9);
	Ожидаем.Что(МетрикаOtlp.Получить("metadata")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЭкспортМетаданныхМетрики() Экспорт

	// Дано - метаданные метрики (metric.metadata), например подсказка типа Prometheus
	Транспорт = Новый ОтелВПамятьТранспорт();
	Экспортер = Новый ОтелЭкспортерМетрик(Транспорт);
	Данные = СоздатьДанныеМетрикиСумма("test.counter", 1);
	Метаданные = Новый Соответствие();
	Метаданные.Вставить("prometheus.type", "unknown");
	Данные.УстановитьМетаданные(Метаданные);
	МассивДанных = Новый Массив();
	МассивДанных.Добавить(Данные);

	// Когда
	Экспортер.Экспортировать(МассивДанных);

	// Тогда
	МетаданныеOtlp = ПерваяМетрикаOtlp(Транспорт).Получить("metadata");
	Ожидаем.Что(МетаданныеOtlp).ИмеетДлину(1);
	Ожидаем.Что(МетаданныеOtlp[0].Получить("key")).Равно("prometheus.type");
	Ожидаем.Что(МетаданныеOtlp[0].Получить("value").Получить("stringValue")).Равно("unknown");

КонецПроцедуры

// ------------------------------------------------------------------
// Служебные
// ------------------------------------------------------------------

Функция ПерваяМетрикаOtlp(Транспорт)
	ДанныеOtlp = Транспорт.ПолучитьОтправленные()[0].Получить("Данные");
	Возврат ДанныеOtlp.Получить("resourceMetrics")[0].Получить("scopeMetrics")[0].Получить("metrics")[0];
КонецФункции

Функция СоздатьДанныеСводки(ИмяМетрики)

	Квантили = Новый Массив();
	Для Каждого Пара Из СтрРазделить("0.5:0.2,0.99:0.9", ",") Цикл
		Части = СтрРазделить(Пара, ":");
		Квантиль = Новый Соответствие();
		Квантиль.Вставить("quantile", Число(Части[0]));
		Квантиль.Вставить("value", Число(Части[1]));
		Квантили.Добавить(Квантиль);
	КонецЦикла;
	ТочкаДанных = Новый Соответствие;
	ТочкаДанных.Вставить("startTimeUnixNano", "1700000000000000000");
	ТочкаДанных.Вставить("timeUnixNano", "1700000060000000000");
	ТочкаДанных.Вставить("attributes", Новый Массив());
	ТочкаДанных.Вставить("count", 12);
	ТочкаДанных.Вставить("sum", 5.5);
	ТочкаДанных.Вставить("quantileValues", Квантили);
	ТочкиДанных = Новый Массив();
	ТочкиДанных.Добавить(ТочкаДанных);

	Возврат Новый ОтелДанныеМетрики(
		Новый ОтелРесурс(),
		Новый ОтелОбластьИнструментирования("test-lib", "1.0"),
		ИмяМетрики, "", "s",
		ОтелТипМетрики.Сводка(),
		ТочкиДанных, Ложь, "double"
	);

КонецФункции

Функция СоздатьДанныеМетрикиСумма(ИмяМетрики, Значение)

	ТочкаДанных = Новый Соответствие;
	ТочкаДанных.Вставить("value", Значение);
	ТочкаДанных.Вставить("startTimeUnixNano", "0");
	ТочкаДанных.Вставить("timeUnixNano", "0");
	ТочкаДанных.Вставить("attributes", Новый Массив());
	ТочкиДанных = Новый Массив();
	ТочкиДанных.Добавить(ТочкаДанных);

	Возврат Новый ОтелДанныеМетрики(
		Новый ОтелРесурс(),
		Новый ОтелОбластьИнструментирования("test-lib", "1.0"),
		ИмяМетрики, "", "",
		ОтелТипМетрики.Сумма(),
		ТочкиДанных, Истина, "int"
	);

КонецФункции
