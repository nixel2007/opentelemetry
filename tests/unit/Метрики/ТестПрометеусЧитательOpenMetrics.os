// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
#Использовать "../../.."
#Использовать asserts
#Использовать prometheus

// Выдача читателя в text format 0.0.4 и семейства для OpenMetrics: строки UNIT, время создания
// серий _created, exemplars счетчиков и бакетов гистограмм, типы unknown, info и stateset.
// Выдачу OpenMetrics формирует библиотека prometheus, в реестре которой читатель зарегистрирован
// как custom Collector (Prometheus Exporter, Client Libraries)

// Version and Format: читатель выдает text format 0.0.4, в нем нет exemplars и времени создания
// серий

&Тест
Процедура ВыдачаВТекстовомФормате() Экспорт

    // Дано - счетчик со временем старта и exemplar
    Читатель = ЧитательСДанными(ДанныеСчетчика("jobs", 5, ЭкземплярыСчетчика()));

    // Когда
    Тело = Читатель.СобратьВТексте();
    ТипКонтента = Читатель.ContentType();

    // Тогда
    Ожидаем.Что(Тело).Равно("# TYPE jobs_total counter" + Символы.ПС + "jobs_total 5" + Символы.ПС);
    Ожидаем.Что(ТипКонтента).Равно("text/plain; version=0.0.4; charset=utf-8");

КонецПроцедуры

// Client Libraries: читатель в реестре библиотеки prometheus отдает семейства со временем
// создания и exemplars; в OpenMetrics имя семейства счетчика без суффикса _total, выдача
// завершается строкой # EOF

&Тест
Процедура РеестрБиблиотекиВыдаетOpenMetrics() Экспорт

    // Дано - счетчик со временем старта и exemplar
    Читатель = ЧитательСДанными(ДанныеСчетчика("jobs", 5, ЭкземплярыСчетчика()));

    // Когда
    Тело = ВыдачаOpenMetrics(Читатель);

    // Тогда
    ПС = Символы.ПС;
    Ожидаемое = "# TYPE jobs counter" + ПС
        + "jobs_total 5 # {" + ЛейблыТрассировки() + "} 0.7 1700000003" + ПС
        + "jobs_created 1700000000.5" + ПС
        + "# EOF" + ПС;
    Ожидаем.Что(Тело).Равно(Ожидаемое);

КонецПроцедуры

// Prometheus Compatibility / Metric Metadata: единица метрики SHOULD выводиться строкой UNIT;
// часть единицы в фигурных скобках отбрасывается и строки UNIT не дает

&Тест
Процедура ЕдиницаВыводитсяСтрокойUnit() Экспорт

    // Дано
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("unit-lib", "1.0"), Новый ОтелРесурс(Истина));
    Метр.СоздатьСчетчик("traffic", "Трафик", "By").Добавить(10);
    Метр.СоздатьГистограмму("http.duration", "", "s").Записать(0.2);
    Метр.СоздатьСчетчик("jobs", "", "{job}").Добавить(1);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Тело = ВыдачаOpenMetrics(Читатель);

    // Тогда
    ПС = Символы.ПС;
    Ожидаем.Что(Тело).Содержит("# TYPE traffic_bytes counter" + ПС + "# UNIT traffic_bytes bytes" + ПС);
    Ожидаем.Что(Тело).Содержит("# TYPE http_duration_seconds histogram" + ПС
        + "# UNIT http_duration_seconds seconds" + ПС);
    Ожидаем.Что(Тело).Содержит("# TYPE jobs counter" + ПС + "jobs_total{");
    Ожидаем.Что(СтрНайти(Тело, "# UNIT jobs")).Равно(0);

КонецПроцедуры

// Metric Metadata: у семейства одна строка UNIT - первой метрики; отличающаяся единица
// одноименной метрики отбрасывается с предупреждением, точки метрики не отбрасываются

&ПараметризованныйТест
&ИсточникЗначение("с единицей")
&ИсточникЗначение("без единицы")
Процедура ОтличающаясяЕдиницаСемействаПредупреждает(Первая) Экспорт

    // Дано - датчик size в байтах получает суффикс единицы и то же имя size_bytes, что у датчика
    //   без единицы; Первая - какая метрика собирается первой
    Ресурс = Новый ОтелРесурс(Истина);
    СЕдиницей = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("unit-lib", "1.0"), Ресурс);
    СЕдиницей.СоздатьДатчик("size", "", "By").Записать(1);
    БезЕдиницы = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("plain-lib", "1.0"), Ресурс);
    БезЕдиницы.СоздатьДатчик("size_bytes").Записать(2);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Если Первая = "с единицей" Тогда
        Читатель.ДобавитьМетр(СЕдиницей);
        Читатель.ДобавитьМетр(БезЕдиницы);
    Иначе
        Читатель.ДобавитьМетр(БезЕдиницы);
        Читатель.ДобавитьМетр(СЕдиницей);
    КонецЕсли;
    Аппендер = ПодключитьАппендер();

    // Когда
    Тело = ВыдачаOpenMetrics(Читатель);

    // Тогда - точки обеих метрик в выдаче, UNIT первой метрики
    ОтключитьАппендер(Аппендер);
    СтрокЕдиницы = ?(Первая = "с единицей", 1, 0);
    Ожидаем.Что(СтрЧислоВхождений(Тело, "# UNIT size_bytes bytes")).Равно(СтрокЕдиницы);
    Ожидаем.Что(Тело).Содержит("otel_scope_name=""unit-lib""");
    Ожидаем.Что(Тело).Содержит("otel_scope_name=""plain-lib""");
    Ожидаем.Что(ЕстьПредупреждениеСТекстом(Аппендер, "UNIT семейства 'size_bytes' не изменен")).ЭтоИстина();

КонецПроцедуры

// Prometheus Compatibility / Sums, Histograms, Summaries: время старта точки SHOULD выводиться
// временем создания серии (_created в OpenMetrics): у счетчика после значения, у гистограммы и
// сводки после _count; у датчика и немонотонной суммы (датчик Prometheus) его нет

&Тест
Процедура ВремяСозданияСчетчикаГистограммыИСводки() Экспорт

    // Дано
    Метр = МетрСДанными(ДанныеСчетчика("jobs", 5, Новый Массив()));
    Метр.Данные.Добавить(ДанныеГистограммы("latency", Новый Массив()));
    Метр.Данные.Добавить(ДанныеСводки("rpc.duration", "s"));
    Метр.Данные.Добавить(ДанныеДатчика("temperature", 20));
    Метр.Данные.Добавить(ДанныеСуммы("queue", 3, Новый Массив()));
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Тело = ВыдачаOpenMetrics(Читатель);

    // Тогда
    ПС = Символы.ПС;
    Ожидаем.Что(Тело).Содержит("jobs_total 5" + ПС + "jobs_created 1700000000.5" + ПС);
    Ожидаем.Что(Тело).Содержит("latency_count 4" + ПС + "latency_created 1700000000.5" + ПС);
    Ожидаем.Что(Тело).Содержит("rpc_duration_seconds_count 12" + ПС
        + "rpc_duration_seconds_created 1700000000.5" + ПС);
    Ожидаем.Что(СтрНайти(Тело, "temperature_created")).Равно(0);
    Ожидаем.Что(СтрНайти(Тело, "queue_created")).Равно(0);

КонецПроцедуры

// Prometheus Compatibility / Sums: у сэмпла счетчика в OpenMetrics один exemplar, выводится
// последний (SHOULD); Exemplar Conversion: trace_id, span_id и время exemplar (MUST)

&Тест
Процедура ПоследнийЭкземплярСчетчика() Экспорт

    // Дано
    Экземпляры = Новый Массив();
    Экземпляры.Добавить(Экземпляр(0.7, "1700000003000000000"));
    Экземпляры.Добавить(Экземпляр(0.9, "1700000005000000000"));
    Экземпляры.Добавить(Экземпляр(0.2, "1700000004000000000"));
    Читатель = ЧитательСДанными(ДанныеСчетчика("jobs", 5, Экземпляры));

    // Когда
    Тело = ВыдачаOpenMetrics(Читатель);

    // Тогда
    Ожидаем.Что(Тело).Содержит("jobs_total 5 # {" + ЛейблыТрассировки() + "} 0.9 1700000005" + Символы.ПС);

КонецПроцедуры

// Histograms as Prometheus Histograms: у бакета в OpenMetrics один exemplar, выводится последний
// из попавших в бакет (SHOULD); значение на границе попадает в бакет этой границы, бакет без
// exemplars выводится без него

&Тест
Процедура ПоследнийЭкземплярКаждогоБакета() Экспорт

    // Дано - границы 1 и 5
    Экземпляры = Новый Массив();
    Экземпляры.Добавить(Экземпляр(1, "1700000002000000000"));
    Экземпляры.Добавить(Экземпляр(0.5, "1700000001000000000"));
    Экземпляры.Добавить(Экземпляр(7, "1700000004000000000"));
    Читатель = ЧитательСДанными(ДанныеГистограммы("latency", Экземпляры));

    // Когда
    Тело = ВыдачаOpenMetrics(Читатель);

    // Тогда
    ПС = Символы.ПС;
    Трассировка = ЛейблыТрассировки();
    Ожидаем.Что(Тело).Содержит("latency_bucket{le=""1.0""} 2 # {" + Трассировка + "} 1 1700000002" + ПС
        + "latency_bucket{le=""5.0""} 3" + ПС
        + "latency_bucket{le=""+Inf""} 4 # {" + Трассировка + "} 7 1700000004" + ПС
        + "latency_sum 3.5" + ПС);

КонецПроцедуры

// Gauges, Summaries: exemplars датчика и сводки SHOULD отбрасываться; немонотонная сумма
// выводится датчиком, ее exemplars тоже отбрасываются

&Тест
Процедура ЭкземплярыДатчикаИСводкиОтбрасываются() Экспорт

    // Дано
    Датчик = ДанныеДатчика("temperature", 20);
    Датчик.ТочкиДанных()[0].Вставить("exemplars", ЭкземплярыСчетчика());
    Метр = МетрСДанными(Датчик);
    Метр.Данные.Добавить(ДанныеСводки("rpc.duration", "s"));
    Метр.Данные.Добавить(ДанныеСуммы("queue", 3, ЭкземплярыСчетчика()));
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Тело = ВыдачаOpenMetrics(Читатель);

    // Тогда
    Ожидаем.Что(Тело).Содержит("temperature 20" + Символы.ПС);
    Ожидаем.Что(Тело).Содержит("queue 3" + Символы.ПС);
    Ожидаем.Что(СтрНайти(Тело, " # {")).Равно(0);

КонецПроцедуры

// Exemplar Conversion: лейблы trace_id и span_id MUST быть приоритетнее одноименных атрибутов
// filtered_attributes, остальные атрибуты выводятся лейблами exemplar

&Тест
Процедура TraceIdИSpanIdПриоритетнееАтрибутовЭкземпляра() Экспорт

    // Дано
    Экземпляр = Экземпляр(0.7, "1700000003000000000", "trace_id", "from-attribute");
    ДобавитьАтрибутЭкземпляра(Экземпляр, "user", "alice");
    Экземпляры = Новый Массив();
    Экземпляры.Добавить(Экземпляр);
    Читатель = ЧитательСДанными(ДанныеСчетчика("jobs", 5, Экземпляры));

    // Когда
    Тело = ВыдачаOpenMetrics(Читатель);

    // Тогда
    Сэмпл = "jobs_total 5 # {" + ЛейблыТрассировки() + ",user=""alice""} 0.7 1700000003" + Символы.ПС;
    Ожидаем.Что(Тело).Содержит(Сэмпл);
    Ожидаем.Что(СтрНайти(Тело, "from-attribute")).Равно(0);

КонецПроцедуры

// Exemplar Conversion: filtered_attributes MUST добавляться лейблами, если не превышают лимит
// протокола: в OpenMetrics 1.0 - 128 символов (кодовых точек UTF-8) в именах и значениях лейблов
// exemplar; trace_id и span_id занимают 63 символа, лейбл k - один

&ПараметризованныйТест
&ИсточникЗначение("64||1")
&ИсточникЗначение("65||0")
&ИсточникЗначение("63|😀|1")
Процедура АтрибутыЭкземпляраВПределахЛимита(Случай) Экспорт

    // Дано - число символов x в значении|окончание значения|выводится ли атрибут
    Части = СтрРазделить(Случай, "|");
    Значение = "";
    Пока СтрДлина(Значение) < Число(Части[0]) Цикл
        Значение = Значение + "x";
    КонецЦикла;
    Значение = Значение + Части[1];
    Экземпляры = Новый Массив();
    Экземпляры.Добавить(Экземпляр(0.7, "1700000003000000000", "k", Значение));
    Читатель = ЧитательСДанными(ДанныеСчетчика("jobs", 5, Экземпляры));

    // Когда
    Тело = ВыдачаOpenMetrics(Читатель);

    // Тогда - exemplar с trace_id и span_id выводится в любом случае, атрибут - если укладывается в
    //   лимит
    Ожидаем.Что(Тело).Содержит("jobs_total 5 # {");
    Ожидаем.Что(Тело).Содержит(ЛейблыТрассировки() + "} 0.7 1700000003");
    Ожидаем.Что(СтрНайти(Тело, "k=""" + Значение + """") > 0).Равно(Части[2] = "1");

КонецПроцедуры

// Prometheus Compatibility / Gauges: OpenMetrics поддерживает типы unknown, info и stateset -
// датчик выводится по подсказке prometheus.type

&ПараметризованныйТест
&ИсточникЗначение("|# TYPE build gauge|build 1")
&ИсточникЗначение("unknown|# TYPE build unknown|build 1")
&ИсточникЗначение("unkown|# TYPE build unknown|build 1")
&ИсточникЗначение("info|# TYPE build info|build_info 1")
&ИсточникЗначение("stateset|# TYPE build stateset|build 1")
Процедура ПодсказкаТипаДатчикаВOpenMetrics(Случай) Экспорт

    // Дано - подсказка prometheus.type|строка TYPE|сэмпл
    Части = СтрРазделить(Случай, "|");
    Метаданные = Новый Соответствие();
    Если Части[0] <> "" Тогда
        Метаданные.Вставить("prometheus.type", Части[0]);
    КонецЕсли;
    Данные = ДанныеДатчика("build", 1);
    Данные.УстановитьМетаданные(Метаданные);
    Читатель = ЧитательСДанными(Данные);

    // Когда
    Тело = ВыдачаOpenMetrics(Читатель);

    // Тогда
    Ожидаем.Что(Тело).Равно(Части[1] + Символы.ПС + Части[2] + Символы.ПС + "# EOF" + Символы.ПС);

КонецПроцедуры

// Выдача OpenMetrics 1.0.0 библиотеки prometheus: читатель зарегистрирован в ее реестре.
Функция ВыдачаOpenMetrics(Читатель)
    Реестр = Новый CollectorRegistry();
    Реестр.Register(Читатель);
    Формат = Prometheus.ВыбратьФормат("application/openmetrics-text; version=1.0.0");
    Возврат Prometheus.СериализоватьВТекст(Prometheus.СобратьМетрики(Реестр), Формат);
КонецФункции

// Время старта точек данных: 1700000000.5 секунды
Функция СтартНс()
    Возврат "1700000000500000000";
КонецФункции

Функция ЛейблыТрассировки()
    Возврат "span_id=""b7ad6b7169203331"",trace_id=""0af7651916cd43dd8448eb211c80319c""";
КонецФункции

Функция ЭкземплярыСчетчика()
    Экземпляры = Новый Массив();
    Экземпляры.Добавить(Экземпляр(0.7, "1700000003000000000"));
    Возврат Экземпляры;
КонецФункции

Функция ЧитательСДанными(Данные)
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(МетрСДанными(Данные));
    Возврат Читатель;
КонецФункции

Функция ДанныеСчетчика(Имя, Значение, Экземпляры, Единица = "")
    Точка = НоваяТочка(Экземпляры);
    Точка.Вставить("value", Значение);
    Возврат НовыеДанные(Имя, Единица, ОтелТипМетрики.Сумма(), Точка, Истина);
КонецФункции

Функция ДанныеСуммы(Имя, Значение, Экземпляры)
    Точка = НоваяТочка(Экземпляры);
    Точка.Вставить("value", Значение);
    Возврат НовыеДанные(Имя, "", ОтелТипМетрики.Сумма(), Точка, Ложь);
КонецФункции

Функция ДанныеДатчика(Имя, Значение)
    Точка = НоваяТочка(Новый Массив());
    Точка.Вставить("value", Значение);
    Возврат НовыеДанные(Имя, "", ОтелТипМетрики.Датчик(), Точка, Ложь);
КонецФункции

// Гистограмма с границами 1 и 5: по бакетам 2, 1 и 1 наблюдение
Функция ДанныеГистограммы(Имя, Экземпляры)
    Границы = Новый Массив();
    Границы.Добавить(1);
    Границы.Добавить(5);
    Счетчики = Новый Массив();
    Для Каждого Количество Из СтрРазделить("2,1,1", ",") Цикл
        Счетчики.Добавить(Число(Количество));
    КонецЦикла;
    Точка = НоваяТочка(Экземпляры);
    Точка.Вставить("explicitBounds", Границы);
    Точка.Вставить("bucketCounts", Счетчики);
    Точка.Вставить("sum", 3.5);
    Точка.Вставить("count", 4);
    Возврат НовыеДанные(Имя, "", ОтелТипМетрики.Гистограмма(), Точка, Ложь);
КонецФункции

// Сводка с exemplar: 12 наблюдений, квантили 0, 0.5 и 0.99
Функция ДанныеСводки(Имя, Единица)
    Квантили = Новый Массив();
    Для Каждого Пара Из СтрРазделить("0:0.1,0.5:0.2,0.99:0.9", ",") Цикл
        Части = СтрРазделить(Пара, ":");
        Квантиль = Новый Соответствие();
        Квантиль.Вставить("quantile", Число(Части[0]));
        Квантиль.Вставить("value", Число(Части[1]));
        Квантили.Добавить(Квантиль);
    КонецЦикла;
    Точка = НоваяТочка(ЭкземплярыСчетчика());
    Точка.Вставить("count", 12);
    Точка.Вставить("sum", 5.5);
    Точка.Вставить("quantileValues", Квантили);
    Возврат НовыеДанные(Имя, Единица, ОтелТипМетрики.Сводка(), Точка, Ложь);
КонецФункции

Функция НоваяТочка(Экземпляры)
    Точка = Новый Соответствие();
    Точка.Вставить("attributes", Новый Массив());
    Точка.Вставить("startTimeUnixNano", СтартНс());
    Точка.Вставить("timeUnixNano", "1700000060000000000");
    Точка.Вставить("exemplars", Экземпляры);
    Возврат Точка;
КонецФункции

Функция НовыеДанные(Имя, Единица, ТипМетрики, Точка, Монотонный)
    Точки = Новый Массив();
    Точки.Добавить(Точка);
    Возврат Новый ОтелДанныеМетрики(Новый ОтелРесурс(Истина), Новый ОтелОбластьИнструментирования(""), Имя, "",
        Единица, ТипМетрики, Точки, Монотонный, "double");
КонецФункции

Функция Экземпляр(Значение, Время, КлючАтрибута = "", ЗначениеАтрибута = "")
    Экземпляр = Новый Соответствие();
    Экземпляр.Вставить("timeUnixNano", Время);
    Экземпляр.Вставить("asDouble", Значение);
    Экземпляр.Вставить("traceId", "0af7651916cd43dd8448eb211c80319c");
    Экземпляр.Вставить("spanId", "b7ad6b7169203331");
    Если КлючАтрибута <> "" Тогда
        ДобавитьАтрибутЭкземпляра(Экземпляр, КлючАтрибута, ЗначениеАтрибута);
    КонецЕсли;
    Возврат Экземпляр;
КонецФункции

Процедура ДобавитьАтрибутЭкземпляра(Экземпляр, Ключ, Значение)
    Атрибуты = Экземпляр.Получить("filteredAttributes");
    Если Атрибуты = Неопределено Тогда
        Атрибуты = Новый Массив();
        Экземпляр.Вставить("filteredAttributes", Атрибуты);
    КонецЕсли;
    ЗначениеAnyValue = Новый Соответствие();
    ЗначениеAnyValue.Вставить("stringValue", Значение);
    Атрибут = Новый Соответствие();
    Атрибут.Вставить("key", Ключ);
    Атрибут.Вставить("value", ЗначениеAnyValue);
    Атрибуты.Добавить(Атрибут);
КонецПроцедуры

// Метр, отдающий читателю заданные данные метрики.
Функция МетрСДанными(ДанныеМетрики)
    Текст = "Перем Область Экспорт;
    |Перем Данные Экспорт;
    |Функция ОбластьИнструментирования() Экспорт
    |    Возврат Область;
    |КонецФункции
    |Функция СобратьДляЧитателя(Читатель, ВремяСбора = Неопределено, Ошибки = Неопределено) Экспорт
    |    Возврат Данные;
    |КонецФункции
    |Данные = Новый Массив;";
    Метр = ЗагрузитьСценарийИзСтроки(Текст);
    Метр.Область = Новый ОтелОбластьИнструментирования("");
    Метр.Данные.Добавить(ДанныеМетрики);
    Возврат Метр;
КонецФункции

Функция ПодключитьАппендер()
    Текст = "Перем События Экспорт;
    |Процедура ВывестиСобытие(Событие) Экспорт
    |    События.Добавить(Событие);
    |КонецПроцедуры
    |Процедура Закрыть() Экспорт
    |КонецПроцедуры
    |Процедура УстановитьСвойство(Имя, Значение) Экспорт
    |КонецПроцедуры
    |События = Новый Массив();";
    Аппендер = ЗагрузитьСценарийИзСтроки(Текст);
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);
    Возврат Аппендер;
КонецФункции

Процедура ОтключитьАппендер(Аппендер)
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics");
    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);
КонецПроцедуры

Функция ЕстьПредупреждениеСТекстом(Аппендер, Текст)
    Для Каждого Событие Из Аппендер.События Цикл
        Если Событие.ПолучитьУровень() = УровниЛога.Предупреждение
                И СтрНайти(Событие.ПолучитьСообщение(), Текст) > 0 Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции
