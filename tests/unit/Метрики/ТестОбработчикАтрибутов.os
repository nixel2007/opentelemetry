#Использовать "../../.."
#Использовать asserts

// ============================================================
// ОтелОбработчикАтрибутов - фильтр атрибутов потока метрики (attribute_keys View)
// ============================================================

&Тест
Процедура БезСписковАтрибутыНеМеняются() Экспорт

	// Дано
	Обработчик = Новый ОтелОбработчикАтрибутов();
	Атрибуты = АтрибутыСКлючами("http.method", "db.system");

	// Когда
	Результат = Обработчик.Обработать(Атрибуты);

	// Тогда
	Ожидаем.Что(Результат = Атрибуты, "исходный объект").ЭтоИстина();
	Ожидаем.Что(Обработчик.БезФильтра()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РазрешенныеКлючиОставляютТолькоСвои() Экспорт

	// Дано
	Обработчик = Новый ОтелОбработчикАтрибутов(Ключи("http.method"));

	// Когда
	Результат = Обработчик.Обработать(АтрибутыСКлючами("http.method", "db.system"));

	// Тогда
	Ожидаем.Что(Результат.ВСоответствие()).ИмеетДлину(1);
	Ожидаем.Что(Результат.Получить("http.method")).Равно("значение http.method");

КонецПроцедуры

&Тест
Процедура ИсключенныеКлючиПриоритетнееРазрешенных() Экспорт

	// Дано
	Обработчик = Новый ОтелОбработчикАтрибутов(Ключи("*"), Ключи("secret.*"));

	// Когда
	Результат = Обработчик.Обработать(АтрибутыСКлючами("secret.token", "user.id"));

	// Тогда
	Ожидаем.Что(Результат.ВСоответствие()).ИмеетДлину(1);
	Ожидаем.Что(Результат.Получить("user.id")).Равно("значение user.id");

КонецПроцедуры

// Ключ в списке - точное значение или шаблон: ? - любой один символ, * - любое число любых
// символов, в том числе ни одного; сравнение с учетом регистра (схема конфигурации,
// IncludeExclude). Остальные символы шаблона, включая точку и скобки, сравниваются как есть.

&ПараметризованныйТест
&ИсточникЗначение("http.*|http.method|Истина")
&ИсточникЗначение("http.*|http.|Истина")
&ИсточникЗначение("http.*|db.system|Ложь")
&ИсточникЗначение("http.*|HTTP.method|Ложь")
&ИсточникЗначение("*.id|user.id|Истина")
&ИсточникЗначение("*|любой.ключ|Истина")
&ИсточникЗначение("code.?|code.a|Истина")
&ИсточникЗначение("code.?|code.ab|Ложь")
&ИсточникЗначение("code.?|code.|Ложь")
&ИсточникЗначение("a*b*c|a-b-c|Истина")
&ИсточникЗначение("a*b*c|a-c|Ложь")
&ИсточникЗначение("a.b|aXb|Ложь")
&ИсточникЗначение("[ab]|a|Ложь")
&ИсточникЗначение("[ab]|[ab]|Истина")
&ИсточникЗначение("a+b(c)$|a+b(c)$|Истина")
&ИсточникЗначение("a+b(c)$|aab(c)|Ложь")
&ИсточникЗначение("Ключ.*|Ключ.Значение|Истина")
Процедура РазрешенныйКлючПоШаблону(Случай) Экспорт

	// Дано - шаблон|ключ атрибута|ключ сохраняется
	Части = СтрРазделить(Случай, "|");
	Обработчик = Новый ОтелОбработчикАтрибутов(Ключи(Части[0]));

	// Когда
	Результат = Обработчик.Обработать(АтрибутыСКлючами(Части[1]));

	// Тогда
	Ожидаем.Что(Результат.Получить(Части[1]) <> Неопределено).Равно(Части[2] = "Истина");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("secret.*|secret.token|Ложь")
&ИсточникЗначение("secret.*|user.id|Истина")
&ИсточникЗначение("secret.?|secret.ab|Истина")
&ИсточникЗначение("SECRET.*|secret.token|Истина")
Процедура ИсключенныйКлючПоШаблону(Случай) Экспорт

	// Дано - шаблон|ключ атрибута|ключ сохраняется
	Части = СтрРазделить(Случай, "|");
	Обработчик = Новый ОтелОбработчикАтрибутов(, Ключи(Части[0]));

	// Когда
	Результат = Обработчик.Обработать(АтрибутыСКлючами(Части[1]));

	// Тогда
	Ожидаем.Что(Результат.Получить(Части[1]) <> Неопределено).Равно(Части[2] = "Истина");

КонецПроцедуры

#Область Служебные

Функция Ключи(Ключ)
	Результат = Новый Массив();
	Результат.Добавить(Ключ);
	Возврат Результат;
КонецФункции

Функция АтрибутыСКлючами(Ключ1, Ключ2 = Неопределено)
	Атрибуты = Новый ОтелАтрибуты();
	Атрибуты.Установить(Ключ1, "значение " + Ключ1);
	Если Ключ2 <> Неопределено Тогда
		Атрибуты.Установить(Ключ2, "значение " + Ключ2);
	КонецЕсли;
	Возврат Атрибуты;
КонецФункции

#КонецОбласти
