&Тест
Процедура ОтбрасываниеНеВозвращаетДанных() Экспорт

    // Дано
    АгрегаторБаза = Новый ОтелБазовыйАгрегатор(ОтелТипМетрики.Сумма(), Истина, "int");
    Агрегатор = Новый ПостроительНаследника(Новый ОтелАгрегаторDrop(), АгрегаторБаза).Построить();
    Хранилище = Новый ОтелХранилищеНаблюдений("drop.stream", "", "", Агрегатор, "ObservableCounter");

    // Когда
    Данные = Хранилище.Собрать(Группы(Группа(100, Запись(1))), Ресурс(), Область(), Кумулятивная());

    // Тогда
    Ожидаем.Что(Хранилище.ЭтоОтбрасывание()).ЭтоИстина();
    Ожидаем.Что(Данные).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЭкземплярыНаблюденийПриВключенномФильтре() Экспорт

    // Дано
    Хранилище = ХранилищеСуммы();
    Хранилище.УстановитьФильтрЭкземпляров(ОтелФильтрЭкземпляров.ВсегдаВключен());
    Хранилище.УстановитьФабрикуРезервуаров(Новый ОтелФабрикаПростыхРезервуаров(1));
    Хранилище.УстановитьФильтрАтрибутов(Ключи("a"), Неопределено);

    // Когда
    Данные = Хранилище.Собрать(Группы(Группа(100, Запись(5, Атрибуты("a", 1, "b", 2)))),
        Ресурс(), Область(), Кумулятивная());

    // Тогда - exemplar хранит отброшенный фильтром атрибут
    Экземпляры = Данные.ТочкиДанных()[0].Получить("exemplars");
    Ожидаем.Что(Экземпляры).ИмеетДлину(1);
    Ожидаем.Что(Экземпляры[0].Получить("asDouble")).Равно(5);
    Ожидаем.Что(Экземпляры[0].Получить("filteredAttributes")[0].Получить("key")).Равно("b");

КонецПроцедуры

// Metrics SDK / Exemplar: при выключенном сэмплировании exemplars SDK MUST NOT иметь связанных с
// ним накладных расходов, резервуары серий не создаются

&Тест
Процедура ФильтрВсегдаВыключенНеСоздаетРезервуары() Экспорт

    // Дано
    Текст = "Перем Создано Экспорт;
    |Функция СоздатьРезервуар() Экспорт
    |    Создано = Создано + 1;
    |    Возврат Новый ОтелРезервуарЭкземпляров(1);
    |КонецФункции
    |Создано = 0;";
    Фабрика = ЗагрузитьСценарийИзСтроки(Текст);
    Хранилище = ХранилищеСуммы();
    Хранилище.УстановитьФильтрЭкземпляров(ОтелФильтрЭкземпляров.ВсегдаВыключен());
    Хранилище.УстановитьФабрикуРезервуаров(Фабрика);

    // Когда
    Данные = Хранилище.Собрать(Группы(Группа(100, Запись(5, Атрибуты("a", 1)), Запись(7, Атрибуты("a", 2)))),
        Ресурс(), Область(), Кумулятивная());

    // Тогда
    Ожидаем.Что(Данные.ТочкиДанных()).ИмеетДлину(2);
    Ожидаем.Что(Фабрика.Создано).Равно(0);

КонецПроцедуры

&Тест
Процедура ДанныеНесутИмяОписаниеИЕдиницуПотока() Экспорт

    // Дано
    Хранилище = ХранилищеСуммы();

    // Когда
    Данные = Хранилище.Собрать(Группы(Группа(100, Запись(1))), Ресурс(), Область(), Кумулятивная());

    // Тогда
    Ожидаем.Что(Данные.Имя()).Равно("observed.stream");
    Ожидаем.Что(Данные.Описание()).Равно("описание");
    Ожидаем.Что(Данные.ЕдиницаИзмерения()).Равно("By");
    Ожидаем.Что(Хранилище.Вид()).Равно("ObservableCounter");

КонецПроцедуры

#Область Служебные

Функция ХранилищеСуммы()
    АгрегаторБаза = Новый ОтелБазовыйАгрегатор(ОтелТипМетрики.Сумма(), Истина, "int");
    Агрегатор = Новый ПостроительНаследника(Новый ОтелАгрегаторСуммы(), АгрегаторБаза).Построить();
    Возврат Новый ОтелХранилищеНаблюдений("observed.stream", "описание", "By", Агрегатор, "ObservableCounter");
КонецФункции

Функция ХранилищеДатчика()
    АгрегаторБаза = Новый ОтелБазовыйАгрегатор(ОтелТипМетрики.Датчик(), Ложь, "double");
    Агрегатор = Новый ПостроительНаследника(Новый ОтелАгрегаторПоследнегоЗначения(), АгрегаторБаза).Построить();
    Возврат Новый ОтелХранилищеНаблюдений("observed.gauge", "", "", Агрегатор, "ObservableGauge");
КонецФункции

Функция Ресурс()
    Возврат Новый ОтелРесурс(Истина);
КонецФункции

Функция Область()
    Возврат Новый ОтелОбластьИнструментирования("test-lib", "1.0");
КонецФункции

Функция Кумулятивная()
    Возврат ОтелВременнаяАгрегация.Кумулятивная();
КонецФункции

Функция Дельта()
    Возврат ОтелВременнаяАгрегация.Дельта();
КонецФункции

Функция Ключи(Ключ1)
    Результат = Новый Массив();
    Результат.Добавить(Ключ1);
    Возврат Результат;
КонецФункции

// BSLLS:NumberOfOptionalParams-off
Функция Атрибуты(Ключ1, Значение1, Ключ2 = Неопределено, Значение2 = Неопределено,
        Ключ3 = Неопределено, Значение3 = Неопределено)
// BSLLS:NumberOfOptionalParams-on
    Результат = Новый ОтелАтрибуты();
    Результат.Установить(Ключ1, Значение1);
    Если Ключ2 <> Неопределено Тогда
        Результат.Установить(Ключ2, Значение2);
    КонецЕсли;
    Если Ключ3 <> Неопределено Тогда
        Результат.Установить(Ключ3, Значение3);
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция Запись(Значение, АтрибутыЗаписи = Неопределено)
    Наблюдение = Новый ОтелНаблюдениеМетрики();
    Наблюдение.Записать(Значение, АтрибутыЗаписи);
    Возврат Наблюдение.Записи()[0];
КонецФункции

// BSLLS:NumberOfOptionalParams-off
Функция Группа(Время, Запись1, Запись2 = Неопределено, Запись3 = Неопределено, Запись4 = Неопределено)
// BSLLS:NumberOfOptionalParams-on
    Записи = Новый Массив();
    Записи.Добавить(Запись1);
    Если Запись2 <> Неопределено Тогда
        Записи.Добавить(Запись2);
    КонецЕсли;
    Если Запись3 <> Неопределено Тогда
        Записи.Добавить(Запись3);
    КонецЕсли;
    Если Запись4 <> Неопределено Тогда
        Записи.Добавить(Запись4);
    КонецЕсли;
    Возврат Новый Структура("Записи, Время", Записи, Время);
КонецФункции

Функция Группы(Группа1)
    Результат = Новый Массив();
    Результат.Добавить(Группа1);
    Возврат Результат;
КонецФункции

Функция КлючиАтрибутовТочки(Точка)
    Ключи = Новый СписокЗначений();
    Для Каждого Атрибут Из Точка.Получить("attributes") Цикл
        Ключи.Добавить(Атрибут.Получить("key"));
    КонецЦикла;
    Ключи.СортироватьПоЗначению();
    Возврат СтрСоединить(Ключи.ВыгрузитьЗначения(), ",");
КонецФункции

Функция ЗначениеАтрибутаТочки(Точка, Ключ)
    Для Каждого Атрибут Из Точка.Получить("attributes") Цикл
        Если Атрибут.Получить("key") = Ключ Тогда
            Для Каждого ТипИЗначение Из Атрибут.Получить("value") Цикл
                Возврат ТипИЗначение.Значение;
            КонецЦикла;
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

Функция ЗначениеТочкиПоАтрибуту(Данные, Ключ, Значение)
    Для Каждого Точка Из Данные.ТочкиДанных() Цикл
        Если ЗначениеАтрибутаТочки(Точка, Ключ) = Значение Тогда
            Возврат Точка.Получить("value");
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

#КонецОбласти
