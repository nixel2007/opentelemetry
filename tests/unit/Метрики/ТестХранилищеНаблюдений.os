&Тест
Процедура ТочкаНесетВремяНаблюденияИВременнуюАгрегацию() Экспорт

    // Дано
    Хранилище = ХранилищеСуммы();

    // Когда
    Данные = Хранилище.Собрать(Группы(Группа(12345, Запись(1))), Ресурс(), Область(), Кумулятивная());

    // Тогда
    Ожидаем.Что(Данные.ТочкиДанных()[0].Получить("timeUnixNano")).Равно(12345);
    Ожидаем.Что(Данные.ВременнаяАгрегация()).Равно(Кумулятивная());

КонецПроцедуры

&Тест
Процедура КумулятивныеТочкиИмеютПостоянноеВремяСтарта() Экспорт

    // Дано
    ДоСоздания = ОтелУтилиты.ТекущееВремяВНаносекундах();
    Хранилище = ХранилищеСуммы();
    Приостановить(5);

    // Когда
    Первые = Хранилище.Собрать(Группы(Группа(ОтелУтилиты.ТекущееВремяВНаносекундах(), Запись(10))),
        Ресурс(), Область(), Кумулятивная());
    Вторые = Хранилище.Собрать(Группы(Группа(ОтелУтилиты.ТекущееВремяВНаносекундах(), Запись(15))),
        Ресурс(), Область(), Кумулятивная());

    // Тогда - начало ряда - создание потока, одно для всех сборов
    СтартПервой = Первые.ТочкиДанных()[0].Получить("startTimeUnixNano");
    ВремяПервой = Первые.ТочкиДанных()[0].Получить("timeUnixNano");
    Ожидаем.Что(Число(СтартПервой) >= Число(ДоСоздания), "старт не раньше создания").ЭтоИстина();
    Ожидаем.Что(Число(СтартПервой) < Число(ВремяПервой), "старт раньше наблюдения").ЭтоИстина();
    Ожидаем.Что(Вторые.ТочкиДанных()[0].Получить("startTimeUnixNano")).Равно(СтартПервой);
    Ожидаем.Что(Вторые.ТочкиДанных()[0].Получить("value")).Равно(15);

КонецПроцедуры

&Тест
Процедура ДельтаСуммыСчитаетсяОтПредыдущегоСбора() Экспорт

    // Дано
    Хранилище = ХранилищеСуммы();

    // Когда
    Первые = Хранилище.Собрать(Группы(Группа(ОтелУтилиты.ТекущееВремяВНаносекундах(), Запись(10))),
        Ресурс(), Область(), Дельта());
    Вторые = Хранилище.Собрать(Группы(Группа(ОтелУтилиты.ТекущееВремяВНаносекундах(), Запись(15))),
        Ресурс(), Область(), Дельта());

    // Тогда
    Ожидаем.Что(Первые.ТочкиДанных()[0].Получить("value")).Равно(10);
    Ожидаем.Что(Вторые.ТочкиДанных()[0].Получить("value")).Равно(5);
    Ожидаем.Что(Вторые.ТочкиДанных()[0].Получить("startTimeUnixNano"))
        .Равно(Первые.ТочкиДанных()[0].Получить("timeUnixNano"));
    Ожидаем.Что(Вторые.ВременнаяАгрегация()).Равно(Дельта());

КонецПроцедуры

&Тест
Процедура ДельтаНеИспользуетЗначениеНеНаблюдавшейсяСерии() Экспорт

    // Дано - серия a пропала в одном сборе
    Хранилище = ХранилищеСуммы();
    Хранилище.Собрать(Группы(Группа(100, Запись(10, Атрибуты("k", "a")))), Ресурс(), Область(), Дельта());
    Хранилище.Собрать(Группы(Группа(200, Запись(1, Атрибуты("k", "b")))), Ресурс(), Область(), Дельта());

    // Когда
    Данные = Хранилище.Собрать(Группы(Группа(300, Запись(15, Атрибуты("k", "a")))), Ресурс(), Область(), Дельта());

    // Тогда - прошлые значения хранятся только для серий прошлого сбора
    Ожидаем.Что(Данные.ТочкиДанных()).ИмеетДлину(1);
    Ожидаем.Что(Данные.ТочкиДанных()[0].Получить("value")).Равно(15);

КонецПроцедуры

