&Тест
Процедура НаблюденияСовпадающиеПослеФильтраСкладываются() Экспорт

    // Дано
    Хранилище = ХранилищеСуммы();
    Хранилище.УстановитьФильтрАтрибутов(Ключи("a"), Неопределено);
    Группа = Группа(100, Запись(5, Атрибуты("a", 1, "b", 1)), Запись(7, Атрибуты("a", 1, "b", 2)));

    // Когда
    Данные = Хранилище.Собрать(Группы(Группа), Ресурс(), Область(), Кумулятивная());

    // Тогда - серии без атрибута b складываются, как сумма исходных серий
    Ожидаем.Что(Данные.ТочкиДанных()).ИмеетДлину(1);
    Ожидаем.Что(Данные.ТочкиДанных()[0].Получить("value")).Равно(12);

КонецПроцедуры

