КонецПроцедуры

&Тест
Процедура СовпавшиеПослеНормализацииЛейблыСклеиваютсяЧерезТочкуСЗапятой() Экспорт

    // Дано - a.b и a_b дают лейбл a_b; значения склеиваются в порядке исходных ключей
    Атрибуты = Новый ОтелАтрибуты();
    Атрибуты.Установить("a_b", "second");
    Атрибуты.Установить("a.b", "first");
    Атрибуты.Установить("a-b", 3);

    // Когда
    Лейблы = ЛейблыСэмплаДатчика(Атрибуты);

    // Тогда - "a-b" < "a.b" < "a_b"
    Ожидаем.Что(Лейблы.Получить("a_b")).Равно("3;first;second");

КонецПроцедуры

&Тест
Процедура СовпавшиеЛейблыАтрибутовОбластиСклеиваются() Экспорт

    // Дано
    АтрибутыОбласти = Новый ОтелАтрибуты();
    АтрибутыОбласти.Установить("x_y", "2");
    АтрибутыОбласти.Установить("x.y", "1");
    Область = Новый ОтелОбластьИнструментирования("lib", "", АтрибутыОбласти);
    Метр = Новый ОтелМетр(Область, Новый ОтелРесурс(Истина));
    Метр.СоздатьДатчик("g").Записать(1);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Лейблы = Читатель.СобратьСемейства()[0].Получить("Сэмплы")[0].Получить("Лейблы");

    // Тогда
    Ожидаем.Что(Лейблы.Получить("otel_scope_x_y")).Равно("1;2");

КонецПроцедуры

Функция ЛейблыСэмплаДатчика(Атрибуты)
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("lib", ""), Новый ОтелРесурс(Истина));
    Метр.СоздатьДатчик("g").Записать(7, Атрибуты);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);
    Семейства = Читатель.СобратьСемейства();
    Возврат Семейства[0].Получить("Сэмплы")[0].Получить("Лейблы");
КонецФункции

&Тест
Процедура СcopeВерсияПустаяНеДобавляетЛейбл() Экспорт

    // Дано - ОбластьИнструментирования с именем, но пустой версией
    //        ЗначениеЗаполнено(ИмяОбласти)=Истина, ЗначениеЗаполнено(ВерсияОбласти)=Ложь
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("scope-lib", "");
    Метр = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
    Датчик = Метр.СоздатьДатчик("scope_ver_gauge");
    Датчик.Записать(11);

    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Текст = Читатель.СобратьВТексте();

    // Тогда - scope_name добавлен, а otel_scope_version отсутствует
    Ожидаем.Что(СтрНайти(Текст, "scope_ver_gauge") > 0).ЭтоИстина();
    Ожидаем.Что(СтрНайти(Текст, "otel_scope_name=""scope-lib""") > 0).ЭтоИстина();
    Ожидаем.Что(СтрНайти(Текст, "otel_scope_version") = 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СемействоБезСcopeИмениНеДобавляетЛейбл() Экспорт

    // Дано - ОбластьИнструментирования с пустым именем и версией
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("", "");
    Метр = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
    Датчик = Метр.СоздатьДатчик("scope_test_gauge");
    Датчик.Записать(5);

    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Текст = Читатель.СобратьВТексте();

    // Тогда - лейбл otel_scope_name отсутствует
    Ожидаем.Что(СтрНайти(Текст, "scope_test_gauge") > 0).ЭтоИстина();
    Ожидаем.Что(СтрНайти(Текст, "otel_scope_name") = 0).ЭтоИстина();
    Ожидаем.Что(СтрНайти(Текст, "otel_scope_version") = 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НормализацияИмениПустойРезультатВозвращаетПодчеркивание() Экспорт

    // Дано - инструмент с именем "_", которое после нормализации становится пустым
    //        (РВХвост удаляет хвостовое "_") и возвращается "_"
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("norm-lib", "1.0");
    Метр = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
    Датчик = Метр.СоздатьДатчик("_");
    Датчик.Записать(3);

    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Семейства = Читатель.СобратьСемейства();

    // Тогда - метрика нормализована в "_"
    Ожидаем.Что(Семейства.Количество()).Равно(1);
    Ожидаем.Что(Семейства[0].Получить("Имя")).Равно("_");

КонецПроцедуры

&Тест
Процедура ПредставлениеНовоеОписаниеОтображаетсяВСправке() Экспорт

    // Дано - View задаёт НовоеОписание для инструмента в читателе
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("view-desc-lib", "1.0");
    Метр = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);

    Пары = Новый Массив();
    Пара = Новый Соответствие();
    Пара.Вставить("Селектор", Новый ОтелСелекторИнструментов("view_desc_gauge"));
    Пара.Вставить("Представление", Новый ОтелПредставление(, "Описание из View"));
    Пары.Добавить(Пара);
    Метр.УстановитьПредставления(Пары);

    Датчик = Метр.СоздатьДатчик("view_desc_gauge", "Исходное описание");
    Датчик.Записать(1);

    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Семейства = Читатель.СобратьСемейства();

    // Тогда - Справка содержит описание из View
    Ожидаем.Что(Семейства.Количество()).Равно(1);
    Ожидаем.Что(Семейства[0].Получить("Справка")).Равно("Описание из View");

КонецПроцедуры

&Тест
Процедура МетрБросаетНеЛомаетСборДругихМетров() Экспорт

    // Дано - метр, бросающий исключение при сборе, и исправный метр с данными
    ТекстМетра = "
    |Функция ОбластьИнструментирования() Экспорт
    |    Возврат Новый ОтелОбластьИнструментирования(""throw-lib"", ""1.0"");
    |КонецФункции
    |Функция СобратьДляЧитателя(Читатель, ВремяСбора = Неопределено, Ошибки = Неопределено) Экспорт
    |    ВызватьИсключение ""тест: ошибка сбора метра"";
    |КонецФункции";
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("healthy-lib", "1.0"), Новый ОтелРесурс(Истина));
    Счетчик = Метр.СоздатьСчетчик("healthy_requests");
    Счетчик.Добавить(3);

    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(ЗагрузитьСценарийИзСтроки(ТекстМетра));
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Семейства = Читатель.СобратьСемейства();

    // Тогда - сбой одного метра не лишает выдачу метрик остальных
    Ожидаем.Что(Семейства.Количество()).Равно(1);
    Ожидаем.Что(Семейства[0].Получить("Имя")).Равно("healthy_requests_total");

КонецПроцедуры

// Metrics SDK / Collect: SHOULD сообщать вызывающему об успехе или сбое сбора

&ПараметризованныйТест
&ИсточникЗначение("СобратьВТексте|исправный|Истина")
&ИсточникЗначение("СобратьВТексте|сбой метра|Ложь")
&ИсточникЗначение("СобратьВТексте|сбой инструмента|Ложь")
&ИсточникЗначение("СобратьСемейства|исправный|Истина")
&ИсточникЗначение("СобратьСемейства|сбой метра|Ложь")
&ИсточникЗначение("СобратьСемейства|сбой инструмента|Ложь")
Процедура СборСообщаетРезультат(Случай) Экспорт

    // Дано - метод сбора|второй метр|ожидаемый успех сбора
    Части = СтрРазделить(Случай, "|");
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("healthy-lib", "1.0"), Новый ОтелРесурс(Истина));
    Счетчик = Метр.СоздатьСчетчик("healthy_requests");
    Счетчик.Добавить(1);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);
    ВторойМетр = ВторойМетрСбора(Части[1]);
    Если ВторойМетр <> Неопределено Тогда
        Читатель.ДобавитьМетр(ВторойМетр);
    КонецЕсли;

    // Когда
    РезультатСбора = Неопределено;
    Если Части[0] = "СобратьВТексте" Тогда
        Выдача = Читатель.СобратьВТексте(РезультатСбора);
        Ожидаем.Что(Выдача).Содержит("healthy_requests_total");
    Иначе
        Семейства = Читатель.СобратьСемейства(РезультатСбора);
        Ожидаем.Что(Семейства.Количество()).Равно(1);
    КонецЕсли;

    // Тогда - данные исправного метра выданы, результат сообщает о сбое сбора
    Ожидаем.Что(ТипЗнч(РезультатСбора)).Равно(Тип("ОтелРезультатЭкспорта"));
    Ожидаем.Что(РезультатСбора.Успешно()).Равно(Части[2] = "Истина");

КонецПроцедуры

// Возвращает метр-заглушку со сбоем сбора: "сбой метра" - сбор бросает исключение, "сбой
// инструмента" - сбор сообщает ошибку инструмента; иначе Неопределено.
//
Функция ВторойМетрСбора(Вид)
    Если Вид = "сбой метра" Тогда
        Текст = "
        |Функция ОбластьИнструментирования() Экспорт Возврат Неопределено; КонецФункции
        |Функция СобратьДляЧитателя(Читатель, ВремяСбора = Неопределено, Ошибки = Неопределено) Экспорт
        |    ВызватьИсключение ""тест: ошибка сбора метра"";
        |КонецФункции";
    ИначеЕсли Вид = "сбой инструмента" Тогда
        Текст = "
        |Функция ОбластьИнструментирования() Экспорт
        |    Возврат Новый ОтелОбластьИнструментирования(""failing-lib"", ""1.0"");
        |КонецФункции
        |Функция СобратьДляЧитателя(Читатель, ВремяСбора = Неопределено, Ошибки = Неопределено) Экспорт
        |    Ошибки.Добавить(""тест: ошибка сбора инструмента"");
        |    Возврат Новый Массив;
        |КонецФункции";
    Иначе
        Возврат Неопределено;
    КонецЕсли;
    Возврат ЗагрузитьСценарийИзСтроки(Текст);
КонецФункции

// Metrics SDK / Shutdown: после Shutdown вызовы SHOULD возвращать сбой

&ПараметризованныйТест
&ИсточникЗначение("СобратьВТексте")
&ИсточникЗначение("СобратьСемейства")
&ИсточникЗначение("СброситьБуфер")
&ИсточникЗначение("СброситьБуферБезОчистки")
&ИсточникЗначение("Закрыть")
Процедура ЗакрытыйЧитательСообщаетОшибку(Метод) Экспорт

    // Дано
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("closed-lib", "1.0"), Новый ОтелРесурс(Истина));
    Метр.СоздатьСчетчик("closed_requests").Добавить(1);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);
    Читатель.Закрыть();

    // Когда
    Результат = ВызватьПослеЗакрытия(Читатель, Метод);

    // Тогда
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();

КонецПроцедуры

Функция ВызватьПослеЗакрытия(Читатель, Метод)
    РезультатСбора = Неопределено;
    Если Метод = "СобратьВТексте" Тогда
        Ожидаем.Что(Читатель.СобратьВТексте(РезультатСбора)).Равно("");
        Возврат РезультатСбора;
    ИначеЕсли Метод = "СобратьСемейства" Тогда
        Ожидаем.Что(Читатель.СобратьСемейства(РезультатСбора)).ИмеетДлину(0);
        Возврат РезультатСбора;
    ИначеЕсли Метод = "СброситьБуфер" Тогда
        Возврат Читатель.СброситьБуфер();
    ИначеЕсли Метод = "СброситьБуферБезОчистки" Тогда
        Возврат Читатель.СброситьБуферБезОчистки();
    Иначе
        Возврат Читатель.Закрыть();
    КонецЕсли;
КонецФункции

// Prometheus Compatibility / Metric Metadata: отбрасывая комментарий или точки метрики,
// экспортер SHOULD предупреждать пользователя через логирование ошибок

&ПараметризованныйТест
&ИсточникЗначение("описание|описание 'Second description' метрики 'jobs' отличается")
&ИсточникЗначение("экспоненциальная|'exp_histo'")
&ИсточникЗначение("конвертация|'broken_histogram'")
Процедура ОтбрасываниеПредупреждаетВЛоге(Случай) Экспорт

    // Дано - случай|фрагмент предупреждения
    Части = СтрРазделить(Случай, "|");
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    ДобавитьМетрыОтбрасывания(Читатель, Части[0]);
    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);

    // Когда
    Читатель.СобратьСемейства();

    // Тогда
    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);
    Ожидаем.Что(ЕстьПредупреждениеСТекстом(Аппендер, Части[1]), "предупреждение в логе").ЭтоИстина();

КонецПроцедуры

Процедура ДобавитьМетрыОтбрасывания(Читатель, Случай)
    Ресурс = Новый ОтелРесурс(Истина);
    Версия = "1.0";
    Если Случай = "описание" Тогда
        Первый = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("first-lib", Версия), Ресурс);
        Первый.СоздатьСчетчик("jobs", "First description").Добавить(1);
        Второй = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("second-lib", Версия), Ресурс);
        Второй.СоздатьСчетчик("jobs", "Second description").Добавить(2);
        Читатель.ДобавитьМетр(Первый);
        Читатель.ДобавитьМетр(Второй);
    ИначеЕсли Случай = "экспоненциальная" Тогда
        Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("exp-lib", Версия), Ресурс);
        Метр.СоздатьЭкспоненциальнуюГистограмму("exp_histo").Записать(100);
        Читатель.ДобавитьМетр(Метр);
    Иначе
        // Гистограмма с нечисловым количеством в бакете: конвертация точки падает
        Область = Новый ОтелОбластьИнструментирования("broken-lib", Версия);
        Счетчики = Новый Массив();
        Счетчики.Добавить("не число");
        Точка = Новый Соответствие();
        Точка.Вставить("bucketCounts", Счетчики);
        Точки = Новый Массив();
        Точки.Добавить(Точка);
        Данные = Новый ОтелДанныеМетрики(Ресурс, Область, "broken_histogram", "", "",
            ОтелТипМетрики.Гистограмма(), Точки);
        Читатель.ДобавитьМетр(МетрСДанными(Область, Данные));
    КонецЕсли;
КонецПроцедуры

// Prometheus Exporter / Client Libraries: экспортер SHOULD быть смоделирован как custom
// Collector клиентской библиотеки, чтобы выдаваться вместе с ее инструментированием

&Тест
Процедура ЧитательРегистрируетсяКакКоллекторБиблиотекиPrometheus() Экспорт

    // Дано - счетчик библиотеки prometheus и читатель OTel в одном реестре
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("collector-lib", "1.0"), Новый ОтелРесурс(Истина));
    Метр.СоздатьСчетчик("otel_requests").Добавить(3);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);
    Реестр = Новый CollectorRegistry();
    Родной = PrometheusMetrics.НовыйСчетчик(Новый Структура("Имя, Справка", "native_jobs_total", "Задания"));
    PrometheusMetrics.ДобавитьКСчетчику(Родной, 5);
    Реестр.Register(Родной);

    // Когда
    Реестр.Register(Читатель);
    Текст = Prometheus.СериализоватьВТекст(Prometheus.СобратьМетрики(Реестр));

    // Тогда
    Ожидаем.Что(Текст).Содержит("native_jobs_total 5");
    Ожидаем.Что(Текст).Содержит("otel_requests_total{");

КонецПроцедуры

// Метрика target_info из ресурса (Prometheus Compatibility / Resource Attributes) - раздел в
// статусе Development, не выводится; по умолчанию атрибуты ресурса MUST NOT копироваться в лейблы
// метрик

&Тест
Процедура РесурсНеВыводитсяМетрикойTargetInfo() Экспорт

    // Дано
    Читатель = ЧитательСРесурсом();

    // Когда
    Текст = Читатель.СобратьВТексте();

    // Тогда
    Ожидаем.Что(СтрНайти(Текст, "target_info")).Равно(0);
    Ожидаем.Что(Текст).Содержит("orders_total{otel_scope_name=""target-lib"",otel_scope_version=""1.0""} 1");

КонецПроцедуры

// Prometheus Exporter / Resource Attributes as Metric Labels: настройка SHOULD позволять выбрать
// включаемые и исключаемые атрибуты ресурса

&Тест
Процедура ВыбранныеАтрибутыРесурсаКопируютсяВЛейблыМетрик() Экспорт

    // Дано
    Читатель = ЧитательСРесурсом();

    // Когда - включаются service.*, исключается service.namespace
    Читатель.УстановитьАтрибутыРесурсаВЛейблах(МассивСтрок("service.*"), МассивСтрок("service.namespace"));
    Текст = Читатель.СобратьВТексте();

    // Тогда
    Ожидаем.Что(Текст).Содержит(
        "orders_total{otel_scope_name=""target-lib"",otel_scope_version=""1.0"",service_name=""checkout""} 1");

КонецПроцедуры

&Тест
Процедура АтрибутТочкиПриоритетнееСкопированногоАтрибутаРесурса() Экспорт

    // Дано - атрибут точки host.name совпадает с атрибутом ресурса
    Ресурс = РесурсПриложения();
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("target-lib", "1.0"), Ресурс);
    Атрибуты = Новый ОтелАтрибуты();
    Атрибуты.Установить("host.name", "from-point");
    Метр.СоздатьСчетчик("orders").Добавить(1, Атрибуты);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда - копируются все атрибуты ресурса
    Читатель.УстановитьАтрибутыРесурсаВЛейблах(Неопределено);
    Текст = Читатель.СобратьВТексте();

    // Тогда
    Ожидаем.Что(Текст).Содержит("orders_total{host_name=""from-point"",otel_scope_name=""target-lib""");

КонецПроцедуры

Функция ЧитательСРесурсом()
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("target-lib", "1.0"), РесурсПриложения());
    Метр.СоздатьСчетчик("orders").Добавить(1);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);
    Возврат Читатель;
КонецФункции

Функция РесурсПриложения()
    Ресурс = Новый ОтелРесурс(Истина);
    Ресурс.Атрибуты().Установить("service.name", "checkout");
    Ресурс.Атрибуты().Установить("service.namespace", "shop");
    Ресурс.Атрибуты().Установить("host.name", "web-1");
    Возврат Ресурс;
КонецФункции

Функция МассивСтрок(Значение)
    Результат = Новый Массив();
    Результат.Добавить(Значение);
    Возврат Результат;
КонецФункции

&Тест
Процедура ПредставлениеНовоеИмяОтображаетсяВPrometheus() Экспорт

    // Дано - View задаёт НовоеИмя для инструмента в Prometheus читателе (→ line 200)
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("view-name-lib", "1.0");
    Метр = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);

    Пары = Новый Массив();
    Пара = Новый Соответствие();
    Пара.Вставить("Селектор", Новый ОтелСелекторИнструментов("original_gauge"));
    Пара.Вставить("Представление", Новый ОтелПредставление("renamed_gauge"));
    Пары.Добавить(Пара);
    Метр.УстановитьПредставления(Пары);

    Датчик = Метр.СоздатьДатчик("original_gauge", "Исходное описание");
    Датчик.Записать(42);

    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Семейства = Читатель.СобратьСемейства();

    // Тогда - метрика переименована через View
    Ожидаем.Что(Семейства.Количество()).Равно(1);
    Ожидаем.Что(Семейства[0].Получить("Имя")).Равно("renamed_gauge");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Единица")
&ИсточникЗначение("ВерсияМетра")
&ИсточникЗначение("АдресСхемыМетра")
&ИсточникЗначение("ИмяВДругомРегистре")
Процедура ПредставлениеПереименовываетПоКритериюСелектора(Критерий) Экспорт

    // Дано - View переименовывает метрику, селектор выбирает инструмент по одному критерию
    ИмяИнструмента = "Selected.Counter";
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования(
        "view-lib", "1.0.0", , "https://example.com/schema/1");
    Метр = Новый ОтелМетр(ОбластьИнструментирования, Новый ОтелРесурс(Истина));
    Пары = Новый Массив();
    Пара = Новый Соответствие();
    Пара.Вставить("Селектор", СелекторПоКритерию(Критерий, ИмяИнструмента));
    Пара.Вставить("Представление", Новый ОтелПредставление("renamed_metric"));
    Пары.Добавить(Пара);
    Метр.УстановитьПредставления(Пары);
    Метр.СоздатьСчетчик(ИмяИнструмента, "", "ms").Добавить(5);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Семейства = Читатель.СобратьСемейства();

    // Тогда - метрика выведена под новым именем (с суффиксом единицы "ms")
    Ожидаем.Что(Семейства).ИмеетДлину(1);
    Ожидаем.Что(Семейства[0].Получить("Имя")).Равно("renamed_metric_milliseconds_total");

КонецПроцедуры

Функция СелекторПоКритерию(Критерий, ИмяИнструмента)
    Если Критерий = "Единица" Тогда
        Возврат Новый ОтелСелекторИнструментов(ИмяИнструмента, , , "ms");
    ИначеЕсли Критерий = "ВерсияМетра" Тогда
        Возврат Новый ОтелСелекторИнструментов(ИмяИнструмента, , , , "1.0.0");
    ИначеЕсли Критерий = "АдресСхемыМетра" Тогда
        Возврат Новый ОтелСелекторИнструментов(ИмяИнструмента, , , , , "https://example.com/schema/1");
    Иначе
        Возврат Новый ОтелСелекторИнструментов(НРег(ИмяИнструмента));
    КонецЕсли;
КонецФункции

&Тест
Процедура КонвертироватьАтрибутыНеопределеноВозвращаетПустойЛейбл() Экспорт

    // Дано - точка данных без ключа "attributes": КонвертироватьАтрибутыВЛейблы делает ранний выход
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("noattr-lib", "1.0");

    ТочкаДанных = Новый Соответствие();
    ТочкаДанных.Вставить("value", 5);
    // ключ "attributes" намеренно отсутствует
    ТочкиДанных = Новый Массив();
    ТочкиДанных.Добавить(ТочкаДанных);
    МетрикаДатчик = Новый ОтелДанныеМетрики(
        Неопределено, ОбластьИнструментирования,
        "noattr_gauge", "", "1", ОтелТипМетрики.Датчик(), ТочкиДанных);

    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(МетрСДанными(ОбластьИнструментирования, МетрикаДатчик));

    // Когда - атрибуты отсутствуют, КонвертироватьАтрибутыВЛейблы делает ранний выход
    Семейства = Читатель.СобратьСемейства();

    // Тогда - семейство создано, сэмпл без пользовательских лейблов
    Ожидаем.Что(Семейства.Количество()).Равно(1);
    Сэмплы = Семейства[0].Получить("Сэмплы");
    Ожидаем.Что(Сэмплы.Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура КонвертироватьАтрибутПрямоеЗначение() Экспорт

    // Дано - точка данных с атрибутом, чьё value - строка, а не Соответствие
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("scalar-lib", "1.0");

    АтрибутМап = Новый Соответствие();
    АтрибутМап.Вставить("key", "env");
    АтрибутМап.Вставить("value", "prod"); // строка вместо вложенного Соответствия
    АтрибутыМассив = Новый Массив();
    АтрибутыМассив.Добавить(АтрибутМап);

    ТочкаДанных = Новый Соответствие();
    ТочкаДанных.Вставить("value", 9);
    ТочкаДанных.Вставить("attributes", АтрибутыМассив);
    ТочкиДанных = Новый Массив();
    ТочкиДанных.Добавить(ТочкаДанных);
    МетрикаДатчик = Новый ОтелДанныеМетрики(
        Неопределено, ОбластьИнструментирования,
        "scalar_gauge", "", "1", ОтелТипМетрики.Датчик(), ТочкиДанных);

    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(МетрСДанными(ОбластьИнструментирования, МетрикаДатчик));

    // Когда - value не Соответствие → Строка(ЗначениеОбъект)
    Семейства = Читатель.СобратьСемейства();

    // Тогда - лейбл env="prod" (прямая строка)
    Ожидаем.Что(Семейства.Количество()).Равно(1);
    Сэмплы = Семейства[0].Получить("Сэмплы");
    Лейблы = Сэмплы[0].Получить("Лейблы");
    Ожидаем.Что(Лейблы.Получить("env")).Равно("prod");

КонецПроцедуры

// Метр, отдающий читателю заданные данные метрики.
Функция МетрСДанными(Область, ДанныеМетрики)
    Текст = "Перем Область Экспорт;
    |Перем Данные Экспорт;
    |Функция ОбластьИнструментирования() Экспорт
    |    Возврат Область;
    |КонецФункции
    |Функция СобратьДляЧитателя(Читатель, ВремяСбора = Неопределено, Ошибки = Неопределено) Экспорт
    |    Возврат Данные;
    |КонецФункции
    |Данные = Новый Массив;";
    Метр = ЗагрузитьСценарийИзСтроки(Текст);
    Метр.Область = Область;
    Метр.Данные.Добавить(ДанныеМетрики);
    Возврат Метр;
КонецФункции

Функция СтрокиСПрефиксом(Строки, Префикс)
    Результат = Новый Массив();
    Для Каждого Строка Из Строки Цикл
        Если СтрНачинаетсяС(Строка, Префикс) Тогда
            Результат.Добавить(Строка);
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция СтрокиСПодстрокой(Строки, Подстрока)
    Результат = Новый Массив();
    Для Каждого Строка Из Строки Цикл
        Если СтрНайти(Строка, Подстрока) > 0 Тогда
            Результат.Добавить(Строка);
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции
