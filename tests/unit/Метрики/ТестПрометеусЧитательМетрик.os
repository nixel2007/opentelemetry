КонецПроцедуры

&Тест
Процедура СобратьГистограмму() Экспорт

    // Дано
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0");
    Метр = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
    Гистограмма = Метр.СоздатьГистограмму("test_histogram", "Тестовая гистограмма");

    Атрибуты = Новый ОтелАтрибуты();
    Гистограмма.Записать(50, Атрибуты);
    Гистограмма.Записать(500, Атрибуты);

    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Текст = Читатель.СобратьВТексте();

    // Тогда - текст содержит histogram с _bucket, _count, _sum
    Ожидаем.Что(СтрНайти(Текст, "test_histogram") > 0).ЭтоИстина();
    Ожидаем.Что(СтрНайти(Текст, "_bucket") > 0).ЭтоИстина();
    Ожидаем.Что(СтрНайти(Текст, "_count") > 0).ЭтоИстина();
    Ожидаем.Что(СтрНайти(Текст, "_sum") > 0).ЭтоИстина();
    Ожидаем.Что(СтрНайти(Текст, "# TYPE test_histogram histogram") > 0).ЭтоИстина();
    Ожидаем.Что(СтрНайти(Текст, "+Inf") > 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ГистограммаСНесколькимиСериямиВыводитВсеСерии() Экспорт

    // Дано - две серии гистограммы в одной области и одноименная гистограмма другой области
    Ресурс = Новый ОтелРесурс(Истина);
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("lib-a", "1.0"), Ресурс);
    Гистограмма = Метр.СоздатьГистограмму("lat");
    АтрибутыА = Новый ОтелАтрибуты();
    АтрибутыА.Установить("route", "/a");
    АтрибутыБ = Новый ОтелАтрибуты();
    АтрибутыБ.Установить("route", "/b");
    Гистограмма.Записать(3, АтрибутыА);
    Гистограмма.Записать(700, АтрибутыБ);
    Гистограмма.Записать(800, АтрибутыБ);
    МетрДругой = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("lib-b", "1.0"), Ресурс);
    МетрДругой.СоздатьГистограмму("lat").Записать(1);

    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);
    Читатель.ДобавитьМетр(МетрДругой);

    // Когда
    Строки = СтрРазделить(Читатель.СобратьВТексте(), Символы.ПС, Ложь);

    // Тогда - у каждой из трех серий свои бакеты, _sum и _count
    Ожидаем.Что(СтрокиСПрефиксом(Строки, "lat_count{").Количество()).Равно(3);
    Ожидаем.Что(СтрокиСПрефиксом(Строки, "lat_sum{").Количество()).Равно(3);
    БакетыInf = Новый Массив();
    Для Каждого Строка Из СтрокиСПрефиксом(Строки, "lat_bucket{") Цикл
        Если СтрНайти(Строка, "le=""+Inf""") > 0 Тогда
            БакетыInf.Добавить(Строка);
        КонецЕсли;
    КонецЦикла;
    Ожидаем.Что(БакетыInf.Количество()).Равно(3);
    Ожидаем.Что(Строки.Найти("lat_count{otel_scope_name=""lib-a"",otel_scope_version=""1.0"",route=""/b""} 2"))
        .Не_().Равно(Неопределено);
    Ожидаем.Что(Строки.Найти("lat_sum{otel_scope_name=""lib-a"",otel_scope_version=""1.0"",route=""/b""} 1500"))
        .Не_().Равно(Неопределено);
    Ожидаем.Что(Строки.Найти("lat_count{otel_scope_name=""lib-b"",otel_scope_version=""1.0""} 1"))
        .Не_().Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СэмплыСерииГистограммыИдутПодрядПоВозрастаниюLe() Экспорт

    // Дано
    Ресурс = Новый ОтелРесурс(Истина);
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("lib", ""), Ресурс);
    Границы = Новый Массив();
    Границы.Добавить(1);
    Границы.Добавить(10);
    Совет = Новый Структура("ГраницыГистограммы", Границы);
    Гистограмма = Метр.СоздатьГистограмму("h", "", "", Совет);
    Атрибуты = Новый ОтелАтрибуты();
    Атрибуты.Установить("k", "v");
    Гистограмма.Записать(5, Атрибуты);
    Гистограмма.Записать(50);

    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Строки = СтрРазделить(Читатель.СобратьВТексте(), Символы.ПС, Ложь);

    // Тогда - серия: бакеты по возрастанию le, затем _sum и _count
    Серия = СтрокиСПодстрокой(Строки, "k=""v""");
    Ожидаем.Что(Серия.Количество()).Равно(5);
    Ожидаем.Что(Серия[0]).Равно("h_bucket{k=""v"",le=""1"",otel_scope_name=""lib""} 0");
    Ожидаем.Что(Серия[1]).Равно("h_bucket{k=""v"",le=""10"",otel_scope_name=""lib""} 1");
    Ожидаем.Что(Серия[2]).Равно("h_bucket{k=""v"",le=""+Inf"",otel_scope_name=""lib""} 1");
    Ожидаем.Что(Серия[3]).Равно("h_sum{k=""v"",otel_scope_name=""lib""} 5");
    Ожидаем.Что(Серия[4]).Равно("h_count{k=""v"",otel_scope_name=""lib""} 1");
    Ожидаем.Что(Строки.Найти("h_bucket{le=""+Inf"",otel_scope_name=""lib""} 1")).Не_().Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СчетчикTypeИHelpСИменемСэмпла() Экспорт

    // Дано - в text format 0.0.4 строки TYPE и HELP относятся к метрике с тем же именем
    Ресурс = Новый ОтелРесурс(Истина);
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("lib", ""), Ресурс);
    Метр.СоздатьСчетчик("req", "Запросы").Добавить(5);

    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Строки = СтрРазделить(Читатель.СобратьВТексте(), Символы.ПС, Ложь);

    // Тогда
    Ожидаем.Что(Строки.Найти("# HELP req_total Запросы")).Не_().Равно(Неопределено);
    Ожидаем.Что(Строки.Найти("# TYPE req_total counter")).Не_().Равно(Неопределено);
    Ожидаем.Что(Строки.Найти("req_total{otel_scope_name=""lib""} 5")).Не_().Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СемействаПередаютсяВБиблиотекуБезПреобразования() Экспорт

    // Дано - семейства в промежуточном формате библиотеки prometheus: у счетчика имя
    //   семейства совпадает с именем сэмпла
    Ресурс = Новый ОтелРесурс(Истина);
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("lib", ""), Ресурс);
    Метр.СоздатьСчетчик("req", "Запросы").Добавить(5);

    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Текст = Prometheus.СериализоватьВТекст(Читатель.СобратьСемейства());

    // Тогда - строки HELP и TYPE счетчика с именем сэмпла, текст как у СобратьВТексте
    Строки = СтрРазделить(Текст, Символы.ПС, Ложь);
    Ожидаем.Что(Строки.Найти("# HELP req_total Запросы")).Не_().Равно(Неопределено);
    Ожидаем.Что(Строки.Найти("# TYPE req_total counter")).Не_().Равно(Неопределено);
    Ожидаем.Что(Текст).Равно(Читатель.СобратьВТексте());

КонецПроцедуры

&Тест
Процедура СобратьРеверсивныйСчетчик() Экспорт

    // Дано
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0");
    Метр = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
    Счетчик = Метр.СоздатьРеверсивныйСчетчик("test_updown", "Реверсивный счетчик");

    Атрибуты = Новый ОтелАтрибуты();
    Счетчик.Добавить(10, Атрибуты);
    Счетчик.Добавить(-3, Атрибуты);

    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Текст = Читатель.СобратьВТексте();

    // Тогда - UpDownCounter (monotonic=false) -> gauge, без _total
    Ожидаем.Что(СтрНайти(Текст, "test_updown") > 0).ЭтоИстина();
    Ожидаем.Что(СтрНайти(Текст, "# TYPE test_updown gauge") > 0).ЭтоИстина();
    Ожидаем.Что(СтрНайти(Текст, "7") > 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СовместимостьИнтерфейса() Экспорт

    // Дано
    Читатель = Новый ОтелПрометеусЧитательМетрик();

    // Когда - Запустить/СброситьБуфер/Закрыть не падают
    Читатель.Запустить();
    Читатель.СброситьБуфер();
    Читатель.Закрыть();

    // Тогда - ошибок нет
    Ожидаем.Что(Истина).Равно(Истина);

