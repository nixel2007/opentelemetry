&Тест
Процедура НесколькоМетров() Экспорт

    // Дано
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования1 = Новый ОтелОбластьИнструментирования("lib1", "1.0");
    Метр1 = Новый ОтелМетр(ОбластьИнструментирования1, Ресурс);
    Счетчик1 = Метр1.СоздатьСчетчик("counter_one");
    Счетчик1.Добавить(10);

    ОбластьИнструментирования2 = Новый ОтелОбластьИнструментирования("lib2", "2.0");
    Метр2 = Новый ОтелМетр(ОбластьИнструментирования2, Ресурс);
    Счетчик2 = Метр2.СоздатьСчетчик("counter_two");
    Счетчик2.Добавить(20);

    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр1);
    Читатель.ДобавитьМетр(Метр2);

    // Когда
    Текст = Читатель.СобратьВТексте();

    // Тогда - обе метрики присутствуют с разными scope лейблами
    Ожидаем.Что(СтрНайти(Текст, "counter_one_total") > 0).ЭтоИстина();
    Ожидаем.Что(СтрНайти(Текст, "counter_two_total") > 0).ЭтоИстина();
    Ожидаем.Что(СтрНайти(Текст, "10") > 0).ЭтоИстина();
    Ожидаем.Что(СтрНайти(Текст, "20") > 0).ЭтоИстина();
    Ожидаем.Что(СтрНайти(Текст, "otel_scope_name=""lib1""") > 0).ЭтоИстина();
    Ожидаем.Что(СтрНайти(Текст, "otel_scope_name=""lib2""") > 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЭкспоненциальнаяГистограммаПропускается() Экспорт

    // Дано - по спеке exponential histograms SHOULD be dropped в text format 0.0.4
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0");
    Метр = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
    ЭкспоненциальнаяГистограмма = Метр.СоздатьЭкспоненциальнуюГистограмму("exp_histo", "Тест");

    Атрибуты = Новый ОтелАтрибуты();
    ЭкспоненциальнаяГистограмма.Записать(100, Атрибуты);

    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Семейства = Читатель.СобратьСемейства();

    // Тогда - экспоненциальная гистограмма пропущена
    Ожидаем.Что(Семейства).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ОдноименныеМетрикиИзРазныхМетровОбъединяются() Экспорт

    // Дано - два метра дают инструменты с одним именем и одинаковым типом
    ИмяМетрики = "http_requests";
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования1 = Новый ОтелОбластьИнструментирования("lib1", "1.0");
    Метр1 = Новый ОтелМетр(ОбластьИнструментирования1, Ресурс);
    Счетчик1 = Метр1.СоздатьСчетчик(ИмяМетрики);
    Счетчик1.Добавить(10);

    ОбластьИнструментирования2 = Новый ОтелОбластьИнструментирования("lib2", "2.0");
    Метр2 = Новый ОтелМетр(ОбластьИнструментирования2, Ресурс);
    Счетчик2 = Метр2.СоздатьСчетчик(ИмяМетрики);
    Счетчик2.Добавить(20);

    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр1);
    Читатель.ДобавитьМетр(Метр2);

    // Когда
    Семейства = Читатель.СобратьСемейства();

    // Тогда - одно семейство с двумя сэмплами (различаются по scope лейблам)
    Ожидаем.Что(Семейства).ИмеетДлину(1);
    Ожидаем.Что(Семейства[0].Получить("Имя")).Равно(ИмяМетрики + "_total");
    СэмплыСемейства = Семейства[0].Получить("Сэмплы");
    Ожидаем.Что(СэмплыСемейства.Количество()).Равно(2);

КонецПроцедуры

&Тест
Процедура КонфликтТиповПропускается() Экспорт

    // Дано - два метра с одним именем, но разным TYPE
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования1 = Новый ОтелОбластьИнструментирования("lib1", "1.0");
    Метр1 = Новый ОтелМетр(ОбластьИнструментирования1, Ресурс);
    Счетчик = Метр1.СоздатьСчетчик("conflicting_metric");
    Счетчик.Добавить(10);

    ОбластьИнструментирования2 = Новый ОтелОбластьИнструментирования("lib2", "2.0");
    Метр2 = Новый ОтелМетр(ОбластьИнструментирования2, Ресурс);
    Датчик = Метр2.СоздатьДатчик("conflicting_metric");
    Датчик.Записать(99);

    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр1);
    Читатель.ДобавитьМетр(Метр2);

    // Когда
    Семейства = Читатель.СобратьСемейства();

    // Тогда - только первая метрика, вторая пропущена из-за конфликта TYPE
    Ожидаем.Что(Семейства).ИмеетДлину(1);
    Ожидаем.Что(Семейства[0].Получить("Тип")).Равно("counter");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Counter|net.io|By|net_io_bytes_total")
&ИсточникЗначение("Gauge|memory.usage|MiBy|memory_usage_mebibytes")
&ИсточникЗначение("Gauge|device.temperature|Cel|device_temperature_celsius")
&ИсточникЗначение("Gauge|disk.utilization|%|disk_utilization_percent")
&ИсточникЗначение("Gauge|net.throughput|By/s|net_throughput_bytes_per_second")
&ИсточникЗначение("Gauge|packet.rate|{packet}/s|packet_rate_per_second")
&ИсточникЗначение("Counter|http.requests|{request}|http_requests_total")
&ИсточникЗначение("Gauge|cpu.utilization|1|cpu_utilization")
&ИсточникЗначение("Gauge|queue.depth|item|queue_depth_item")
&ИсточникЗначение("Gauge|request.duration.seconds|s|request_duration_seconds")
&ИсточникЗначение("Counter|io.bytes_total|By|io_bytes_total")
&ИсточникЗначение("Counter|requests_total||requests_total")
Процедура ИмяМетрикиСодержитСуффиксЕдиницы(Случай) Экспорт

    // Дано - случай "вид|имя OTel|единица UCUM|ожидаемое имя сэмпла Prometheus"
    Части = СтрРазделить(Случай, "|");
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("units-lib", "1.0"), Новый ОтелРесурс(Истина));
    Если Части[0] = "Counter" Тогда
        Метр.СоздатьСчетчик(Части[1], "", Части[2]).Добавить(1);
    Иначе
        Метр.СоздатьДатчик(Части[1], "", Части[2]).Записать(1);
    КонецЕсли;
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Семейства = Читатель.СобратьСемейства();

    // Тогда - единица переведена в слово Prometheus и стоит перед суффиксом типа;
    //   имя OTel при этом не меняется (перевод только в слое Prometheus)
    Ожидаем.Что(Семейства).ИмеетДлину(1);
    Ожидаем.Что(Семейства[0].Получить("Сэмплы")[0].Получить("ИмяСэмпла")).Равно(Части[3]);

КонецПроцедуры

&Тест
Процедура ГистограммаСЕдиницейПолучаетСуффиксВоВсехИменах() Экспорт

    // Дано - гистограмма длительности в секундах, как в semconv
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("units-lib", "1.0"), Новый ОтелРесурс(Истина));
    Метр.СоздатьГистограмму("http.server.request.duration", "", "s").Записать(0.2);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Семейства = Читатель.СобратьСемейства();

    // Тогда - суффикс единицы в имени семейства и перед _bucket/_sum/_count
    Ожидаем.Что(Семейства[0].Получить("Имя")).Равно("http_server_request_duration_seconds");
    Сэмплы = Семейства[0].Получить("Сэмплы");
    Ожидаем.Что(ЗначенияСэмплов(Сэмплы, "http_server_request_duration_seconds_count")).ИмеетДлину(1);
    Ожидаем.Что(ЗначенияСэмплов(Сэмплы, "http_server_request_duration_seconds_sum")).ИмеетДлину(1);
    Ожидаем.Что(ЗначенияСэмплов(Сэмплы, "http_server_request_duration_seconds_bucket").Количество() > 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СчетчикСЕдиницейПолучаетСуффиксЕдиницыИTotal() Экспорт

    // Дано - имена переводятся по UnderscoreEscapingWithSuffixes: "." заменяется на "_",
    //   добавляются суффиксы единицы и _total
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("units-lib", "1.0"), Новый ОтелРесурс(Истина));
    Метр.СоздатьСчетчик("net.io", "", "By").Добавить(1);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Семейства = Читатель.СобратьСемейства();

    // Тогда
    Ожидаем.Что(Семейства[0].Получить("Сэмплы")[0].Получить("ИмяСэмпла")).Равно("net_io_bytes_total");

КонецПроцедуры

&Тест
Процедура КонфликтЕдиницДаетРазныеСемейства() Экспорт

    // Дано - повторная регистрация счетчика с другой единицей дает два инструмента
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("units-lib", "1.0"), Новый ОтелРесурс(Истина));
    Метр.СоздатьСчетчик("transfer", "", "By").Добавить(10);
    Метр.СоздатьСчетчик("transfer", "", "s").Добавить(500);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Семейства = Читатель.СобратьСемейства();

    // Тогда - суффиксы единиц разводят метрики по разным семействам, точки не теряются
    Имена = Новый Массив();
    Для Каждого Семейство Из Семейства Цикл
        Имена.Добавить(Семейство.Получить("Имя"));
    КонецЦикла;
    Ожидаем.Что(Имена).ИмеетДлину(2);
    Ожидаем.Что(Имена).Содержит("transfer_bytes_total");
    Ожидаем.Что(Имена).Содержит("transfer_seconds_total");

КонецПроцедуры

&Тест
Процедура ДублирующиесяСерииОдноименныхМетрикОднойОбластиОтбрасываются() Экспорт

    // Дано - в одном метре два наблюдаемых счетчика, имена которых совпадают после
    //   экранирования ("dup.series" и "dup_series"): их серии совпадают по имени и лейблам
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("dup-lib", "1.0"), Новый ОтелРесурс(Истина));
    Метр.СоздатьНаблюдаемыйСчетчик("dup.series", Новый Действие(ЭтотОбъект, "НаблюдатьДесять"));
    Метр.СоздатьНаблюдаемыйСчетчик("dup_series", Новый Действие(ЭтотОбъект, "НаблюдатьПятьсот"));
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);
    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);

    // Когда
    Семейства = Читатель.СобратьСемейства();

    // Тогда - в выдаче одна серия (первой метрики), точка второй отброшена с предупреждением
    Ожидаем.Что(Семейства).ИмеетДлину(1);
    Сэмплы = Семейства[0].Получить("Сэмплы");
    Ожидаем.Что(Сэмплы).ИмеетДлину(1);
    Ожидаем.Что(Сэмплы[0].Получить("Значение")).Равно(10);
    Ожидаем.Что(ЕстьПредупреждениеСТекстом(Аппендер, "(семейство 'dup_series_total'): отброшено точек - 1"),
        "предупреждение в логе").ЭтоИстина();

    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);

КонецПроцедуры

&Тест
Процедура ОдноименныеМетрикиОднойОбластиСРазнымиАтрибутамиСохраняются() Экспорт

    // Дано - одноименные после экранирования метрики одной области пишут разные наборы
    //   атрибутов: серии не совпадают, точки отбрасывать нельзя
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("dup-lib", "1.0"), Новый ОтелРесурс(Истина));
    Метр.СоздатьНаблюдаемыйСчетчик("dup.attrs", Новый Действие(ЭтотОбъект, "НаблюдатьПервоеОкружение"));
    Метр.СоздатьНаблюдаемыйСчетчик("dup_attrs", Новый Действие(ЭтотОбъект, "НаблюдатьВтороеОкружение"));
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Семейства = Читатель.СобратьСемейства();

    // Тогда - обе серии в выдаче
    Ожидаем.Что(Семейства).ИмеетДлину(1);
    Ожидаем.Что(Семейства[0].Получить("Сэмплы")).ИмеетДлину(2);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Счетчик")
&ИсточникЗначение("Гистограмма")
Процедура СовпадающиеИменаСэмпловРазныхСемействНеДублируются(Случай) Экспорт

    // Дано - разные семейства дают сэмплы с одним именем и лейблами: счетчик "foo" с единицей
    //   By выводит foo_bytes_total (семейство foo_bytes), гистограмма "lat" - lat_count;
    //   датчик с таким же именем выводит сэмпл с тем же именем. Формат Prometheus требует
    //   уникального сочетания имени сэмпла и лейблов
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("clash-lib", "1.0"), Новый ОтелРесурс(Истина));
    Если Случай = "Счетчик" Тогда
        Метр.СоздатьСчетчик("foo", "", "By").Добавить(1);
        ИмяСэмпла = "foo_bytes_total";
    Иначе
        Метр.СоздатьГистограмму("lat").Записать(1);
        ИмяСэмпла = "lat_count";
    КонецЕсли;
    Метр.СоздатьДатчик(ИмяСэмпла).Записать(5);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Семейства = Читатель.СобратьСемейства();

    // Тогда - сэмпл с этим именем и лейблами в выдаче один
    ВсегоСэмплов = 0;
    Для Каждого Семейство Из Семейства Цикл
        ВсегоСэмплов = ВсегоСэмплов + ЗначенияСэмплов(Семейство.Получить("Сэмплы"), ИмяСэмпла).Количество();
    КонецЦикла;
    Ожидаем.Что(ВсегоСэмплов, "сэмплов " + ИмяСэмпла).Равно(1);

КонецПроцедуры

&Тест
Процедура СчетчикИДатчикСОднимИменемВТекстеДаютОдинTYPE() Экспорт

    // Дано - счетчик "foo" с единицей By выводится как foo_bytes_total, датчик "foo_bytes_total"
    //   пишет другую серию. В text format 0.0.4 строка TYPE у метрики одна
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("clash-lib", "1.0"), Новый ОтелРесурс(Истина));
    АтрибутыСчетчика = Новый ОтелАтрибуты();
    АтрибутыСчетчика.Установить("kind", "counter");
    Метр.СоздатьСчетчик("foo", "", "By").Добавить(1, АтрибутыСчетчика);
    АтрибутыДатчика = Новый ОтелАтрибуты();
    АтрибутыДатчика.Установить("kind", "gauge");
    Метр.СоздатьДатчик("foo_bytes_total").Записать(5, АтрибутыДатчика);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);
    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);

    // Когда
    Строки = СтрРазделить(Читатель.СобратьВТексте(), Символы.ПС, Ложь);
    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);

    // Тогда - датчик пропущен с предупреждением о конфликте TYPE, счетчик выведен
    Ожидаем.Что(СтрокиСПрефиксом(Строки, "# TYPE foo_bytes_total ").Количество()).Равно(1);
    Ожидаем.Что(Строки.Найти("# TYPE foo_bytes_total counter")).Не_().Равно(Неопределено);
    СтрокаСчетчика = "foo_bytes_total{kind=""counter"",otel_scope_name=""clash-lib"",otel_scope_version=""1.0""} 1";
    Ожидаем.Что(Строки.Найти(СтрокаСчетчика)).Не_().Равно(Неопределено);
    Ожидаем.Что(ЕстьПредупреждениеСТекстом(Аппендер, "Конфликт TYPE для 'foo_bytes_total'"),
        "предупреждение в логе").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДублирующаясяСерияГистограммыОтбрасываетсяЦеликом() Экспорт

    // Дано - две гистограммы, имена которых совпадают после экранирования, в одном метре
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("dup-lib", "1.0"), Новый ОтелРесурс(Истина));
    Первая = Метр.СоздатьГистограмму("dup.hist");
    Вторая = Метр.СоздатьГистограмму("dup_hist");
    Первая.Записать(5);
    Вторая.Записать(7);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Семейства = Читатель.СобратьСемейства();

    // Тогда - в семействе только точка первой гистограммы, сэмплы второй не подмешаны
    Ожидаем.Что(Семейства).ИмеетДлину(1);
    Сэмплы = Семейства[0].Получить("Сэмплы");
    Ожидаем.Что(ЗначенияСэмплов(Сэмплы, "dup_hist_count")).ИмеетДлину(1);
    Ожидаем.Что(ЗначенияСэмплов(Сэмплы, "dup_hist_sum")[0]).Равно(5);

КонецПроцедуры

Процедура НаблюдатьДесять(Наблюдение) Экспорт
    Наблюдение.Записать(10);
КонецПроцедуры

Процедура НаблюдатьПятьсот(Наблюдение) Экспорт
    Наблюдение.Записать(500);
КонецПроцедуры

Процедура НаблюдатьПервоеОкружение(Наблюдение) Экспорт
    Атрибуты = Новый ОтелАтрибуты();
    Атрибуты.Установить("env", "prod");
    Наблюдение.Записать(10, Атрибуты);
КонецПроцедуры

Процедура НаблюдатьВтороеОкружение(Наблюдение) Экспорт
    Атрибуты = Новый ОтелАтрибуты();
    Атрибуты.Установить("env", "dev");
    Наблюдение.Записать(500, Атрибуты);
КонецПроцедуры

Функция ЗначенияСэмплов(Сэмплы, ИмяСэмпла)
    Значения = Новый Массив();
    Для Каждого Сэмпл Из Сэмплы Цикл
        Если Сэмпл.Получить("ИмяСэмпла") = ИмяСэмпла Тогда
            Значения.Добавить(Сэмпл.Получить("Значение"));
        КонецЕсли;
    КонецЦикла;
    Возврат Значения;
КонецФункции

Функция СоздатьТестовыйАппендер()
    Текст = "Перем События Экспорт;
    |Процедура ВывестиСобытие(Событие) Экспорт
    |    События.Добавить(Событие);
    |КонецПроцедуры
    |Процедура Закрыть() Экспорт
    |КонецПроцедуры
    |Процедура УстановитьСвойство(Имя, Значение) Экспорт
    |КонецПроцедуры
    |События = Новый Массив();";
    Возврат ЗагрузитьСценарийИзСтроки(Текст);
КонецФункции

Функция ЕстьПредупреждениеСТекстом(Аппендер, Текст)
    Для Каждого Событие Из Аппендер.События Цикл
        Если Событие.ПолучитьУровень() = УровниЛога.Предупреждение
                И СтрНайти(Событие.ПолучитьСообщение(), Текст) > 0 Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

&Тест
