    // Тогда - scope лейблы присутствуют на всех сэмплах гистограммы
    Ожидаем.Что(СтрНайти(Текст, "otel_scope_name=""histo-lib""") > 0).ЭтоИстина();
    Ожидаем.Что(СтрНайти(Текст, "otel_scope_version=""3.0""") > 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ScopeЛейблыВключаютАдресСхемыИАтрибутыОбласти() Экспорт

    // Дано - спецификация совместимости (Instrumentation Scope, Stable): экспортер MUST по
    //   умолчанию добавлять имя, версию, адрес схемы и атрибуты области лейблами otel_scope_*;
    //   атрибут, совпадающий после префикса с otel_scope_name/version/schema_url, отбрасывается
    АтрибутыОбласти = Новый ОтелАтрибуты();
    АтрибутыОбласти.Установить("library.mascot", "gopher");
    АтрибутыОбласти.Установить("name", "конфликт");
    Область = Новый ОтелОбластьИнструментирования("scope-lib", "1.0", АтрибутыОбласти, "https://schema/1.0");
    Метр = Новый ОтелМетр(Область, Новый ОтелРесурс(Истина));
    Метр.СоздатьСчетчик("scoped").Добавить(1);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Семейства = Читатель.СобратьСемейства();

    // Тогда
    Лейблы = Семейства[0].Получить("Сэмплы")[0].Получить("Лейблы");
    Ожидаем.Что(Лейблы.Получить("otel_scope_name"), "имя области").Равно("scope-lib");
    Ожидаем.Что(Лейблы.Получить("otel_scope_version"), "версия области").Равно("1.0");
    Ожидаем.Что(Лейблы.Получить("otel_scope_schema_url"), "адрес схемы").Равно("https://schema/1.0");
    Ожидаем.Что(Лейблы.Получить("otel_scope_library_mascot"), "атрибут области").Равно("gopher");

КонецПроцедуры

&Тест
Процедура СерииОбластейСРазнымиАдресамиСхемыНеСклеиваются() Экспорт

    // Дано - два метра с одинаковыми именем и версией, но разными адресами схемы пишут
    //   одноименный счетчик: серии различаются лейблом otel_scope_schema_url
    ПервыйМетр = Новый ОтелМетр(
        Новый ОтелОбластьИнструментирования("same-lib", "1.0", , "https://a"), Новый ОтелРесурс(Истина));
    ВторойМетр = Новый ОтелМетр(
        Новый ОтелОбластьИнструментирования("same-lib", "1.0", , "https://b"), Новый ОтелРесурс(Истина));
    ПервыйМетр.СоздатьСчетчик("shared").Добавить(1);
    ВторойМетр.СоздатьСчетчик("shared").Добавить(2);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(ПервыйМетр);
    Читатель.ДобавитьМетр(ВторойМетр);

    // Когда
    Семейства = Читатель.СобратьСемейства();

    // Тогда - точки обоих метров в выдаче
    Ожидаем.Что(Семейства).ИмеетДлину(1);
    Ожидаем.Что(Семейства[0].Получить("Сэмплы")).ИмеетДлину(2);

КонецПроцедуры

&Тест
Процедура МультиПровайдерЗащита() Экспорт

    // Дано - один читатель Prometheus
    Читатель = Новый ОтелПрометеусЧитательМетрик();

    // Когда - первая регистрация
    Результат1 = Читатель.ЗарегистрироватьУПровайдера();

    // Тогда - успешно
    Ожидаем.Что(Результат1).Равно(Истина);

    // Когда - вторая регистрация (у другого провайдера)
    Результат2 = Читатель.ЗарегистрироватьУПровайдера();

    // Тогда - отклонена
    Ожидаем.Что(Результат2).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура НеизвестныйТипМетрикиПропускается() Экспорт

    // Дано - инструмент с неизвестным типом метрики
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0");
    ТочкиДанных = Новый Массив();
    ТочкаДанных = Новый Соответствие();
    ТочкаДанных.Вставить("value", 1);
    ТочкиДанных.Добавить(ТочкаДанных);
    МетрикаСНеизвестнымТипом = Новый ОтелДанныеМетрики(
        Ресурс, ОбластьИнструментирования,
        "unknown_metric", "", "1", "unknown_type", ТочкиДанных);

    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(МетрСДанными(ОбластьИнструментирования, МетрикаСНеизвестнымТипом));

    // Когда
    Семейства = Читатель.СобратьСемейства();

    // Тогда - неизвестный тип метрики пропущен, семейства пусты
    Ожидаем.Что(Семейства.Количество()).Равно(0);

