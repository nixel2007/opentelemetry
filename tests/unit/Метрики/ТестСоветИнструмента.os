КонецПроцедуры

&Тест
Процедура РеверсивныйСчетчикСAdvisory() Экспорт

    // Дано
    Метр = СоздатьМетр();
    Совет = СоздатьСоветСГраницами();

    // Когда
    Счетчик = Метр.СоздатьРеверсивныйСчетчик("test.updown", , , Совет);

    // Тогда
    Ожидаем.Что(Счетчик.Имя()).Равно("test.updown");

КонецПроцедуры

&Тест
Процедура НаблюдаемыйДатчикСAdvisoryКлючамиНеФильтруетАтрибуты() Экспорт

    // Дано - ключи атрибутов в Совете асинхронного инструмента
    Метр = СоздатьМетр();
    Датчик = Метр.СоздатьНаблюдаемыйДатчик("test.obs.filtered",
        Новый Действие(ЭтотОбъект, "НаблюдатьСТремяАтрибутами"), , , СоздатьСоветСКлючами());

    // Когда
    Данные = СобратьДанные(Датчик, Метр);

    // Тогда - в точке данных все атрибуты
    МассивАтрибутов = Данные.ТочкиДанных()[0].Получить("attributes");
    Ожидаем.Что(МассивАтрибутов.Количество()).Равно(3);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("5|1")
&ИсточникЗначение("1|1")
&ИсточникЗначение("1|x")
Процедура НевалидныеГраницыСоветаИгнорируются(Случай) Экспорт

    // Дано - границы advisory не являются числами по строгому возрастанию
    Метр = СоздатьМетр();
    МокЛог = Мок.Получить(Тип("Лог"));
    Метр.УстановитьЛог(МокЛог);
    Границы = Новый Массив;
    Для Каждого Значение Из СтрРазделить(Случай, "|") Цикл
        Границы.Добавить(?(Значение = "x", Значение, Число(Значение)));
    КонецЦикла;

    // Когда
    Гистограмма = Метр.СоздатьГистограмму("test.invalid.bounds", , ,
        Новый Структура("ГраницыГистограммы", Границы));
    Гистограмма.Записать(1);

    // Тогда - пользователь предупрежден, работа идет как без параметра: границы по умолчанию
    МокЛог.ПроверитьЧтоВызывалсяМетод().Предупреждение(
        Матчеры.Содержит("строгому возрастанию"), Матчеры.ЛюбоеЗначение());
    ТочкаДанных = СобратьДанные(Гистограмма, Метр).ТочкиДанных()[0];
    Ожидаем.Что(ТочкаДанных.Получить("explicitBounds")).ИмеетДлину(15);

КонецПроцедуры

Процедура НаблюдатьСТремяАтрибутами(Наблюдение) Экспорт
    Атрибуты = Новый ОтелАтрибуты;
    Атрибуты.Установить("http.method", "GET");
    Атрибуты.Установить("http.status_code", "200");
    Атрибуты.Установить("http.url", "/api/test");
    Наблюдение.Записать(7, Атрибуты);
КонецПроцедуры
