// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать "../../.."
#Использовать asserts
#Использовать atomic
#Использовать extends

// Состояние для фоновых заданий
Перем Инструмент;
Перем КоличествоЗаданий;
Перем НаЗадание;
Перем Прибыло;

// Metrics API: методы инструмента безопасны для конкурентного вызова по умолчанию

&Тест
Процедура КонкурентноеДобавлениеCallbackНеТеряетРегистрации() Экспорт

    // Дано - наблюдаемый счетчик без callback-ов
    ПодготовитьИнструмент(4, 300);

    // Когда - задания одновременно добавляют разные callback-и
    Задания = ЗапуститьЗадания("ДобавитьCallbackи");

    // Тогда - каждый callback зарегистрирован: по точке данных на callback
    ПроверитьЗадания(Задания);
    Ожидаем.Что(КоличествоТочек(), "точек данных").Равно(КоличествоЗаданий * НаЗадание);

КонецПроцедуры

&Тест
Процедура КонкурентноеДобавлениеВнешнихНаблюденийНеТеряетЗаписи() Экспорт

    // Дано - идет dispatch мульти-callback: внешние наблюдения принимаются
    ПодготовитьИнструмент(4, 300);
    Инструмент.УстановитьВыполняетсяCallback(Истина);

    // Когда - задания одновременно добавляют наблюдения с разными атрибутами
    Задания = ЗапуститьЗадания("ДобавитьНаблюдения");
    Инструмент.УстановитьВыполняетсяCallback(Ложь);

    // Тогда
    ПроверитьЗадания(Задания);
    Ожидаем.Что(КоличествоТочек(), "точек данных").Равно(КоличествоЗаданий * НаЗадание);

КонецПроцедуры

// Выполняется фоновыми заданиями: после общего старта добавляет НаЗадание callback-ов.
//
Процедура ДобавитьCallbackи(НомерЗадания) Экспорт
    ДождатьсяОбщегоСтарта();
    Для Номер = 1 По НаЗадание Цикл
        Инструмент.ДобавитьCallback(Новый Действие(ЭтотОбъект, "Наблюдать"), КлючСерии(НомерЗадания, Номер));
    КонецЦикла;
КонецПроцедуры

// Выполняется фоновыми заданиями: после общего старта добавляет НаЗадание наблюдений.
//
Процедура ДобавитьНаблюдения(НомерЗадания) Экспорт
    ДождатьсяОбщегоСтарта();
    Для Номер = 1 По НаЗадание Цикл
        Наблюдение = Новый ОтелНаблюдениеМетрики();
        Наблюдать(Наблюдение, КлючСерии(НомерЗадания, Номер));
        Инструмент.ДобавитьВнешниеНаблюдения(Наблюдение);
    КонецЦикла;
КонецПроцедуры

Процедура Наблюдать(Наблюдение, Серия) Экспорт
    Атрибуты = Новый ОтелАтрибуты();
    Атрибуты.Установить("series", Серия);
    Наблюдение.Записать(1, Атрибуты);
КонецПроцедуры

Процедура ПодготовитьИнструмент(Заданий, Добавлений)
    АгрегаторБаза = Новый ОтелБазовыйАгрегатор(ОтелТипМетрики.Сумма(), Истина, "int");
    Агрегатор = Новый ПостроительНаследника(Новый ОтелАгрегаторСуммы(), АгрегаторБаза).Построить();
    Инструмент = Новый ОтелБазовыйНаблюдаемыйИнструмент("obs.concurrent", Неопределено, "", "1", Агрегатор);
    Инструмент.УстановитьЛимитМощности(100000);
    КоличествоЗаданий = Заданий;
    НаЗадание = Добавлений;
    Прибыло = Новый АтомарноеЧисло(0);
КонецПроцедуры

Функция ЗапуститьЗадания(ИмяМетода)
    Задания = Новый Массив();
    Для НомерЗадания = 1 По КоличествоЗаданий Цикл
        Параметры = Новый Массив();
        Параметры.Добавить(НомерЗадания);
        Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, ИмяМетода, Параметры));
    КонецЦикла;
    ФоновыеЗадания.ОжидатьВсе(Задания);
    Возврат Задания;
КонецФункции

Процедура ПроверитьЗадания(Задания)
    Для Каждого Задание Из Задания Цикл
        Ожидаем.Что(Задание.ИнформацияОбОшибке, "ошибка фонового задания").Равно(Неопределено);
    КонецЦикла;
КонецПроцедуры

Функция КоличествоТочек()
    Данные = Инструмент.Собрать(Новый ОтелРесурс(Истина), Новый ОтелОбластьИнструментирования("test"),
        "obs.concurrent", "");
    Возврат Данные.ТочкиДанных().Количество();
КонецФункции

// Задания стартуют одновременно: каждое ждет, пока до барьера дойдут все.
// Ожидание ограничено временем; периодически задание уступает процессор.
//
Процедура ДождатьсяОбщегоСтарта()
    ТаймаутБарьераМс = 30000;
    ВитковДоУступки = 1000;
    Прибыло.ИнкрементироватьИПолучить();
    НачалоОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Витков = 0;
    Пока Прибыло.Получить() < КоличествоЗаданий Цикл
        Витков = Витков + 1;
        Если Витков % ВитковДоУступки = 0 Тогда
            Приостановить(0);
        КонецЕсли;
        Если ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжидания > ТаймаутБарьераМс Тогда
            Возврат;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция КлючСерии(НомерЗадания, Номер)
    Возврат Формат(НомерЗадания, "ЧГ=") + "-" + Формат(Номер, "ЧГ=");
КонецФункции
