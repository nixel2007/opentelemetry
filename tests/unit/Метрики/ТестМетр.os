&Тест
Процедура КонфликтСоветаОдинНеопределено() Экспорт

	// Дано - гистограмма зарегистрирована без Совета
	Ресурс = Новый ОтелРесурс();
	ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0.0");
	Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
	МокЛог = Мок.Получить(Тип("Лог"));
	Метрика.УстановитьЛог(МокЛог);

	Метрика.СоздатьГистограмму("hist.advice.one-undefined", "", "", Неопределено);

	// Когда - регистрируем с тем же именем, но с Советом (один Неопределено, другой нет)
	Г = Новый Массив();
	Г.Добавить(1);
	Г.Добавить(10);
	Совет = Новый Структура("ГраницыГистограммы", Г);
	Метрика.СоздатьГистограмму("hist.advice.one-undefined", "", "", Совет);

	// Тогда - конфликт advisory → предупреждение с различием и рецептом через View
	МокЛог.ПроверитьЧтоВызывалсяМетод().Предупреждение(
		Матчеры.СоответствуетВыражению(РегулярноеВыражениеКонфликтаСовета()));

