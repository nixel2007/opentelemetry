	Пара.Вставить("Селектор", Новый ОтелСелекторИнструментов()); // Имя = Неопределено (широкий)
	Пара.Вставить("Представление", Новый ОтелПредставление("renamed.metric"));
	Пары.Добавить(Пара);

	// Когда - регистрируем View с НовоеИмя и широким селектором
	Метрика.УстановитьПредставления(Пары);

	// Тогда - предупреждение о широком селекторе с НовоеИмя
	МокЛог.ПроверитьЧтоВызывалсяМетод().Предупреждение(
		Матчеры.Содержит("НовоеИмя"),
		Матчеры.ЛюбоеЗначение(),
		Матчеры.ЛюбоеЗначение());

