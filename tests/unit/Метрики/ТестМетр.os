&ПараметризованныйТест
&ИсточникЗначение("Единица")
&ИсточникЗначение("ВерсияМетра")
&ИсточникЗначение("АдресСхемыМетра")
&ИсточникЗначение("ИмяВСмешанномРегистре")
Процедура ViewПрименяетсяПоКритериюСелектора(Критерий) Экспорт

	// Дано - View с агрегацией "drop" выбирает инструмент по одному из критериев селектора
	Ресурс = Новый ОтелРесурс();
	ОбластьИнструментирования = Новый ОтелОбластьИнструментирования(
		"test-lib", "1.0.0", , "https://example.com/schema/1");
	Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);

	Пары = Новый Массив();
	Пара = Новый Соответствие();
	Пара.Вставить("Селектор", СелекторПоКритерию(Критерий));
	Пара.Вставить("Представление", Новый ОтелПредставление(, , , , ОтелАгрегация.Отбросить()));
	Пары.Добавить(Пара);
	Метрика.УстановитьПредставления(Пары);

	// Когда
	Счетчик = Метрика.СоздатьСчетчик("Selected.Counter", "", "ms");
	Счетчик.Добавить(5);

	// Тогда - View применен: данные отброшены
	Ожидаем.Что(СобратьДанные(Счетчик, Метрика)).Равно(Неопределено);

КонецПроцедуры

Функция СелекторПоКритерию(Критерий)
	Если Критерий = "Единица" Тогда
		Возврат Новый ОтелСелекторИнструментов("Selected.Counter", , , "ms");
	ИначеЕсли Критерий = "ВерсияМетра" Тогда
		Возврат Новый ОтелСелекторИнструментов("Selected.Counter", , , , "1.0.0");
	ИначеЕсли Критерий = "АдресСхемыМетра" Тогда
		Возврат Новый ОтелСелекторИнструментов("Selected.Counter", , , , , "https://example.com/schema/1");
	Иначе
		Возврат Новый ОтелСелекторИнструментов("Selected.Counter");
	КонецЕсли;
КонецФункции

&Тест
Процедура ViewАгрегацияLastValueДляСчетчика() Экспорт

	// Дано - View с агрегацией "last_value" для счетчика
	Ресурс = Новый ОтелРесурс();
	ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0.0");
	Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);

	Пары = Новый Массив();
	Пара = Новый Соответствие();
	Пара.Вставить("Селектор", Новый ОтелСелекторИнструментов("lv.counter"));
	Пара.Вставить("Представление", Новый ОтелПредставление(, , , , ОтелАгрегация.ПоследнееЗначение()));
	Пары.Добавить(Пара);
	Метрика.УстановитьПредставления(Пары);

	// Когда - создаём счетчик с View-агрегацией "last_value"
	Счетчик = Метрика.СоздатьСчетчик("lv.counter");

	// Тогда - инструмент создан, данные собираются как датчик: тип точек задает агрегация
	Ожидаем.Что(Счетчик).Не_().Равно(Неопределено);
	Счетчик.Добавить(10);
	Данные = СобратьДанные(Счетчик, Метрика);
	Ожидаем.Что(Данные).Не_().Равно(Неопределено);
	Ожидаем.Что(Данные.ТипМетрики()).Равно(ОтелТипМетрики.Датчик());

КонецПроцедуры

&Тест
Процедура УстановитьПредставленияНеопределено() Экспорт

	// Дано - метр с несколькими инструментами
	Ресурс = Новый ОтелРесурс();
	ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0.0");
	Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);

	// Когда - устанавливаем представления = Неопределено (ветка раннего выхода)
	ЕстьИсключение = Ложь;
	Попытка
		Метрика.УстановитьПредставления(Неопределено);
	Исключение
		ЕстьИсключение = Истина;
	КонецПопытки;

	// Тогда - нет исключения
	Ожидаем.Что(ЕстьИсключение).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура КонфликтОписанияСViewОписаниеПодавляется() Экспорт

	// Дано - View задаёт НовоеОписание для инструмента
	Ресурс = Новый ОтелРесурс();
	ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0.0");
	Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
	МокЛог = Мок.Получить(Тип("Лог"));
	Метрика.УстановитьЛог(МокЛог);

	Пары = Новый Массив();
	Пара = Новый Соответствие();
	Пара.Вставить("Селектор", Новый ОтелСелекторИнструментов("view.desc.counter"));
	Пара.Вставить("Представление", Новый ОтелПредставление(, "Описание из View"));
	Пары.Добавить(Пара);
	Метрика.УстановитьПредставления(Пары);

	// Регистрируем первый счетчик с описанием
	Первый = Метрика.СоздатьСчетчик("view.desc.counter", "Первое описание");

	// Когда - регистрируем второй с другим описанием (конфликт описания)
	Второй = Метрика.СоздатьСчетчик("view.desc.counter", "Другое описание");

	// Тогда - возвращён первый инструмент (предупреждение подавлено View)
	Ожидаем.Что(Второй).Равно(Первый);

КонецПроцедуры

