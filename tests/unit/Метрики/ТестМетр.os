&Тест
Процедура ГистограммаСАгрегациейBase2Exponential() Экспорт

	// Дано - устанавливаем base2_exponential_bucket_histogram как дефолт
	Ресурс = Новый ОтелРесурс();
	ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0.0");
	Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
	Метрика.УстановитьАгрегациюГистограммПоУмолчанию("base2_exponential_bucket_histogram");

	// Когда - создаём гистограмму
	Гистограмма = Метрика.СоздатьГистограмму("exp.latency");

	// Тогда - тип метрики соответствует ExponentialHistogram
	Гистограмма.Записать(5);
	Данные = СобратьДанные(Гистограмма, Метрика);
	Ожидаем.Что(Данные.ТипМетрики()).Равно(ОтелТипМетрики.ЭкспоненциальнаяГистограмма());

