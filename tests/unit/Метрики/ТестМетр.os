&Тест
Процедура ЗарегистрироватьОбратныйВызовНеопределеноВСписке() Экспорт

	// Дано - список инструментов содержит Неопределено
	Ресурс = Новый ОтелРесурс();
	ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0.0");
	Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
	МокЛог = Мок.Получить(Тип("Лог"));
	Метрика.УстановитьЛог(МокЛог);

	СписокСНеопределенным = Новый Массив();
	СписокСНеопределенным.Добавить(Неопределено);

	МультиCallback = Новый Действие(ЭтотОбъект, "НоопОбратныйВызов");

	// Когда - регистрируем callback со списком, содержащим Неопределено
	Метрика.ЗарегистрироватьОбратныйВызов(МультиCallback, СписокСНеопределенным);

	// Тогда - регистрация отклонена, предупреждение о чужом инструменте
	МокЛог.ПроверитьЧтоВызывалсяМетод().Предупреждение(
		Матчеры.Содержит("не созданный этим Meter"));

