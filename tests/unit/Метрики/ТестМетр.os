&Тест
Процедура ОтключитьИнструментыСИсключением() Экспорт

	// Дано - метрика с инструментом, бросающим исключение при вызове Отключить
	Ресурс = Новый ОтелРесурс();
	ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0.0");
	Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
	ТекстИнструмента = "
	|Функция Имя() Экспорт
	|    Возврат ""bad.instrument"";
	|КонецФункции
	|Процедура Отключить() Экспорт
	|    ВызватьИсключение ""Тест: ошибка при отключении"";
	|КонецПроцедуры";
	БросающийИнструмент = ЗагрузитьСценарийИзСтроки(ТекстИнструмента);
	Метрика.Инструменты().Добавить(БросающийИнструмент);

	// Когда - вызываем ОтключитьИнструменты
	ЕстьИсключение = Ложь;
	Попытка
		Метрика.ОтключитьИнструменты();
	Исключение
		ЕстьИсключение = Истина;
	КонецПопытки;

	// Тогда - исключение из Отключить() поглощено, не пробросилось наружу
	Ожидаем.Что(ЕстьИсключение).Равно(Ложь);

КонецПроцедуры

