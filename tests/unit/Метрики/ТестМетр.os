	// Когда - создаём счётчик с Неопределено вместо описания и единицы измерения
	Счетчик = Метрика.СоздатьСчетчик("valid.name", Неопределено, Неопределено);

	// Тогда - счётчик создан, описание и единица = пустые строки
	Ожидаем.Что(Счетчик).Не_().Равно(Неопределено);

