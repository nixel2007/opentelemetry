// Metrics API: callback-и, переданные при создании асинхронного инструмента, регистрируются
// навсегда - и при повторном создании идентичного инструмента (данные идентичных
// инструментов агрегируются вместе)

&Тест
Процедура ПовторноеСозданиеНаблюдаемогоИнструментаДобавляетCallback() Экспорт

	// Дано
	Метрика = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("test-lib", "1.0.0"), Новый ОтелРесурс());

	// Когда
	Счетчик1 = Метрика.СоздатьНаблюдаемыйСчетчик("dup.counter", Новый Действие(ЭтотОбъект, "НаблюдатьПервый"));
	Счетчик2 = Метрика.СоздатьНаблюдаемыйСчетчик("dup.counter", Новый Действие(ЭтотОбъект, "НаблюдатьВторой"));
	Данные = СобратьДанные(Счетчик1, Метрика);

	// Тогда - один инструмент с наблюдениями обоих callback-ов
	Ожидаем.Что(Счетчик2).Равно(Счетчик1);
	Ожидаем.Что(Данные.ТочкиДанных()).ИмеетДлину(2);

КонецПроцедуры

Процедура НаблюдатьПервый(Наблюдение) Экспорт
	Наблюдение.Записать(1, АтрибутыИсточника("first"));
КонецПроцедуры

Процедура НаблюдатьВторой(Наблюдение) Экспорт
	Наблюдение.Записать(2, АтрибутыИсточника("second"));
КонецПроцедуры

Функция АтрибутыИсточника(Источник)
	Атрибуты = Новый ОтелАтрибуты();
	Атрибуты.Установить("src", Источник);
	Возврат Атрибуты;
КонецФункции

// Metrics API: регистрацию callback-а, добавленного после создания инструмента, в том числе
// мульти-callback-а нескольких инструментов, MUST можно отменить

&Тест
Процедура РегистрациюCallbackИнструментаМожноОтменить() Экспорт

	// Дано
	Метрика = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("test-lib", "1.0.0"), Новый ОтелРесурс());
	Датчик = Метрика.СоздатьНаблюдаемыйДатчик("undo.gauge");
	Регистрация = Датчик.ДобавитьCallback(Новый Действие(ЭтотОбъект, "НаблюдатьПервый"));

	// Когда
	Регистрация.Закрыть();

	// Тогда
	Ожидаем.Что(СобратьДанные(Датчик, Метрика)).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура РегистрациюМультиCallbackМожноОтменить() Экспорт

	// Дано
	Метрика = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("test-lib", "1.0.0"), Новый ОтелРесурс());
	Датчик1 = Метрика.СоздатьНаблюдаемыйДатчик("gauge1");
	Датчик2 = Метрика.СоздатьНаблюдаемыйДатчик("gauge2");
	Инструменты = Новый Массив();
	Инструменты.Добавить(Датчик1);
	Инструменты.Добавить(Датчик2);
	Регистрация = Метрика.ЗарегистрироватьОбратныйВызов(
		Новый Действие(ЭтотОбъект, "МультиОбратныйВызовДляТеста"), Инструменты);

	// Когда
	Регистрация.Закрыть();
	Метрика.ВызватьМультиОбратныеВызовы();

	// Тогда - мульти-callback больше не вызывается
	Ожидаем.Что(СобратьДанные(Датчик1, Метрика)).Равно(Неопределено);
	Ожидаем.Что(СобратьДанные(Датчик2, Метрика)).Равно(Неопределено);

КонецПроцедуры

// Metrics API: мульти-callback MUST связываться с набором асинхронных инструментов того же Meter

&Тест
Процедура МультиCallbackССинхроннымИнструментомОтклоняется() Экспорт

	// Дано
	Метрика = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("test-lib", "1.0.0"), Новый ОтелРесурс());
	МокЛог = Мок.Получить(Тип("Лог"));
	Метрика.УстановитьЛог(МокЛог);
	Счетчик = Метрика.СоздатьСчетчик("sync.counter");
	Счетчик.Добавить(5);
	Инструменты = Новый Массив();
	Инструменты.Добавить(Счетчик);

	// Когда
	Регистрация = Метрика.ЗарегистрироватьОбратныйВызов(Новый Действие(ЭтотОбъект, "НоопОбратныйВызов"), Инструменты);
	Метрика.ВызватьМультиОбратныеВызовы();
	Регистрация.Закрыть();

	// Тогда - регистрация отклонена, данные синхронного счетчика не сброшены
	МокЛог.ПроверитьЧтоВызывалсяМетод().Предупреждение(Матчеры.Содержит("не асинхронный"));
	Ожидаем.Что(СобратьДанные(Счетчик, Метрика).ТочкиДанных()).ИмеетДлину(1);

КонецПроцедуры

// Metrics API: наблюдения одного callback-а MUST считаться одним моментом времени -
// у наблюдений мульти-callback-а для разных инструментов одинаковый timestamp

&Тест
Процедура НаблюденияМультиCallbackИмеютОдинаковоеВремя() Экспорт

	// Дано - собственный callback второго датчика выполняется 50 мс
	Метрика = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("test-lib", "1.0.0"), Новый ОтелРесурс());
	Датчик1 = Метрика.СоздатьНаблюдаемыйДатчик("gauge1");
	Датчик2 = Метрика.СоздатьНаблюдаемыйДатчик("gauge2", Новый Действие(ЭтотОбъект, "МедленноНаблюдать"));
	Инструменты = Новый Массив();
	Инструменты.Добавить(Датчик1);
	Инструменты.Добавить(Датчик2);
	Метрика.ЗарегистрироватьОбратныйВызов(Новый Действие(ЭтотОбъект, "МультиОбратныйВызовДляТеста"), Инструменты);

	// Когда
	Метрика.ВызватьМультиОбратныеВызовы();
	Приостановить(20);
	Точка1 = ТочкаСоЗначением(СобратьДанные(Датчик1, Метрика), 10);
	Точка2 = ТочкаСоЗначением(СобратьДанные(Датчик2, Метрика), 20);

	// Тогда
	Ожидаем.Что(Точка1.Получить("timeUnixNano")).Равно(Точка2.Получить("timeUnixNano"));

КонецПроцедуры

Процедура МедленноНаблюдать(Наблюдение) Экспорт
	Приостановить(50);
	Наблюдение.Записать(1, АтрибутыИсточника("own"));
КонецПроцедуры

Функция ТочкаСоЗначением(Данные, Значение)
	Для Каждого Точка Из Данные.ТочкиДанных() Цикл
		Если Точка.Получить("value") = Значение Тогда
			Возврат Точка;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Нет точки со значением " + Значение;
КонецФункции

// Наблюдения одного callback-а, в том числе ушедшие в точку переполнения лимита мощности,
// получают одинаковый timestamp

&Тест
Процедура ТочкаПереполненияИмеетВремяНаблюдений() Экспорт

	// Дано - лимит мощности 2, первый callback записывает три набора атрибутов (третий уходит
	// в точку переполнения), второй callback выполняется 50 мс
	Метрика = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("test-lib", "1.0.0"), Новый ОтелРесурс());
	Метрика.УстановитьЛимитМощности(2);
	Датчик = Метрика.СоздатьНаблюдаемыйДатчик("overflow.gauge", Новый Действие(ЭтотОбъект, "НаблюдатьТриНабора"));
	Датчик.ДобавитьCallback(Новый Действие(ЭтотОбъект, "МедленноНичегоНеНаблюдать"));

	// Когда
	Точки = СобратьДанные(Датчик, Метрика).ТочкиДанных();

	// Тогда - у всех точек первого callback-а, включая точку переполнения, одно время
	Ожидаем.Что(Точки).ИмеетДлину(3);
	Для Каждого Точка Из Точки Цикл
		Ожидаем.Что(Точка.Получить("timeUnixNano")).Равно(Точки[0].Получить("timeUnixNano"));
	КонецЦикла;

КонецПроцедуры

Процедура НаблюдатьТриНабора(Наблюдение) Экспорт
	Наблюдение.Записать(1, АтрибутыИсточника("a"));
	Наблюдение.Записать(2, АтрибутыИсточника("b"));
	Наблюдение.Записать(3, АтрибутыИсточника("c"));
КонецПроцедуры

Процедура МедленноНичегоНеНаблюдать(Наблюдение) Экспорт // BSLLS:UnusedParameters-off
	Приостановить(50);
КонецПроцедуры

// Metrics SDK: "The implementation SHOULD use a timeout to prevent indefinite callback execution."
// Таймаут метра ограничивает callback-и его асинхронных инструментов и мульти-callback-и

&Тест
Процедура ТаймаутОбратныхВызововПоУмолчанию30Секунд() Экспорт

	// Дано
	Метрика = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("test-lib"), Новый ОтелРесурс());

	// Когда
	Датчик = Метрика.СоздатьНаблюдаемыйДатчик("default.timeout.gauge", Новый Действие(ЭтотОбъект, "НаблюдатьБыстро"));

	// Тогда
	Ожидаем.Что(Метрика.ТаймаутОбратныхВызововМс()).Равно(30000);
	Ожидаем.Что(Датчик.ТаймаутCallbackМс()).Равно(30000);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("инструмента")
&ИсточникЗначение("мульти")
Процедура ДолгийОбратныйВызовПрерываетсяПоТаймаутуМетра(Случай) Экспорт

	// Дано - callback медленного датчика выполняется 1000 мс, таймаут метра задан после создания
	// инструментов
	Метрика = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("test-lib"), Новый ОтелРесурс());
	МедленныйДатчик(Метрика, Случай, СостояниеМедленного(1000));
	Метрика.СоздатьНаблюдаемыйДатчик("fast.gauge", Новый Действие(ЭтотОбъект, "НаблюдатьБыстро"));
	Метрика.УстановитьТаймаутОбратныхВызововМс(100);

	// Когда
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Данные = Метрика.СобратьДляЧитателя(Неопределено);
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	// Тогда - сбор не ждет медленный callback, его наблюдения отброшены
	Ожидаем.Что(Длительность).Меньше(800);
	Ожидаем.Что(Данные).ИмеетДлину(1);
	Ожидаем.Что(Данные[0].Имя()).Равно("fast.gauge");

КонецПроцедуры

// Callback, задание которого продолжает выполняться после таймаута, не запускается повторно
// до своего завершения: следующий раунд сбора не выполняет его параллельно, зависшие задания
// не копятся

&ПараметризованныйТест
&ИсточникЗначение("инструмента")
&ИсточникЗначение("мульти")
Процедура ЗависшийОбратныйВызовНеЗапускаетсяПовторно(Случай) Экспорт

	// Дано - callback выполняется 700 мс при таймауте метра 100 мс
	Метрика = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("test-lib"), Новый ОтелРесурс());
	Метрика.УстановитьТаймаутОбратныхВызововМс(100);
	Состояние = СостояниеМедленного(700);
	МедленныйДатчик(Метрика, Случай, Состояние);

	// Когда - второй сбор начинается, пока задание первого еще выполняется
	Метрика.СобратьДляЧитателя(Неопределено);
	Метрика.СобратьДляЧитателя(Неопределено);

	// Тогда - callback не запущен повторно
	Ожидаем.Что(Состояние.Вызовы.Получить()).Равно(1);

	// Когда - задание первого сбора завершилось
	Состояние.ЗадержкаМс = 0;
	Приостановить(800);
	Данные = Метрика.СобратьДляЧитателя(Неопределено);

	// Тогда - callback снова вызывается
	Ожидаем.Что(Состояние.Вызовы.Получить()).Равно(2);
	Ожидаем.Что(Данные).ИмеетДлину(1);

КонецПроцедуры

Функция МедленныйДатчик(Метрика, Случай, Состояние)
	Датчик = Метрика.СоздатьНаблюдаемыйДатчик("slow.gauge");
	Если Случай = "инструмента" Тогда
		Датчик.ДобавитьCallback(Новый Действие(ЭтотОбъект, "НаблюдатьМедленно"), Состояние);
	Иначе
		Инструменты = Новый Массив();
		Инструменты.Добавить(Датчик);
		Метрика.ЗарегистрироватьОбратныйВызов(Новый Действие(ЭтотОбъект, "НаблюдатьМедленноМульти"), Инструменты,
			Состояние);
	КонецЕсли;
	Возврат Датчик;
КонецФункции

Функция СостояниеМедленного(ЗадержкаМс)
	Возврат Новый Структура("ЗадержкаМс, Вызовы", ЗадержкаМс, Новый АтомарноеЧисло());
КонецФункции

Процедура НаблюдатьМедленно(Наблюдение, Состояние) Экспорт
	Состояние.Вызовы.ИнкрементироватьИПолучить();
	Приостановить(Состояние.ЗадержкаМс);
	Наблюдение.Записать(1);
КонецПроцедуры

Процедура НаблюдатьМедленноМульти(Наблюдения, Состояние) Экспорт
	Состояние.Вызовы.ИнкрементироватьИПолучить();
	Приостановить(Состояние.ЗадержкаМс);
	Наблюдения.Получить("slow.gauge").Записать(1);
КонецПроцедуры

Процедура НаблюдатьБыстро(Наблюдение) Экспорт
	Наблюдение.Записать(2);
КонецПроцедуры
