&Тест
Процедура КонфликтВидовВозвращаетИнструментЗапрошенногоВида() Экспорт

    // Дано
    Ресурс = Новый ОтелРесурс();
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-library", "1.0.0");
    Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);

    // Когда
    Счетчик = Метрика.СоздатьСчетчик("shared.name", "Counter desc", "1");
    Гистограмма = Метрика.СоздатьГистограмму("shared.name", "Histogram desc", "ms");
    Гистограмма.Записать(7);

    // Тогда
    // По спеке Meter MUST вернуть работающий инструмент: вызывающий получает гистограмму,
    // счетчик остается отдельным инструментом, оба экспортируются (pass-through).
    Ожидаем.Что(Гистограмма.Вид()).Равно("Histogram");
    Ожидаем.Что(Гистограмма).Не_().Равно(Счетчик);
    Ожидаем.Что(СобратьДанные(Гистограмма, Метрика).ТочкиДанных()[0].Получить("count")).Равно(1);
    Ожидаем.Что(Метрика.Инструменты()).ИмеетДлину(2);

КонецПроцедуры

&Тест
Процедура ПовторныйКонфликтВозвращаетТотЖеВторойИнструмент() Экспорт

    // Дано - счетчик и второй счетчик с тем же именем и другой единицей
    Ресурс = Новый ОтелРесурс();
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-library", "1.0.0");
    Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
    Первый = Метрика.СоздатьСчетчик("repeat.conflict", "", "1");
    Второй = Метрика.СоздатьСчетчик("repeat.conflict", "", "ms");

    // Когда - обе регистрации повторяются
    ПовторВторого = Метрика.СоздатьСчетчик("repeat.conflict", "", "ms");
    ПовторПервого = Метрика.СоздатьСчетчик("repeat.conflict", "", "1");

    // Тогда - новые инструменты не создаются, каждая регистрация получает свой инструмент
    Ожидаем.Что(Второй).Не_().Равно(Первый);
    Ожидаем.Что(ПовторВторого).Равно(Второй);
    Ожидаем.Что(ПовторПервого).Равно(Первый);
    Ожидаем.Что(Метрика.Инструменты()).ИмеетДлину(2);

КонецПроцедуры

&Тест
Процедура КонфликтВидаСДругимРегистромИспользуетПервоеИмя() Экспорт

    // Дано - счетчик зарегистрирован с именем в смешанном регистре
    Ресурс = Новый ОтелРесурс();
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-library", "1.0.0");
    Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
    Метрика.СоздатьСчетчик("MixedCase.Metric");

    // Когда - гистограмма с тем же именем в другом регистре
    Гистограмма = Метрика.СоздатьГистограмму("mixedcase.metric");

    // Тогда - отдельная гистограмма с первым встреченным именем (spec MUST)
    Ожидаем.Что(Гистограмма.Вид()).Равно("Histogram");
    Ожидаем.Что(Гистограмма.Имя()).Равно("MixedCase.Metric");

КонецПроцедуры

&Тест
Процедура КонфликтВидаПредупреждаетОбОтдельнойМетрикеСРецептомПоВиду() Экспорт

    // Дано
    Ресурс = Новый ОтелРесурс();
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-library", "1.0.0");
    Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
    МокЛог = Мок.Получить(Тип("Лог"));
    Метрика.УстановитьЛог(МокЛог);
    Метрика.СоздатьСчетчик("kind.warning");

    // Когда
    Метрика.СоздатьГистограмму("kind.warning");

    // Тогда - предупреждение: данные экспортируются отдельной метрикой, View различает по виду
    Выражение = "повторной регистрации.*вид: было Counter, запрошено Histogram"
        + ".*отдельной метрикой.*ТипИнструмента='Histogram'";
    МокЛог.ПроверитьЧтоВызывалсяМетод().Предупреждение(Матчеры.СоответствуетВыражению(Выражение));

КонецПроцедуры

&Тест
Процедура КонфликтЕдиницПредупреждаетОбОтдельнойМетрикеСРецептомПоЕдинице() Экспорт

    // Дано
    Ресурс = Новый ОтелРесурс();
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-library", "1.0.0");
    Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
    МокЛог = Мок.Получить(Тип("Лог"));
    Метрика.УстановитьЛог(МокЛог);
    Метрика.СоздатьСчетчик("unit.warning", "", "1");

    // Когда
    Метрика.СоздатьСчетчик("unit.warning", "", "ms");

    // Тогда - предупреждение: данные экспортируются отдельной метрикой, View различает по единице
    МокЛог.ПроверитьЧтоВызывалсяМетод().Предупреждение(
        Матчеры.СоответствуетВыражению("повторной регистрации.*отдельной метрикой.*Единица='ms'"));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Вид")
&ИсточникЗначение("Единица")
Процедура КонфликтРазрешенныйViewНеПредупреждает(Различие) Экспорт

    // Дано - View переименовывает второй инструмент, метрики получают разные имена:
    //   конфликт исправлен через View, предупреждение не нужно (spec SHOULD)
    Метрика = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("test-library", "1.0.0"), Новый ОтелРесурс());
    Если Различие = "Вид" Тогда
        Селектор = Новый ОтелСелекторИнструментов("resolved.metric", "Histogram");
    Иначе
        Селектор = Новый ОтелСелекторИнструментов("resolved.metric", , , "ms");
    КонецЕсли;
    Пары = Новый Массив();
    Пара = Новый Соответствие();
    Пара.Вставить("Селектор", Селектор);
    Пара.Вставить("Представление", Новый ОтелПредставление("resolved.metric.second"));
    Пары.Добавить(Пара);
    Метрика.УстановитьПредставления(Пары);
    Метрика.СоздатьСчетчик("resolved.metric", "", "1");
    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);

    // Когда
    Если Различие = "Вид" Тогда
        Метрика.СоздатьГистограмму("resolved.metric", "", "1");
    Иначе
        Метрика.СоздатьСчетчик("resolved.metric", "", "ms");
    КонецЕсли;

    // Тогда
    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);
    Ожидаем.Что(ЕстьПредупреждениеСТекстом(Аппендер, "повторной регистрации")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура КонфликтНеРазрешенныйViewПредупреждает() Экспорт

    // Дано - View переименовывает оба инструмента в одно имя: конфликт остается
    Метрика = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("test-library", "1.0.0"), Новый ОтелРесурс());
    Пары = Новый Массив();
    Пара = Новый Соответствие();
    Пара.Вставить("Селектор", Новый ОтелСелекторИнструментов("unresolved.metric"));
    Пара.Вставить("Представление", Новый ОтелПредставление("unresolved.renamed"));
    Пары.Добавить(Пара);
    Метрика.УстановитьПредставления(Пары);
    Метрика.СоздатьСчетчик("unresolved.metric");
    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);

    // Когда
    Метрика.СоздатьГистограмму("unresolved.metric");

    // Тогда
    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);
    Ожидаем.Что(ЕстьПредупреждениеСТекстом(Аппендер, "повторной регистрации")).ЭтоИстина();

КонецПроцедуры

Функция СоздатьТестовыйАппендер()
    Текст = "Перем События Экспорт;
    |Процедура ВывестиСобытие(Событие) Экспорт
    |    События.Добавить(Событие);
    |КонецПроцедуры
    |Процедура Закрыть() Экспорт
    |КонецПроцедуры
    |Процедура УстановитьСвойство(Имя, Значение) Экспорт
    |КонецПроцедуры
    |События = Новый Массив();";
    Возврат ЗагрузитьСценарийИзСтроки(Текст);
КонецФункции

Функция ЕстьПредупреждениеСТекстом(Аппендер, Текст)
    Для Каждого Событие Из Аппендер.События Цикл
        Если Событие.ПолучитьУровень() = УровниЛога.Предупреждение
                И СтрНайти(Событие.ПолучитьСообщение(), Текст) > 0 Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

&Тест
Процедура ОбратныйВызовНесколькихИнструментов() Экспорт

    // Дано
    Ресурс = Новый ОтелРесурс();
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-library", "1.0.0");
    Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);

    Датчик1 = Метрика.СоздатьНаблюдаемыйДатчик("gauge1", Неопределено, "Первый");
    Датчик2 = Метрика.СоздатьНаблюдаемыйДатчик("gauge2", Неопределено, "Второй");

    // Регистрируем мульти-callback
    Инструменты = Новый Массив();
    Инструменты.Добавить(Датчик1);
    Инструменты.Добавить(Датчик2);

    МультиCallback = Новый Действие(ЭтотОбъект, "МультиОбратныйВызовДляТеста");
    Метрика.ЗарегистрироватьОбратныйВызов(МультиCallback, Инструменты);

    // Когда
    Метрика.ВызватьМультиОбратныеВызовы();

    // Тогда
    Данные1 = СобратьДанные(Датчик1, Метрика);
    Данные2 = СобратьДанные(Датчик2, Метрика);
    Ожидаем.Что(Данные1.ТочкиДанных()).ИмеетДлину(1);
    Ожидаем.Что(Данные2.ТочкиДанных()).ИмеетДлину(1);
    Ожидаем.Что(Данные1.ТочкиДанных()[0].Получить("value")).Равно(10);
    Ожидаем.Что(Данные2.ТочкиДанных()[0].Получить("value")).Равно(20);

КонецПроцедуры

Процедура МультиОбратныйВызовДляТеста(Наблюдения) Экспорт
    Наблюдения.Получить("gauge1").Записать(10);
    Наблюдения.Получить("gauge2").Записать(20);
КонецПроцедуры

