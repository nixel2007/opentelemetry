&Тест
Процедура КонфликтОписанияГенерируетРецептБезВида() Экспорт

	// Дано - два счетчика с одним именем и единицей, но разными описаниями
	Ресурс = Новый ОтелРесурс();
	ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0.0");
	Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
	МокЛог = Мок.Получить(Тип("Лог"));
	Метрика.УстановитьЛог(МокЛог);

	Первый = Метрика.СоздатьСчетчик("desc.conflict", "Первое описание", "1");

	// Когда - второй с тем же типом и единицей, но другим описанием
	Второй = Метрика.СоздатьСчетчик("desc.conflict", "Другое описание", "1");

	// Тогда - возвращён первый, залогировано предупреждение с рецептом через View
	Ожидаем.Что(Второй).Равно(Первый);
	МокЛог.ПроверитьЧтоВызывалсяМетод().Предупреждение(
		Матчеры.СоответствуетВыражению("повторной регистрации.*описание.*НовоеОписание"));

КонецПроцедуры

&Тест
Процедура ПроходНасквозьЭкспоненциальнойГистограммы() Экспорт

	// Дано - экспоненциальная гистограмма уже зарегистрирована с единицей "ms"
	Ресурс = Новый ОтелРесурс();
	ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0.0");
	Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);

	Г1 = Метрика.СоздатьЭкспоненциальнуюГистограмму("expo.dup", "", "ms");

	// Когда - создаём с тем же именем, но другой единицей (конфликт единиц → pass-through)
	Г2 = Метрика.СоздатьЭкспоненциальнуюГистограмму("expo.dup", "", "s");
	Г3 = Метрика.СоздатьЭкспоненциальнуюГистограмму("expo.dup", "", "s");

	// Тогда - отдельный инструмент с запрошенной единицей, повторный вызов возвращает его же
	Ожидаем.Что(Г2).Не_().Равно(Г1);
	Ожидаем.Что(Г2.ЕдиницаИзмерения()).Равно("s");
	Ожидаем.Что(Г3).Равно(Г2);
	Ожидаем.Что(Метрика.Инструменты()).ИмеетДлину(2);

КонецПроцедуры

