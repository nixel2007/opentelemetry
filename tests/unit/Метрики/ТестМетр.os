Процедура ViewНесовместимаяАгрегацияДляAsyncИгнорируется() Экспорт

    // Дано - View с ExplicitBucketHistogram на ObservableCounter (несовместимо для async)
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test", "1.0");
    Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);

    Пары = Новый Массив();
    Пара = Новый Соответствие();
    Пара.Вставить("Селектор", Новый ОтелСелекторИнструментов("async.counter"));
    Пара.Вставить("Представление", Новый ОтелПредставление(, , , , ОтелАгрегация.ГистограммаСЯвнымиГраницами()));
    Пары.Добавить(Пара);
    Метрика.УстановитьПредставления(Пары);

    Callback = Лямбда.Выражение("н -> н.Записать(10)").ВДействие();

    // Когда - создаём ObservableCounter с явно заданным View histogram
    Счетчик = Метрика.СоздатьНаблюдаемыйСчетчик("async.counter", Callback);

    // Тогда - View-агрегация проигнорирована, используется default (sum)
    Данные = СобратьДанные(Счетчик, Метрика);
    Ожидаем.Что(Данные.ТипМетрики()).Равно(ОтелТипМетрики.Сумма());

