&Тест
Процедура РезервуарЭкземпляровНеФабрика() Экспорт

	// Дано - View с объектом без метода СоздатьРезервуар (не фабрика)
	Ресурс = Новый ОтелРесурс(Истина);
	ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test", "1.0");
	Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
	МокЛог = Мок.Получить(Тип("Лог"));
	Метрика.УстановитьЛог(МокЛог);

	НеФабрика = Новый Соответствие(); // нет метода СоздатьРезервуар

	Пары = Новый Массив();
	Пара = Новый Соответствие();
	Пара.Вставить("Селектор", Новый ОтелСелекторИнструментов("counter.nonfactory.res"));
	Пара.Вставить("Представление", Новый ОтелПредставление(, , , , , , НеФабрика));
	Пары.Добавить(Пара);
	Метрика.УстановитьПредставления(Пары);

	// Когда - создаём счетчик: резервуар должен создаваться на каждую серию, поэтому
	//   экземпляр резервуара вместо фабрики отклоняется
	Счетчик = Метрика.СоздатьСчетчик("counter.nonfactory.res"); // BSLLS:UnusedLocalVariable-off

	// Тогда - ошибка конфигурации, используется резервуар по умолчанию
	МокЛог.ПроверитьЧтоВызывалсяМетод().Ошибка(
		Матчеры.Содержит("не является фабрикой"));

