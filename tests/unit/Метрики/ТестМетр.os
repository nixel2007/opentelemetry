&Тест
Процедура ПовторнаяГистограммаСАгрегациейBase2ExponentialБезПредупреждения() Экспорт

	// Дано - base2_exponential_bucket_histogram по умолчанию: гистограмма регистрируется
	// как экспоненциальная, повторный вызов с теми же параметрами - не конфликт
	Метрика = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("test-lib", "1.0.0"), Новый ОтелРесурс());
	Метрика.УстановитьАгрегациюГистограммПоУмолчанию("base2_exponential_bucket_histogram");
	Первая = Метрика.СоздатьГистограмму("exp.repeat");
	Аппендер = СоздатьТестовыйАппендер();
	Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics");
	Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);

	// Когда
	Попытка
		Повторная = Метрика.СоздатьГистограмму("exp.repeat");
	Исключение
		Лог.УдалитьСпособВывода(Аппендер);
		ВызватьИсключение;
	КонецПопытки;
	Лог.УдалитьСпособВывода(Аппендер);

	// Тогда - тот же инструмент и никаких предупреждений о повторной регистрации
	Ожидаем.Что(Повторная, "повторный вызов").Равно(Первая);
	Ожидаем.Что(ЕстьПредупреждениеСТекстом(Аппендер, "повторной регистрации"), "предупреждение").ЭтоЛожь();
	Ожидаем.Что(Метрика.Инструменты().Количество(), "инструментов").Равно(1);

КонецПроцедуры

