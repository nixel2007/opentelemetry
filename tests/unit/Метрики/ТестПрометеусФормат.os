// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
#Использовать "../../.."
#Использовать asserts
#Использовать prometheus

// Форматы выдачи Prometheus-экспортера: text 0.0.4/1.0.0 и OpenMetrics 1.0.0, схемы экранирования
// имен и согласование формата по заголовку Accept

// Text format 0.0.4 совпадает с выдачей библиотеки prometheus

&ПараметризованныйТест
&ИсточникЗначение("счетчик")
&ИсточникЗначение("датчик, лейблы пусты")
&ИсточникЗначение("гистограмма")
&ИсточникЗначение("экранирование")
Процедура ТекстСовпадаетСБиблиотекой(Случай) Экспорт

    // Дано
    Семейства = СемействаСлучая(Случай);

    // Когда
    Текст = ОтелПрометеусФормат.ТекстВыдачи(Семейства, ОтелПрометеусФормат.ФорматПоУмолчанию());

    // Тогда
    Ожидаем.Что(Текст).Равно(Prometheus.СериализоватьВТекст(Семейства));

КонецПроцедуры

&Тест
Процедура ПустаяВыдачаТекста() Экспорт

    // Когда
    Текст = ОтелПрометеусФормат.ТекстВыдачи(Новый Массив(), ОтелПрометеусФормат.ФорматПоУмолчанию());

    // Тогда
    Ожидаем.Что(Текст).Равно("");

КонецПроцедуры

// OpenMetrics 1.0.0: # UNIT для семейства, имя которого оканчивается на единицу, экранирование
// кавычек в HELP и # EOF в конце выдачи

&Тест
Процедура ВыдачаOpenMetrics() Экспорт

    // Дано
    Сэмплы = Новый Массив();
    Сэмплы.Добавить(Сэмпл("http_duration_seconds_count", 3, "route", "/a"));
    Семейства = Новый Массив();
    Семейства.Добавить(Семейство("http_duration_seconds", "histogram", "Длительность ""запроса""", Сэмплы, "seconds"));
    Сэмплы = Новый Массив();
    Сэмплы.Добавить(Сэмпл("jobs_total", 5));
    Семейства.Добавить(Семейство("jobs", "counter", "", Сэмплы, "seconds"));

    // Когда
    Текст = ОтелПрометеусФормат.ТекстВыдачи(Семейства, ФорматOpenMetrics("underscores"));

    // Тогда - единица jobs не совпадает с окончанием имени, # UNIT для нее не выводится
    Ожидаем.Что(Текст).Равно(
        "# HELP http_duration_seconds Длительность \""запроса\""" + Символы.ПС
        + "# TYPE http_duration_seconds histogram" + Символы.ПС
        + "# UNIT http_duration_seconds seconds" + Символы.ПС
        + "http_duration_seconds_count{route=""/a""} 3" + Символы.ПС
        + "# TYPE jobs counter" + Символы.ПС
        + "jobs_total 5" + Символы.ПС
        + "# EOF" + Символы.ПС);

КонецПроцедуры

&Тест
Процедура ПустаяВыдачаOpenMetrics() Экспорт

    // Когда
    Текст = ОтелПрометеусФормат.ТекстВыдачи(Новый Массив(), ФорматOpenMetrics("underscores"));

    // Тогда
    Ожидаем.Что(Текст).Равно("# EOF" + Символы.ПС);

КонецПроцедуры

// Экранирование allow-utf-8: имена, недопустимые в классическом формате, выводятся в кавычках

&Тест
Процедура ИменаUtf8ВКавычках() Экспорт

    // Дано
    Сэмплы = Новый Массив();
    Сэмплы.Добавить(Сэмпл("foo.bar_total", 1, "a.b", "v"));
    Сэмплы.Добавить(Сэмпл("foo.bar_total", 2, "ok", "w"));
    Семейства = Новый Массив();
    Семейства.Добавить(Семейство("foo.bar_total", "counter", "Счетчик", Сэмплы));
    Формат = ОтелПрометеусФормат.ВыбратьФормат("text/plain;version=1.0.0;escaping=allow-utf-8");

    // Когда
    Текст = ОтелПрометеусФормат.ТекстВыдачи(Семейства, Формат);

    // Тогда
    Ожидаем.Что(Текст).Равно(
        "# HELP ""foo.bar_total"" Счетчик" + Символы.ПС
        + "# TYPE ""foo.bar_total"" counter" + Символы.ПС
        + "{""foo.bar_total"",""a.b""=""v""} 1" + Символы.ПС
        + "{""foo.bar_total"",ok=""w""} 2" + Символы.ПС);

КонецПроцедуры

// Схемы экранирования имен Prometheus: underscores, dots, values, allow-utf-8

&ПараметризованныйТест
&ИсточникЗначение("метрика|foo.bar|underscores|foo_bar")
&ИсточникЗначение("метрика|foo_bar|underscores|foo_bar")
&ИсточникЗначение("метрика|a:b|underscores|a:b")
&ИсточникЗначение("метрика|1abc|underscores|_abc")
&ИсточникЗначение("метрика|foo.bar_total|dots|foo_dot_bar__total")
&ИсточникЗначение("метрика|foo.bar|values|U__foo_2e_bar")
&ИсточникЗначение("метрика|foo_bar|values|foo_bar")
&ИсточникЗначение("метрика|foo.bar|allow-utf-8|foo.bar")
&ИсточникЗначение("лейбл|a:b|underscores|a_b")
&ИсточникЗначение("лейбл|a.b|dots|a_dot_b")
&ИсточникЗначение("лейбл|a_b|dots|a__b")
&ИсточникЗначение("лейбл|a:b|values|U__a_3a_b")
Процедура ЭкранированиеИмен(Случай) Экспорт

    // Дано - вид имени|имя|схема|ожидаемое имя
    Части = СтрРазделить(Случай, "|");

    // Когда
    Если Части[0] = "метрика" Тогда
        Имя = ОтелПрометеусФормат.ЭкранироватьИмяМетрики(Части[1], Части[2]);
    Иначе
        Имя = ОтелПрометеусФормат.ЭкранироватьИмяЛейбла(Части[1], Части[2]);
    КонецЕсли;

    // Тогда
    Ожидаем.Что(Имя).Равно(Части[3]);

КонецПроцедуры

// Prometheus Exporter / Content Negotiation: формат выдачи согласуется по заголовку Accept; без
// Accept - text 0.0.4 с экранированием underscores

// BSLLS:LineLength-off
&ПараметризованныйТест
&ИсточникЗначение("|text/plain; version=0.0.4; charset=utf-8")
&ИсточникЗначение("*/*|text/plain; version=0.0.4; charset=utf-8")
&ИсточникЗначение("text/plain;version=0.0.4|text/plain; version=0.0.4; charset=utf-8")
&ИсточникЗначение("text/plain;version=0.0.4;escaping=allow-utf-8|text/plain; version=0.0.4; charset=utf-8")
&ИсточникЗначение("text/plain;version=0.0.4;escaping=dots|text/plain; version=0.0.4; charset=utf-8; escaping=dots")
&ИсточникЗначение("text/plain;version=1.0.0;escaping=allow-utf-8|text/plain; version=1.0.0; charset=utf-8; escaping=allow-utf-8")
&ИсточникЗначение("text/plain;version=1.0.0|text/plain; version=1.0.0; charset=utf-8; escaping=underscores")
&ИсточникЗначение("application/openmetrics-text;version=0.0.1;q=0.5,text/plain;version=0.0.4;q=0.3|application/openmetrics-text; version=0.0.1; charset=utf-8")
&ИсточникЗначение("application/openmetrics-text;version=1.0.0;escaping=allow-utf-8;q=0.6,application/openmetrics-text;version=0.0.1;q=0.5,text/plain;version=1.0.0;escaping=allow-utf-8;q=0.4,text/plain;version=0.0.4;q=0.3,*/*;q=0.2|application/openmetrics-text; version=1.0.0; charset=utf-8; escaping=allow-utf-8")
&ИсточникЗначение("text/plain;version=0.0.4;q=0.9,application/openmetrics-text;version=1.0.0;q=0.5|text/plain; version=0.0.4; charset=utf-8")
&ИсточникЗначение("application/openmetrics-text;version=1.0.0;q=0,text/plain|text/plain; version=0.0.4; charset=utf-8")
&ИсточникЗначение("application/vnd.google.protobuf;proto=io.prometheus.client.MetricFamily;encoding=delimited|text/plain; version=0.0.4; charset=utf-8")
&ИсточникЗначение("text/plain;version=2.0.0,application/openmetrics-text|application/openmetrics-text; version=0.0.1; charset=utf-8")
Процедура СогласованиеФормата(Случай) Экспорт
// BSLLS:LineLength-on

    // Дано - заголовок Accept|ожидаемый Content-Type ответа
    Разделитель = СтрНайти(Случай, "|", НаправлениеПоиска.СКонца);
    Accept = Лев(Случай, Разделитель - 1);
    ОжидаемыйТип = Сред(Случай, Разделитель + 1);

    // Когда
    Формат = ОтелПрометеусФормат.ВыбратьФормат(Accept);

    // Тогда
    Ожидаем.Что(Формат.ТипКонтента).Равно(ОжидаемыйТип);

КонецПроцедуры

Функция СемействаСлучая(Случай)
    Семейства = Новый Массив();
    Сэмплы = Новый Массив();
    Если Случай = "счетчик" Тогда
        Сэмплы.Добавить(Сэмпл("jobs_total", 5, "queue", "fast"));
        Сэмплы.Добавить(Сэмпл("jobs_total", 2.5, "queue", "slow"));
        Семейства.Добавить(Семейство("jobs_total", "counter", "Задания", Сэмплы));
    ИначеЕсли Случай = "датчик, лейблы пусты" Тогда
        Сэмплы.Добавить(Сэмпл("temperature", 21.5));
        Семейства.Добавить(Семейство("temperature", "gauge", "", Сэмплы));
        Семейства.Добавить(Семейство("alpha", "gauge", "Первое по алфавиту", МассивСэмплов(Сэмпл("alpha", 1))));
    ИначеЕсли Случай = "гистограмма" Тогда
        Для Каждого Маршрут Из СтрРазделить("/b,/a", ",") Цикл
            Сэмплы.Добавить(СэмплБакета("latency_bucket", 1, Маршрут, "+Inf"));
            Сэмплы.Добавить(СэмплБакета("latency_bucket", 1, Маршрут, 0.5));
            Сэмплы.Добавить(СэмплБакета("latency_bucket", 0, Маршрут, 0.1));
            Сэмплы.Добавить(Сэмпл("latency_sum", 0.3, "route", Маршрут));
            Сэмплы.Добавить(Сэмпл("latency_count", 1, "route", Маршрут));
        КонецЦикла;
        Семейства.Добавить(Семейство("latency", "histogram", "Задержка", Сэмплы));
    Иначе
        Сэмплы.Добавить(Сэмпл("escaped", 1, "path", "C:\dir ""x""" + Символы.ПС + "y"));
        Семейства.Добавить(Семейство("escaped", "gauge", "Справка \ с" + Символы.ПС + "переводом", Сэмплы));
    КонецЕсли;
    Возврат Семейства;
КонецФункции

Функция Семейство(Имя, Тип, Справка, Сэмплы, Единица = "")
    Семейство = Новый Соответствие();
    Семейство.Вставить("Имя", Имя);
    Семейство.Вставить("Тип", Тип);
    Семейство.Вставить("Справка", Справка);
    Семейство.Вставить("Сэмплы", Сэмплы);
    Если Единица <> "" Тогда
        Семейство.Вставить("Единица", Единица);
    КонецЕсли;
    Возврат Семейство;
КонецФункции

Функция Сэмпл(ИмяСэмпла, Значение, ИмяЛейбла = "", ЗначениеЛейбла = "")
    Лейблы = Новый Соответствие();
    Если ИмяЛейбла <> "" Тогда
        Лейблы.Вставить(ИмяЛейбла, ЗначениеЛейбла);
    КонецЕсли;
    Сэмпл = Новый Соответствие();
    Сэмпл.Вставить("ИмяСэмпла", ИмяСэмпла);
    Сэмпл.Вставить("Значение", Значение);
    Сэмпл.Вставить("Лейблы", Лейблы);
    Возврат Сэмпл;
КонецФункции

Функция СэмплБакета(ИмяСэмпла, Значение, Маршрут, Граница)
    Сэмпл = Сэмпл(ИмяСэмпла, Значение, "route", Маршрут);
    Сэмпл.Получить("Лейблы").Вставить("le", Граница);
    Возврат Сэмпл;
КонецФункции

Функция МассивСэмплов(Сэмпл)
    Сэмплы = Новый Массив();
    Сэмплы.Добавить(Сэмпл);
    Возврат Сэмплы;
КонецФункции

Функция ФорматOpenMetrics(Экранирование)
    Возврат ОтелПрометеусФормат.ВыбратьФормат("application/openmetrics-text;version=1.0.0;escaping=" + Экранирование);
КонецФункции
