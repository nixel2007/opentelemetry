// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
// BSLLS:UsingHardcodeNetworkAddress-off
#Использовать "../../.."
#Использовать asserts

// Выдача Prometheus-читателя в согласованном формате: OpenMetrics 1.0.0 (# UNIT, _created, info,
// exemplars), схемы экранирования имен после стратегии трансляции, подсказки типа датчика

&Тест
Процедура ВыдачаOpenMetricsПоЗапросу() Экспорт

    // Дано
    Читатель = ЧитательСМетриками();

    // Когда
    ТипКонтента = "";
    Тело = Читатель.СобратьДляЗапроса("application/openmetrics-text;version=1.0.0", ТипКонтента);

    // Тогда - у семейства счетчика нет суффикса _total, у гистограммы с единицей есть # UNIT,
    //   ресурс - info-метрика target
    ПС = Символы.ПС;
    Лейблы = ЛейблыОбласти();
    Ожидаем.Что(ТипКонтента).Равно("application/openmetrics-text; version=1.0.0; charset=utf-8; escaping=underscores");
    Ожидаем.Что(Тело).Содержит("# HELP jobs Задания" + ПС + "# TYPE jobs counter" + ПС
        + "jobs_total{" + Лейблы + "} 2" + ПС + "jobs_created{" + Лейблы + "} ");
    Ожидаем.Что(Тело).Содержит("# TYPE http_duration_seconds histogram" + ПС
        + "# UNIT http_duration_seconds seconds" + ПС);
    Ожидаем.Что(Тело).Содержит("http_duration_seconds_count{" + Лейблы + "} 1" + ПС
        + "http_duration_seconds_created{" + Лейблы + "} ");
    Ожидаем.Что(Тело).Содержит("# TYPE target info" + ПС + "target_info{service_name=""checkout""} 1" + ПС);
    Ожидаем.Что(СтрЗаканчиваетсяНа(Тело, ПС + "# EOF" + ПС)).ЭтоИстина();

КонецПроцедуры

// Prometheus Compatibility / Sums, Histograms: StartTimeUnixNano SHOULD выводиться как StartTime
// формата - в OpenMetrics это сэмпл _created

&ПараметризованныйТест
&ИсточникЗначение("jobs_created{")
&ИсточникЗначение("http_duration_seconds_created{")
Процедура ВремяСозданияИзВремениСтарта(Префикс) Экспорт

    // Дано
    Начало = Число(ОтелУтилиты.ТекущееВремяВНаносекундах()) / 1000000000;
    Читатель = ЧитательСМетриками();

    // Когда
    Тело = Читатель.СобратьДляЗапроса("application/openmetrics-text;version=1.0.0");
    Конец = Число(ОтелУтилиты.ТекущееВремяВНаносекундах()) / 1000000000;

    // Тогда - время старта потока в секундах, между созданием метрики и сбором
    Создание = ЗначениеСэмпла(Тело, Префикс);
    Ожидаем.Что(Создание).БольшеИлиРавно(Начало - 1);
    Ожидаем.Что(Создание).МеньшеИлиРавно(Конец);

КонецПроцедуры

&Тест
Процедура ТекстовыйФорматБезСозданияИЕдиницы() Экспорт

    // Дано
    Читатель = ЧитательСМетриками();

    // Когда
    Тело = Читатель.СобратьДляЗапроса("text/plain;version=0.0.4");

    // Тогда
    Ожидаем.Что(СтрНайти(Тело, "_created")).Равно(0);
    Ожидаем.Что(СтрНайти(Тело, "# UNIT")).Равно(0);
    Ожидаем.Что(СтрНайти(Тело, "# EOF")).Равно(0);
    Ожидаем.Что(Тело).Содержит("# TYPE jobs_total counter");
    Ожидаем.Что(Тело).Содержит("# TYPE target_info gauge");

КонецПроцедуры

// Prometheus Exporter / Interaction with Translation Strategy: сначала применяется стратегия
// трансляции, затем экранирование из согласованного формата (таблица спецификации для счетчика
// foo.bar с единицей By)

&ПараметризованныйТест
&ИсточникЗначение("UnderscoreEscapingWithSuffixes|underscores|foo_bar_bytes_total{")
&ИсточникЗначение("UnderscoreEscapingWithSuffixes|allow-utf-8|foo_bar_bytes_total{")
&ИсточникЗначение("UnderscoreEscapingWithoutSuffixes|underscores|foo_bar{")
&ИсточникЗначение("UnderscoreEscapingWithoutSuffixes|allow-utf-8|foo_bar{")
&ИсточникЗначение("NoUTF8EscapingWithSuffixes|underscores|foo_bar_bytes_total{")
&ИсточникЗначение("NoUTF8EscapingWithSuffixes|allow-utf-8|{""foo.bar_bytes_total"",")
&ИсточникЗначение("NoTranslation|underscores|foo_bar{")
&ИсточникЗначение("NoTranslation|allow-utf-8|{""foo.bar"",")
Процедура СтратегияТрансляцииИЭкранирование(Случай) Экспорт

    // Дано - стратегия|экранирование|начало сэмпла
    Части = СтрРазделить(Случай, "|");
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("fmt-lib", "1.0"), Новый ОтелРесурс(Истина));
    Метр.СоздатьСчетчик("foo.bar", "", "By").Добавить(1);
    Читатель = Новый ОтелПрометеусЧитательМетрик(Части[0]);
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Тело = Читатель.СобратьДляЗапроса("text/plain;version=1.0.0;escaping=" + Части[1]);

    // Тогда
    Ожидаем.Что(Тело).Содержит(Символы.ПС + Части[2]);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("NoTranslation|allow-utf-8|""http.method""=""GET""")
&ИсточникЗначение("NoTranslation|underscores|http_method=""GET""")
&ИсточникЗначение("NoUTF8EscapingWithSuffixes|allow-utf-8|""http.method""=""GET""")
&ИсточникЗначение("UnderscoreEscapingWithSuffixes|allow-utf-8|http_method=""GET""")
Процедура ИмяЛейблаПоСтратегииИЭкранированию(Случай) Экспорт

    // Дано - стратегия|экранирование|лейбл
    Части = СтрРазделить(Случай, "|");
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("fmt-lib", "1.0"), Новый ОтелРесурс(Истина));
    Атрибуты = Новый ОтелАтрибуты();
    Атрибуты.Установить("http.method", "GET");
    Метр.СоздатьСчетчик("requests").Добавить(1, Атрибуты);
    Читатель = Новый ОтелПрометеусЧитательМетрик(Части[0]);
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Тело = Читатель.СобратьДляЗапроса("text/plain;version=1.0.0;escaping=" + Части[1]);

    // Тогда
    Ожидаем.Что(Тело).Содержит(Части[2]);

КонецПроцедуры

&Тест
Процедура ЭкранированиеDotsМеняетИменаМетрикИЛейблы() Экспорт

    // Дано
    Читатель = ЧитательСМетриками();

    // Когда
    ТипКонтента = "";
    Тело = Читатель.СобратьДляЗапроса("application/openmetrics-text;version=1.0.0;escaping=dots", ТипКонтента);

    // Тогда - "_" экранируется как "__", "." как "_dot_"
    Ожидаем.Что(ТипКонтента).Равно("application/openmetrics-text; version=1.0.0; charset=utf-8; escaping=dots");
    Ожидаем.Что(Тело).Содержит("jobs__total{otel__scope__name=""fmt-lib"",otel__scope__version=""1.0""} 2");
    Ожидаем.Что(Тело).Содержит("target__info{service__name=""checkout""} 1");

КонецПроцедуры

// Prometheus Compatibility / Gauges: датчик выводится по подсказке prometheus.type из metadata
// метрики; info - в text format gauge с суффиксом _info

&ПараметризованныйТест
&ИсточникЗначение("|application/openmetrics-text;version=1.0.0|# TYPE build gauge|build 1")
&ИсточникЗначение("gauge|application/openmetrics-text;version=1.0.0|# TYPE build gauge|build 1")
&ИсточникЗначение("unknown|application/openmetrics-text;version=1.0.0|# TYPE build unknown|build 1")
&ИсточникЗначение("unkown|application/openmetrics-text;version=1.0.0|# TYPE build unknown|build 1")
&ИсточникЗначение("unknown|text/plain;version=0.0.4|# TYPE build untyped|build 1")
&ИсточникЗначение("info|application/openmetrics-text;version=1.0.0|# TYPE build info|build_info 1")
&ИсточникЗначение("info|text/plain;version=0.0.4|# TYPE build_info gauge|build_info 1")
&ИсточникЗначение("stateset|application/openmetrics-text;version=1.0.0|# TYPE build stateset|build 1")
&ИсточникЗначение("stateset|text/plain;version=0.0.4|# TYPE build gauge|build 1")
Процедура ПодсказкаТипаДатчика(Случай) Экспорт

    // Дано - подсказка prometheus.type|Accept|строка TYPE|сэмпл (у точки нет лейблов)
    Части = СтрРазделить(Случай, "|");
    Метаданные = Новый Соответствие();
    Если Части[0] <> "" Тогда
        Метаданные.Вставить("prometheus.type", Части[0]);
    КонецЕсли;
    Данные = ДанныеДатчика("build", Метаданные);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(МетрСДанными(Данные));

    // Когда
    Тело = Читатель.СобратьДляЗапроса(Части[1]);

    // Тогда
    Ожидаем.Что(Тело).Содержит(Части[2] + Символы.ПС);
    Ожидаем.Что(Тело).Содержит(Символы.ПС + Части[3]);

КонецПроцедуры

// Prometheus Compatibility / Exemplar Conversion: в OpenMetrics exemplar выводится с лейблами
// trace_id, span_id и отфильтрованных атрибутов и временем; у гистограммы - последний exemplar,
// попавший в бакет

&Тест
Процедура ЭкземплярСчетчикаВOpenMetrics() Экспорт

    // Дано
    Экземпляры = Новый Массив();
    Экземпляры.Добавить(Экземпляр(3, "1700000000500000000", "user", "alice"));
    Данные = ДанныеСчетчика("requests", 5, Экземпляры);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(МетрСДанными(Данные));

    // Когда
    ОткрытыеМетрики = Читатель.СобратьДляЗапроса("application/openmetrics-text;version=1.0.0");
    Текст = Читатель.СобратьДляЗапроса("text/plain;version=0.0.4");

    // Тогда - в text format exemplars не поддерживаются и отбрасываются
    Ожидаем.Что(ОткрытыеМетрики).Содержит("requests_total 5 # {span_id=""b7ad6b7169203331"","
        + "trace_id=""0af7651916cd43dd8448eb211c80319c"",user=""alice""} 3 1700000000.5" + Символы.ПС);
    Ожидаем.Что(Текст).Содержит("requests_total 5" + Символы.ПС);
    Ожидаем.Что(СтрНайти(Текст, "trace_id")).Равно(0);

КонецПроцедуры

&Тест
Процедура ЭкземплярыБакетовГистограммы() Экспорт

    // Дано - exemplars 0.5 и 0.7 попадают в бакет le=1 (0.7 позже), 3 - в бакет le=5
    Экземпляры = Новый Массив();
    Экземпляры.Добавить(Экземпляр(0.5, "1700000001000000000"));
    Экземпляры.Добавить(Экземпляр(3, "1700000002000000000"));
    Экземпляры.Добавить(Экземпляр(0.7, "1700000003000000000"));
    Данные = ДанныеГистограммы("latency", Экземпляры);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(МетрСДанными(Данные));

    // Когда
    Тело = Читатель.СобратьДляЗапроса("application/openmetrics-text;version=1.0.0");

    // Тогда
    Ожидаем.Что(Тело).Содержит("latency_bucket{le=""1""} 1 # {span_id=""b7ad6b7169203331"","
        + "trace_id=""0af7651916cd43dd8448eb211c80319c""} 0.7 1700000003" + Символы.ПС);
    Ожидаем.Что(Тело).Содержит("latency_bucket{le=""5""} 2 # {span_id=""b7ad6b7169203331"","
        + "trace_id=""0af7651916cd43dd8448eb211c80319c""} 3 1700000002" + Символы.ПС);
    Ожидаем.Что(Тело).Содержит("latency_bucket{le=""+Inf""} 2" + Символы.ПС);

КонецПроцедуры

&Тест
Процедура ДлинныеАтрибутыЭкземпляраОтбрасываются() Экспорт

    // Дано - лейблы exemplar в OpenMetrics 1.0 ограничены 128 символами
    Экземпляры = Новый Массив();
    Экземпляры.Добавить(Экземпляр(3, "1700000000000000000", "payload", СтрокаДлины(200)));
    Данные = ДанныеСчетчика("requests", 5, Экземпляры);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(МетрСДанными(Данные));

    // Когда
    Тело = Читатель.СобратьДляЗапроса("application/openmetrics-text;version=1.0.0");

    // Тогда - trace_id и span_id сохраняются, отфильтрованные атрибуты отброшены
    Ожидаем.Что(Тело).Содержит("requests_total 5 # {span_id=""b7ad6b7169203331"","
        + "trace_id=""0af7651916cd43dd8448eb211c80319c""} 3 1700000000" + Символы.ПС);

КонецПроцедуры

// Prometheus Compatibility / Gauges: exemplars датчика SHOULD отбрасываться

&Тест
Процедура ЭкземплярыДатчикаОтбрасываются() Экспорт

    // Дано
    Экземпляры = Новый Массив();
    Экземпляры.Добавить(Экземпляр(3, "1700000000000000000"));
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(МетрСДанными(ДанныеДатчика("queue", Новый Соответствие(), 4, Экземпляры)));

    // Когда
    Тело = Читатель.СобратьДляЗапроса("application/openmetrics-text;version=1.0.0");

    // Тогда
    Ожидаем.Что(Тело).Содержит("queue 4" + Символы.ПС);
    Ожидаем.Что(СтрНайти(Тело, "trace_id")).Равно(0);

КонецПроцедуры

// OpenMetrics: значение info-метрики всегда 1, суффикс _info у сэмпла не повторяется

&ПараметризованныйТест
&ИсточникЗначение("application/openmetrics-text;version=1.0.0|# TYPE build info")
&ИсточникЗначение("text/plain;version=0.0.4|# TYPE build_info gauge")
Процедура InfoМетрикаСоСуффиксомВИмени(Случай) Экспорт

    // Дано - Accept|строка TYPE; имя датчика уже оканчивается на _info, значение не 1
    Части = СтрРазделить(Случай, "|");
    Метаданные = Новый Соответствие();
    Метаданные.Вставить("prometheus.type", "info");
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(МетрСДанными(ДанныеДатчика("build_info", Метаданные, 7)));

    // Когда
    Тело = Читатель.СобратьДляЗапроса(Части[0]);

    // Тогда
    Ожидаем.Что(Тело).Содержит(Части[1] + Символы.ПС + "build_info 1" + Символы.ПС);
    Ожидаем.Что(СтрНайти(Тело, "_info_info")).Равно(0);

КонецПроцедуры

&Тест
Процедура ДатчикИInfoМетрикаСОднимИменемНеСмешиваются() Экспорт

    // Дано - датчик build и info-метрика build: в text format info-метрика - семейство build_info
    //   с тем же базовым именем build
    Метаданные = Новый Соответствие();
    Метаданные.Вставить("prometheus.type", "info");
    Метр = МетрСДанными(ДанныеДатчика("build", Новый Соответствие()));
    Метр.Данные.Добавить(ДанныеДатчика("build", Метаданные));
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);
    Аппендер = ПодключитьАппендер();

    // Когда
    Тело = Читатель.СобратьДляЗапроса("text/plain;version=0.0.4");

    // Тогда - сэмплы info-метрики не попадают в семейство датчика, конфликт в логе
    ОтключитьАппендер(Аппендер);
    Ожидаем.Что(Тело).Содержит("# TYPE build gauge" + Символы.ПС + "build 1" + Символы.ПС);
    Ожидаем.Что(СтрНайти(Тело, "build_info")).Равно(0);
    Ожидаем.Что(ЕстьПредупреждениеСТекстом(Аппендер, "Конфликт TYPE для 'build'")).ЭтоИстина();

КонецПроцедуры

// Prometheus Compatibility / Metric Metadata: у семейства одна строка UNIT, отличающаяся единица
// одноименной метрики отбрасывается с предупреждением

&Тест
Процедура ОтличающаясяЕдиницаСемействаПредупреждает() Экспорт

    // Дано - без суффиксов единиц имя latency_seconds общее для метрик в секундах и миллисекундах
    Ресурс = Новый ОтелРесурс(Истина);
    Первый = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("first-lib", "1.0"), Ресурс);
    Первый.СоздатьДатчик("latency_seconds", "", "s").Записать(1);
    Второй = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("second-lib", "1.0"), Ресурс);
    Второй.СоздатьДатчик("latency_seconds", "", "ms").Записать(1000);
    Читатель = Новый ОтелПрометеусЧитательМетрик("UnderscoreEscapingWithoutSuffixes");
    Читатель.ДобавитьМетр(Первый);
    Читатель.ДобавитьМетр(Второй);
    Аппендер = ПодключитьАппендер();

    // Когда
    Тело = Читатель.СобратьДляЗапроса("application/openmetrics-text;version=1.0.0");

    // Тогда - точки обеих метрик в выдаче, UNIT первой
    ОтключитьАппендер(Аппендер);
    Ожидаем.Что(Тело).Содержит("# UNIT latency_seconds seconds" + Символы.ПС);
    Ожидаем.Что(Тело).Содержит("otel_scope_name=""second-lib""");
    Ожидаем.Что(ЕстьПредупреждениеСТекстом(Аппендер, "UNIT семейства 'latency_seconds' не изменен")).ЭтоИстина();

КонецПроцедуры

// OpenMetrics: без переданных границ бакетов гистограмма выводится одним бакетом +Inf

&Тест
Процедура ГистограммаБезГраницБакетов() Экспорт

    // Дано
    Счетчики = Новый Массив();
    Счетчики.Добавить(2);
    Точка = Новый Соответствие();
    Точка.Вставить("attributes", Новый Массив());
    Точка.Вставить("bucketCounts", Счетчики);
    Точка.Вставить("sum", 3);
    Точка.Вставить("count", 2);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(МетрСДанными(НовыеДанные("latency", ОтелТипМетрики.Гистограмма(), Точка, Ложь)));

    // Когда
    Тело = Читатель.СобратьДляЗапроса("application/openmetrics-text;version=1.0.0");

    // Тогда
    Ожидаем.Что(Тело).Содержит("latency_bucket{le=""+Inf""} 2" + Символы.ПС + "latency_sum 3" + Символы.ПС
        + "latency_count 2" + Символы.ПС);

КонецПроцедуры

// Prometheus Compatibility / Summaries: Summary выводится Prometheus summary - квантили с лейблом
// quantile по возрастанию, _sum и _count; exemplars отбрасываются

&ПараметризованныйТест
&ИсточникЗначение("text/plain;version=0.0.4")
&ИсточникЗначение("application/openmetrics-text;version=1.0.0")
Процедура СводкаВыводитсяКвантилямиСуммойИКоличеством(Accept) Экспорт

    // Дано - квантили в точке не упорядочены, у точки есть exemplar
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(МетрСДанными(ДанныеСводки("rpc.duration", "s")));

    // Когда
    Тело = Читатель.СобратьДляЗапроса(Accept);

    // Тогда
    ПС = Символы.ПС;
    Ожидаем.Что(Тело).Содержит("# TYPE rpc_duration_seconds summary" + ПС);
    Ожидаем.Что(Тело).Содержит("rpc_duration_seconds{quantile=""0""} 0.1" + ПС
        + "rpc_duration_seconds{quantile=""0.5""} 0.2" + ПС
        + "rpc_duration_seconds{quantile=""0.99""} 0.9" + ПС
        + "rpc_duration_seconds_sum 5.5" + ПС
        + "rpc_duration_seconds_count 12" + ПС);
    Ожидаем.Что(СтрНайти(Тело, "trace_id")).Равно(0);

КонецПроцедуры

&Тест
Процедура СводкаВOpenMetricsСЕдиницейИВременемСоздания() Экспорт

    // Дано
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(МетрСДанными(ДанныеСводки("rpc.duration", "s")));

    // Когда
    Тело = Читатель.СобратьДляЗапроса("application/openmetrics-text;version=1.0.0");

    // Тогда - время старта точки выводится сэмплом _created
    Ожидаем.Что(Тело).Содержит("# UNIT rpc_duration_seconds seconds" + Символы.ПС);
    Ожидаем.Что(Тело).Содержит("rpc_duration_seconds_count 12" + Символы.ПС
        + "rpc_duration_seconds_created 1700000000" + Символы.ПС);

КонецПроцедуры

// Metrics SDK / MetricProducer: метрики продюсера (например, Summary из моста к другой библиотеке)
// выдаются вместе с метриками метров

&Тест
Процедура ДанныеПродюсераВыдаютсяВместеСМетриками() Экспорт

    // Дано
    Читатель = ЧитательСМетриками();
    Продюсер = ПродюсерСДанными(ДанныеСводки("rpc.duration", "s"));
    Читатель.ДобавитьПродюсер(Продюсер);

    // Когда
    РезультатСбора = Неопределено;
    Тело = Читатель.СобратьВТексте(РезультатСбора);

    // Тогда - продюсер получил фильтр с кумулятивной временной агрегацией
    Ожидаем.Что(Тело).Содержит("rpc_duration_seconds_count 12" + Символы.ПС);
    Ожидаем.Что(Тело).Содержит("jobs_total{");
    Ожидаем.Что(РезультатСбора.Успешно()).ЭтоИстина();
    Ожидаем.Что(Продюсер.Фильтр.ПредпочтительнаяТемпоральность()).Равно(ОтелВременнаяАгрегация.Кумулятивная());

КонецПроцедуры

&Тест
Процедура ПродюсерПолучаетФильтрЧитателяСКумулятивнойАгрегацией() Экспорт

    // Дано - фильтр читателя без предпочтения временной агрегации отбрасывает сводки
    Фильтр = Новый ОтелФильтрМетрик(Новый Действие(ЭтотОбъект, "ОтброситьСводку"));
    Читатель = ЧитательСМетриками();
    Читатель.УстановитьФильтрМетрик(Фильтр);
    Продюсер = ПродюсерСДанными(ДанныеСводки("rpc.duration", "s"));
    Читатель.ДобавитьПродюсер(Продюсер);

    // Когда
    Тело = Читатель.СобратьВТексте();

    // Тогда - продюсер получил обертку над фильтром читателя, сам фильтр не изменен
    РешениеФильтра = Продюсер.Фильтр.ТестМетрики(Область(), "rpc.duration", ОтелТипМетрики.Сводка(), "s");
    Ожидаем.Что(РешениеФильтра).Равно(ОтелРезультатФильтраМетрик.Отбросить());
    Ожидаем.Что(Продюсер.Фильтр.ПредпочтительнаяТемпоральность()).Равно(ОтелВременнаяАгрегация.Кумулятивная());
    Ожидаем.Что(Фильтр.ПредпочтительнаяТемпоральность()).Равно(Неопределено);
    Ожидаем.Что(СтрНайти(Тело, "rpc_duration")).Равно(0);
    Ожидаем.Что(Тело).Содержит("jobs_total{");

КонецПроцедуры

Функция ОтброситьСводку(ОбластьИнструментирования, Имя, Вид, ЕдиницаИзмерения) Экспорт // BSLLS:UnusedParameters-off
    Если Вид = ОтелТипМетрики.Сводка() Тогда
        Возврат ОтелРезультатФильтраМетрик.Отбросить();
    КонецЕсли;
    Возврат ОтелРезультатФильтраМетрик.Принять();
КонецФункции

&ПараметризованныйТест
&ИсточникЗначение("исключение")
&ИсточникЗначение("статус")
Процедура СбойПродюсераНеЛишаетВыдачуМетрик(Сбой) Экспорт

    // Дано - продюсер вызывает исключение или возвращает статус ошибки
    Читатель = ЧитательСМетриками();
    Продюсер = ПродюсерСДанными(ДанныеСводки("rpc.duration", "s"));
    Продюсер.Сбой = Сбой;
    Читатель.ДобавитьПродюсер(Продюсер);

    // Когда
    РезультатСбора = Неопределено;
    Тело = Читатель.СобратьВТексте(РезультатСбора);

    // Тогда - метрики метров выданы, сбой продюсера отражен в результате сбора
    Ожидаем.Что(Тело).Содержит("jobs_total{");
    Ожидаем.Что(СтрНайти(Тело, "rpc_duration")).Равно(0);
    Ожидаем.Что(РезультатСбора.Успешно()).ЭтоЛожь();

КонецПроцедуры

Функция ДанныеСводки(Имя, Единица)
    Квантили = Новый Массив();
    Для Каждого Пара Из СтрРазделить("0.99:0.9,0:0.1,0.5:0.2", ",") Цикл
        Части = СтрРазделить(Пара, ":");
        Квантиль = Новый Соответствие();
        Квантиль.Вставить("quantile", Число(Части[0]));
        Квантиль.Вставить("value", Число(Части[1]));
        Квантили.Добавить(Квантиль);
    КонецЦикла;
    Экземпляры = Новый Массив();
    Экземпляры.Добавить(Экземпляр(0.3, "1700000001000000000"));
    Точка = Новый Соответствие();
    Точка.Вставить("attributes", Новый Массив());
    Точка.Вставить("startTimeUnixNano", "1700000000000000000");
    Точка.Вставить("timeUnixNano", "1700000060000000000");
    Точка.Вставить("count", 12);
    Точка.Вставить("sum", 5.5);
    Точка.Вставить("quantileValues", Квантили);
    Точка.Вставить("exemplars", Экземпляры);
    Точки = Новый Массив();
    Точки.Добавить(Точка);
    Возврат Новый ОтелДанныеМетрики(Новый ОтелРесурс(Истина), Область(), Имя, "", Единица, ОтелТипМетрики.Сводка(),
        Точки, Ложь, "double");
КонецФункции

// Продюсер метрик, отдающий заданные данные и запоминающий переданный фильтр.
Функция ПродюсерСДанными(ДанныеМетрики)
    Текст = "Перем Данные Экспорт;
    |Перем Фильтр Экспорт;
    |Перем Сбой Экспорт;
    |Функция Произвести(ФильтрМетрик = Неопределено) Экспорт
    |    Фильтр = ФильтрМетрик;
    |    Если Сбой = ""исключение"" Тогда
    |        ВызватьИсключение ""Продюсер недоступен"";
    |    ИначеЕсли Сбой = ""статус"" Тогда
    |        Возврат Новый ОтелРезультатПроизводстваМетрик(""Failure"", , ""Продюсер недоступен"");
    |    КонецЕсли;
    |    Возврат Новый ОтелРезультатПроизводстваМетрик(""Success"", Данные);
    |КонецФункции
    |Данные = Новый Массив;
    |Сбой = """";";
    Продюсер = ЗагрузитьСценарийИзСтроки(Текст);
    Продюсер.Данные.Добавить(ДанныеМетрики);
    Возврат Продюсер;
КонецФункции

Функция ЧитательСМетриками()
    Ресурс = Новый ОтелРесурс(Истина);
    Ресурс.Атрибуты().Установить("service.name", "checkout");
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("fmt-lib", "1.0"), Ресурс);
    Метр.СоздатьСчетчик("jobs", "Задания", "{job}").Добавить(2);
    Метр.СоздатьГистограмму("http.duration", "Длительность", "s").Записать(0.2);
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.ДобавитьМетр(Метр);
    Возврат Читатель;
КонецФункции

Функция ЛейблыОбласти()
    Возврат "otel_scope_name=""fmt-lib"",otel_scope_version=""1.0""";
КонецФункции

// Возвращает число из последнего поля строки выдачи, начинающейся с префикса.
//
Функция ЗначениеСэмпла(Тело, Префикс)
    Для Каждого СтрокаВыдачи Из СтрРазделить(Тело, Символы.ПС) Цикл
        Если СтрНачинаетсяС(СтрокаВыдачи, Префикс) Тогда
            Поля = СтрРазделить(СтрокаВыдачи, " ");
            Возврат Число(Поля[Поля.ВГраница()]);
        КонецЕсли;
    КонецЦикла;
    ВызватьИсключение "Нет сэмпла " + Префикс;
КонецФункции

Функция ДанныеДатчика(Имя, Метаданные, Значение = 1, Экземпляры = Неопределено)
    Точка = Новый Соответствие();
    Точка.Вставить("value", Значение);
    Точка.Вставить("attributes", Новый Массив());
    Если Экземпляры <> Неопределено Тогда
        Точка.Вставить("exemplars", Экземпляры);
    КонецЕсли;
    Данные = НовыеДанные(Имя, ОтелТипМетрики.Датчик(), Точка, Ложь);
    Данные.УстановитьМетаданные(Метаданные);
    Возврат Данные;
КонецФункции

Функция ДанныеСчетчика(Имя, Значение, Экземпляры)
    Точка = Новый Соответствие();
    Точка.Вставить("value", Значение);
    Точка.Вставить("attributes", Новый Массив());
    Точка.Вставить("exemplars", Экземпляры);
    Возврат НовыеДанные(Имя, ОтелТипМетрики.Сумма(), Точка, Истина);
КонецФункции

Функция ДанныеГистограммы(Имя, Экземпляры)
    Границы = Новый Массив();
    Границы.Добавить(1);
    Границы.Добавить(5);
    Счетчики = Новый Массив();
    Для Каждого Количество Из СтрРазделить("1,1,0", ",") Цикл
        Счетчики.Добавить(Число(Количество));
    КонецЦикла;
    Точка = Новый Соответствие();
    Точка.Вставить("attributes", Новый Массив());
    Точка.Вставить("explicitBounds", Границы);
    Точка.Вставить("bucketCounts", Счетчики);
    Точка.Вставить("sum", 3.5);
    Точка.Вставить("count", 2);
    Точка.Вставить("exemplars", Экземпляры);
    Возврат НовыеДанные(Имя, ОтелТипМетрики.Гистограмма(), Точка, Ложь);
КонецФункции

Функция НовыеДанные(Имя, ТипМетрики, Точка, Монотонный)
    Точки = Новый Массив();
    Точки.Добавить(Точка);
    Возврат Новый ОтелДанныеМетрики(Новый ОтелРесурс(Истина), Область(), Имя, "", "", ТипМетрики, Точки, Монотонный);
КонецФункции

Функция Экземпляр(Значение, Время, КлючАтрибута = "", ЗначениеАтрибута = "")
    Экземпляр = Новый Соответствие();
    Экземпляр.Вставить("timeUnixNano", Время);
    Экземпляр.Вставить("asDouble", Значение);
    Экземпляр.Вставить("traceId", "0af7651916cd43dd8448eb211c80319c");
    Экземпляр.Вставить("spanId", "b7ad6b7169203331");
    Если КлючАтрибута <> "" Тогда
        ЗначениеAnyValue = Новый Соответствие();
        ЗначениеAnyValue.Вставить("stringValue", ЗначениеАтрибута);
        Атрибут = Новый Соответствие();
        Атрибут.Вставить("key", КлючАтрибута);
        Атрибут.Вставить("value", ЗначениеAnyValue);
        Атрибуты = Новый Массив();
        Атрибуты.Добавить(Атрибут);
        Экземпляр.Вставить("filteredAttributes", Атрибуты);
    КонецЕсли;
    Возврат Экземпляр;
КонецФункции

Функция СтрокаДлины(Длина)
    Результат = "";
    Пока СтрДлина(Результат) < Длина Цикл
        Результат = Результат + "x";
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция Область()
    Возврат Новый ОтелОбластьИнструментирования("");
КонецФункции

Функция ПодключитьАппендер()
    Текст = "Перем События Экспорт;
    |Процедура ВывестиСобытие(Событие) Экспорт
    |    События.Добавить(Событие);
    |КонецПроцедуры
    |Процедура Закрыть() Экспорт
    |КонецПроцедуры
    |Процедура УстановитьСвойство(Имя, Значение) Экспорт
    |КонецПроцедуры
    |События = Новый Массив();";
    Аппендер = ЗагрузитьСценарийИзСтроки(Текст);
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);
    Возврат Аппендер;
КонецФункции

Процедура ОтключитьАппендер(Аппендер)
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics");
    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);
КонецПроцедуры

Функция ЕстьПредупреждениеСТекстом(Аппендер, Текст)
    Для Каждого Событие Из Аппендер.События Цикл
        Если Событие.ПолучитьУровень() = УровниЛога.Предупреждение
                И СтрНайти(Событие.ПолучитьСообщение(), Текст) > 0 Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

// Метр, отдающий читателю заданные данные метрики.
Функция МетрСДанными(ДанныеМетрики)
    Текст = "Перем Область Экспорт;
    |Перем Данные Экспорт;
    |Функция ОбластьИнструментирования() Экспорт
    |    Возврат Область;
    |КонецФункции
    |Функция СобратьДляЧитателя(Читатель, ВремяСбора = Неопределено, Ошибки = Неопределено) Экспорт
    |    Возврат Данные;
    |КонецФункции
    |Данные = Новый Массив;";
    Метр = ЗагрузитьСценарийИзСтроки(Текст);
    Метр.Область = Область();
    Метр.Данные.Добавить(ДанныеМетрики);
    Возврат Метр;
КонецФункции
