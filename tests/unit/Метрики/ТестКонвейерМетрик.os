// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
#Использовать "../../.."
#Использовать asserts

// Сквозные тесты конвейера метрик: провайдер, несколько читателей, View и экспорт.

&Тест
Процедура ЧитателиСобираютНезависимо() Экспорт

    // Дано - дельта- и кумулятивный читатели одного провайдера
    ДельтаЭкспортер = Захватчик(ОтелВременнаяАгрегация.Дельта());
    КумулятивныйЭкспортер = Захватчик(ОтелВременнаяАгрегация.Кумулятивная());
    ДельтаЧитатель = Новый ОтелПериодическийЧитательМетрик(ДельтаЭкспортер);
    КумулятивныйЧитатель = Новый ОтелПериодическийЧитательМетрик(КумулятивныйЭкспортер);
    Провайдер = ПровайдерСЧитателями(ДельтаЧитатель, КумулятивныйЧитатель);
    Счетчик = Провайдер.ПолучитьМетр("pipeline-lib").СоздатьСчетчик("requests");

    // Когда - сборы читателей чередуются
    Счетчик.Добавить(5);
    ДельтаЧитатель.СброситьБуфер();
    КумулятивныйЧитатель.СброситьБуфер();
    Счетчик.Добавить(2);
    ДельтаЧитатель.СброситьБуфер();
    КумулятивныйЧитатель.СброситьБуфер();

    // Тогда - сбор одного читателя не сбрасывает и не искажает данные другого
    ДельтаЭкспорты = ДельтаЭкспортер.Экспорты;
    КумулятивныеЭкспорты = КумулятивныйЭкспортер.Экспорты;
    Ожидаем.Что(ЗначениеТочки(ДельтаЭкспорты[0][0])).Равно(5);
    Ожидаем.Что(ЗначениеТочки(ДельтаЭкспорты[1][0])).Равно(2);
    Ожидаем.Что(ЗначениеТочки(КумулятивныеЭкспорты[0][0])).Равно(5);
    Ожидаем.Что(ЗначениеТочки(КумулятивныеЭкспорты[1][0])).Равно(7);
    Ожидаем.Что(ДельтаЭкспорты[1][0].ВременнаяАгрегация()).Равно(ОтелВременнаяАгрегация.Дельта());
    Ожидаем.Что(КумулятивныеЭкспорты[1][0].ВременнаяАгрегация()).Равно(ОтелВременнаяАгрегация.Кумулятивная());
    Провайдер.Закрыть();

КонецПроцедуры

&Тест
Процедура АгрегацияПоУмолчаниюЗадаетсяЧитателемПоВиду() Экспорт

    // Дано - первый читатель отбрасывает счетчики, второй использует агрегацию спецификации
    СОтбрасыванием = Захватчик();
    ПоУмолчанию = Захватчик();
    ЧитательСОтбрасыванием = Новый ОтелПериодическийЧитательМетрик(СОтбрасыванием);
    ЧитательСОтбрасыванием.УстановитьАгрегациюПоУмолчанию("Counter", "drop");
    ЧитательПоУмолчанию = Новый ОтелПериодическийЧитательМетрик(ПоУмолчанию);
    Провайдер = ПровайдерСЧитателями(ЧитательСОтбрасыванием, ЧитательПоУмолчанию);
    Метр = Провайдер.ПолучитьМетр("pipeline-lib");

    // Когда
    Метр.СоздатьСчетчик("dropped.by.first").Добавить(3);
    Метр.СоздатьДатчик("kept.gauge").Записать(1);
    ЧитательСОтбрасыванием.СброситьБуфер();
    ЧитательПоУмолчанию.СброситьБуфер();

    // Тогда
    Ожидаем.Что(СОтбрасыванием.Метрика("dropped.by.first")).Равно(Неопределено);
    Ожидаем.Что(СОтбрасыванием.Метрика("kept.gauge")).Не_().Равно(Неопределено);
    Ожидаем.Что(ЗначениеТочки(ПоУмолчанию.Метрика("dropped.by.first"))).Равно(3);
    Провайдер.Закрыть();

КонецПроцедуры

&Тест
Процедура ЛимитМощностиЗадаетсяЧитателемПоВиду() Экспорт

    // Дано - у первого читателя лимит мощности счетчиков 2, у второго - по умолчанию
    СЛимитом = Захватчик();
    БезЛимита = Захватчик();
    ЧитательСЛимитом = Новый ОтелПериодическийЧитательМетрик(СЛимитом);
    ЧитательСЛимитом.УстановитьЛимитМощностиДляВида("Counter", 2);
    ЧитательБезЛимита = Новый ОтелПериодическийЧитательМетрик(БезЛимита);
    Провайдер = ПровайдерСЧитателями(ЧитательСЛимитом, ЧитательБезЛимита);
    Счетчик = Провайдер.ПолучитьМетр("pipeline-lib").СоздатьСчетчик("limited");

    // Когда - четыре серии атрибутов
    Для Номер = 1 По 4 Цикл
        Счетчик.Добавить(1, АтрибутыСерии("n", Номер));
    КонецЦикла;
    ЧитательСЛимитом.СброситьБуфер();
    ЧитательБезЛимита.СброситьБуфер();

    // Тогда - у читателя с лимитом две серии и overflow, у второго все четыре серии
    ТочкиСЛимитом = СЛимитом.Метрика("limited").ТочкиДанных();
    Ожидаем.Что(ТочкиСЛимитом).ИмеетДлину(3);
    Ожидаем.Что(ЧислоТочекПереполнения(ТочкиСЛимитом)).Равно(1);
    Ожидаем.Что(БезЛимита.Метрика("limited").ТочкиДанных()).ИмеетДлину(4);
    Провайдер.Закрыть();

КонецПроцедуры

&Тест
Процедура КаждоеСовпавшееПредставлениеДаетМетрику() Экспорт

    // Дано - два View с разными именами выбирают один счетчик
    Экспортер = Захватчик();
    Читатель = Новый ОтелПериодическийЧитательМетрик(Экспортер);
    Провайдер = ПровайдерСЧитателями(Читатель);
    Провайдер.ЗарегистрироватьПредставление(
        Новый ОтелСелекторИнструментов("orders"), Новый ОтелПредставление("orders.first"));
    Провайдер.ЗарегистрироватьПредставление(
        Новый ОтелСелекторИнструментов("orders"), Новый ОтелПредставление("orders.second"));

    // Когда
    Провайдер.ПолучитьМетр("pipeline-lib").СоздатьСчетчик("orders").Добавить(4);
    Читатель.СброситьБуфер();

    // Тогда - поток на каждый View
    Ожидаем.Что(ЗначениеТочки(Экспортер.Метрика("orders.first"))).Равно(4);
    Ожидаем.Что(ЗначениеТочки(Экспортер.Метрика("orders.second"))).Равно(4);
    Ожидаем.Что(Экспортер.Метрика("orders")).Равно(Неопределено);
    Провайдер.Закрыть();

КонецПроцедуры

&Тест
Процедура ПредставлениеПослеПолученияМетраПрименяетсяКЕгоИнструментам() Экспорт

    // Дано - метр и инструмент получены до регистрации View
    Экспортер = Захватчик();
    Читатель = Новый ОтелПериодическийЧитательМетрик(Экспортер);
    Провайдер = ПровайдерСЧитателями(Читатель);
    Счетчик = Провайдер.ПолучитьМетр("pipeline-lib").СоздатьСчетчик("late.view");

    // Когда
    Провайдер.ЗарегистрироватьПредставление(
        Новый ОтелСелекторИнструментов("late.view"), Новый ОтелПредставление("late.view.renamed"));
    Счетчик.Добавить(1);
    Читатель.СброситьБуфер();

    // Тогда - измерения после регистрации View попадают в поток View
    Ожидаем.Что(ЗначениеТочки(Экспортер.Метрика("late.view.renamed"))).Равно(1);
    Ожидаем.Что(Экспортер.Метрика("late.view")).Равно(Неопределено);
    Провайдер.Закрыть();

КонецПроцедуры

&Тест
Процедура СелекторHistogramВыбираетГистограммуСЭкспоненциальнойАгрегациейЧитателя() Экспорт

    // Дано - агрегация гистограмм читателя по умолчанию экспоненциальная, View выбирает вид Histogram
    Экспортер = Захватчик();
    Читатель = Новый ОтелПериодическийЧитательМетрик(Экспортер, 60000, 2000, "base2_exponential_bucket_histogram");
    Провайдер = ПровайдерСЧитателями(Читатель);
    Провайдер.ЗарегистрироватьПредставление(
        Новый ОтелСелекторИнструментов("latency", "Histogram"), Новый ОтелПредставление("latency.exp"));

    // Когда
    Провайдер.ПолучитьМетр("pipeline-lib").СоздатьГистограмму("latency").Записать(12);
    Читатель.СброситьБуфер();

    // Тогда - инструмент остается видом Histogram, агрегация берется у читателя
    Метрика = Экспортер.Метрика("latency.exp");
    Ожидаем.Что(Метрика).Не_().Равно(Неопределено);
    Ожидаем.Что(Метрика.ТипМетрики()).Равно(ОтелТипМетрики.ЭкспоненциальнаяГистограмма());
    Провайдер.Закрыть();

КонецПроцедуры

&Тест
Процедура ПереименованиеВИмяДругогоИнструментаПредупреждаетИЭкспортируетОба() Экспорт

    // Дано - View переименовывает инструмент в имя существующего инструмента
    Экспортер = Захватчик();
    Читатель = Новый ОтелПериодическийЧитательМетрик(Экспортер);
    Провайдер = ПровайдерСЧитателями(Читатель);
    Провайдер.ЗарегистрироватьПредставление(
        Новый ОтелСелекторИнструментов("jobs.started"), Новый ОтелПредставление("jobs.total"));
    Метр = Провайдер.ПолучитьМетр("pipeline-lib");
    Метр.СоздатьСчетчик("jobs.total").Добавить(1);
    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);

    // Когда
    Метр.СоздатьСчетчик("jobs.started").Добавить(2);
    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);
    Читатель.СброситьБуфер();

    // Тогда - предупреждение о конфликте идентичности, оба потока экспортируются
    Ожидаем.Что(ЕстьПредупреждениеСТекстом(Аппендер, "Конфликт идентичности метрик")).ЭтоИстина();
    Одноименные = 0;
    Для Каждого Данные Из Экспортер.ПоследнийЭкспорт() Цикл
        Если Данные.Имя() = "jobs.total" Тогда
            Одноименные = Одноименные + 1;
        КонецЕсли;
    КонецЦикла;
    Ожидаем.Что(Одноименные).Равно(2);
    Провайдер.Закрыть();

КонецПроцедуры

&Тест
Процедура ПредставлениеССемантическойОшибкойИгнорируетсяЦеликом() Экспорт

    // Дано - View задает асинхронному счетчику гистограммную агрегацию и новое имя
    Экспортер = Захватчик();
    Читатель = Новый ОтелПериодическийЧитательМетрик(Экспортер);
    Провайдер = ПровайдерСЧитателями(Читатель);
    Провайдер.ЗарегистрироватьПредставление(Новый ОтелСелекторИнструментов("observed"),
        Новый ОтелПредставление("observed.hist", , , , ОтелАгрегация.ГистограммаСЯвнымиГраницами()));

    // Когда
    Провайдер.ПолучитьМетр("pipeline-lib").СоздатьНаблюдаемыйСчетчик("observed",
        Новый Действие(ЭтотОбъект, "НаблюдатьПять"));
    Читатель.СброситьБуфер();

    // Тогда - метрика экспортируется так, как если бы View не было
    Ожидаем.Что(Экспортер.Метрика("observed.hist")).Равно(Неопределено);
    Метрика = Экспортер.Метрика("observed");
    Ожидаем.Что(Метрика.ТипМетрики()).Равно(ОтелТипМетрики.Сумма());
    Ожидаем.Что(ЗначениеТочки(Метрика)).Равно(5);
    Провайдер.Закрыть();

КонецПроцедуры

&Тест
Процедура ГистограммаДатчикаНеСобираетСумму() Экспорт

    // Дано - синхронный датчик может записывать отрицательные значения, View задает гистограмму
    Экспортер = Захватчик();
    Читатель = Новый ОтелПериодическийЧитательМетрик(Экспортер);
    Провайдер = ПровайдерСЧитателями(Читатель);
    Провайдер.ЗарегистрироватьПредставление(Новый ОтелСелекторИнструментов("temperature"),
        Новый ОтелПредставление(, , , , ОтелАгрегация.ГистограммаСЯвнымиГраницами()));
    Датчик = Провайдер.ПолучитьМетр("pipeline-lib").СоздатьДатчик("temperature");

    // Когда
    Датчик.Записать(-5);
    Датчик.Записать(3);
    Читатель.СброситьБуфер();

    // Тогда - гистограмма без суммы
    Метрика = Экспортер.Метрика("temperature");
    Ожидаем.Что(Метрика.ТипМетрики()).Равно(ОтелТипМетрики.Гистограмма());
    Точка = Метрика.ТочкиДанных()[0];
    Ожидаем.Что(Точка.Получить("count")).Равно(2);
    Ожидаем.Что(Точка.Получить("sum")).Равно(Неопределено);
    Провайдер.Закрыть();

КонецПроцедуры

&Тест
Процедура ЛимитМощностиПредставленияДляАсинхронногоИнструмента() Экспорт

    // Дано - View задает лимит мощности асинхронного датчика
    Экспортер = Захватчик();
    Читатель = Новый ОтелПериодическийЧитательМетрик(Экспортер);
    Провайдер = ПровайдерСЧитателями(Читатель);
    Провайдер.ЗарегистрироватьПредставление(Новый ОтелСелекторИнструментов("observed.series"),
        Новый ОтелПредставление(, , , , , , , 2));

    // Когда - callback наблюдает четыре серии
    Провайдер.ПолучитьМетр("pipeline-lib").СоздатьНаблюдаемыйДатчик("observed.series",
        Новый Действие(ЭтотОбъект, "НаблюдатьЧетыреСерии"));
    Читатель.СброситьБуфер();

    // Тогда - две серии и overflow
    Точки = Экспортер.Метрика("observed.series").ТочкиДанных();
    Ожидаем.Что(Точки).ИмеетДлину(3);
    Ожидаем.Что(ЧислоТочекПереполнения(Точки)).Равно(1);
    Провайдер.Закрыть();

КонецПроцедуры

&Тест
Процедура АгрегацияПоУмолчаниюPrometheusЧитателяПоВиду() Экспорт

    // Дано - Prometheus-читатель отбрасывает счетчики по умолчанию
    Читатель = Новый ОтелПрометеусЧитательМетрик();
    Читатель.УстановитьАгрегациюПоУмолчанию("Counter", "drop");
    Провайдер = ПровайдерСЧитателями(Читатель);
    Метр = Провайдер.ПолучитьМетр("pipeline-lib");

    // Когда
    Метр.СоздатьСчетчик("prom.dropped").Добавить(1);
    Метр.СоздатьДатчик("prom.kept").Записать(2);
    Текст = Читатель.СобратьВТексте();

    // Тогда
    Ожидаем.Что(СтрНайти(Текст, "prom_dropped")).Равно(0);
    Ожидаем.Что(СтрНайти(Текст, "prom_kept") > 0).ЭтоИстина();
    Провайдер.Закрыть();

КонецПроцедуры

Процедура НаблюдатьПять(Наблюдение) Экспорт
    Наблюдение.Записать(5);
КонецПроцедуры

Процедура НаблюдатьЧетыреСерии(Наблюдение) Экспорт
    Для Номер = 1 По 4 Цикл
        Наблюдение.Записать(Номер, АтрибутыСерии("n", Номер));
    КонецЦикла;
КонецПроцедуры

Функция ЧислоТочекПереполнения(Точки)
    Число = 0;
    Для Каждого Точка Из Точки Цикл
        Если КлючиАтрибутов(Точка) = "otel.metric.overflow" Тогда
            Число = Число + 1;
        КонецЕсли;
    КонецЦикла;
    Возврат Число;
КонецФункции

Функция Захватчик(Временность = Неопределено)
    КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Экспортер = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "ЗахватчикДанныхМетрик.os"));
    Если Временность <> Неопределено Тогда
        Экспортер.УстановитьВременность(Временность);
    КонецЕсли;
    Возврат Экспортер;
КонецФункции

Функция ПровайдерСЧитателями(Первый, Второй = Неопределено)
    Построитель = Новый ОтелПостроительПровайдераМетрик();
    Построитель.УстановитьРесурс(Новый ОтелРесурс(Истина));
    Построитель.ЗарегистрироватьЧитатель(Первый);
    Если Второй <> Неопределено Тогда
        Построитель.ЗарегистрироватьЧитатель(Второй);
    КонецЕсли;
    Возврат Построитель.Построить();
КонецФункции

Функция АтрибутыСерии(Ключ, Значение)
    Атрибуты = Новый ОтелАтрибуты();
    Атрибуты.Установить(Ключ, Значение);
    Возврат Атрибуты;
КонецФункции

Функция МассивСтрок(Первая, Вторая = Неопределено)
    Результат = Новый Массив();
    Результат.Добавить(Первая);
    Если Вторая <> Неопределено Тогда
        Результат.Добавить(Вторая);
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ЗначениеТочки(ДанныеМетрики)
    Возврат ДанныеМетрики.ТочкиДанных()[0].Получить("value");
КонецФункции

Функция КлючиАтрибутов(Точка)
    Ключи = Новый СписокЗначений();
    Для Каждого Атрибут Из Точка.Получить("attributes") Цикл
        Ключи.Добавить(Атрибут.Получить("key"));
    КонецЦикла;
    Ключи.СортироватьПоЗначению();
    Возврат СтрСоединить(Ключи.ВыгрузитьЗначения(), ",");
КонецФункции

Функция СоздатьТестовыйАппендер()
    Текст = "Перем События Экспорт;
    |Процедура ВывестиСобытие(Событие) Экспорт
    |    События.Добавить(Событие);
    |КонецПроцедуры
    |Процедура Закрыть() Экспорт
    |КонецПроцедуры
    |Процедура УстановитьСвойство(Имя, Значение) Экспорт
    |КонецПроцедуры
    |События = Новый Массив();";
    Возврат ЗагрузитьСценарийИзСтроки(Текст);
КонецФункции

Функция ЕстьПредупреждениеСТекстом(Аппендер, Текст)
    Для Каждого Событие Из Аппендер.События Цикл
        Если Событие.ПолучитьУровень() = УровниЛога.Предупреждение
                И СтрНайти(Событие.ПолучитьСообщение(), Текст) > 0 Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции
