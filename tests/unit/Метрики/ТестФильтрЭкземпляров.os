&Тест
Процедура ВсегдаВыключенНеЗахватывает() Экспорт

    // Тогда
    Ожидаем.Что(ОтелФильтрЭкземпляров.ДолженЗахватить(ОтелФильтрЭкземпляров.ВсегдаВыключен())).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ВсегдаВключенЗахватывает() Экспорт

    // Тогда
    Ожидаем.Что(ОтелФильтрЭкземпляров.ДолженЗахватить(ОтелФильтрЭкземпляров.ВсегдаВключен())).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ПоТрассировкеБезАктивногоСпана() Экспорт

    // Дано - нет активного спана
    ОтелКонтекст.Очистить();

    // Тогда - без активного спана не захватываем
    Ожидаем.Что(ОтелФильтрЭкземпляров.ДолженЗахватить(ОтелФильтрЭкземпляров.ПоТрассировке())).Равно(Ложь);

    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура ПоТрассировкеСАктивнымСпаном() Экспорт

    // Дано - есть активный спан
    ОтелКонтекст.Очистить();
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("библ", "1.0");
    Спан = Новый ОтелСпан("тест", Ресурс, ОбластьИнструментирования);
    ОтелКонтекст.СделатьСпанТекущим(Спан);

    // Тогда - с активным спаном захватываем
    Ожидаем.Что(ОтелФильтрЭкземпляров.ДолженЗахватить(ОтелФильтрЭкземпляров.ПоТрассировке())).Равно(Истина);

    // Очистка
    Спан.Завершить();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура ПоТрассировкеНеЗахватываетБезФлагаSampled() Экспорт

    // Дано - активный спан валиден, но не сэмплирован (флаги 00)
    ОтелКонтекст.Очистить();
    ОтелКонтекст.СделатьСпанТекущим(ОбернутыйСпан("b7ad6b7169203331", 0));

    // Тогда - TraceBased: только измерения в контексте сэмплированного спана
    Ожидаем.Что(ОтелФильтрЭкземпляров.ДолженЗахватить(ОтелФильтрЭкземпляров.ПоТрассировке())).Равно(Ложь);

    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура ПоТрассировкеУчитываетЯвныйКонтекстИзмерения() Экспорт

    // Дано - текущий контекст пуст, у измерения явный контекст со сэмплированным спаном
    ОтелКонтекст.Очистить();
    Контекст = ОтелКонтекст.КонтекстСоСпаном(Новый Соответствие(), ОбернутыйСпан("b7ad6b7169203331", 1));

    // Тогда
    Ожидаем.Что(ОтелФильтрЭкземпляров.ДолженЗахватить(ОтелФильтрЭкземпляров.ПоТрассировке(), Контекст))
        .Равно(Истина);

КонецПроцедуры

&Тест
Процедура ПоТрассировкеЯвныйКонтекстИзмеренияВажнееТекущего() Экспорт

    // Дано - текущий спан сэмплирован, а у измерения явный контекст с несэмплированным спаном
    ОтелКонтекст.Очистить();
    ОтелКонтекст.СделатьСпанТекущим(ОбернутыйСпан("b7ad6b7169203331", 1));
    Контекст = ОтелКонтекст.КонтекстСоСпаном(Новый Соответствие(), ОбернутыйСпан("00f067aa0ba902b7", 0));

    // Тогда
    Ожидаем.Что(ОтелФильтрЭкземпляров.ДолженЗахватить(ОтелФильтрЭкземпляров.ПоТрассировке(), Контекст))
        .Равно(Ложь);

    ОтелКонтекст.Очистить();

КонецПроцедуры

Функция ОбернутыйСпан(ИдСпана, Флаги)
    КонтекстСпана = Новый ОтелКонтекстСпана("0af7651916cd43dd8448eb211c80319c", ИдСпана, Флаги);
    Возврат ОтелСпаны.Обернуть(КонтекстСпана);
КонецФункции
