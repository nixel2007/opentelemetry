// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать "../../.."
#Использовать asserts
#Использовать atomic

// Состояние для фоновых заданий конкурентной регистрации
Перем Метр;
Перем КоличествоРаундов;
Перем Прибыло;
Перем Сорвано;

&Тест
Процедура КонкурентноеСозданиеИнструментаРегистрируетОдинЭкземпляр() Экспорт

    // Дано - два фоновых задания на барьере одновременно создают счетчик с одним именем
    // (Meter потокобезопасен; повторная регистрация той же идентичности возвращает
    // ранее зарегистрированный инструмент, а не второй экземпляр)
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("test"), Новый ОтелРесурс(Истина));
    КоличествоРаундов = 200;
    Прибыло = Новый АтомарноеЧисло(0);
    Сорвано = Новый АтомарноеБулево(Ложь);

    // Когда
    КоличествоЗаданий = 2;
    Задания = Новый Массив();
    Пока Задания.Количество() < КоличествоЗаданий Цикл
        Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "СоздатьСчетчикиОдновременно"));
    КонецЦикла;
    ФоновыеЗадания.ОжидатьВсе(Задания);

    // Тогда - на каждое имя зарегистрирован один инструмент, и оба задания получили его
    Для Каждого Задание Из Задания Цикл
        Ожидаем.Что(Задание.ИнформацияОбОшибке, "ошибка фонового задания").Равно(Неопределено);
    КонецЦикла;
    Ожидаем.Что(Сорвано.Получить(), "барьер фоновых заданий сорван").ЭтоЛожь();
    Первые = Задания[0].Результат;
    Вторые = Задания[1].Результат;
    РазныхЭкземпляров = 0;
    Для Индекс = 0 По КоличествоРаундов - 1 Цикл
        Если Первые[Индекс] <> Вторые[Индекс] Тогда
            РазныхЭкземпляров = РазныхЭкземпляров + 1;
        КонецЕсли;
    КонецЦикла;
    Ожидаем.Что(РазныхЭкземпляров, "раундов, в которых задания получили разные инструменты").Равно(0);
    Ожидаем.Что(Метр.Инструменты().Количество(), "зарегистрировано инструментов").Равно(КоличествоРаундов);

КонецПроцедуры

// Выполняется двумя фоновыми заданиями: в каждом раунде задания встречаются на барьере
// и создают счетчик с именем раунда одновременно. Барьер ограничен временем; периодически
// задание уступает процессор, чтобы на одном ядре второе задание дошло до барьера.
Функция СоздатьСчетчикиОдновременно() Экспорт
    ТаймаутБарьераМс = 30000;
    ВитковДоУступки = 1000;
    Полученные = Новый Массив();
    Для Индекс = 0 По КоличествоРаундов - 1 Цикл
        Прибыло.ИнкрементироватьИПолучить();
        Цель = 2 * (Индекс + 1);
        НачалоОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
        Витков = 0;
        Пока Прибыло.Получить() < Цель Цикл
            Витков = Витков + 1;
            Если Витков % ВитковДоУступки = 0 Тогда
                Приостановить(0);
            КонецЕсли;
            ОжиданиеМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжидания;
            Если ОжиданиеМс > ТаймаутБарьераМс Или Сорвано.Получить() Тогда
                Сорвано.Установить(Истина);
                Возврат Полученные;
            КонецЕсли;
        КонецЦикла;
        Полученные.Добавить(Метр.СоздатьСчетчик("counter." + Формат(Индекс, "ЧН=0; ЧГ=")));
    КонецЦикла;
    Возврат Полученные;
КонецФункции

// Duplicate instrument registration (Metrics SDK): о конфликте повторной регистрации SDK SHOULD
// предупредить и в гонке, когда фоновое задание не нашло имя при поиске, а к регистрации под
// блокировкой его уже занял другой инструмент. Аппендер лога останавливает задание между поиском
// и регистрацией на предупреждении о некорректном совете
&Тест
Процедура ОдновременнаяРегистрацияСКонфликтомПредупреждает() Экспорт

    // Дано
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("test"), Новый ОтелРесурс(Истина));
    Аппендер = АппендерСПаузой();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.metrics");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);
    Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "СоздатьСчетчикСНекорректнымСоветом");
    ДождатьсяИстины(Аппендер.НаПаузе);

    // Когда - пока задание стоит между поиском и регистрацией, имя занимает другой инструмент
    Первый = Метр.СоздатьСчетчик("race.metric", "описание A");
    Аппендер.МожноПродолжать.Установить(Истина);
    Задание.ОжидатьЗавершения();

    // Тогда
    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);
    Ожидаем.Что(Аппендер.НаПаузе.Получить(), "задание остановилось между поиском и регистрацией").ЭтоИстина();
    Ожидаем.Что(Задание.ИнформацияОбОшибке, "ошибка фонового задания").Равно(Неопределено);
    Ожидаем.Что(Задание.Результат = Первый, "задание получило инструмент первой регистрации").ЭтоИстина();
    Ожидаем.Что(ЕстьСообщение(Аппендер, "повторной регистрации"), "предупреждение о конфликте").ЭтоИстина();

КонецПроцедуры

Функция СоздатьСчетчикСНекорректнымСоветом() Экспорт
    // Совет не Структура: о нем предупреждается после поиска имени и до регистрации
    Возврат Метр.СоздатьСчетчик("race.metric", "описание B", "", "не структура");
КонецФункции

// Аппендер лога: запоминает сообщения, а на предупреждении о некорректном совете
// останавливает записавший поток, пока тест не разрешит продолжить
Функция АппендерСПаузой()
    Текст = "Перем Сообщения Экспорт;
    |Перем НаПаузе Экспорт;
    |Перем МожноПродолжать Экспорт;
    |Процедура ВывестиСобытие(Событие) Экспорт
    |    Сообщения.Добавить(Событие.ПолучитьСообщение());
    |    Если СтрНайти(Событие.ПолучитьСообщение(), ""Advisory-параметры"") = 0 Тогда
    |        Возврат;
    |    КонецЕсли;
    |    НаПаузе.Установить(Истина);
    |    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    |    Пока НЕ МожноПродолжать.Получить() И ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало < 10000 Цикл
    |        Приостановить(5);
    |    КонецЦикла;
    |КонецПроцедуры
    |Процедура Закрыть() Экспорт
    |КонецПроцедуры
    |Процедура УстановитьСвойство(Имя, Значение) Экспорт
    |КонецПроцедуры
    |Сообщения = Новый Массив();";
    Аппендер = ЗагрузитьСценарийИзСтроки(Текст);
    Аппендер.НаПаузе = Новый АтомарноеБулево(Ложь);
    Аппендер.МожноПродолжать = Новый АтомарноеБулево(Ложь);
    Возврат Аппендер;
КонецФункции

Процедура ДождатьсяИстины(Флаг)
    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Пока НЕ Флаг.Получить() И ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало < 10000 Цикл
        Приостановить(5);
    КонецЦикла;
КонецПроцедуры

Функция ЕстьСообщение(Аппендер, Текст)
    Для Каждого Сообщение Из Аппендер.Сообщения Цикл
        Если СтрНайти(Сообщение, Текст) > 0 Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции
