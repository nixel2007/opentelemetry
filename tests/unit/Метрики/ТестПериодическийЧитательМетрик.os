&Тест
Процедура ПродюсерВозвращаетОбъектУспех() Экспорт

    // Дано - продюсер, возвращающий объект с Успех()=Истина и непустыми Метриками
    КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Захватчик = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "ЗахватчикЭкспорта.os"));

    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("prod-lib", "1.0");

    ТочкаДанных = Новый Соответствие();
    ТочкаДанных.Вставить("value", 77);
    ТочкаДанных.Вставить("attributes", Новый Массив());
    ТочкиДанных = Новый Массив();
    ТочкиДанных.Добавить(ТочкаДанных);
    ДанныеМетрики = Новый ОтелДанныеМетрики(
        Ресурс, ОбластьИнструментирования,
        "prod.metric", "", "1", ОтелТипМетрики.Датчик(), ТочкиДанных);

    ТекстРезультата = "
    |Перем Метрики Экспорт;
    |Функция Успех() Экспорт Возврат Истина; КонецФункции";
    ОбъектРезультата = ЗагрузитьСценарийИзСтроки(ТекстРезультата);
    ОбъектРезультата.Метрики = Новый Массив();
    ОбъектРезультата.Метрики.Добавить(ДанныеМетрики);

    ТекстПродюсера = "
    |Перем ОбъектРезультата Экспорт;
    |Функция Произвести(Ресурс) Экспорт
    |    Возврат ОбъектРезультата;
    |КонецФункции";
    Продюсер = ЗагрузитьСценарийИзСтроки(ТекстПродюсера);
    Продюсер.ОбъектРезультата = ОбъектРезультата;

    Читатель = Новый ОтелПериодическийЧитательМетрик(Захватчик);
    Читатель.ДобавитьПродюсер(Продюсер);

    // Когда
    Результат = Читатель.СброситьБуфер();

    // Тогда - продюсер с Успех()=Истина: данные экспортированы
    Ожидаем.Что(Результат.Успешно()).Равно(Истина);
    Ожидаем.Что(Захватчик.ЗахваченныеЗначения.Количество()).Равно(1);
    Ожидаем.Что(Захватчик.ЗахваченныеЗначения[0][0]).Равно(77);

КонецПроцедуры

