&Тест
Процедура ПродюсерВозвращаетМассив() Экспорт

    // Дано - продюсер, возвращающий Массив (legacy API совместимость)
    КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Захватчик = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "ЗахватчикЭкспорта.os"));

    ТекстПродюсера = "
    |Функция Произвести(Ресурс) Экспорт
    |    Ресурс = Новый ОтелРесурс();
    |    Область = Новый ОтелОбластьИнструментирования(""prod"", ""1.0"");
    |    ТочкаДанных = Новый Соответствие();
    |    ТочкаДанных.Вставить(""value"", 99);
    |    ТочкиДанных = Новый Массив();
    |    ТочкиДанных.Добавить(ТочкаДанных);
    |    Данные = Новый ОтелДанныеМетрики(Ресурс, Область, ""prod.metric"", """", ""1"", ОтелТипМетрики.Сумма(), ТочкиДанных, Истина);
    |    Результат = Новый Массив();
    |    Результат.Добавить(Данные);
    |    Возврат Результат;
    |КонецФункции";
    Продюсер = ЗагрузитьСценарийИзСтроки(ТекстПродюсера);

    Читатель = Новый ОтелПериодическийЧитательМетрик(Захватчик);
    Читатель.ДобавитьПродюсер(Продюсер);

    // Когда
    Результат = Читатель.СброситьБуфер();

    // Тогда - данные продюсера экспортированы
    Ожидаем.Что(Результат.Успешно()).Равно(Истина);
    Ожидаем.Что(Захватчик.ЗахваченныеЗначения.Количество()).Равно(1);
    Ожидаем.Что(Захватчик.ЗахваченныеЗначения[0][0]).Равно(99);

КонецПроцедуры

&Тест
Процедура ВыполнитьЭкспортЭкспортерВозвращаетЛожь() Экспорт

    // Дано - мок экспортер, который возвращает Ложь из Экспортировать
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерМетрик"));
    МокЭкспортер.Когда().Экспортировать(
        Матчеры.ЛюбоеЗначение(),
        Матчеры.ЛюбоеЗначение()
    ).ТогдаВозвращает(Ложь);

    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0");
    Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
    Счетчик = Метрика.СоздатьСчетчик("test.counter");
    Счетчик.Добавить(7);

    Читатель = Новый ОтелПериодическийЧитательМетрик(МокЭкспортер);
    Читатель.ДобавитьМетр(Метрика);

    // Когда
    Результат = Читатель.СброситьБуфер();

    // Тогда - экспорт вернул Ложь → результат - ошибка
    Ожидаем.Что(Результат.Успешно()).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ПродюсерВозвращаетОбъектСОшибкой() Экспорт

    // Дано - захватчик экспорта
    КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Захватчик = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "ЗахватчикЭкспорта.os"));

    // Результирующий объект продюсера с Успех() = Ложь
    ТекстРезультата = "
    |Перем Статус Экспорт;
    |Перем СообщениеОшибки Экспорт;
    |Перем Метрики Экспорт;
    |Функция Успех() Экспорт
    |    Возврат Ложь;
    |КонецФункции
    |Статус = ""error"";
    |СообщениеОшибки = ""тест: ошибка продюсера"";
    |Метрики = Новый Массив();";
    ОбъектРезультата = ЗагрузитьСценарийИзСтроки(ТекстРезультата);

    // Продюсер, возвращающий объект с Успех() = Ложь
    ТекстПродюсера = "
    |Перем ОбъектРезультата Экспорт;
    |Функция Произвести(Ресурс) Экспорт
    |    Возврат ОбъектРезультата;
    |КонецФункции";
    Продюсер = ЗагрузитьСценарийИзСтроки(ТекстПродюсера);
    Продюсер.ОбъектРезультата = ОбъектРезультата;

    Читатель = Новый ОтелПериодическийЧитательМетрик(Захватчик);
    Читатель.ДобавитьПродюсер(Продюсер);

    // Когда
    Результат = Читатель.СброситьБуфер();

    // Тогда - продюсер вернул ошибку, читатель не упал, данные не экспортированы, результат сбора -
    //   ошибка (MetricReader Collect SHOULD сообщать о сбое)
    Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
    Ожидаем.Что(Захватчик.ЗахваченныеЗначения.Количество()).Равно(0);

КонецПроцедуры

// MetricProducer: данные продюсера содержат ресурс, поэтому Produce SHOULD принимать ресурс
// параметром - читатель передает ресурс провайдера, у которого зарегистрирован. MetricFilter
// (параметр Produce) - Development, читатель его не передает
&Тест
Процедура ПродюсерПолучаетРесурсПровайдера() Экспорт

    // Дано
    КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Захватчик = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "ЗахватчикЭкспорта.os"));
    Продюсер = ПродюсерСРесурсом();
    Читатель = Новый ОтелПериодическийЧитательМетрик(Захватчик);
    Читатель.ДобавитьПродюсер(Продюсер);
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерМетрик(Ресурс, Читатель);

    // Когда
    Результат = Читатель.СброситьБуфер();

    // Тогда
    Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
    Ожидаем.Что(Продюсер.Вызовов).Равно(1);
    Ожидаем.Что(Продюсер.ПолученныйРесурс = Ресурс).ЭтоИстина();
    Провайдер.Закрыть();

КонецПроцедуры

// Читатель без провайдера передает продюсеру ресурс по умолчанию
&Тест
Процедура ПродюсерЧитателяБезПровайдераПолучаетРесурсПоУмолчанию() Экспорт

    // Дано
    КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Захватчик = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "ЗахватчикЭкспорта.os"));
    Продюсер = ПродюсерСРесурсом();
    Читатель = Новый ОтелПериодическийЧитательМетрик(Захватчик);
    Читатель.ДобавитьПродюсер(Продюсер);

    // Когда
    Результат = Читатель.СброситьБуфер();

    // Тогда
    Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
    Ожидаем.Что(ТипЗнч(Продюсер.ПолученныйРесурс)).Равно(Тип("ОтелРесурс"));

КонецПроцедуры

// Продюсер, запоминающий переданный ему ресурс.
Функция ПродюсерСРесурсом()
    Текст = "
    |Перем Вызовов Экспорт;
    |Перем ПолученныйРесурс Экспорт;
    |Функция Произвести(Ресурс) Экспорт
    |    Вызовов = Вызовов + 1;
    |    ПолученныйРесурс = Ресурс;
    |    Возврат Новый ОтелРезультатПроизводстваМетрик();
    |КонецФункции
    |Вызовов = 0;";
    Возврат ЗагрузитьСценарийИзСтроки(Текст);
КонецФункции

&Тест
Процедура ПрименитьПредставлениеПереименовываетМетрику() Экспорт

    // Дано - экспортер, захватывающий имена метрик
    ТекстЭкспортера = "
    |Перем ЗахваченныеИмена Экспорт;
    |Функция Экспортировать(МассивДанных, Таймаут = Неопределено) Экспорт
    |    Для Каждого Данные Из МассивДанных Цикл
    |        ЗахваченныеИмена.Добавить(Данные.Имя());
    |    КонецЦикла;
    |    Возврат Истина;
    |КонецФункции
    |Функция ПолучитьВременнуюАгрегацию(ТипИнструмента) Экспорт
    |    Возврат Неопределено;
    |КонецФункции
    |Процедура Закрыть() Экспорт
    |КонецПроцедуры
    |ЗахваченныеИмена = Новый Массив();";
    ЭкспортерЗахватчик = ЗагрузитьСценарийИзСтроки(ТекстЭкспортера);

    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0");
    Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
    Счетчик = Метрика.СоздатьСчетчик("original.counter");

    // Задаём представление: переименовать "original.counter" → "renamed.counter".
    //   View задает поток: измерения после регистрации View попадают в поток с новым именем
    Пары = Новый Массив();
    Пара = Новый Соответствие();
    Пара.Вставить("Селектор", Новый ОтелСелекторИнструментов("original.counter"));
    Пара.Вставить("Представление", Новый ОтелПредставление("renamed.counter"));
    Пары.Добавить(Пара);
    Метрика.УстановитьПредставления(Пары);
    Счетчик.Добавить(1);

    Читатель = Новый ОтелПериодическийЧитательМетрик(ЭкспортерЗахватчик);
    Читатель.ДобавитьМетр(Метрика);

    // Когда
    Читатель.СброситьБуфер();

    // Тогда - метрика экспортирована с новым именем
    Ожидаем.Что(ЭкспортерЗахватчик.ЗахваченныеИмена.Количество()).Равно(1);
    Ожидаем.Что(ЭкспортерЗахватчик.ЗахваченныеИмена[0]).Равно("renamed.counter");

КонецПроцедуры

