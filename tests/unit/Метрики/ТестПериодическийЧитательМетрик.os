&Тест
Процедура НесколькоЧитателейИзолированоСостояние() Экспорт

    // Дано - два читателя, один метр, один счетчик
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0");
    Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
    Счетчик = Метрика.СоздатьСчетчик("test.counter");

    КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Захватчик1 = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "ЗахватчикЭкспорта.os"));
    Захватчик2 = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "ЗахватчикЭкспорта.os"));

    Читатель1 = Новый ОтелПериодическийЧитательМетрик(Захватчик1);
    Читатель2 = Новый ОтелПериодическийЧитательМетрик(Захватчик2);
    Читатель1.ДобавитьМетр(Метрика);
    Читатель2.ДобавитьМетр(Метрика);
    Счетчик.Добавить(7);

    // Когда - оба читателя собирают данные
    Читатель1.СброситьБуфер();
    Читатель2.СброситьБуфер();

    // Тогда - каждый читатель получил данные независимо
    Ожидаем.Что(Захватчик1.ЗахваченныеЗначения.Количество()).Равно(1);
    Ожидаем.Что(Захватчик2.ЗахваченныеЗначения.Количество()).Равно(1);

КонецПроцедуры

