// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
#Использовать "../../.."
#Использовать asserts
#Использовать moskito

&Тест
Процедура СобратьИЭкспортировать() Экспорт

    // Дано
    Транспорт = Новый ОтелВПамятьТранспорт();
    Экспортер = Новый ОтелЭкспортерМетрик(Транспорт);
    Читатель = Новый ОтелПериодическийЧитательМетрик(Экспортер);

    Ресурс = Новый ОтелРесурс();
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0");
    Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
    Счетчик = Метрика.СоздатьСчетчик("test.counter");
    Счетчик.Добавить(5);

    Читатель.ДобавитьМетр(Метрика);

    // Когда
    Читатель.СброситьБуфер();

    // Тогда - транспорт получил данные
    Ожидаем.Что(Транспорт.ПолучитьОтправленные()).ИмеетДлину(1);
    Ожидаем.Что(Транспорт.ПолучитьОтправленные()[0].Получить("Путь")).Равно("/v1/metrics");

КонецПроцедуры

&Тест
Процедура ЗакрытьЧитатель() Экспорт

    // Дано
    Транспорт = Новый ОтелВПамятьТранспорт();
    Экспортер = Новый ОтелЭкспортерМетрик(Транспорт);
    Читатель = Новый ОтелПериодическийЧитательМетрик(Экспортер);

    Ресурс = Новый ОтелРесурс();
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0");
    Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
    Счетчик = Метрика.СоздатьСчетчик("test.counter");
    Счетчик.Добавить(10);

    Читатель.ДобавитьМетр(Метрика);

    // Когда - закрытие вызывает финальный экспорт
    Читатель.Закрыть();

    // Тогда
    Ожидаем.Что(Транспорт.ПолучитьОтправленные()).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ИнтервалПоУмолчанию() Экспорт

    // Дано
    Транспорт = Новый ОтелВПамятьТранспорт();
    Экспортер = Новый ОтелЭкспортерМетрик(Транспорт);

    // Когда
    Читатель = Новый ОтелПериодическийЧитательМетрик(Экспортер);

    // Тогда - интервал задается при создании, проверяем что объект создан без ошибок
    Ожидаем.Что(Читатель).Не_().Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЗакрытьВызываетЗакрытьЭкспортера() Экспорт

    // Дано - мок экспортер для проверки вызова Закрыть
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерМетрик"));
    Читатель = Новый ОтелПериодическийЧитательМетрик(МокЭкспортер);

    // Когда - закрываем читатель
    Читатель.Закрыть();

    // Тогда - экспортер.Закрыть() должен быть вызван (per spec: Shutdown MUST call exporter.Shutdown)
    // с оставшимся временем закрытия читателя
    МокЭкспортер.ПроверитьЧтоВызывалсяМетод().Закрыть(Матчеры.ЛюбоеЗначение());

КонецПроцедуры

&Тест
Процедура ОшибкаЭкспортера() Экспорт

    // Дано - экспортер бросает исключение
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерМетрик"));
    МокЭкспортер.Когда().Экспортировать(
        Матчеры.ЛюбоеЗначение()
    ).ТогдаВыбрасываетИсключение("тест: ошибка экспорта метрик");
    Читатель = Новый ОтелПериодическийЧитательМетрик(МокЭкспортер);

    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0");
    Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
    Счетчик = Метрика.СоздатьСчетчик("test.counter");
    Счетчик.Добавить(5);

    Читатель.ДобавитьМетр(Метрика);

    // Когда - сбрасываем буфер, экспортер падает
    Читатель.СброситьБуфер();

    // Тогда - ошибка обработана, читатель не сломался
    Читатель.Закрыть();
    Ожидаем.Что(Истина).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ДвойнойЗапуск() Экспорт

    // Дано
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерМетрик"));
    Читатель = Новый ОтелПериодическийЧитательМетрик(МокЭкспортер, 100);

    // Когда - двойной запуск
    Читатель.Запустить();
    Читатель.Запустить(); // повторный вызов должен быть безопасен

    // Тогда - без ошибок
    Ожидаем.Что(Истина).Равно(Истина);

    Читатель.Закрыть();

КонецПроцедуры

&Тест
Процедура ФоновыйПериодическийСбор() Экспорт

    // Дано - короткий интервал для быстрого срабатывания
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерМетрик"));
    Читатель = Новый ОтелПериодическийЧитательМетрик(МокЭкспортер, 100);

    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("test-lib", "1.0");
    Метрика = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);
    Счетчик = Метрика.СоздатьСчетчик("test.counter");
    Счетчик.Добавить(5);
    Читатель.ДобавитьМетр(Метрика);

    // Когда - запускаем фоновый сбор и ждем
    Читатель.Запустить();
    Приостановить(300);

    // Тогда - закрываем, фоновый сбор должен остановиться
    Читатель.Закрыть();
    Ожидаем.Что(Истина).Равно(Истина);

КонецПроцедуры

// Shutdown SHOULD укладываться в таймаут: фоновое задание, ждущее интервал сбора,
// останавливается сразу, а не по истечении интервала

&Тест
Процедура ЗакрытьНеЖдетИнтервалФоновогоСбора() Экспорт

    // Дано - фоновый сбор ждет длинный интервал
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерМетрик"));
    Читатель = Новый ОтелПериодическийЧитательМетрик(МокЭкспортер, 60000);
    Читатель.Запустить();
    Приостановить(50);

    // Когда
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Результат = Читатель.Закрыть(5000);
    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;

    // Тогда
    Ожидаем.Что(Результат.ИстекТаймаут(), Результат.Описание()).ЭтоЛожь();
    Ожидаем.Что(ДлительностьМс < 2000, ДлительностьМс).ЭтоИстина();

КонецПроцедуры

// MetricReader Collect SHOULD сообщать, успешен ли сбор, завершился ли он сбоем или таймаутом:
// сбой и таймаут callback-а асинхронного инструмента и мульти-callback-а, таймаут продюсера

&ПараметризованныйТест
&ИсточникЗначение("callback-исключение|Ошибка")
&ИсточникЗначение("callback-таймаут|Таймаут")
&ИсточникЗначение("мульти-callback-исключение|Ошибка")
&ИсточникЗначение("мульти-callback-таймаут|Таймаут")
Процедура СбойCallbackОтражаетсяВРезультатеСбора(Случай) Экспорт

    // Дано - сбой|ожидаемый результат; метрики остальных инструментов собираются
    Части = СтрРазделить(Случай, "|");
    Транспорт = Новый ОтелВПамятьТранспорт();
    Читатель = Новый ОтелПериодическийЧитательМетрик(Новый ОтелЭкспортерМетрик(Транспорт));
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("test-lib", "1.0"), Новый ОтелРесурс(Истина));
    Метр.УстановитьТаймаутОбратныхВызововМс(200);
    Метр.СоздатьСчетчик("jobs").Добавить(1);
    ИмяМетода = ?(СтрЗаканчиваетсяНа(Части[0], "исключение"), "НаблюдатьСИсключением", "НаблюдатьДолго");
    Если СтрНачинаетсяС(Части[0], "мульти") Тогда
        Инструменты = Новый Массив();
        Инструменты.Добавить(Метр.СоздатьНаблюдаемыйДатчик("broken.gauge"));
        Метр.ЗарегистрироватьОбратныйВызов(Новый Действие(ЭтотОбъект, ИмяМетода), Инструменты);
    Иначе
        Метр.СоздатьНаблюдаемыйДатчик("broken.gauge", Новый Действие(ЭтотОбъект, ИмяМетода));
    КонецЕсли;
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Результат = Читатель.СброситьБуфер();

    // Тогда
    Ожидаем.Что(Транспорт.ПолучитьОтправленные().Количество()).Равно(1);
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
    Ожидаем.Что(Результат.ИстекТаймаут()).Равно(Части[1] = "Таймаут");

КонецПроцедуры

Процедура НаблюдатьСИсключением(Наблюдение) Экспорт // BSLLS:UnusedParameters-off
    ВызватьИсключение "Сбой callback-а";
КонецПроцедуры

Процедура НаблюдатьДолго(Наблюдение) Экспорт // BSLLS:UnusedParameters-off
    Приостановить(1000);
КонецПроцедуры

&Тест
Процедура ТаймаутПродюсераОтражаетсяВРезультатеСбора() Экспорт

    // Дано - продюсер сообщает о таймауте
    ТекстПродюсера = "
    |Функция Произвести(Ресурс) Экспорт
    |    Возврат Новый ОтелРезультатПроизводстваМетрик(""Timeout"", , ""тест: таймаут продюсера"");
    |КонецФункции";
    Читатель = Новый ОтелПериодическийЧитательМетрик(Новый ОтелЭкспортерМетрик(Новый ОтелВПамятьТранспорт()));
    Читатель.ДобавитьПродюсер(ЗагрузитьСценарийИзСтроки(ТекстПродюсера));

    // Когда
    Результат = Читатель.СброситьБуфер();

    // Тогда
    Ожидаем.Что(Результат.ИстекТаймаут()).ЭтоИстина();

КонецПроцедуры

// MeterProvider Shutdown и ForceFlush SHOULD укладываться в таймаут: сбор, который уже выполняется
// в другом потоке, ждут не дольше срока

&ПараметризованныйТест
&ИсточникЗначение("Закрыть")
&ИсточникЗначение("ПринудительноВыгрузитьСРезультатом")
Процедура СборДругогоПотокаЖдетсяНеДольшеСрока(Метод) Экспорт

    // Дано - сбор в фоновом задании экспортирует 3 секунды
    ТекстЭкспортера = "
    |Функция Экспортировать(Данные, Таймаут = Неопределено) Экспорт
    |    Приостановить(3000);
    |    Возврат Истина;
    |КонецФункции
    |Функция ПолучитьВременнуюАгрегацию(Тип) Экспорт
    |    Возврат ОтелВременнаяАгрегация.Кумулятивная();
    |КонецФункции
    |Функция СброситьБуфер(ТаймаутМс = 0) Экспорт
    |    Возврат ОтелРезультатыЭкспорта.Успех();
    |КонецФункции
    |Функция Закрыть(ТаймаутМс = 0) Экспорт
    |    Возврат ОтелРезультатыЗакрытия.Успех();
    |КонецФункции";
    Читатель = Новый ОтелПериодическийЧитательМетрик(ЗагрузитьСценарийИзСтроки(ТекстЭкспортера));
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("test-lib", "1.0"), Новый ОтелРесурс(Истина));
    Метр.СоздатьСчетчик("jobs").Добавить(1);
    Читатель.ДобавитьМетр(Метр);
    Параметры = Новый Массив();
    Параметры.Добавить(0);
    Задание = ФоновыеЗадания.Выполнить(Читатель, "СброситьБуфер", Параметры);
    Приостановить(300);

    // Когда
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Результат = Новый Действие(Читатель, Метод).Выполнить(500);
    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;

    // Тогда
    Задание.ОжидатьЗавершения();
    Ожидаем.Что(Результат.ИстекТаймаут(), Результат.Описание()).ЭтоИстина();
    Ожидаем.Что(ДлительностьМс < 2000, ДлительностьМс).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АгрегацияПоУмолчаниюВозвращаетКорректныеЗначения() Экспорт

    // Дано
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерМетрик"));
    Читатель = Новый ОтелПериодическийЧитательМетрик(МокЭкспортер);

    // Тогда
    Ожидаем.Что(Читатель.АгрегацияПоУмолчанию("Counter")).Равно("sum");
    Ожидаем.Что(Читатель.АгрегацияПоУмолчанию("UpDownCounter")).Равно("sum");
    Ожидаем.Что(Читатель.АгрегацияПоУмолчанию("Histogram")).Равно("explicit_bucket_histogram");
    Ожидаем.Что(Читатель.АгрегацияПоУмолчанию("Gauge")).Равно("last_value");
    Ожидаем.Что(Читатель.АгрегацияПоУмолчанию("ObservableCounter")).Равно("sum");
    Ожидаем.Что(Читатель.АгрегацияПоУмолчанию("ObservableUpDownCounter")).Равно("sum");
    Ожидаем.Что(Читатель.АгрегацияПоУмолчанию("ObservableGauge")).Равно("last_value");

КонецПроцедуры

&Тест
Процедура АгрегацияПоУмолчаниюНастраивается() Экспорт

    // Дано
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерМетрик"));
    Читатель = Новый ОтелПериодическийЧитательМетрик(МокЭкспортер);

    // Когда
    Читатель.УстановитьАгрегациюПоУмолчанию("Histogram", "base2_exponential_bucket_histogram");

    // Тогда
    Ожидаем.Что(Читатель.АгрегацияПоУмолчанию("Histogram")).Равно("base2_exponential_bucket_histogram");
    Ожидаем.Что(Читатель.АгрегацияГистограммПоУмолчанию()).Равно("base2_exponential_bucket_histogram");

КонецПроцедуры

&Тест
Процедура АгрегацияГистограммИзКонструктораОтражаетсяВСелекторе() Экспорт

    // Дано
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерМетрик"));

    // Когда
    Читатель = Новый ОтелПериодическийЧитательМетрик(
        МокЭкспортер, , , "base2_exponential_bucket_histogram");

    // Тогда
    Ожидаем.Что(Читатель.АгрегацияПоУмолчанию("Histogram")).Равно("base2_exponential_bucket_histogram");
    Ожидаем.Что(Читатель.АгрегацияПоУмолчанию("Counter")).Равно("sum");

КонецПроцедуры

&Тест
Процедура ЧитательНельзяЗарегистрироватьУДвухПровайдеров() Экспорт

    // Дано
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерМетрик"));
    Читатель = Новый ОтелПериодическийЧитательМетрик(МокЭкспортер);

    // Когда - первая регистрация успешна
    Результат1 = Читатель.ЗарегистрироватьУПровайдера();

    // Тогда
    Ожидаем.Что(Результат1).Равно(Истина);

    // Когда - вторая регистрация отклонена
    Результат2 = Читатель.ЗарегистрироватьУПровайдера();

    // Тогда
    Ожидаем.Что(Результат2).Равно(Ложь);

КонецПроцедуры

Функция СобратьЗначенияНаблюдаемого(Временность)
    КаталогТестовыхДанных = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Захватчик = ЗагрузитьСценарий(ОбъединитьПути(КаталогТестовыхДанных, "ЗахватчикЭкспорта.os"));
    Захватчик.УстановитьВременность(Временность);

    Наблюдатель = ЗагрузитьСценарий(ОбъединитьПути(КаталогТестовыхДанных, "ИнкрементныйНаблюдатель.os"));
    Наблюдатель.УстановитьШаг(100);

    Читатель = Новый ОтелПериодическийЧитательМетрик(Захватчик);

    Ресурс = Новый ОтелРесурс();
    Область = Новый ОтелОбластьИнструментирования("test-lib", "1.0");
    Метр = Новый ОтелМетр(Область, Ресурс);
    Действие = Новый Действие(Наблюдатель, "Наблюдать");
    Метр.СоздатьНаблюдаемыйСчетчик("async.counter", Действие);

    Читатель.ДобавитьМетр(Метр);

    Читатель.СброситьБуфер();
    Наблюдатель.УстановитьШаг(50);
    Читатель.СброситьБуфер();
    Наблюдатель.УстановитьШаг(25);
    Читатель.СброситьБуфер();

    Возврат Захватчик.ЗахваченныеЗначения;
КонецФункции

&Тест
Процедура НаблюдаемыйСчетчикКумулятивнаяВременностьПередаетАбсолютныеЗначения() Экспорт

    // Дано+Когда
    Захваченные = СобратьЗначенияНаблюдаемого(ОтелВременнаяАгрегация.Кумулятивная());

    // Тогда - cumulative reader получает абсолютные значения наблюдений
    Ожидаем.Что(Захваченные).ИмеетДлину(3);
    Ожидаем.Что(Захваченные[0][0]).Равно(100);
    Ожидаем.Что(Захваченные[1][0]).Равно(150);
    Ожидаем.Что(Захваченные[2][0]).Равно(175);

КонецПроцедуры

&Тест
Процедура НаблюдаемыйСчетчикДельтаВременностьВычисляетПриращения() Экспорт

    // Дано+Когда
    Захваченные = СобратьЗначенияНаблюдаемого(ОтелВременнаяАгрегация.Дельта());

    // Тогда - delta reader получает приращения относительно предыдущего наблюдения
    Ожидаем.Что(Захваченные).ИмеетДлину(3);
    Ожидаем.Что(Захваченные[0][0]).Равно(100);
    Ожидаем.Что(Захваченные[1][0]).Равно(50);
    Ожидаем.Что(Захваченные[2][0]).Равно(25);

