&Тест
Процедура ФорсФлашВозвращаетОшибкуЭкспортера() Экспорт

    // Дано - экспортер с ПринудительноВыгрузитьСРезультатом(), возвращающим ошибку
    ТекстЭкспортера = "
    |Функция Экспортировать(Данные, Таймаут = Неопределено) Экспорт
    |    Возврат Истина;
    |КонецФункции
    |Функция ПолучитьВременнуюАгрегацию(Тип) Экспорт
    |    Возврат ОтелВременнаяАгрегация.Кумулятивная();
    |КонецФункции
    |Функция СброситьБуфер(ТаймаутМс = 0) Экспорт
    |    Возврат ОтелРезультатыЭкспорта.Успех();
    |КонецФункции
    |Процедура Закрыть() Экспорт КонецПроцедуры
    |Функция ПринудительноВыгрузитьСРезультатом(ТаймаутМс = 0) Экспорт
    |    Возврат ОтелРезультатыЗакрытия.Ошибка(""тест: форсфлаш ошибка"");
    |КонецФункции";
    ЭкспортерСОшибкой = ЗагрузитьСценарийИзСтроки(ТекстЭкспортера);

    Читатель = Новый ОтелПериодическийЧитательМетрик(ЭкспортерСОшибкой);

    // Когда
    Результат = Читатель.ПринудительноВыгрузитьСРезультатом();

    // Тогда - форсфлаш экспортера вернул ошибку → читатель тоже возвращает ошибку
    Ожидаем.Что(Результат.Успешно()).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ЗакрытьЭкспортерБросает() Экспорт

    // Дано - экспортер, бросающий исключение в Закрыть (→ line 158 покрыта)
    ТекстЭкспортера = "
    |Функция Экспортировать(Данные, Таймаут = Неопределено) Экспорт
    |    Возврат Истина;
    |КонецФункции
    |Функция ПолучитьВременнуюАгрегацию(Тип) Экспорт
    |    Возврат ОтелВременнаяАгрегация.Кумулятивная();
    |КонецФункции
    |Процедура Закрыть() Экспорт
    |    ВызватьИсключение ""тест: ошибка закрытия"";
    |КонецПроцедуры";
    ЭкспортерБросающий = ЗагрузитьСценарийИзСтроки(ТекстЭкспортера);

    Читатель = Новый ОтелПериодическийЧитательМетрик(ЭкспортерБросающий);

    // Когда - Закрыть() бросает исключение в Экспортер.Закрыть()
    Результат = Читатель.Закрыть();

    // Тогда - исключение не выходит наружу, ошибка закрытия экспортера сообщена в результате
    // (Shutdown SHOULD сообщать об успехе, ошибке или таймауте), читатель закрыт
    Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
    Ожидаем.Что(СтрНайти(Результат.Описание(), "тест: ошибка закрытия") > 0, Результат.Описание()).ЭтоИстина();
    Ожидаем.Что(Читатель.Закрыть().Описание()).Равно("Reader закрыт");

КонецПроцедуры

&Тест
Процедура НаблюдаемыйСчетчикСАтрибутамиДельта() Экспорт

    // Дано - ObservableCounter с атрибутами и читатель с дельта-темпоральностью.
    // При сборе СформироватьКлючАтрибутов обходит OTLP-атрибуты (Соответствие),
    // покрывая ветки lines 521-523, 527.
    КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Захватчик = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "ЗахватчикЭкспорта.os"));
    Захватчик.УстановитьВременность(ОтелВременнаяАгрегация.Дельта());

    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("obs-lib", "1.0");
    Метр = Новый ОтелМетр(ОбластьИнструментирования, Ресурс);

    ТекстНаблюдателя = "
    |Процедура Наблюдать(Наблюдение) Экспорт
    |    Атрибуты = Новый ОтелАтрибуты();
    |    Атрибуты.Установить(""env"", ""prod"");
    |    Наблюдение.Записать(50, Атрибуты);
    |КонецПроцедуры";
    Наблюдатель = ЗагрузитьСценарийИзСтроки(ТекстНаблюдателя);
    Действие = Новый Действие(Наблюдатель, "Наблюдать");
    Метр.СоздатьНаблюдаемыйСчетчик("obs.with.attrs", Действие);

    Читатель = Новый ОтелПериодическийЧитательМетрик(Захватчик);
    Читатель.ДобавитьМетр(Метр);

    // Когда - первый сбор (абсолютное значение = дельта от 0)
    Читатель.СброситьБуфер();
    // Второй сбор (дельта = 0, т.к. значение не изменилось)
    Читатель.СброситьБуфер();

    // Тогда - два экспорта выполнены, атрибуты обработаны через ключ-формирование
    Ожидаем.Что(Захватчик.ЗахваченныеЗначения.Количество()).Равно(2);
    Ожидаем.Что(Захватчик.ЗахваченныеЗначения[0][0]).Равно(50);
    Ожидаем.Что(Захватчик.ЗахваченныеЗначения[1][0]).Равно(0);

КонецПроцедуры

&Тест
Процедура НаблюдаемыйСчетчикДельтаРазныеНаборыАтрибутовНеСмешиваются() Экспорт

    // Дано - ObservableCounter с двумя сериями (env=prod и env=dev) и дельта-читатель.
    // Значения растут между сборами: prod 10 -> 15, dev 100 -> 130.
    КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Захватчик = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "ЗахватчикЭкспорта.os"));
    Захватчик.УстановитьВременность(ОтелВременнаяАгрегация.Дельта());

    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("obs-lib", "1.0"), Новый ОтелРесурс(Истина));
    ТекстНаблюдателя = "
    |Перем Сбор Экспорт;
    |Процедура Наблюдать(Наблюдение) Экспорт
    |    Сбор = Сбор + 1;
    |    Прод = Новый ОтелАтрибуты();
    |    Прод.Установить(""env"", ""prod"");
    |    Наблюдение.Записать(?(Сбор = 1, 10, 15), Прод);
    |    Дев = Новый ОтелАтрибуты();
    |    Дев.Установить(""env"", ""dev"");
    |    Наблюдение.Записать(?(Сбор = 1, 100, 130), Дев);
    |КонецПроцедуры
    |Сбор = 0;";
    Наблюдатель = ЗагрузитьСценарийИзСтроки(ТекстНаблюдателя);
    Метр.СоздатьНаблюдаемыйСчетчик("obs.two.series", Новый Действие(Наблюдатель, "Наблюдать"));

    Читатель = Новый ОтелПериодическийЧитательМетрик(Захватчик);
    Читатель.ДобавитьМетр(Метр);

    // Когда - два сбора
    Читатель.СброситьБуфер();
    Читатель.СброситьБуфер();

    // Тогда - дельта каждой серии считается от ее собственного предыдущего значения
    Ожидаем.Что(Захватчик.ЗахваченныеЗначения.Количество()).Равно(2);
    Первый = Захватчик.ЗахваченныеЗначения[0];
    Второй = Захватчик.ЗахваченныеЗначения[1];
    Ожидаем.Что(Первый.Найти(10), "первый сбор prod").Не_().Равно(Неопределено);
    Ожидаем.Что(Первый.Найти(100), "первый сбор dev").Не_().Равно(Неопределено);
    Ожидаем.Что(Второй.Найти(5), "второй сбор prod").Не_().Равно(Неопределено);
    Ожидаем.Что(Второй.Найти(30), "второй сбор dev").Не_().Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ДубликатИнструментаДругогоВидаЭкспортируетсяОтдельнойМетрикой() Экспорт

    // Дано - гистограмма и счетчик с одним именем в одном метре
    Транспорт = Новый ОтелВПамятьТранспорт();
    Читатель = Новый ОтелПериодическийЧитательМетрик(Новый ОтелЭкспортерМетрик(Транспорт), 3600000);
    Провайдер = Новый ОтелПостроительПровайдераМетрик()
        .ЗарегистрироватьЧитатель(Читатель)
        .Построить();
    Метр = Провайдер.ПолучитьМетр("dup-lib");
    Гистограмма = Метр.СоздатьГистограмму("dup.metric", "", "ms");
    Счетчик = Метр.СоздатьСчетчик("dup.metric", "", "ms");

    // Когда
    Гистограмма.Записать(7);
    Счетчик.Добавить(3);
    Провайдер.СброситьБуфер();

    // Тогда - обе метрики экспортированы, каждая со своими данными
    Метрики = ЭкспортированныеМетрики(Транспорт);
    Ожидаем.Что(Метрики).ИмеетДлину(2);
    Ожидаем.Что(Метрики).Содержит("dup.metric|histogram|1");
    Ожидаем.Что(Метрики).Содержит("dup.metric|sum|3");

    Провайдер.Закрыть();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Единица")
&ИсточникЗначение("ВерсияМетра")
&ИсточникЗначение("АдресСхемыМетра")
&ИсточникЗначение("ИмяВДругомРегистре")
Процедура ПредставлениеПереименовываетПоКритериюСелектора(Критерий) Экспорт

    // Дано - View переименовывает метрику, селектор выбирает инструмент по одному критерию
    ИмяИнструмента = "Selected.Counter";
    Транспорт = Новый ОтелВПамятьТранспорт();
    Читатель = Новый ОтелПериодическийЧитательМетрик(Новый ОтелЭкспортерМетрик(Транспорт), 3600000);
    Селектор = СелекторПоКритерию(Критерий, ИмяИнструмента);
    Провайдер = Новый ОтелПостроительПровайдераМетрик()
        .ЗарегистрироватьЧитатель(Читатель)
        .ЗарегистрироватьПредставление(Селектор, Новый ОтелПредставление("renamed.metric"))
        .Построить();
    Метр = Провайдер.ПолучитьМетр("view-lib", "1.0.0", , "https://example.com/schema/1");
    Метр.СоздатьСчетчик(ИмяИнструмента, "", "ms").Добавить(5);

    // Когда
    Провайдер.СброситьБуфер();

    // Тогда - метрика экспортирована под новым именем
    Ожидаем.Что(ЭкспортированныеМетрики(Транспорт)).Содержит("renamed.metric|sum|5");

    Провайдер.Закрыть();

КонецПроцедуры

Функция СелекторПоКритерию(Критерий, ИмяИнструмента)
    Если Критерий = "Единица" Тогда
        Возврат Новый ОтелСелекторИнструментов(ИмяИнструмента, , , "ms");
    ИначеЕсли Критерий = "ВерсияМетра" Тогда
        Возврат Новый ОтелСелекторИнструментов(ИмяИнструмента, , , , "1.0.0");
    ИначеЕсли Критерий = "АдресСхемыМетра" Тогда
        Возврат Новый ОтелСелекторИнструментов(ИмяИнструмента, , , , , "https://example.com/schema/1");
    Иначе
        Возврат Новый ОтелСелекторИнструментов(НРег(ИмяИнструмента));
    КонецЕсли;
КонецФункции

// Описания экспортированных OTLP-метрик в виде "имя|тип|значение первой точки"
// (для гистограммы - count).
Функция ЭкспортированныеМетрики(Транспорт)
    Результат = Новый Массив();
    Для Каждого Отправка Из Транспорт.ПолучитьОтправленные() Цикл
        Для Каждого РесурсныеМетрики Из Отправка.Получить("Данные").Получить("resourceMetrics") Цикл
            Для Каждого МетрикиОбласти Из РесурсныеМетрики.Получить("scopeMetrics") Цикл
                Для Каждого Метрика Из МетрикиОбласти.Получить("metrics") Цикл
                    Результат.Добавить(ОписаниеМетрики(Метрика));
                КонецЦикла;
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ОписаниеМетрики(Метрика)
    Имя = Метрика.Получить("name");
    Если Метрика.Получить("sum") <> Неопределено Тогда
        Точка = Метрика.Получить("sum").Получить("dataPoints")[0];
        Значение = Точка.Получить("asInt");
        Если Значение = Неопределено Тогда
            Значение = Точка.Получить("asDouble");
        КонецЕсли;
        Возврат СтрШаблон("%1|sum|%2", Имя, Значение);
    КонецЕсли;
    Если Метрика.Получить("histogram") <> Неопределено Тогда
        Точка = Метрика.Получить("histogram").Получить("dataPoints")[0];
        Возврат СтрШаблон("%1|histogram|%2", Имя, Точка.Получить("count"));
    КонецЕсли;
    Возврат Имя;
КонецФункции

&Тест
Процедура ПринудительноВыгрузитьУспешноБезЭкспортера() Экспорт

    // Дано - читатель без экспортера (Неопределено) и без метров
    Читатель = Новый ОтелПериодическийЧитательМетрик(Неопределено);

    // Когда - форсфлаш без экспортера и пустого буфера
    Результат = Читатель.ПринудительноВыгрузитьСРезультатом();

    // Тогда - успешно (нечего экспортировать, нет экспортера)
    Ожидаем.Что(Результат.Успешно()).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ПринудительноВыгрузитьСЭкспортеромБросающимИсключение() Экспорт

    // Дано - ForceFlush экспортера бросает исключение
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерМетрик"));
    МокЭкспортер.Когда()
        .ПринудительноВыгрузитьСРезультатом(Матчеры.ЛюбоеЗначение())
        .ТогдаВыбрасываетИсключение("форс-флаш недоступен");
    Читатель = Новый ОтелПериодическийЧитательМетрик(МокЭкспортер);

    // Когда - форсфлаш без метров (буфер пуст)
    Результат = Читатель.ПринудительноВыгрузитьСРезультатом();

    // Тогда - сбой ForceFlush экспортера сообщается ошибкой
    Ожидаем.Что(Результат.Успешно()).Равно(Ложь);
    Ожидаем.Что(СтрНайти(Результат.Описание(), "форс-флаш недоступен") > 0, Результат.Описание()).ЭтоИстина();

    Читатель.Закрыть();

КонецПроцедуры

&Тест
Процедура ПринудительноВыгрузитьВызываетСброситьБуферЭкспортераИнтерфейса() Экспорт

    // Дано - экспортер реализует только ИнтерфейсЭкспортерМетрик
    Экспортер = ЭкспортерИнтерфейса(Истина);
    Читатель = Новый ОтелПериодическийЧитательМетрик(Экспортер);

    // Когда
    Результат = Читатель.ПринудительноВыгрузитьСРезультатом(5000);

    // Тогда - ForceFlush экспортера - метод интерфейса СброситьБуфер с оставшимся временем
    Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
    Ожидаем.Что(Экспортер.СбросВызван).ЭтоИстина();
    Ожидаем.Что(Экспортер.ПереданныйТаймаутСброса > 0 И Экспортер.ПереданныйТаймаутСброса <= 5000,
        Экспортер.ПереданныйТаймаутСброса).ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Ложь")
&ИсточникЗначение("ОшибкаЭкспорта")
&ИсточникЗначение("ТаймаутЭкспорта")
&ИсточникЗначение("исключение")
Процедура ПринудительноВыгрузитьСообщаетСбойСбросаЭкспортера(Случай) Экспорт

    // Дано - СброситьБуфер экспортера сообщает о сбое
    Если Случай = "Ложь" Тогда
        РезультатСброса = Ложь;
    ИначеЕсли Случай = "ОшибкаЭкспорта" Тогда
        РезультатСброса = ОтелРезультатыЭкспорта.Ошибка();
    ИначеЕсли Случай = "ТаймаутЭкспорта" Тогда
        РезультатСброса = ОтелРезультатыЭкспорта.Таймаут();
    Иначе
        РезультатСброса = Случай;
    КонецЕсли;
    Читатель = Новый ОтелПериодическийЧитательМетрик(ЭкспортерИнтерфейса(РезультатСброса));

    // Когда
    Результат = Читатель.ПринудительноВыгрузитьСРезультатом(5000);

    // Тогда
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПринудительноВыгрузитьПослеИстеченияСрокаПередаетЭкспортеруОграниченныйТаймаут() Экспорт

    // Дано - экспорт занимает больше срока ForceFlush
    Экспортер = ЭкспортерИнтерфейса(Истина, 200);
    Читатель = Новый ОтелПериодическийЧитательМетрик(Экспортер);
    Метр = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("slow-lib", "1.0"), Новый ОтелРесурс(Истина));
    Счетчик = Метр.СоздатьСчетчик("slow.counter");
    Счетчик.Добавить(1);
    Читатель.ДобавитьМетр(Метр);

    // Когда
    Результат = Читатель.ПринудительноВыгрузитьСРезультатом(50);

    // Тогда - ForceFlush экспортера вызван и после истечения срока, но не без ограничения
    Ожидаем.Что(Результат.ИстекТаймаут()).ЭтоИстина();
    Ожидаем.Что(Экспортер.СбросВызван).ЭтоИстина();
    Ожидаем.Что(Экспортер.ПереданныйТаймаутСброса).Равно(1);

КонецПроцедуры

// Metrics SDK / Periodic exporting MetricReader: exportTimeoutMillis ограничивает Export,
// Export MUST NOT блокироваться бесконечно

&Тест
Процедура ТаймаутЭкспортаПоУмолчанию30Секунд() Экспорт

    // Дано
    Читатель = Новый ОтелПериодическийЧитательМетрик(Мок.Получить(Тип("ОтелЭкспортерМетрик")));

    // Когда
    Таймаут = Читатель.ТаймаутЭкспортаМс();

    // Тогда
    Ожидаем.Что(Таймаут).Равно(30000);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("0|1234|1234")
&ИсточникЗначение("5000|1000|1000")
&ИсточникЗначение("500|1000|500")
Процедура ЭкспортОграниченТаймаутомЭкспорта(Случай) Экспорт

    // Дано - таймаут сброса|таймаут экспорта читателя|ожидаемый таймаут Export
    Части = СтрРазделить(Случай, "|");
    КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Захватчик = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "ЗахватчикТаймаута.os"));
    Читатель = ЧитательСоСчетчиком(Захватчик);
    Читатель.УстановитьТаймаутЭкспортаМс(Число(Части[1]));

    // Когда
    Читатель.СброситьБуфер(Число(Части[0]));

    // Тогда - Export получает меньший из сроков, а без срока сброса - таймаут экспорта;
    // от срока сброса к экспорту остается время за вычетом сбора
    Ожидаемый = Число(Части[2]);
    Ожидаем.Что(Захватчик.ЗахваченныйТаймаут).Между(Ожидаемый - 100, Ожидаемый);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Ложь")
&ИсточникЗначение("Таймаут")
Процедура СброситьБуферСообщаетТаймаутЭкспорта(Случай) Экспорт

    // Дано - экспорт не уложился в таймаут: вернул Ложь после истечения срока или таймаут
    РезультатЭкспорта = ?(Случай = "Ложь", Ложь, ОтелРезультатыЭкспорта.Таймаут());
    Экспортер = ЭкспортерСРезультатом(РезультатЭкспорта, 100);
    Читатель = ЧитательСоСчетчиком(Экспортер);

    // Когда
    Результат = Читатель.СброситьБуфер(20);

    // Тогда
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
    Ожидаем.Что(Результат.ИстекТаймаут()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СброситьБуферСообщаетОшибкуЭкспортаВСрок() Экспорт

    // Дано - экспорт сразу вернул ошибку
    Читатель = ЧитательСоСчетчиком(ЭкспортерСРезультатом(ОтелРезультатыЭкспорта.Ошибка(), 0));

    // Когда
    Результат = Читатель.СброситьБуфер(5000);

    // Тогда - ошибка, а не таймаут
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
    Ожидаем.Что(Результат.ИстекТаймаут()).ЭтоЛожь();

КонецПроцедуры

// Metrics SDK / Periodic exporting MetricReader: maxExportBatchSize

&Тест
Процедура МаксРазмерПакетаПоУмолчаниюБезОграничения() Экспорт

    // Дано
    Читатель = Новый ОтелПериодическийЧитательМетрик(Мок.Получить(Тип("ОтелЭкспортерМетрик")));

    // Когда
    Размер = Читатель.МаксРазмерПакетаЭкспорта();

    // Тогда
    Ожидаем.Что(Размер).Равно(0);

КонецПроцедуры

&Тест
Процедура МаксРазмерПакетаРазбиваетСборНаПолныеПакеты() Экспорт

    // Дано - шесть точек: пять серий счетчика и датчик; в пакете не больше четырех точек
    Экспортер = ЗахватчикДанных();
    Читатель = Новый ОтелПериодическийЧитательМетрик(Экспортер);
    Читатель.УстановитьМаксРазмерПакетаЭкспорта(4);
    Читатель.ДобавитьМетр(МетрСШестьюТочками());

    // Когда
    Результат = Читатель.СброситьБуфер();

    // Тогда - полный пакет из четырех точек счетчика, затем его последняя точка и датчик
    Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
    Ожидаем.Что(Экспортер.Экспорты.Количество()).Равно(2);
    Первый = Экспортер.Экспорты[0];
    Второй = Экспортер.Экспорты[1];
    Ожидаем.Что(Первый.Количество()).Равно(1);
    Ожидаем.Что(Первый[0].Имя()).Равно("batched.counter");
    Ожидаем.Что(Первый[0].ТочкиДанных().Количество()).Равно(4);
    Ожидаем.Что(Второй.Количество()).Равно(2);
    Ожидаем.Что(Второй[0].Имя()).Равно("batched.counter");
    Ожидаем.Что(Второй[0].ТочкиДанных().Количество()).Равно(1);
    Ожидаем.Что(Второй[0].ВременнаяАгрегация()).Равно(Первый[0].ВременнаяАгрегация());
    Ожидаем.Что(Второй[1].Имя()).Равно("batched.gauge");

КонецПроцедуры

&Тест
Процедура БезМаксРазмераПакетаСборЭкспортируетсяОднимВызовом() Экспорт

    // Дано
    Экспортер = ЗахватчикДанных();
    Читатель = Новый ОтелПериодическийЧитательМетрик(Экспортер);
    Читатель.ДобавитьМетр(МетрСШестьюТочками());

    // Когда
    Читатель.СброситьБуфер();

    // Тогда
    Ожидаем.Что(Экспортер.Экспорты.Количество()).Равно(1);
    Ожидаем.Что(Экспортер.Экспорты[0].Количество()).Равно(2);

КонецПроцедуры

Функция ЗахватчикДанных()
    КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Возврат ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "ЗахватчикДанныхМетрик.os"));
КонецФункции

Функция МетрСШестьюТочками()
    Метрика = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("batch-lib", "1.0"), Новый ОтелРесурс(Истина));
    Счетчик = Метрика.СоздатьСчетчик("batched.counter");
    Для Номер = 1 По 5 Цикл
        Атрибуты = Новый ОтелАтрибуты();
        Атрибуты.Установить("n", Номер);
        Счетчик.Добавить(Номер, Атрибуты);
    КонецЦикла;
    Датчик = Метрика.СоздатьДатчик("batched.gauge");
    Датчик.Записать(7);
    Возврат Метрика;
КонецФункции

Функция ЭкспортерСРезультатом(РезультатЭкспорта, ЗадержкаМс)
    Текст = "Перем РезультатЭкспорта Экспорт;
    |Перем ЗадержкаМс Экспорт;
    |Функция Экспортировать(МассивДанных, ТаймаутМс = 0) Экспорт
    |    Если ЗадержкаМс > 0 Тогда
    |        Приостановить(ЗадержкаМс);
    |    КонецЕсли;
    |    Возврат РезультатЭкспорта;
    |КонецФункции
    |Функция СброситьБуфер(ТаймаутМс = 0) Экспорт
    |    Возврат Истина;
    |КонецФункции
    |Функция Закрыть() Экспорт
    |    Возврат Истина;
    |КонецФункции";
    Экспортер = ЗагрузитьСценарийИзСтроки(Текст);
    Экспортер.РезультатЭкспорта = РезультатЭкспорта;
    Экспортер.ЗадержкаМс = ЗадержкаМс;
    Возврат Экспортер;
КонецФункции

Функция ЭкспортерИнтерфейса(РезультатСброса, ЗадержкаЭкспортаМс = 0)
    Текст = "Перем РезультатСброса Экспорт;
    |Перем ЗадержкаЭкспортаМс Экспорт;
    |Перем ПереданныйТаймаутСброса Экспорт;
    |Перем СбросВызван Экспорт;
    |Функция Экспортировать(МассивДанных, ТаймаутМс = 0) Экспорт
    |    Если ЗадержкаЭкспортаМс > 0 Тогда
    |        Приостановить(ЗадержкаЭкспортаМс);
    |    КонецЕсли;
    |    Возврат Истина;
    |КонецФункции
    |Функция СброситьБуфер(ТаймаутМс = 0) Экспорт
    |    СбросВызван = Истина;
    |    ПереданныйТаймаутСброса = ТаймаутМс;
    |    Если РезультатСброса = ""исключение"" Тогда
    |        ВызватьИсключение ""сбой сброса экспортера"";
    |    КонецЕсли;
    |    Возврат РезультатСброса;
    |КонецФункции
    |Функция Закрыть() Экспорт
    |    Возврат Истина;
    |КонецФункции
    |СбросВызван = Ложь;";
    Экспортер = ЗагрузитьСценарийИзСтроки(Текст);
    Экспортер.РезультатСброса = РезультатСброса;
    Экспортер.ЗадержкаЭкспортаМс = ЗадержкаЭкспортаМс;
    Возврат Экспортер;
КонецФункции

// Экспортер, задающий агрегацию по умолчанию одному виду инструмента.
Функция ЭкспортерСАгрегацией(Вид, Агрегация)
    Текст = "Перем Вид Экспорт;
    |Перем Агрегация Экспорт;
    |Функция Экспортировать(МассивДанных, ТаймаутМс = 0) Экспорт
    |    Возврат Истина;
    |КонецФункции
    |Функция Закрыть() Экспорт
    |    Возврат Истина;
    |КонецФункции
    |Функция АгрегацияПоУмолчанию(ВидИнструмента) Экспорт
    |    Возврат ?(ВидИнструмента = Вид, Агрегация, Неопределено);
    |КонецФункции";
    Экспортер = ЗагрузитьСценарийИзСтроки(Текст);
    Экспортер.Вид = Вид;
    Экспортер.Агрегация = Агрегация;
    Возврат Экспортер;
КонецФункции

// MetricReader: агрегация по умолчанию SHOULD браться у экспортера; вид, которому экспортер
// агрегацию не задал, получает агрегацию по умолчанию
&Тест
Процедура АгрегацияПоУмолчаниюБеретсяУЭкспортера() Экспорт

    // Дано - экспортер задает счетчикам drop
    Читатель = Новый ОтелПериодическийЧитательМетрик(ЭкспортерСАгрегацией("Counter", "drop"));

    // Тогда
    Ожидаем.Что(Читатель.АгрегацияПоУмолчанию("Counter")).Равно("drop");
    Ожидаем.Что(Читатель.АгрегацияПоУмолчанию("Gauge")).Равно("last_value");

КонецПроцедуры

// Агрегация, заданная читателю явно, приоритетнее агрегации экспортера
&Тест
Процедура ЯвнаяАгрегацияЧитателяПриоритетнееЭкспортера() Экспорт

    // Дано - экспортер задает гистограммам drop
    Читатель = Новый ОтелПериодическийЧитательМетрик(ЭкспортерСАгрегацией("Histogram", "drop"), , ,
        "base2_exponential_bucket_histogram");

    // Тогда
    Ожидаем.Что(Читатель.АгрегацияПоУмолчанию("Histogram")).Равно("base2_exponential_bucket_histogram");
    Ожидаем.Что(Читатель.АгрегацияГистограммПоУмолчанию()).Равно("base2_exponential_bucket_histogram");

КонецПроцедуры

&Тест
Процедура ПринудительноВыгрузитьСЭкспортеромВозвращающимУспех() Экспорт

    // Дано - экспортер возвращает успех при ПринудительноВыгрузитьСРезультатом (строки 685, 691)
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерМетрик"));
    МокЭкспортер.Когда()
        .ПринудительноВыгрузитьСРезультатом(Матчеры.ЛюбоеЗначение())
        .ТогдаВозвращает(ОтелРезультатыЗакрытия.Успех());
    Читатель = Новый ОтелПериодическийЧитательМетрик(МокЭкспортер);

    // Когда - форсфлаш без метров (буфер пуст)
    Результат = Читатель.ПринудительноВыгрузитьСРезультатом();

    // Тогда - успех: ЭкспортерВернулОшибку=Ложь (т.к. Успешно=Истина), ТекущийРезультат остаётся Неопределено
    Ожидаем.Что(Результат.Успешно()).Равно(Истина);

    Читатель.Закрыть();

КонецПроцедуры

// Metrics SDK / Shutdown: SHOULD укладываться в таймаут и сообщать об успехе, ошибке
// или таймауте - финальный экспорт ограничен оставшимся временем, его сбой в результате

&Тест
Процедура ЗакрытьОграничиваетФинальныйЭкспортОставшимсяВременем() Экспорт

    // Дано
    КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Захватчик = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "ЗахватчикТаймаута.os"));
    Читатель = ЧитательСоСчетчиком(Захватчик);

    // Когда
    Результат = Читатель.Закрыть(5000);

    // Тогда
    Ожидаем.Что(Результат.Успешно(), Результат.Описание()).ЭтоИстина();
    Ожидаем.Что(Захватчик.ЗахваченныйТаймаут > 0 И Захватчик.ЗахваченныйТаймаут <= 5000,
        Захватчик.ЗахваченныйТаймаут).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗакрытьСообщаетОшибкуФинальногоЭкспорта() Экспорт

    // Дано - экспортер сообщает о сбое результатом Ложь
    Экспортер = ЗагрузитьСценарийИзСтроки(
        "Функция Экспортировать(МассивДанныхМетрик, Таймаут = Неопределено) Экспорт
        |    Возврат Ложь;
        |КонецФункции
        |Функция ПолучитьВременнуюАгрегацию(ТипИнструмента) Экспорт
        |    Возврат ОтелВременнаяАгрегация.Кумулятивная();
        |КонецФункции
        |Функция СброситьБуфер(ТаймаутМс = 0) Экспорт
        |    Возврат ОтелРезультатыЭкспорта.Успех();
        |КонецФункции
        |Процедура Закрыть() Экспорт
        |КонецПроцедуры");
    Читатель = ЧитательСоСчетчиком(Экспортер);

    // Когда
    Результат = Читатель.Закрыть(5000);

    // Тогда
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();

КонецПроцедуры

// MetricReader ForceFlush и Shutdown SHOULD complete or abort within some timeout: срок сброса
// ограничивает и callback-и сбора, а не только их собственный таймаут
&Тест
Процедура СброситьБуферОграничиваетCallbackиСроком() Экспорт

    // Дано - callback выполняется 2 с при таймауте callback-ов метра 30 с
    КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Захватчик = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "ЗахватчикТаймаута.os"));
    Читатель = ЧитательСМедленнымCallback(Захватчик, 2000);

    // Когда - сброс со сроком 200 мс
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Результат = Читатель.СброситьБуфер(200);
    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;

    // Тогда - сброс не ждал callback дольше срока и сообщил о таймауте
    Ожидаем.Что(ДлительностьМс, "длительность сброса, мс").Меньше(1500);
    Ожидаем.Что(Результат.ИстекТаймаут(), "таймаут сброса").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СброситьБуферПередаетЭкспортуОстатокСрокаПослеСбора() Экспорт

    // Дано - сбор занимает 500 мс
    КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Захватчик = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "ЗахватчикТаймаута.os"));
    Читатель = ЧитательСМедленнымCallback(Захватчик, 500);

    // Когда
    Читатель.СброситьБуфер(5000);

    // Тогда - экспорт получил срок за вычетом сбора
    Ожидаем.Что(Захватчик.ЗахваченныйТаймаут).Между(3500, 4600);

КонецПроцедуры

&Тест
Процедура ПродюсерНеВызываетсяПослеСрокаСброса() Экспорт

    // Дано - callback метра занимает весь срок, продюсер считает вызовы
    КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Захватчик = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "ЗахватчикТаймаута.os"));
    Читатель = ЧитательСМедленнымCallback(Захватчик, 2000);
    Продюсер = ЗагрузитьСценарийИзСтроки("Перем Вызовы Экспорт;
    |Функция Произвести(Ресурс) Экспорт
    |    Вызовы = Вызовы + 1;
    |    Возврат Новый ОтелРезультатПроизводстваМетрик();
    |КонецФункции
    |Вызовы = 0;");
    Читатель.ДобавитьПродюсер(Продюсер);

    // Когда
    Результат = Читатель.СброситьБуфер(200);

    // Тогда - продюсер не вызван, сбор сообщил о таймауте
    Ожидаем.Что(Продюсер.Вызовы).Равно(0);
    Ожидаем.Что(Результат.ИстекТаймаут(), "таймаут сброса").ЭтоИстина();

КонецПроцедуры

Функция ЧитательСоСчетчиком(Экспортер)
    Метрика = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("test-lib", "1.0"), Новый ОтелРесурс(Истина));
    Метрика.СоздатьСчетчик("test.counter").Добавить(1);
    Читатель = Новый ОтелПериодическийЧитательМетрик(Экспортер);
    Читатель.ДобавитьМетр(Метрика);
    Возврат Читатель;
КонецФункции

Функция ЧитательСМедленнымCallback(Экспортер, ЗадержкаМс)
    Метрика = Новый ОтелМетр(Новый ОтелОбластьИнструментирования("test-lib", "1.0"), Новый ОтелРесурс(Истина));
    Метрика.СоздатьНаблюдаемыйДатчик("slow.gauge").ДобавитьCallback(
        Новый Действие(ЭтотОбъект, "НаблюдатьМедленно"), ЗадержкаМс);
    Читатель = Новый ОтелПериодическийЧитательМетрик(Экспортер);
    Читатель.ДобавитьМетр(Метрика);
    Возврат Читатель;
КонецФункции

Процедура НаблюдатьМедленно(Наблюдение, ЗадержкаМс) Экспорт
    Приостановить(ЗадержкаМс);
    Наблюдение.Записать(1);
КонецПроцедуры
