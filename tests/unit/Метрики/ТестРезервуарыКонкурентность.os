// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать "../../.."
#Использовать asserts

// Metrics SDK / Concurrency requirements: все методы ExemplarReservoir безопасны для
// конкурентного вызова

// Резервуар, общий для теста и фоновых заданий
Перем Резервуар;

&ПараметризованныйТест
&ИсточникЗначение("простой")
&ИсточникЗначение("выровненный")
Процедура СборИОчисткаВоВремяПредложенийБезОшибок(Случай) Экспорт

    // Дано - фоновые задания предлагают измерения в резервуар
    Резервуар = НовыйРезервуар(Случай);
    Задания = ЗапуститьПредложения(3);

    // Когда - одновременно резервуар собирается и очищается
    Ошибки = Новый Массив();
    Для Итерация = 1 По 1500 Цикл
        ПрочитатьСобранное(Ошибки, Итерация);
    КонецЦикла;
    ФоновыеЗадания.ОжидатьВсе(Задания);

    // Тогда - ни сбор, ни предложения не падают, размер резервуара не превышен
    Для Каждого Задание Из Задания Цикл
        Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
            Ошибки.Добавить(Задание.ИнформацияОбОшибке.Описание);
        КонецЕсли;
    КонецЦикла;
    Ожидаем.Что(Ошибки.Количество(), СтрСоединить(Ошибки, Символы.ПС)).Равно(0);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("простой")
&ИсточникЗначение("выровненный")
Процедура СобратьВозвращаетСнимок(Случай) Экспорт

    // Дано - собраны экземпляры резервуара с одним измерением
    Резервуар = НовыйРезервуар(Случай);
    Резервуар.Предложить("k", 1);
    Собранные = Резервуар.Собрать("k");

    // Когда - после сбора предлагаются новые измерения
    Для Значение = 2 По 20 Цикл
        Резервуар.Предложить("k", Значение);
    КонецЦикла;

    // Тогда - собранный массив не меняется
    Ожидаем.Что(Собранные.Количество()).Равно(1);
    Ожидаем.Что(Собранные[0].Получить("asDouble")).Равно(1);

КонецПроцедуры

// Выполняется фоновыми заданиями: предлагает измерения в общий резервуар.
//
Процедура Предлагать(НомерЗадания) Экспорт
    Для Номер = 1 По 2000 Цикл
        Резервуар.Предложить("k", (Номер + НомерЗадания) % 20);
    КонецЦикла;
КонецПроцедуры

Функция НовыйРезервуар(Вид)
    Если Вид = "выровненный" Тогда
        Границы = Новый Массив();
        Для Граница = 1 По 19 Цикл
            Границы.Добавить(Граница);
        КонецЦикла;
        Возврат Новый ОтелВыровненныйРезервуарГистограммы(Границы);
    КонецЕсли;
    Возврат Новый ОтелРезервуарЭкземпляров(5);
КонецФункции

Функция ЗапуститьПредложения(Заданий)
    Задания = Новый Массив();
    Для НомерЗадания = 1 По Заданий Цикл
        Параметры = Новый Массив();
        Параметры.Добавить(НомерЗадания);
        Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "Предлагать", Параметры);
        Задания.Добавить(Задание);
    КонецЦикла;
    Возврат Задания;
КонецФункции

Процедура ПрочитатьСобранное(Ошибки, Итерация)
    Попытка
        Экземпляры = Резервуар.Собрать("k");
        Если ЧислоЗначений(Экземпляры) > Резервуар.МаксРазмер() Тогда
            Ошибки.Добавить("превышен размер резервуара");
        КонецЕсли;
        Если Итерация % 500 = 0 Тогда
            Резервуар.Очистить();
        КонецЕсли;
    Исключение
        Ошибки.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
КонецПроцедуры

// Обходит собранные экземпляры: обход падает, если резервуар отдал массив, который
// меняется конкурентными предложениями.
//
Функция ЧислоЗначений(Экземпляры)
    Число = 0;
    Для Каждого Экземпляр Из Экземпляры Цикл
        Если Экземпляр.Получить("asDouble") <> Неопределено Тогда
            Число = Число + 1;
        КонецЕсли;
    КонецЦикла;
    Возврат Число;
КонецФункции
