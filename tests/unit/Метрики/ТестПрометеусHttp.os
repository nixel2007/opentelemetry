#Использовать "../../.."
#Использовать asserts

// HTTP-сервер Prometheus-экспортера: разбор запроса, ответ и ограничение клиентов хостом

&Тест
Процедура РазборЗапроса() Экспорт

    // Дано
    ВКПС = Символы.ВК + Символы.ПС;
    Текст = "GET /metrics?name[]=x HTTP/1.1" + ВКПС
        + "Host: localhost:9464" + ВКПС
        + "Accept: text/plain;version=0.0.4" + ВКПС
        + ВКПС;

    // Когда
    Запрос = ОтелПрометеусHttp.РазобратьЗапрос(Текст);

    // Тогда - путь без строки запроса, имена заголовков в нижнем регистре
    Ожидаем.Что(Запрос.Метод).Равно("GET");
    Ожидаем.Что(Запрос.Путь).Равно("/metrics");
    Ожидаем.Что(Запрос.Заголовки.Получить("accept")).Равно("text/plain;version=0.0.4");

КонецПроцедуры

&Тест
Процедура ОтветСДлинойТелаВБайтах() Экспорт

    // Дано - тело с кириллицей: длина в байтах UTF-8 больше длины строки
    ВКПС = Символы.ВК + Символы.ПС;
    Тело = "метрика 1" + Символы.ПС;

    // Когда
    Ответ = ПолучитьСтрокуИзДвоичныхДанных(ОтелПрометеусHttp.ОтветHttp(200, "text/plain", Тело), "UTF-8");

    // Тогда
    Ожидаем.Что(Ответ).Равно("HTTP/1.1 200 OK" + ВКПС
        + "Content-Type: text/plain" + ВКПС
        + "Content-Length: 17" + ВКПС
        + "Connection: close" + ВКПС
        + ВКПС
        + Тело);

КонецПроцедуры

&Тест
Процедура ОтветНаHeadБезТела() Экспорт

    // Дано
    ВКПС = Символы.ВК + Символы.ПС;

    // Когда
    Ответ = ПолучитьСтрокуИзДвоичныхДанных(ОтелПрометеусHttp.ОтветHttp(200, "text/plain", "abc", Истина), "UTF-8");

    // Тогда - длина тела указана, само тело не передается
    Ожидаем.Что(Ответ).Равно("HTTP/1.1 200 OK" + ВКПС
        + "Content-Type: text/plain" + ВКПС
        + "Content-Length: 3" + ВКПС
        + "Connection: close" + ВКПС
        + ВКПС);

КонецПроцедуры

// Prometheus Exporter / Host: host - адрес, на котором отдаются метрики. TCPСервер OneScript
// принимает подключения на всех интерфейсах, поэтому локальный хост ограничивает клиентов
// локальными адресами

&ПараметризованныйТест
&ИсточникЗначение("localhost|127.0.0.1:5000|Истина")
&ИсточникЗначение("localhost|192.0.2.2:5000|Ложь")
&ИсточникЗначение("127.0.0.1|10.1.2.3:5000|Ложь")
&ИсточникЗначение("localhost|[::1]:5000|Истина")
&ИсточникЗначение("localhost|[::ffff:127.0.0.1]:5000|Истина")
&ИсточникЗначение("0.0.0.0|192.0.2.2:5000|Истина")
&ИсточникЗначение("|192.0.2.2:5000|Истина")
&ИсточникЗначение("metrics.example|192.0.2.2:5000|Истина")
Процедура КлиентРазрешенПоХосту(Случай) Экспорт

    // Дано - хост|адрес клиента|разрешен ли клиент
    Части = СтрРазделить(Случай, "|");

    // Когда
    Разрешен = ОтелПрометеусHttp.КлиентРазрешен(Части[0], Части[1]);

    // Тогда
    Ожидаем.Что(Разрешен).Равно(Части[2] = "Истина");

КонецПроцедуры
