КонецПроцедуры

&Тест
Процедура РезервуарПредставленияНеФабрикаОтклоняется() Экспорт

    // Дано - во View передан резервуар, а не фабрика резервуаров
    Контекст = НовыйКонтекст();
    ДобавитьПредставление(Контекст, "c",
        Новый ОтелПредставление("renamed", , , , , , Новый ОтелРезервуарЭкземпляров(1)));

    // Когда
    Записи = ОтелПотокиМетрик.СоздатьХранилища(Контекст, Дескриптор("c", "Counter"));

    // Тогда - остальные настройки View применяются, резервуар - по умолчанию
    Ожидаем.Что(Записи[0].Хранилище.Имя()).Равно("renamed");
    Контекст.Лог.ПроверитьЧтоВызывалсяМетод().Ошибка(Матчеры.Содержит("фабрик"));

КонецПроцедуры

&Тест
Процедура ХранилищаНеизменныхПотоковСохраняются() Экспорт

    // Дано
    Контекст = НовыйКонтекст();
    Первое = Новый ОтелПредставление("x1");
    ДобавитьПредставление(Контекст, "c", Первое);
    Текущие = ОтелПотокиМетрик.СоздатьХранилища(Контекст, Дескриптор("c", "Counter"));

    // Когда - зарегистрирован еще один View
    ДобавитьПредставление(Контекст, "c", Новый ОтелПредставление("x2"));
    Новые = ОтелПотокиМетрик.СоздатьХранилища(Контекст, Дескриптор("c", "Counter"), Текущие);

    // Тогда
    Ожидаем.Что(Новые).ИмеетДлину(2);
    Ожидаем.Что(Новые[0].Хранилище = Текущие[0].Хранилище, "хранилище x1 сохранено").ЭтоИстина();
    Ожидаем.Что(Новые[1].Хранилище.Имя()).Равно("x2");

КонецПроцедуры

&Тест
Процедура ХранилищеПересоздаетсяПриИзмененииЗаписиМинМакс() Экспорт

    // Дано - агрегация гистограмм читателя записывает min и max
    Контекст = НовыйКонтекст();
    Читатель = НовыйЧитатель();
    Контекст.Читатели.Добавить(Читатель);
    Читатель.УстановитьАгрегациюПоУмолчанию("Histogram", ОтелАгрегация.ГистограммаСЯвнымиГраницами());
    Текущие = ОтелПотокиМетрик.СоздатьХранилища(Контекст, Дескриптор("h", "Histogram"));

    // Когда - агрегация читателя больше не записывает min и max
    Читатель.УстановитьАгрегациюПоУмолчанию("Histogram", ОтелАгрегация.ГистограммаСЯвнымиГраницами(, Ложь));
    Новые = ОтелПотокиМетрик.СоздатьХранилища(Контекст, Дескриптор("h", "Histogram"), Текущие);

    // Тогда - поток изменился, хранилище создано заново
    Ожидаем.Что(Новые[0].Хранилище = Текущие[0].Хранилище, "хранилище пересоздано").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПредустановленнаяАгрегацияИнструментаБезView() Экспорт

    // Дано - экспоненциальная гистограмма с заданным числом бакетов
    Контекст = НовыйКонтекст();
    АгрегацияИнструмента = ОтелАгрегация.ГистограммаЭкспоненциальная(10);
    Дескриптор = ОтелПотокиМетрик.НовыйДескриптор("e", "", "", "ExponentialHistogram", Неопределено,
        АгрегацияИнструмента);

    // Когда
    Хранилище = ОтелПотокиМетрик.СоздатьХранилища(Контекст, Дескриптор)[0].Хранилище;

    // Тогда
    Ожидаем.Что(Хранилище.Агрегатор().ТипМетрики()).Равно(ОтелТипМетрики.ЭкспоненциальнаяГистограмма());

КонецПроцедуры

#Область Служебные

Функция НовыйКонтекст()
    Контекст = ОтелПотокиМетрик.НовыйКонтекст(Область());
    Контекст.Лог = Мок.Получить(Тип("Лог"));
    Возврат Контекст;
КонецФункции

Функция Область()
    Возврат Новый ОтелОбластьИнструментирования("test-lib", "1.0");
КонецФункции

Функция Дескриптор(Имя, Вид, Совет = Неопределено)
    Возврат ОтелПотокиМетрик.НовыйДескриптор(Имя, "описание", "1", Вид, Совет);
КонецФункции

Функция НовыйЧитатель(Лимит = 2000)
    Экспортер = Новый ОтелЭкспортерМетрик(Новый ОтелВПамятьТранспорт());
    Возврат Новый ОтелПериодическийЧитательМетрик(Экспортер, 60000, Лимит);
КонецФункции

Процедура ДобавитьПредставление(Контекст, ИмяИнструмента, Представление)
    Пара = Новый Соответствие();
    Пара.Вставить("Селектор", Новый ОтелСелекторИнструментов(ИмяИнструмента));
    Пара.Вставить("Представление", Представление);
    Контекст.Представления.Добавить(Пара);
КонецПроцедуры

Функция Ключи(Ключ1, Ключ2 = Неопределено)
    Результат = Новый Массив();
    Результат.Добавить(Ключ1);
    Если Ключ2 <> Неопределено Тогда
        Результат.Добавить(Ключ2);
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция Числа(Число1, Число2 = Неопределено)
    Результат = Новый Массив();
    Результат.Добавить(Число1);
    Если Число2 <> Неопределено Тогда
        Результат.Добавить(Число2);
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция АтрибутыABC()
    Атрибуты = Новый ОтелАтрибуты();
    Атрибуты.Установить("a", 1);
    Атрибуты.Установить("b", 2);
    Атрибуты.Установить("c", 3);
    Возврат Атрибуты;
КонецФункции

Функция ГруппыНаблюдения(Атрибуты)
    Наблюдение = Новый ОтелНаблюдениеМетрики();
    Наблюдение.Записать(1, Атрибуты);
    Группы = Новый Массив();
    Группы.Добавить(Новый Структура("Записи, Время", Наблюдение.Записи(), Неопределено));
    Возврат Группы;
КонецФункции

Функция КлючиЗаписанныхАтрибутов(Хранилище)
    Хранилище.Записать(1, АтрибутыABC());
    Данные = Хранилище.Собрать(Новый ОтелРесурс(Истина), Область(), ОтелВременнаяАгрегация.Кумулятивная());
    Возврат КлючиАтрибутовТочки(Данные.ТочкиДанных()[0]);
КонецФункции

Функция КлючиАтрибутовТочки(Точка)
    Ключи = Новый СписокЗначений();
    Для Каждого Атрибут Из Точка.Получить("attributes") Цикл
        Ключи.Добавить(Атрибут.Получить("key"));
    КонецЦикла;
    Ключи.СортироватьПоЗначению();
    Возврат СтрСоединить(Ключи.ВыгрузитьЗначения(), ",");
КонецФункции

#КонецОбласти
