// ============================================================
// ОтелПотокиМетрик - потоки метрики инструмента по читателям и View
// ============================================================

&Тест
Процедура БезПредставленийОдинПотокПоУмолчанию() Экспорт

    // Дано
    Контекст = НовыйКонтекст();

    // Когда
    Записи = ОтелПотокиМетрик.СоздатьХранилища(Контекст, Дескриптор("requests", "Counter"));

    // Тогда
    Ожидаем.Что(Записи).ИмеетДлину(1);
    Ожидаем.Что(Записи[0].Читатель).Равно(Неопределено);
    Ожидаем.Что(Записи[0].Хранилище.Имя()).Равно("requests");
    Ожидаем.Что(Записи[0].Хранилище.Вид()).Равно("Counter");
    Ожидаем.Что(Записи[0].Хранилище.Агрегатор().ТипМетрики()).Равно(ОтелТипМетрики.Сумма());

КонецПроцедуры

&Тест
Процедура ПотокДляКаждогоЧитателя() Экспорт

    // Дано
    Контекст = НовыйКонтекст();
    Читатель1 = НовыйЧитатель();
    Читатель2 = НовыйЧитатель();
    Контекст.Читатели.Добавить(Читатель1);
    Контекст.Читатели.Добавить(Читатель2);

    // Когда
    Записи = ОтелПотокиМетрик.СоздатьХранилища(Контекст, Дескриптор("requests", "Counter"));

    // Тогда - у каждого читателя свое хранилище
    Ожидаем.Что(Записи).ИмеетДлину(2);
    Ожидаем.Что(Записи[0].Читатель = Читатель1, "первый читатель").ЭтоИстина();
    Ожидаем.Что(Записи[1].Читатель = Читатель2, "второй читатель").ЭтоИстина();
    Ожидаем.Что(Записи[0].Хранилище = Записи[1].Хранилище, "разные хранилища").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура КаждоеСовпавшееПредставлениеСоздаетПоток() Экспорт

    // Дано
    Контекст = НовыйКонтекст();
    ДобавитьПредставление(Контекст, "requests", Новый ОтелПредставление("x1"));
    ДобавитьПредставление(Контекст, "requests", Новый ОтелПредставление("x2"));

    // Когда
    Записи = ОтелПотокиМетрик.СоздатьХранилища(Контекст, Дескриптор("requests", "Counter"));

    // Тогда
    Ожидаем.Что(Записи).ИмеетДлину(2);
    Ожидаем.Что(Записи[0].Хранилище.Имя()).Равно("x1");
    Ожидаем.Что(Записи[1].Хранилище.Имя()).Равно("x2");
    Ожидаем.Что(Записи[0].Переименован).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АгрегацияПоУмолчаниюЧитателяПоВидуИнструмента() Экспорт

    // Дано
    Контекст = НовыйКонтекст();
    Читатель = НовыйЧитатель();
    Читатель.УстановитьАгрегациюПоУмолчанию("Counter", "drop");
    Читатель.УстановитьАгрегациюПоУмолчанию("Gauge", "sum");
    Контекст.Читатели.Добавить(Читатель);

    // Когда
    СчетчикЗаписи = ОтелПотокиМетрик.СоздатьХранилища(Контекст, Дескриптор("c", "Counter"));
    ДатчикЗаписи = ОтелПотокиМетрик.СоздатьХранилища(Контекст, Дескриптор("g", "Gauge"));

    // Тогда
    Ожидаем.Что(СчетчикЗаписи[0].Хранилище.ЭтоОтбрасывание()).ЭтоИстина();
    Ожидаем.Что(ДатчикЗаписи[0].Хранилище.Агрегатор().ТипМетрики()).Равно(ОтелТипМетрики.Сумма());
    Ожидаем.Что(ДатчикЗаписи[0].Хранилище.Агрегатор().Монотонный()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ЛимитМощностиЧитателяПоВидуИнструмента() Экспорт

    // Дано
    Контекст = НовыйКонтекст();
    Читатель = НовыйЧитатель(7);
    Читатель.УстановитьЛимитМощностиДляВида("Histogram", 3);
    Контекст.Читатели.Добавить(Читатель);

    // Когда
    Счетчик = ОтелПотокиМетрик.СоздатьХранилища(Контекст, Дескриптор("c", "Counter"))[0].Хранилище;
    Гистограмма = ОтелПотокиМетрик.СоздатьХранилища(Контекст, Дескриптор("h", "Histogram"))[0].Хранилище;

    // Тогда
    Ожидаем.Что(Счетчик.ЛимитМощности()).Равно(7);
    Ожидаем.Что(Гистограмма.ЛимитМощности()).Равно(3);

КонецПроцедуры

&Тест
Процедура ЛимитМощностиПредставленияДляАсинхронногоИнструмента() Экспорт

    // Дано
    Контекст = НовыйКонтекст();
    ДобавитьПредставление(Контекст, "obs",
        Новый ОтелПредставление(, , , , , , , 3));

