&Тест
Процедура ПредставлениеСНесовместимойАгрегациейИгнорируетсяЦеликом() Экспорт

    // Дано
    Контекст = НовыйКонтекст();
    ДобавитьПредставление(Контекст, "obs",
        Новый ОтелПредставление("renamed", , , , ОтелАгрегация.ГистограммаСЯвнымиГраницами()));

    // Когда
    Записи = ОтелПотокиМетрик.СоздатьХранилища(Контекст, Дескриптор("obs", "ObservableGauge"));

    // Тогда - поток как без View: имя инструмента, агрегация по умолчанию
    Ожидаем.Что(Записи).ИмеетДлину(1);
    Ожидаем.Что(Записи[0].Хранилище.Имя()).Равно("obs");
    Ожидаем.Что(Записи[0].Хранилище.Агрегатор().ТипМетрики()).Равно(ОтелТипМетрики.Датчик());
    Контекст.Лог.ПроверитьЧтоВызывалсяМетод().Предупреждение(Матчеры.Содержит("семантическая ошибка"));

КонецПроцедуры

&Тест
Процедура ПредставлениеСНеизвестнойАгрегациейИгнорируется() Экспорт

    // Дано
    Контекст = НовыйКонтекст();
    ДобавитьПредставление(Контекст, "c", Новый ОтелПредставление("renamed", , , , "bogus"));

    // Когда
    Записи = ОтелПотокиМетрик.СоздатьХранилища(Контекст, Дескриптор("c", "Counter"));

    // Тогда
    Ожидаем.Что(Записи[0].Хранилище.Имя()).Равно("c");
