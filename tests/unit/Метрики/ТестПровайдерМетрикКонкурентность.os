// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать "../../.."
#Использовать asserts

// Metrics SDK / Concurrency requirements: создание Meter, ForceFlush и Shutdown провайдера
// безопасны для конкурентного вызова

// Провайдер, общий для теста и фоновых заданий
Перем Провайдер;

&Тест
Процедура ИзменениеКонфигурацииИЗакрытиеВоВремяСозданияМетровБезОшибок() Экспорт

    // Дано - фоновые задания создают метры и инструменты
    Провайдер = Новый ОтелПровайдерМетрик(Новый ОтелРесурс(Истина));
    Задания = ЗапуститьСозданиеМетров(3);

    // Когда - одновременно регистрируются View, меняется конфигурация, затем провайдер закрывается
    Ошибки = Новый Массив();
    Для Итерация = 1 По 40 Цикл
        ИзменитьКонфигурацию(Ошибки, Итерация);
    КонецЦикла;
    Попытка
        Провайдер.Закрыть();
    Исключение
        Ошибки.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
    ФоновыеЗадания.ОжидатьВсе(Задания);

    // Тогда
    Для Каждого Задание Из Задания Цикл
        Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
            Ошибки.Добавить(Задание.ИнформацияОбОшибке.Описание);
        КонецЕсли;
    КонецЦикла;
    Ожидаем.Что(Ошибки.Количество(), СтрСоединить(Ошибки, Символы.ПС)).Равно(0);

КонецПроцедуры

// Выполняется фоновыми заданиями: создает метры с разными областями и счетчик в каждом.
//
Процедура СоздаватьМетры(НомерЗадания) Экспорт
    Для Номер = 1 По 100 Цикл
        Метр = Провайдер.ПолучитьМетр(СтрШаблон("lib-%1-%2", НомерЗадания, Номер));
        Счетчик = Метр.СоздатьСчетчик("requests");
        Счетчик.Добавить(1);
    КонецЦикла;
КонецПроцедуры

Функция ЗапуститьСозданиеМетров(Заданий)
    Задания = Новый Массив();
    Для НомерЗадания = 1 По Заданий Цикл
        Параметры = Новый Массив();
        Параметры.Добавить(НомерЗадания);
        Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "СоздаватьМетры", Параметры);
        Задания.Добавить(Задание);
    КонецЦикла;
    Возврат Задания;
КонецФункции

Процедура ИзменитьКонфигурацию(Ошибки, Итерация)
    Попытка
        Провайдер.ЗарегистрироватьПредставление(
            Новый ОтелСелекторИнструментов("other" + Итерация), Новый ОтелПредставление("renamed" + Итерация));
        Если Итерация % 10 = 0 Тогда
            Провайдер.УстановитьТаймаутОбратныхВызововМс(1000 + Итерация);
            Провайдер.УстановитьАгрегациюГистограммПоУмолчанию("explicit_bucket_histogram");
        КонецЕсли;
    Исключение
        Ошибки.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
КонецПроцедуры
