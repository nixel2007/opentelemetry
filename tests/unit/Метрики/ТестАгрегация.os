// Спецификация Metrics SDK (Histogram Aggregations): sum не собирается для инструментов,
// записывающих отрицательные значения

&ПараметризованныйТест
&ИсточникЗначение("explicit_bucket_histogram|Histogram|Истина")
&ИсточникЗначение("explicit_bucket_histogram|Counter|Истина")
&ИсточникЗначение("explicit_bucket_histogram|UpDownCounter|Ложь")
&ИсточникЗначение("explicit_bucket_histogram|Gauge|Ложь")
&ИсточникЗначение("base2_exponential_bucket_histogram|Histogram|Истина")
&ИсточникЗначение("base2_exponential_bucket_histogram|UpDownCounter|Ложь")
&ИсточникЗначение("base2_exponential_bucket_histogram|Gauge|Ложь")
Процедура СуммаГистограммыПоВидуИнструмента(Случай) Экспорт

	// Дано
	Части = СтрРазделить(Случай, "|");
	ЕстьСумма = Части[2];
	Агрегатор = ОтелАгрегация.СоздатьАгрегаторПотока(ОтелАгрегация.Нормализовать(Части[0]), Части[1]);
	Аккумулятор = Агрегатор.СоздатьАккумулятор();
	Агрегатор.Записать(Аккумулятор, 3);

	// Когда
	Точка = Агрегатор.СформироватьТочкуДанных(Аккумулятор, "1000", "2000", Новый Массив, Новый Массив);

	// Тогда
	Ожидаем.Что(Точка.Получить("sum") <> Неопределено).Равно(ЕстьСумма = "Истина");

КонецПроцедуры

// Спецификация Metrics SDK (Histogram Aggregations): min и max собираются, только если
// включен параметр RecordMinMax

&ПараметризованныйТест
&ИсточникЗначение("explicit_bucket_histogram|Истина")
&ИсточникЗначение("explicit_bucket_histogram|Ложь")
&ИсточникЗначение("base2_exponential_bucket_histogram|Истина")
&ИсточникЗначение("base2_exponential_bucket_histogram|Ложь")
Процедура МинМаксГистограммыПоПараметруАгрегации(Случай) Экспорт

	// Дано
	Части = СтрРазделить(Случай, "|");
	ЗаписыватьМинМакс = Части[1] = "Истина";
	Агрегация = ОтелАгрегация.Нормализовать(ГистограммаСЗаписьюМинМакс(Части[0], ЗаписыватьМинМакс));
	Агрегатор = ОтелАгрегация.СоздатьАгрегаторПотока(Агрегация, "Histogram");
	Аккумулятор = Агрегатор.СоздатьАккумулятор();
	Агрегатор.Записать(Аккумулятор, 3);
	Агрегатор.Записать(Аккумулятор, 7);

	// Когда
	Точка = Агрегатор.СформироватьТочкуДанных(Аккумулятор, "1000", "2000", Новый Массив, Новый Массив);

	// Тогда
	Ожидаем.Что(Точка.Получить("min") <> Неопределено, "min").Равно(ЗаписыватьМинМакс);
	Ожидаем.Что(Точка.Получить("max") <> Неопределено, "max").Равно(ЗаписыватьМинМакс);
	Ожидаем.Что(Точка.Получить("count")).Равно(2);

КонецПроцедуры

&Тест
Процедура ЭкспоненциальнаяГистограммаНачинаетСМаксимальнойШкалы() Экспорт

	// Дано
	Агрегация = ОтелАгрегация.Нормализовать(ОтелАгрегация.ГистограммаЭкспоненциальная(160, 5));
	Агрегатор = ОтелАгрегация.СоздатьАгрегаторПотока(Агрегация, "Histogram");
	Аккумулятор = Агрегатор.СоздатьАккумулятор();
	Агрегатор.Записать(Аккумулятор, 3);

	// Когда
	Точка = Агрегатор.СформироватьТочкуДанных(Аккумулятор, "1000", "2000", Новый Массив, Новый Массив);

	// Тогда - спецификация Metrics SDK: для одного значения используется шкала MaxScale
	Ожидаем.Что(Точка.Получить("scale")).Равно(5);

КонецПроцедуры

&Тест
Процедура АгрегаторПотокаГистограммыСГраницами() Экспорт

	// Дано
	Границы = Новый Массив();
	Границы.Добавить(1);
	Границы.Добавить(10);

	// Когда
	Агрегатор = ОтелАгрегация.СоздатьАгрегаторПотока(
		ОтелАгрегация.Нормализовать(ОтелАгрегация.ГистограммаСЯвнымиГраницами(Границы)), "Histogram");

	// Тогда
	Ожидаем.Что(Агрегатор.Границы()).ИмеетДлину(2);

КонецПроцедуры

// Спецификация Metrics SDK (Exemplar defaults)

&Тест
Процедура РезервуарЯвнойГистограммыВыровненПоБакетам() Экспорт

	// Дано
	Агрегация = ОтелАгрегация.Нормализовать("explicit_bucket_histogram");
	Агрегатор = ОтелАгрегация.СоздатьАгрегаторПотока(Агрегация, "Histogram");

	// Когда
	Фабрика = ОтелАгрегация.ФабрикаРезервуаровПоУмолчанию(Агрегация, Агрегатор);

	// Тогда
	Ожидаем.Что(Фабрика).ИмеетТип("ОтелФабрикаВыровненныхРезервуаровГистограммы");

КонецПроцедуры

&Тест
Процедура РезервуарЯвнойГистограммыИзОдногоБакетаПростой() Экспорт

	// Дано - без границ гистограмма состоит из одного бакета
	Агрегация = ОтелАгрегация.Нормализовать(ОтелАгрегация.ГистограммаСЯвнымиГраницами(Новый Массив()));
	Агрегатор = ОтелАгрегация.СоздатьАгрегаторПотока(Агрегация, "Histogram");

	// Когда
	Фабрика = ОтелАгрегация.ФабрикаРезервуаровПоУмолчанию(Агрегация, Агрегатор);

	// Тогда
	Ожидаем.Что(Фабрика).ИмеетТип("ОтелФабрикаПростыхРезервуаров");
	Ожидаем.Что(Фабрика.Размер()).Равно(1);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("10|10")
&ИсточникЗначение("160|20")
Процедура РезервуарЭкспоненциальнойГистограммыПоЧислуБакетов(Случай) Экспорт

	// Дано
	Части = СтрРазделить(Случай, "|");
	ОжидаемыйРазмер = Части[1];
	Агрегация = ОтелАгрегация.Нормализовать(ОтелАгрегация.ГистограммаЭкспоненциальная(Число(Части[0])));
	Агрегатор = ОтелАгрегация.СоздатьАгрегаторПотока(Агрегация, "Histogram");

	// Когда
	Фабрика = ОтелАгрегация.ФабрикаРезервуаровПоУмолчанию(Агрегация, Агрегатор);

	// Тогда
	Ожидаем.Что(Фабрика.Размер()).Равно(Число(ОжидаемыйРазмер));

КонецПроцедуры

&Тест
Процедура РезервуарСуммыПростойИзОдногоЭкземпляра() Экспорт

	// Дано
	Агрегация = ОтелАгрегация.Нормализовать("sum");
	Агрегатор = ОтелАгрегация.СоздатьАгрегаторПотока(Агрегация, "Counter");

	// Когда
	Фабрика = ОтелАгрегация.ФабрикаРезервуаровПоУмолчанию(Агрегация, Агрегатор);

	// Тогда
	Ожидаем.Что(Фабрика.Размер()).Равно(1);

КонецПроцедуры

&Тест
Процедура РезервуараОтбрасыванияНет() Экспорт

	// Дано
	Агрегация = ОтелАгрегация.Нормализовать("drop");
	Агрегатор = ОтелАгрегация.СоздатьАгрегаторПотока(Агрегация, "Counter");

	// Когда-Тогда
	Ожидаем.Что(ОтелАгрегация.ФабрикаРезервуаровПоУмолчанию(Агрегация, Агрегатор)).Равно(Неопределено);

КонецПроцедуры

#Область Служебные

Функция ГистограммаСЗаписьюМинМакс(ТипАгрегации, ЗаписыватьМинМакс)
	Если ТипАгрегации = "explicit_bucket_histogram" Тогда
		Возврат ОтелАгрегация.ГистограммаСЯвнымиГраницами(, ЗаписыватьМинМакс);
	КонецЕсли;
	Возврат ОтелАгрегация.ГистограммаЭкспоненциальная(, , ЗаписыватьМинМакс);
КонецФункции

#КонецОбласти
