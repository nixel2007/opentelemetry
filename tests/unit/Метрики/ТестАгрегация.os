// ============================================================
// Агрегация потока: нормализация, совместимость, агрегатор по виду инструмента
// ============================================================

&ПараметризованныйТест
&ИсточникЗначение("sum|sum")
&ИсточникЗначение("last_value|last_value")
&ИсточникЗначение("drop|drop")
&ИсточникЗначение("default|default")
&ИсточникЗначение("explicit_bucket_histogram|explicit_bucket_histogram")
&ИсточникЗначение("base2_exponential_bucket_histogram|base2_exponential_bucket_histogram")
&ИсточникЗначение("exponential_histogram|base2_exponential_bucket_histogram")
Процедура НормализоватьСтроковуюАгрегацию(Случай) Экспорт

	// Дано
	Части = СтрРазделить(Случай, "|");

	// Когда
	Нормализованная = ОтелАгрегация.Нормализовать(Части[0]);

	// Тогда
	Ожидаем.Что(Нормализованная.Тип).Равно(Части[1]);

КонецПроцедуры

