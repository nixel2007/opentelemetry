// Шкала экспоненциальной гистограммы - от -10 до 20; признак записи min и max - Булево

&Тест
Процедура НормализоватьНекорректныеПараметрыГистограмм() Экспорт

	// Дано
	ШкалаВыше = ОтелАгрегация.ГистограммаЭкспоненциальная(160, 21);
	ШкалаНиже = ОтелАгрегация.ГистограммаЭкспоненциальная(160, -11);
	ЯвнаяСоСтрокой = ОтелАгрегация.ГистограммаСЯвнымиГраницами(, "нет");
	ЭкспоненциальнаяСЧислом = ОтелАгрегация.ГистограммаЭкспоненциальная(160, 20, 0);

	// Когда-Тогда
	Ожидаем.Что(ОтелАгрегация.Нормализовать(ШкалаВыше), "шкала 21").Равно(Неопределено);
	Ожидаем.Что(ОтелАгрегация.Нормализовать(ШкалаНиже), "шкала -11").Равно(Неопределено);
	Ожидаем.Что(ОтелАгрегация.Нормализовать(ЯвнаяСоСтрокой), "явная").Равно(Неопределено);
	Ожидаем.Что(ОтелАгрегация.Нормализовать(ЭкспоненциальнаяСЧислом), "экспоненциальная").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура НормализоватьНеизвестнуюАгрегацию() Экспорт

	// Дано
	БезТипа = Новый Соответствие();
	БезТипа.Вставить("Границы", Новый Массив());

	// Когда-Тогда
	Ожидаем.Что(ОтелАгрегация.Нормализовать("bogus")).Равно(Неопределено);
	Ожидаем.Что(ОтелАгрегация.Нормализовать(БезТипа)).Равно(Неопределено);
	Ожидаем.Что(ОтелАгрегация.Нормализовать(42)).Равно(Неопределено);

КонецПроцедуры

