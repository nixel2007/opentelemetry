&ИсточникЗначение("sum|UpDownCounter|sum|Ложь|int")
&ИсточникЗначение("sum|Histogram|sum|Истина|double")
&ИсточникЗначение("sum|Gauge|sum|Ложь|double")
&ИсточникЗначение("sum|ObservableCounter|sum|Истина|int")
&ИсточникЗначение("last_value|Counter|gauge|Ложь|int")
