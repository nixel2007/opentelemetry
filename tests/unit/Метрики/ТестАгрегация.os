&Тест
Процедура НормализоватьНеизвестнуюАгрегацию() Экспорт

	// Дано
	БезТипа = Новый Соответствие();
	БезТипа.Вставить("Границы", Новый Массив());

	// Когда-Тогда
	Ожидаем.Что(ОтелАгрегация.Нормализовать("bogus")).Равно(Неопределено);
	Ожидаем.Что(ОтелАгрегация.Нормализовать(БезТипа)).Равно(Неопределено);
	Ожидаем.Что(ОтелАгрегация.Нормализовать(42)).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("explicit_bucket_histogram|ObservableGauge|Ложь")
&ИсточникЗначение("base2_exponential_bucket_histogram|ObservableCounter|Ложь")
&ИсточникЗначение("explicit_bucket_histogram|ObservableUpDownCounter|Ложь")
&ИсточникЗначение("sum|ObservableGauge|Истина")
&ИсточникЗначение("explicit_bucket_histogram|Counter|Истина")
&ИсточникЗначение("base2_exponential_bucket_histogram|Gauge|Истина")
Процедура СовместимостьАгрегацииСВидом(Случай) Экспорт

	// Дано
	Части = СтрРазделить(Случай, "|");

	// Когда
	Совместима = ОтелАгрегация.СовместимаСВидом(ОтелАгрегация.Нормализовать(Части[0]), Части[1]);

	// Тогда
	Ожидаем.Что(Совместима).Равно(Части[2] = "Истина");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("sum|Counter|sum|Истина|int")
&ИсточникЗначение("sum|UpDownCounter|sum|Ложь|int")
&ИсточникЗначение("sum|Histogram|sum|Истина|double")
&ИсточникЗначение("sum|Gauge|sum|Ложь|double")
&ИсточникЗначение("sum|ObservableCounter|sum|Истина|int")
&ИсточникЗначение("last_value|Counter|gauge|Ложь|int")
&ИсточникЗначение("default|Counter|sum|Истина|int")
&ИсточникЗначение("default|ObservableUpDownCounter|sum|Ложь|int")
&ИсточникЗначение("default|Gauge|gauge|Ложь|double")
&ИсточникЗначение("default|ObservableGauge|gauge|Ложь|double")
&ИсточникЗначение("default|Histogram|histogram|Ложь|double")
&ИсточникЗначение("explicit_bucket_histogram|Counter|histogram|Ложь|double")
&ИсточникЗначение("base2_exponential_bucket_histogram|Histogram|exponentialHistogram|Ложь|double")
Процедура АгрегаторПотокаПоВидуИнструмента(Случай) Экспорт

	// Дано
	Части = СтрРазделить(Случай, "|");

	// Когда
	Агрегатор = ОтелАгрегация.СоздатьАгрегаторПотока(ОтелАгрегация.Нормализовать(Части[0]), Части[1]);

	// Тогда
	Ожидаем.Что(Агрегатор.ТипМетрики()).Равно(Части[2]);
	Ожидаем.Что(Агрегатор.Монотонный()).Равно(Части[3] = "Истина");
	Ожидаем.Что(Агрегатор.ТипЗначения()).Равно(Части[4]);

КонецПроцедуры

&Тест
Процедура АгрегаторОтбрасыванияПотока() Экспорт

	// Когда
	Агрегатор = ОтелАгрегация.СоздатьАгрегаторПотока(ОтелАгрегация.Нормализовать("drop"), "Counter");

	// Тогда
	Ожидаем.Что(ОтелАгрегация.ЭтоАгрегаторОтбрасывания(Агрегатор)).ЭтоИстина();

КонецПроцедуры

// Спецификация Metrics SDK (Histogram Aggregations): sum не собирается для инструментов,
// записывающих отрицательные значения

&ПараметризованныйТест
&ИсточникЗначение("explicit_bucket_histogram|Histogram|Истина")
&ИсточникЗначение("explicit_bucket_histogram|Counter|Истина")
&ИсточникЗначение("explicit_bucket_histogram|UpDownCounter|Ложь")
&ИсточникЗначение("explicit_bucket_histogram|Gauge|Ложь")
&ИсточникЗначение("base2_exponential_bucket_histogram|Histogram|Истина")
&ИсточникЗначение("base2_exponential_bucket_histogram|UpDownCounter|Ложь")
&ИсточникЗначение("base2_exponential_bucket_histogram|Gauge|Ложь")
Процедура СуммаГистограммыПоВидуИнструмента(Случай) Экспорт

	// Дано
	Части = СтрРазделить(Случай, "|");
	ЕстьСумма = Части[2];
	Агрегатор = ОтелАгрегация.СоздатьАгрегаторПотока(ОтелАгрегация.Нормализовать(Части[0]), Части[1]);
	Аккумулятор = Агрегатор.СоздатьАккумулятор();
	Агрегатор.Записать(Аккумулятор, 3);

	// Когда
	Точка = Агрегатор.СформироватьТочкуДанных(Аккумулятор, "1000", "2000", Новый Массив, Новый Массив);

	// Тогда
	Ожидаем.Что(Точка.Получить("sum") <> Неопределено).Равно(ЕстьСумма = "Истина");

КонецПроцедуры

&Тест
Процедура АгрегаторПотокаГистограммыСГраницами() Экспорт

	// Дано
	Границы = Новый Массив();
	Границы.Добавить(1);
	Границы.Добавить(10);

	// Когда
	Агрегатор = ОтелАгрегация.СоздатьАгрегаторПотока(
		ОтелАгрегация.Нормализовать(ОтелАгрегация.ГистограммаСЯвнымиГраницами(Границы)), "Histogram");

	// Тогда
	Ожидаем.Что(Агрегатор.Границы()).ИмеетДлину(2);

КонецПроцедуры

// Спецификация Metrics SDK (Exemplar defaults)

&Тест
Процедура РезервуарЯвнойГистограммыВыровненПоБакетам() Экспорт

	// Дано
	Агрегация = ОтелАгрегация.Нормализовать("explicit_bucket_histogram");
	Агрегатор = ОтелАгрегация.СоздатьАгрегаторПотока(Агрегация, "Histogram");

	// Когда
	Фабрика = ОтелАгрегация.ФабрикаРезервуаровПоУмолчанию(Агрегация, Агрегатор);

	// Тогда
	Ожидаем.Что(Фабрика).ИмеетТип("ОтелФабрикаВыровненныхРезервуаровГистограммы");

КонецПроцедуры

&Тест
Процедура РезервуарЯвнойГистограммыИзОдногоБакетаПростой() Экспорт

	// Дано - без границ гистограмма состоит из одного бакета
	Агрегация = ОтелАгрегация.Нормализовать(ОтелАгрегация.ГистограммаСЯвнымиГраницами(Новый Массив()));
	Агрегатор = ОтелАгрегация.СоздатьАгрегаторПотока(Агрегация, "Histogram");

	// Когда
	Фабрика = ОтелАгрегация.ФабрикаРезервуаровПоУмолчанию(Агрегация, Агрегатор);

	// Тогда
	Ожидаем.Что(Фабрика).ИмеетТип("ОтелФабрикаПростыхРезервуаров");
	Ожидаем.Что(Фабрика.Размер()).Равно(1);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("10|10")
&ИсточникЗначение("160|20")
Процедура РезервуарЭкспоненциальнойГистограммыПоЧислуБакетов(Случай) Экспорт

	// Дано
	Части = СтрРазделить(Случай, "|");
	ОжидаемыйРазмер = Части[1];
	Агрегация = ОтелАгрегация.Нормализовать(ОтелАгрегация.ГистограммаЭкспоненциальная(Число(Части[0])));
	Агрегатор = ОтелАгрегация.СоздатьАгрегаторПотока(Агрегация, "Histogram");

	// Когда
	Фабрика = ОтелАгрегация.ФабрикаРезервуаровПоУмолчанию(Агрегация, Агрегатор);

	// Тогда
	Ожидаем.Что(Фабрика.Размер()).Равно(Число(ОжидаемыйРазмер));

КонецПроцедуры

