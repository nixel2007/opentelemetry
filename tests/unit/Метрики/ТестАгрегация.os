&ИсточникЗначение("base2_exponential_bucket_histogram|Histogram|exponentialHistogram|Ложь|double")
Процедура АгрегаторПотокаПоВидуИнструмента(Случай) Экспорт

	// Дано
	Части = СтрРазделить(Случай, "|");

	// Когда
	Агрегатор = ОтелАгрегация.СоздатьАгрегаторПотока(ОтелАгрегация.Нормализовать(Части[0]), Части[1]);

	// Тогда
	Ожидаем.Что(Агрегатор.ТипМетрики()).Равно(Части[2]);
	Ожидаем.Что(Агрегатор.Монотонный()).Равно(Части[3] = "Истина");
	Ожидаем.Что(Агрегатор.ТипЗначения()).Равно(Части[4]);

