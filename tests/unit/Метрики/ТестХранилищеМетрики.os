// ============================================================

&Тест
Процедура КумулятивныйСборСохраняетЗначенияИВремяСтарта() Экспорт

    // Дано
    Хранилище = ХранилищеСуммы();
    Хранилище.Записать(10);
    Хранилище.Записать(32);

    // Когда
    Первые = Хранилище.Собрать(Ресурс(), Область(), Кумулятивная());
    Хранилище.Записать(8);
    Вторые = Хранилище.Собрать(Ресурс(), Область(), Кумулятивная());

    // Тогда
    Ожидаем.Что(Первые.ТочкиДанных()[0].Получить("value")).Равно(42);
    Ожидаем.Что(Вторые.ТочкиДанных()[0].Получить("value")).Равно(50);
    Ожидаем.Что(Вторые.ТочкиДанных()[0].Получить("startTimeUnixNano"))
        .Равно(Первые.ТочкиДанных()[0].Получить("startTimeUnixNano"));
    Ожидаем.Что(Вторые.ВременнаяАгрегация()).Равно(Кумулятивная());

КонецПроцедуры

&Тест
Процедура ДельтаСборНачинаетНовыйИнтервал() Экспорт

    // Дано
    Хранилище = ХранилищеСуммы();
    Хранилище.Записать(5);

    // Когда
    Первые = Хранилище.Собрать(Ресурс(), Область(), Дельта());
    Хранилище.Записать(3);
    Вторые = Хранилище.Собрать(Ресурс(), Область(), Дельта());

    // Тогда - второй интервал начинается временем первого сбора
    ПерваяТочка = Первые.ТочкиДанных()[0];
    ВтораяТочка = Вторые.ТочкиДанных()[0];
    Ожидаем.Что(ПерваяТочка.Получить("value")).Равно(5);
    Ожидаем.Что(ВтораяТочка.Получить("value")).Равно(3);
    Ожидаем.Что(ВтораяТочка.Получить("startTimeUnixNano")).Равно(ПерваяТочка.Получить("timeUnixNano"));
    Ожидаем.Что(Вторые.ВременнаяАгрегация()).Равно(Дельта());

КонецПроцедуры

&Тест
Процедура ВремяСбораЧитателяЗаканчиваетИНачинаетИнтервал() Экспорт

    // Дано
    Хранилище = ХранилищеСуммы();
    Хранилище.Записать(5);

    // Когда - читатель передает одно время сбора всем потокам
    Первые = Хранилище.Собрать(Ресурс(), Область(), Дельта(), "1700000000000000000");
    Хранилище.Записать(3);
    Вторые = Хранилище.Собрать(Ресурс(), Область(), Дельта(), "1700000001000000000");

    // Тогда
    Ожидаем.Что(Первые.ТочкиДанных()[0].Получить("timeUnixNano")).Равно("1700000000000000000");
    Ожидаем.Что(Вторые.ТочкиДанных()[0].Получить("startTimeUnixNano")).Равно("1700000000000000000");
    Ожидаем.Что(Вторые.ТочкиДанных()[0].Получить("timeUnixNano")).Равно("1700000001000000000");

КонецПроцедуры

