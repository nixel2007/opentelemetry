&Тест
Процедура ПереполнениеПослеЛимитаНаборов() Экспорт

    // Дано
    Хранилище = ХранилищеСуммы();
    Хранилище.УстановитьЛимитМощности(2);

    // Когда
    Хранилище.Записать(1, Атрибуты("k", "a"));
    Хранилище.Записать(2, Атрибуты("k", "b"));
    Хранилище.Записать(4, Атрибуты("k", "c"));
    Хранилище.Записать(8, Атрибуты("k", "d"));

    // Тогда - два набора своих, остальные в серии переполнения
    Данные = Хранилище.Собрать(Ресурс(), Область(), Кумулятивная());
    Ожидаем.Что(Данные.ТочкиДанных()).ИмеетДлину(3);
    ТочкаПереполнения = НайтиТочкуПоАтрибуту(Данные, "otel.metric.overflow", Истина);
    Ожидаем.Что(ТочкаПереполнения <> Неопределено, "есть точка переполнения").ЭтоИстина();
    Ожидаем.Что(ТочкаПереполнения.Получить("value")).Равно(12);
    Ожидаем.Что(ТочкаПереполнения.Получить("attributes")).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ЛимитНаборовНеВызываетПереполнения() Экспорт

    // Дано
    Хранилище = ХранилищеСуммы();
    Хранилище.УстановитьЛимитМощности(2);

    // Когда
    Хранилище.Записать(1, Атрибуты("k", "a"));
    Хранилище.Записать(2, Атрибуты("k", "b"));
    Хранилище.Записать(3, Атрибуты("k", "a"));

    // Тогда
    Данные = Хранилище.Собрать(Ресурс(), Область(), Кумулятивная());
    Ожидаем.Что(Данные.ТочкиДанных()).ИмеетДлину(2);
    Ожидаем.Что(НайтиТочкуПоАтрибуту(Данные, "otel.metric.overflow", Истина)).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура КумулятивнаяСерияДоПереполненияПродолжаетЭкспортироваться() Экспорт

    // Дано - лимит исчерпан
    Хранилище = ХранилищеСуммы();
    Хранилище.УстановитьЛимитМощности(1);
    Хранилище.Записать(1, Атрибуты("k", "a"));
    Хранилище.Записать(1, Атрибуты("k", "b"));

    // Когда - запись в набор, наблюдавшийся до переполнения
    Хранилище.Записать(5, Атрибуты("k", "a"));

    // Тогда
    Данные = Хранилище.Собрать(Ресурс(), Область(), Кумулятивная());
    Ожидаем.Что(ЗначениеТочкиПоАтрибуту(Данные, "k", "a")).Равно(6);
    Ожидаем.Что(ЗначениеТочкиПоАтрибуту(Данные, "otel.metric.overflow", Истина)).Равно(1);

КонецПроцедуры

&Тест
Процедура ОтбрасываниеНеВозвращаетДанных() Экспорт

    // Дано
    АгрегаторБаза = Новый ОтелБазовыйАгрегатор(ОтелТипМетрики.Сумма(), Истина, "int");
    Агрегатор = Новый ПостроительНаследника(Новый ОтелАгрегаторDrop(), АгрегаторБаза).Построить();
    Хранилище = Новый ОтелХранилищеМетрики("drop.stream", "", "", Агрегатор, "Counter");

    // Когда
    Хранилище.Записать(1, Атрибуты("k", "a"));

    // Тогда
    Ожидаем.Что(Хранилище.ЭтоОтбрасывание()).ЭтоИстина();
    Ожидаем.Что(Хранилище.Собрать(Ресурс(), Область(), Кумулятивная())).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЭкземплярПереполненияСохраняетАтрибутыИзмерения() Экспорт

    // Дано
    Хранилище = ХранилищеСуммы();
    Хранилище.УстановитьЛимитМощности(1);
    Хранилище.УстановитьФильтрЭкземпляров(ОтелФильтрЭкземпляров.ВсегдаВключен());
    Хранилище.УстановитьФабрикуРезервуаров(Новый ОтелФабрикаПростыхРезервуаров(1));

    // Когда
    Хранилище.Записать(1, Атрибуты("k", "a"));
    Хранилище.Записать(2, Атрибуты("k", "b"));

    // Тогда - атрибуты измерения, не попавшие в точку переполнения, сохранены в exemplar
    Данные = Хранилище.Собрать(Ресурс(), Область(), Кумулятивная());
    ТочкаПереполнения = НайтиТочкуПоАтрибуту(Данные, "otel.metric.overflow", Истина);
    Экземпляры = ТочкаПереполнения.Получить("exemplars");
    Ожидаем.Что(Экземпляры).ИмеетДлину(1);
    Отфильтрованные = Экземпляры[0].Получить("filteredAttributes");
    Ожидаем.Что(Отфильтрованные).ИмеетДлину(1);
    Ожидаем.Что(Отфильтрованные[0].Получить("key")).Равно("k");

КонецПроцедуры

&Тест
Процедура ЭкземплярыОтносятсяКИнтервалуСбора() Экспорт

    // Дано
    Хранилище = ХранилищеСуммы();
    Хранилище.УстановитьФильтрЭкземпляров(ОтелФильтрЭкземпляров.ВсегдаВключен());
    Хранилище.УстановитьФабрикуРезервуаров(Новый ОтелФабрикаПростыхРезервуаров(1));
    Хранилище.Записать(1);
    Хранилище.Собрать(Ресурс(), Область(), Кумулятивная());

    // Когда - новых измерений не было
    Данные = Хранилище.Собрать(Ресурс(), Область(), Кумулятивная());

    // Тогда - точка есть, exemplars прошлого интервала не повторяются
    Ожидаем.Что(Данные.ТочкиДанных()[0].Получить("exemplars")).Равно(Неопределено);

КонецПроцедуры

// Metrics SDK / Exemplar: при выключенном сэмплировании exemplars SDK MUST NOT иметь связанных с
// ним накладных расходов, резервуары серий не создаются

&Тест
Процедура ФильтрВсегдаВыключенНеСоздаетРезервуары() Экспорт

    // Дано
    Фабрика = ФабрикаСоСчетчиком();
    Хранилище = ХранилищеСуммы();
    Хранилище.УстановитьФильтрЭкземпляров(ОтелФильтрЭкземпляров.ВсегдаВыключен());
    Хранилище.УстановитьФабрикуРезервуаров(Фабрика);

    // Когда
    Хранилище.Записать(1, Атрибуты("k", "a"));
    Хранилище.Записать(2, Атрибуты("k", "b"));
    Данные = Хранилище.Собрать(Ресурс(), Область(), Дельта());
    Хранилище.Записать(3, Атрибуты("k", "a"));

    // Тогда
    Ожидаем.Что(Данные.ТочкиДанных()).ИмеетДлину(2);
    Ожидаем.Что(Фабрика.Создано).Равно(0);

КонецПроцедуры

&Тест
Процедура ВключениеФильтраСоздаетРезервуарыСуществующихСерий() Экспорт

    // Дано - серия создана при выключенном фильтре
    Хранилище = ХранилищеСуммы();
    Хранилище.УстановитьФильтрЭкземпляров(ОтелФильтрЭкземпляров.ВсегдаВыключен());
    Хранилище.УстановитьФабрикуРезервуаров(Новый ОтелФабрикаПростыхРезервуаров(1));
    Хранилище.Записать(1);

    // Когда
    Хранилище.УстановитьФильтрЭкземпляров(ОтелФильтрЭкземпляров.ВсегдаВключен());
    Хранилище.Записать(2);
    Данные = Хранилище.Собрать(Ресурс(), Область(), Кумулятивная());

    // Тогда - измерение после включения фильтра попало в exemplar серии
    Экземпляры = Данные.ТочкиДанных()[0].Получить("exemplars");
    Ожидаем.Что(Экземпляры).ИмеетДлину(1);
    Ожидаем.Что(Экземпляры[0].Получить("asDouble")).Равно(2);

КонецПроцедуры

// Error handling: методы, принимающие внешний код, MUST обрабатывать все его ошибки. Сбой
// пользовательского резервуара exemplars не лишает сбор точки данных: точка выдается без exemplars

&ПараметризованныйТест
&ИсточникЗначение("исключение|Дельта")
&ИсточникЗначение("исключение|Кумулятивная")
&ИсточникЗначение("неопределено|Дельта")
&ИсточникЗначение("неопределено|Кумулятивная")
Процедура СбойСобратьРезервуараНеЛишаетСборТочки(Случай) Экспорт

    // Дано - Собрать резервуара выбрасывает исключение или возвращает Неопределено
    Части = СтрРазделить(Случай, "|");
    Хранилище = ХранилищеСуммы();
    Хранилище.УстановитьФильтрЭкземпляров(ОтелФильтрЭкземпляров.ВсегдаВключен());
    Хранилище.УстановитьФабрикуРезервуаров(СбойныйРезервуар(Части[0]));
    Хранилище.Записать(5);

    // Когда
    Данные = Хранилище.Собрать(Ресурс(), Область(), Временность(Части[1]));

    // Тогда
    Ожидаем.Что(Данные.ТочкиДанных()).ИмеетДлину(1);
    Ожидаем.Что(Данные.ТочкиДанных()[0].Получить("value")).Равно(5);
    Ожидаем.Что(Данные.ТочкиДанных()[0].Получить("exemplars")).Равно(Неопределено);

КонецПроцедуры

// Сбой фабрики резервуаров не отменяет измерение: серия остается без резервуара до следующего
// интервала сбора, в котором резервуар создается снова

&ПараметризованныйТест
&ИсточникЗначение("Дельта")
&ИсточникЗначение("Кумулятивная")
Процедура СбойСоздатьРезервуарНеОтменяетИзмерение(ИмяВременности) Экспорт

    // Дано - первый вызов СоздатьРезервуар выбрасывает исключение
    Хранилище = ХранилищеСуммы();
    Хранилище.УстановитьФильтрЭкземпляров(ОтелФильтрЭкземпляров.ВсегдаВключен());
    Хранилище.УстановитьФабрикуРезервуаров(ФабрикаСоСбоемНаВызове(1));

    // Когда
    Хранилище.Записать(5);
    Первые = Хранилище.Собрать(Ресурс(), Область(), Временность(ИмяВременности));
    Хранилище.Записать(7);
    Вторые = Хранилище.Собрать(Ресурс(), Область(), Временность(ИмяВременности));

    // Тогда - измерения агрегированы, в следующем интервале exemplar сохранен
    Ожидаем.Что(Первые.ТочкиДанных()[0].Получить("value")).Равно(5);
    Ожидаем.Что(Первые.ТочкиДанных()[0].Получить("exemplars")).Равно(Неопределено);
    Ожидаем.Что(Вторые.ТочкиДанных()[0].Получить("value")).Равно(?(ИмяВременности = "Дельта", 7, 12));
    Экземпляры = Вторые.ТочкиДанных()[0].Получить("exemplars");
    Ожидаем.Что(Экземпляры).ИмеетДлину(1);
    Ожидаем.Что(Экземпляры[0].Получить("asDouble")).Равно(7);

КонецПроцедуры

&Тест
Процедура СбойНовогоРезервуараПослеКумулятивногоСбораНеЛишаетСборТочки() Экспорт

    // Дано - второй вызов СоздатьРезервуар (новый резервуар серии после сбора) выбрасывает исключение
    Хранилище = ХранилищеСуммы();
    Хранилище.УстановитьФильтрЭкземпляров(ОтелФильтрЭкземпляров.ВсегдаВключен());
    Хранилище.УстановитьФабрикуРезервуаров(ФабрикаСоСбоемНаВызове(2));
    Хранилище.Записать(5);

    // Когда
    Первые = Хранилище.Собрать(Ресурс(), Область(), Кумулятивная());
    Хранилище.Записать(7);
    Вторые = Хранилище.Собрать(Ресурс(), Область(), Кумулятивная());

    // Тогда
    Ожидаем.Что(Первые.ТочкиДанных()[0].Получить("exemplars")).ИмеетДлину(1);
    Ожидаем.Что(Вторые.ТочкиДанных()[0].Получить("value")).Равно(12);
    Ожидаем.Что(Вторые.ТочкиДанных()[0].Получить("exemplars")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СбойОчисткиОбщегоРезервуараНеЛишаетСборТочки() Экспорт

    // Дано - общий резервуар потока (устаревший способ), Очистить выбрасывает исключение
    Хранилище = ХранилищеСуммы();
    Хранилище.УстановитьФильтрЭкземпляров(ОтелФильтрЭкземпляров.ВсегдаВключен());
    Хранилище.УстановитьРезервуарЭкземпляров(СбойныйРезервуар("", Истина));
    Хранилище.Записать(5);

    // Когда
    Данные = Хранилище.Собрать(Ресурс(), Область(), Кумулятивная());

    // Тогда
    Ожидаем.Что(Данные.ТочкиДанных()[0].Получить("value")).Равно(5);

КонецПроцедуры

&Тест
Процедура КонкурентнаяЗаписьНовогоНабораНеВызываетПереполнения() Экспорт

    // Дано - лимит в один набор, задания пишут один и тот же новый набор
    Хранилище = ХранилищеСуммы();
    Хранилище.УстановитьЛимитМощности(1);
    ПодготовитьЗадания(8, 200);

    // Когда
    Задания = ЗапуститьЗадания("ЗаписатьОдинНабор");

    // Тогда
    ПроверитьЗадания(Задания);
    Данные = Хранилище.Собрать(Ресурс(), Область(), Кумулятивная());
    Ожидаем.Что(Данные.ТочкиДанных(), "точки без переполнения").ИмеетДлину(1);
    Ожидаем.Что(Данные.ТочкиДанных()[0].Получить("value")).Равно(КоличествоЗаданий * НаЗадание);

КонецПроцедуры

&Тест
Процедура ДельтаСборПриКонкурентнойЗаписиНеТеряетИзмерений() Экспорт

    // Дано
    Хранилище = ХранилищеСуммы();
    ПодготовитьЗадания(4, 500);

    // Когда - задания пишут, пока идут дельта-сборы
    Задания = ЗапуститьЗаданияБезОжидания("ЗаписатьНаборыЗадания");
    Собрано = 0;
    Пока Завершено.Получить() < КоличествоЗаданий Цикл
        Собрано = Собрано + СуммаЗначений(Хранилище.Собрать(Ресурс(), Область(), Дельта()));
    КонецЦикла;
    ФоновыеЗадания.ОжидатьВсе(Задания);
    Собрано = Собрано + СуммаЗначений(Хранилище.Собрать(Ресурс(), Область(), Дельта()));

    // Тогда - каждое измерение попало ровно в один интервал
    ПроверитьЗадания(Задания);
    Ожидаем.Что(Собрано).Равно(КоличествоЗаданий * НаЗадание);

КонецПроцедуры

// Выполняется фоновыми заданиями: пишет один набор атрибутов.
//
Процедура ЗаписатьОдинНабор(НомерЗадания) Экспорт // BSLLS:UnusedParameters-off
    ДождатьсяОбщегоСтарта();
    Для Номер = 1 По НаЗадание Цикл // BSLLS:UnusedLocalVariable-off
        Хранилище.Записать(1, Атрибуты("k", "shared"));
    КонецЦикла;
КонецПроцедуры

// Выполняется фоновыми заданиями: пишет по единице в несколько наборов.
//
Процедура ЗаписатьНаборыЗадания(НомерЗадания) Экспорт
    ДождатьсяОбщегоСтарта();
    Попытка
        Для Номер = 1 По НаЗадание Цикл
            Хранилище.Записать(1, Атрибуты("k", Формат(НомерЗадания * 10 + Номер % 3, "ЧГ=")));
        КонецЦикла;
    Исключение
        Завершено.ИнкрементироватьИПолучить();
        ВызватьИсключение;
    КонецПопытки;
    Завершено.ИнкрементироватьИПолучить();
КонецПроцедуры

#Область Служебные

Функция ХранилищеСуммы()
    АгрегаторБаза = Новый ОтелБазовыйАгрегатор(ОтелТипМетрики.Сумма(), Истина, "int");
    Агрегатор = Новый ПостроительНаследника(Новый ОтелАгрегаторСуммы(), АгрегаторБаза).Построить();
    Возврат Новый ОтелХранилищеМетрики("stream.name", "описание потока", "ms", Агрегатор, "Counter");
КонецФункции

Функция Ресурс()
    Возврат Новый ОтелРесурс(Истина);
КонецФункции

Функция Область()
    Возврат Новый ОтелОбластьИнструментирования("test-lib", "1.0");
КонецФункции

Функция Кумулятивная()
    Возврат ОтелВременнаяАгрегация.Кумулятивная();
КонецФункции

Функция Дельта()
    Возврат ОтелВременнаяАгрегация.Дельта();
КонецФункции

// Фабрика простых резервуаров, считающая созданные резервуары.
Функция ФабрикаСоСчетчиком()
    Текст = "Перем Создано Экспорт;
    |Функция СоздатьРезервуар() Экспорт
    |    Создано = Создано + 1;
    |    Возврат Новый ОтелРезервуарЭкземпляров(1);
    |КонецФункции
    |Создано = 0;";
    Возврат ЗагрузитьСценарийИзСтроки(Текст);
КонецФункции

Функция Временность(Имя)
    Возврат ?(Имя = "Дельта", Дельта(), Кумулятивная());
КонецФункции

// Фабрика простых резервуаров, вызов СоздатьРезервуар с заданным номером выбрасывает исключение.
Функция ФабрикаСоСбоемНаВызове(НомерВызова)
    Текст = "Перем Создано Экспорт;
    |Перем НомерСбоя Экспорт;
    |Функция СоздатьРезервуар() Экспорт
    |    Создано = Создано + 1;
    |    Если Создано = НомерСбоя Тогда
    |        ВызватьИсключение ""тест: сбой фабрики резервуаров"";
    |    КонецЕсли;
    |    Возврат Новый ОтелРезервуарЭкземпляров(1);
    |КонецФункции
    |Создано = 0;";
    Фабрика = ЗагрузитьСценарийИзСтроки(Текст);
    Фабрика.НомерСбоя = НомерВызова;
    Возврат Фабрика;
КонецФункции

// Резервуар со сбоями, он же своя фабрика: СоздатьРезервуар возвращает сам резервуар.
//
// Параметры:
//   СбойСобрать - Строка - "исключение": Собрать выбрасывает исключение, "неопределено" - возвращает
//       Неопределено; иначе пустой массив
//   СбойОчистить - Булево - Очистить выбрасывает исключение
//
Функция СбойныйРезервуар(СбойСобрать, СбойОчистить = Ложь)
    Текст = "Перем СбойСобрать Экспорт;
    |Перем СбойОчистить Экспорт;
    |Функция СоздатьРезервуар() Экспорт
    |    Возврат ЭтотОбъект;
    |КонецФункции
    |Процедура Предложить(КлючАтрибутов, Значение, АтрибутыИзмерения, АтрибутыСерии,
    |        КонтекстСпана = Неопределено, Timestamp = Неопределено, Контекст = Неопределено) Экспорт
    |КонецПроцедуры
    |Функция Собрать(КлючАтрибутов) Экспорт
    |    Если СбойСобрать = ""исключение"" Тогда
    |        ВызватьИсключение ""тест: сбой Собрать резервуара"";
    |    ИначеЕсли СбойСобрать = ""неопределено"" Тогда
    |        Возврат Неопределено;
    |    КонецЕсли;
    |    Возврат Новый Массив();
    |КонецФункции
    |Процедура Очистить() Экспорт
    |    Если СбойОчистить Тогда
    |        ВызватьИсключение ""тест: сбой Очистить резервуара"";
    |    КонецЕсли;
    |КонецПроцедуры";
    Резервуар = ЗагрузитьСценарийИзСтроки(Текст);
    Резервуар.СбойСобрать = СбойСобрать;
    Резервуар.СбойОчистить = СбойОчистить;
    Возврат Резервуар;
КонецФункции

Функция Ключи(Ключ1, Ключ2 = Неопределено)
    Результат = Новый Массив();
    Результат.Добавить(Ключ1);
    Если Ключ2 <> Неопределено Тогда
        Результат.Добавить(Ключ2);
    КонецЕсли;
    Возврат Результат;
КонецФункции

// BSLLS:NumberOfOptionalParams-off
Функция Атрибуты(Ключ1, Значение1, Ключ2 = Неопределено, Значение2 = Неопределено,
        Ключ3 = Неопределено, Значение3 = Неопределено)
// BSLLS:NumberOfOptionalParams-on
    Результат = Новый ОтелАтрибуты();
    Результат.Установить(Ключ1, Значение1);
    Если Ключ2 <> Неопределено Тогда
        Результат.Установить(Ключ2, Значение2);
    КонецЕсли;
    Если Ключ3 <> Неопределено Тогда
        Результат.Установить(Ключ3, Значение3);
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ЕдинственнаяТочка(ХранилищеПотока)
    Данные = ХранилищеПотока.Собрать(Ресурс(), Область(), Кумулятивная());
    Ожидаем.Что(Данные.ТочкиДанных()).ИмеетДлину(1);
    Возврат Данные.ТочкиДанных()[0];
КонецФункции

Функция КлючиАтрибутовТочки(Точка)
    Ключи = Новый СписокЗначений();
    Для Каждого Атрибут Из Точка.Получить("attributes") Цикл
        Ключи.Добавить(Атрибут.Получить("key"));
    КонецЦикла;
    Ключи.СортироватьПоЗначению();
    Возврат СтрСоединить(Ключи.ВыгрузитьЗначения(), ",");
КонецФункции

Функция ЗначениеАтрибутаТочки(Точка, Ключ)
    Для Каждого Атрибут Из Точка.Получить("attributes") Цикл
        Если Атрибут.Получить("key") = Ключ Тогда
            Значение = Атрибут.Получить("value");
            Для Каждого ТипИЗначение Из Значение Цикл
                Возврат ТипИЗначение.Значение;
            КонецЦикла;
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

Функция НайтиТочкуПоАтрибуту(Данные, Ключ, Значение)
    Для Каждого Точка Из Данные.ТочкиДанных() Цикл
        Если ЗначениеАтрибутаТочки(Точка, Ключ) = Значение Тогда
            Возврат Точка;
        КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

Функция ЗначениеТочкиПоАтрибуту(Данные, Ключ, Значение)
    Точка = НайтиТочкуПоАтрибуту(Данные, Ключ, Значение);
    Если Точка = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат Точка.Получить("value");
КонецФункции

Функция СуммаЗначений(Данные)
    Если Данные = Неопределено Тогда
        Возврат 0;
    КонецЕсли;
    Сумма = 0;
    Для Каждого Точка Из Данные.ТочкиДанных() Цикл
        Сумма = Сумма + Точка.Получить("value");
    КонецЦикла;
    Возврат Сумма;
КонецФункции

Процедура ПодготовитьЗадания(Заданий, Записей)
    КоличествоЗаданий = Заданий;
    НаЗадание = Записей;
    Прибыло = Новый АтомарноеЧисло(0);
    Завершено = Новый АтомарноеЧисло(0);
КонецПроцедуры

Функция ЗапуститьЗадания(ИмяМетода)
    Задания = ЗапуститьЗаданияБезОжидания(ИмяМетода);
    ФоновыеЗадания.ОжидатьВсе(Задания);
    Возврат Задания;
КонецФункции

Функция ЗапуститьЗаданияБезОжидания(ИмяМетода)
    Задания = Новый Массив();
    Для НомерЗадания = 1 По КоличествоЗаданий Цикл
        Параметры = Новый Массив();
        Параметры.Добавить(НомерЗадания);
        Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, ИмяМетода, Параметры));
    КонецЦикла;
    Возврат Задания;
КонецФункции

Процедура ПроверитьЗадания(Задания)
    Для Каждого Задание Из Задания Цикл
        Ожидаем.Что(Задание.ИнформацияОбОшибке, "ошибка фонового задания").Равно(Неопределено);
    КонецЦикла;
КонецПроцедуры

// Задания стартуют одновременно: каждое ждет, пока до барьера дойдут все.
//
Процедура ДождатьсяОбщегоСтарта()
    ТаймаутБарьераМс = 30000;
    ВитковДоУступки = 1000;
    Прибыло.ИнкрементироватьИПолучить();
    НачалоОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Витков = 0;
    Пока Прибыло.Получить() < КоличествоЗаданий Цикл
        Витков = Витков + 1;
        Если Витков % ВитковДоУступки = 0 Тогда
            Приостановить(0);
        КонецЕсли;
        Если ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжидания > ТаймаутБарьераМс Тогда
            Возврат;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

#КонецОбласти
