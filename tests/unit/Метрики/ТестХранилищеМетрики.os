&Тест
Процедура РазрешенныеИИсключенныеКлючиПрименяютсяВместе() Экспорт

    // Дано
    Хранилище = ХранилищеСуммы();
    Хранилище.УстановитьФильтрАтрибутов(Ключи("a", "b"), Ключи("b"));

    // Когда
    Хранилище.Записать(1, Атрибуты("a", 1, "b", 2, "c", 3));

    // Тогда
    Точка = ЕдинственнаяТочка(Хранилище);
    Ожидаем.Что(КлючиАтрибутовТочки(Точка)).Равно("a");

