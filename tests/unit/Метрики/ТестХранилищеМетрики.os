&Тест
Процедура ИзменениеАтрибутовПослеЗаписиНеМеняетСерию() Экспорт

    // Дано
    Хранилище = ХранилищеСуммы();
    ОбщиеАтрибуты = Атрибуты("route", "/a");
    Хранилище.Записать(1, ОбщиеАтрибуты);

