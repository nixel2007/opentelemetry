// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать "../../.."
#Использовать asserts

// Trace SDK, AlwaysRecord: DROP -> RECORD_ONLY, RECORD_ONLY -> RECORD_ONLY,
// RECORD_AND_SAMPLE -> RECORD_AND_SAMPLE

&Тест
Процедура AlwaysRecordПоднимаетDropДоRecordOnly() Экспорт
    // Дано
    Сэмплер = ОтелСэмплер.ВсегдаЗаписывать(ОтелСэмплер.ВсегдаВыключен());

    // Когда
    Решение = Сэмплировать(Сэмплер).Решение();

    // Тогда
    Ожидаем.Что(Решение).Равно(ОтелСэмплер.РешениеЗаписать());
КонецПроцедуры

&Тест
Процедура AlwaysRecordСохраняетRecordAndSample() Экспорт
    // Дано
    Сэмплер = ОтелСэмплер.ВсегдаЗаписывать(ОтелСэмплер.ВсегдаВключен());

    // Когда
    Решение = Сэмплировать(Сэмплер).Решение();

    // Тогда
    Ожидаем.Что(Решение).Равно(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
КонецПроцедуры

&Тест
Процедура AlwaysRecordСохраняетRecordOnly() Экспорт
    // Дано - обернутый сэмплер возвращает RECORD_ONLY
    Сэмплер = ОтелСэмплер.ВсегдаЗаписывать(ОтелСэмплер.ВсегдаЗаписывать(ОтелСэмплер.ВсегдаВыключен()));

    // Когда
    Решение = Сэмплировать(Сэмплер).Решение();

    // Тогда
    Ожидаем.Что(Решение).Равно(ОтелСэмплер.РешениеЗаписать());
КонецПроцедуры

&Тест
Процедура AlwaysRecordПоднимаетDropОтСэмплераПоДоле() Экспорт
    // Дано - обернутый сэмплер по доле 0.0 отбрасывает все
    Сэмплер = ОтелСэмплер.ВсегдаЗаписывать(ОтелСэмплер.ПоДолеТрассировок(0.0));

    // Когда
    Решение = Сэмплировать(Сэмплер).Решение();

    // Тогда
    Ожидаем.Что(Решение).Равно(ОтелСэмплер.РешениеЗаписать());
КонецПроцедуры

&Тест
Процедура AlwaysRecordСохраняетTraceStateИАтрибутыОбернутого() Экспорт
    // Дано - пользовательский сэмплер отбрасывает спан, задает атрибут и TraceState
    Сэмплер = ОтелСэмплер.ВсегдаЗаписывать(ОтбрасывающийСАтрибутом());

    // Когда
    Результат = Сэмплировать(Сэмплер);

    // Тогда - решение поднято, атрибуты и TraceState обернутого сэмплера сохранены
    Ожидаем.Что(Результат.Решение()).Равно(ОтелСэмплер.РешениеЗаписать());
    Ожидаем.Что(Результат.Атрибуты().Получить("sampler.reason")).Равно("drop");
    Ожидаем.Что(Результат.СостояниеТрассировки().Получить("vendor")).Равно("value");
КонецПроцедуры

&Тест
Процедура AlwaysRecordОписаниеСодержитОбернутый() Экспорт
    // Тогда
    Ожидаем.Что(ОтелСэмплер.ВсегдаЗаписывать(ОтелСэмплер.ВсегдаВыключен()).Описание())
        .Равно("AlwaysRecord{AlwaysOffSampler}");
    Ожидаем.Что(ОтелСэмплер.ВсегдаЗаписывать(ОтелСэмплер.ПоДолеТрассировок(0.5)).Описание())
        .Равно("AlwaysRecord{TraceIdRatioBased{0.500000}}");
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция Сэмплировать(Сэмплер)
    Контекст = Новый ФиксированноеСоответствие(Новый Соответствие());
    Возврат Сэмплер.ДолженСэмплировать(Контекст, "0af7651916cd43dd8448eb211c80319c", "span",
        ОтелВидСпана.Внутренний(), Неопределено, Неопределено);
КонецФункции

// Пользовательский сэмплер: отбрасывает спан, задает атрибут и TraceState.
Функция ОтбрасывающийСАтрибутом()
    Текст = "Функция ДолженСэмплировать(Контекст, ИдТрассировки, ИмяСпана, ВидСпана, Атрибуты, Линки) Экспорт
    |    НовыеАтрибуты = Новый ОтелАтрибуты();
    |    НовыеАтрибуты.Установить(""sampler.reason"", ""drop"");
    |    Состояние = Новый ОтелСостояниеТрассировки();
    |    Возврат Новый ОтелРезультатСэмплирования(ОтелСэмплер.РешениеОтбросить(), НовыеАтрибуты,
    |        Состояние.Установить(""vendor"", ""value""));
    |КонецФункции
    |Функция Описание() Экспорт
    |    Возврат ""DropWithAttribute"";
    |КонецФункции";
    Возврат ЗагрузитьСценарийИзСтроки(Текст);
КонецФункции

#КонецОбласти
