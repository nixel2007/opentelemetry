// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
#Использовать "../../.."
#Использовать asserts

// --- AlwaysOn и AlwaysOff ---

&Тест
Процедура ВсегдаВключенЗаписываетИЭкспортирует() Экспорт
    // Дано
    Сэмплер = ОтелСэмплер.ВсегдаВключен();

    // Когда
    Результат = Сэмплировать(Сэмплер, КорневойКонтекст());

    // Тогда
    Ожидаем.Что(Результат.Решение()).Равно(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
    Ожидаем.Что(Результат.Атрибуты().Количество()).Равно(0);
    Ожидаем.Что(Результат.СостояниеТрассировки()).Равно(Неопределено);
КонецПроцедуры

&Тест
Процедура ВсегдаВыключенОтбрасывает() Экспорт
    // Дано
    Сэмплер = ОтелСэмплер.ВсегдаВыключен();

    // Когда
    Результат = Сэмплировать(Сэмплер, КорневойКонтекст());

    // Тогда
    Ожидаем.Что(Результат.Решение()).Равно(ОтелСэмплер.РешениеОтбросить());
КонецПроцедуры

&Тест
Процедура РешениеЗаписатьВозвращаетЕдиницу() Экспорт
    // Тогда
    Ожидаем.Что(ОтелСэмплер.РешениеЗаписать()).Равно(1);
КонецПроцедуры

&Тест
Процедура ОписаниеВсегдаВключенИВсегдаВыключен() Экспорт
    // Тогда - Trace SDK: описание MUST быть AlwaysOnSampler и AlwaysOffSampler
    Ожидаем.Что(ОтелСэмплер.ВсегдаВключен().Описание()).Равно("AlwaysOnSampler");
    Ожидаем.Что(ОтелСэмплер.ВсегдаВыключен().Описание()).Равно("AlwaysOffSampler");
КонецПроцедуры

// --- TraceIdRatioBased ---

&Тест
Процедура ПоДолеТрассировокНоль() Экспорт
    // Дано - доля 0.0 отбрасывает все трассировки
    Сэмплер = ОтелСэмплер.ПоДолеТрассировок(0.0);

    // Когда
    Решение = Сэмплировать(Сэмплер, КорневойКонтекст()).Решение();

    // Тогда
    Ожидаем.Что(Решение).Равно(ОтелСэмплер.РешениеОтбросить());
КонецПроцедуры

&Тест
Процедура ПоДолеТрассировокЕдиница() Экспорт
    // Дано - доля 1.0 сэмплирует все трассировки
    Сэмплер = ОтелСэмплер.ПоДолеТрассировок(1.0);

    // Когда
    Решение = Сэмплировать(Сэмплер, КорневойКонтекст()).Решение();

    // Тогда
    Ожидаем.Что(Решение).Равно(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
КонецПроцедуры

&Тест
Процедура ПоДолеТрассировокПоловина() Экспорт
    // Дано - доля 0.5: порог отбора 2^55 для значения случайности из правых 7 байт trace ID
    Сэмплер = ОтелСэмплер.ПоДолеТрассировок(0.5);

    // Когда
    РешениеВысокой = Сэмплировать(Сэмплер, КорневойКонтекст(), ИдВысокойСлучайности()).Решение();
    РешениеНизкой = Сэмплировать(Сэмплер, КорневойКонтекст(), ИдНизкойСлучайности()).Решение();

    // Тогда - значение не ниже порога сэмплируется, ниже порога - отбрасывается
    Ожидаем.Что(РешениеВысокой).Равно(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
    Ожидаем.Что(РешениеНизкой).Равно(ОтелСэмплер.РешениеОтбросить());
КонецПроцедуры

&Тест
Процедура ПоДолеТрассировокПустойТрейсИд() Экспорт
    // Дано
    Сэмплер = ОтелСэмплер.ПоДолеТрассировок(0.5);

    // Когда - пустой trace ID
    Решение = Сэмплировать(Сэмплер, КорневойКонтекст(), "").Решение();

    // Тогда - спан сэмплируется
    Ожидаем.Что(Решение).Равно(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
КонецПроцедуры

&Тест
Процедура ПоДолеТрассировокНевалидныйТрейсИд() Экспорт
    // Дано - trace ID с нешестнадцатеричными символами в правых 7 байтах
    Сэмплер = ОтелСэмплер.ПоДолеТрассировок(0.5);

    // Когда
    Решение = Сэмплировать(Сэмплер, КорневойКонтекст(), "0af7651916cd43ddZZZZZZZZZZZZZZZZ").Решение();

    // Тогда - значение случайности не вычисляется, спан сэмплируется
    Ожидаем.Что(Решение).Равно(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
КонецПроцедуры

// Trace SDK: TraceIdRatioBased MUST ignore the parent SampledFlag
&Тест
Процедура ПоДолеТрассировокНеУчитываетФлагРодителя() Экспорт
    // Дано - родители с флагом sampled и без него
    КонтекстСФлагом = КонтекстРодителя(Истина, Ложь);
    КонтекстБезФлага = КонтекстРодителя(Ложь, Ложь);

    // Когда
    РешениеВсех = Сэмплировать(ОтелСэмплер.ПоДолеТрассировок(1.0), КонтекстБезФлага).Решение();
    РешениеНикого = Сэмплировать(ОтелСэмплер.ПоДолеТрассировок(0.0), КонтекстСФлагом).Решение();

    // Тогда - решение задает только доля
    Ожидаем.Что(РешениеВсех).Равно(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
    Ожидаем.Что(РешениеНикого).Равно(ОтелСэмплер.РешениеОтбросить());
КонецПроцедуры

// TraceIdRatioBased: решение - детерминированная функция TraceId. Sub-key rv TraceState
// (explicit randomness) относится к Development-разделу Sampling Requirements и не учитывается
&ПараметризованныйТест
&ИсточникЗначение("0000000000000000ffffffffffffffff|00000000000000")
&ИсточникЗначение("00000000000000000000000000000001|ffffffffffffff")
Процедура ПоДолеТрассировокНеУчитываетRvИзTraceState(Случай) Экспорт
    // Дано - rv в TraceState родителя дает решение, противоположное решению по trace ID
    Части = СтрРазделить(Случай, "|");
    ИдТрассировки = Части[0];
    СостояниеРодителя = Новый ОтелСостояниеТрассировки();
    СостояниеРодителя = СостояниеРодителя.Установить("ot", "rv:" + Части[1]);
    Сэмплер = ОтелСэмплер.ПоДолеТрассировок(0.5);

    // Когда
    РешениеСRv = Сэмплировать(Сэмплер, КонтекстРодителя(Истина, Ложь, ИдТрассировки, СостояниеРодителя),
        ИдТрассировки).Решение();
    РешениеПоИд = Сэмплировать(Сэмплер, КорневойКонтекст(), ИдТрассировки).Решение();

    // Тогда
    Ожидаем.Что(РешениеСRv).Равно(РешениеПоИд);
КонецПроцедуры

&Тест
Процедура ПоДолеТрассировокСоблюдаетДолюНаИдПоУмолчанию() Экспорт
    // Дано - trace ID из генератора по умолчанию. UUIDv4 содержит фиксированные биты
    // версии и варианта, случайны только правые 7 байт (W3C Trace Context Level 2).
    // Допуск 0.05 при 2000 ID - более 4 стандартных отклонений.
    КоличествоИд = 2000;
    Допуск = 0.05;
    Идентификаторы = Новый Массив;
    Для Номер = 1 По КоличествоИд Цикл // BSLLS:UnusedLocalVariable-off
        Идентификаторы.Добавить(ОтелУтилиты.СгенерироватьИдТрассировки());
    КонецЦикла;

    Для Каждого Доля Из ДолиДляПроверки() Цикл
        // Когда
        Отобрано = 0;
        Для Каждого ИдТрассировки Из Идентификаторы Цикл
            Если ОтобранаПоДоле(Доля, ИдТрассировки) Тогда
                Отобрано = Отобрано + 1;
            КонецЕсли;
        КонецЦикла;

        // Тогда
        ФактическаяДоля = Отобрано / КоличествоИд;
        Ожидаем.Что(ФактическаяДоля, "фактическая доля при ratio=" + Доля)
            .Между(Доля - Допуск, Доля + Допуск);
    КонецЦикла;
КонецПроцедуры

&Тест
Процедура ПоДолеТрассировокБольшаяДоляВключаетВсеТрассировкиМеньшей() Экспорт
    // Дано - спека: сэмплер с большей долей MUST сэмплировать все трассировки,
    // которые сэмплирует сэмплер с меньшей долей
    КоличествоИд = 500;
    МеньшаяДоля = 0.2;
    БольшаяДоля = 0.6;

    Для Номер = 1 По КоличествоИд Цикл // BSLLS:UnusedLocalVariable-off
        ИдТрассировки = ОтелУтилиты.СгенерироватьИдТрассировки();

        // Когда
        ОтобранаМеньшей = ОтобранаПоДоле(МеньшаяДоля, ИдТрассировки);
        ОтобранаБольшей = ОтобранаПоДоле(БольшаяДоля, ИдТрассировки);

        // Тогда
        Если ОтобранаМеньшей Тогда
            Ожидаем.Что(ОтобранаБольшей, "trace ID " + ИдТрассировки).Равно(Истина);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

// TraceIdRatioBased: точность доли в описании SHOULD различать сэмплеры с разными долями
&Тест
Процедура ОписаниеПоДолеРазличаетДолиПослеШестогоЗнака() Экспорт
    // Когда - доли различаются только седьмым знаком после точки
    Описание1 = ОтелСэмплер.ПоДолеТрассировок(0.1234561).Описание();
    Описание2 = ОтелСэмплер.ПоДолеТрассировок(0.1234564).Описание();

    // Тогда
    Ожидаем.Что(Описание1).Равно("TraceIdRatioBased{0.1234561}");
    Ожидаем.Что(Описание2).Равно("TraceIdRatioBased{0.1234564}");
КонецПроцедуры

&Тест
Процедура ОписаниеПоДолеШестьюЗнаками() Экспорт
    // Когда - доля без значащих знаков после шестого
    Описание = ОтелСэмплер.ПоДолеТрассировок(0.25).Описание();

    // Тогда
    Ожидаем.Что(Описание).Равно("TraceIdRatioBased{0.250000}");
КонецПроцедуры

// --- ParentBased ---

&ПараметризованныйТест
&ИсточникЗначение("ВсегдаВключен")
&ИсточникЗначение("ВсегдаВыключен")
Процедура НаОсновеРодителяБезРодителяВызываетКорневой(Корневой) Экспорт
    // Дано
    Сэмплер = ОтелСэмплер.НаОсновеРодителя(СэмплерВида(Корневой));

    // Когда
    Решение = Сэмплировать(Сэмплер, КорневойКонтекст()).Решение();

    // Тогда
    Ожидаем.Что(Решение).Равно(РешениеСэмплирования(Корневой = "ВсегдаВключен"));
КонецПроцедуры

&Тест
Процедура НаОсновеРодителяНевалидныйРодительВызываетКорневой() Экспорт
    // Дано - в контексте спан с невалидным контекстом: это корневой спан. Делегат
    // локального несэмплированного родителя отбросил бы спан
    Сэмплер = ОтелСэмплер.НаОсновеРодителя(ОтелСэмплер.ВсегдаВключен());
    Контекст = ОтелКонтекст.КонтекстСоСпаном(Новый Соответствие(), ОтелСпаны.Невалидный());

    // Когда
    Решение = Сэмплировать(Сэмплер, Контекст).Решение();

    // Тогда
    Ожидаем.Что(Решение).Равно(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("УдаленныйСэмплирован")
&ИсточникЗначение("УдаленныйНеСэмплирован")
&ИсточникЗначение("ЛокальныйСэмплирован")
&ИсточникЗначение("ЛокальныйНеСэмплирован")
Процедура НаОсновеРодителяДелегатыПоУмолчанию(Сценарий) Экспорт
    // Дано - корневой сэмплер отбрасывает все: решение принимают делегаты по умолчанию
    Сэмплер = ОтелСэмплер.НаОсновеРодителя(ОтелСэмплер.ВсегдаВыключен());
    Сэмплирован = СтрНайти(Сценарий, "НеСэмплирован") = 0;
    Удаленный = СтрНачинаетсяС(Сценарий, "Удаленный");

    // Когда
    Решение = Сэмплировать(Сэмплер, КонтекстРодителя(Сэмплирован, Удаленный)).Решение();

    // Тогда - родитель с флагом sampled: AlwaysOn, без флага: AlwaysOff
    Ожидаем.Что(Решение).Равно(РешениеСэмплирования(Сэмплирован));
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("УдаленныйСэмплирован")
&ИсточникЗначение("УдаленныйНеСэмплирован")
&ИсточникЗначение("ЛокальныйСэмплирован")
&ИсточникЗначение("ЛокальныйНеСэмплирован")
Процедура НаОсновеРодителяВыбираетДелегата(Сценарий) Экспорт
    // Дано - каждый делегат принимает решение, противоположное делегату по умолчанию
    Сэмплер = ОтелСэмплер.НаОсновеРодителя(ОтелСэмплер.ВсегдаВключен(),
        ОтелСэмплер.ВсегдаВыключен(), ОтелСэмплер.ВсегдаВключен(),
        ОтелСэмплер.ВсегдаВыключен(), ОтелСэмплер.ВсегдаВключен());
    Сэмплирован = СтрНайти(Сценарий, "НеСэмплирован") = 0;
    Удаленный = СтрНачинаетсяС(Сценарий, "Удаленный");

    // Когда
    Решение = Сэмплировать(Сэмплер, КонтекстРодителя(Сэмплирован, Удаленный)).Решение();

    // Тогда - решение принял делегат своего сценария
    Ожидаем.Что(Решение).Равно(РешениеСэмплирования(НЕ Сэмплирован));
КонецПроцедуры

// Trace SDK: делегаты ParentBased - сэмплеры со своими параметрами
&Тест
Процедура НаОсновеРодителяДелегатПоДолеИспользуетСвоюДолю() Экспорт
    // Дано - корень отбрасывает все трассировки, делегат удаленного сэмплированного родителя
    // отбирает половину по своей доле 0.5
    Сэмплер = ОтелСэмплер.НаОсновеРодителя(
        ОтелСэмплер.ПоДолеТрассировок(0.0), ОтелСэмплер.ПоДолеТрассировок(0.5));
    ИдВысокой = ИдВысокойСлучайности();
    ИдНизкой = ИдНизкойСлучайности();

    // Когда
    РешениеВысокой = Сэмплировать(Сэмплер, КонтекстРодителя(Истина, Истина, ИдВысокой), ИдВысокой).Решение();
    РешениеНизкой = Сэмплировать(Сэмплер, КонтекстРодителя(Истина, Истина, ИдНизкой), ИдНизкой).Решение();
    РешениеКорня = Сэмплировать(Сэмплер, КорневойКонтекст(), ИдВысокой).Решение();

    // Тогда - делегат решает по доле 0.5, корень - по доле 0
    Ожидаем.Что(РешениеВысокой).Равно(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
    Ожидаем.Что(РешениеНизкой).Равно(ОтелСэмплер.РешениеОтбросить());
    Ожидаем.Что(РешениеКорня).Равно(ОтелСэмплер.РешениеОтбросить());
КонецПроцедуры

&Тест
Процедура ОписаниеНаОсновеРодителяСодержитКорневойИДелегатов() Экспорт
    // Дано
    Корневой = ОтелСэмплер.ПоДолеТрассировок(0.1);
    УдаленныйРодительНеСэмплирован = ОтелСэмплер.ПоДолеТрассировок(0.5);
    Сэмплер = ОтелСэмплер.НаОсновеРодителя(Корневой, Неопределено, УдаленныйРодительНеСэмплирован);

    // Когда
    Описание = Сэмплер.Описание();

    // Тогда
    Ожидаем.Что(Описание).Равно("ParentBased{root:TraceIdRatioBased{0.100000},"
        + "remoteParentSampled:AlwaysOnSampler,"
        + "remoteParentNotSampled:TraceIdRatioBased{0.500000},"
        + "localParentSampled:AlwaysOnSampler,"
        + "localParentNotSampled:AlwaysOffSampler}");
КонецПроцедуры

// --- TraceState и атрибуты результата ---

// Trace SDK, ShouldSample: сэмплеры SHOULD возвращать переданный TraceState, если не меняют его.
// Результат без TraceState сохраняет TraceState родителя (как SamplingResult в Java SDK)
&ПараметризованныйТест
&ИсточникЗначение("ВсегдаВключен")
&ИсточникЗначение("ВсегдаВыключен")
&ИсточникЗначение("ПоДолеТрассировок")
&ИсточникЗначение("НаОсновеРодителя")
&ИсточникЗначение("ВсегдаЗаписывать")
Процедура ВстроенныйСэмплерНеМеняетTraceState(ВидСэмплера) Экспорт
    // Дано - TraceState родителя с rv и записью вендора
    СостояниеРодителя = Новый ОтелСостояниеТрассировки();
    СостояниеРодителя = СостояниеРодителя.Установить("ot", "rv:abc123");
    СостояниеРодителя = СостояниеРодителя.Установить("vendor", "data");
    Контекст = КонтекстРодителя(Истина, Ложь, ИдТрассировкиПоУмолчанию(), СостояниеРодителя);

    // Когда
    Результат = Сэмплировать(СэмплерВида(ВидСэмплера), Контекст);

    // Тогда
    Ожидаем.Что(Результат.СостояниеТрассировки()).Равно(Неопределено);
КонецПроцедуры

&Тест
Процедура РезультатРешенияНеизменяемИКэшируется() Экспорт
    // Когда
    Результат = ОтелСэмплер.Результат(ОтелСэмплер.РешениеЗаписать());

    // Тогда - результат без атрибутов, не меняющий TraceState; повторный вызов не создает объект
    Ожидаем.Что(Результат.Решение()).Равно(ОтелСэмплер.РешениеЗаписать());
    Ожидаем.Что(Результат.Атрибуты().Количество()).Равно(0);
    Ожидаем.Что(Результат.СостояниеТрассировки()).Равно(Неопределено);
    Ожидаем.Что(ОтелСэмплер.Результат(ОтелСэмплер.РешениеЗаписать())).Равно(Результат);
КонецПроцедуры

// Trace SDK, ShouldSample: атрибуты результата неизменяемы
&Тест
Процедура АтрибутыРезультатаНеизменяемы() Экспорт
    // Дано
    Атрибуты = Новый ОтелАтрибуты();
    Атрибуты.Установить("sampling.priority", 1);
    Результат = Новый ОтелРезультатСэмплирования(ОтелСэмплер.РешениеЗаписатьИЭкспортировать(), Атрибуты);

    // Когда - исходный набор меняется после создания результата
    Атрибуты.Установить("sampling.priority", 2);

    // Тогда
    Ожидаем.Что(Результат.Атрибуты()).ИмеетТип("ФиксированноеСоответствие");
    Ожидаем.Что(Результат.Атрибуты().Получить("sampling.priority")).Равно(1);
КонецПроцедуры

&Тест
Процедура РезультатПринимаетАтрибутыСоответствием() Экспорт
    // Дано
    Атрибуты = Новый Соответствие();
    Атрибуты.Вставить("sampling.priority", 1);

    // Когда
    Результат = Новый ОтелРезультатСэмплирования(ОтелСэмплер.РешениеЗаписатьИЭкспортировать(), Атрибуты);

    // Тогда
    Ожидаем.Что(Результат.Атрибуты().Получить("sampling.priority")).Равно(1);
КонецПроцедуры

&Тест
Процедура РучноеСозданиеРезультатаСАтрибутами() Экспорт
    // Дано - пользовательский сэмплер может создать результат с атрибутами
    Атрибуты = Новый ОтелАтрибуты();
    Атрибуты.Установить("sampling.priority", 1);

    // Когда
    Результат = Новый ОтелРезультатСэмплирования(ОтелСэмплер.РешениеЗаписатьИЭкспортировать(), Атрибуты);

    // Тогда
    Ожидаем.Что(Результат.Решение()).Равно(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
    Ожидаем.Что(Результат.Атрибуты().Получить("sampling.priority")).Равно(1);
КонецПроцедуры

&Тест
Процедура РучноеСозданиеРезультатаСTraceState() Экспорт
    // Дано - пользовательский сэмплер может изменить TraceState
    СостояниеТрассировки = Новый ОтелСостояниеТрассировки();
    СостояниеТрассировки = СостояниеТрассировки.Установить("myvendor", "sampled");

    // Когда
    Результат = Новый ОтелРезультатСэмплирования(ОтелСэмплер.РешениеЗаписатьИЭкспортировать(), ,
        СостояниеТрассировки);

    // Тогда
    Ожидаем.Что(Результат.СостояниеТрассировки().Получить("myvendor")).Равно("sampled");
КонецПроцедуры

// --- Контекст спана родителя ---

&Тест
Процедура КонтекстСпанаРодителяИзКонтекста() Экспорт
    // Дано
    Контекст = КонтекстРодителя(Истина, Истина);

    // Когда
    КонтекстСпана = ОтелСэмплер.КонтекстСпанаРодителя(Контекст);

    // Тогда
    Ожидаем.Что(КонтекстСпана.ИдТрассировки()).Равно(ИдТрассировкиПоУмолчанию());
    Ожидаем.Что(КонтекстСпана.Удаленный()).ЭтоИстина();
КонецПроцедуры

&Тест
Процедура КонтекстСпанаРодителяКорневогоСпана() Экспорт
    // Когда - контекст без спана и контекст с невалидным спаном
    БезСпана = ОтелСэмплер.КонтекстСпанаРодителя(КорневойКонтекст());
    СНевалидным = ОтелСэмплер.КонтекстСпанаРодителя(
        ОтелКонтекст.КонтекстСоСпаном(Новый Соответствие(), ОтелСпаны.Невалидный()));

    // Тогда - родителя нет
    Ожидаем.Что(БезСпана).Равно(Неопределено);
    Ожидаем.Что(СНевалидным).Равно(Неопределено);
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция Сэмплировать(Сэмплер, Контекст, ИдТрассировки = Неопределено)
    Если ИдТрассировки = Неопределено Тогда
        ИдТрассировки = ИдТрассировкиПоУмолчанию();
    КонецЕсли;
    Возврат Сэмплер.ДолженСэмплировать(Контекст, ИдТрассировки, "span", ОтелВидСпана.Внутренний(),
        Неопределено, Неопределено);
КонецФункции

Функция КорневойКонтекст()
    Возврат Новый ФиксированноеСоответствие(Новый Соответствие());
КонецФункции

Функция КонтекстРодителя(Сэмплирован, Удаленный, ИдТрассировки = Неопределено, СостояниеТрассировки = "")
    Если ИдТрассировки = Неопределено Тогда
        ИдТрассировки = ИдТрассировкиПоУмолчанию();
    КонецЕсли;
    КонтекстСпана = Новый ОтелКонтекстСпана(ИдТрассировки, "b7ad6b7169203331", ?(Сэмплирован, 1, 0),
        СостояниеТрассировки, Удаленный);
    Возврат ОтелКонтекст.КонтекстСоСпаном(Новый Соответствие(), ОтелСпаны.Обернуть(КонтекстСпана));
КонецФункции

Функция СэмплерВида(ВидСэмплера)
    Если ВидСэмплера = "ВсегдаВключен" Тогда
        Возврат ОтелСэмплер.ВсегдаВключен();
    ИначеЕсли ВидСэмплера = "ВсегдаВыключен" Тогда
        Возврат ОтелСэмплер.ВсегдаВыключен();
    ИначеЕсли ВидСэмплера = "ПоДолеТрассировок" Тогда
        Возврат ОтелСэмплер.ПоДолеТрассировок(0.5);
    ИначеЕсли ВидСэмплера = "ВсегдаЗаписывать" Тогда
        Возврат ОтелСэмплер.ВсегдаЗаписывать(ОтелСэмплер.ВсегдаВыключен());
    Иначе
        Возврат ОтелСэмплер.НаОсновеРодителя(ОтелСэмплер.ВсегдаВключен());
    КонецЕсли;
КонецФункции

// Решение RECORD_AND_SAMPLE или DROP.
Функция РешениеСэмплирования(Сэмплирован)
    Если Сэмплирован Тогда
        Возврат ОтелСэмплер.РешениеЗаписатьИЭкспортировать();
    КонецЕсли;
    Возврат ОтелСэмплер.РешениеОтбросить();
КонецФункции

Функция ИдТрассировкиПоУмолчанию()
    Возврат "0af7651916cd43dd8448eb211c80319c";
КонецФункции

Функция ИдВысокойСлучайности()
    Возврат "0000000000000000ffffffffffffffff";
КонецФункции

Функция ИдНизкойСлучайности()
    Возврат "ffffffffffffffff0000000000000001";
КонецФункции

Функция ДолиДляПроверки()
    Доли = Новый Массив;
    Доли.Добавить(0.25);
    Доли.Добавить(0.5);
    Доли.Добавить(0.75);
    Возврат Доли;
КонецФункции

Функция ОтобранаПоДоле(Доля, ИдТрассировки)
    Результат = Сэмплировать(ОтелСэмплер.ПоДолеТрассировок(Доля), КорневойКонтекст(), ИдТрассировки);
    Возврат Результат.Решение() = ОтелСэмплер.РешениеЗаписатьИЭкспортировать();
КонецФункции

#КонецОбласти
