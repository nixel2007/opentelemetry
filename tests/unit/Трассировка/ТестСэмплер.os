// --- Тесты SamplingResult: атрибуты и TraceState ---

&Тест
Процедура РезультатСодержитПустыеАтрибутыПоУмолчанию() Экспорт
    // Дано / Когда
    Результат = ОтелСэмплер.ДолженСэмплировать(ОтелСэмплер.ВсегдаВключен());

    // Тогда - встроенные семплеры не добавляют атрибутов
    Ожидаем.Что(Результат.Атрибуты()).ИмеетТип("ОтелАтрибуты");
    Ожидаем.Что(Результат.Атрибуты().Количество()).Равно(0);
КонецПроцедуры

&Тест
Процедура РезультатСодержитПустоеСостояниеТрассировки() Экспорт
    // Дано / Когда
    Результат = ОтелСэмплер.ДолженСэмплировать(ОтелСэмплер.ВсегдаВключен());

    // Тогда - встроенные семплеры не модифицируют TraceState
    Ожидаем.Что(Результат.СостояниеТрассировки()).ИмеетТип("ОтелСостояниеТрассировки");
    Ожидаем.Что(Результат.СостояниеТрассировки().Пустой()).Равно(Истина);
КонецПроцедуры

&Тест
Процедура РучноеСозданиеРезультатаСАтрибутами() Экспорт
    // Дано - пользовательский семплер может создать результат с атрибутами
    Атрибуты = Новый ОтелАтрибуты();
    Атрибуты.Установить("sampling.priority", 1);

    // Когда
    Результат = Новый ОтелРезультатСэмплирования(
        ОтелСэмплер.РешениеЗаписатьИЭкспортировать(),
        Атрибуты
    );

    // Тогда
    Ожидаем.Что(Результат.Решение()).Равно(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
    Ожидаем.Что(Результат.Атрибуты().Получить("sampling.priority")).Равно(1);
КонецПроцедуры

&Тест
Процедура РучноеСозданиеРезультатаСTraceState() Экспорт
    // Дано - пользовательский семплер может модифицировать TraceState
    СостояниеТрассировки = Новый ОтелСостояниеТрассировки();
    СостояниеТрассировки = СостояниеТрассировки.Установить("myvendor", "sampled");

    // Когда
    Результат = Новый ОтелРезультатСэмплирования(
        ОтелСэмплер.РешениеЗаписатьИЭкспортировать(),
        ,
        СостояниеТрассировки
    );

    // Тогда
    Ожидаем.Что(Результат.СостояниеТрассировки().Получить("myvendor")).Равно("sampled");
КонецПроцедуры

// --- Тесты сохранения rv (explicit randomness) в TraceState ---

&Тест
Процедура СэмплерСохраняетРодительскийTraceState() Экспорт
    // Дано - родительский TraceState содержит rv (explicit randomness)
    РодительскийТС = Новый ОтелСостояниеТрассировки();
    РодительскийТС = РодительскийТС.Установить("ot", "rv:abc123");
    РодительскийТС = РодительскийТС.Установить("vendor", "data");

    // Когда - ВсегдаВключен с родительским TraceState
    Результат = ОтелСэмплер.ДолженСэмплировать(
        ОтелСэмплер.ВсегдаВключен(), , , , , , , , РодительскийТС);

    // Тогда - rv и другие записи сохранены
    Ожидаем.Что(Результат.СостояниеТрассировки().Получить("ot")).Равно("rv:abc123");
    Ожидаем.Что(Результат.СостояниеТрассировки().Получить("vendor")).Равно("data");
КонецПроцедуры

&Тест
Процедура СэмплерВсегдаВыключенСохраняетРодительскийTraceState() Экспорт
    // Дано
    РодительскийТС = Новый ОтелСостояниеТрассировки();
    РодительскийТС = РодительскийТС.Установить("ot", "rv:abc123");

    // Когда - ВсегдаВыключен тоже должен сохранять TraceState
    Результат = ОтелСэмплер.ДолженСэмплировать(
        ОтелСэмплер.ВсегдаВыключен(), , , , , , , , РодительскийТС);

    // Тогда
    Ожидаем.Что(Результат.СостояниеТрассировки().Получить("ot")).Равно("rv:abc123");
КонецПроцедуры

&Тест
Процедура СэмплерПоДолеСохраняетRv() Экспорт
    // Дано
    РодительскийТС = Новый ОтелСостояниеТрассировки();
    РодительскийТС = РодительскийТС.Установить("ot", "rv:deadbeef");

    // Когда - ПоДолеТрассировок с долей 1.0 (всегда записывать)
    Результат = ОтелСэмплер.ДолженСэмплировать(
        ОтелСэмплер.ПоДолеТрассировок(), 1.0,
        "0af7651916cd43dd8448eb211c80319c", , , , , , РодительскийТС);

    // Тогда
    Ожидаем.Что(Результат.СостояниеТрассировки().Получить("ot")).Равно("rv:deadbeef");
КонецПроцедуры

&Тест
Процедура СэмплерБезРодительскогоTraceStateВозвращаетПустой() Экспорт
    // Дано / Когда - без родительского TraceState
    Результат = ОтелСэмплер.ДолженСэмплировать(ОтелСэмплер.ВсегдаВключен());

    // Тогда - пустой TraceState (обратная совместимость)
    Ожидаем.Что(Результат.СостояниеТрассировки().Пустой()).Равно(Истина);
КонецПроцедуры

// --- Тесты функции Описание() для непокрытых веток ---

&Тест
Процедура ОписаниеНаОсновеРодителяПоУмолчанию() Экспорт
    // Дано / Когда - НаОсновеРодителя без явной корневой стратегии -> по умолчанию ВсегдаВключен
    Результат = ОтелСэмплер.Описание(ОтелСэмплер.НаОсновеРодителя());

    // Тогда
    Ожидаем.Что(Результат).Равно("ParentBased{root=AlwaysOnSampler}");
КонецПроцедуры

&Тест
Процедура ОписаниеНеизвестнойСтратегии() Экспорт
    // Дано / Когда - неизвестная стратегия в Описание() -> "UnknownSampler"
    Результат = ОтелСэмплер.Описание(999);

    // Тогда
    Ожидаем.Что(Результат).Равно("UnknownSampler");
КонецПроцедуры

// --- Тесты ветки rv (consistent probability sampling) ---

&Тест
Процедура ПоДолеТрассировокТрейсСтейтНеверногоТипа() Экспорт
    // Дано - в качестве TraceState передана строка (не ОтелСостояниеТрассировки)
    // ИзвлечьЗначениеRandom должен вернуть Неопределено при проверке типа

    // Когда - ПоДолеТрассировок с долей 0.5 и невалидным типом трейссостояния
    Результат = ОтелСэмплер.ДолженСэмплировать(
        ОтелСэмплер.ПоДолеТрассировок(), 0.5,
        "0000000000000000ffffffffffffffff", , , , , , "НеТрейсСтейт");

    // Тогда - rv не найден, используется trace ID -> высокое значение случайности -> записать
    Ожидаем.Что(Результат.Решение()).Равно(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
КонецПроцедуры

&Тест
Процедура ПоДолеТрассировокТрейсСтейтБезRv() Экспорт
    // Дано - TraceState существует, но не содержит "ot" ключа (нет rv)
    РодительскийТС = Новый ОтелСостояниеТрассировки();
    РодительскийТС = РодительскийТС.Установить("vendor", "data");

    // Когда - ПоДолеТрассировок с долей 0.5 и TraceState без rv
    Результат = ОтелСэмплер.ДолженСэмплировать(
        ОтелСэмплер.ПоДолеТрассировок(), 0.5,
        "0000000000000000ffffffffffffffff", , , , , , РодительскийТС);

    // Тогда - rv = Неопределено, высокое значение случайности trace ID -> записать
    Ожидаем.Что(Результат.Решение()).Равно(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
КонецПроцедуры

&Тест
Процедура ПоДолеТрассировокRvНевернойДлины() Экспорт
    // Дано - TraceState с rv длиной 8 символов (не 14)
    РодительскийТС = Новый ОтелСостояниеТрассировки();
    РодительскийТС = РодительскийТС.Установить("ot", "rv:deadbeef");

    // Когда - ПоДолеТрассировок с долей 0.5, rv отброшен из-за длины
    Результат = ОтелСэмплер.ДолженСэмплировать(
        ОтелСэмплер.ПоДолеТрассировок(), 0.5,
        "0000000000000000ffffffffffffffff", , , , , , РодительскийТС);

    // Тогда - rv невалидный (длина ≠ 14), высокое значение случайности trace ID -> записать
    Ожидаем.Что(Результат.Решение()).Равно(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
КонецПроцедуры

&Тест
Процедура ПоДолеТрассировокСRvВалидным() Экспорт
    РодительскийТС = Новый ОтелСостояниеТрассировки();
    РодительскийТС = РодительскийТС.Установить("ot", "rv:ffffffffffffff");

    // Когда - ПоДолеТрассировок с долей 0.5 и валидным rv
    Результат = ОтелСэмплер.ДолженСэмплировать(
        ОтелСэмплер.ПоДолеТрассировок(), 0.5,
        "0af7651916cd43dd8448eb211c80319c", , , , , , РодительскийТС);

    // Тогда - rv >= порог -> записать и экспортировать
    Ожидаем.Что(Результат.Решение()).Равно(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
КонецПроцедуры

&Тест
Процедура ПоДолеТрассировокСRvОтбрасывается() Экспорт
    // Дано - TraceState с rv = 00000000000000 (0), threshold(0.5) = 2^55
    // rv < threshold -> отбросить
    РодительскийТС = Новый ОтелСостояниеТрассировки();
    РодительскийТС = РодительскийТС.Установить("ot", "rv:00000000000000");

    // Когда - ПоДолеТрассировок с долей 0.5 и минимальным rv
    Результат = ОтелСэмплер.ДолженСэмплировать(
        ОтелСэмплер.ПоДолеТрассировок(), 0.5,
        "0af7651916cd43dd8448eb211c80319c", , , , , , РодительскийТС);

    // Тогда - rv < порог -> отбросить
    Ожидаем.Что(Результат.Решение()).Равно(ОтелСэмплер.РешениеОтбросить());
КонецПроцедуры

&Тест
Процедура ПоДолеТрассировокRvНевалидноеЧисло() Экспорт
    // Дано - TraceState с rv ровно 14 символов, но не hex (Z - не шестнадцатеричный символ)
    // ИзШестнадцатеричнойСтроки вернет Неопределено -> fallback на запись
    РодительскийТС = Новый ОтелСостояниеТрассировки();
    РодительскийТС = РодительскийТС.Установить("ot", "rv:ZZZZZZZZZZZZZZ");

    // Когда
    Результат = ОтелСэмплер.ДолженСэмплировать(
        ОтелСэмплер.ПоДолеТрассировок(), 0.5,
        "0af7651916cd43dd8448eb211c80319c", , , , , , РодительскийТС);

    // Тогда - невалидный rv -> записать и экспортировать
    Ожидаем.Что(Результат.Решение()).Равно(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
КонецПроцедуры

&Тест
Процедура ПоДолеТрассировокНевалидныйТрейсИд() Экспорт
    // Дано - TraceId с нешестнадцатеричными символами в последних 16 позициях
    // ИзШестнадцатеричнойСтроки("ZZZZZZZZZZZZZZZZ") -> Неопределено -> fallback на запись
    // Нет TraceState (нет rv)

    // Когда
    Результат = ОтелСэмплер.ДолженСэмплировать(
        ОтелСэмплер.ПоДолеТрассировок(), 0.5,
        "0af7651916cd43ddZZZZZZZZZZZZZZZZ");

    // Тогда - невалидный хеш TraceId -> записать и экспортировать
    Ожидаем.Что(Результат.Решение()).Равно(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
КонецПроцедуры

// --- TraceIdRatioBased: доля на trace ID по умолчанию и согласованность с rv ---

&Тест
Процедура ПоДолеТрассировокСоблюдаетДолюНаИдПоУмолчанию() Экспорт
    // Дано - trace ID из генератора по умолчанию. UUIDv4 содержит фиксированные биты
    // версии и варианта, случайны только правые 7 байт (W3C Trace Context Level 2).
    // Допуск 0.05 при 2000 ID - более 4 стандартных отклонений.
    КоличествоИд = 2000;
    Допуск = 0.05;
    Идентификаторы = Новый Массив;
    Для Номер = 1 По КоличествоИд Цикл // BSLLS:UnusedLocalVariable-off
        Идентификаторы.Добавить(ОтелУтилиты.СгенерироватьИдТрассировки());
    КонецЦикла;

    Для Каждого Доля Из ДолиДляПроверки() Цикл
        // Когда
        Отобрано = 0;
        Для Каждого ИдТрассировки Из Идентификаторы Цикл
            Если ОтобранаПоДоле(Доля, ИдТрассировки) Тогда
                Отобрано = Отобрано + 1;
            КонецЕсли;
        КонецЦикла;

        // Тогда
        ФактическаяДоля = Отобрано / КоличествоИд;
        Ожидаем.Что(ФактическаяДоля, "фактическая доля при ratio=" + Доля)
            .Между(Доля - Допуск, Доля + Допуск);
    КонецЦикла;
КонецПроцедуры

&Тест
Процедура ПоДолеТрассировокРешениеПоИдСовпадаетСРешениемПоRv() Экспорт
    // Дано - "Presumption of TraceID randomness": без rv случайностью считаются
    // правые 7 байт trace ID, поэтому решения по trace ID и по rv с тем же значением совпадают
    ЗначенияСлучайности = Новый Массив;
    ЗначенияСлучайности.Добавить("00000000000000");
    ЗначенияСлучайности.Добавить("3fffffffffffff");
    ЗначенияСлучайности.Добавить("40000000000000");
    ЗначенияСлучайности.Добавить("7fffffffffffff");
    ЗначенияСлучайности.Добавить("80000000000000");
    ЗначенияСлучайности.Добавить("bfffffffffffff");
    ЗначенияСлучайности.Добавить("c0000000000000");
    ЗначенияСлучайности.Добавить("ffffffffffffff");

    Для Каждого Случайность Из ЗначенияСлучайности Цикл
        ИдТрассировки = "4bf92f3577b34da6a3" + Случайность;
        СостояниеСRv = Новый ОтелСостояниеТрассировки();
        СостояниеСRv = СостояниеСRv.Установить("ot", "rv:" + Случайность);
        Для Каждого Доля Из ДолиДляПроверки() Цикл
            // Когда
            РешениеПоИд = ОтелСэмплер.ДолженСэмплировать(
                ОтелСэмплер.ПоДолеТрассировок(), Доля, ИдТрассировки).Решение();
            РешениеПоRv = ОтелСэмплер.ДолженСэмплировать(
                ОтелСэмплер.ПоДолеТрассировок(), Доля,
                "0af7651916cd43dd8448eb211c80319c", , , , , , СостояниеСRv).Решение();

            // Тогда
            Ожидаем.Что(РешениеПоИд, "случайность " + Случайность + ", доля " + Доля)
                .Равно(РешениеПоRv);
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

&Тест
Процедура ПоДолеТрассировокБольшаяДоляВключаетВсеТрассировкиМеньшей() Экспорт
    // Дано - спека: сэмплер с большей долей MUST сэмплировать все трассировки,
    // которые сэмплирует сэмплер с меньшей долей
    КоличествоИд = 500;
    МеньшаяДоля = 0.2;
    БольшаяДоля = 0.6;

    Для Номер = 1 По КоличествоИд Цикл // BSLLS:UnusedLocalVariable-off
        ИдТрассировки = ОтелУтилиты.СгенерироватьИдТрассировки();

        // Когда
        ОтобранаМеньшей = ОтобранаПоДоле(МеньшаяДоля, ИдТрассировки);
        ОтобранаБольшей = ОтобранаПоДоле(БольшаяДоля, ИдТрассировки);

        // Тогда
        Если ОтобранаМеньшей Тогда
            Ожидаем.Что(ОтобранаБольшей, "trace ID " + ИдТрассировки).Равно(Истина);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ДолиДляПроверки()
    Доли = Новый Массив;
    Доли.Добавить(0.25);
    Доли.Добавить(0.5);
    Доли.Добавить(0.75);
    Возврат Доли;
КонецФункции

Функция ОтобранаПоДоле(Доля, ИдТрассировки)
    Результат = ОтелСэмплер.ДолженСэмплировать(ОтелСэмплер.ПоДолеТрассировок(), Доля, ИдТрассировки);
    Возврат Результат.Решение() = ОтелСэмплер.РешениеЗаписатьИЭкспортировать();
КонецФункции
