&Тест
Процедура ПоДолеТрассировокПоловина() Экспорт
    // Дано - доля 0.5: порог отбора 2^55 для значения случайности из правых 7 байт trace ID
    Сэмплер = ОтелСэмплер.ПоДолеТрассировок();
    ИдВысокойСлучайности = "0000000000000000ffffffffffffffff";
    ИдНизкойСлучайности = "ffffffffffffffff0000000000000001";

    // Когда
    РезультатВысокой = ОтелСэмплер.ДолженСэмплировать(Сэмплер, 0.5, ИдВысокойСлучайности);
    РезультатНизкой = ОтелСэмплер.ДолженСэмплировать(Сэмплер, 0.5, ИдНизкойСлучайности);

    // Тогда - значение не ниже порога сэмплируется, ниже порога - отбрасывается
    Ожидаем.Что(РезультатВысокой.Решение()).Равно(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
    Ожидаем.Что(РезультатНизкой.Решение()).Равно(ОтелСэмплер.РешениеОтбросить());
КонецПроцедуры

&Тест
Процедура ПоДолеТрассировокПустойТрейсИд() Экспорт
    // Дано / Когда - пустой traceId -> записать (fallback)
    Результат = ОтелСэмплер.ДолженСэмплировать(ОтелСэмплер.ПоДолеТрассировок(), 0.5, "");

    // Тогда
    Ожидаем.Что(Результат.Решение()).Равно(ОтелСэмплер.РешениеЗаписатьИЭкспортировать());
КонецПроцедуры

