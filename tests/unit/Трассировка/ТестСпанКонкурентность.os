// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать "../../.."
#Использовать asserts

// Состояние для фоновых заданий
Перем Спан;
Перем ВызововНаЗадание;

&Тест
Процедура КонкурентнаяЗаписьВСпанНеТеряетДанные() Экспорт

    // Дано - лимиты выше числа записей: сохраниться должно все
    Лимиты = Новый ОтелЛимитыСпана();
    Лимиты.УстановитьМаксАтрибутов(10000);
    Лимиты.УстановитьМаксСобытий(10000);
    Спан = СоздатьСпан(Лимиты);
    ВызововНаЗадание = 500;

    // Когда
    Задания = ЗапуститьЗадания(8);

    // Тогда
    ПроверитьЗадания(Задания);
    Ожидаем.Что(Спан.События().Количество(), "событий").Равно(4000);
    Ожидаем.Что(Спан.Атрибуты().Количество(), "атрибутов").Равно(4000);

КонецПроцедуры

&Тест
Процедура КонкурентнаяЗаписьВСпанСоблюдаетЛимиты() Экспорт

    // Дано - лимиты по умолчанию (128): лишнее отбрасывается и учитывается в счетчиках
    Спан = СоздатьСпан(Новый ОтелЛимитыСпана());
    ВызововНаЗадание = 500;

    // Когда
    Задания = ЗапуститьЗадания(8);

    // Тогда
    ПроверитьЗадания(Задания);
    Ожидаем.Что(Спан.События().Количество(), "событий").Равно(128);
    Ожидаем.Что(Спан.КоличествоОтброшенныхСобытий(), "отброшено событий").Равно(4000 - 128);
    Ожидаем.Что(Спан.Атрибуты().Количество(), "атрибутов").Равно(128);
    Ожидаем.Что(Спан.КоличествоОтброшенныхАтрибутов(), "отброшено атрибутов").Равно(4000 - 128);

КонецПроцедуры

&Тест
Процедура КонкурентноеЗавершениеПередаетСпанПроцессоруОдинРаз() Экспорт

    // Дано
    Транспорт = Новый ОтелВПамятьТранспорт();
    Процессор = Новый ОтелПростойПроцессорСпанов(Новый ОтелЭкспортерСпанов(Транспорт));
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(), Процессор);
    Спан = Провайдер.ПолучитьТрассировщик("test").НачатьСпан("span");
    ВызововНаЗадание = 50;

    // Когда
    Задания = ЗапуститьЗадания(8, "ЗавершитьСпан");

    // Тогда
    ПроверитьЗадания(Задания);
    Ожидаем.Что(Транспорт.ПолучитьОтправленные().Количество(), "экспортов спана").Равно(1);
    Ожидаем.Что(Спан.Завершен(), "спан завершен").Равно(Истина);
    Ожидаем.Что(Спан.ЗаписьАктивна(), "запись активна").Равно(Ложь);

КонецПроцедуры

// Выполняется фоновыми заданиями: завершает общий спан и пишет в него атрибут.
Процедура ЗавершитьСпан(НомерЗадания) Экспорт
    Для Индекс = 1 По ВызововНаЗадание Цикл
        Спан.Завершить();
        Спан.УстановитьАтрибут("k." + НомерЗадания, Индекс);
    КонецЦикла;
КонецПроцедуры

// Выполняется фоновыми заданиями: пишет в общий спан события и атрибуты с уникальными ключами.
Процедура ЗаписатьВСпан(НомерЗадания) Экспорт
    Для Индекс = 1 По ВызововНаЗадание Цикл
        Ключ = СтрШаблон("k.%1.%2", НомерЗадания, Формат(Индекс, "ЧН=0; ЧГ="));
        Спан.ДобавитьСобытие(Ключ);
        Спан.УстановитьАтрибут(Ключ, Индекс);
    КонецЦикла;
КонецПроцедуры

Функция СоздатьСпан(Лимиты)
    Провайдер = Новый ОтелПровайдерТрассировки(, , , Лимиты);
    Возврат Провайдер.ПолучитьТрассировщик("test").НачатьСпан("span");
КонецФункции

Функция ЗапуститьЗадания(Количество, ИмяМетода = "ЗаписатьВСпан")
    Задания = Новый Массив();
    Пока Задания.Количество() < Количество Цикл
        Параметры = Новый Массив();
        Параметры.Добавить(Задания.Количество() + 1);
        Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, ИмяМетода, Параметры));
    КонецЦикла;
    ФоновыеЗадания.ОжидатьВсе(Задания);
    Возврат Задания;
КонецФункции

Процедура ПроверитьЗадания(Задания)
    Для Каждого Задание Из Задания Цикл
        Ошибка = "";
        Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
            Ошибка = Задание.ИнформацияОбОшибке.Описание;
        КонецЕсли;
        Ожидаем.Что(Ошибка, "ошибка фонового задания").Равно("");
    КонецЦикла;
КонецПроцедуры
