&Тест
Процедура НачатьСпанОтNonRecordingРодителяСUnsampledФлагомНеЗаписывается() Экспорт
    // Дано - в контексте non-recording родитель с unsampled флагом
    // (имитация propagation от стороннего сервиса с sampled=0).
    // По OTel Trace API §122 + ParentBased sampler ребёнок MUST быть
    // non-recording (passthrough): trace context пропагируется,
    // данные не записываются.
    ОтелКонтекст.Очистить();
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерТрассировки(Ресурс, , ОтелСэмплер.НаОсновеРодителя(ОтелСэмплер.ВсегдаВключен()));
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ", "1.0");

    ФлагUnsampled = 0;
    РодительскийИдТрассировки = "0af7651916cd43dd8448eb211c80319c";
    РодительскийИдСпана = "b7ad6b7169203331";
    КонтекстРодителя = Новый ОтелКонтекстСпана(
        РодительскийИдТрассировки, РодительскийИдСпана, ФлагUnsampled);
    РодительНеЗаписываемый = ОтелСпаны.Обернуть(КонтекстРодителя);
    ОтелКонтекст.СделатьСпанТекущим(РодительНеЗаписываемый);

    // Когда
    Спан = Трассировщик.НачатьСпан("дочерний");

    // Тогда - non-recording, контекст родителя пропагирован
    Ожидаем.Что(ТипЗнч(Спан)).Равно(Тип("ОтелНезаписывающийСпан"));
    Ожидаем.Что(Спан.ЗаписьАктивна()).Равно(Ложь);
    Ожидаем.Что(Спан.КонтекстСпана().ИдТрассировки()).Равно(РодительскийИдТрассировки);

    // Очистка
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();
КонецПроцедуры

&Тест
Процедура РезультатСэмплированияНеПерекрываетсяМеждуСпанами() Экспорт

    // Дано - два провайдера с разными сэмплерами
    ОтелКонтекст.Очистить();
    Ресурс = Новый ОтелРесурс(Истина);

    ПровайдерВключен = Новый ОтелПровайдерТрассировки(Ресурс, , ОтелСэмплер.ВсегдаВключен());
    ПровайдерВыключен = Новый ОтелПровайдерТрассировки(Ресурс, , ОтелСэмплер.ВсегдаВыключен());

    ТрассировщикВключен = ПровайдерВключен.ПолучитьТрассировщик("lib-on", "1.0");
    ТрассировщикВыключен = ПровайдерВыключен.ПолучитьТрассировщик("lib-off", "1.0");

    // Когда - создаём спаны с разными провайдерами
    СпанЗаписываемый = ТрассировщикВключен.НачатьКорневойСпан("включён");
    СпанЗаписываемый.УстановитьАтрибут("key", "value");

    СпанНезаписывающий = ТрассировщикВыключен.НачатьКорневойСпан("выключен");

    // Тогда - результаты сэмплирования не перекрываются
    Ожидаем.Что(СпанЗаписываемый.ЗаписьАктивна()).Равно(Истина);
    Ожидаем.Что(СпанЗаписываемый.Атрибуты().Получить("key")).Равно("value");

    Ожидаем.Что(ТипЗнч(СпанНезаписывающий)).Равно(Тип("ОтелНезаписывающийСпан"));
    Ожидаем.Что(СпанНезаписывающий.ЗаписьАктивна()).Равно(Ложь);

    // Очистка
    СпанЗаписываемый.Завершить();
    ПровайдерВключен.Закрыть();
    ПровайдерВыключен.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

// ParentBased (Trace SDK, Built-in samplers): делегат выбирается по тому, удаленный родитель или
// локальный (SpanContext.IsRemote) и сэмплирован ли он. У удаленного и локального родителя в
// конфигурации противоположные решения: по записи дочернего спана видно, какой делегат сработал

&ПараметризованныйТест
&ИсточникЗначение("удаленный|1|Ложь")
&ИсточникЗначение("удаленный|0|Истина")
&ИсточникЗначение("локальный|1|Истина")
&ИсточникЗначение("локальный|0|Ложь")
Процедура НаОсновеРодителяРазличаетУдаленногоРодителя(Случай) Экспорт

    // Дано - родитель|флаги трассировки родителя|записывается ли дочерний спан
    ОтелКонтекст.Очистить();
    Части = СтрРазделить(Случай, "|");
    Сэмплер = ОтелСэмплер.НаОсновеРодителя(ОтелСэмплер.ВсегдаВключен(),
        ОтелСэмплер.ВсегдаВыключен(), ОтелСэмплер.ВсегдаВключен(),
        ОтелСэмплер.ВсегдаВключен(), ОтелСэмплер.ВсегдаВыключен());
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерТрассировки(Ресурс, , Сэмплер);
    КонтекстРодителя = Новый ОтелКонтекстСпана("11111111111111111111111111111111", "2222222222222222",
        Число(Части[1]), , Части[0] = "удаленный");
    ОтелКонтекст.СделатьСпанТекущим(Новый ОтелНезаписывающийСпан(КонтекстРодителя));
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ", "1.0");

    // Когда
    Спан = Трассировщик.НачатьСпан("child");

    // Тогда
    Ожидаем.Что(Спан.ЗаписьАктивна()).Равно(Части[2] = "Истина");

    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

// Trace SDK, ShouldSample: сэмплер получает контекст с родительским спаном, TraceId, имя, вид,
// начальные атрибуты и линки создаваемого спана
&Тест
Процедура СэмплерПолучаетПараметрыСоздаваемогоСпана() Экспорт

    // Дано
    ОтелКонтекст.Очистить();
    Сэмплер = ЗапоминающийСэмплер(ОтелСэмплер.Результат(ОтелСэмплер.РешениеЗаписатьИЭкспортировать()));
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина), , Сэмплер);
    КонтекстРодителя = КонтекстСРодителем(1);
    Атрибуты = Новый Соответствие();
    Атрибуты.Вставить("user.id", "42");
    Линки = Новый Массив();
    Линки.Добавить(Новый ОтелЛинк(Новый ОтелКонтекстСпана("33333333333333333333333333333333", "4444444444444444")));

    // Когда
    Спан = Провайдер.ПолучитьТрассировщик("библ").НачатьДочернийСпан("операция", КонтекстРодителя,
        ОтелВидСпана.Сервер(), Атрибуты, Линки);

    // Тогда
    Ожидаем.Что(ОтелСэмплер.КонтекстСпанаРодителя(Сэмплер.Контекст).ИдСпана()).Равно(ИдСпанаРодителя());
    Ожидаем.Что(Сэмплер.ИдТрассировки).Равно(ИдТрассировкиРодителя());
    Ожидаем.Что(Сэмплер.ИмяСпана).Равно("операция");
    Ожидаем.Что(Сэмплер.ВидСпана).Равно(ОтелВидСпана.Сервер());
    Ожидаем.Что(Сэмплер.Атрибуты.Получить("user.id")).Равно("42");
    Ожидаем.Что(Сэмплер.Линки.Количество()).Равно(1);

    Спан.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура СэмплерКорневогоСпанаПолучаетЕгоTraceIdИПустыеКоллекции() Экспорт

    // Дано
    ОтелКонтекст.Очистить();
    Сэмплер = ЗапоминающийСэмплер(ОтелСэмплер.Результат(ОтелСэмплер.РешениеЗаписатьИЭкспортировать()));
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина), , Сэмплер);

    // Когда - вид, атрибуты и линки не заданы
    Спан = Провайдер.ПолучитьТрассировщик("библ").НачатьСпан("операция");

    // Тогда - родителя нет, TraceId - у создаваемого спана, вид по умолчанию, пустые коллекции
    Ожидаем.Что(ОтелСэмплер.КонтекстСпанаРодителя(Сэмплер.Контекст)).Равно(Неопределено);
    Ожидаем.Что(Сэмплер.ИдТрассировки).Равно(Спан.КонтекстСпана().ИдТрассировки());
    Ожидаем.Что(Сэмплер.ВидСпана).Равно(ОтелВидСпана.Внутренний());
    Ожидаем.Что(Сэмплер.Атрибуты.Количество()).Равно(0);
    Ожидаем.Что(Сэмплер.Линки.Количество()).Равно(0);

    Спан.Завершить();
    Провайдер.Закрыть();

КонецПроцедуры

// НачатьКорневойСпан создает спан без родителя: текущий спан не передается сэмплеру и процессорам
// как родитель (Trace SDK, ShouldSample: спан с невалидным SpanContext означает корневой спан)
&Тест
Процедура КорневойСпанНеВидитТекущийСпанКакРодителя() Экспорт

    // Дано - текущий спан локальный и сэмплированный; корневой сэмплер отбрасывает все
    ОтелКонтекст.Очистить();
    Процессор = ПроцессорЗапоминающийНачало();
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина), Процессор,
        ОтелСэмплер.ВсегдаЗаписывать(ОтелСэмплер.НаОсновеРодителя(ОтелСэмплер.ВсегдаВыключен())));
    Багаж = Новый ОтелПостроительBaggage().Установить("ключ", "значение").Построить();
    КонтекстТекущий = ОтелКонтекст.КонтекстСBaggage(КонтекстСРодителем(1), Багаж);
    Токен = ОтелКонтекст.ПрисоединитьКонтекст(КонтекстТекущий);

    // Когда
    Спан = Провайдер.ПолучитьТрассировщик("библ").НачатьКорневойСпан("операция");
    ОтелКонтекст.ОтсоединитьКонтекст(Токен);

    // Тогда - решение принял корневой сэмплер: спан записывается без флага sampled;
    // процессор получил контекст без родительского спана, но с baggage текущего контекста
    Ожидаем.Что(Спан.КонтекстСпана().ФлагиТрассировки() % 2).Равно(0);
    Ожидаем.Что(Спан.КонтекстСпана().ИдТрассировки()).Не_().Равно(ИдТрассировкиРодителя());
    КонтекстПриНачале = Процессор.Контексты[0];
    Ожидаем.Что(ОтелСэмплер.КонтекстСпанаРодителя(КонтекстПриНачале)).Равно(Неопределено);
    Ожидаем.Что(ОтелКонтекст.BaggageИзКонтекста(КонтекстПриНачале).Получить("ключ")).Равно("значение");

    Спан.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

// Trace SDK, ShouldSample: RECORD_ONLY - IsRecording = true, флаг Sampled MUST NOT быть установлен
&Тест
Процедура РешениеЗаписатьСоздаетЗаписывающийСпанБезФлагаSampled() Экспорт

    // Дано
    ОтелКонтекст.Очистить();
    Сэмплер = ЗапоминающийСэмплер(ОтелСэмплер.Результат(ОтелСэмплер.РешениеЗаписать()));
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина), , Сэмплер);

    // Когда
    Спан = Провайдер.ПолучитьТрассировщик("библ").НачатьСпан("операция");

    // Тогда
    Ожидаем.Что(Спан.ЗаписьАктивна()).Равно(Истина);
    Ожидаем.Что(Спан.КонтекстСпана().ФлагиТрассировки() % 2).Равно(0);

    Спан.Завершить();
    Провайдер.Закрыть();

КонецПроцедуры

// Trace SDK, ShouldSample: атрибуты результата сэмплера добавляются в спан (до OnStart)
&Тест
Процедура АтрибутыСэмплераДобавляютсяВСпан() Экспорт

    // Дано - сэмплер добавляет атрибут и переопределяет начальный
    ОтелКонтекст.Очистить();
    КлючМетода = "http.method";
    АтрибутыСэмплера = Новый ОтелАтрибуты();
    АтрибутыСэмплера.Установить("sampler.name", "custom");
    АтрибутыСэмплера.Установить(КлючМетода, "POST");
    Результат = Новый ОтелРезультатСэмплирования(ОтелСэмплер.РешениеЗаписатьИЭкспортировать(), АтрибутыСэмплера);
    Сэмплер = ЗапоминающийСэмплер(Результат);
    Процессор = ПроцессорЗапоминающийНачало();
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина), Процессор, Сэмплер);
    Атрибуты = Новый Соответствие();
    Атрибуты.Вставить(КлючМетода, "GET");
    Атрибуты.Вставить("http.route", "/users");

    // Когда
    Спан = Провайдер.ПолучитьТрассировщик("библ").НачатьСпан("операция", , Атрибуты);

    // Тогда
    Ожидаем.Что(Процессор.АтрибутСэмплераПриНачале[0]).Равно("custom");
    Ожидаем.Что(Спан.Атрибуты().Получить(КлючМетода)).Равно("POST");
    Ожидаем.Что(Спан.Атрибуты().Получить("http.route")).Равно("/users");
    Ожидаем.Что(Атрибуты.Количество(), "начальные атрибуты вызывающего не меняются").Равно(2);

    Спан.Завершить();
    Провайдер.Закрыть();

КонецПроцедуры

// Trace SDK, ShouldSample: TraceState результата связывается со спаном через его SpanContext,
// пустой TraceState очищает состояние; результат без TraceState сохраняет TraceState родителя
&ПараметризованныйТест
&ИсточникЗначение("vendor=sampler|vendor=sampler")
&ИсточникЗначение("пустой|")
&ИсточникЗначение("не задан|vendor=parent")
Процедура TraceStateРезультатаСэмплераУСпана(Случай) Экспорт

    // Дано - TraceState результата сэмплера|ожидаемый TraceState спана
    Части = СтрРазделить(Случай, "|");
    Результат = Новый ОтелРезультатСэмплирования(ОтелСэмплер.РешениеЗаписатьИЭкспортировать(), ,
        СостояниеТрассировкиСлучая(Части[0]));

    // Когда
    Спан = ДочернийСпанСРезультатомСэмплера(Результат);

    // Тогда
    Ожидаем.Что(Спан.КонтекстСпана().СостояниеТрассировки().ВСтроку()).Равно(Части[1]);
    Спан.Завершить();

КонецПроцедуры

&Тест
Процедура ОтброшенныйСпанПолучаетTraceStateСэмплера() Экспорт

    // Дано - сэмплер отбрасывает спан и задает TraceState
    Результат = Новый ОтелРезультатСэмплирования(ОтелСэмплер.РешениеОтбросить(), ,
        Новый ОтелСостояниеТрассировки("vendor=dropped"));

    // Когда
    Спан = ДочернийСпанСРезультатомСэмплера(Результат);

    // Тогда - SpanContext незаписывающего спана несет TraceState сэмплера
    Ожидаем.Что(Спан.ЗаписьАктивна()).Равно(Ложь);
    Ожидаем.Что(Спан.КонтекстСпана().СостояниеТрассировки().ВСтроку()).Равно("vendor=dropped");

КонецПроцедуры

// Trace SDK, Enabled: без зарегистрированных SpanProcessors Enabled MUST возвращать false, при этом
// трассировщик остается в SDK-режиме: спаны получают сгенерированные ID и решение сэмплера
&Тест
Процедура БезПроцессоровВыключенНоСоздаетСпаныSdk() Экспорт

    // Дано
    ОтелКонтекст.Очистить();
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина));
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ", "1.0");

    // Когда
    Включен = Трассировщик.Включен();
    Корневой = Трассировщик.НачатьКорневойСпан("корень");
    Дочерний = Трассировщик.НачатьДочернийСпан("ребенок",
        ОтелКонтекст.КонтекстСоСпаном(ОтелКонтекст.Текущий(), Корневой));

    // Тогда
    Ожидаем.Что(Включен).Равно(Ложь);
    Ожидаем.Что(Корневой.КонтекстСпана().Валиден()).Равно(Истина);
    Ожидаем.Что(Корневой.ЗаписьАктивна()).Равно(Истина);
    Ожидаем.Что(Дочерний.КонтекстСпана().ИдТрассировки()).Равно(Корневой.КонтекстСпана().ИдТрассировки());

    Дочерний.Завершить();
    Корневой.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

// Trace SDK, Enabled: с зарегистрированным SpanProcessor Enabled возвращает true
&Тест
Процедура СПроцессоромВключен() Экспорт

    // Дано
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина),
        Мок.Получить(Тип("ОтелПростойПроцессорСпанов")));

    // Когда
    Включен = Провайдер.ПолучитьТрассировщик("библ", "1.0").Включен();

    // Тогда
    Ожидаем.Что(Включен).Равно(Истина);
    Провайдер.Закрыть();

КонецПроцедуры

// Трассировщик отключенного провайдера (API-режим, как у no-op SDK по умолчанию).
Функция ОтключенныйТрассировщик(Провайдер)
    Провайдер.УстановитьВключен(Ложь);
    Возврат Провайдер.ПолучитьТрассировщик("тест");
КонецФункции

Функция ЗапоминающийСэмплер(Результат)
    КаталогФикстур = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
    Сэмплер = ЗагрузитьСценарий(ОбъединитьПути(КаталогФикстур, "ЗапоминающийСэмплер.os"));
    Сэмплер.Результат = Результат;
    Возврат Сэмплер;
КонецФункции

// Процессор запоминает контекст, переданный в ПриНачале, и атрибут sampler.name спана на этот момент.
Функция ПроцессорЗапоминающийНачало()
    Возврат ЗагрузитьСценарийИзСтроки(
        "Перем Контексты Экспорт;
        |Перем АтрибутСэмплераПриНачале Экспорт;
        |Процедура ПриНачале(Спан, РодительскийКонтекст = Неопределено) Экспорт
        |    Контексты.Добавить(РодительскийКонтекст);
        |    АтрибутСэмплераПриНачале.Добавить(Спан.Атрибуты().Получить(""sampler.name""));
        |КонецПроцедуры
        |Процедура ПриЗавершении(Спан) Экспорт
        |КонецПроцедуры
        |Функция СброситьБуфер(ТаймаутМс = 0) Экспорт
        |    Возврат ОтелРезультатыЭкспорта.Успех();
        |КонецФункции
        |Функция Закрыть(ТаймаутМс = 0) Экспорт
        |    Возврат ОтелРезультатыЗакрытия.Успех();
        |КонецФункции
        |Контексты = Новый Массив();
        |АтрибутСэмплераПриНачале = Новый Массив();");
КонецФункции

// Контекст, в котором текущий спан - локальный родитель с TraceState "vendor=parent".
Функция КонтекстСРодителем(ФлагиТрассировки)
    КонтекстСпана = Новый ОтелКонтекстСпана(ИдТрассировкиРодителя(), ИдСпанаРодителя(), ФлагиТрассировки,
        "vendor=parent");
    Возврат ОтелКонтекст.КонтекстСоСпаном(Новый Соответствие(), ОтелСпаны.Обернуть(КонтекстСпана));
КонецФункции

Функция ДочернийСпанСРезультатомСэмплера(Результат)
    ОтелКонтекст.Очистить();
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина), , ЗапоминающийСэмплер(Результат));
    Спан = Провайдер.ПолучитьТрассировщик("библ").НачатьДочернийСпан("операция", КонтекстСРодителем(1));
    Провайдер.Закрыть();
    Возврат Спан;
КонецФункции

Функция СостояниеТрассировкиСлучая(Описание)
    Если Описание = "не задан" Тогда
        Состояние = Неопределено;
    ИначеЕсли Описание = "пустой" Тогда
        Состояние = Новый ОтелСостояниеТрассировки();
    Иначе
        Состояние = Новый ОтелСостояниеТрассировки(Описание);
    КонецЕсли;
    Возврат Состояние;
КонецФункции

Функция ИдТрассировкиРодителя()
    Возврат "11111111111111111111111111111111";
КонецФункции

Функция ИдСпанаРодителя()
    Возврат "2222222222222222";
КонецФункции
