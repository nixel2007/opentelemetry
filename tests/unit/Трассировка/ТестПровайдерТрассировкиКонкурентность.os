// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать "../../.."
#Использовать asserts
#Использовать atomic

// Состояние для фоновых заданий
Перем Провайдер;
Перем КоличествоРаундов;
Перем Прибыло;
Перем Сорвано;

&Тест
Процедура КонкурентноеПолучениеТрассировщикаВозвращаетОдинЭкземпляр() Экспорт

    // Дано - два фоновых задания на барьере одновременно запрашивают трассировщик одной области
    Провайдер = Новый ОтелПровайдерТрассировки();
    КоличествоРаундов = 200;
    Прибыло = Новый АтомарноеЧисло(0);
    Сорвано = Новый АтомарноеБулево(Ложь);

    // Когда
    КоличествоЗаданий = 2;
    Задания = Новый Массив();
    Пока Задания.Количество() < КоличествоЗаданий Цикл
        Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПолучитьТрассировщикиОдновременно"));
    КонецЦикла;
    ФоновыеЗадания.ОжидатьВсе(Задания);

    // Тогда - оба задания получили один и тот же трассировщик, и он же лежит в кэше
    Для Каждого Задание Из Задания Цикл
        Ожидаем.Что(Задание.ИнформацияОбОшибке, "ошибка фонового задания").Равно(Неопределено);
    КонецЦикла;
    Ожидаем.Что(Сорвано.Получить(), "барьер фоновых заданий сорван").ЭтоЛожь();
    Первые = Задания[0].Результат;
    Вторые = Задания[1].Результат;
    РазныхЭкземпляров = 0;
    НеИзКэша = 0;
    Для Индекс = 0 По КоличествоРаундов - 1 Цикл
        Если Первые[Индекс] <> Вторые[Индекс] Тогда
            РазныхЭкземпляров = РазныхЭкземпляров + 1;
        КонецЕсли;
        Если Первые[Индекс] <> Провайдер.ПолучитьТрассировщик(ИмяОбласти(Индекс)) Тогда
            НеИзКэша = НеИзКэша + 1;
        КонецЕсли;
    КонецЦикла;
    Ожидаем.Что(РазныхЭкземпляров, "раундов, в которых задания получили разные трассировщики").Равно(0);
    Ожидаем.Что(НеИзКэша, "раундов, в которых возвращен трассировщик вне кэша").Равно(0);

КонецПроцедуры

// Выполняется двумя фоновыми заданиями: в каждом раунде задания встречаются на барьере
// и запрашивают трассировщик области раунда одновременно.
Функция ПолучитьТрассировщикиОдновременно() Экспорт
    ТаймаутБарьераМс = 30000;
    ВитковДоУступки = 1000;
    Полученные = Новый Массив();
    Для Индекс = 0 По КоличествоРаундов - 1 Цикл
        Прибыло.ИнкрементироватьИПолучить();
        Цель = 2 * (Индекс + 1);
        НачалоОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
        Витков = 0;
        Пока Прибыло.Получить() < Цель Цикл
            Витков = Витков + 1;
            Если Витков % ВитковДоУступки = 0 Тогда
                Приостановить(0);
            КонецЕсли;
            ОжиданиеМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжидания;
            Если ОжиданиеМс > ТаймаутБарьераМс Или Сорвано.Получить() Тогда
                Сорвано.Установить(Истина);
                Возврат Полученные;
            КонецЕсли;
        КонецЦикла;
        Полученные.Добавить(Провайдер.ПолучитьТрассировщик(ИмяОбласти(Индекс)));
    КонецЦикла;
    Возврат Полученные;
КонецФункции

Функция ИмяОбласти(Индекс)
    Возврат "lib." + Формат(Индекс, "ЧН=0; ЧГ=");
КонецФункции
