Процедура СериализацияСохраняетПорядок() Экспорт
    // Дано

    // Когда
    СостояниеТрассировки = Новый ОтелСостояниеТрассировки("a=1,b=2,c=3");

    // Тогда
    Ожидаем.Что(СостояниеТрассировки.ВСтроку()).Равно("a=1,b=2,c=3");
КонецПроцедуры

&Тест
Процедура ЗначениеСПробеламиВнутри() Экспорт
    // Дано - пробелы внутри значения допустимы по W3C

    // Когда
    СостояниеТрассировки = Новый ОтелСостояниеТрассировки();
    НовоеСостояние = СостояниеТрассировки.Установить("key", "hello world");

    // Тогда
    Ожидаем.Что(НовоеСостояние.Получить("key")).Равно("hello world");
КонецПроцедуры

// W3C Trace Context Level 2: ведущие пробелы значения MUST сохраняться, значение не может
// оканчиваться пробелом (value = 0*255(chr) nblk-chr)

&Тест
Процедура ЗначениеСВедущимиПробеламиСохраняется() Экспорт
    // Дано
    СостояниеТрассировки = Новый ОтелСостояниеТрассировки();

    // Когда
    НовоеСостояние = СостояниеТрассировки.Установить("key", " leading");
    Разобранное = Новый ОтелСостояниеТрассировки("k=  v , other=x");

    // Тогда
    Ожидаем.Что(НовоеСостояние.Получить("key")).Равно(" leading");
    Ожидаем.Что(Разобранное.Получить("k")).Равно("  v");
    Ожидаем.Что(Разобранное.Получить("other")).Равно("x");
КонецПроцедуры

