// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
#Использовать "../../.."
#Использовать asserts
#Использовать moskito

// Процессор и спан для фонового задания экспорта
Перем ПроцессорДляФона;
Перем СпанДляФона;
Перем ЗаданиеЭкспорта;

&Тест
Процедура ОбработкаСпана() Экспорт
    // Дано
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерСпанов"));
    Процессор = Новый ОтелПростойПроцессорСпанов(МокЭкспортер);
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("библ", "1.0");
    Спан = Новый ОтелСпан("тест", Ресурс, ОбластьИнструментирования);
    Спан.Завершить();

    // Когда
    Процессор.ПриЗавершении(Спан);

    // Тогда
    МокЭкспортер.ПроверитьЧтоВызывалсяМетод().Экспортировать(Матчеры.ЛюбоеЗначение());
КонецПроцедуры

&Тест
Процедура Закрыть() Экспорт
    // Дано
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерСпанов"));
    Процессор = Новый ОтелПростойПроцессорСпанов(МокЭкспортер);

    // Когда
    Процессор.Закрыть();

    // Тогда - per spec: Shutdown MUST call Exporter.Shutdown
    МокЭкспортер.ПроверитьЧтоВызывалсяМетод().Закрыть();
КонецПроцедуры

&Тест
Процедура ПриНачале() Экспорт
    // Дано
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерСпанов"));
    Процессор = Новый ОтелПростойПроцессорСпанов(МокЭкспортер);
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("библ", "1.0");
    Спан = Новый ОтелСпан("тест", Ресурс, ОбластьИнструментирования);
    РодительскийКонтекст = Новый Соответствие();

    // Когда / Тогда - ПриНачале принимает спан и родительский контекст (no-op)
    Процессор.ПриНачале(Спан, РодительскийКонтекст);
КонецПроцедуры

&Тест
Процедура СброситьБуфер() Экспорт
    // Дано
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерСпанов"));
    Процессор = Новый ОтелПростойПроцессорСпанов(МокЭкспортер);

    // Когда
    Процессор.СброситьБуфер();

    // Тогда - per spec: ForceFlush MUST call Exporter.ForceFlush
    МокЭкспортер.ПроверитьЧтоВызывалсяМетод().СброситьБуфер(Матчеры.ЛюбоеЗначение());
КонецПроцедуры

&Тест
Процедура ПриЗавершенииПослеЗакрытия() Экспорт
    // Дано
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерСпанов"));
    Процессор = Новый ОтелПростойПроцессорСпанов(МокЭкспортер);
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("библ", "1.0");
    Спан = Новый ОтелСпан("тест", Ресурс, ОбластьИнструментирования);
    Спан.Завершить();
    Процессор.Закрыть();

    // Когда - вызов после Shutdown не должен падать
    Процессор.ПриЗавершении(Спан);

    // Тогда - вызов прошел без ошибок, спан проигнорирован
КонецПроцедуры

&Тест
Процедура ПриЗавершенииНеСэмплированногоСпана() Экспорт
    // Дано - span with TraceFlags=0 (not sampled, RECORD_ONLY)
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерСпанов"));
    МокЭкспортер.Когда().Экспортировать(Матчеры.ЛюбоеЗначение()).ТогдаВыбрасываетИсключение(
        "ОтелПростойПроцессорСпанов не должен экспортировать несэмплированные спаны");
    Процессор = Новый ОтелПростойПроцессорСпанов(МокЭкспортер);
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("библ", "1.0");
    НеСэмплированныйСпан = Новый ОтелСпан("тест", Ресурс, ОбластьИнструментирования,
        Неопределено, "", Неопределено, Неопределено, Неопределено, Неопределено, 0);
    НеСэмплированныйСпан.Завершить();

    // Когда / Тогда - по спецификации SpanProcessor MUST NOT экспортировать non-sampled спаны
    Процессор.ПриЗавершении(НеСэмплированныйСпан);
КонецПроцедуры

&Тест
Процедура ПриЗавершенииБезЭкспортера() Экспорт
    // Дано - процессор без экспортера
    Процессор = Новый ОтелПростойПроцессорСпанов(Неопределено);
    Ресурс = Новый ОтелРесурс(Истина);
    ОбластьИнструментирования = Новый ОтелОбластьИнструментирования("библ", "1.0");
    Спан = Новый ОтелСпан("тест", Ресурс, ОбластьИнструментирования);
    Спан.Завершить();

    // Когда / Тогда - не бросает исключение
    Процессор.ПриЗавершении(Спан);
КонецПроцедуры

&Тест
Процедура СброситьБуферБезЭкспортера() Экспорт
    // Дано
    Процессор = Новый ОтелПростойПроцессорСпанов(Неопределено);

    // Когда
    Результат = Процессор.СброситьБуфер();

    // Тогда - возвращает успех
    Ожидаем.Что(Результат.Успешно()).Равно(Истина);
КонецПроцедуры

&Тест
Процедура ЗакрытьДважды() Экспорт
    // Дано
    МокЭкспортер = Мок.Получить(Тип("ОтелЭкспортерСпанов"));
    Процессор = Новый ОтелПростойПроцессорСпанов(МокЭкспортер);

    // Когда - закрываем дважды
    Результат1 = Процессор.Закрыть();
    Результат2 = Процессор.Закрыть();

    // Тогда - оба вызова возвращают успех, экспортер закрывается один раз
    Ожидаем.Что(Результат1.Успешно()).Равно(Истина);
    Ожидаем.Что(Результат2.Успешно()).Равно(Истина);
КонецПроцедуры

&Тест
Процедура ЗакрытьБезЭкспортера() Экспорт
    // Дано
    Процессор = Новый ОтелПростойПроцессорСпанов(Неопределено);

    // Когда
    Результат = Процессор.Закрыть();

    // Тогда - возвращает успех
    Ожидаем.Что(Результат.Успешно()).Равно(Истина);
КонецПроцедуры

// Trace SDK / Shutdown MUST включать эффект ForceFlush: буфер экспортера сбрасывается до его
// закрытия; ошибка закрытия экспортера сообщается в результате

&Тест
Процедура ЗакрытьСбрасываетБуферЭкспортераПередЗакрытием() Экспорт

    // Дано
    Экспортер = ЭкспортерСЖурналомВызовов(ОтелРезультатыЗакрытия.Успех());
    Процессор = Новый ОтелПростойПроцессорСпанов(Экспортер);

    // Когда
    Результат = Процессор.Закрыть(5000);

    // Тогда
    Ожидаем.Что(Результат.Успешно(), Результат.Описание()).ЭтоИстина();
    Ожидаем.Что(СтрСоединить(Экспортер.Вызовы, ",")).Равно("СброситьБуфер,Закрыть");

КонецПроцедуры

&Тест
Процедура ЗакрытьСообщаетОшибкуЗакрытияЭкспортера() Экспорт

    // Дано
    Экспортер = ЭкспортерСЖурналомВызовов(ОтелРезультатыЗакрытия.Ошибка("сбой закрытия экспортера"));
    Процессор = Новый ОтелПростойПроцессорСпанов(Экспортер);

    // Когда
    Результат = Процессор.Закрыть(5000);

    // Тогда
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
    Ожидаем.Что(СтрНайти(Результат.Описание(), "сбой закрытия экспортера") > 0, Результат.Описание()).ЭтоИстина();

КонецПроцедуры

// Shutdown SHOULD укладываться в таймаут: экспорт, зависший в другом потоке, не ждется
// дольше срока, экспортер закрывается

&Тест
Процедура ЗакрытьСоблюдаетТаймаутПриЗависшемЭкспорте() Экспорт

    // Дано - экспорт в другом потоке длится 1000 мс
    Экспортер = МедленныйЭкспортерСпанов(1000);
    ПроцессорДляФона = Новый ОтелПростойПроцессорСпанов(Экспортер);
    СпанДляФона = Новый ОтелСпан("тест", Новый ОтелРесурс(Истина), Новый ОтелОбластьИнструментирования("библ", "1.0"));
    СпанДляФона.Завершить();
    Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЭкспортироватьСпанВФоне");
    ДождатьсяНачалаЭкспорта(Экспортер);

    // Когда
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Результат = ПроцессорДляФона.Закрыть(100);
    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
    Задание.ОжидатьЗавершения();

    // Тогда - таймаут без ожидания экспорта, экспортер все равно закрыт
    Ожидаем.Что(Результат.ИстекТаймаут(), Результат.Описание()).ЭтоИстина();
    Ожидаем.Что(ДлительностьМс < 600, ДлительностьМс).ЭтоИстина();
    Ожидаем.Что(Экспортер.Закрыт, "экспортер закрыт").ЭтоИстина();

КонецПроцедуры

// Trace SDK / ForceFlush: задачи спанов, полученных процессором до ForceFlush, SHOULD завершиться
// до возврата: сброс буфера дожидается экспорта, начатого в другом потоке, в пределах таймаута

&Тест
Процедура СброситьБуферДожидаетсяТекущегоЭкспорта() Экспорт

    // Дано - экспорт в другом потоке длится 300 мс
    Экспортер = МедленныйЭкспортерСпанов(300);
    ЗапуститьЭкспортВФоне(Экспортер);

    // Когда
    Результат = ПроцессорДляФона.СброситьБуфер(5000);
    ЗаданиеЭкспорта.ОжидатьЗавершения();

    // Тогда - буфер экспортера сброшен после завершения экспорта
    Ожидаем.Что(Результат.Успешно()).ЭтоИстина();
    Ожидаем.Что(Экспортер.ЭкспортЗавершенПриСбросе, "экспорт завершен до сброса буфера").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СброситьБуферСоблюдаетТаймаутПриЗависшемЭкспорте() Экспорт

    // Дано - экспорт в другом потоке длится 1000 мс
    Экспортер = МедленныйЭкспортерСпанов(1000);
    ЗапуститьЭкспортВФоне(Экспортер);

    // Когда
    НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Результат = ПроцессорДляФона.СброситьБуфер(100);
    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
    ЗаданиеЭкспорта.ОжидатьЗавершения();

    // Тогда
    Ожидаем.Что(Результат.ИстекТаймаут()).ЭтоИстина();
    Ожидаем.Что(ДлительностьМс < 600, ДлительностьМс).ЭтоИстина();

КонецПроцедуры

Процедура ЗапуститьЭкспортВФоне(Экспортер)
    ПроцессорДляФона = Новый ОтелПростойПроцессорСпанов(Экспортер);
    СпанДляФона = Новый ОтелСпан("тест", Новый ОтелРесурс(Истина), Новый ОтелОбластьИнструментирования("библ", "1.0"));
    СпанДляФона.Завершить();
    ЗаданиеЭкспорта = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЭкспортироватьСпанВФоне");
    ДождатьсяНачалаЭкспорта(Экспортер);
КонецПроцедуры

Процедура ЭкспортироватьСпанВФоне() Экспорт
    ПроцессорДляФона.ПриЗавершении(СпанДляФона);
КонецПроцедуры

Процедура ДождатьсяНачалаЭкспорта(Экспортер)
    Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Пока НЕ Экспортер.НачатЭкспорт.Получить() Цикл
        Если ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало > 10000 Тогда
            ВызватьИсключение "Фоновый экспорт не начался за 10 с";
        КонецЕсли;
        Приостановить(5);
    КонецЦикла;
КонецПроцедуры

Функция МедленныйЭкспортерСпанов(ЗадержкаМс)
    Экспортер = ЗагрузитьСценарийИзСтроки("Перем ЗадержкаМс Экспорт;
    |Перем НачатЭкспорт Экспорт;
    |Перем ЗавершенЭкспорт Экспорт;
    |Перем ЭкспортЗавершенПриСбросе Экспорт;
    |Перем Закрыт Экспорт;
    |Функция Экспортировать(Спаны, Таймаут = Неопределено) Экспорт
    |    НачатЭкспорт.Установить(Истина);
    |    Приостановить(ЗадержкаМс);
    |    ЗавершенЭкспорт.Установить(Истина);
    |    Возврат Истина;
    |КонецФункции
    |Функция СброситьБуфер(ТаймаутМс = 0) Экспорт
    |    ЭкспортЗавершенПриСбросе = ЗавершенЭкспорт.Получить();
    |    Возврат ОтелРезультатыЭкспорта.Успех();
    |КонецФункции
    |Функция Закрыть() Экспорт
    |    Закрыт = Истина;
    |    Возврат ОтелРезультатыЗакрытия.Успех();
    |КонецФункции
    |Закрыт = Ложь;");
    Экспортер.ЗадержкаМс = ЗадержкаМс;
    Экспортер.НачатЭкспорт = Новый АтомарноеБулево(Ложь);
    Экспортер.ЗавершенЭкспорт = Новый АтомарноеБулево(Ложь);
    Возврат Экспортер;
КонецФункции

Функция ЭкспортерСЖурналомВызовов(РезультатЗакрытия)
    Экспортер = ЗагрузитьСценарийИзСтроки("Перем Вызовы Экспорт;
    |Перем РезультатЗакрытия Экспорт;
    |Функция Экспортировать(Спаны, Таймаут = Неопределено) Экспорт
    |    Вызовы.Добавить(""Экспортировать"");
    |    Возврат Истина;
    |КонецФункции
    |Функция СброситьБуфер(ТаймаутМс = 0) Экспорт
    |    Вызовы.Добавить(""СброситьБуфер"");
    |    Возврат ОтелРезультатыЭкспорта.Успех();
    |КонецФункции
    |Функция Закрыть(ТаймаутМс = 0) Экспорт
    |    Вызовы.Добавить(""Закрыть"");
    |    Возврат РезультатЗакрытия;
    |КонецФункции
    |Вызовы = Новый Массив();");
    Экспортер.РезультатЗакрытия = РезультатЗакрытия;
    Возврат Экспортер;
КонецФункции
