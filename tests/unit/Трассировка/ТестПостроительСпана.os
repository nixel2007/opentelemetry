КонецПроцедуры

&Тест
Процедура ДобавитьЛинк() Экспорт
    // Дано
    ОтелКонтекст.Очистить();
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерТрассировки(Ресурс);
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ", "1.0");
    КонтекстЛинка = Новый ОтелКонтекстСпана("01020304050607080910111213141516", "0102030405060708");

    // Когда
    Спан = Трассировщик.ПостроительСпана("операция")
        .ДобавитьЛинк(КонтекстЛинка)
        .НачатьСпан();

    // Тогда
    Ожидаем.Что(Спан.Линки().Количество()).Равно(1);
    Ожидаем.Что(Спан.Линки()[0].КонтекстСпана()).Равно(КонтекстЛинка);

    // Очистка
    Спан.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();
КонецПроцедуры

&Тест
Процедура FluentAPI() Экспорт
    // Дано
    ОтелКонтекст.Очистить();
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерТрассировки(Ресурс);
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ", "1.0");
    КонтекстЛинка = Новый ОтелКонтекстСпана("01020304050607080910111213141516", "0102030405060708");

    // Когда - цепочка вызовов
    Спан = Трассировщик.ПостроительСпана("операция")
        .УстановитьВидСпана(ОтелВидСпана.Клиент())
        .УстановитьАтрибут("http.method", "GET")
        .УстановитьАтрибут("http.url", "https://example.com")
        .ДобавитьЛинк(КонтекстЛинка)
        .НачатьСпан();

    // Тогда - все параметры применены
    Ожидаем.Что(Спан.ВидСпана()).Равно(ОтелВидСпана.Клиент());
    Ожидаем.Что(Спан.Атрибуты().Получить("http.method")).Равно("GET");
    Ожидаем.Что(Спан.Атрибуты().Получить("http.url")).Равно("https://example.com");
    Ожидаем.Что(Спан.Линки().Количество()).Равно(1);

    // Очистка
    Спан.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();
КонецПроцедуры

&Тест
Процедура УстановитьРодителя() Экспорт
    // Дано
    ОтелКонтекст.Очистить();
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерТрассировки(Ресурс);
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ", "1.0");
    Родитель = Трассировщик.НачатьСпан("родитель");

    // Когда - создаем спан с явным родителем через построитель (передаём Context, не Span)
    КонтекстРодителя = ОтелКонтекст.КонтекстСоСпаном(ОтелКонтекст.Текущий(), Родитель);
    Спан = Трассировщик.ПостроительСпана("дочерний")
        .УстановитьРодителя(КонтекстРодителя)
        .НачатьСпан();

    // Тогда - спан наследует trace ID от родителя
    Ожидаем.Что(Спан.КонтекстСпана().ИдТрассировки()).Равно(Родитель.КонтекстСпана().ИдТрассировки());
    Ожидаем.Что(Спан.ИдРодительскогоСпана()).Равно(Родитель.КонтекстСпана().ИдСпана());

    // Очистка
    Спан.Завершить();
    Родитель.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();
КонецПроцедуры

&Тест
Процедура БезРодителя() Экспорт
    // Дано
    ОтелКонтекст.Очистить();
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерТрассировки(Ресурс);
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ", "1.0");
    Родитель = Трассировщик.НачатьСпан("родитель");
    ОтелКонтекст.СделатьСпанТекущим(Родитель);

    // Когда - создаем корневой спан через БезРодителя
    Спан = Трассировщик.ПостроительСпана("корневой")
        .БезРодителя()
        .НачатьСпан();

    // Тогда - новый trace ID, нет родителя
    Ожидаем.Что(Спан.КонтекстСпана().ИдТрассировки() <> Родитель.КонтекстСпана().ИдТрассировки()).Равно(Истина);
    Ожидаем.Что(Спан.ИдРодительскогоСпана()).Равно("");

    // Очистка
    Спан.Завершить();
    Родитель.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();
КонецПроцедуры

&Тест
Процедура УстановитьВремяНачала() Экспорт
    // Дано
    ОтелКонтекст.Очистить();
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерТрассировки(Ресурс);
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ", "1.0");

    // Когда - указываем конкретное время начала
    Спан = Трассировщик.ПостроительСпана("операция")
        .УстановитьВремяНачала("1000000000000")
        .НачатьСпан();

    // Тогда - время начала переопределено
    Ожидаем.Что(Спан.ВремяНачала()).Равно("1000000000000");

    // Очистка
    Спан.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();
КонецПроцедуры

// Span Creation: время начала - параметр создания спана, процессор видит его уже в OnStart

&Тест
Процедура ВремяНачалаВидноВПриНачале() Экспорт

    // Дано - процессор запоминает время начала спана в ПриНачале
    ОтелКонтекст.Очистить();
    Процессор = ЗагрузитьСценарийИзСтроки(
        "Перем ВремяНачала Экспорт;
        |Процедура ПриНачале(Спан, РодительскийКонтекст = Неопределено) Экспорт
        |    ВремяНачала = Спан.ВремяНачала();
        |КонецПроцедуры
        |Процедура ПередЗавершением(Спан) Экспорт
        |КонецПроцедуры
        |Процедура ПриЗавершении(Спан) Экспорт
        |КонецПроцедуры
        |Функция СброситьБуфер(ТаймаутМс = 0) Экспорт
        |    Возврат ОтелРезультатыЭкспорта.Успех();
        |КонецФункции
        |Функция Закрыть(ТаймаутМс = 0) Экспорт
        |    Возврат ОтелРезультатыЗакрытия.Успех();
        |КонецФункции");
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина), Процессор);
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ", "1.0");

    // Когда
    Спан = Трассировщик.ПостроительСпана("операция")
        .УстановитьВремяНачала("1000000000000")
        .НачатьСпан();

    // Тогда
    Ожидаем.Что(Процессор.ВремяНачала).Равно("1000000000000");

    Спан.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура АтрибутыВидимыВПриНачале() Экспорт

    // Дано
    ОтелКонтекст.Очистить();
    Ресурс = Новый ОтелРесурс(Истина);
    Провайдер = Новый ОтелПровайдерТрассировки(Ресурс);
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ", "1.0");

    // Когда - атрибут установлен через построитель до начала спана
    Спан = Трассировщик.ПостроительСпана("операция")
        .УстановитьАтрибут("test.key", "test.val")
        .НачатьСпан();

    // Тогда - атрибут виден в спане сразу после начала
    Ожидаем.Что(Спан.Атрибуты().Получить("test.key")).Равно("test.val");

    // Очистка
    Спан.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

// Trace API / Determining the Parent Span from a Context: явный Context без спана дает
// корневой спан, даже если в неявном текущем контексте есть активный спан

&Тест
Процедура ЯвныйКонтекстБезСпанаСоздаетКорневойСпан() Экспорт

    // Дано - в текущем контексте активен спан
    ОтелКонтекст.Очистить();
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина));
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ", "1.0");
    Текущий = Трассировщик.НачатьСпан("текущий");
    Область = Текущий.СделатьТекущим();

    // Когда - явный Context без спана
    Спан = Трассировщик.ПостроительСпана("корневой")
        .УстановитьРодителя(Новый Соответствие())
        .НачатьСпан();

    // Тогда - корневой спан с новым trace ID
    Область.Закрыть();
    Ожидаем.Что(Спан.ИдРодительскогоСпана()).Равно("");
    Ожидаем.Что(Спан.КонтекстСпана().ИдТрассировки()).Не_().Равно(Текущий.КонтекстСпана().ИдТрассировки());

    Спан.Завершить();
    Текущий.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура ЯвныйКонтекстБезСпанаВAPIРежимеДаетПустойНезаписывающийСпан() Экспорт

    // Дано - API без SDK (трассировщик выключен), в текущем контексте удаленный спан
    ОтелКонтекст.Очистить();
    Провайдер = Новый ОтелПровайдерТрассировки();
    Провайдер.УстановитьВключен(Ложь);
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ");
    КонтекстУдаленного = Новый ОтелКонтекстСпана(
        "0af7651916cd43dd8448eb211c80319c", "b7ad6b7169203331", 1, "", Истина);
    Удаленный = ОтелСпаны.Обернуть(КонтекстУдаленного);
    Область = Удаленный.СделатьТекущим();

    // Когда
    Спан = Трассировщик.ПостроительСпана("операция")
        .УстановитьРодителя(Новый Соответствие())
        .НачатьСпан();

    // Тогда - пустой non-recording спан: нулевые ID, unsampled
    Область.Закрыть();
    Ожидаем.Что(Спан.ЗаписьАктивна()).ЭтоЛожь();
    Ожидаем.Что(Спан.КонтекстСпана().Валиден()).ЭтоЛожь();
    Ожидаем.Что(Спан.КонтекстСпана().ИдТрассировки()).Равно("00000000000000000000000000000000");
    Ожидаем.Что(Спан.КонтекстСпана().ФлагиТрассировки()).Равно(0);

    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура ЯвныйКонтекстПередаетсяПроцессоруВПриНачале() Экспорт

    // Дано - процессор запоминает контекст, переданный в ПриНачале
    ОтелКонтекст.Очистить();
    Процессор = ЗагрузитьСценарийИзСтроки(
        "Перем Контексты Экспорт;
        |Процедура ПриНачале(Спан, РодительскийКонтекст = Неопределено) Экспорт
        |    Контексты.Добавить(РодительскийКонтекст);
        |КонецПроцедуры
        |Процедура ПередЗавершением(Спан) Экспорт
        |КонецПроцедуры
        |Процедура ПриЗавершении(Спан) Экспорт
        |КонецПроцедуры
        |Функция СброситьБуфер(ТаймаутМс = 0) Экспорт
        |    Возврат ОтелРезультатыЭкспорта.Успех();
        |КонецФункции
        |Функция Закрыть(ТаймаутМс = 0) Экспорт
        |    Возврат ОтелРезультатыЗакрытия.Успех();
        |КонецФункции
        |Контексты = Новый Массив();");
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина), Процессор);
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ");
    Родитель = Трассировщик.НачатьСпан("родитель");
    ЯвныйКонтекст = ОтелКонтекст.КонтекстСоСпаном(ОтелКонтекст.Текущий(), Родитель);
    ЯвныйБезСпана = Новый Соответствие();
    ЯвныйБезСпана.Вставить("маркер", "явный");

    // Когда
    СпанСРодителем = Трассировщик.ПостроительСпана("с-родителем").УстановитьРодителя(ЯвныйКонтекст).НачатьСпан();
    СпанБезРодителя = Трассировщик.ПостроительСпана("без-родителя").УстановитьРодителя(ЯвныйБезСпана).НачатьСпан();

    // Тогда - в ПриНачале переданы заданные контексты, а не текущий
    Ожидаем.Что(Процессор.Контексты.Количество()).Равно(3);
    Ожидаем.Что(ОтелКонтекст.СпанИзКонтекста(Процессор.Контексты[1])).Равно(Родитель);
    Ожидаем.Что(Процессор.Контексты[2].Получить("маркер")).Равно("явный");

    СпанСРодителем.Завершить();
    СпанБезРодителя.Завершить();
    Родитель.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры
