    Провайдер.ОбновитьКонфигуратор(Конфигуратор);

    // Тогда - исключение поглощено, трассировщик по-прежнему включён (конфигурация = Неопределено)
    Ожидаем.Что(Трассировщик.Включен()).Равно(Истина);
    Провайдер.Закрыть();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("tooshort")
&ИсточникЗначение("00000000000000000000000000000000")
&ИсточникЗначение("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
&ИсточникЗначение("A1B2C3D4E5F6A7B8A1B2C3D4E5F6A7B8")
Процедура НекорректныйИдТрассировкиЗаменяетсяГенераторомПоУмолчанию(НекорректныйИд) Экспорт

    // Дано - пользовательский генератор возвращает некорректный IdТрассировки
    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.traceprovider");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Ошибка);
    Провайдер = Новый ОтелПостроительПровайдераТрассировки()
        .УстановитьГенераторИд(ГенераторИд(НекорректныйИд, "a1b2c3d4e5f6a7b8"))
        .Построить();
    Трассировщик = Провайдер.ПолучитьТрассировщик("тест");

    // Когда
    Спан = Трассировщик.НачатьСпан("тест-спан");

    // Тогда - IdТрассировки взят из генератора по умолчанию, корректный IdСпана сохранен
    Контекст = Спан.КонтекстСпана();
    Ожидаем.Что(Контекст.Валиден(), "контекст спана валиден").ЭтоИстина();
    Ожидаем.Что(Контекст.ИдСпана(), "корректный IdСпана генератора").Равно("a1b2c3d4e5f6a7b8");
    Ожидаем.Что(ЕстьОшибкаСТекстом(Аппендер, НекорректныйИд), "ошибка в логе").ЭтоИстина();

    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);
    Спан.Завершить();
    Провайдер.Закрыть();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("badspan")
&ИсточникЗначение("0000000000000000")
&ИсточникЗначение("zzzzzzzzzzzzzzzz")
&ИсточникЗначение("A1B2C3D4E5F6A7B8")
Процедура НекорректныйИдСпанаЗаменяетсяГенераторомПоУмолчанию(НекорректныйИд) Экспорт

    // Дано - пользовательский генератор возвращает некорректный IdСпана
    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.traceprovider");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Ошибка);
    Провайдер = Новый ОтелПостроительПровайдераТрассировки()
        .УстановитьГенераторИд(ГенераторИд("a1b2c3d4e5f6a7b8a1b2c3d4e5f6a7b8", НекорректныйИд))
        .Построить();
    Трассировщик = Провайдер.ПолучитьТрассировщик("тест");

    // Когда
    Спан = Трассировщик.НачатьСпан("тест-спан");

    // Тогда - IdСпана взят из генератора по умолчанию, корректный IdТрассировки сохранен
    Контекст = Спан.КонтекстСпана();
    Ожидаем.Что(Контекст.Валиден(), "контекст спана валиден").ЭтоИстина();
    Ожидаем.Что(Контекст.ИдТрассировки(), "корректный IdТрассировки генератора")
        .Равно("a1b2c3d4e5f6a7b8a1b2c3d4e5f6a7b8");
    Ожидаем.Что(ЕстьОшибкаСТекстом(Аппендер, НекорректныйИд), "ошибка в логе").ЭтоИстина();

    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);
    Спан.Завершить();
    Провайдер.Закрыть();

КонецПроцедуры

Функция ГенераторИд(ИдТрассировки, ИдСпана)
    Текст = СтрШаблон(
        "Функция СгенерироватьИдТрассировки() Экспорт
        |    Возврат ""%1"";
        |КонецФункции
        |Функция СгенерироватьИдСпана() Экспорт
        |    Возврат ""%2"";
        |КонецФункции", ИдТрассировки, ИдСпана);
    Возврат ЗагрузитьСценарийИзСтроки(Текст);
КонецФункции

Функция СоздатьТестовыйАппендер()
    Текст = "Перем События Экспорт;
    |Процедура ВывестиСобытие(Событие) Экспорт
    |    События.Добавить(Событие);
    |КонецПроцедуры
    |Процедура Закрыть() Экспорт
    |КонецПроцедуры
    |Процедура УстановитьСвойство(Имя, Значение) Экспорт
    |КонецПроцедуры
    |События = Новый Массив();";
    Возврат ЗагрузитьСценарийИзСтроки(Текст);
КонецФункции

Функция ЕстьОшибкаСТекстом(Аппендер, Текст)
    Для Каждого Событие Из Аппендер.События Цикл
        Если Событие.ПолучитьУровень() = УровниЛога.Ошибка
                И СтрНайти(Событие.ПолучитьСообщение(), Текст) > 0 Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

&Тест
Процедура ПринудительноВыгрузитьУспешно() Экспорт

    // Дано - процессор успешно сбрасывает буфер
    МокПроцессор = Мок.Получить(Тип("ОтелПростойПроцессорСпанов"));
    МокПроцессор.Когда().СброситьБуфер(Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(
        ОтелРезультатыЭкспорта.Успех());
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина), МокПроцессор);

    // Когда
    Результат = Провайдер.ПринудительноВыгрузитьСРезультатом();

    // Тогда - возвращает успех
    Ожидаем.Что(Результат.Успешно()).Равно(Истина);
    Провайдер.Закрыть();

КонецПроцедуры

