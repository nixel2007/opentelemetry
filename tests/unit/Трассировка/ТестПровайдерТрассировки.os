    Провайдер.Закрыть();

КонецПроцедуры

// Trace SDK / Shutdown: MUST вызываться у всех процессоров, SHOULD сообщать об успехе,
// ошибке или таймауте и укладываться в таймаут

&Тест
Процедура ЗакрытьСообщаетОшибкуЗакрытияПроцессора() Экспорт

    // Дано - процессор сообщает о сбое результатом, без исключения
    Процессор = ПроцессорЗакрытия(ОтелРезультатыЗакрытия.Ошибка("сбой финального экспорта"));
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина), Процессор);

    // Когда
    Результат = Провайдер.Закрыть();

    // Тогда
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
    Ожидаем.Что(СтрНайти(Результат.Описание(), "сбой финального экспорта") > 0, Результат.Описание()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗакрытьЗакрываетВсеПроцессорыПослеИсключенияИТаймаута() Экспорт

    // Дано - процессор с исключением, медленный процессор и последний
    Бросающий = ПроцессорЗакрытия(Неопределено, 0, "сбой процессора");
    Медленный = ПроцессорЗакрытия(ОтелРезультатыЗакрытия.Успех(), 300);
    Последний = ПроцессорЗакрытия(ОтелРезультатыЗакрытия.Успех());
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина), Бросающий);
    Провайдер.ДобавитьПроцессор(Медленный);
    Провайдер.ДобавитьПроцессор(Последний);

    // Когда
    Результат = Провайдер.Закрыть(100);

    // Тогда - закрыты все, последний - с минимальным временем после истечения срока
    Ожидаем.Что(Медленный.Закрыт, "медленный закрыт").ЭтоИстина();
    Ожидаем.Что(Последний.Закрыт, "последний закрыт").ЭтоИстина();
    Ожидаем.Что(Последний.ПереданныйТаймаут).Равно(1);
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();

КонецПроцедуры

// Trace SDK / ForceFlush: сброс вызывается у всех процессоров в пределах общего срока,
// SHOULD сообщать об ошибке или таймауте

&Тест
Процедура СброситьБуферСбрасываетВсеПроцессорыПослеИсключенияИТаймаута() Экспорт

    // Дано - процессор с исключением, медленный процессор и последний
    Бросающий = ПроцессорСброса(0, "сбой процессора");
    Медленный = ПроцессорСброса(300);
    Последний = ПроцессорСброса();
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина), Бросающий);
    Провайдер.ДобавитьПроцессор(Медленный);
    Провайдер.ДобавитьПроцессор(Последний);

    // Когда
    Результат = Провайдер.СброситьБуфер(100);

    // Тогда - сброшены все, последний - с минимальным временем после истечения срока
    Ожидаем.Что(Медленный.Сброшен, "медленный сброшен").ЭтоИстина();
    Ожидаем.Что(Последний.Сброшен, "последний сброшен").ЭтоИстина();
    Ожидаем.Что(Последний.ПереданныйТаймаут).Равно(1);
    Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СброситьБуферСообщаетТаймаутМедленногоПроцессора() Экспорт

    // Дано
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина), ПроцессорСброса(300));

    // Когда
    Результат = Провайдер.СброситьБуфер(100);

    // Тогда
    Ожидаем.Что(Результат.ИстекТаймаут()).ЭтоИстина();

КонецПроцедуры

Функция ПроцессорСброса(ЗадержкаМс = 0, ТекстИсключения = "")
    Текст = "Перем ЗадержкаМс Экспорт;
    |Перем ТекстИсключения Экспорт;
    |Перем ПереданныйТаймаут Экспорт;
    |Перем Сброшен Экспорт;
    |Процедура ПриНачале(Спан, РодительскийКонтекст = Неопределено) Экспорт
    |КонецПроцедуры
    |Процедура ПриЗавершении(Спан) Экспорт
    |КонецПроцедуры
    |Функция СброситьБуфер(ТаймаутМс = 0) Экспорт
    |    Сброшен = Истина;
    |    ПереданныйТаймаут = ТаймаутМс;
    |    Если ЗадержкаМс > 0 Тогда
    |        Приостановить(ЗадержкаМс);
    |    КонецЕсли;
    |    Если ТекстИсключения <> """" Тогда
    |        ВызватьИсключение ТекстИсключения;
    |    КонецЕсли;
    |    Возврат ОтелРезультатыЭкспорта.Успех();
    |КонецФункции
    |Функция Закрыть(ТаймаутМс = 0) Экспорт
    |    Возврат ОтелРезультатыЗакрытия.Успех();
    |КонецФункции
    |Сброшен = Ложь;";
    Процессор = ЗагрузитьСценарийИзСтроки(Текст);
    Процессор.ЗадержкаМс = ЗадержкаМс;
    Процессор.ТекстИсключения = ТекстИсключения;
    Возврат Процессор;
КонецФункции

Функция ПроцессорЗакрытия(Результат, ЗадержкаМс = 0, ТекстИсключения = "")
    Текст = "Перем Результат Экспорт;
    |Перем ЗадержкаМс Экспорт;
    |Перем ТекстИсключения Экспорт;
    |Перем ПереданныйТаймаут Экспорт;
    |Перем Закрыт Экспорт;
    |Процедура ПриНачале(Спан, РодительскийКонтекст = Неопределено) Экспорт
    |КонецПроцедуры
    |Процедура ПриЗавершении(Спан) Экспорт
    |КонецПроцедуры
    |Функция СброситьБуфер(ТаймаутМс = 0) Экспорт
    |    Возврат ОтелРезультатыЭкспорта.Успех();
    |КонецФункции
    |Функция Закрыть(ТаймаутМс = 0) Экспорт
    |    Закрыт = Истина;
    |    ПереданныйТаймаут = ТаймаутМс;
    |    Если ЗадержкаМс > 0 Тогда
    |        Приостановить(ЗадержкаМс);
    |    КонецЕсли;
    |    Если ТекстИсключения <> """" Тогда
    |        ВызватьИсключение ТекстИсключения;
    |    КонецЕсли;
    |    Возврат Результат;
    |КонецФункции
    |Закрыт = Ложь;";
    Процессор = ЗагрузитьСценарийИзСтроки(Текст);
    Процессор.Результат = Результат;
    Процессор.ЗадержкаМс = ЗадержкаМс;
    Процессор.ТекстИсключения = ТекстИсключения;
    Возврат Процессор;
КонецФункции

// ParentBased (Trace SDK, Built-in samplers): необязательные делегаты задаются и через построитель.
// Делегат удаленного несэмплированного родителя ВсегдаВключен вместо ВсегдаВыключен по умолчанию
&Тест
Процедура ПостроительПередаетДелегатыНаОсновеРодителя() Экспорт
    // Дано
    ОтелКонтекст.Очистить();
    Конфигурация = ОтелСэмплер.СоздатьКонфигурациюНаОсновеРодителя(, ОтелСэмплер.ВсегдаВключен());
    Провайдер = Новый ОтелПостроительПровайдераТрассировки()
        .УстановитьРесурс(Новый ОтелРесурс(Истина))
        .УстановитьСэмплер(ОтелСэмплер.НаОсновеРодителя(), , , Конфигурация)
        .Построить();
    КонтекстРодителя = Новый ОтелКонтекстСпана("11111111111111111111111111111111", "2222222222222222", 0, , Истина);
    ОтелКонтекст.СделатьСпанТекущим(Новый ОтелНезаписывающийСпан(КонтекстРодителя));
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ", "1.0");

    // Когда
    Спан = Трассировщик.НачатьСпан("child");

    // Тогда
    Ожидаем.Что(Спан.ЗаписьАктивна()).Равно(Истина);

    Спан.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();
КонецПроцедуры
