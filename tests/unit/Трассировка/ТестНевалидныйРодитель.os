// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// Регрессионный набор: невалидный (нулевой) SpanContext родителя.
//
// Спецификация Trace SDK, «SDK Span creation»: "If there is a valid parent trace ID, use it.
// Otherwise generate a new trace ID". Невалидный родитель (ОтелСпаны.Невалидный(),
// незаписывающий спан API-режима, контекст с нулевыми ID) трактуется как отсутствие родителя:
// новый спан корневой, получает свежий TraceId, а сэмплер НаОсновеРодителя применяет
// корневую стратегию.
//
// Нулевые ID в истории репозитория исправлялись точечно на границах (пропагаторы,
// генератор ID, линки), поэтому здесь закреплены все пути создания спана.
#Использовать "../../.."
#Использовать asserts

Перем НулевойИдТрассировки;

&Тест
Процедура НачатьСпанСНевалиднымСпаномВКонтекстеСоздаетКорневойСпан() Экспорт

    // Дано - невалидный спан сделан текущим
    ОтелКонтекст.Очистить();
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина));
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ", "1.0");
    Токен = ОтелКонтекст.СделатьСпанТекущим(ОтелСпаны.Невалидный());

    // Когда
    Спан = Трассировщик.НачатьСпан("операция");
    ОтелКонтекст.ОтсоединитьКонтекст(Токен);

    // Тогда
    ПроверитьКорневойСпанСНовымИдТрассировки(Спан);

    Спан.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура НачатьДочернийСпанСНевалиднымРодительскимСпаномСоздаетКорневойСпан() Экспорт

    // Дано
    ОтелКонтекст.Очистить();
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина));
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ", "1.0");

    // Когда - явный родитель невалиден
    Спан = Трассировщик.НачатьДочернийСпан("операция", ОтелСпаны.Невалидный());

    // Тогда
    ПроверитьКорневойСпанСНовымИдТрассировки(Спан);

    Спан.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура НачатьДочернийСпанСНевалиднымКонтекстомРодителяСоздаетКорневойСпан() Экспорт

    // Дано
    ОтелКонтекст.Очистить();
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина));
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ", "1.0");
    НевалидныйКонтекст = ОтелСпаны.Невалидный().КонтекстСпана();

    // Когда - явный родитель передан как невалидный SpanContext
    Спан = Трассировщик.НачатьДочернийСпан("операция", НевалидныйКонтекст);

    // Тогда
    ПроверитьКорневойСпанСНовымИдТрассировки(Спан);

    Спан.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура ПостроительСпанаСНевалиднымРодителемВКонтекстеСоздаетКорневойСпан() Экспорт

    // Дано - контекст, в котором лежит невалидный спан
    ОтелКонтекст.Очистить();
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина));
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ", "1.0");
    КонтекстРодителя = ОтелКонтекст.КонтекстСоСпаном(ОтелКонтекст.Текущий(), ОтелСпаны.Невалидный());

    // Когда
    Спан = Трассировщик.ПостроительСпана("операция")
        .УстановитьРодителя(КонтекстРодителя)
        .НачатьСпан();

    // Тогда
    ПроверитьКорневойСпанСНовымИдТрассировки(Спан);

    Спан.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура НаОсновеРодителяСНевалиднымРодителемПрименяетКорневуюСтратегию() Экспорт

    // Дано - НаОсновеРодителя с корневой стратегией ВсегдаВключен
    ОтелКонтекст.Очистить();
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина), ,
        ОтелСэмплер.НаОсновеРодителя(), 1.0, ОтелСэмплер.ВсегдаВключен());
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ", "1.0");
    Токен = ОтелКонтекст.СделатьСпанТекущим(ОтелСпаны.Невалидный());

    // Когда - невалидный родитель не сэмплирован, но родителем не считается
    Спан = Трассировщик.НачатьСпан("операция");
    ОтелКонтекст.ОтсоединитьКонтекст(Токен);

    // Тогда - решение принимает корневая стратегия
    ПроверитьКорневойСпанСНовымИдТрассировки(Спан);

    Спан.Завершить();
    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

&Тест
Процедура ОтброшенныйСпанПриНевалидномРодителеПолучаетНовыйИдТрассировки() Экспорт

    // Дано - НаОсновеРодителя с корневой стратегией ВсегдаВыключен
    ОтелКонтекст.Очистить();
    Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(Истина), ,
        ОтелСэмплер.НаОсновеРодителя(), 1.0, ОтелСэмплер.ВсегдаВыключен());
    Трассировщик = Провайдер.ПолучитьТрассировщик("библ", "1.0");
    Токен = ОтелКонтекст.СделатьСпанТекущим(ОтелСпаны.Невалидный());

    // Когда
    Спан = Трассировщик.НачатьСпан("операция");
    ОтелКонтекст.ОтсоединитьКонтекст(Токен);

    // Тогда - спан отброшен, но его контекст пригоден для пропагации
    Ожидаем.Что(Спан.ЗаписьАктивна()).Равно(Ложь);
    Ожидаем.Что(Спан.КонтекстСпана().Валиден()).Равно(Истина);
    Ожидаем.Что(Спан.КонтекстСпана().ИдТрассировки()).Не_().Равно(НулевойИдТрассировки);

    Провайдер.Закрыть();
    ОтелКонтекст.Очистить();

КонецПроцедуры

Процедура ПроверитьКорневойСпанСНовымИдТрассировки(Спан)
    Ожидаем.Что(Спан.ЗаписьАктивна(), "спан записывается").Равно(Истина);
    Ожидаем.Что(Спан.КонтекстСпана().ИдТрассировки(), "TraceId").Не_().Равно(НулевойИдТрассировки);
    Ожидаем.Что(Спан.КонтекстСпана().Валиден(), "SpanContext валиден").Равно(Истина);
    Ожидаем.Что(Спан.ИдРодительскогоСпана(), "спан корневой").Равно("");
КонецПроцедуры

НулевойИдТрассировки = "00000000000000000000000000000000";
