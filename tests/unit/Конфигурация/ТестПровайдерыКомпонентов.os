// ============================================================
// Провайдеры компонентов файла конфигурации (PluginComponentProvider, Configuration SDK).
// Реестр общий для процесса: каждый тест регистрирует провайдеры под своими именами
// ============================================================

// ===== Регистрация =====

// Configuration SDK, Register PluginComponentProvider: тип и имя - уникальный ключ, повторная
// регистрация - ошибка
&Тест
Процедура ПовторнаяРегистрацияТипаИИмениОшибка() Экспорт

	// Дано
	ПодключитьТестовыеКлассы();
	Тип = ОтелТипКомпонентаКонфигурации.ЭкспортерСпанов();
	ОтелКонфигурационнаяФабрика.ЗарегистрироватьПровайдерКомпонента(
		НовыйПровайдер(Неопределено), Тип, "повтор_экспортер");

	// Когда
	ТекстОшибки = "";
	Попытка
		ОтелКонфигурационнаяФабрика.ЗарегистрироватьПровайдерКомпонента(
			НовыйПровайдер(Неопределено), Тип, "повтор_экспортер");
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("""повтор_экспортер""");
	Ожидаем.Что(ТекстОшибки).Содержит("уже зарегистрирован");

КонецПроцедуры

&Тест
Процедура ОдноИмяРегистрируетсяДляРазныхТипов() Экспорт

	// Дано
	ПодключитьТестовыеКлассы();

	// Когда
	ОтелКонфигурационнаяФабрика.ЗарегистрироватьПровайдерКомпонента(
		НовыйПровайдер(Неопределено), ОтелТипКомпонентаКонфигурации.ЭкспортерСпанов(), "общее_имя");
	ОтелКонфигурационнаяФабрика.ЗарегистрироватьПровайдерКомпонента(
		НовыйПровайдер(Неопределено), ОтелТипКомпонентаКонфигурации.ЭкспортерЗаписейЛога(), "общее_имя");

	// Тогда - исключения нет
	Ожидаем.Что(Истина).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТипыКомпонентовПоСхемеКонфигурации() Экспорт

	// Тогда - тип компонента - имя типа схемы конфигурации
	Ожидаем.Что(ОтелТипКомпонентаКонфигурации.Пропагатор()).Равно("TextMapPropagator");
	Ожидаем.Что(ОтелТипКомпонентаКонфигурации.ЭкспортерСпанов()).Равно("SpanExporter");
	Ожидаем.Что(ОтелТипКомпонентаКонфигурации.ПроцессорСпанов()).Равно("SpanProcessor");
	Ожидаем.Что(ОтелТипКомпонентаКонфигурации.Сэмплер()).Равно("Sampler");
	Ожидаем.Что(ОтелТипКомпонентаКонфигурации.ГенераторИд()).Равно("IdGenerator");
	Ожидаем.Что(ОтелТипКомпонентаКонфигурации.ЧитательМетрикPull()).Равно("PullMetricExporter");
	Ожидаем.Что(ОтелТипКомпонентаКонфигурации.ЭкспортерМетрик()).Равно("PushMetricExporter");
	Ожидаем.Что(ОтелТипКомпонентаКонфигурации.ПродюсерМетрик()).Равно("MetricProducer");
	Ожидаем.Что(ОтелТипКомпонентаКонфигурации.ЭкспортерЗаписейЛога()).Равно("LogRecordExporter");
	Ожидаем.Что(ОтелТипКомпонентаКонфигурации.ПроцессорЗаписейЛога()).Равно("LogRecordProcessor");

КонецПроцедуры

// ===== Создание компонентов =====

// Configuration SDK, Create: компонент, которого нет в SDK, создает зарегистрированный провайдер
// с типом и именем компонента; свойства из модели передаются ему как ОтелСвойстваКонфигурации

&ПараметризованныйТест
&ИсточникЗначение("traces")
&ИсточникЗначение("logs")
Процедура ЭкспортерИзПровайдера(Сигнал) Экспорт

	// Дано
	ПодключитьТестовыеКлассы();
	Транспорт = Новый ОтелВПамятьТранспорт();
	Имя = "экспортер_из_провайдера_" + Сигнал;
	Если Сигнал = "traces" Тогда
		Провайдер = НовыйПровайдер(Новый ОтелЭкспортерСпанов(Транспорт));
		Тип = ОтелТипКомпонентаКонфигурации.ЭкспортерСпанов();
	Иначе
		Провайдер = НовыйПровайдер(Новый ОтелЭкспортерЛогов(Транспорт));
		Тип = ОтелТипКомпонентаКонфигурации.ЭкспортерЗаписейЛога();
	КонецЕсли;
	ОтелКонфигурационнаяФабрика.ЗарегистрироватьПровайдерКомпонента(Провайдер, Тип, Имя);
	КонфигПроцессора = Новый ОтелКонфигурацияПростогоПроцессора();
	КонфигПроцессора.Экспортер = КомпонентСоСвойством(Имя, "адрес", "http://collector");

	// Когда
	ПровайдерСигнала = ПровайдерСПроцессором(Сигнал, КонфигПроцессора);
	ЗаписатьТелеметрию(ПровайдерСигнала, Сигнал);
	ПровайдерСигнала.Закрыть();

	// Тогда
	Ожидаем.Что(Провайдер.КоличествоВызовов).Равно(1);
	Ожидаем.Что(ТипЗнч(Провайдер.ПолученныеСвойства)).Равно(Тип("ОтелСвойстваКонфигурации"));
	Ожидаем.Что(Провайдер.ПолученныеСвойства.ПолучитьСтроку("адрес")).Равно("http://collector");
	Ожидаем.Что(Транспорт.ПолучитьОтправленные()).ИмеетДлину(1);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("traces")
&ИсточникЗначение("logs")
Процедура ПроцессорИзПровайдера(Сигнал) Экспорт

	// Дано
	ПодключитьТестовыеКлассы();
	Транспорт = Новый ОтелВПамятьТранспорт();
	Имя = "процессор_из_провайдера_" + Сигнал;
	Если Сигнал = "traces" Тогда
		Процессор = Новый ОтелПростойПроцессорСпанов(Новый ОтелЭкспортерСпанов(Транспорт));
		Тип = ОтелТипКомпонентаКонфигурации.ПроцессорСпанов();
	Иначе
		Процессор = Новый ОтелПростойПроцессорЛогов(Новый ОтелЭкспортерЛогов(Транспорт));
		Тип = ОтелТипКомпонентаКонфигурации.ПроцессорЗаписейЛога();
	КонецЕсли;
	Провайдер = НовыйПровайдер(Процессор);
	ОтелКонфигурационнаяФабрика.ЗарегистрироватьПровайдерКомпонента(Провайдер, Тип, Имя);

	// Когда
	ПровайдерСигнала = ПровайдерСПроцессором(Сигнал, КомпонентСоСвойством(Имя, "размер", 10));
	ЗаписатьТелеметрию(ПровайдерСигнала, Сигнал);
	ПровайдерСигнала.Закрыть();

	// Тогда
	Ожидаем.Что(Провайдер.ПолученныеСвойства.ПолучитьЦелое("размер")).Равно(10);
	Ожидаем.Что(Транспорт.ПолучитьОтправленные()).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура ЭкспортерМетрикИПродюсерИзПровайдеров() Экспорт

	// Дано - периодический читатель с экспортером и продюсером из провайдеров
	ПодключитьТестовыеКлассы();
	Транспорт = Новый ОтелВПамятьТранспорт();
	ПровайдерЭкспортера = НовыйПровайдер(Новый ОтелЭкспортерМетрик(Транспорт));
	ОтелКонфигурационнаяФабрика.ЗарегистрироватьПровайдерКомпонента(
		ПровайдерЭкспортера, ОтелТипКомпонентаКонфигурации.ЭкспортерМетрик(), "экспортер_метрик_из_провайдера");
	Продюсер = Новый ТестовыйПродюсерМетрик();
	ПровайдерПродюсера = НовыйПровайдер(Продюсер);
	ОтелКонфигурационнаяФабрика.ЗарегистрироватьПровайдерКомпонента(
		ПровайдерПродюсера, ОтелТипКомпонентаКонфигурации.ПродюсерМетрик(), "продюсер_из_провайдера");
	КонфигЧитателя = Новый ОтелКонфигурацияПериодическогоЧитателя();
	КонфигЧитателя.Экспортер = КомпонентСоСвойством("экспортер_метрик_из_провайдера", "адрес", "x");
	КонфигЧитателя.Продюсеры.Добавить(КомпонентСоСвойством("продюсер_из_провайдера", "источник", "jmx"));
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераМетрик();
	КонфигПровайдера.Читатели.Добавить(КонфигЧитателя);

	// Когда
	ПровайдерМетрик = ОтелКонфигурационнаяФабрика.СоздатьПровайдерМетрик(Новый ОтелРесурс(), КонфигПровайдера);
	ПровайдерМетрик.ПолучитьМетр("тест").СоздатьСчетчик("запросы").Добавить(1);
	ПровайдерМетрик.СброситьБуфер();
	ПровайдерМетрик.Закрыть();

	// Тогда
	Ожидаем.Что(ПровайдерЭкспортера.ПолученныеСвойства.ПолучитьСтроку("адрес")).Равно("x");
	Ожидаем.Что(ПровайдерПродюсера.ПолученныеСвойства.ПолучитьСтроку("источник")).Равно("jmx");
	Ожидаем.Что(Продюсер.КоличествоВызовов > 0).ЭтоИстина();
	Ожидаем.Что(Транспорт.ПолучитьОтправленные().Количество() > 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура PullЧитательИзПровайдера() Экспорт

	// Дано - pull-читатель: читатель создает провайдер по имени pull-экспортера, продюсеры и лимиты
	// мощности секции pull фабрика задает созданному читателю
	ПодключитьТестовыеКлассы();
	Читатель = Новый ОтелПрометеусЧитательМетрик();
	ПровайдерЧитателя = НовыйПровайдер(Читатель);
	ОтелКонфигурационнаяФабрика.ЗарегистрироватьПровайдерКомпонента(
		ПровайдерЧитателя, ОтелТипКомпонентаКонфигурации.ЧитательМетрикPull(), "pull_из_провайдера");
	Продюсер = Новый ТестовыйПродюсерМетрик();
	ОтелКонфигурационнаяФабрика.ЗарегистрироватьПровайдерКомпонента(
		НовыйПровайдер(Продюсер), ОтелТипКомпонентаКонфигурации.ПродюсерМетрик(), "продюсер_pull_читателя");
	КонфигЧитателя = Новый ОтелКонфигурацияPullЧитателя();
	КонфигЧитателя.Экспортер = КомпонентСоСвойством("pull_из_провайдера", "порт", 9464);
	КонфигЧитателя.Продюсеры.Добавить(КомпонентСоСвойством("продюсер_pull_читателя", "источник", "jmx"));
	КонфигЧитателя.ЛимитыМощности = Новый ОтелКонфигурацияЛимитовМощности();
	КонфигЧитателя.ЛимитыМощности.ПоУмолчанию = 7;
	КонфигЧитателя.ЛимитыМощности.Счетчик = 5;
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераМетрик();
	КонфигПровайдера.Читатели.Добавить(КонфигЧитателя);

	// Когда
	ПровайдерМетрик = ОтелКонфигурационнаяФабрика.СоздатьПровайдерМетрик(Новый ОтелРесурс(), КонфигПровайдера);
	Читатели = ПровайдерМетрик.ЧитателиМетрик();
	Читатель.СобратьВТексте();
	ПровайдерМетрик.Закрыть();

	// Тогда
	Ожидаем.Что(ПровайдерЧитателя.ПолученныеСвойства.ПолучитьЦелое("порт")).Равно(9464);
	Ожидаем.Что(Читатели).ИмеетДлину(1);
	Ожидаем.Что(Читатели[0]).Равно(Читатель);
	Ожидаем.Что(Читатель.ЛимитМощностиДляВида("Counter")).Равно(5);
	Ожидаем.Что(Читатель.ЛимитМощностиДляВида("Histogram")).Равно(7);
	Ожидаем.Что(Продюсер.КоличествоВызовов > 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура PullЧитательБезПровайдераОшибка() Экспорт

	// Дано
	КонфигЧитателя = Новый ОтелКонфигурацияPullЧитателя();
	КонфигЧитателя.Экспортер = КомпонентСоСвойством("pull_без_провайдера", "порт", 9464);
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераМетрик();
	КонфигПровайдера.Читатели.Добавить(КонфигЧитателя);

	// Когда
	ТекстОшибки = "";
	Попытка
		ОтелКонфигурационнаяФабрика.СоздатьПровайдерМетрик(Новый ОтелРесурс(), КонфигПровайдера).Закрыть();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("Pull-экспортер метрик ""pull_без_провайдера"" не поддерживается");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("провайдера")
&ИсточникЗначение("корневой")
Процедура СэмплерИзПровайдера(Место) Экспорт

	// Дано
	ПодключитьТестовыеКлассы();
	Сэмплер = ОтелСэмплер.ВсегдаВыключен();
	Имя = "сэмплер_из_провайдера_" + Место;
	ОтелКонфигурационнаяФабрика.ЗарегистрироватьПровайдерКомпонента(
		НовыйПровайдер(Сэмплер), ОтелТипКомпонентаКонфигурации.Сэмплер(), Имя);
	КонфигПровайдера = ПровайдерТрассировкиСПроцессором();
	Если Место = "провайдера" Тогда
		КонфигПровайдера.Сэмплер = КомпонентКонфигурации(Имя);
	Иначе
		КонфигПровайдера.Сэмплер = Новый ОтелКонфигурацияСэмплера();
		КонфигПровайдера.Сэмплер.Тип = "parent_based";
		КонфигПровайдера.Сэмплер.Корневой = КомпонентКонфигурации(Имя);
	КонецЕсли;

	// Когда
	ПровайдерТрассировки = ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(
		Новый ОтелРесурс(), КонфигПровайдера);
	Спан = ПровайдерТрассировки.ПолучитьТрассировщик("тест").НачатьСпан("корневой");
	ПровайдерТрассировки.Закрыть();

	// Тогда - корневой спан не записывается сэмплером always_off из провайдера
	Ожидаем.Что(Спан.ЗаписьАктивна()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ГенераторИдИзПровайдера() Экспорт

	// Дано
	ПодключитьТестовыеКлассы();
	ОтелКонфигурационнаяФабрика.ЗарегистрироватьПровайдерКомпонента(
		НовыйПровайдер(Новый ТестовыйГенераторИд()), ОтелТипКомпонентаКонфигурации.ГенераторИд(),
		"генератор_из_провайдера");
	КонфигПровайдера = ПровайдерТрассировкиСПроцессором();
	КонфигПровайдера.ГенераторИд = КомпонентКонфигурации("генератор_из_провайдера");

	// Когда
	ПровайдерТрассировки = ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(
		Новый ОтелРесурс(), КонфигПровайдера);
	ИдТрассировки = ПровайдерТрассировки.СгенерироватьИдТрассировки();
	ПровайдерТрассировки.Закрыть();

	// Тогда
	Ожидаем.Что(ИдТрассировки).Равно("0af7651916cd43dd8448eb211c80319c");

КонецПроцедуры

&Тест
Процедура ПропагаторыИзПровайдеров() Экспорт

	// Дано - пропагатор из списка composite со свойствами и пропагатор из строки composite_list
	ПодключитьТестовыеКлассы();
	ПровайдерСоставного = НовыйПровайдер(Новый ТестовыйПропагатор("поле-составного"));
	ОтелКонфигурационнаяФабрика.ЗарегистрироватьПровайдерКомпонента(
		ПровайдерСоставного, ОтелТипКомпонентаКонфигурации.Пропагатор(), "пропагатор_составного");
	ПровайдерСписка = НовыйПровайдер(Новый ТестовыйПропагатор("поле-списка"));
	ОтелКонфигурационнаяФабрика.ЗарегистрироватьПровайдерКомпонента(
		ПровайдерСписка, ОтелТипКомпонентаКонфигурации.Пропагатор(), "пропагатор_списка");
	КонфигПропагатора = Новый ОтелКонфигурацияПропагатора();
	КонфигПропагатора.Составной.Добавить(КомпонентСоСвойством("пропагатор_составного", "формат", "a"));
	КонфигПропагатора.СписокСоставного = "tracecontext, пропагатор_списка";

	// Когда
	Пропагаторы = ОтелКонфигурационнаяФабрика.СоздатьПропагаторы(КонфигПропагатора);

	// Тогда
	Поля = Пропагаторы.Поля();
	Ожидаем.Что(Поля).Содержит("поле-составного");
	Ожидаем.Что(Поля).Содержит("поле-списка");
	Ожидаем.Что(Поля).Содержит("traceparent");
	Ожидаем.Что(ПровайдерСоставного.ПолученныеСвойства.ПолучитьСтроку("формат")).Равно("a");
	Ожидаем.Что(ПровайдерСписка.ПолученныеСвойства.Ключи()).ИмеетДлину(0);

КонецПроцедуры

// Configuration SDK, Create: ошибка Create Component провайдера передается из Create
&Тест
Процедура ОшибкаПровайдераПередаетсяИзСоздать() Экспорт

	// Дано
	ПодключитьТестовыеКлассы();
	ОтелКонфигурационнаяФабрика.ЗарегистрироватьПровайдерКомпонента(
		НовыйПровайдер(Неопределено, "Не задано обязательное свойство адрес"),
		ОтелТипКомпонентаКонфигурации.ЭкспортерСпанов(), "экспортер_с_ошибкой");
	КонфигПроцессора = Новый ОтелКонфигурацияПростогоПроцессора();
	КонфигПроцессора.Экспортер = КомпонентКонфигурации("экспортер_с_ошибкой");

	// Когда
	ТекстОшибки = "";
	Попытка
		ПровайдерСПроцессором("traces", КонфигПроцессора).Закрыть();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("Не задано обязательное свойство адрес");

КонецПроцедуры

// Компонент файла конфигурации: свойства из YAML доходят до провайдера со своими типами
&Тест
Процедура СвойстваИзФайлаДоходятДоПровайдера() Экспорт

	// Дано
	ПодключитьТестовыеКлассы();
	Транспорт = Новый ОтелВПамятьТранспорт();
	Провайдер = НовыйПровайдер(Новый ОтелЭкспортерСпанов(Транспорт));
	ОтелКонфигурационнаяФабрика.ЗарегистрироватьПровайдерКомпонента(
		Провайдер, ОтелТипКомпонентаКонфигурации.ЭкспортерСпанов(), "my_file_exporter");
	ТекстYaml =
	"file_format: ""1.0""
	|tracer_provider:
	|  processors:
	|    - simple:
	|        exporter:
	|          my_file_exporter:
	|            endpoint: http://collector
	|            port: 4318
	|            enabled: true
	|            tags: [a, b]
	|            nested:
	|              key: value
	|            empty:
	|";
	ПутьКФайлу = ПолучитьИмяВременногоФайла("yaml");
	Запись = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	Запись.Записать(ТекстYaml);
	Запись.Закрыть();

	// Когда
	Модель = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);
	УдалитьФайлы(ПутьКФайлу);
	Сдк = ОтелКонфигурационнаяФабрика.Создать(Модель);
	Сдк.Закрыть();

	// Тогда
	Свойства = Провайдер.ПолученныеСвойства;
	Ожидаем.Что(Свойства.ПолучитьСтроку("endpoint")).Равно("http://collector");
	Ожидаем.Что(Свойства.ПолучитьЦелое("port")).Равно(4318);
	Ожидаем.Что(Свойства.ПолучитьБулево("enabled")).Равно(Истина);
	Ожидаем.Что(Свойства.ПолучитьМассивСтрок("tags")).ИмеетДлину(2);
	Ожидаем.Что(Свойства.ПолучитьСвойства("nested").ПолучитьСтроку("key")).Равно("value");
	Ожидаем.Что(Свойства.ЭтоNull("empty")).ЭтоИстина();

КонецПроцедуры

// ===== Вспомогательные =====

Процедура ПодключитьТестовыеКлассы()
	Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures");
	ПодключитьСценарий(ОбъединитьПути(Каталог, "ТестовыйПровайдерКомпонента.os"), "ТестовыйПровайдерКомпонента");
	ПодключитьСценарий(ОбъединитьПути(Каталог, "ТестовыйГенераторИд.os"), "ТестовыйГенераторИд");
	ПодключитьСценарий(ОбъединитьПути(Каталог, "ТестовыйПропагатор.os"), "ТестовыйПропагатор");
	ПодключитьСценарий(ОбъединитьПути(Каталог, "ТестовыйПродюсерМетрик.os"), "ТестовыйПродюсерМетрик");
КонецПроцедуры

Функция НовыйПровайдер(Компонент, ТекстОшибки = "")
	Возврат Новый ТестовыйПровайдерКомпонента(Компонент, ТекстОшибки);
КонецФункции

Функция КомпонентКонфигурации(Имя)
	Компонент = Новый ОтелКонфигурацияКомпонента();
	Компонент.Имя = Имя;
	Возврат Компонент;
КонецФункции

Функция КомпонентСоСвойством(Имя, ИмяСвойства, Значение)
	Компонент = КомпонентКонфигурации(Имя);
	Компонент.Свойства = Новый Соответствие;
	Компонент.Свойства.Вставить(ИмяСвойства, Значение);
	Возврат Компонент;
КонецФункции

Функция ПровайдерТрассировкиСПроцессором()
	КонфигПроцессора = Новый ОтелКонфигурацияПростогоПроцессора();
	КонфигПроцессора.Экспортер = Новый ОтелКонфигурацияКонсольногоЭкспортера();
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераТрассировки();
	КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора);
	Возврат КонфигПровайдера;
КонецФункции

// Создает провайдер трассировки (traces) или логирования (logs) с одним процессором.
Функция ПровайдерСПроцессором(Сигнал, КонфигПроцессора)
	Ресурс = Новый ОтелРесурс();
	Если Сигнал = "traces" Тогда
		КонфигПровайдера = Новый ОтелКонфигурацияПровайдераТрассировки();
		КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора);
		Возврат ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(Ресурс, КонфигПровайдера);
	КонецЕсли;
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераЛогирования();
	КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора);
	Возврат ОтелКонфигурационнаяФабрика.СоздатьПровайдерЛогирования(Ресурс, КонфигПровайдера);
КонецФункции

// Записывает один спан (traces) или одну запись лога (logs).
Процедура ЗаписатьТелеметрию(ПровайдерСигнала, Сигнал)
	Если Сигнал = "traces" Тогда
		ПровайдерСигнала.ПолучитьТрассировщик("тест").НачатьСпан("операция").Завершить();
	Иначе
		Логгер = ПровайдерСигнала.ПолучитьЛоггер("тест");
		Логгер.Записать(Логгер.СоздатьЗаписьЛога());
	КонецЕсли;
КонецПроцедуры
