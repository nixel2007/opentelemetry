// Fixture: провайдер компонента файла конфигурации (PluginComponentProvider) для тестов фабрики.
// СоздатьКомпонент запоминает полученные свойства и возвращает компонент из конструктора; с текстом
// ошибки в конструкторе выбрасывает исключение, как провайдер, которому не подошли свойства.
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:ExportVariables-off

Перем Компонент;
Перем ТекстОшибки;
Перем ПолученныеСвойства Экспорт;
Перем КоличествоВызовов Экспорт;

Функция СоздатьКомпонент(Свойства) Экспорт
	ПолученныеСвойства = Свойства;
	КоличествоВызовов = КоличествоВызовов + 1;
	Если ТекстОшибки <> "" Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	Возврат Компонент;
КонецФункции

Процедура ПриСозданииОбъекта(НовыйКомпонент, НовыйТекстОшибки = "")
	Компонент = НовыйКомпонент;
	ТекстОшибки = НовыйТекстОшибки;
	КоличествоВызовов = 0;
КонецПроцедуры
