// Fixture: пропагатор для тестов фабрики: имя из конструктора возвращается полем пропагатора.
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:UnusedParameters-off

Перем ИмяПоля;

Процедура Внедрить(Контекст, Носитель, Сеттер = Неопределено) Экспорт
	// контекст не внедряется
КонецПроцедуры

Функция Извлечь(Контекст, Носитель, Геттер = Неопределено) Экспорт
	Возврат Контекст;
КонецФункции

Функция Поля() Экспорт
	Результат = Новый Массив;
	Результат.Добавить(ИмяПоля);
	Возврат Результат;
КонецФункции

Процедура ПриСозданииОбъекта(НовоеИмяПоля)
	ИмяПоля = НовоеИмяПоля;
КонецПроцедуры
