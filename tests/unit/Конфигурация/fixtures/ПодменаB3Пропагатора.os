// Fixture: подмена класса ОтелB3Пропагатор из пакета opentelemetry-propagator-b3 для тестов
// конфигурации. Подключается под именем ОтелB3Пропагатор через ПодключитьСценарий; формат из
// конструктора ("single" или "multi") возвращается в имени поля.
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:UnusedParameters-off

Перем ФорматB3;

Процедура Внедрить(Контекст, Носитель, Сеттер = Неопределено) Экспорт
	// контекст не внедряется
КонецПроцедуры

Функция Извлечь(Контекст, Носитель, Геттер = Неопределено) Экспорт
	Возврат Контекст;
КонецФункции

Функция Поля() Экспорт
	Результат = Новый Массив;
	Результат.Добавить("b3-" + ФорматB3);
	Возврат Результат;
КонецФункции

Процедура ПриСозданииОбъекта(Формат = Неопределено)
	ФорматB3 = Формат;
КонецПроцедуры
