Процедура ЛимитыСпанаПоУмолчанию() Экспорт

	// Дано
	СтрокиYaml = МассивСтрок(
		"file_format: ""1.0""",
		"tracer_provider:",
		"  processors:",
		"    - batch:",
		"        exporter:",
		"          otlp_http:",
		"  limits: {}"
	);
