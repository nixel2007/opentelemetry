// ПроверитьМодель проверяет модель по той же схеме, что и Разобрать файл: модель, разобранная из файла со
// всеми свойствами, которые читает SDK, проходит проверку - перевод модели в данные схемы ничего не теряет
// и не искажает

&Тест
Процедура МодельИзФайлаПроходитПроверкуСхемы() Экспорт

	// Дано - все свойства модели, в том числе компоненты, которых нет в SDK
	ТекстYaml =
	"file_format: ""1.0""
	|disabled: false
	|resource:
	|  schema_url: https://opentelemetry.io/schemas/1.26.0
	|  attributes_list: env=prod
	|  attributes:
	|    - name: service.name
	|      value: svc
	|    - name: port
	|      value: 8080
	|      type: int
	|    - name: ratio
	|      value: 0.5
	|      type: double
	|    - name: enabled
	|      value: true
	|      type: bool
	|    - name: tags
	|      value: [a, b]
	|      type: string_array
	|    - name: removed
	|      value:
	|attribute_limits:
	|  attribute_value_length_limit: 100
	|  attribute_value_depth_limit: 5
	|  attribute_count_limit: 50
	|propagator:
	|  composite:
	|    - tracecontext:
	|    - xray:
	|  composite_list: baggage
	|tracer_provider:
	|  processors:
	|    - batch:
	|        schedule_delay: 100
	|        export_timeout: 200
	|        max_queue_size: 10
	|        max_export_batch_size: 5
	|        exporter:
	|          otlp_http:
	|            endpoint: http://localhost:1/v1/traces
	|            compression: gzip
	|            timeout: 1000
	|            headers:
	|              - name: x-a
	|                value: a
	|            headers_list: x-b=b
	|            max_request_size: 1000
	|            max_response_size: 2000
	|    - simple:
	|        exporter:
	|          otlp_grpc:
	|            endpoint: http://localhost:1
	|            max_request_size: 0
	|            max_response_size: 4194304
	|    - my_processor:
	|  limits:
	|    attribute_value_length_limit: 10
	|    attribute_value_depth_limit: 5
	|    attribute_count_limit: 10
	|    event_count_limit: 10
	|    link_count_limit: 10
	|    event_attribute_count_limit: 10
	|    link_attribute_count_limit: 10
	|  sampler:
	|    parent_based:
	|      root:
	|        trace_id_ratio_based:
	|          ratio: 0.5
	|      remote_parent_sampled:
	|        always_on:
	|      remote_parent_not_sampled:
	|        always_off:
	|      local_parent_sampled:
	|        always_record:
	|          root:
	|            my_sampler:
	|              rate: 5
	|      local_parent_not_sampled:
	|        always_off:
	|  id_generator:
	|    random:
	|meter_provider:
	|  readers:
	|    - periodic:
	|        interval: 1000
	|        timeout: 500
	|        exporter:
	|          otlp_grpc:
	|            temporality_preference: delta
	|            default_histogram_aggregation: base2_exponential_bucket_histogram
	|        producers:
	|          - opencensus:
	|        cardinality_limits:
	|          default: 100
	|          counter: 1
	|          up_down_counter: 2
	|          histogram: 3
	|          gauge: 4
	|          observable_counter: 5
	|          observable_up_down_counter: 6
	|          observable_gauge: 7
	|    - pull:
	|        exporter:
	|          my_pull_exporter:
	|  exemplar_filter: always_on
	|logger_provider:
	|  processors:
	|    - batch:
	|        exporter:
	|          console:
	|  limits:
	|    attribute_value_length_limit: 10
	|    attribute_value_depth_limit: 5
	|    attribute_count_limit: 10";
	ПутьКФайлу = СоздатьТестовыйФайл("full_model.yaml", ТекстYaml);
	Конфигурация = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);

	// Когда
	ТекстОшибки = "";
	Попытка
		ОтелФайловаяКонфигурация.ПроверитьМодель(Конфигурация);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Тогда
	Ожидаем.Что(ТекстОшибки).Равно("");

КонецПроцедуры

&Тест
Процедура ПроверитьМодельСообщаетНарушенияСхемы() Экспорт

	// Дано - модель, собранная в коде, со значениями вне границ схемы
	КонфигПроцессора = Новый ОтелКонфигурацияПакетногоПроцессора();
	КонфигПроцессора.Экспортер = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигПроцессора.ЗадержкаОтправки = -1;
	КонфигПроцессора.МаксРазмерПакета = 0;
	Модель = Новый ОтелКонфигурация();
	Модель.ФорматФайла = "1.0";
	Модель.ПровайдерЛогирования = Новый ОтелКонфигурацияПровайдераЛогирования();
	Модель.ПровайдерЛогирования.Процессоры.Добавить(КонфигПроцессора);

	// Когда
	ТекстОшибки = "";
	Попытка
		ОтелФайловаяКонфигурация.ПроверитьМодель(Модель);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Тогда - все нарушения с путями свойств схемы
	Ожидаем.Что(ТекстОшибки).Содержит("Модель конфигурации не соответствует схеме opentelemetry-configuration 1.2:");
	Ожидаем.Что(ТекстОшибки).Содержит(
		"/logger_provider/processors/0/batch/schedule_delay: Значение -1 меньше минимума 0");
	Ожидаем.Что(ТекстОшибки).Содержит(
		"/logger_provider/processors/0/batch/max_export_batch_size: Значение 0 не больше строгого минимума 0");

КонецПроцедуры

// ------------------------------------------------------------------
// Служебные
// ------------------------------------------------------------------

Функция МассивСтрок(Знач Стр1, Знач Стр2 = "_!ПУСТО!_", Знач Стр3 = "_!ПУСТО!_",
	Знач Стр4 = "_!ПУСТО!_", Знач Стр5 = "_!ПУСТО!_", Знач Стр6 = "_!ПУСТО!_",
	Знач Стр7 = "_!ПУСТО!_", Знач Стр8 = "_!ПУСТО!_", Знач Стр9 = "_!ПУСТО!_",
	Знач Стр10 = "_!ПУСТО!_", Знач Стр11 = "_!ПУСТО!_", Знач Стр12 = "_!ПУСТО!_",
	Знач Стр13 = "_!ПУСТО!_", Знач Стр14 = "_!ПУСТО!_", Знач Стр15 = "_!ПУСТО!_",
	Знач Стр16 = "_!ПУСТО!_", Знач Стр17 = "_!ПУСТО!_", Знач Стр18 = "_!ПУСТО!_",
	Знач Стр19 = "_!ПУСТО!_", Знач Стр20 = "_!ПУСТО!_", Знач Стр21 = "_!ПУСТО!_",
	Знач Стр22 = "_!ПУСТО!_", Знач Стр23 = "_!ПУСТО!_", Знач Стр24 = "_!ПУСТО!_",
	Знач Стр25 = "_!ПУСТО!_", Знач Стр26 = "_!ПУСТО!_", Знач Стр27 = "_!ПУСТО!_",
	Знач Стр28 = "_!ПУСТО!_", Знач Стр29 = "_!ПУСТО!_", Знач Стр30 = "_!ПУСТО!_",
	Знач Стр31 = "_!ПУСТО!_", Знач Стр32 = "_!ПУСТО!_", Знач Стр33 = "_!ПУСТО!_",
	Знач Стр34 = "_!ПУСТО!_", Знач Стр35 = "_!ПУСТО!_")

	Результат = Новый Массив;
	ВсеСтроки = Новый Массив;
	ВсеСтроки.Добавить(Стр1);
	ВсеСтроки.Добавить(Стр2);
	ВсеСтроки.Добавить(Стр3);
	ВсеСтроки.Добавить(Стр4);
	ВсеСтроки.Добавить(Стр5);
	ВсеСтроки.Добавить(Стр6);
	ВсеСтроки.Добавить(Стр7);
	ВсеСтроки.Добавить(Стр8);
	ВсеСтроки.Добавить(Стр9);
	ВсеСтроки.Добавить(Стр10);
	ВсеСтроки.Добавить(Стр11);
	ВсеСтроки.Добавить(Стр12);
	ВсеСтроки.Добавить(Стр13);
	ВсеСтроки.Добавить(Стр14);
	ВсеСтроки.Добавить(Стр15);
	ВсеСтроки.Добавить(Стр16);
	ВсеСтроки.Добавить(Стр17);
	ВсеСтроки.Добавить(Стр18);
	ВсеСтроки.Добавить(Стр19);
	ВсеСтроки.Добавить(Стр20);
	ВсеСтроки.Добавить(Стр21);
	ВсеСтроки.Добавить(Стр22);
	ВсеСтроки.Добавить(Стр23);
	ВсеСтроки.Добавить(Стр24);
	ВсеСтроки.Добавить(Стр25);
	ВсеСтроки.Добавить(Стр26);
	ВсеСтроки.Добавить(Стр27);
	ВсеСтроки.Добавить(Стр28);
	ВсеСтроки.Добавить(Стр29);
	ВсеСтроки.Добавить(Стр30);
	ВсеСтроки.Добавить(Стр31);
	ВсеСтроки.Добавить(Стр32);
	ВсеСтроки.Добавить(Стр33);
	ВсеСтроки.Добавить(Стр34);
	ВсеСтроки.Добавить(Стр35);

	Для Каждого Стр Из ВсеСтроки Цикл
		Если Стр = "_!ПУСТО!_" Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(Стр);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СоздатьТестовыйФайл(Знач ИмяФайла, Знач Содержимое)

	ПутьКФайлу = КаталогТестовыхДанных + "/" + ИмяФайла;
	Запись = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	Запись.Записать(Содержимое);
	Запись.Закрыть();
	Возврат ПутьКФайлу;

КонецФункции

Процедура ПроверитьКомпонент(Знач Компонент, Знач Имя)
	Ожидаем.Что(Компонент, Имя).ИмеетТип("ОтелКонфигурацияКомпонента");
	Ожидаем.Что(Компонент.Имя).Равно(Имя);
КонецПроцедуры

Функция ОшибкаРазбора(Знач ИмяФайла, Знач СтрокиYaml)

	ПутьКФайлу = СоздатьТестовыйФайл(ИмяФайла, СтрСоединить(СтрокиYaml, Символы.ПС));
	Попытка
		ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция СоздатьТестовыйАппендер()
	Текст = "Перем События Экспорт;
	|Процедура ВывестиСобытие(Событие) Экспорт
	|    События.Добавить(Событие);
	|КонецПроцедуры
	|Процедура Закрыть() Экспорт
	|КонецПроцедуры
	|Процедура УстановитьСвойство(Имя, Значение) Экспорт
	|КонецПроцедуры
	|События = Новый Массив();";
	Возврат ЗагрузитьСценарийИзСтроки(Текст);
КонецФункции

Функция ЕстьСообщениеСТекстом(Аппендер, Текст)
	Для Каждого Событие Из Аппендер.События Цикл
		Если СтрНайти(Событие.ПолучитьСообщение(), Текст) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&ТестовыйНабор
Процедура ПриСозданииОбъекта()

	КаталогТестовыхДанных = ОбъединитьПути(КаталогВременныхФайлов(), "otel_file_config_tests");
	СоздатьКаталог(КаталогТестовыхДанных);

КонецПроцедуры
