// Экспортер otlp_grpc - встроенный экспортер схемы: OTLP по gRPC

&Тест
Процедура РазборЭкспортераOtlpGrpc() Экспорт

	// Дано
	СтрокиYaml = МассивСтрок(
		"file_format: ""1.0""",
		"tracer_provider:",
		"  processors:",
		"    - batch:",
		"        exporter:",
		"          otlp_grpc:",
		"            endpoint: http://collector:4317",
		"            compression: gzip",
		"            timeout: 5000",
		"            headers:",
		"              - name: api-key",
		"                value: secret",
		"            headers_list: tenant=dev",
		"            max_request_size: 0",
		"            max_response_size: 1024",
		"meter_provider:",
		"  readers:",
		"    - periodic:",
		"        exporter:",
		"          otlp_grpc:",
		"            temporality_preference: delta",
		"            default_histogram_aggregation: base2_exponential_bucket_histogram"
	);
	ПутьКФайлу = СоздатьТестовыйФайл("otlp_grpc.yaml", СтрСоединить(СтрокиYaml, Символы.ПС));

	// Когда
	Конфигурация = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);

	// Тогда
	Экспортер = Конфигурация.ПровайдерТрассировки.Процессоры[0].Экспортер;
	Ожидаем.Что(Экспортер).ИмеетТип("ОтелКонфигурацияЭкспортераOtlpGrpc");
	Ожидаем.Что(Экспортер.Адрес).Равно("http://collector:4317");
	Ожидаем.Что(Экспортер.Сжатие).Равно("gzip");
	Ожидаем.Что(Экспортер.Таймаут).Равно(5000);
	Ожидаем.Что(Экспортер.Заголовки.Количество()).Равно(1);
	Ожидаем.Что(Экспортер.Заголовки[0].Имя).Равно("api-key");
	Ожидаем.Что(Экспортер.Заголовки[0].Значение).Равно("secret");
	Ожидаем.Что(Экспортер.СписокЗаголовков).Равно("tenant=dev");
	Ожидаем.Что(Экспортер.МаксРазмерЗапроса).Равно(0);
	Ожидаем.Что(Экспортер.МаксРазмерОтвета).Равно(1024);

	ЭкспортерМетрик = Конфигурация.ПровайдерМетрик.Читатели[0].Экспортер;
	Ожидаем.Что(ЭкспортерМетрик).ИмеетТип("ОтелКонфигурацияЭкспортераOtlpGrpc");
	Ожидаем.Что(ЭкспортерМетрик.Адрес).Равно("");
	Ожидаем.Что(ЭкспортерМетрик.Таймаут).Равно(10000);
	Ожидаем.Что(ЭкспортерМетрик.МаксРазмерЗапроса).Равно(67108864);
	Ожидаем.Что(ЭкспортерМетрик.МаксРазмерОтвета).Равно(4194304);
	Ожидаем.Что(ЭкспортерМетрик.ПредпочтениеВременнойАгрегации).Равно("delta");
	Ожидаем.Что(ЭкспортерМетрик.АгрегацияГистограммПоУмолчанию).Равно("base2_exponential_bucket_histogram");

КонецПроцедуры

