	ПутьКФайлу = СоздатьТестовыйФайл("meter_defaults.yaml", Yaml);

	// Когда
	Конфигурация = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);

	// Тогда
	Провайдер = Конфигурация.ПровайдерМетрик;
	Ожидаем.Что(Провайдер.ФильтрЭкземпляров).Равно("trace_based");

	Читатель = Провайдер.Читатели[0];
	Ожидаем.Что(Читатель.Интервал).Равно(60000);
	Ожидаем.Что(Читатель.Таймаут).Равно(30000);

КонецПроцедуры

// ------------------------------------------------------------------
