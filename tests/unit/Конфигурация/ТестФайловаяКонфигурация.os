// ------------------------------------------------------------------

&Тест
Процедура РазборПровайдераЛогирования() Экспорт

	// Дано
	СтрокиYaml = МассивСтрок(
		"file_format: ""1.0""",
		"logger_provider:",
		"  processors:",
		"    - batch:",
		"        schedule_delay: 2000",
		"        exporter:",
		"          otlp_http:",
		"            endpoint: http://collector:4318/v1/logs",
		"  limits:",
		"    attribute_count_limit: 64",
		"    attribute_value_length_limit: 1024"
	);
	Yaml = СтрСоединить(СтрокиYaml, Символы.ПС);
	ПутьКФайлу = СоздатьТестовыйФайл("logger_provider.yaml", Yaml);

	// Когда
	Конфигурация = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);

	// Тогда
	Провайдер = Конфигурация.ПровайдерЛогирования;
	Ожидаем.Что(Провайдер).ИмеетТип("ОтелКонфигурацияПровайдераЛогирования");
	Ожидаем.Что(Провайдер.Процессоры.Количество()).Равно(1);

	Процессор = Провайдер.Процессоры[0];
	Ожидаем.Что(Процессор.ЗадержкаОтправки).Равно(2000);
	Ожидаем.Что(Процессор.Экспортер.Адрес).Равно("http://collector:4318/v1/logs");

	Лимиты = Провайдер.Лимиты;
	Ожидаем.Что(Лимиты).ИмеетТип("ОтелКонфигурацияЛимитовАтрибутов");
	Ожидаем.Что(Лимиты.МаксКоличествоАтрибутов).Равно(64);
	Ожидаем.Что(Лимиты.МаксДлинаЗначенияАтрибута).Равно(1024);

КонецПроцедуры

