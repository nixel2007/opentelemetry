		"  processors:",
		"    - batch:",
		"        max_queue_size: 0",
		"        exporter:",
		"          otlp_http:"
	);

	// Когда
	ТекстОшибки = ОшибкаРазбора("schema_exclusive_minimum.yaml", СтрокиYaml);

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("/logger_provider/processors/0/batch/max_queue_size");

КонецПроцедуры

