		Ожидаем.Что(Ложь).Равно(Истина);
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("file_format");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ОшибкаНеподдерживаемаяВерсия() Экспорт

	// Дано
	ПутьКФайлу = СоздатьТестовыйФайл("bad_version.yaml", "file_format: ""2.0""");

	// Тогда
	Попытка
		ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);
		Ожидаем.Что(Ложь).Равно(Истина);
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("2.0");
	КонецПопытки;

КонецПроцедуры

// Схема файла конфигурации: file_format - строка. YAML читает 1.0 без кавычек как число, и
// разбор сообщает об этом, а не о неподдерживаемой версии "1"

&Тест
Процедура ОшибкаFileFormatЧислом() Экспорт

	// Дано
	ПутьКФайлу = СоздатьТестовыйФайл("numeric_format.yaml", "file_format: 1.0");

	// Тогда
	Попытка
		ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);
		Ожидаем.Что(Ложь).Равно(Истина);
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("file_format должен быть строкой");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ОшибкаВерсияФорматаДругойОсновнойВерсии() Экспорт

	// Дано - VERSIONING: другая основная версия file_format - ошибка
	ПутьКФайлу = СоздатьТестовыйФайл("major_0.yaml", "file_format: ""0.4""");

	// Когда
	ТекстОшибки = "";
	Попытка
		ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("0.4");

КонецПроцедуры

// ------------------------------------------------------------------
// Проверка по схеме opentelemetry-configuration: Configuration SDK / Parse возвращает ошибку,
// если файл не соответствует схеме (типы, обязательные свойства, ограничения)
// ------------------------------------------------------------------

&Тест
Процедура ОшибкаСхемыЗначениеМеньшеМинимума() Экспорт

	// Дано - schedule_delay по схеме не меньше 0
	СтрокиYaml = МассивСтрок(
		"file_format: ""1.0""",
		"tracer_provider:",
		"  processors:",
		"    - batch:",
		"        schedule_delay: -1",
		"        exporter:",
		"          otlp_http:"
	);

	// Когда
	ТекстОшибки = ОшибкаРазбора("schema_minimum.yaml", СтрокиYaml);

	// Тогда - ошибка называет свойство
	Ожидаем.Что(ТекстОшибки).Содержит("/tracer_provider/processors/0/batch/schedule_delay");

КонецПроцедуры

&Тест
Процедура ОшибкаСхемыЗначениеНеБольшеСтрогогоМинимума() Экспорт

	// Дано - max_queue_size по схеме больше 0
