// ------------------------------------------------------------------
// Экспортер OTLP HTTP - заголовки
// ------------------------------------------------------------------

&Тест
Процедура РазборЭкспортераСЗаголовками() Экспорт

	// Дано
	СтрокиYaml = МассивСтрок(
		"file_format: ""1.0""",
		"tracer_provider:",
		"  processors:",
		"    - batch:",
		"        exporter:",
		"          otlp_http:",
		"            endpoint: http://collector:4318/v1/traces",
		"            headers:",
		"              - name: Authorization",
		"                value: ""Bearer token123""",
		"              - name: X-Custom",
		"                value: custom-value",
		"            headers_list: ""extra=val"""
	);
	Yaml = СтрСоединить(СтрокиYaml, Символы.ПС);
	ПутьКФайлу = СоздатьТестовыйФайл("exporter_headers.yaml", Yaml);

	// Когда
	Конфигурация = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);

	// Тогда
	Экспортер = Конфигурация.ПровайдерТрассировки.Процессоры[0].Экспортер;
	Ожидаем.Что(Экспортер.Заголовки.Количество()).Равно(2);
	Ожидаем.Что(Экспортер.Заголовки[0].Имя).Равно("Authorization");
	Ожидаем.Что(Экспортер.Заголовки[0].Значение).Равно("Bearer token123");
	Ожидаем.Что(Экспортер.Заголовки[1].Имя).Равно("X-Custom");
	Ожидаем.Что(Экспортер.Заголовки[1].Значение).Равно("custom-value");
	Ожидаем.Что(Экспортер.СписокЗаголовков).Равно("extra=val");

КонецПроцедуры

// Схема файла конфигурации: заголовок со значением null пропускается

&Тест
Процедура ЗаголовокБезЗначенияПропускается() Экспорт

	// Дано
	СтрокиYaml = МассивСтрок(
		"file_format: ""1.0""",
		"tracer_provider:",
		"  processors:",
		"    - batch:",
		"        exporter:",
		"          otlp_http:",
		"            headers:",
		"              - name: X-Null",
		"                value:",
		"              - name: X-Empty",
		"                value: """"",
		"              - name: X-Set",
		"                value: set"
	);
	ПутьКФайлу = СоздатьТестовыйФайл("exporter_null_header.yaml", СтрСоединить(СтрокиYaml, Символы.ПС));

	// Когда
	Конфигурация = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);

	// Тогда - пустая строка - значение заголовка, null - нет
	Заголовки = Конфигурация.ПровайдерТрассировки.Процессоры[0].Экспортер.Заголовки;
	Ожидаем.Что(Заголовки).ИмеетДлину(2);
	Ожидаем.Что(Заголовки[0].Имя).Равно("X-Empty");
	Ожидаем.Что(Заголовки[0].Значение).Равно("");
	Ожидаем.Что(Заголовки[1].Имя).Равно("X-Set");

КонецПроцедуры

// ------------------------------------------------------------------
