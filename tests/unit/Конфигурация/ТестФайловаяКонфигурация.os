// ------------------------------------------------------------------
// Дополнительные ветки
// ------------------------------------------------------------------

// disabled по схеме - булево: подстановка ${...} без кавычек дает булево значение, пустое значение -
// null (false по умолчанию), другая строка - ошибка разбора

&ПараметризованныйТест
&ИсточникЗначение("true", "Истина")
&ИсточникЗначение("FALSE", "Ложь")
&ИсточникЗначение("", "Ложь")
Процедура РазборОтключенногоИзПеременнойОкружения(ЗначениеПеременной, Ожидаемое) Экспорт

	// Дано
	УстановитьПеременнуюСреды("OTEL_TEST_SDK_DISABLED", ЗначениеПеременной);
	СтрокиYaml = МассивСтрок(
		"file_format: ""1.0""",
		"disabled: ${OTEL_TEST_SDK_DISABLED}"
	);
	ПутьКФайлу = СоздатьТестовыйФайл("disabled_env.yaml", СтрСоединить(СтрокиYaml, Символы.ПС));

	// Когда
	Попытка
		Конфигурация = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);
	Исключение
		УстановитьПеременнуюСреды("OTEL_TEST_SDK_DISABLED", "");
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПеременнуюСреды("OTEL_TEST_SDK_DISABLED", "");

	// Тогда
	Ожидаем.Что(Конфигурация.Отключен).Равно(Ожидаемое = "Истина");

КонецПроцедуры

&Тест
Процедура ОшибкаСхемыОтключенИзПеременнойНеБулево() Экспорт

	// Дано
	УстановитьПеременнуюСреды("OTEL_TEST_SDK_DISABLED", "да");
	СтрокиYaml = МассивСтрок(
		"file_format: ""1.0""",
		"disabled: ${OTEL_TEST_SDK_DISABLED}"
	);

	// Когда
	ТекстОшибки = ОшибкаРазбора("disabled_env_string.yaml", СтрокиYaml);
	УстановитьПеременнуюСреды("OTEL_TEST_SDK_DISABLED", "");

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("/disabled");

КонецПроцедуры

// Простой процессор (simple) - встроенный процессор спанов и записей лога схемы

&ПараметризованныйТест
&ИсточникЗначение("tracer_provider", "traces")
&ИсточникЗначение("logger_provider", "logs")
Процедура РазборПростогоПроцессора(КлючПровайдера, Сигнал) Экспорт

	// Дано
	СтрокиYaml = МассивСтрок(
		"file_format: ""1.0""",
		КлючПровайдера + ":",
		"  processors:",
		"    - simple:",
		"        exporter:",
		"          otlp_http:",
		"            endpoint: http://collector:4318/v1/" + Сигнал
	);
	ПутьКФайлу = СоздатьТестовыйФайл("simple_processor.yaml", СтрСоединить(СтрокиYaml, Символы.ПС));

	// Когда
	Конфигурация = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);

	// Тогда
	Если КлючПровайдера = "tracer_provider" Тогда
		Процессоры = Конфигурация.ПровайдерТрассировки.Процессоры;
	Иначе
		Процессоры = Конфигурация.ПровайдерЛогирования.Процессоры;
	КонецЕсли;
	Ожидаем.Что(Процессоры.Количество()).Равно(1);
	Ожидаем.Что(Процессоры[0]).ИмеетТип("ОтелКонфигурацияПростогоПроцессора");
	Ожидаем.Что(Процессоры[0].Экспортер.Адрес).Равно("http://collector:4318/v1/" + Сигнал);

КонецПроцедуры

// Configuration SDK, Parse: компонент, которого нет в SDK, разбор сохраняет в общем виде - имя и
// свойства как в файле (ОтелКонфигурацияКомпонента); что с ним делать, решает фабрика

&Тест
Процедура РазборНевстроенныхЭкспортеров() Экспорт

	// Дано - console (null), пользовательский экспортер со свойствами, otlp_file/development
	СтрокиYaml = МассивСтрок(
		"file_format: ""1.0""",
		"tracer_provider:",
		"  processors:",
		"    - batch:",
		"        exporter:",
		"          console:",
		"    - simple:",
		"        exporter:",
		"          my_exporter:",
		"            url: http://example",
		"logger_provider:",
		"  processors:",
		"    - simple:",
		"        exporter:",
		"          otlp_file/development:"
	);
	ПутьКФайлу = СоздатьТестовыйФайл("custom_exporters.yaml", СтрСоединить(СтрокиYaml, Символы.ПС));

	// Когда
	Конфигурация = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);

	// Тогда
	Процессоры = Конфигурация.ПровайдерТрассировки.Процессоры;
	ПроверитьКомпонент(Процессоры[0].Экспортер, "console");
	Ожидаем.Что(Процессоры[0].Экспортер.Свойства).Равно(Неопределено);
	ПроверитьКомпонент(Процессоры[1].Экспортер, "my_exporter");
