&Тест
Процедура ОшибкаСхемыПеречисляетВсеНарушения() Экспорт

	// Дано - два нарушения в одном файле
	СтрокиYaml = МассивСтрок(
		"file_format: ""1.0""",
		"resource:",
		"  attributes:",
		"    - value: no-name",
		"tracer_provider:",
		"  processors:",
		"    - batch:",
		"        schedule_delay: -1",
		"        exporter:",
		"          otlp_http:"
	);

	// Когда
	ТекстОшибки = ОшибкаРазбора("schema_many.yaml", СтрокиYaml);

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("/resource/attributes/0");
	Ожидаем.Что(ТекстОшибки).Содержит("/tracer_provider/processors/0/batch/schedule_delay");

КонецПроцедуры

// VERSIONING: file_format с более новой младшей версией разбирается с предупреждением; свойства,
// которых нет в поддерживаемой схеме, пропускаются

&Тест
Процедура НоваяМладшаяВерсияФорматаПредупреждаетОНеописанныхСвойствах() Экспорт

	// Дано
	СтрокиYaml = МассивСтрок(
		"file_format: ""1.99""",
		"tracer_provider:",
		"  processors:",
		"    - batch:",
		"        exporter:",
		"          otlp_http:",
		"            endpoint: http://collector:4318/v1/traces",
		"            future_option: 1"
	);
	ПутьКФайлу = СоздатьТестовыйФайл("newer_minor.yaml", СтрСоединить(СтрокиYaml, Символы.ПС));

	Аппендер = СоздатьТестовыйАппендер();
	Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.file-configuration");
	Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);

	// Когда
	Попытка
		Конфигурация = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);
	Исключение
		Лог.УдалитьСпособВывода(Аппендер);
		Логирование.ЗакрытьЛог(Лог);
		ВызватьИсключение;
	КонецПопытки;
	Лог.УдалитьСпособВывода(Аппендер);
	Логирование.ЗакрытьЛог(Лог);

	// Тогда
	Экспортер = Конфигурация.ПровайдерТрассировки.Процессоры[0].Экспортер;
	Ожидаем.Что(Экспортер.Адрес).Равно("http://collector:4318/v1/traces");
	Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "1.99"), "предупреждение о версии").ЭтоИстина();
	Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "future_option"), "предупреждение о свойстве").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПримерСпецификацииМиграцииСПеременнымиПроходитПроверку() Экспорт

	// Дано - пример otel-sdk-migration-config.yaml: числа и булевы значения задаются подстановкой
	// ${ПЕРЕМЕННАЯ:-значение}, переменные не заданы
	ПутьКФайлу = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "otel-sdk-migration-config.yaml");

	// Когда
	Конфигурация = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);

	// Тогда - значения по умолчанию из подстановки получили типы схемы
	Ожидаем.Что(Конфигурация.Отключен).Равно(Ложь);
	Ожидаем.Что(Конфигурация.ЛимитыАтрибутов.МаксКоличествоАтрибутов).Равно(128);
	Ожидаем.Что(Конфигурация.ПровайдерТрассировки.Процессоры[0].ЗадержкаОтправки).Равно(5000);
	Ожидаем.Что(Конфигурация.ПровайдерМетрик.Читатели[0].Интервал).Равно(60000);
	Ожидаем.Что(Конфигурация.Пропагатор.СписокСоставного).Равно("tracecontext,baggage");

КонецПроцедуры

// ------------------------------------------------------------------
// Ресурс
// ------------------------------------------------------------------

&Тест
Процедура РазборРесурсаСАтрибутами() Экспорт

	// Дано
	СтрокиYaml = МассивСтрок(
		"file_format: ""1.0""",
		"resource:",
		"  attributes:",
		"    - name: service.name",
		"      value: my-service",
		"    - name: service.version",
		"      value: ""1.2.3""",
		"  attributes_list: ""env=prod,zone=us"""
	);
	Yaml = СтрСоединить(СтрокиYaml, Символы.ПС);
	ПутьКФайлу = СоздатьТестовыйФайл("resource.yaml", Yaml);

	// Когда
	Конфигурация = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);

	// Тогда
	Ожидаем.Что(Конфигурация.Ресурс).ИмеетТип("ОтелКонфигурацияРесурса");
	Ожидаем.Что(Конфигурация.Ресурс.Атрибуты.Количество()).Равно(2);
	Ожидаем.Что(Конфигурация.Ресурс.Атрибуты[0].Имя).Равно("service.name");
	Ожидаем.Что(Конфигурация.Ресурс.Атрибуты[0].Значение).Равно("my-service");
	Ожидаем.Что(Конфигурация.Ресурс.Атрибуты[1].Имя).Равно("service.version");
	Ожидаем.Что(Конфигурация.Ресурс.Атрибуты[1].Значение).Равно("1.2.3");
	Ожидаем.Что(Конфигурация.Ресурс.СписокАтрибутов).Равно("env=prod,zone=us");
	Ожидаем.Что(Конфигурация.Ресурс.АдресСхемы).Равно("");

КонецПроцедуры

// Схема файла конфигурации: type атрибута ресурса задает тип значения, без type - string. Разбор сохраняет
// type в поле Тип записи, фабрика проверяет по нему значение

&Тест
Процедура РазборТипаАтрибутаРесурса() Экспорт

	// Дано
	СтрокиYaml = МассивСтрок(
		"file_format: ""1.0""",
		"resource:",
		"  attributes:",
		"    - name: port",
		"      value: 8080",
		"      type: int",
		"    - name: service.name",
		"      value: my-service"
	);
	ПутьКФайлу = СоздатьТестовыйФайл("resource_type.yaml", СтрСоединить(СтрокиYaml, Символы.ПС));

	// Когда
	Конфигурация = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);

	// Тогда
	Атрибуты = Конфигурация.Ресурс.Атрибуты;
	Ожидаем.Что(Атрибуты[0].Тип).Равно("int");
	Ожидаем.Что(Атрибуты[0].Значение).Равно(8080);
	Ожидаем.Что(Атрибуты[1].Свойство("Тип"), "поле Тип без type").ЭтоИстина();
	Ожидаем.Что(Атрибуты[1].Тип).Равно(Неопределено);

КонецПроцедуры

// Схема файла конфигурации: resource.schema_url - URL схемы ресурса

&Тест
Процедура РазборАдресаСхемыРесурса() Экспорт

	// Дано
	СтрокиYaml = МассивСтрок(
		"file_format: ""1.0""",
		"resource:",
		"  schema_url: https://opentelemetry.io/schemas/1.26.0"
	);
	ПутьКФайлу = СоздатьТестовыйФайл("resource_schema_url.yaml", СтрСоединить(СтрокиYaml, Символы.ПС));

	// Когда
	Конфигурация = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);

	// Тогда
	Ожидаем.Что(Конфигурация.Ресурс.АдресСхемы).Равно("https://opentelemetry.io/schemas/1.26.0");

КонецПроцедуры

// ------------------------------------------------------------------
// Лимиты атрибутов
// ------------------------------------------------------------------

&Тест
Процедура РазборЛимитовАтрибутов() Экспорт

	// Дано
	СтрокиYaml = МассивСтрок(
		"file_format: ""1.0""",
		"attribute_limits:",
		"  attribute_count_limit: 64"
	);
	Yaml = СтрСоединить(СтрокиYaml, Символы.ПС);
	ПутьКФайлу = СоздатьТестовыйФайл("attr_limits.yaml", Yaml);

	// Когда
	Конфигурация = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);

	// Тогда
	Ожидаем.Что(Конфигурация.ЛимитыАтрибутов).ИмеетТип("ОтелКонфигурацияЛимитовАтрибутов");
	Ожидаем.Что(Конфигурация.ЛимитыАтрибутов.МаксКоличествоАтрибутов).Равно(64);
	Ожидаем.Что(Конфигурация.ЛимитыАтрибутов.МаксДлинаЗначенияАтрибута).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура РазборЛимитовАтрибутовСДлиной() Экспорт

