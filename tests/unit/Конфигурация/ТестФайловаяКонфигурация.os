// ------------------------------------------------------------------
// MeterProvider
// ------------------------------------------------------------------

&Тест
Процедура РазборПровайдераМетрик() Экспорт

	// Дано
	СтрокиYaml = МассивСтрок(
		"file_format: ""1.0""",
		"meter_provider:",
		"  exemplar_filter: always_on",
		"  readers:",
		"    - periodic:",
		"        interval: 30000",
		"        timeout: 10000",
		"        exporter:",
		"          otlp_http:",
		"            endpoint: http://collector:4318/v1/metrics",
		"            temporality_preference: delta",
		"            default_histogram_aggregation: base2_exponential_bucket_histogram"
	);
	Yaml = СтрСоединить(СтрокиYaml, Символы.ПС);
	ПутьКФайлу = СоздатьТестовыйФайл("meter_provider.yaml", Yaml);

	// Когда
	Конфигурация = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);

	// Тогда
	Провайдер = Конфигурация.ПровайдерМетрик;
	Ожидаем.Что(Провайдер).ИмеетТип("ОтелКонфигурацияПровайдераМетрик");
	Ожидаем.Что(Провайдер.ФильтрЭкземпляров).Равно("always_on");
	Ожидаем.Что(Провайдер.Читатели.Количество()).Равно(1);

	Читатель = Провайдер.Читатели[0];
	Ожидаем.Что(Читатель).ИмеетТип("ОтелКонфигурацияПериодическогоЧитателя");
	Ожидаем.Что(Читатель.Интервал).Равно(30000);
	Ожидаем.Что(Читатель.Таймаут).Равно(10000);
	Ожидаем.Что(Читатель.ЛимитыМощности).Равно(Неопределено);

	Экспортер = Читатель.Экспортер;
	Ожидаем.Что(Экспортер.Адрес).Равно("http://collector:4318/v1/metrics");
	Ожидаем.Что(Экспортер.ПредпочтениеВременнойАгрегации).Равно("delta");
	Ожидаем.Что(Экспортер.АгрегацияГистограммПоУмолчанию).Равно("base2_exponential_bucket_histogram");

КонецПроцедуры

&Тест
Процедура РазборЛимитовМощностиЧитателя() Экспорт

	// Дано
	ТекстYaml =
	"file_format: ""1.0""
	|meter_provider:
	|  readers:
	|    - periodic:
	|        exporter:
	|          otlp_http:
	|        cardinality_limits:
	|          default: 100
	|          counter: 1
	|          up_down_counter: 2
	|          histogram: 3
	|          gauge: 4
	|          observable_counter: 5
	|          observable_up_down_counter: 6
	|          observable_gauge: 7
	|    - periodic:
	|        exporter:
	|          otlp_http:
	|        cardinality_limits:
	|          counter: 8";
	ПутьКФайлу = СоздатьТестовыйФайл("cardinality_limits.yaml", ТекстYaml);

	// Когда
	Конфигурация = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);

	// Тогда
	Лимиты = Конфигурация.ПровайдерМетрик.Читатели[0].ЛимитыМощности;
	Ожидаем.Что(Лимиты).ИмеетТип("ОтелКонфигурацияЛимитовМощности");
	Ожидаем.Что(Лимиты.ПоУмолчанию).Равно(100);
	Ожидаем.Что(Лимиты.Счетчик).Равно(1);
	Ожидаем.Что(Лимиты.РеверсивныйСчетчик).Равно(2);
	Ожидаем.Что(Лимиты.Гистограмма).Равно(3);
	Ожидаем.Что(Лимиты.Датчик).Равно(4);
	Ожидаем.Что(Лимиты.НаблюдаемыйСчетчик).Равно(5);
	Ожидаем.Что(Лимиты.НаблюдаемыйРеверсивныйСчетчик).Равно(6);
	Ожидаем.Что(Лимиты.НаблюдаемыйДатчик).Равно(7);

	// Тогда - без default лимит по умолчанию 2000, вид без лимита не задан
	Лимиты = Конфигурация.ПровайдерМетрик.Читатели[1].ЛимитыМощности;
	Ожидаем.Что(Лимиты.ПоУмолчанию).Равно(2000);
	Ожидаем.Что(Лимиты.Счетчик).Равно(8);
	Ожидаем.Что(Лимиты.Гистограмма).Равно(Неопределено);

КонецПроцедуры

