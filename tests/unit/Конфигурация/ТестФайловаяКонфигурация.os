&Тест
Процедура РазборПропагатораСОбъектнымиЭлементами() Экспорт

	// Дано - элементы composite - объекты с одним ключом, именем пропагатора; у пропагатора, которого
	//   нет в SDK, могут быть свойства
	СтрокиYaml = МассивСтрок(
		"file_format: ""1.0""",
		"propagator:",
		"  composite:",
		"    - tracecontext:",
		"    - baggage:",
		"    - xray:",
		"        mode: strict"
	);
	Yaml = СтрСоединить(СтрокиYaml, Символы.ПС);
	ПутьКФайлу = СоздатьТестовыйФайл("propagator_objects.yaml", Yaml);

	// Когда
	Конфигурация = ОтелФайловаяКонфигурация.Разобрать(ПутьКФайлу);

	// Тогда
	Составной = Конфигурация.Пропагатор.Составной;
	Ожидаем.Что(Составной.Количество()).Равно(3);
	ПроверитьКомпонент(Составной[0], "tracecontext");
	Ожидаем.Что(Составной[0].Свойства).Равно(Неопределено);
	ПроверитьКомпонент(Составной[1], "baggage");
	ПроверитьКомпонент(Составной[2], "xray");
	Ожидаем.Что(Составной[2].Свойства.Получить("mode")).Равно("strict");

КонецПроцедуры

