// ============================================================

&Тест
Процедура СкалярыЧитаютсяСвоимиТипами() Экспорт

	// Дано
	Свойства = Новый ОтелСвойстваКонфигурации(УзелСоСкалярами());

	// Тогда
	Ожидаем.Что(Свойства.ПолучитьСтроку("адрес")).Равно("http://localhost");
	Ожидаем.Что(Свойства.ПолучитьБулево("включен")).Равно(Истина);
	Ожидаем.Что(Свойства.ПолучитьЦелое("порт")).Равно(4318);
	Ожидаем.Что(Свойства.ПолучитьЧисло("доля")).Равно(0.25);
	Ожидаем.Что(Свойства.ПолучитьЧисло("порт")).Равно(4318);

КонецПроцедуры

// Configuration SDK, Create Component: свойство не того типа - ошибка. Геттер выбрасывает
// исключение с именем свойства и ожидаемым типом
&ПараметризованныйТест
&ИсточникЗначение("ПолучитьСтроку|порт|строка")
&ИсточникЗначение("ПолучитьБулево|адрес|булево")
&ИсточникЗначение("ПолучитьЦелое|доля|целое число")
&ИсточникЗначение("ПолучитьЧисло|включен|число")
&ИсточникЗначение("ПолучитьСвойства|адрес|соответствие")
&ИсточникЗначение("ПолучитьМассивСтрок|адрес|последовательность строк")
&ИсточникЗначение("ПолучитьМассивСвойств|адрес|последовательность соответствий")
Процедура ЗначениеДругогоТипаОшибка(Случай) Экспорт

	// Дано - метод|свойство|ожидаемый тип
	Части = СтрРазделить(Случай, "|");
	Свойства = Новый ОтелСвойстваКонфигурации(УзелСоСкалярами());

	// Когда
	ТекстОшибки = ОшибкаЧтения(Свойства, Части[0], Части[1]);

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("""" + Части[1] + """");
	Ожидаем.Что(ТекстОшибки).Содержит(Части[2]);

КонецПроцедуры

&Тест
Процедура ОтсутствующееСвойствоДаетЗначениеПоУмолчанию() Экспорт

	// Дано
	Свойства = Новый ОтелСвойстваКонфигурации(УзелСоСкалярами());

	// Тогда
	Ожидаем.Что(Свойства.ПолучитьСтроку("нет")).Равно(Неопределено);
	Ожидаем.Что(Свойства.ПолучитьСтроку("нет", "умолчание")).Равно("умолчание");
	Ожидаем.Что(Свойства.ПолучитьЦелое("нет", 10)).Равно(10);
	Ожидаем.Что(Свойства.ПолучитьЧисло("нет", 0.5)).Равно(0.5);
	Ожидаем.Что(Свойства.ПолучитьБулево("нет", Истина)).Равно(Истина);
	Ожидаем.Что(Свойства.ПолучитьСвойства("нет")).Равно(Неопределено);
	Ожидаем.Что(Свойства.ПолучитьМассивСтрок("нет")).Равно(Неопределено);

КонецПроцедуры

// Свойство со значением null и отсутствующее свойство различаются: на null геттер возвращает Null,
// значение по умолчанию - только для отсутствующего свойства
&Тест
Процедура NullОтличаетсяОтОтсутствующегоСвойства() Экспорт

	// Дано
	Узел = Новый Соответствие;
	Узел.Вставить("пусто", Неопределено);
	Свойства = Новый ОтелСвойстваКонфигурации(Узел);

	// Тогда
	Ожидаем.Что(Свойства.Содержит("пусто")).ЭтоИстина();
	Ожидаем.Что(Свойства.ЭтоNull("пусто")).ЭтоИстина();
	Ожидаем.Что(Свойства.Содержит("нет")).ЭтоЛожь();
	Ожидаем.Что(Свойства.ЭтоNull("нет")).ЭтоЛожь();
	Ожидаем.Что(Свойства.ПолучитьСтроку("пусто", "умолчание")).Равно(Null);
	Ожидаем.Что(Свойства.ПолучитьЦелое("пусто", 10)).Равно(Null);
	Ожидаем.Что(Свойства.ПолучитьСвойства("пусто")).Равно(Null);
	Ожидаем.Что(Свойства.ПолучитьМассивСтрок("пусто")).Равно(Null);

КонецПроцедуры

&Тест
Процедура КлючиСодержатВсеЗаданныеСвойства() Экспорт

	// Дано
	Узел = Новый Соответствие;
	Узел.Вставить("а", 1);
	Узел.Вставить("б", Неопределено);
	Свойства = Новый ОтелСвойстваКонфигурации(Узел);

	// Когда
	Ключи = Свойства.Ключи();

	// Тогда
	Ожидаем.Что(Ключи).ИмеетДлину(2);
	Ожидаем.Что(Ключи).Содержит("а");
	Ожидаем.Что(Ключи).Содержит("б");

КонецПроцедуры

&Тест
Процедура ВложенноеСоответствиеЧитаетсяКакСвойства() Экспорт

	// Дано
	Вложенный = Новый Соответствие;
	Вложенный.Вставить("имя", "значение");
	Вложенный.Вставить("пусто", Неопределено);
	Узел = Новый Соответствие;
	Узел.Вставить("вложенный", Вложенный);
	Свойства = Новый ОтелСвойстваКонфигурации(Узел);

	// Когда
	ВложенныеСвойства = Свойства.ПолучитьСвойства("вложенный");

	// Тогда
	Ожидаем.Что(ТипЗнч(ВложенныеСвойства)).Равно(Тип("ОтелСвойстваКонфигурации"));
	Ожидаем.Что(ВложенныеСвойства.ПолучитьСтроку("имя")).Равно("значение");
	Ожидаем.Что(ВложенныеСвойства.ЭтоNull("пусто")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура МассивыСкаляровЧитаютсяСвоимиТипами() Экспорт

	// Дано
	Узел = Новый Соответствие;
	Узел.Вставить("строки", МассивИз("а", "б"));
	Узел.Вставить("флаги", МассивИз(Истина, Ложь));
	Узел.Вставить("целые", МассивИз(1, 2));
	Узел.Вставить("числа", МассивИз(1, 2.5));
	Свойства = Новый ОтелСвойстваКонфигурации(Узел);

	// Тогда
	Ожидаем.Что(Свойства.ПолучитьМассивСтрок("строки")).РавноМассиву(МассивИз("а", "б"));
	Ожидаем.Что(Свойства.ПолучитьМассивБулево("флаги")).РавноМассиву(МассивИз(Истина, Ложь));
	Ожидаем.Что(Свойства.ПолучитьМассивЦелых("целые")).РавноМассиву(МассивИз(1, 2));
	Ожидаем.Что(Свойства.ПолучитьМассивЧисел("числа")).РавноМассиву(МассивИз(1, 2.5));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ПолучитьМассивСтрок|смешанный|последовательность строк")
&ИсточникЗначение("ПолучитьМассивЦелых|числа|последовательность целых чисел")
&ИсточникЗначение("ПолучитьМассивСвойств|смешанный|последовательность соответствий")
Процедура МассивСЭлементомДругогоТипаОшибка(Случай) Экспорт

	// Дано - метод|свойство|ожидаемый тип
	Части = СтрРазделить(Случай, "|");
	Узел = Новый Соответствие;
	Узел.Вставить("смешанный", МассивИз("а", 1));
	Узел.Вставить("числа", МассивИз(1, 2.5));
	Свойства = Новый ОтелСвойстваКонфигурации(Узел);

	// Когда
	ТекстОшибки = ОшибкаЧтения(Свойства, Части[0], Части[1]);

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("""" + Части[1] + """");
	Ожидаем.Что(ТекстОшибки).Содержит(Части[2]);

КонецПроцедуры

&Тест
Процедура МассивСоответствийЧитаетсяКакМассивСвойств() Экспорт

	// Дано
	Первый = Новый Соответствие;
	Первый.Вставить("имя", "первый");
	Второй = Новый Соответствие;
	Второй.Вставить("имя", "второй");
	Узел = Новый Соответствие;
	Узел.Вставить("элементы", МассивИз(Первый, Второй));
	Свойства = Новый ОтелСвойстваКонфигурации(Узел);

	// Когда
	Элементы = Свойства.ПолучитьМассивСвойств("элементы");

	// Тогда
	Ожидаем.Что(Элементы).ИмеетДлину(2);
	Ожидаем.Что(Элементы[0].ПолучитьСтроку("имя")).Равно("первый");
	Ожидаем.Что(Элементы[1].ПолучитьСтроку("имя")).Равно("второй");

КонецПроцедуры

&Тест
Процедура ФиксированныеКоллекцииЧитаютсяКакОбычные() Экспорт

	// Дано - узел из фиксированных соответствий и массивов
	Вложенный = Новый Соответствие;
	Вложенный.Вставить("имя", "значение");
	Узел = Новый Соответствие;
	Узел.Вставить("вложенный", Новый ФиксированноеСоответствие(Вложенный));
	Узел.Вставить("строки", Новый ФиксированныйМассив(МассивИз("а", "б")));
	ФиксированныйВложенный = Новый ФиксированноеСоответствие(Вложенный);
	Элементы = МассивИз(ФиксированныйВложенный, ФиксированныйВложенный);
	Узел.Вставить("элементы", Новый ФиксированныйМассив(Элементы));
	Свойства = Новый ОтелСвойстваКонфигурации(Новый ФиксированноеСоответствие(Узел));

	// Тогда
	Ожидаем.Что(Свойства.ПолучитьСвойства("вложенный").ПолучитьСтроку("имя")).Равно("значение");
	Ожидаем.Что(Свойства.ПолучитьМассивСтрок("строки")).РавноМассиву(МассивИз("а", "б"));
	Ожидаем.Что(Свойства.ПолучитьМассивСвойств("элементы")).ИмеетДлину(2);

КонецПроцедуры

&Тест
Процедура КомпонентБезСвойствДаетПустыеСвойства() Экспорт

	// Дано - ключ компонента без значения (my_exporter:)
	Свойства = Новый ОтелСвойстваКонфигурации(Неопределено);

	// Тогда
	Ожидаем.Что(Свойства.Ключи()).ИмеетДлину(0);
	Ожидаем.Что(Свойства.Содержит("адрес")).ЭтоЛожь();
	Ожидаем.Что(Свойства.ПолучитьСтроку("адрес", "умолчание")).Равно("умолчание");

КонецПроцедуры

&Тест
Процедура ИзменениеИсходногоУзлаНеМеняетСвойства() Экспорт

	// Дано
	Вложенный = Новый Соответствие;
	Вложенный.Вставить("имя", "до");
	Строки = МассивИз("а", "б");
	Узел = Новый Соответствие;
	Узел.Вставить("адрес", "до");
	Узел.Вставить("вложенный", Вложенный);
	Узел.Вставить("строки", Строки);
	Свойства = Новый ОтелСвойстваКонфигурации(Узел);

	// Когда
	Узел.Вставить("адрес", "после");
	Узел.Вставить("новое", 1);
	Вложенный.Вставить("имя", "после");
	Строки.Добавить("в");

	// Тогда
	Ожидаем.Что(Свойства.ПолучитьСтроку("адрес")).Равно("до");
	Ожидаем.Что(Свойства.Содержит("новое")).ЭтоЛожь();
	Ожидаем.Что(Свойства.ПолучитьСвойства("вложенный").ПолучитьСтроку("имя")).Равно("до");
	Ожидаем.Что(Свойства.ПолучитьМассивСтрок("строки")).ИмеетДлину(2);

КонецПроцедуры

Функция УзелСоСкалярами()

	Узел = Новый Соответствие;
	Узел.Вставить("адрес", "http://localhost");
	Узел.Вставить("включен", Истина);
	Узел.Вставить("порт", 4318);
	Узел.Вставить("доля", 0.25);
	Возврат Узел;

КонецФункции

Функция МассивИз(Первый, Второй)

	Массив = Новый Массив;
	Массив.Добавить(Первый);
	Массив.Добавить(Второй);
	Возврат Массив;

КонецФункции

// Возвращает текст ошибки чтения свойства методом или пустую строку, если ошибки нет.
Функция ОшибкаЧтения(Свойства, ИмяМетода, ИмяСвойства)

	Параметры = Новый Массив;
	Параметры.Добавить(ИмяСвойства);
	Попытка
		Рефлектор = Новый Рефлектор;
		Рефлектор.ВызватьМетод(Свойства, ИмяМетода, Параметры);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции
