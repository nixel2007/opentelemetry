КонецПроцедуры

// ===== Проверка модели по схеме =====

// Configuration SDK, Create: значение, недопустимое по схеме конфигурации, - ошибка. Модель, собранная
// в коде, проходит ту же проверку по схеме, что и файл в Разобрать: ошибка называет путь свойства схемы

&ПараметризованныйТест
&ИсточникЗначение("disabled")
&ИсточникЗначение("schedule_delay")
&ИсточникЗначение("max_queue_size")
&ИсточникЗначение("timeout")
&ИсточникЗначение("ratio")
&ИсточникЗначение("event_count_limit")
&ИсточникЗначение("attribute_count_limit")
&ИсточникЗначение("interval")
&ИсточникЗначение("exemplar_filter")
&ИсточникЗначение("temporality_preference")
&ИсточникЗначение("default_histogram_aggregation")
&ИсточникЗначение("attribute_type")
&ИсточникЗначение("span_exporter_temporality")
&ИсточникЗначение("limits_class")
Процедура МодельСНедопустимымЗначениемОшибка(Случай) Экспорт

	// Дано
	Модель = МодельСНарушением(Случай);

	// Когда
	ТекстОшибки = ОшибкаСоздания(Модель);

	// Тогда - нарушение с путем свойства схемы
	Ожидаем.Что(ТекстОшибки).Содержит("Модель конфигурации не соответствует схеме opentelemetry-configuration");
	Ожидаем.Что(ТекстОшибки).Содержит(ОжидаемоеНарушение(Случай));

КонецПроцедуры

// processors провайдеров трассировки и логирования и readers провайдера метрик обязательны по схеме,
// причем хотя бы с одним элементом: провайдер без них - ошибка, как секция без них в файле

&ПараметризованныйТест
&ИсточникЗначение("traces", "/tracer_provider/processors")
&ИсточникЗначение("logs", "/logger_provider/processors")
&ИсточникЗначение("metrics", "/meter_provider/readers")
Процедура ПровайдерБезПроцессоровИлиЧитателейОшибка(Сигнал, Путь) Экспорт

	// Дано
	Модель = НоваяМодель();
	Если Сигнал = "traces" Тогда
		Модель.ПровайдерТрассировки = Новый ОтелКонфигурацияПровайдераТрассировки();
	ИначеЕсли Сигнал = "logs" Тогда
		Модель.ПровайдерЛогирования = Новый ОтелКонфигурацияПровайдераЛогирования();
	Иначе
		Модель.ПровайдерМетрик = Новый ОтелКонфигурацияПровайдераМетрик();
	КонецЕсли;

	// Когда
	ТекстОшибки = ОшибкаСоздания(Модель);

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит(Путь + ": Элементов 0, требуется не меньше 1");

КонецПроцедуры

