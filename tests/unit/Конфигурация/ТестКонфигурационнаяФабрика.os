&Тест
Процедура РазрешитьСелекторДельта() Экспорт

	// Дано - провайдер метрик с читателем с предпочтением delta
	Модель = НоваяМодель();
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераМетрик();
	КонфигЧитателя = Новый ОтелКонфигурацияПериодическогоЧитателя();
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигЭкспортера.ПредпочтениеВременнойАгрегации = "delta";
	КонфигЧитателя.Экспортер = КонфигЭкспортера;
	КонфигПровайдера.Читатели.Добавить(КонфигЧитателя);
	Модель.ПровайдерМетрик = КонфигПровайдера;
	Модель.ПровайдерТрассировки = ПровайдерТрассировкиСПроцессором();
	Модель.ПровайдерЛогирования = ПровайдерЛогированияСПроцессором();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Ожидаем.Что(ТипЗнч(Sdk)).Равно(Тип("ОтелSdk"));

КонецПроцедуры

&Тест
Процедура СоздатьПровайдерМетрикСДвумяЧитателями() Экспорт

	// Дано - два читателя метрик в конфигурации провайдера
	Модель = НоваяМодель();
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераМетрик();
	КонфигЧитателя1 = Новый ОтелКонфигурацияПериодическогоЧитателя();
	КонфигЧитателя1.Экспортер = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигЧитателя2 = Новый ОтелКонфигурацияПериодическогоЧитателя();
	КонфигЧитателя2.Экспортер = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигПровайдера.Читатели.Добавить(КонфигЧитателя1);
	КонфигПровайдера.Читатели.Добавить(КонфигЧитателя2);
	Модель.ПровайдерМетрик = КонфигПровайдера;
	Модель.ПровайдерТрассировки = ПровайдерТрассировкиСПроцессором();
	Модель.ПровайдерЛогирования = ПровайдерЛогированияСПроцессором();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда - SDK создан (ветка массива читателей, строки 180-181)
	Ожидаем.Что(ТипЗнч(Sdk)).Равно(Тип("ОтелSdk"));

КонецПроцедуры

&Тест
Процедура КорневойСэмплерTraceIdRatioBased() Экспорт

	// Дано - сэмплер parent_based с корневым trace_id_ratio_based
	Модель = НоваяМодель();
	КонфигПровайдера = ПровайдерТрассировкиСПроцессором();
	КонфигСэмплера = Новый ОтелКонфигурацияСэмплера();
	КонфигСэмплера.Тип = "parent_based";
	КонфигСэмплера.Корневой = КонфигСэмплераТипа("trace_id_ratio_based", 0.1);
	КонфигПровайдера.Сэмплер = КонфигСэмплера;
	Модель.ПровайдерТрассировки = КонфигПровайдера;
	Модель.ПровайдерЛогирования = ПровайдерЛогированияСПроцессором();
	Модель.ПровайдерМетрик = ПровайдерМетрикСЧитателем();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Ожидаем.Что(Sdk.ПровайдерТрассировки().Сэмплер().Описание()).Равно(
		ОписаниеНаОсновеРодителя("TraceIdRatioBased{0.100000}"));

КонецПроцедуры

// ===== Обязательные свойства =====

// Configuration SDK, Create: обязательное свойство, которого нет в модели, - ошибка. У процессоров
// и периодического читателя обязателен exporter

&ПараметризованныйТест
&ИсточникЗначение("traces", "batch")
&ИсточникЗначение("traces", "simple")
&ИсточникЗначение("logs", "batch")
&ИсточникЗначение("logs", "simple")
&ИсточникЗначение("metrics", "periodic")
Процедура КомпонентБезЭкспортераОшибка(Сигнал, Компонент) Экспорт

	// Дано - Экспортер = Неопределено (по умолчанию)

	// Когда
	ТекстОшибки = "";
	Попытка
		ПровайдерСЭкспортером(Сигнал, Неопределено, Компонент).Закрыть();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Тогда - нарушение схемы с путем компонента
	Если Сигнал = "traces" Тогда
		Путь = "/tracer_provider/processors/0/";
	ИначеЕсли Сигнал = "logs" Тогда
		Путь = "/logger_provider/processors/0/";
	Иначе
		Путь = "/meter_provider/readers/0/";
	КонецЕсли;
	Ожидаем.Что(ТекстОшибки).Содержит(Путь + Компонент + ": Отсутствует обязательное свойство ""exporter""");

КонецПроцедуры

// file_format - обязательное свойство модели: без него и с версией, которую SDK не поддерживает, -
// ошибка, как при разборе файла

&ПараметризованныйТест
&ИсточникЗначение("", "Не задан обязательный file_format")
&ИсточникЗначение("2.0", "Неподдерживаемая версия формата файла: 2.0")
&ИсточникЗначение("abc", "Неподдерживаемая версия формата файла: abc")
Процедура СоздатьСНекорректнымФорматомФайлаОшибка(ФорматФайла, ОжидаемыйТекст) Экспорт

	// Дано
	Модель = НоваяМодель();
	Модель.ФорматФайла = ФорматФайла;

	// Когда
	ТекстОшибки = "";
	Попытка
		ОтелКонфигурационнаяФабрика.Создать(Модель).Закрыть();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит(ОжидаемыйТекст);

КонецПроцедуры

// ===== Проверка модели по схеме =====

// Configuration SDK, Create: значение, недопустимое по схеме конфигурации, - ошибка. Модель, собранная
// в коде, проходит ту же проверку по схеме, что и файл в Разобрать: ошибка называет путь свойства схемы

&ПараметризованныйТест
&ИсточникЗначение("disabled")
&ИсточникЗначение("schedule_delay")
&ИсточникЗначение("max_queue_size")
&ИсточникЗначение("timeout")
&ИсточникЗначение("ratio")
&ИсточникЗначение("event_count_limit")
&ИсточникЗначение("span_attribute_value_depth_limit")
&ИсточникЗначение("attribute_count_limit")
&ИсточникЗначение("attribute_value_depth_limit")
&ИсточникЗначение("max_request_size")
&ИсточникЗначение("max_response_size")
&ИсточникЗначение("encoding")
&ИсточникЗначение("http_tls_insecure")
&ИсточникЗначение("interval")
&ИсточникЗначение("cardinality_limits")
&ИсточникЗначение("exemplar_filter")
&ИсточникЗначение("temporality_preference")
&ИсточникЗначение("default_histogram_aggregation")
&ИсточникЗначение("attribute_type")
&ИсточникЗначение("span_exporter_temporality")
&ИсточникЗначение("limits_class")
&ИсточникЗначение("console_span_temporality")
&ИсточникЗначение("view_instrument_type")
&ИсточникЗначение("view_max_scale")
&ИсточникЗначение("view_aggregation_type")
&ИсточникЗначение("view_cardinality_limit")
&ИсточникЗначение("view_included_empty")
Процедура МодельСНедопустимымЗначениемОшибка(Случай) Экспорт

	// Дано
	Модель = МодельСНарушением(Случай);

	// Когда
	ТекстОшибки = ОшибкаСоздания(Модель);

	// Тогда - нарушение с путем свойства схемы
	Ожидаем.Что(ТекстОшибки).Содержит("Модель конфигурации не соответствует схеме opentelemetry-configuration");
	Ожидаем.Что(ТекстОшибки).Содержит(ОжидаемоеНарушение(Случай));

КонецПроцедуры

// processors провайдеров трассировки и логирования и readers провайдера метрик обязательны по схеме,
// причем хотя бы с одним элементом: провайдер без них - ошибка, как секция без них в файле

&ПараметризованныйТест
&ИсточникЗначение("traces", "/tracer_provider/processors")
&ИсточникЗначение("logs", "/logger_provider/processors")
&ИсточникЗначение("metrics", "/meter_provider/readers")
Процедура ПровайдерБезПроцессоровИлиЧитателейОшибка(Сигнал, Путь) Экспорт

	// Дано
	Модель = НоваяМодель();
	Если Сигнал = "traces" Тогда
		Модель.ПровайдерТрассировки = Новый ОтелКонфигурацияПровайдераТрассировки();
	ИначеЕсли Сигнал = "logs" Тогда
		Модель.ПровайдерЛогирования = Новый ОтелКонфигурацияПровайдераЛогирования();
	Иначе
		Модель.ПровайдерМетрик = Новый ОтелКонфигурацияПровайдераМетрик();
	КонецЕсли;

	// Когда
	ТекстОшибки = ОшибкаСоздания(Модель);

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит(Путь + ": Элементов 0, требуется не меньше 1");

КонецПроцедуры

