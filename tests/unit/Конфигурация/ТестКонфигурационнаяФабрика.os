&Тест
Процедура ТаймаутПериодическогоЧитателяОграничиваетЭкспорт() Экспорт

	// Дано - periodic.timeout читателя
	Модель = Новый ОтелКонфигурация();
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераМетрик();
	КонфигЧитателя = Новый ОтелКонфигурацияПериодическогоЧитателя();
	КонфигЧитателя.Экспортер = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигЧитателя.Таймаут = 1500;
	КонфигПровайдера.Читатели.Добавить(КонфигЧитателя);
	Модель.ПровайдерМетрик = КонфигПровайдера;
	Модель.ПровайдерТрассировки = Новый ОтелКонфигурацияПровайдераТрассировки();
	Модель.ПровайдерЛогирования = Новый ОтелКонфигурацияПровайдераЛогирования();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Читатель = Sdk.ПровайдерМетрик().ЧитателиМетрик()[0];
	Ожидаем.Что(Читатель.ТаймаутЭкспортаМс()).Равно(1500);

КонецПроцедуры

&Тест
Процедура АгрегацияГистограммЭкспортераДоходитДоЧитателя() Экспорт

	// Дано - default_histogram_aggregation экспортера otlp_http; читатель берет агрегацию по
	// умолчанию у экспортера (MetricReader)
	Модель = Новый ОтелКонфигурация();
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераМетрик();
	КонфигЧитателя = Новый ОтелКонфигурацияПериодическогоЧитателя();
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигЭкспортера.АгрегацияГистограммПоУмолчанию = "base2_exponential_bucket_histogram";
	КонфигЧитателя.Экспортер = КонфигЭкспортера;
	КонфигПровайдера.Читатели.Добавить(КонфигЧитателя);
	Модель.ПровайдерМетрик = КонфигПровайдера;
	Модель.ПровайдерТрассировки = Новый ОтелКонфигурацияПровайдераТрассировки();
	Модель.ПровайдерЛогирования = Новый ОтелКонфигурацияПровайдераЛогирования();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Читатель = Sdk.ПровайдерМетрик().ЧитателиМетрик()[0];
	Ожидаем.Что(Читатель.АгрегацияПоУмолчанию("Histogram")).Равно("base2_exponential_bucket_histogram");
	Ожидаем.Что(Читатель.АгрегацияПоУмолчанию("Counter")).Равно("default");
	Sdk.Закрыть();

