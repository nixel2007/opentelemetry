// ===== Вспомогательные =====

Функция КонфигСэмплераТипа(Тип, Доля = 1.0)
	КонфигСэмплера = Новый ОтелКонфигурацияСэмплера();
	КонфигСэмплера.Тип = Тип;
	КонфигСэмплера.Доля = Доля;
	Возврат КонфигСэмплера;
КонецФункции

// Описание ParentBased с заданным корневым сэмплером и делегатами по умолчанию.
Функция ОписаниеНаОсновеРодителя(ОписаниеКорневого)
	Возврат "ParentBased{root:" + ОписаниеКорневого + ",remoteParentSampled:AlwaysOnSampler,"
		+ "remoteParentNotSampled:AlwaysOffSampler,localParentSampled:AlwaysOnSampler,"
		+ "localParentNotSampled:AlwaysOffSampler}";
КонецФункции

Функция СоздатьТестовыйАппендер()
	Текст = "Перем События Экспорт;
	|Процедура ВывестиСобытие(Событие) Экспорт
	|    События.Добавить(Событие);
	|КонецПроцедуры
	|Процедура Закрыть() Экспорт
	|КонецПроцедуры
	|Процедура УстановитьСвойство(Имя, Значение) Экспорт
	|КонецПроцедуры
	|События = Новый Массив();";
	Возврат ЗагрузитьСценарийИзСтроки(Текст);
КонецФункции

Функция ЕстьСообщениеСТекстом(Аппендер, Текст)
	Для Каждого Событие Из Аппендер.События Цикл
		Если СтрНайти(Событие.ПолучитьСообщение(), Текст) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Файловая конфигурация: b3 и b3multi - встроенные пропагаторы схемы декларативной конфигурации,
// как и в OTEL_PROPAGATORS. Класс ОтелB3Пропагатор поставляется пакетом
// opentelemetry-propagator-b3, в тесте его заменяет фикстура. Отдельный процесс: подмененный
// класс не должен попасть в тесты, которые проверяют работу без пакета
&ПараметризованныйТест
&ИсточникЗначение("b3|single")
&ИсточникЗначение("b3multi|multi")
&Изолированный(Уровень = "Процесс")
Процедура СоздатьПропагаторыB3(Случай) Экспорт

	// Дано - имя пропагатора|формат B3
	Части = СтрРазделить(Случай, "|");
	ПодключитьПодменуB3();
	КонфигПропагатора = Новый ОтелКонфигурацияПропагатора();
	КонфигПропагатора.СписокСоставного = "tracecontext," + Части[0];

	// Когда
	Пропагаторы = ОтелКонфигурационнаяФабрика.СоздатьПропагаторы(КонфигПропагатора);

	// Тогда
	Ожидаем.Что(Пропагаторы.Поля()).Содержит("b3-" + Части[1]);

КонецПроцедуры

Процедура ПодключитьПодменуB3()
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "ПодменаB3Пропагатора.os"),
		"ОтелB3Пропагатор");
КонецПроцедуры

// Схема файла конфигурации: секция propagator без composite и composite_list (propagator: {})
// дает noop-пропагатор
&Тест
Процедура СоздатьПропагаторыИзПустойКонфигурации() Экспорт

	// Дано
	КонфигПропагатора = Новый ОтелКонфигурацияПропагатора();

	// Когда
	Пропагаторы = ОтелКонфигурационнаяФабрика.СоздатьПропагаторы(КонфигПропагатора);

	// Тогда
	Ожидаем.Что(ТипЗнч(Пропагаторы)).Равно(Тип("ОтелНоопПропагатор"));

КонецПроцедуры

// Схема файла конфигурации: без секции propagator SDK получает noop-пропагатор
&Тест
Процедура СоздатьSdkБезПропагатора() Экспорт

	// Дано - модель файла без секции propagator
	Модель = Новый ОтелКонфигурация();
	Модель.ПровайдерТрассировки = Новый ОтелКонфигурацияПровайдераТрассировки();
	Модель.ПровайдерЛогирования = Новый ОтелКонфигурацияПровайдераЛогирования();
	Модель.ПровайдерМетрик = Новый ОтелКонфигурацияПровайдераМетрик();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Ожидаем.Что(ТипЗнч(Sdk.Пропагаторы())).Равно(Тип("ОтелНоопПропагатор"));

КонецПроцедуры

// Транспорт, созданный по файлу конфигурации, закрывает экспортер при закрытии провайдера.
// Закрытие видно по отладочной записи транспорта
&ПараметризованныйТест
&ИсточникЗначение("traces")
&ИсточникЗначение("logs")
&ИсточникЗначение("metrics")
Процедура ЗакрытиеПровайдераЗакрываетТранспортФайлаКонфигурации(Сигнал) Экспорт

	// Дано - экспортер otlp_http
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигЭкспортера.Адрес = "http://localhost:1/v1/" + Сигнал;
	КонфигЭкспортера.Таймаут = 1000;
	Провайдер = ПровайдерСЭкспортеромOtlpHttp(Сигнал, КонфигЭкспортера);
	ИмяЛога = "oscript.lib.opentelemetry.transport";
	Аппендер = СоздатьТестовыйАппендер();
	Логирование.ПолучитьЛог(ИмяЛога).ДобавитьСпособВывода(Аппендер, УровниЛога.Отладка);

	// Когда
	Провайдер.Закрыть();

	// Тогда
	Логирование.ПолучитьЛог(ИмяЛога).УдалитьСпособВывода(Аппендер);
	Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "транспорт закрыт"), Сигнал).ЭтоИстина();

КонецПроцедуры

Функция ПровайдерСЭкспортеромOtlpHttp(Сигнал, КонфигЭкспортера)
	Ресурс = Новый ОтелРесурс();
	Если Сигнал = "metrics" Тогда
		КонфигЧитателя = Новый ОтелКонфигурацияПериодическогоЧитателя();
		КонфигЧитателя.Экспортер = КонфигЭкспортера;
		КонфигПровайдера = Новый ОтелКонфигурацияПровайдераМетрик();
		КонфигПровайдера.Читатели.Добавить(КонфигЧитателя);
		Возврат ОтелКонфигурационнаяФабрика.СоздатьПровайдерМетрик(Ресурс, КонфигПровайдера);
	КонецЕсли;
	КонфигПроцессора = Новый ОтелКонфигурацияПакетногоПроцессора();
	КонфигПроцессора.Экспортер = КонфигЭкспортера;
	Если Сигнал = "traces" Тогда
		КонфигПровайдера = Новый ОтелКонфигурацияПровайдераТрассировки();
		КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора);
		Возврат ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(Ресурс, КонфигПровайдера);
	КонецЕсли;
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераЛогирования();
	КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора);
	Возврат ОтелКонфигурационнаяФабрика.СоздатьПровайдерЛогирования(Ресурс, КонфигПровайдера);
КонецФункции
