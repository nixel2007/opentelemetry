// Функции, которые строят часть SDK из части модели, проверяют свою часть по схеме так же, как Создать
// всю модель: путь в ошибке - путь части в модели

&ПараметризованныйТест
&ИсточникЗначение("СоздатьРесурс", "/resource/attributes/0/type")
&ИсточникЗначение("СоздатьПровайдерТрассировки", "/tracer_provider/processors/0/batch/schedule_delay")
&ИсточникЗначение("СоздатьПровайдерТрассировки.limits", "/attribute_limits/attribute_count_limit")
&ИсточникЗначение("СоздатьПровайдерЛогирования", "/logger_provider/processors/0/batch/max_queue_size")
&ИсточникЗначение("СоздатьПровайдерЛогирования.limits", "/attribute_limits/attribute_count_limit")
&ИсточникЗначение("СоздатьПровайдерМетрик", "/meter_provider/exemplar_filter")
&ИсточникЗначение("СоздатьПропагаторы", "/propagator/composite/0")
Процедура ФункцияЧастиМоделиПроверяетЧасть(ИмяФункции, Путь) Экспорт

	// Дано
	Ресурс = Новый ОтелРесурс();
	ГлобальныеЛимиты = Новый ОтелКонфигурацияЛимитовАтрибутов();
	ГлобальныеЛимиты.МаксКоличествоАтрибутов = -5;

	// Когда
	ТекстОшибки = "";
	Попытка
		Если ИмяФункции = "СоздатьРесурс" Тогда
			ОтелКонфигурационнаяФабрика.СоздатьРесурс(МодельСНарушением("attribute_type").Ресурс);
		ИначеЕсли ИмяФункции = "СоздатьПровайдерТрассировки" Тогда
			ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(Ресурс,
				МодельСНарушением("schedule_delay").ПровайдерТрассировки).Закрыть();
		ИначеЕсли ИмяФункции = "СоздатьПровайдерТрассировки.limits" Тогда
			ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(Ресурс,
				ПровайдерТрассировкиСПроцессором(), ГлобальныеЛимиты).Закрыть();
		ИначеЕсли ИмяФункции = "СоздатьПровайдерЛогирования" Тогда
			ОтелКонфигурационнаяФабрика.СоздатьПровайдерЛогирования(Ресурс,
				МодельСНарушением("max_queue_size").ПровайдерЛогирования).Закрыть();
		ИначеЕсли ИмяФункции = "СоздатьПровайдерЛогирования.limits" Тогда
			ОтелКонфигурационнаяФабрика.СоздатьПровайдерЛогирования(Ресурс,
				ПровайдерЛогированияСПроцессором(), ГлобальныеЛимиты).Закрыть();
		ИначеЕсли ИмяФункции = "СоздатьПровайдерМетрик" Тогда
			ОтелКонфигурационнаяФабрика.СоздатьПровайдерМетрик(Ресурс,
				МодельСНарушением("exemplar_filter").ПровайдерМетрик).Закрыть();
		Иначе
			КонфигПропагатора = Новый ОтелКонфигурацияПропагатора();
			КонфигПропагатора.Составной.Добавить("tracecontext");
			ОтелКонфигурационнаяФабрика.СоздатьПропагаторы(КонфигПропагатора);
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("Модель конфигурации не соответствует схеме opentelemetry-configuration");
	Ожидаем.Что(ТекстОшибки).Содержит(Путь + ": ");

КонецПроцедуры

// ===== Процессоры спанов: граничные случаи =====

&Тест
Процедура ДваПроцессораСпановОбъединяютсяВКомпозитный() Экспорт

	// Дано - два процессора с экспортерами → СоздатьПроцессорыСпанов вернёт
	//        ОтелКомпозитныйПроцессорСпанов → строка 268
	Модель = НоваяМодель();
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераТрассировки();
	КонфигПроцессора1 = Новый ОтелКонфигурацияПакетногоПроцессора();
	КонфигПроцессора1.Экспортер = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигПроцессора2 = Новый ОтелКонфигурацияПакетногоПроцессора();
	КонфигПроцессора2.Экспортер = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора1);
	КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора2);
	Модель.ПровайдерТрассировки = КонфигПровайдера;
	Модель.ПровайдерЛогирования = ПровайдерЛогированияСПроцессором();
	Модель.ПровайдерМетрик = ПровайдерМетрикСЧитателем();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Ожидаем.Что(ТипЗнч(Sdk)).Равно(Тип("ОтелSdk"));

КонецПроцедуры

// ===== Процессоры логов: граничные случаи =====

&Тест
Процедура ДваПроцессораЛоговОбъединяютсяВКомпозитный() Экспорт

	// Дано - два процессора логов → строка 321
	Модель = НоваяМодель();
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераЛогирования();
	КонфигПроцессора1 = Новый ОтелКонфигурацияПакетногоПроцессора();
	КонфигПроцессора1.Экспортер = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигПроцессора2 = Новый ОтелКонфигурацияПакетногоПроцессора();
	КонфигПроцессора2.Экспортер = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора1);
	КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора2);
	Модель.ПровайдерЛогирования = КонфигПровайдера;
	Модель.ПровайдерТрассировки = ПровайдерТрассировкиСПроцессором();
	Модель.ПровайдерМетрик = ПровайдерМетрикСЧитателем();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Ожидаем.Что(ТипЗнч(Sdk)).Равно(Тип("ОтелSdk"));

КонецПроцедуры

// ===== Фильтр экземпляров: граничные случаи =====

&Тест
Процедура ФильтрЭкземпляровПустаяСтрокаВозвращаетПоТрассировке() Экспорт

	Модель = НоваяМодель();
	КонфигПровайдера = ПровайдерМетрикСЧитателем();
	КонфигПровайдера.ФильтрЭкземпляров = "";
	Модель.ПровайдерМетрик = КонфигПровайдера;
	Модель.ПровайдерТрассировки = ПровайдерТрассировкиСПроцессором();
	Модель.ПровайдерЛогирования = ПровайдерЛогированияСПроцессором();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Ожидаем.Что(ТипЗнч(Sdk)).Равно(Тип("ОтелSdk"));

КонецПроцедуры

&Тест
Процедура ПровайдерЛогированияСГлобальнымиЛимитами() Экспорт

	// Дано - глобальные лимиты атрибутов без специфичных для провайдера (строки 484-485, 496-497)
	Модель = НоваяМодель();
	КонфигурацияГлобальныхЛимитов = Новый ОтелКонфигурацияЛимитовАтрибутов();
	КонфигурацияГлобальныхЛимитов.МаксКоличествоАтрибутов = 100;
	КонфигурацияГлобальныхЛимитов.МаксДлинаЗначенияАтрибута = 500;
	Модель.ЛимитыАтрибутов = КонфигурацияГлобальныхЛимитов;
	КонфигПровайдера = ПровайдерЛогированияСПроцессором();
	// КонфигПровайдера.Лимиты = Неопределено (по умолчанию) → используются глобальные лимиты
	Модель.ПровайдерЛогирования = КонфигПровайдера;
	Модель.ПровайдерТрассировки = ПровайдерТрассировкиСПроцессором();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Ожидаем.Что(ТипЗнч(Sdk)).Равно(Тип("ОтелSdk"));

КонецПроцедуры

// ===== Вспомогательные =====

// Возвращает модель с обязательным file_format и без секций.
Функция НоваяМодель()
	Модель = Новый ОтелКонфигурация();
	Модель.ФорматФайла = "1.0";
	Возврат Модель;
КонецФункции

// Возвращает модель со всеми секциями и одним значением, недопустимым по схеме: случай - имя свойства
// схемы. Пустой случай - модель без нарушений.
Функция МодельСНарушением(Случай)

	ПровайдерТрассировки = Новый ОтелКонфигурацияПровайдераТрассировки();
	ПроцессорСпанов = ПакетныйПроцессор("traces");
	ПровайдерТрассировки.Процессоры.Добавить(ПроцессорСпанов);
	ПровайдерТрассировки.Сэмплер = КонфигСэмплераТипа("trace_id_ratio_based", 0.5);
	ПровайдерТрассировки.Лимиты = Новый ОтелКонфигурацияЛимитовСпана();
	ПровайдерЛогирования = Новый ОтелКонфигурацияПровайдераЛогирования();
	ПровайдерЛогирования.Процессоры.Добавить(ПакетныйПроцессор("logs"));

	Модель = НоваяМодель();
	Модель.Ресурс = Новый ОтелКонфигурацияРесурса();
	Модель.Ресурс.Атрибуты.Добавить(Новый Структура("Имя, Значение", "service.name", "schema-test"));
	Модель.ЛимитыАтрибутов = Новый ОтелКонфигурацияЛимитовАтрибутов();
	Модель.Пропагатор = Новый ОтелКонфигурацияПропагатора();
	Модель.Пропагатор.Составной.Добавить(КомпонентКонфигурации("tracecontext"));
	Модель.ПровайдерТрассировки = ПровайдерТрассировки;
	Модель.ПровайдерЛогирования = ПровайдерЛогирования;
	Модель.ПровайдерМетрик = ПровайдерМетрикСЧитателем();

	Если Случай = "" Тогда
		Возврат Модель;
	КонецЕсли;

	// Нарушение в провайдере трассировки
	Если Случай = "schedule_delay" Тогда
		ПроцессорСпанов.ЗадержкаОтправки = -1;
	ИначеЕсли Случай = "timeout" Тогда
		ПроцессорСпанов.Экспортер.Таймаут = "5000";
	ИначеЕсли Случай = "span_exporter_temporality" Тогда
		ПроцессорСпанов.Экспортер.ПредпочтениеВременнойАгрегации = "delta";
	ИначеЕсли Случай = "ratio" Тогда
		ПровайдерТрассировки.Сэмплер.Доля = 1.5;
	ИначеЕсли Случай = "event_count_limit" Тогда
		ПровайдерТрассировки.Лимиты.МаксСобытий = -1;
	Иначе
		ВнестиНарушениеВнеТрассировки(Модель, Случай);
	КонецЕсли;

	Возврат Модель;

КонецФункции

Процедура ВнестиНарушениеВнеТрассировки(Модель, Случай)

	Читатель = Модель.ПровайдерМетрик.Читатели[0];
	Если Случай = "disabled" Тогда
		Модель.Отключен = "yes";
	ИначеЕсли Случай = "max_queue_size" Тогда
		Модель.ПровайдерЛогирования.Процессоры[0].МаксРазмерОчереди = 0;
	ИначеЕсли Случай = "limits_class" Тогда
		Модель.ПровайдерЛогирования.Лимиты = Новый ОтелКонфигурацияЛимитовСпана();
	ИначеЕсли Случай = "attribute_count_limit" Тогда
		Модель.ЛимитыАтрибутов.МаксКоличествоАтрибутов = -5;
	ИначеЕсли Случай = "attribute_type" Тогда
		Модель.Ресурс.Атрибуты.Вставить(0, Новый Структура("Имя, Значение, Тип", "port", 8080, "integer"));
	ИначеЕсли Случай = "interval" Тогда
		Читатель.Интервал = -1;
	ИначеЕсли Случай = "exemplar_filter" Тогда
		Модель.ПровайдерМетрик.ФильтрЭкземпляров = "sometimes";
	ИначеЕсли Случай = "temporality_preference" Тогда
		Читатель.Экспортер.ПредпочтениеВременнойАгрегации = "DELTA";
	ИначеЕсли Случай = "default_histogram_aggregation" Тогда
		Читатель.Экспортер = Новый ОтелКонфигурацияЭкспортераOtlpGrpc();
		Читатель.Экспортер.АгрегацияГистограммПоУмолчанию = "exponential";
	Иначе
		ВызватьИсключение "Неизвестный случай нарушения: " + Случай;
	КонецЕсли;

КонецПроцедуры

// Возвращает строку нарушения, которую ошибка проверки модели содержит для случая МодельСНарушением.
Функция ОжидаемоеНарушение(Случай)

	Нарушения = Новый Соответствие;
	Нарушения.Вставить("disabled", "/disabled: Ожидался тип boolean или null, получен string");
	Нарушения.Вставить("schedule_delay",
		"/tracer_provider/processors/0/batch/schedule_delay: Значение -1 меньше минимума 0");
	Нарушения.Вставить("max_queue_size",
		"/logger_provider/processors/0/batch/max_queue_size: Значение 0 не больше строгого минимума 0");
	Нарушения.Вставить("timeout",
		"/tracer_provider/processors/0/batch/exporter/otlp_http/timeout: Ожидался тип integer или null, получен string");
	Нарушения.Вставить("ratio", "/tracer_provider/sampler/trace_id_ratio_based/ratio: Значение 1.5 больше максимума 1");
	Нарушения.Вставить("event_count_limit", "/tracer_provider/limits/event_count_limit: Значение -1 меньше минимума 0");
	Нарушения.Вставить("attribute_count_limit",
		"/attribute_limits/attribute_count_limit: Значение -5 меньше минимума 0");
	Нарушения.Вставить("interval", "/meter_provider/readers/0/periodic/interval: Значение -1 меньше минимума 0");
	Нарушения.Вставить("exemplar_filter",
		"/meter_provider/exemplar_filter: Значение ""sometimes"" не входит в перечисление enum");
	Нарушения.Вставить("temporality_preference",
		"/meter_provider/readers/0/periodic/exporter/otlp_http/temporality_preference: Значение ""DELTA""");
	Нарушения.Вставить("default_histogram_aggregation",
		"/meter_provider/readers/0/periodic/exporter/otlp_grpc/default_histogram_aggregation: "
		+ "Значение ""exponential""");
	Нарушения.Вставить("attribute_type",
		"/resource/attributes/0/type: Значение ""integer"" не входит в перечисление enum");
	Нарушения.Вставить("span_exporter_temporality",
		"/tracer_provider/processors/0/batch/exporter/otlp_http/temporality_preference: Свойство ""temporality_");
	Нарушения.Вставить("limits_class", "/logger_provider/limits: Ожидался тип object");
	Возврат Нарушения.Получить(Случай);

КонецФункции

// Возвращает текст ошибки Создать или пустую строку, если SDK создан.
Функция ОшибкаСоздания(Модель)
	Попытка
		Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Sdk.Закрыть();
	Возврат "";
КонецФункции

// Возвращает провайдер трассировки модели с простым процессором: processors обязателен по схеме.
Функция ПровайдерТрассировкиСПроцессором()
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераТрассировки();
	КонфигПровайдера.Процессоры.Добавить(ПростойПроцессор("traces"));
	Возврат КонфигПровайдера;
КонецФункции

// Возвращает провайдер логирования модели с простым процессором: processors обязателен по схеме.
Функция ПровайдерЛогированияСПроцессором()
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераЛогирования();
	КонфигПровайдера.Процессоры.Добавить(ПростойПроцессор("logs"));
	Возврат КонфигПровайдера;
КонецФункции

// Возвращает провайдер метрик модели с периодическим читателем: readers обязателен по схеме.
Функция ПровайдерМетрикСЧитателем()
	КонфигЧитателя = Новый ОтелКонфигурацияПериодическогоЧитателя();
	КонфигЧитателя.Экспортер = ЭкспортерOtlpHttp("metrics");
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераМетрик();
	КонфигПровайдера.Читатели.Добавить(КонфигЧитателя);
	Возврат КонфигПровайдера;
КонецФункции

Функция ПростойПроцессор(Сигнал)
	КонфигПроцессора = Новый ОтелКонфигурацияПростогоПроцессора();
	КонфигПроцессора.Экспортер = ЭкспортерOtlpHttp(Сигнал);
	Возврат КонфигПроцессора;
КонецФункции

Функция ПакетныйПроцессор(Сигнал)
	КонфигПроцессора = Новый ОтелКонфигурацияПакетногоПроцессора();
	КонфигПроцессора.Экспортер = ЭкспортерOtlpHttp(Сигнал);
	Возврат КонфигПроцессора;
КонецФункции

// Экспортер otlp_http на закрытый порт: тесты не отправляют данные коллектору.
Функция ЭкспортерOtlpHttp(Сигнал)
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигЭкспортера.Адрес = "http://localhost:1/v1/" + Сигнал;
	Возврат КонфигЭкспортера;
КонецФункции

Функция КонфигСэмплераТипа(Тип, Доля = 1.0)
	КонфигСэмплера = Новый ОтелКонфигурацияСэмплера();
	КонфигСэмплера.Тип = Тип;
	КонфигСэмплера.Доля = Доля;
	Возврат КонфигСэмплера;
КонецФункции

// Описание ParentBased с заданным корневым сэмплером и делегатами по умолчанию.
Функция ОписаниеНаОсновеРодителя(ОписаниеКорневого)
	Возврат "ParentBased{root:" + ОписаниеКорневого + ",remoteParentSampled:AlwaysOnSampler,"
		+ "remoteParentNotSampled:AlwaysOffSampler,localParentSampled:AlwaysOnSampler,"
		+ "localParentNotSampled:AlwaysOffSampler}";
КонецФункции

Функция СоздатьТестовыйАппендер()
	Текст = "Перем События Экспорт;
	|Процедура ВывестиСобытие(Событие) Экспорт
	|    События.Добавить(Событие);
	|КонецПроцедуры
	|Процедура Закрыть() Экспорт
	|КонецПроцедуры
	|Процедура УстановитьСвойство(Имя, Значение) Экспорт
	|КонецПроцедуры
	|События = Новый Массив();";
	Возврат ЗагрузитьСценарийИзСтроки(Текст);
КонецФункции

Функция ЕстьСообщениеСТекстом(Аппендер, Текст)
	Для Каждого Событие Из Аппендер.События Цикл
		Если СтрНайти(Событие.ПолучитьСообщение(), Текст) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Файловая конфигурация: b3 и b3multi - встроенные пропагаторы схемы декларативной конфигурации,
// как и в OTEL_PROPAGATORS. Класс ОтелB3Пропагатор поставляется пакетом
// opentelemetry-propagator-b3, в тесте его заменяет фикстура. Отдельный процесс: подмененный
// класс не должен попасть в тесты, которые проверяют работу без пакета
&ПараметризованныйТест
&ИсточникЗначение("b3|single")
&ИсточникЗначение("b3multi|multi")
&Изолированный(Уровень = "Процесс")
Процедура СоздатьПропагаторыB3(Случай) Экспорт

	// Дано - имя пропагатора|формат B3
	Части = СтрРазделить(Случай, "|");
	ПодключитьПодменуB3();
	КонфигПропагатора = Новый ОтелКонфигурацияПропагатора();
	КонфигПропагатора.СписокСоставного = "tracecontext," + Части[0];

	// Когда
	Пропагаторы = ОтелКонфигурационнаяФабрика.СоздатьПропагаторы(КонфигПропагатора);

	// Тогда
	Ожидаем.Что(Пропагаторы.Поля()).Содержит("b3-" + Части[1]);

КонецПроцедуры

Процедура ПодключитьПодменуB3()
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "ПодменаB3Пропагатора.os"),
		"ОтелB3Пропагатор");
КонецПроцедуры

// Схема файла конфигурации: секция propagator без composite и composite_list (propagator: {})
// дает noop-пропагатор
&Тест
Процедура СоздатьПропагаторыИзПустойКонфигурации() Экспорт

	// Дано
	КонфигПропагатора = Новый ОтелКонфигурацияПропагатора();

	// Когда
	Пропагаторы = ОтелКонфигурационнаяФабрика.СоздатьПропагаторы(КонфигПропагатора);

	// Тогда
	Ожидаем.Что(ТипЗнч(Пропагаторы)).Равно(Тип("ОтелНоопПропагатор"));

КонецПроцедуры

// Схема файла конфигурации: без секции propagator SDK получает noop-пропагатор
&Тест
Процедура СоздатьSdkБезПропагатора() Экспорт

	// Дано - модель файла без секции propagator
	Модель = НоваяМодель();
	Модель.ПровайдерТрассировки = ПровайдерТрассировкиСПроцессором();
	Модель.ПровайдерЛогирования = ПровайдерЛогированияСПроцессором();
	Модель.ПровайдерМетрик = ПровайдерМетрикСЧитателем();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Ожидаем.Что(ТипЗнч(Sdk.Пропагаторы())).Равно(Тип("ОтелНоопПропагатор"));

КонецПроцедуры

// Транспорт, созданный по файлу конфигурации, закрывает экспортер при закрытии провайдера.
// Закрытие видно по отладочной записи транспорта
&ПараметризованныйТест
&ИсточникЗначение("traces", "batch")
&ИсточникЗначение("logs", "batch")
&ИсточникЗначение("metrics", "periodic")
&ИсточникЗначение("traces", "simple")
&ИсточникЗначение("logs", "simple")
Процедура ЗакрытиеПровайдераЗакрываетТранспортФайлаКонфигурации(Сигнал, Компонент) Экспорт

	// Дано - экспортер otlp_http у пакетного или простого процессора, у периодического читателя
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигЭкспортера.Адрес = "http://localhost:1/v1/" + Сигнал;
	КонфигЭкспортера.Таймаут = 1000;
	Провайдер = ПровайдерСЭкспортером(Сигнал, КонфигЭкспортера, Компонент);
	ИмяЛога = "oscript.lib.opentelemetry.transport";
	Аппендер = СоздатьТестовыйАппендер();
	Логирование.ПолучитьЛог(ИмяЛога).ДобавитьСпособВывода(Аппендер, УровниЛога.Отладка);

	// Когда
	Провайдер.Закрыть();

	// Тогда
	Логирование.ПолучитьЛог(ИмяЛога).УдалитьСпособВывода(Аппендер);
	Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "транспорт закрыт"), Сигнал + " " + Компонент).ЭтоИстина();

КонецПроцедуры

// Экспортер otlp_grpc отправляет данные через ОтелGrpcТранспорт, созданный фабрикой: транспорт
// закрывается вместе с провайдером. Закрытие видно по отладочной записи gRPC-транспорта
&ПараметризованныйТест
&ИсточникЗначение("traces", "batch")
&ИсточникЗначение("logs", "simple")
&ИсточникЗначение("metrics", "periodic")
Процедура ЗакрытиеПровайдераЗакрываетGrpcТранспорт(Сигнал, Компонент) Экспорт

	// Дано
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpGrpc();
	КонфигЭкспортера.Адрес = "http://localhost:1";
	КонфигЭкспортера.Таймаут = 1000;
	Провайдер = ПровайдерСЭкспортером(Сигнал, КонфигЭкспортера, Компонент);
	ИмяЛога = "oscript.lib.opentelemetry.grpc";
	Аппендер = СоздатьТестовыйАппендер();
	Логирование.ПолучитьЛог(ИмяЛога).ДобавитьСпособВывода(Аппендер, УровниЛога.Отладка);

	// Когда
	Провайдер.Закрыть();

	// Тогда
	Логирование.ПолучитьЛог(ИмяЛога).УдалитьСпособВывода(Аппендер);
	Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "транспорт закрыт"), Сигнал + " " + Компонент).ЭтоИстина();

КонецПроцедуры

// Клиент OPI_GRPC не поддерживает сжатие: compression: gzip у otlp_grpc не игнорируется молча
&Тест
Процедура СжатиеGrpcНеПоддерживаетсяСПредупреждением() Экспорт

	// Дано
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpGrpc();
	КонфигЭкспортера.Адрес = "http://localhost:1";
	КонфигЭкспортера.Сжатие = "gzip";
	ИмяЛога = "oscript.lib.opentelemetry.config.factory";
	Аппендер = СоздатьТестовыйАппендер();
	Логирование.ПолучитьЛог(ИмяЛога).ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);

	// Когда
	Провайдер = ПровайдерСЭкспортером("traces", КонфигЭкспортера);

	// Тогда - предупреждение ссылается на задачу о сжатии в OPI_GRPC
	Логирование.ПолучитьЛог(ИмяЛога).УдалитьСпособВывода(Аппендер);
	Провайдер.Закрыть();
	Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "не поддерживается"), "предупреждение").ЭтоИстина();
	Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "Bayselonarrend/OpenIntegrations/issues/112"), "ссылка на задачу")
		.ЭтоИстина();

КонецПроцедуры

// Простой процессор (simple) из файла конфигурации - SimpleSpanProcessor и SimpleLogRecordProcessor SDK
&ПараметризованныйТест
&ИсточникЗначение("traces", "ОтелПростойПроцессорСпанов")
&ИсточникЗначение("logs", "ОтелПростойПроцессорЛогов")
Процедура СоздатьПровайдерСПростымПроцессором(Сигнал, ТипПроцессора) Экспорт

	// Дано
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигЭкспортера.Адрес = "http://localhost:1/v1/" + Сигнал;

	// Когда
	Провайдер = ПровайдерСЭкспортером(Сигнал, КонфигЭкспортера, "simple");

	// Тогда - провайдер хранит процессоры в композитном
	Процессоры = Провайдер.Процессор().Процессоры();
	Провайдер.Закрыть();
	Ожидаем.Что(Процессоры.Количество()).Равно(1);
	Ожидаем.Что(Процессоры[0]).ИмеетТип(ТипПроцессора);

КонецПроцедуры

// Создает провайдер сигнала с экспортером: для traces и logs - у процессора, для metrics - у
// периодического читателя.
//
// Параметры:
//   Сигнал - Строка - traces, logs или metrics
//   КонфигЭкспортера - Произвольный - конфигурация экспортера
//   Компонент - Строка - процессор batch или simple; для metrics не используется
//
Функция ПровайдерСЭкспортером(Сигнал, КонфигЭкспортера, Компонент = "batch")
	Ресурс = Новый ОтелРесурс();
	Если Сигнал = "metrics" Тогда
		КонфигЧитателя = Новый ОтелКонфигурацияПериодическогоЧитателя();
		КонфигЧитателя.Экспортер = КонфигЭкспортера;
		КонфигПровайдера = Новый ОтелКонфигурацияПровайдераМетрик();
		КонфигПровайдера.Читатели.Добавить(КонфигЧитателя);
		Возврат ОтелКонфигурационнаяФабрика.СоздатьПровайдерМетрик(Ресурс, КонфигПровайдера);
	КонецЕсли;
	Если Компонент = "simple" Тогда
		КонфигПроцессора = Новый ОтелКонфигурацияПростогоПроцессора();
	Иначе
		КонфигПроцессора = Новый ОтелКонфигурацияПакетногоПроцессора();
	КонецЕсли;
	КонфигПроцессора.Экспортер = КонфигЭкспортера;
	Возврат ПровайдерСПроцессором(Сигнал, КонфигПроцессора);
КонецФункции

// Создает провайдер трассировки (traces) или логирования (logs) с одним процессором.
Функция ПровайдерСПроцессором(Сигнал, КонфигПроцессора)
	Ресурс = Новый ОтелРесурс();
	Если Сигнал = "traces" Тогда
		КонфигПровайдера = Новый ОтелКонфигурацияПровайдераТрассировки();
		КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора);
		Возврат ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(Ресурс, КонфигПровайдера);
	КонецЕсли;
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераЛогирования();
	КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора);
	Возврат ОтелКонфигурационнаяФабрика.СоздатьПровайдерЛогирования(Ресурс, КонфигПровайдера);
КонецФункции

// Возвращает компонент модели по имени без свойств: пропагатор, экспортер или другой компонент.
Функция КомпонентКонфигурации(Имя)
	Компонент = Новый ОтелКонфигурацияКомпонента();
	Компонент.Имя = Имя;
	Возврат Компонент;
КонецФункции

// Возвращает читатель pull, как его сохраняет разбор файла: по схеме у него обязателен pull-экспортер.
Функция PullЧитатель()
	Экспортер = Новый Соответствие;
	Экспортер.Вставить("my_pull_exporter", Неопределено);
	Компонент = КомпонентКонфигурации("pull");
	Компонент.Свойства = Новый Соответствие;
	Компонент.Свойства.Вставить("exporter", Экспортер);
	Возврат Компонент;
КонецФункции

// Возвращает текст ошибки создания провайдера трассировки или пустую строку, если провайдер создан.
Функция ОшибкаСозданияПровайдераТрассировки(КонфигПровайдера)
	Попытка
		Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(Новый ОтелРесурс(), КонфигПровайдера);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Провайдер.Закрыть();
	Возврат "";
КонецФункции
