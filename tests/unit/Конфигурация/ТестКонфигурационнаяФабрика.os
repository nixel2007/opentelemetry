// ------------------------------------------------------------------
// Тесты модуля ОтелКонфигурационнаяФабрика
// ------------------------------------------------------------------

// ===== Создание полного SDK =====

&Тест
Процедура СоздатьМинимальныйSdk() Экспорт

	// Дано - модель только с file_format: по схеме без секции провайдера провайдер noop
	Модель = НоваяМодель();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Ожидаем.Что(ТипЗнч(Sdk)).Равно(Тип("ОтелSdk"));
	Ожидаем.Что(Sdk.ПровайдерТрассировки()).Не_().ИмеетТип("Неопределено");
	Ожидаем.Что(Sdk.ПровайдерЛогирования()).Не_().ИмеетТип("Неопределено");
	Ожидаем.Что(Sdk.ПровайдерМетрик()).Не_().ИмеетТип("Неопределено");

КонецПроцедуры

&Тест
Процедура СоздатьНоопSdkПриОтключенномКонфиге() Экспорт

	// Дано
	Модель = НоваяМодель();
	Модель.Отключен = Истина;

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Ожидаем.Что(ТипЗнч(Sdk)).Равно(Тип("ОтелSdk"));

	Трассировщик = Sdk.ПровайдерТрассировки().ПостроительТрассировщика("test").Построить();
	Спан = Трассировщик.НачатьСпан("тест");
	Ожидаем.Что(ТипЗнч(Спан)).Равно(Тип("ОтелНезаписывающийСпан"));

	// Инструменты no-op SDK не накапливают измерения
	Счетчик = Sdk.ПолучитьМетр("test").СоздатьСчетчик("noop.counter");
	Счетчик.Добавить(1);
	Ожидаем.Что(Счетчик.Включен()).ЭтоЛожь();
	Ожидаем.Что(Счетчик.КоличествоСерий()).Равно(0);

КонецПроцедуры

// ===== Ресурс =====

&Тест
Процедура СоздатьРесурсИзМассиваАтрибутов() Экспорт

	// Дано
	КонфигРесурса = Новый ОтелКонфигурацияРесурса();
	Запись1 = Новый Структура("Имя, Значение", "service.name", "my-service");
	Запись2 = Новый Структура("Имя, Значение", "service.version", "1.0.0");
	КонфигРесурса.Атрибуты.Добавить(Запись1);
	КонфигРесурса.Атрибуты.Добавить(Запись2);

	// Когда
	Ресурс = ОтелКонфигурационнаяФабрика.СоздатьРесурс(КонфигРесурса);

	// Тогда
	Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name")).Равно("my-service");
	Ожидаем.Что(Ресурс.Атрибуты().Получить("service.version")).Равно("1.0.0");

КонецПроцедуры

&Тест
Процедура СоздатьРесурсИзСтрокиАтрибутов() Экспорт

	// Дано
	КонфигРесурса = Новый ОтелКонфигурацияРесурса();
	КонфигРесурса.СписокАтрибутов = "service.name=test,env=prod";

	// Когда
	Ресурс = ОтелКонфигурационнаяФабрика.СоздатьРесурс(КонфигРесурса);

	// Тогда
	Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name")).Равно("test");
	Ожидаем.Что(Ресурс.Атрибуты().Получить("env")).Равно("prod");

КонецПроцедуры

// Схема файла конфигурации: resource.schema_url задает URL схемы ресурса

&Тест
Процедура СоздатьРесурсСАдресомСхемы() Экспорт

	// Дано
	КонфигРесурса = Новый ОтелКонфигурацияРесурса();
	КонфигРесурса.АдресСхемы = "https://opentelemetry.io/schemas/1.26.0";

	// Когда
	Ресурс = ОтелКонфигурационнаяФабрика.СоздатьРесурс(КонфигРесурса);

	// Тогда
	Ожидаем.Что(Ресурс.АдресСхемы()).Равно("https://opentelemetry.io/schemas/1.26.0");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("a=%ZZ,b=1")
&ИсточникЗначение("a=1,malformed_no_equals,b=1")
Процедура СоздатьРесурсОтбрасываетСписокАтрибутовСОшибкойЦеликом(СписокАтрибутов) Экспорт

	// Дано - attributes_list в формате OTEL_RESOURCE_ATTRIBUTES с ошибкой разбора:
	// значение отбрасывается целиком и ошибка сообщается, attributes применяются
	КонфигРесурса = Новый ОтелКонфигурацияРесурса();
	КонфигРесурса.Атрибуты.Добавить(Новый Структура("Имя, Значение", "service.name", "my-service"));
	КонфигРесурса.СписокАтрибутов = СписокАтрибутов;
	Аппендер = СоздатьТестовыйАппендер();
	Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.config.factory");
	Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Ошибка);

	// Когда
	Попытка
		Ресурс = ОтелКонфигурационнаяФабрика.СоздатьРесурс(КонфигРесурса);
	Исключение
		Лог.УдалитьСпособВывода(Аппендер);
		ВызватьИсключение;
	КонецПопытки;
	Лог.УдалитьСпособВывода(Аппендер);

	// Тогда
	Ожидаем.Что(Ресурс.Атрибуты().Получить("a"), "атрибут списка").Равно(Неопределено);
	Ожидаем.Что(Ресурс.Атрибуты().Получить("b"), "остальные атрибуты списка").Равно(Неопределено);
	Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name"), "атрибут из attributes").Равно("my-service");
	Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "attributes_list"), "ошибка в логе").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СоздатьРесурсАтрибутыПриоритетнееСпискаАтрибутов() Экспорт

	// Дано - один ключ в attributes и в attributes_list (схема декларативной конфигурации:
	// записи attributes_list имеют меньший приоритет, чем записи attributes)
	КонфигРесурса = Новый ОтелКонфигурацияРесурса();
	КонфигРесурса.Атрибуты.Добавить(Новый Структура("Имя, Значение", "env", "из-attributes"));
	КонфигРесурса.СписокАтрибутов = "env=из-attributes_list,zone=us";

	// Когда
	Ресурс = ОтелКонфигурационнаяФабрика.СоздатьРесурс(КонфигРесурса);

	// Тогда
	Ожидаем.Что(Ресурс.Атрибуты().Получить("env")).Равно("из-attributes");
	Ожидаем.Что(Ресурс.Атрибуты().Получить("zone")).Равно("us");

КонецПроцедуры

&Тест
Процедура СоздатьРесурсБезКонфига() Экспорт

	// Когда
	Ресурс = ОтелКонфигурационнаяФабрика.СоздатьРесурс();

	// Тогда
	Ожидаем.Что(ТипЗнч(Ресурс)).Равно(Тип("ОтелРесурс"));

КонецПроцедуры

&Тест
Процедура РесурсФайловойКонфигурацииНеЧитаетПеременныеОкружения() Экспорт

	// Дано - при OTEL_CONFIG_FILE остальные переменные окружения игнорируются
	Модель = НоваяМодель();
	Модель.Отключен = Истина;
	УстановитьПеременнуюСреды("OTEL_SERVICE_NAME", "from-env");
	УстановитьПеременнуюСреды("OTEL_RESOURCE_ATTRIBUTES", "leak=yes");
	Попытка
		// Когда - ресурс SDK и ресурс отключенного SDK
		Ресурс = ОтелКонфигурационнаяФабрика.СоздатьРесурс();
		РесурсНоопSdk = ОтелКонфигурационнаяФабрика.Создать(Модель).ПровайдерМетрик().Ресурс();
	Исключение
		СброситьПеременныеРесурса();
		ВызватьИсключение;
	КонецПопытки;
	СброситьПеременныеРесурса();

	// Тогда
	Ожидаем.Что(Ресурс.Атрибуты().Получить("service.name")).Равно("unknown_service:oscript");
	Ожидаем.Что(Ресурс.Атрибуты().Получить("leak")).Равно(Неопределено);
	Ожидаем.Что(РесурсНоопSdk.Атрибуты().Получить("service.name")).Равно("unknown_service:oscript");
	Ожидаем.Что(РесурсНоопSdk.Атрибуты().Получить("telemetry.sdk.name")).Равно("opentelemetry");

КонецПроцедуры

Процедура СброситьПеременныеРесурса()
	УстановитьПеременнуюСреды("OTEL_SERVICE_NAME", "");
	УстановитьПеременнуюСреды("OTEL_RESOURCE_ATTRIBUTES", "");
КонецПроцедуры

// ===== Провайдер трассировки =====

&Тест
Процедура СоздатьПровайдерТрассировкиСДефолтами() Экспорт

	// Дано
	Ресурс = Новый ОтелРесурс();
	КонфигПровайдера = ПровайдерТрассировкиСПроцессором();

	// Когда
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(
		Ресурс, КонфигПровайдера);

	// Тогда
	Ожидаем.Что(ТипЗнч(Провайдер)).Равно(Тип("ОтелПровайдерТрассировки"));
	// Сэмплер по умолчанию - parent_based
	Ожидаем.Что(Провайдер.Сэмплер().Описание()).Равно(
		ОписаниеНаОсновеРодителя("AlwaysOnSampler"));

КонецПроцедуры

&Тест
Процедура СоздатьПровайдерТрассировкиСAlwaysOnСэмплером() Экспорт

	// Дано
	Ресурс = Новый ОтелРесурс();
	КонфигПровайдера = ПровайдерТрассировкиСПроцессором();
	КонфигСэмплера = Новый ОтелКонфигурацияСэмплера();
	КонфигСэмплера.Тип = "always_on";
	КонфигПровайдера.Сэмплер = КонфигСэмплера;

	// Когда
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(
		Ресурс, КонфигПровайдера);

	// Тогда
	Ожидаем.Что(Провайдер.Сэмплер().Описание()).Равно("AlwaysOnSampler");

КонецПроцедуры

