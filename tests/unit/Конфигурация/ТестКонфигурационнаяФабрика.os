&Тест
Процедура КонсольныйЭкспортерМетрикЗадаетВременнуюАгрегациюИГистограммы() Экспорт

	// Дано
	КонфигЭкспортера = Новый ОтелКонфигурацияКонсольногоЭкспортера();
	КонфигЭкспортера.ПредпочтениеВременнойАгрегации = "delta";
	КонфигЭкспортера.АгрегацияГистограммПоУмолчанию = "base2_exponential_bucket_histogram";

	// Когда
	Провайдер = ПровайдерСЭкспортером("metrics", КонфигЭкспортера);
	Читатель = Провайдер.ЧитателиМетрик()[0];
	Провайдер.Закрыть();

	// Тогда
	Ожидаем.Что(Читатель.ВременнаяАгрегацияДляВида("Counter")).Равно(ОтелВременнаяАгрегация.Дельта());
	Ожидаем.Что(Читатель.АгрегацияГистограммПоУмолчанию()).Равно("base2_exponential_bucket_histogram");

КонецПроцедуры

