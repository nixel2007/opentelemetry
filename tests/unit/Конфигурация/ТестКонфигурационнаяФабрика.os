// Схема файла конфигурации: cardinality_limits периодического читателя - лимит мощности по видам
// инструментов; вид без своего лимита берет default, без default - 2000

&Тест
Процедура ЛимитыМощностиЧитателяПоВидамИнструментов() Экспорт

	// Дано
	КонфигПровайдера = ПровайдерМетрикСЧитателем();
	ЛимитыМощности = Новый ОтелКонфигурацияЛимитовМощности();
	ЛимитыМощности.ПоУмолчанию = 100;
	ЛимитыМощности.Счетчик = 1;
	ЛимитыМощности.РеверсивныйСчетчик = 2;
	ЛимитыМощности.Гистограмма = 3;
	ЛимитыМощности.Датчик = 4;
	ЛимитыМощности.НаблюдаемыйСчетчик = 5;
	ЛимитыМощности.НаблюдаемыйРеверсивныйСчетчик = 6;
	КонфигПровайдера.Читатели[0].ЛимитыМощности = ЛимитыМощности;

	// Когда
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерМетрик(Новый ОтелРесурс(), КонфигПровайдера);
	Читатель = Провайдер.ЧитателиМетрик()[0];
	Провайдер.Закрыть();

	// Тогда
	Ожидаем.Что(Читатель.ЛимитМощности()).Равно(100);
	Ожидаем.Что(Читатель.ЛимитМощностиДляВида("Counter")).Равно(1);
	Ожидаем.Что(Читатель.ЛимитМощностиДляВида("UpDownCounter")).Равно(2);
	Ожидаем.Что(Читатель.ЛимитМощностиДляВида("Histogram")).Равно(3);
	Ожидаем.Что(Читатель.ЛимитМощностиДляВида("Gauge")).Равно(4);
	Ожидаем.Что(Читатель.ЛимитМощностиДляВида("ObservableCounter")).Равно(5);
	Ожидаем.Что(Читатель.ЛимитМощностиДляВида("ObservableUpDownCounter")).Равно(6);
	Ожидаем.Что(Читатель.ЛимитМощностиДляВида("ObservableGauge")).Равно(100);

КонецПроцедуры

&Тест
Процедура ЛимитМощностиЧитателяПоУмолчанию2000() Экспорт

	// Дано - читатель без cardinality_limits и читатель с cardinality_limits, где default - null
	КонфигПровайдера = ПровайдерМетрикСЧитателем();
	КонфигЧитателя = Новый ОтелКонфигурацияПериодическогоЧитателя();
	КонфигЧитателя.Экспортер = ЭкспортерOtlpHttp("metrics");
	КонфигЧитателя.ЛимитыМощности = Новый ОтелКонфигурацияЛимитовМощности();
	КонфигЧитателя.ЛимитыМощности.ПоУмолчанию = Неопределено;
	КонфигЧитателя.ЛимитыМощности.Счетчик = 7;
	КонфигПровайдера.Читатели.Добавить(КонфигЧитателя);

	// Когда
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерМетрик(Новый ОтелРесурс(), КонфигПровайдера);
	Читатели = Провайдер.ЧитателиМетрик();
	Провайдер.Закрыть();

	// Тогда
	Ожидаем.Что(Читатели[0].ЛимитМощностиДляВида("Histogram")).Равно(2000);
	Ожидаем.Что(Читатели[1].ЛимитМощности()).Равно(2000);
	Ожидаем.Что(Читатели[1].ЛимитМощностиДляВида("Histogram")).Равно(2000);
	Ожидаем.Что(Читатели[1].ЛимитМощностиДляВида("Counter")).Равно(7);

КонецПроцедуры

// ===== Представления (View) =====

// Схема файла конфигурации: meter_provider.views - представления провайдера метрик. Селектор выбирает
// инструменты, поток задает имя, описание, агрегацию, лимит мощности и ключи атрибутов потока

&Тест
Процедура ПредставлениеИзКонфигурацииЗадаетПотокМетрики() Экспорт

	// Дано - гистограмма переименована, с явными границами без min и max, с фильтром атрибутов
	КонфигПровайдера = ПровайдерМетрикСЧитателем();
	Представление = Новый ОтелКонфигурацияПредставления();
	Представление.Селектор.ИмяИнструмента = "http.server.duration";
	Представление.Селектор.ТипИнструмента = "histogram";
	Представление.Поток.Имя = "http.duration";
	Представление.Поток.Описание = "Длительность";
	Представление.Поток.Агрегация = Новый ОтелКонфигурацияАгрегации();
	Представление.Поток.Агрегация.Тип = "explicit_bucket_histogram";
	Границы = Новый Массив();
	Границы.Добавить(1);
	Границы.Добавить(10);
	Представление.Поток.Агрегация.Границы = Границы;
	Представление.Поток.Агрегация.ЗаписыватьМинМакс = Ложь;
	Представление.Поток.КлючиАтрибутов = Новый ОтелКонфигурацияКлючейАтрибутов();
	Представление.Поток.КлючиАтрибутов.Включенные = СтрРазделить("http.*", ",");
	Представление.Поток.КлючиАтрибутов.Исключенные = СтрРазделить("http.secret", ",");
	КонфигПровайдера.Представления.Добавить(Представление);
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерМетрик(Новый ОтелРесурс(), КонфигПровайдера);
	Метр = Провайдер.ПолучитьМетр("http");
	Атрибуты = Новый ОтелАтрибуты();
	Атрибуты.Установить("http.method", "GET");
	Атрибуты.Установить("http.secret", "x");
	Атрибуты.Установить("user.id", "u1");
	Метр.СоздатьГистограмму("http.server.duration").Записать(5, Атрибуты);

	// Когда
	Данные = Метр.СобратьДляЧитателя(Провайдер.ЧитателиМетрик()[0]);
	Провайдер.Закрыть();

	// Тогда
	Ожидаем.Что(Данные).ИмеетДлину(1);
	Ожидаем.Что(Данные[0].Имя()).Равно("http.duration");
	Ожидаем.Что(Данные[0].Описание()).Равно("Длительность");
	Точка = Данные[0].ТочкиДанных()[0];
	Ожидаем.Что(Точка.Получить("explicitBounds")).ИмеетДлину(2);
	Ожидаем.Что(Точка.Получить("min")).Равно(Неопределено);
	Ожидаем.Что(Точка.Получить("max")).Равно(Неопределено);
	АтрибутыТочки = Точка.Получить("attributes");
	Ожидаем.Что(АтрибутыТочки).ИмеетДлину(1);
	Ожидаем.Что(АтрибутыТочки[0].Получить("key")).Равно("http.method");

КонецПроцедуры

&Тест
Процедура ПредставлениеСЭкспоненциальнойГистограммойИЛимитомМощности() Экспорт

	// Дано
	КонфигПровайдера = ПровайдерМетрикСЧитателем();
	Представление = Новый ОтелКонфигурацияПредставления();
	Представление.Селектор.ТипИнструмента = "histogram";
	Представление.Поток.Агрегация = Новый ОтелКонфигурацияАгрегации();
	Представление.Поток.Агрегация.Тип = "base2_exponential_bucket_histogram";
	Представление.Поток.Агрегация.МаксШкала = 5;
	Представление.Поток.Агрегация.ЗаписыватьМинМакс = Ложь;
	Представление.Поток.ЛимитМощностиАгрегации = 2;
	КонфигПровайдера.Представления.Добавить(Представление);
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерМетрик(Новый ОтелРесурс(), КонфигПровайдера);
	Метр = Провайдер.ПолучитьМетр("db");
	Гистограмма = Метр.СоздатьГистограмму("db.duration");
	Для Каждого Таблица Из СтрРазделить("a,b,c,d", ",") Цикл
		Атрибуты = Новый ОтелАтрибуты();
		Атрибуты.Установить("table", Таблица);
		Гистограмма.Записать(3, Атрибуты);
	КонецЦикла;

	// Когда
	Данные = Метр.СобратьДляЧитателя(Провайдер.ЧитателиМетрик()[0]);
	Провайдер.Закрыть();

	// Тогда - лимит 2: две серии и серия переполнения; шкала одного значения - максимальная
	Ожидаем.Что(Данные[0].ТипМетрики()).Равно(ОтелТипМетрики.ЭкспоненциальнаяГистограмма());
	Точки = Данные[0].ТочкиДанных();
	Ожидаем.Что(Точки).ИмеетДлину(3);
	Ожидаем.Что(Точки[0].Получить("scale")).Равно(5);
	Ожидаем.Что(Точки[0].Получить("min")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СелекторПредставленияИзКонфигурации() Экспорт

	// Дано
	КонфигПровайдера = ПровайдерМетрикСЧитателем();
	Представление = Новый ОтелКонфигурацияПредставления();
	Селектор = Представление.Селектор;
	Селектор.ИмяИнструмента = "requests";
	Селектор.ТипИнструмента = "counter";
	Селектор.Единица = "1";
	Селектор.ИмяМетра = "lib";
	Селектор.ВерсияМетра = "1.0.0";
	Селектор.АдресСхемыМетра = "https://opentelemetry.io/schemas/1.26.0";
	КонфигПровайдера.Представления.Добавить(Представление);

	// Когда
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерМетрик(Новый ОтелРесурс(), КонфигПровайдера);
	Представления = Провайдер.ПолучитьПредставления();
	Провайдер.Закрыть();

	// Тогда
	Ожидаем.Что(Представления).ИмеетДлину(1);
	СелекторSdk = Представления[0].Получить("Селектор");
	Ожидаем.Что(СелекторSdk.Имя()).Равно("requests");
	Ожидаем.Что(СелекторSdk.ТипИнструмента()).Равно("Counter");
	Ожидаем.Что(СелекторSdk.Единица()).Равно("1");
	Ожидаем.Что(СелекторSdk.ИмяМетра()).Равно("lib");
	Ожидаем.Что(СелекторSdk.ВерсияМетра()).Равно("1.0.0");
	Ожидаем.Что(СелекторSdk.АдресСхемыМетра()).Равно("https://opentelemetry.io/schemas/1.26.0");
	ПредставлениеSdk = Представления[0].Получить("Представление");
	Ожидаем.Что(ПредставлениеSdk.НовоеИмя()).Равно(Неопределено);
	Ожидаем.Что(ПредставлениеSdk.Агрегация()).Равно(Неопределено);
	Ожидаем.Что(ПредставлениеSdk.РазрешенныеКлючиАтрибутов()).Равно(Неопределено);
	Ожидаем.Что(ПредставлениеSdk.ИсключенныеКлючиАтрибутов()).Равно(Неопределено);
	Ожидаем.Что(ПредставлениеSdk.ЛимитМощностиАгрегации()).Равно(Неопределено);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("counter|Counter")
&ИсточникЗначение("up_down_counter|UpDownCounter")
&ИсточникЗначение("histogram|Histogram")
&ИсточникЗначение("gauge|Gauge")
&ИсточникЗначение("observable_counter|ObservableCounter")
&ИсточникЗначение("observable_up_down_counter|ObservableUpDownCounter")
&ИсточникЗначение("observable_gauge|ObservableGauge")
Процедура ТипИнструментаСелектораПредставления(Случай) Экспорт

	// Дано
	Части = СтрРазделить(Случай, "|");
	КонфигПровайдера = ПровайдерМетрикСЧитателем();
	Представление = Новый ОтелКонфигурацияПредставления();
	Представление.Селектор.ТипИнструмента = Части[0];
	КонфигПровайдера.Представления.Добавить(Представление);

	// Когда
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерМетрик(Новый ОтелРесурс(), КонфигПровайдера);
	СелекторSdk = Провайдер.ПолучитьПредставления()[0].Получить("Селектор");
	Провайдер.Закрыть();

	// Тогда
	Ожидаем.Что(СелекторSdk.ТипИнструмента()).Равно(Части[1]);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("default")
&ИсточникЗначение("drop")
&ИсточникЗначение("sum")
&ИсточникЗначение("last_value")
Процедура АгрегацияПредставленияБезПараметров(ТипАгрегации) Экспорт

	// Дано
	КонфигПровайдера = ПровайдерМетрикСЧитателем();
	Представление = Новый ОтелКонфигурацияПредставления();
	Представление.Поток.Агрегация = Новый ОтелКонфигурацияАгрегации();
	Представление.Поток.Агрегация.Тип = ТипАгрегации;
	КонфигПровайдера.Представления.Добавить(Представление);

	// Когда
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерМетрик(Новый ОтелРесурс(), КонфигПровайдера);
	ПредставлениеSdk = Провайдер.ПолучитьПредставления()[0].Получить("Представление");
	Провайдер.Закрыть();

	// Тогда - агрегация ОтелАгрегация с тем же именем
	Ожидаем.Что(ПредставлениеSdk.Агрегация()).Равно(ТипАгрегации);

КонецПроцедуры

