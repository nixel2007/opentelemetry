КонецПроцедуры

// Ошибка конфигурации второго процессора или читателя не оставляет работающим первый: его фоновый
// экспорт и транспорт закрываются. Закрытие видно по отладочной записи транспорта

&ПараметризованныйТест
&ИсточникЗначение("traces")
&ИсточникЗначение("logs")
&ИсточникЗначение("metrics")
Процедура ОшибкаКомпонентаЗакрываетСозданныеКомпоненты(Сигнал) Экспорт

	// Дано - первый компонент с экспортером otlp_http, второй - которого нет в SDK
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигЭкспортера.Адрес = "http://localhost:1/v1/" + Сигнал;
	Если Сигнал = "metrics" Тогда
		КонфигЧитателя = Новый ОтелКонфигурацияПериодическогоЧитателя();
		КонфигЧитателя.Экспортер = КонфигЭкспортера;
		КонфигПровайдера = Новый ОтелКонфигурацияПровайдераМетрик();
		КонфигПровайдера.Читатели.Добавить(КонфигЧитателя);
		КонфигПровайдера.Читатели.Добавить(PullЧитатель());
	Иначе
		КонфигПроцессора = Новый ОтелКонфигурацияПакетногоПроцессора();
		КонфигПроцессора.Экспортер = КонфигЭкспортера;
		Если Сигнал = "traces" Тогда
			КонфигПровайдера = Новый ОтелКонфигурацияПровайдераТрассировки();
		Иначе
			КонфигПровайдера = Новый ОтелКонфигурацияПровайдераЛогирования();
		КонецЕсли;
		КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора);
		КонфигПровайдера.Процессоры.Добавить(КомпонентКонфигурации("my_processor"));
	КонецЕсли;
	ИмяЛога = "oscript.lib.opentelemetry.transport";
	Аппендер = СоздатьТестовыйАппендер();
	Логирование.ПолучитьЛог(ИмяЛога).ДобавитьСпособВывода(Аппендер, УровниЛога.Отладка);

	// Когда
	ТекстОшибки = "";
	Попытка
		Если Сигнал = "traces" Тогда
			ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(Новый ОтелРесурс(), КонфигПровайдера);
		ИначеЕсли Сигнал = "logs" Тогда
			ОтелКонфигурационнаяФабрика.СоздатьПровайдерЛогирования(Новый ОтелРесурс(), КонфигПровайдера);
		Иначе
			ОтелКонфигурационнаяФабрика.СоздатьПровайдерМетрик(Новый ОтелРесурс(), КонфигПровайдера);
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Тогда
	Логирование.ПолучитьЛог(ИмяЛога).УдалитьСпособВывода(Аппендер);
	Ожидаем.Что(ТекстОшибки).Содержит("не поддерживается");
	Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "транспорт закрыт"), Сигнал).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура PullЧитательОшибка() Экспорт

	// Дано - pull-читатель: встроенного pull-экспортера в SDK нет
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераМетрик();
	КонфигПровайдера.Читатели.Добавить(PullЧитатель());

	// Когда
	ТекстОшибки = "";
	Попытка
		ОтелКонфигурационнаяФабрика.СоздатьПровайдерМетрик(Новый ОтелРесурс(), КонфигПровайдера).Закрыть();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("Читатель метрик ""pull"" не поддерживается");

КонецПроцедуры

