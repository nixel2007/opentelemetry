// Функции, которые строят часть SDK из части модели, проверяют свою часть по схеме так же, как Создать
// всю модель: путь в ошибке - путь части в модели

&ПараметризованныйТест
&ИсточникЗначение("СоздатьРесурс", "/resource/attributes/0/type")
&ИсточникЗначение("СоздатьПровайдерТрассировки", "/tracer_provider/processors/0/batch/schedule_delay")
&ИсточникЗначение("СоздатьПровайдерТрассировки.limits", "/attribute_limits/attribute_count_limit")
&ИсточникЗначение("СоздатьПровайдерЛогирования", "/logger_provider/processors/0/batch/max_queue_size")
&ИсточникЗначение("СоздатьПровайдерЛогирования.limits", "/attribute_limits/attribute_count_limit")
&ИсточникЗначение("СоздатьПровайдерМетрик", "/meter_provider/exemplar_filter")
&ИсточникЗначение("СоздатьПропагаторы", "/propagator/composite/0")
Процедура ФункцияЧастиМоделиПроверяетЧасть(ИмяФункции, Путь) Экспорт

	// Дано
	Ресурс = Новый ОтелРесурс();
	ГлобальныеЛимиты = Новый ОтелКонфигурацияЛимитовАтрибутов();
	ГлобальныеЛимиты.МаксКоличествоАтрибутов = -5;

	// Когда
	ТекстОшибки = "";
	Попытка
		Если ИмяФункции = "СоздатьРесурс" Тогда
			ОтелКонфигурационнаяФабрика.СоздатьРесурс(МодельСНарушением("attribute_type").Ресурс);
		ИначеЕсли ИмяФункции = "СоздатьПровайдерТрассировки" Тогда
			ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(Ресурс,
				МодельСНарушением("schedule_delay").ПровайдерТрассировки).Закрыть();
		ИначеЕсли ИмяФункции = "СоздатьПровайдерТрассировки.limits" Тогда
			ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(Ресурс,
				ПровайдерТрассировкиСПроцессором(), ГлобальныеЛимиты).Закрыть();
		ИначеЕсли ИмяФункции = "СоздатьПровайдерЛогирования" Тогда
			ОтелКонфигурационнаяФабрика.СоздатьПровайдерЛогирования(Ресурс,
				МодельСНарушением("max_queue_size").ПровайдерЛогирования).Закрыть();
		ИначеЕсли ИмяФункции = "СоздатьПровайдерЛогирования.limits" Тогда
			ОтелКонфигурационнаяФабрика.СоздатьПровайдерЛогирования(Ресурс,
				ПровайдерЛогированияСПроцессором(), ГлобальныеЛимиты).Закрыть();
		ИначеЕсли ИмяФункции = "СоздатьПровайдерМетрик" Тогда
			ОтелКонфигурационнаяФабрика.СоздатьПровайдерМетрик(Ресурс,
				МодельСНарушением("exemplar_filter").ПровайдерМетрик).Закрыть();
		Иначе
			КонфигПропагатора = Новый ОтелКонфигурацияПропагатора();
			КонфигПропагатора.Составной.Добавить("tracecontext");
			ОтелКонфигурационнаяФабрика.СоздатьПропагаторы(КонфигПропагатора);
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("Модель конфигурации не соответствует схеме opentelemetry-configuration");
	Ожидаем.Что(ТекстОшибки).Содержит(Путь + ": ");

КонецПроцедуры

// ===== Значения по описанию свойств схемы =====

// Configuration SDK, Create: значение, недопустимое по описанию свойства (description), - ошибка.
// Описание value атрибута ресурса: тип значения должен соответствовать type, без type - string

&ПараметризованныйТест
&ИсточникЗначение("string")
&ИсточникЗначение("без type")
&ИсточникЗначение("bool")
&ИсточникЗначение("int")
&ИсточникЗначение("double")
&ИсточникЗначение("double целым числом")
&ИсточникЗначение("string_array")
&ИсточникЗначение("bool_array")
&ИсточникЗначение("int_array")
&ИсточникЗначение("double_array")
Процедура АтрибутРесурсаСоЗначениемСвоегоТипа(Случай) Экспорт

	// Дано
	Запись = АтрибутРесурсаСлучая(Случай);
	КонфигРесурса = Новый ОтелКонфигурацияРесурса();
	КонфигРесурса.Атрибуты.Добавить(Запись);

	// Когда
	Ресурс = ОтелКонфигурационнаяФабрика.СоздатьРесурс(КонфигРесурса);

	// Тогда
	Ожидаем.Что(Ресурс.Атрибуты().Получить("attr")).Равно(Запись.Значение);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("string", "число")
&ИсточникЗначение("", "число")
&ИсточникЗначение("string", "массив строк")
&ИсточникЗначение("bool", "строка")
&ИсточникЗначение("int", "дробное число")
&ИсточникЗначение("int", "строка")
&ИсточникЗначение("double", "строка")
&ИсточникЗначение("string_array", "массив чисел")
&ИсточникЗначение("bool_array", "массив строк")
&ИсточникЗначение("int_array", "массив дробных чисел")
&ИсточникЗначение("double_array", "массив строк")
Процедура АтрибутРесурсаНеСвоегоТипаОшибка(ТипАтрибута, ВидЗначения) Экспорт

	// Дано - пустой тип: атрибут без type
	Если ТипАтрибута = "" Тогда
		Запись = Новый Структура("Имя, Значение", "attr", ЗначениеВида(ВидЗначения));
	Иначе
		Запись = Новый Структура("Имя, Значение, Тип", "attr", ЗначениеВида(ВидЗначения), ТипАтрибута);
	КонецЕсли;
	КонфигРесурса = Новый ОтелКонфигурацияРесурса();
	КонфигРесурса.Атрибуты.Добавить(Запись);

	// Когда
	ТекстОшибки = "";
	Попытка
		ОтелКонфигурационнаяФабрика.СоздатьРесурс(КонфигРесурса);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Тогда
	ОжидаемыйТип = ?(ТипАтрибута = "", "string", ТипАтрибута);
	Ожидаем.Что(ТекстОшибки).Содержит("Атрибут ресурса ""attr"": значение не соответствует типу " + ОжидаемыйТип);

КонецПроцедуры

// Описание value атрибута ресурса: значение null - запись пропускается, атрибут из attributes_list с тем же
// именем остается

&Тест
Процедура АтрибутРесурсаСоЗначениемNullПропускается() Экспорт

	// Дано
	КонфигРесурса = Новый ОтелКонфигурацияРесурса();
	КонфигРесурса.СписокАтрибутов = "env=prod";
	КонфигРесурса.Атрибуты.Добавить(Новый Структура("Имя, Значение", "env", Неопределено));
	КонфигРесурса.Атрибуты.Добавить(Новый Структура("Имя, Значение, Тип", "zone", Неопределено, "string"));

	// Когда
	Ресурс = ОтелКонфигурационнаяФабрика.СоздатьРесурс(КонфигРесурса);

	// Тогда
	Атрибуты = Ресурс.Атрибуты().ВСоответствие();
	Ожидаем.Что(Атрибуты.Получить("env")).Равно("prod");
	ЕстьZone = Ложь;
	Для Каждого КлючИЗначение Из Атрибуты Цикл
		ЕстьZone = ЕстьZone ИЛИ КлючИЗначение.Ключ = "zone";
	КонецЦикла;
	Ожидаем.Что(ЕстьZone, "атрибут со значением null").ЭтоЛожь();

КонецПроцедуры

// Описание attributes_list: строка в формате OTEL_RESOURCE_ATTRIBUTES. Строка с ошибкой разбора - ошибка
// создания, а не значение, отброшенное с записью в лог, как у переменной окружения

&ПараметризованныйТест
&ИсточникЗначение("a=%ZZ,b=1")
&ИсточникЗначение("a=1,malformed_no_equals,b=1")
Процедура СписокАтрибутовСОшибкойРазбораОшибка(СписокАтрибутов) Экспорт

	// Дано
	КонфигРесурса = Новый ОтелКонфигурацияРесурса();
	КонфигРесурса.СписокАтрибутов = СписокАтрибутов;

	// Когда
	ТекстОшибки = "";
	Попытка
		ОтелКонфигурационнаяФабрика.СоздатьРесурс(КонфигРесурса);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("Некорректный resource.attributes_list");

КонецПроцедуры

// Описание headers_list: строка в формате OTEL_EXPORTER_OTLP_HEADERS. Строка с ошибкой разбора - ошибка
// создания

&ПараметризованныйТест
&ИсточникЗначение("otlp_http", "X-Header")
&ИсточникЗначение("otlp_http", "=value")
&ИсточникЗначение("otlp_grpc", "a=%ZZ")
Процедура СписокЗаголовковСОшибкойРазбораОшибка(ВидЭкспортера, СписокЗаголовков) Экспорт

	// Дано
	КонфигЭкспортера = ЭкспортерВида(ВидЭкспортера);
	КонфигЭкспортера.СписокЗаголовков = СписокЗаголовков;

	// Когда
	ТекстОшибки = ОшибкаСозданияПровайдераТрассировкиСЭкспортером(КонфигЭкспортера);

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("Экспортер " + ВидЭкспортера + ": некорректный headers_list");

КонецПроцедуры

// Описание compression: известные значения gzip и none, другие - если SDK их поддерживает. SDK
// поддерживает только gzip и none: другое значение, в том числе в другом регистре, - ошибка

&ПараметризованныйТест
&ИсточникЗначение("otlp_http", "zstd")
&ИсточникЗначение("otlp_http", "GZIP")
&ИсточникЗначение("otlp_grpc", "zstd")
Процедура НеподдерживаемоеСжатиеОшибка(ВидЭкспортера, Сжатие) Экспорт

	// Дано
	КонфигЭкспортера = ЭкспортерВида(ВидЭкспортера);
	КонфигЭкспортера.Сжатие = Сжатие;

	// Когда
	ТекстОшибки = ОшибкаСозданияПровайдераТрассировкиСЭкспортером(КонфигЭкспортера);

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит(
		"Экспортер " + ВидЭкспортера + ": сжатие """ + Сжатие + """ не поддерживается. Поддерживаются: gzip, none");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("otlp_http")
&ИсточникЗначение("otlp_grpc")
Процедура СжатиеNoneБезСжатия(ВидЭкспортера) Экспорт

	// Дано
	КонфигЭкспортера = ЭкспортерВида(ВидЭкспортера);
	КонфигЭкспортера.Сжатие = "none";

	// Когда
	ТекстОшибки = ОшибкаСозданияПровайдераТрассировкиСЭкспортером(КонфигЭкспортера);

	// Тогда
	Ожидаем.Что(ТекстОшибки).Равно("");

КонецПроцедуры

// Описание endpoint: адрес otlp_http - URL со схемой http или https. Адрес otlp_grpc - URL со схемой http
// или https или адрес без схемы: о защищенности такого соединения сообщает tls.insecure

&ПараметризованныйТест
&ИсточникЗначение("otlp_http", "localhost:4318/v1/traces")
&ИсточникЗначение("otlp_http", "ftp://localhost/v1/traces")
&ИсточникЗначение("otlp_grpc", "ftp://localhost:4317")
&ИсточникЗначение("otlp_grpc", "unix:///tmp/otel.sock")
Процедура АдресЭкспортераСНеподдерживаемойСхемойОшибка(ВидЭкспортера, Адрес) Экспорт

	// Дано
	КонфигЭкспортера = ЭкспортерВида(ВидЭкспортера);
	КонфигЭкспортера.Адрес = Адрес;

	// Когда
	ТекстОшибки = ОшибкаСозданияПровайдераТрассировкиСЭкспортером(КонфигЭкспортера);

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("Экспортер " + ВидЭкспортера + ": endpoint """ + Адрес + """");
	Ожидаем.Что(ТекстОшибки).Содержит("схемой http или https");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("otlp_http", "HTTP://localhost:1/v1/traces")
&ИсточникЗначение("otlp_http", "https://localhost:1/v1/traces")
&ИсточникЗначение("otlp_grpc", "localhost:1")
&ИсточникЗначение("otlp_grpc", "https://localhost:1")
Процедура АдресЭкспортераСДопустимойСхемой(ВидЭкспортера, Адрес) Экспорт

	// Дано
	КонфигЭкспортера = ЭкспортерВида(ВидЭкспортера);
	КонфигЭкспортера.Адрес = Адрес;

	// Когда
	ТекстОшибки = ОшибкаСозданияПровайдераТрассировкиСЭкспортером(КонфигЭкспортера);

	// Тогда
	Ожидаем.Что(ТекстОшибки).Равно("");

КонецПроцедуры

// ===== Свойство со значением null =====

// Configuration SDK, Create: свойство со значением null получает значение по умолчанию. В модели из кода
// null - Неопределено: модель с Неопределено в свойстве со значением по умолчанию проходит проверку схемы и
// дает SDK

&ПараметризованныйТест
&ИсточникЗначение("disabled")
&ИсточникЗначение("resource.attributes")
&ИсточникЗначение("resource.attributes_list")
&ИсточникЗначение("resource.schema_url")
&ИсточникЗначение("propagator.composite")
&ИсточникЗначение("propagator.composite_list")
&ИсточникЗначение("batch.schedule_delay")
&ИсточникЗначение("batch.export_timeout")
&ИсточникЗначение("batch.max_queue_size")
&ИсточникЗначение("batch.max_export_batch_size")
&ИсточникЗначение("otlp.endpoint")
&ИсточникЗначение("otlp.compression")
&ИсточникЗначение("otlp.timeout")
&ИсточникЗначение("otlp.headers")
&ИсточникЗначение("otlp.headers_list")
&ИсточникЗначение("otlp.max_request_size")
&ИсточникЗначение("otlp.max_response_size")
&ИсточникЗначение("otlp.encoding")
&ИсточникЗначение("otlp.tls")
&ИсточникЗначение("span_limits")
&ИсточникЗначение("ratio")
&ИсточникЗначение("periodic.interval")
&ИсточникЗначение("periodic.timeout")
&ИсточникЗначение("periodic.producers")
&ИсточникЗначение("periodic.cardinality_limits.default")
&ИсточникЗначение("otlp.temporality_preference")
&ИсточникЗначение("otlp.default_histogram_aggregation")
&ИсточникЗначение("exemplar_filter")
&ИсточникЗначение("views")
&ИсточникЗначение("view.aggregation")
&ИсточникЗначение("view.attribute_keys")
Процедура СвойствоСоЗначениемNullПолучаетЗначениеПоУмолчанию(Случай) Экспорт

	// Дано
	Модель = МодельСоЗначениемNull(Случай);

	// Когда
	ТекстОшибки = ОшибкаСоздания(Модель);

	// Тогда
	Ожидаем.Что(ТекстОшибки, Случай).Равно("");

КонецПроцедуры

&Тест
Процедура МодельСоЗначениемNullНеИзменяется() Экспорт

	// Дано
	Модель = МодельСоЗначениемNull("periodic.interval");

	// Когда
	ОшибкаСоздания(Модель);

	// Тогда - значения по умолчанию фабрика берет у копии модели
	Ожидаем.Что(Модель.ПровайдерМетрик.Читатели[0].Интервал).Равно(Неопределено);

КонецПроцедуры

// ===== Процессоры спанов: граничные случаи =====

&Тест
Процедура ДваПроцессораСпановОбъединяютсяВКомпозитный() Экспорт

	// Дано - два процессора с экспортерами → СоздатьПроцессорыСпанов вернёт
	//        ОтелКомпозитныйПроцессорСпанов → строка 268
	Модель = НоваяМодель();
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераТрассировки();
	КонфигПроцессора1 = Новый ОтелКонфигурацияПакетногоПроцессора();
	КонфигПроцессора1.Экспортер = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигПроцессора2 = Новый ОтелКонфигурацияПакетногоПроцессора();
	КонфигПроцессора2.Экспортер = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора1);
	КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора2);
	Модель.ПровайдерТрассировки = КонфигПровайдера;
	Модель.ПровайдерЛогирования = ПровайдерЛогированияСПроцессором();
	Модель.ПровайдерМетрик = ПровайдерМетрикСЧитателем();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Ожидаем.Что(ТипЗнч(Sdk)).Равно(Тип("ОтелSdk"));

КонецПроцедуры

// ===== Процессоры логов: граничные случаи =====

&Тест
Процедура ДваПроцессораЛоговОбъединяютсяВКомпозитный() Экспорт

	// Дано - два процессора логов → строка 321
	Модель = НоваяМодель();
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераЛогирования();
	КонфигПроцессора1 = Новый ОтелКонфигурацияПакетногоПроцессора();
	КонфигПроцессора1.Экспортер = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигПроцессора2 = Новый ОтелКонфигурацияПакетногоПроцессора();
	КонфигПроцессора2.Экспортер = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора1);
	КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора2);
	Модель.ПровайдерЛогирования = КонфигПровайдера;
	Модель.ПровайдерТрассировки = ПровайдерТрассировкиСПроцессором();
	Модель.ПровайдерМетрик = ПровайдерМетрикСЧитателем();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Ожидаем.Что(ТипЗнч(Sdk)).Равно(Тип("ОтелSdk"));

КонецПроцедуры

// ===== Фильтр экземпляров: граничные случаи =====

&Тест
Процедура ФильтрЭкземпляровПустаяСтрокаВозвращаетПоТрассировке() Экспорт

	Модель = НоваяМодель();
	КонфигПровайдера = ПровайдерМетрикСЧитателем();
	КонфигПровайдера.ФильтрЭкземпляров = "";
	Модель.ПровайдерМетрик = КонфигПровайдера;
	Модель.ПровайдерТрассировки = ПровайдерТрассировкиСПроцессором();
	Модель.ПровайдерЛогирования = ПровайдерЛогированияСПроцессором();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Ожидаем.Что(ТипЗнч(Sdk)).Равно(Тип("ОтелSdk"));

КонецПроцедуры

&Тест
Процедура ПровайдерЛогированияСГлобальнымиЛимитами() Экспорт

	// Дано - глобальные лимиты атрибутов без специфичных для провайдера (строки 484-485, 496-497)
	Модель = НоваяМодель();
	КонфигурацияГлобальныхЛимитов = Новый ОтелКонфигурацияЛимитовАтрибутов();
	КонфигурацияГлобальныхЛимитов.МаксКоличествоАтрибутов = 100;
	КонфигурацияГлобальныхЛимитов.МаксДлинаЗначенияАтрибута = 500;
	Модель.ЛимитыАтрибутов = КонфигурацияГлобальныхЛимитов;
	КонфигПровайдера = ПровайдерЛогированияСПроцессором();
	// КонфигПровайдера.Лимиты = Неопределено (по умолчанию) → используются глобальные лимиты
	Модель.ПровайдерЛогирования = КонфигПровайдера;
	Модель.ПровайдерТрассировки = ПровайдерТрассировкиСПроцессором();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Ожидаем.Что(ТипЗнч(Sdk)).Равно(Тип("ОтелSdk"));

КонецПроцедуры

// ===== Вспомогательные =====

// Возвращает модель с обязательным file_format и без секций.
Функция НоваяМодель()
	Модель = Новый ОтелКонфигурация();
	Модель.ФорматФайла = "1.0";
	Возврат Модель;
КонецФункции

// Возвращает модель со всеми секциями и одним значением, недопустимым по схеме: случай - имя свойства
// схемы. Пустой случай - модель без нарушений.
Функция МодельСНарушением(Случай)

	ПровайдерТрассировки = Новый ОтелКонфигурацияПровайдераТрассировки();
	ПроцессорСпанов = ПакетныйПроцессор("traces");
	ПровайдерТрассировки.Процессоры.Добавить(ПроцессорСпанов);
	ПровайдерТрассировки.Сэмплер = КонфигСэмплераТипа("trace_id_ratio_based", 0.5);
	ПровайдерТрассировки.Лимиты = Новый ОтелКонфигурацияЛимитовСпана();
	ПровайдерЛогирования = Новый ОтелКонфигурацияПровайдераЛогирования();
	ПровайдерЛогирования.Процессоры.Добавить(ПакетныйПроцессор("logs"));

	Модель = НоваяМодель();
	Модель.Ресурс = Новый ОтелКонфигурацияРесурса();
	Модель.Ресурс.Атрибуты.Добавить(Новый Структура("Имя, Значение", "service.name", "schema-test"));
	Модель.ЛимитыАтрибутов = Новый ОтелКонфигурацияЛимитовАтрибутов();
	Модель.Пропагатор = Новый ОтелКонфигурацияПропагатора();
	Модель.Пропагатор.Составной.Добавить(КомпонентКонфигурации("tracecontext"));
	Модель.ПровайдерТрассировки = ПровайдерТрассировки;
	Модель.ПровайдерЛогирования = ПровайдерЛогирования;
	Модель.ПровайдерМетрик = ПровайдерМетрикСЧитателем();

	Если Случай = "" Тогда
		Возврат Модель;
	КонецЕсли;

	// Нарушение в провайдере трассировки
	Если Случай = "schedule_delay" Тогда
		ПроцессорСпанов.ЗадержкаОтправки = -1;
	ИначеЕсли Случай = "timeout" Тогда
		ПроцессорСпанов.Экспортер.Таймаут = "5000";
	ИначеЕсли Случай = "span_exporter_temporality" Тогда
		ПроцессорСпанов.Экспортер.ПредпочтениеВременнойАгрегации = "delta";
	ИначеЕсли Случай = "console_span_temporality" Тогда
		ПроцессорСпанов.Экспортер = Новый ОтелКонфигурацияКонсольногоЭкспортера();
		ПроцессорСпанов.Экспортер.ПредпочтениеВременнойАгрегации = "delta";
	ИначеЕсли Случай = "max_request_size" Тогда
		ПроцессорСпанов.Экспортер.МаксРазмерЗапроса = -1;
	ИначеЕсли Случай = "encoding" Тогда
		ПроцессорСпанов.Экспортер.Кодирование = "JSON";
	ИначеЕсли Случай = "http_tls_insecure" Тогда
		ПроцессорСпанов.Экспортер.НастройкиTls = Новый ОтелНастройкиTls();
		ПроцессорСпанов.Экспортер.НастройкиTls.Insecure = Истина;
	ИначеЕсли Случай = "ratio" Тогда
		ПровайдерТрассировки.Сэмплер.Доля = 1.5;
	ИначеЕсли Случай = "event_count_limit" Тогда
		ПровайдерТрассировки.Лимиты.МаксСобытий = -1;
	ИначеЕсли Случай = "span_attribute_value_depth_limit" Тогда
		ПровайдерТрассировки.Лимиты.МаксГлубинаЗначенияАтрибута = 0;
	Иначе
		ВнестиНарушениеВнеТрассировки(Модель, Случай);
	КонецЕсли;

	Возврат Модель;

КонецФункции

Процедура ВнестиНарушениеВнеТрассировки(Модель, Случай)

	Читатель = Модель.ПровайдерМетрик.Читатели[0];
	Если Случай = "disabled" Тогда
		Модель.Отключен = "yes";
	ИначеЕсли Случай = "max_queue_size" Тогда
		Модель.ПровайдерЛогирования.Процессоры[0].МаксРазмерОчереди = 0;
	ИначеЕсли Случай = "limits_class" Тогда
		Модель.ПровайдерЛогирования.Лимиты = Новый ОтелКонфигурацияЛимитовСпана();
	ИначеЕсли Случай = "attribute_count_limit" Тогда
		Модель.ЛимитыАтрибутов.МаксКоличествоАтрибутов = -5;
	ИначеЕсли Случай = "attribute_value_depth_limit" Тогда
		Модель.ЛимитыАтрибутов.МаксГлубинаЗначенияАтрибута = 0;
	ИначеЕсли Случай = "attribute_type" Тогда
		Модель.Ресурс.Атрибуты.Вставить(0, Новый Структура("Имя, Значение, Тип", "port", 8080, "integer"));
	ИначеЕсли Случай = "interval" Тогда
		Читатель.Интервал = -1;
	ИначеЕсли Случай = "cardinality_limits" Тогда
		Читатель.ЛимитыМощности = Новый ОтелКонфигурацияЛимитовМощности();
		Читатель.ЛимитыМощности.Гистограмма = 0;
	ИначеЕсли Случай = "max_response_size" Тогда
		Читатель.Экспортер.МаксРазмерОтвета = 0;
	ИначеЕсли Случай = "exemplar_filter" Тогда
		Модель.ПровайдерМетрик.ФильтрЭкземпляров = "sometimes";
	ИначеЕсли Случай = "temporality_preference" Тогда
		Читатель.Экспортер.ПредпочтениеВременнойАгрегации = "DELTA";
	ИначеЕсли Случай = "default_histogram_aggregation" Тогда
		Читатель.Экспортер = Новый ОтелКонфигурацияЭкспортераOtlpGrpc();
		Читатель.Экспортер.АгрегацияГистограммПоУмолчанию = "exponential";
	ИначеЕсли СтрНачинаетсяС(Случай, "view_") Тогда
		ВнестиНарушениеПредставления(Модель, Случай);
	Иначе
		ВызватьИсключение "Неизвестный случай нарушения: " + Случай;
	КонецЕсли;

КонецПроцедуры

Процедура ВнестиНарушениеПредставления(Модель, Случай)

	Представление = Новый ОтелКонфигурацияПредставления();
	Представление.Селектор.ИмяИнструмента = "requests";
	Поток = Представление.Поток;
	Поток.Агрегация = Новый ОтелКонфигурацияАгрегации();
	Модель.ПровайдерМетрик.Представления.Добавить(Представление);
	Если Случай = "view_instrument_type" Тогда
		Представление.Селектор.ТипИнструмента = "Histogram";
	ИначеЕсли Случай = "view_max_scale" Тогда
		Поток.Агрегация.Тип = "base2_exponential_bucket_histogram";
		Поток.Агрегация.МаксШкала = 25;
	ИначеЕсли Случай = "view_aggregation_type" Тогда
		Поток.Агрегация.Тип = "histogram";
	ИначеЕсли Случай = "view_cardinality_limit" Тогда
		Поток.ЛимитМощностиАгрегации = 0;
	Иначе
		Поток.КлючиАтрибутов = Новый ОтелКонфигурацияКлючейАтрибутов();
		Поток.КлючиАтрибутов.Включенные = Новый Массив;
	КонецЕсли;

КонецПроцедуры

// Возвращает модель со всеми секциями, в которой одно свойство со значением по умолчанию равно Неопределено
// (null): случай - путь свойства схемы.
Функция МодельСоЗначениемNull(Случай)

	Модель = МодельСНарушением("");
	ПроцессорСпанов = Модель.ПровайдерТрассировки.Процессоры[0];
	Если СтрНачинаетсяС(Случай, "otlp.") Тогда
		ПроцессорСпанов.Экспортер.НастройкиTls = Новый ОтелНастройкиTls();
		ЗаменитьСвойствоЭкспортераНаNull(ПроцессорСпанов.Экспортер, Модель.ПровайдерМетрик.Читатели[0].Экспортер, Случай);
	ИначеЕсли СтрНачинаетсяС(Случай, "batch.") Тогда
		ИменаСвойств = Новый Соответствие;
		ИменаСвойств.Вставить("batch.schedule_delay", "ЗадержкаОтправки");
		ИменаСвойств.Вставить("batch.export_timeout", "ТаймаутЭкспорта");
		ИменаСвойств.Вставить("batch.max_queue_size", "МаксРазмерОчереди");
		ИменаСвойств.Вставить("batch.max_export_batch_size", "МаксРазмерПакета");
		ПроцессорСпанов[ИменаСвойств[Случай]] = Неопределено;
	ИначеЕсли СтрНачинаетсяС(Случай, "periodic.") Тогда
		ЗаменитьСвойствоЧитателяНаNull(Модель.ПровайдерМетрик.Читатели[0], Случай);
	Иначе
		ЗаменитьСвойствоМоделиНаNull(Модель, Случай);
	КонецЕсли;
	Возврат Модель;

КонецФункции

Процедура ЗаменитьСвойствоЭкспортераНаNull(ЭкспортерСпанов, ЭкспортерМетрик, Случай)

	ИменаСвойств = Новый Соответствие;
	ИменаСвойств.Вставить("otlp.endpoint", "Адрес");
	ИменаСвойств.Вставить("otlp.compression", "Сжатие");
	ИменаСвойств.Вставить("otlp.timeout", "Таймаут");
	ИменаСвойств.Вставить("otlp.headers", "Заголовки");
	ИменаСвойств.Вставить("otlp.headers_list", "СписокЗаголовков");
	ИменаСвойств.Вставить("otlp.max_request_size", "МаксРазмерЗапроса");
	ИменаСвойств.Вставить("otlp.max_response_size", "МаксРазмерОтвета");
	ИменаСвойств.Вставить("otlp.encoding", "Кодирование");
	ИменаСвойств.Вставить("otlp.temporality_preference", "ПредпочтениеВременнойАгрегации");
	ИменаСвойств.Вставить("otlp.default_histogram_aggregation", "АгрегацияГистограммПоУмолчанию");
	Если Случай = "otlp.tls" Тогда
		ЭкспортерСпанов.НастройкиTls.ФайлСертификата = Неопределено;
		ЭкспортерСпанов.НастройкиTls.Insecure = Неопределено;
	ИначеЕсли СтрНайти(Случай, "temporality") > 0 ИЛИ СтрНайти(Случай, "histogram") > 0 Тогда
		ЭкспортерМетрик[ИменаСвойств[Случай]] = Неопределено;
	Иначе
		ЭкспортерСпанов[ИменаСвойств[Случай]] = Неопределено;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаменитьСвойствоЧитателяНаNull(Читатель, Случай)

	Если Случай = "periodic.interval" Тогда
		Читатель.Интервал = Неопределено;
	ИначеЕсли Случай = "periodic.timeout" Тогда
		Читатель.Таймаут = Неопределено;
	ИначеЕсли Случай = "periodic.producers" Тогда
		Читатель.Продюсеры = Неопределено;
	Иначе
		Читатель.ЛимитыМощности = Новый ОтелКонфигурацияЛимитовМощности();
		Читатель.ЛимитыМощности.ПоУмолчанию = Неопределено;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаменитьСвойствоМоделиНаNull(Модель, Случай)

	Если Случай = "disabled" Тогда
		Модель.Отключен = Неопределено;
	ИначеЕсли Случай = "resource.attributes" Тогда
		Модель.Ресурс.Атрибуты = Неопределено;
	ИначеЕсли Случай = "resource.attributes_list" Тогда
		Модель.Ресурс.СписокАтрибутов = Неопределено;
	ИначеЕсли Случай = "resource.schema_url" Тогда
		Модель.Ресурс.АдресСхемы = Неопределено;
	ИначеЕсли Случай = "propagator.composite" Тогда
		Модель.Пропагатор.Составной = Неопределено;
	ИначеЕсли Случай = "propagator.composite_list" Тогда
		Модель.Пропагатор.СписокСоставного = Неопределено;
	ИначеЕсли Случай = "span_limits" Тогда
		Лимиты = Модель.ПровайдерТрассировки.Лимиты;
		Лимиты.МаксСобытий = Неопределено;
		Лимиты.МаксЛинков = Неопределено;
		Лимиты.МаксАтрибутовНаСобытие = Неопределено;
		Лимиты.МаксАтрибутовНаЛинк = Неопределено;
	ИначеЕсли Случай = "ratio" Тогда
		Модель.ПровайдерТрассировки.Сэмплер.Доля = Неопределено;
	ИначеЕсли СтрНачинаетсяС(Случай, "view") Тогда
		ЗаменитьСвойствоПредставленияНаNull(Модель.ПровайдерМетрик, Случай);
	Иначе
		Модель.ПровайдерМетрик.ФильтрЭкземпляров = Неопределено;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаменитьСвойствоПредставленияНаNull(ПровайдерМетрик, Случай)

	Если Случай = "views" Тогда
		ПровайдерМетрик.Представления = Неопределено;
		Возврат;
	КонецЕсли;
	Представление = Новый ОтелКонфигурацияПредставления();
	Представление.Селектор.ИмяИнструмента = "requests";
	ПровайдерМетрик.Представления.Добавить(Представление);
	Если Случай = "view.aggregation" Тогда
		Агрегация = Новый ОтелКонфигурацияАгрегации();
		Агрегация.Тип = Неопределено;
		Агрегация.ЗаписыватьМинМакс = Неопределено;
		Агрегация.МаксШкала = Неопределено;
		Агрегация.МаксРазмер = Неопределено;
		Представление.Поток.Агрегация = Агрегация;
	Иначе
		Представление.Поток.КлючиАтрибутов = Новый ОтелКонфигурацияКлючейАтрибутов();
	КонецЕсли;

КонецПроцедуры

// Возвращает строку нарушения, которую ошибка проверки модели содержит для случая МодельСНарушением.
Функция ОжидаемоеНарушение(Случай)

	Нарушения = Новый Соответствие;
	Нарушения.Вставить("disabled", "/disabled: Ожидался тип boolean или null, получен string");
	Нарушения.Вставить("schedule_delay",
		"/tracer_provider/processors/0/batch/schedule_delay: Значение -1 меньше минимума 0");
	Нарушения.Вставить("max_queue_size",
		"/logger_provider/processors/0/batch/max_queue_size: Значение 0 не больше строгого минимума 0");
	Нарушения.Вставить("timeout",
		"/tracer_provider/processors/0/batch/exporter/otlp_http/timeout: Ожидался тип integer или null, получен string");
	Нарушения.Вставить("ratio", "/tracer_provider/sampler/trace_id_ratio_based/ratio: Значение 1.5 больше максимума 1");
	Нарушения.Вставить("event_count_limit", "/tracer_provider/limits/event_count_limit: Значение -1 меньше минимума 0");
	Нарушения.Вставить("span_attribute_value_depth_limit",
		"/tracer_provider/limits/attribute_value_depth_limit: Значение 0 меньше минимума 1");
	Нарушения.Вставить("attribute_count_limit",
		"/attribute_limits/attribute_count_limit: Значение -5 меньше минимума 0");
	Нарушения.Вставить("attribute_value_depth_limit",
		"/attribute_limits/attribute_value_depth_limit: Значение 0 меньше минимума 1");
	Нарушения.Вставить("max_request_size",
		"/tracer_provider/processors/0/batch/exporter/otlp_http/max_request_size: Значение -1 меньше минимума 0");
	Нарушения.Вставить("http_tls_insecure",
		"/tracer_provider/processors/0/batch/exporter/otlp_http/tls/insecure: Свойство ""insecure"" не описано");
	Нарушения.Вставить("encoding",
		"/tracer_provider/processors/0/batch/exporter/otlp_http/encoding: Значение ""JSON"" не входит в перечисление");
	Нарушения.Вставить("max_response_size",
		"/meter_provider/readers/0/periodic/exporter/otlp_http/max_response_size: Значение 0 меньше минимума 1");
	Нарушения.Вставить("interval", "/meter_provider/readers/0/periodic/interval: Значение -1 меньше минимума 0");
	Нарушения.Вставить("cardinality_limits",
		"/meter_provider/readers/0/periodic/cardinality_limits/histogram: Значение 0 не больше строгого минимума 0");
	Нарушения.Вставить("exemplar_filter",
		"/meter_provider/exemplar_filter: Значение ""sometimes"" не входит в перечисление enum");
	Нарушения.Вставить("temporality_preference",
		"/meter_provider/readers/0/periodic/exporter/otlp_http/temporality_preference: Значение ""DELTA""");
	Нарушения.Вставить("default_histogram_aggregation",
		"/meter_provider/readers/0/periodic/exporter/otlp_grpc/default_histogram_aggregation: "
		+ "Значение ""exponential""");
	Нарушения.Вставить("attribute_type",
		"/resource/attributes/0/type: Значение ""integer"" не входит в перечисление enum");
	Нарушения.Вставить("span_exporter_temporality",
		"/tracer_provider/processors/0/batch/exporter/otlp_http/temporality_preference: Свойство ""temporality_");
	Нарушения.Вставить("limits_class", "/logger_provider/limits: Ожидался тип object");
	Нарушения.Вставить("console_span_temporality",
		"/tracer_provider/processors/0/batch/exporter/console/temporality_preference: Свойство ""temporality_");
	Нарушения.Вставить("view_instrument_type",
		"/meter_provider/views/0/selector/instrument_type: Значение ""Histogram"" не входит в перечисление");
	Нарушения.Вставить("view_max_scale",
		"/meter_provider/views/0/stream/aggregation/base2_exponential_bucket_histogram/max_scale: "
		+ "Значение 25 больше максимума 20");
	Нарушения.Вставить("view_aggregation_type",
		"/meter_provider/views/0/stream/aggregation/histogram: Свойство ""histogram"" не описано");
	Нарушения.Вставить("view_cardinality_limit",
		"/meter_provider/views/0/stream/aggregation_cardinality_limit: Значение 0 не больше строгого минимума 0");
	Нарушения.Вставить("view_included_empty",
		"/meter_provider/views/0/stream/attribute_keys/included: Элементов 0, требуется не меньше 1");
	Возврат Нарушения.Получить(Случай);

КонецФункции

// Возвращает текст ошибки Создать или пустую строку, если SDK создан.
Функция ОшибкаСоздания(Модель)
	Попытка
		Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Sdk.Закрыть();
	Возврат "";
КонецФункции

// Возвращает провайдер трассировки модели с простым процессором: processors обязателен по схеме.
Функция ПровайдерТрассировкиСПроцессором()
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераТрассировки();
	КонфигПровайдера.Процессоры.Добавить(ПростойПроцессор("traces"));
	Возврат КонфигПровайдера;
КонецФункции

// Возвращает провайдер логирования модели с простым процессором: processors обязателен по схеме.
Функция ПровайдерЛогированияСПроцессором()
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераЛогирования();
	КонфигПровайдера.Процессоры.Добавить(ПростойПроцессор("logs"));
	Возврат КонфигПровайдера;
КонецФункции

// Возвращает провайдер метрик модели с периодическим читателем: readers обязателен по схеме.
Функция ПровайдерМетрикСЧитателем()
	КонфигЧитателя = Новый ОтелКонфигурацияПериодическогоЧитателя();
	КонфигЧитателя.Экспортер = ЭкспортерOtlpHttp("metrics");
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераМетрик();
	КонфигПровайдера.Читатели.Добавить(КонфигЧитателя);
	Возврат КонфигПровайдера;
КонецФункции

Функция ПростойПроцессор(Сигнал)
	КонфигПроцессора = Новый ОтелКонфигурацияПростогоПроцессора();
	КонфигПроцессора.Экспортер = ЭкспортерOtlpHttp(Сигнал);
	Возврат КонфигПроцессора;
КонецФункции

Функция ПакетныйПроцессор(Сигнал)
	КонфигПроцессора = Новый ОтелКонфигурацияПакетногоПроцессора();
	КонфигПроцессора.Экспортер = ЭкспортерOtlpHttp(Сигнал);
	Возврат КонфигПроцессора;
КонецФункции

// Экспортер otlp_http на закрытый порт: тесты не отправляют данные коллектору.
Функция ЭкспортерOtlpHttp(Сигнал)
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигЭкспортера.Адрес = "http://localhost:1/v1/" + Сигнал;
	Возврат КонфигЭкспортера;
КонецФункции

// Экспортер спанов otlp_http или otlp_grpc на закрытый порт.
// Создает файл сертификата в каталоге временных файлов и возвращает его абсолютный путь. Файл удаляет тест.
Функция ВременныйФайлСертификата()
	ПутьКФайлу = ОбъединитьПути(КаталогВременныхФайлов(), "otel-tls-test-cert.pem");
	Запись = Новый ЗаписьТекста(ПутьКФайлу);
	Запись.ЗаписатьСтроку("-----BEGIN CERTIFICATE-----");
	Запись.ЗаписатьСтроку("-----END CERTIFICATE-----");
	Запись.Закрыть();
	Возврат ПутьКФайлу;
КонецФункции

Функция ЭкспортерВида(ВидЭкспортера)
	Если ВидЭкспортера = "otlp_grpc" Тогда
		КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpGrpc();
		КонфигЭкспортера.Адрес = "http://localhost:1";
		Возврат КонфигЭкспортера;
	КонецЕсли;
	Возврат ЭкспортерOtlpHttp("traces");
КонецФункции

// Возвращает текст ошибки создания провайдера трассировки с простым процессором и экспортером или пустую
// строку, если провайдер создан.
Функция ОшибкаСозданияПровайдераТрассировкиСЭкспортером(КонфигЭкспортера)
	КонфигПроцессора = Новый ОтелКонфигурацияПростогоПроцессора();
	КонфигПроцессора.Экспортер = КонфигЭкспортера;
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераТрассировки();
	КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора);
	Возврат ОшибкаСозданияПровайдераТрассировки(КонфигПровайдера);
КонецФункции

// Возвращает атрибут ресурса модели со значением типа из случая: имя типа схемы, "без type" - атрибут без
// типа, "double целым числом" - тип double со значением 2.
Функция АтрибутРесурсаСлучая(Случай)

	Если Случай = "без type" Тогда
		Возврат Новый Структура("Имя, Значение", "attr", "a");
	КонецЕсли;

	Значения = Новый Соответствие;
	Значения.Вставить("string", "a");
	Значения.Вставить("bool", Истина);
	Значения.Вставить("int", 8080);
	Значения.Вставить("double", 1.5);
	Значения.Вставить("double целым числом", 2);
	Значения.Вставить("string_array", МассивЗначений("a", "b"));
	Значения.Вставить("bool_array", МассивЗначений(Истина, Ложь));
	Значения.Вставить("int_array", МассивЗначений(1, 2));
	Значения.Вставить("double_array", МассивЗначений(1.5, 2));
	ТипАтрибута = СтрРазделить(Случай, " ")[0];
	Возврат Новый Структура("Имя, Значение, Тип", "attr", Значения.Получить(Случай), ТипАтрибута);

КонецФункции

// Возвращает значение атрибута по описанию вида.
Функция ЗначениеВида(ВидЗначения)
	Значения = Новый Соответствие;
	Значения.Вставить("число", 123);
	Значения.Вставить("дробное число", 1.5);
	Значения.Вставить("строка", "true");
	Значения.Вставить("массив строк", МассивЗначений("a", "b"));
	Значения.Вставить("массив чисел", МассивЗначений(1, 2));
	Значения.Вставить("массив дробных чисел", МассивЗначений(1.5, 2.5));
	Возврат Значения.Получить(ВидЗначения);
КонецФункции

Функция МассивЗначений(Значение1, Значение2)
	Значения = Новый Массив;
	Значения.Добавить(Значение1);
	Значения.Добавить(Значение2);
	Возврат Значения;
КонецФункции

Функция КонфигСэмплераТипа(Тип, Доля = 1.0)
	КонфигСэмплера = Новый ОтелКонфигурацияСэмплера();
	КонфигСэмплера.Тип = Тип;
	КонфигСэмплера.Доля = Доля;
	Возврат КонфигСэмплера;
КонецФункции

// Описание ParentBased с заданным корневым сэмплером и делегатами по умолчанию.
Функция ОписаниеНаОсновеРодителя(ОписаниеКорневого)
	Возврат "ParentBased{root:" + ОписаниеКорневого + ",remoteParentSampled:AlwaysOnSampler,"
		+ "remoteParentNotSampled:AlwaysOffSampler,localParentSampled:AlwaysOnSampler,"
		+ "localParentNotSampled:AlwaysOffSampler}";
КонецФункции

Функция СоздатьТестовыйАппендер()
	Текст = "Перем События Экспорт;
	|Процедура ВывестиСобытие(Событие) Экспорт
	|    События.Добавить(Событие);
	|КонецПроцедуры
	|Процедура Закрыть() Экспорт
	|КонецПроцедуры
	|Процедура УстановитьСвойство(Имя, Значение) Экспорт
	|КонецПроцедуры
	|События = Новый Массив();";
	Возврат ЗагрузитьСценарийИзСтроки(Текст);
КонецФункции

Функция ЕстьСообщениеСТекстом(Аппендер, Текст)
	Для Каждого Событие Из Аппендер.События Цикл
		Если СтрНайти(Событие.ПолучитьСообщение(), Текст) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Файловая конфигурация: b3 и b3multi - встроенные пропагаторы схемы декларативной конфигурации,
// как и в OTEL_PROPAGATORS. Класс ОтелB3Пропагатор поставляется пакетом
// opentelemetry-propagator-b3, в тесте его заменяет фикстура. Отдельный процесс: подмененный
// класс не должен попасть в тесты, которые проверяют работу без пакета
&ПараметризованныйТест
&ИсточникЗначение("b3|single")
&ИсточникЗначение("b3multi|multi")
&Изолированный(Уровень = "Процесс")
Процедура СоздатьПропагаторыB3(Случай) Экспорт

	// Дано - имя пропагатора|формат B3
	Части = СтрРазделить(Случай, "|");
	ПодключитьПодменуB3();
	КонфигПропагатора = Новый ОтелКонфигурацияПропагатора();
	КонфигПропагатора.СписокСоставного = "tracecontext," + Части[0];

	// Когда
	Пропагаторы = ОтелКонфигурационнаяФабрика.СоздатьПропагаторы(КонфигПропагатора);

	// Тогда
	Ожидаем.Что(Пропагаторы.Поля()).Содержит("b3-" + Части[1]);

КонецПроцедуры

Процедура ПодключитьПодменуB3()
	ПодключитьСценарий(
		ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "ПодменаB3Пропагатора.os"),
		"ОтелB3Пропагатор");
КонецПроцедуры

// Схема файла конфигурации: секция propagator без composite и composite_list (propagator: {})
// дает noop-пропагатор
&Тест
Процедура СоздатьПропагаторыИзПустойКонфигурации() Экспорт

	// Дано
	КонфигПропагатора = Новый ОтелКонфигурацияПропагатора();

	// Когда
	Пропагаторы = ОтелКонфигурационнаяФабрика.СоздатьПропагаторы(КонфигПропагатора);

	// Тогда
	Ожидаем.Что(ТипЗнч(Пропагаторы)).Равно(Тип("ОтелНоопПропагатор"));

КонецПроцедуры

// Схема файла конфигурации: без секции propagator SDK получает noop-пропагатор
&Тест
Процедура СоздатьSdkБезПропагатора() Экспорт

	// Дано - модель файла без секции propagator
	Модель = НоваяМодель();
	Модель.ПровайдерТрассировки = ПровайдерТрассировкиСПроцессором();
	Модель.ПровайдерЛогирования = ПровайдерЛогированияСПроцессором();
	Модель.ПровайдерМетрик = ПровайдерМетрикСЧитателем();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Ожидаем.Что(ТипЗнч(Sdk.Пропагаторы())).Равно(Тип("ОтелНоопПропагатор"));

КонецПроцедуры

// Транспорт, созданный по файлу конфигурации, закрывает экспортер при закрытии провайдера.
// Закрытие видно по отладочной записи транспорта
&ПараметризованныйТест
&ИсточникЗначение("traces", "batch")
&ИсточникЗначение("logs", "batch")
&ИсточникЗначение("metrics", "periodic")
&ИсточникЗначение("traces", "simple")
&ИсточникЗначение("logs", "simple")
Процедура ЗакрытиеПровайдераЗакрываетТранспортФайлаКонфигурации(Сигнал, Компонент) Экспорт

	// Дано - экспортер otlp_http у пакетного или простого процессора, у периодического читателя
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигЭкспортера.Адрес = "http://localhost:1/v1/" + Сигнал;
	КонфигЭкспортера.Таймаут = 1000;
	Провайдер = ПровайдерСЭкспортером(Сигнал, КонфигЭкспортера, Компонент);
	ИмяЛога = "oscript.lib.opentelemetry.transport";
	Аппендер = СоздатьТестовыйАппендер();
	Логирование.ПолучитьЛог(ИмяЛога).ДобавитьСпособВывода(Аппендер, УровниЛога.Отладка);

	// Когда
	Провайдер.Закрыть();

	// Тогда
	Логирование.ПолучитьЛог(ИмяЛога).УдалитьСпособВывода(Аппендер);
	Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "транспорт закрыт"), Сигнал + " " + Компонент).ЭтоИстина();

КонецПроцедуры

// Экспортер otlp_grpc отправляет данные через ОтелGrpcТранспорт, созданный фабрикой: транспорт
// закрывается вместе с провайдером. Закрытие видно по отладочной записи gRPC-транспорта
&ПараметризованныйТест
&ИсточникЗначение("traces", "batch")
&ИсточникЗначение("logs", "simple")
&ИсточникЗначение("metrics", "periodic")
Процедура ЗакрытиеПровайдераЗакрываетGrpcТранспорт(Сигнал, Компонент) Экспорт

	// Дано
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpGrpc();
	КонфигЭкспортера.Адрес = "http://localhost:1";
	КонфигЭкспортера.Таймаут = 1000;
	Провайдер = ПровайдерСЭкспортером(Сигнал, КонфигЭкспортера, Компонент);
	ИмяЛога = "oscript.lib.opentelemetry.grpc";
	Аппендер = СоздатьТестовыйАппендер();
	Логирование.ПолучитьЛог(ИмяЛога).ДобавитьСпособВывода(Аппендер, УровниЛога.Отладка);

	// Когда
	Провайдер.Закрыть();

	// Тогда
	Логирование.ПолучитьЛог(ИмяЛога).УдалитьСпособВывода(Аппендер);
	Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "транспорт закрыт"), Сигнал + " " + Компонент).ЭтоИстина();

КонецПроцедуры

// Клиент OPI_GRPC не поддерживает сжатие: compression: gzip у otlp_grpc не игнорируется молча
&Тест
Процедура СжатиеGrpcНеПоддерживаетсяСПредупреждением() Экспорт

	// Дано
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpGrpc();
	КонфигЭкспортера.Адрес = "http://localhost:1";
	КонфигЭкспортера.Сжатие = "gzip";
	ИмяЛога = "oscript.lib.opentelemetry.config.factory";
	Аппендер = СоздатьТестовыйАппендер();
	Логирование.ПолучитьЛог(ИмяЛога).ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);

	// Когда
	Провайдер = ПровайдерСЭкспортером("traces", КонфигЭкспортера);

	// Тогда - предупреждение ссылается на задачу о сжатии в OPI_GRPC
	Логирование.ПолучитьЛог(ИмяЛога).УдалитьСпособВывода(Аппендер);
	Провайдер.Закрыть();
	Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "не поддерживается"), "предупреждение").ЭтоИстина();
	Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "Bayselonarrend/OpenIntegrations/issues/112"), "ссылка на задачу")
		.ЭтоИстина();

КонецПроцедуры

// Клиент OPI_GRPC принимает ответ не больше 4 MiB, другой лимит задать нельзя: max_response_size у otlp_grpc,
// отличный от 4 MiB, не игнорируется молча

&ПараметризованныйТест
&ИсточникЗначение("1024", "Истина")
&ИсточникЗначение("4194304", "Ложь")
Процедура МаксРазмерОтветаGrpcНеПоддерживаетсяСПредупреждением(МаксРазмерОтвета, ЕстьПредупреждение) Экспорт

	// Дано
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpGrpc();
	КонфигЭкспортера.Адрес = "http://localhost:1";
	КонфигЭкспортера.МаксРазмерОтвета = Число(МаксРазмерОтвета);
	ИмяЛога = "oscript.lib.opentelemetry.config.factory";
	Аппендер = СоздатьТестовыйАппендер();
	Логирование.ПолучитьЛог(ИмяЛога).ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);

	// Когда
	Провайдер = ПровайдерСЭкспортером("traces", КонфигЭкспортера);

	// Тогда - предупреждение ссылается на задачу о лимите ответа в OPI_GRPC
	Логирование.ПолучитьЛог(ИмяЛога).УдалитьСпособВывода(Аппендер);
	Провайдер.Закрыть();
	Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "Bayselonarrend/OpenIntegrations/issues/113"), МаксРазмерОтвета)
		.Равно(ЕстьПредупреждение = "Истина");

КонецПроцедуры

// Описание tls: ca_file, key_file и cert_file - абсолютные пути к файлам, key_file и cert_file задаются
// только вместе. Configuration SDK, Create: значение не по описанию свойства - ошибка

&ПараметризованныйТест
&ИсточникЗначение("otlp_http", "ca_file относительный")
&ИсточникЗначение("otlp_grpc", "ca_file относительный")
&ИсточникЗначение("otlp_http", "ca_file не найден")
&ИсточникЗначение("otlp_grpc", "key_file относительный")
&ИсточникЗначение("otlp_http", "cert_file не найден")
&ИсточникЗначение("otlp_http", "key_file без cert_file")
&ИсточникЗначение("otlp_grpc", "cert_file без key_file")
Процедура НастройкиTlsНеПоОписаниюОшибка(ВидЭкспортера, Случай) Экспорт

	// Дано
	ФайлСертификата = ВременныйФайлСертификата();
	КонфигЭкспортера = ЭкспортерВида(ВидЭкспортера);
	КонфигЭкспортера.НастройкиTls = Новый ОтелНастройкиTls();
	НастройкиTls = КонфигЭкспортера.НастройкиTls;
	ОтсутствующийФайл = ОбъединитьПути(КаталогВременныхФайлов(), "otel-tls-missing.pem");
	Если Случай = "ca_file относительный" Тогда
		НастройкиTls.ФайлСертификата = "certs/ca.pem";
		ОжидаемаяОшибка = "tls.ca_file ""certs/ca.pem"" должен быть абсолютным путем к файлу";
	ИначеЕсли Случай = "ca_file не найден" Тогда
		НастройкиTls.ФайлСертификата = ОтсутствующийФайл;
		ОжидаемаяОшибка = СтрШаблон("файл tls.ca_file ""%1"" не найден", ОтсутствующийФайл);
	ИначеЕсли Случай = "key_file относительный" Тогда
		НастройкиTls.ФайлКлиентскогоКлюча = "client.key";
		НастройкиTls.ФайлКлиентскогоСертификата = ФайлСертификата;
		ОжидаемаяОшибка = "tls.key_file ""client.key"" должен быть абсолютным путем к файлу";
	ИначеЕсли Случай = "cert_file не найден" Тогда
		НастройкиTls.ФайлКлиентскогоКлюча = ФайлСертификата;
		НастройкиTls.ФайлКлиентскогоСертификата = ОтсутствующийФайл;
		ОжидаемаяОшибка = СтрШаблон("файл tls.cert_file ""%1"" не найден", ОтсутствующийФайл);
	ИначеЕсли Случай = "key_file без cert_file" Тогда
		НастройкиTls.ФайлКлиентскогоКлюча = ФайлСертификата;
		ОжидаемаяОшибка = "tls.key_file и tls.cert_file задаются только вместе";
	Иначе
		НастройкиTls.ФайлКлиентскогоСертификата = ФайлСертификата;
		ОжидаемаяОшибка = "tls.key_file и tls.cert_file задаются только вместе";
	КонецЕсли;

	// Когда
	ТекстОшибки = ОшибкаСозданияПровайдераТрассировкиСЭкспортером(КонфигЭкспортера);

	// Тогда
	УдалитьФайлы(ФайлСертификата);
	Ожидаем.Что(ТекстОшибки).Содержит(СтрШаблон("Экспортер %1: ", ВидЭкспортера));
	Ожидаем.Что(ТекстОшибки).Содержит(ОжидаемаяОшибка);

КонецПроцедуры

// Настройки tls доходят до транспорта: HTTP-клиент OneScript файлы сертификатов не применяет и
// транспорт предупреждает об этом
&Тест
Процедура НастройкиTlsДоходятДоHttpТранспорта() Экспорт

	// Дано
	ФайлСертификата = ВременныйФайлСертификата();
	КонфигЭкспортера = ЭкспортерOtlpHttp("traces");
	КонфигЭкспортера.НастройкиTls = Новый ОтелНастройкиTls();
	КонфигЭкспортера.НастройкиTls.ФайлСертификата = ФайлСертификата;
	ИмяЛога = "oscript.lib.opentelemetry.transport";
	Аппендер = СоздатьТестовыйАппендер();
	Логирование.ПолучитьЛог(ИмяЛога).ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);

	// Когда
	Провайдер = ПровайдерСЭкспортером("traces", КонфигЭкспортера);

	// Тогда
	Логирование.ПолучитьЛог(ИмяЛога).УдалитьСпособВывода(Аппендер);
	Провайдер.Закрыть();
	УдалитьФайлы(ФайлСертификата);
	Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "файлы сертификатов TLS"), "предупреждение транспорта").ЭтоИстина();

КонецПроцедуры

// Простой процессор (simple) из файла конфигурации - SimpleSpanProcessor и SimpleLogRecordProcessor SDK
&ПараметризованныйТест
&ИсточникЗначение("traces", "ОтелПростойПроцессорСпанов")
&ИсточникЗначение("logs", "ОтелПростойПроцессорЛогов")
Процедура СоздатьПровайдерСПростымПроцессором(Сигнал, ТипПроцессора) Экспорт

	// Дано
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигЭкспортера.Адрес = "http://localhost:1/v1/" + Сигнал;

	// Когда
	Провайдер = ПровайдерСЭкспортером(Сигнал, КонфигЭкспортера, "simple");

	// Тогда - провайдер хранит процессоры в композитном
	Процессоры = Провайдер.Процессор().Процессоры();
	Провайдер.Закрыть();
	Ожидаем.Что(Процессоры.Количество()).Равно(1);
	Ожидаем.Что(Процессоры[0]).ИмеетТип(ТипПроцессора);

КонецПроцедуры

// Создает провайдер сигнала с экспортером: для traces и logs - у процессора, для metrics - у
// периодического читателя.
//
// Параметры:
//   Сигнал - Строка - traces, logs или metrics
//   КонфигЭкспортера - Произвольный - конфигурация экспортера
//   Компонент - Строка - процессор batch или simple; для metrics не используется
//
Функция ПровайдерСЭкспортером(Сигнал, КонфигЭкспортера, Компонент = "batch")
	Ресурс = Новый ОтелРесурс();
	Если Сигнал = "metrics" Тогда
		КонфигЧитателя = Новый ОтелКонфигурацияПериодическогоЧитателя();
		КонфигЧитателя.Экспортер = КонфигЭкспортера;
		КонфигПровайдера = Новый ОтелКонфигурацияПровайдераМетрик();
		КонфигПровайдера.Читатели.Добавить(КонфигЧитателя);
		Возврат ОтелКонфигурационнаяФабрика.СоздатьПровайдерМетрик(Ресурс, КонфигПровайдера);
	КонецЕсли;
	Если Компонент = "simple" Тогда
		КонфигПроцессора = Новый ОтелКонфигурацияПростогоПроцессора();
	Иначе
		КонфигПроцессора = Новый ОтелКонфигурацияПакетногоПроцессора();
	КонецЕсли;
	КонфигПроцессора.Экспортер = КонфигЭкспортера;
	Возврат ПровайдерСПроцессором(Сигнал, КонфигПроцессора);
КонецФункции

// Создает провайдер трассировки (traces) или логирования (logs) с одним процессором.
Функция ПровайдерСПроцессором(Сигнал, КонфигПроцессора)
	Ресурс = Новый ОтелРесурс();
	Если Сигнал = "traces" Тогда
		КонфигПровайдера = Новый ОтелКонфигурацияПровайдераТрассировки();
		КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора);
		Возврат ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(Ресурс, КонфигПровайдера);
	КонецЕсли;
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераЛогирования();
	КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора);
	Возврат ОтелКонфигурационнаяФабрика.СоздатьПровайдерЛогирования(Ресурс, КонфигПровайдера);
КонецФункции

// Возвращает компонент модели по имени без свойств: пропагатор, экспортер или другой компонент.
Функция КомпонентКонфигурации(Имя)
	Компонент = Новый ОтелКонфигурацияКомпонента();
	Компонент.Имя = Имя;
	Возврат Компонент;
КонецФункции

// Возвращает читатель pull, как его сохраняет разбор файла: по схеме у него обязателен pull-экспортер.
Функция PullЧитатель()
	Экспортер = Новый Соответствие;
	Экспортер.Вставить("my_pull_exporter", Неопределено);
	Компонент = КомпонентКонфигурации("pull");
	Компонент.Свойства = Новый Соответствие;
	Компонент.Свойства.Вставить("exporter", Экспортер);
	Возврат Компонент;
КонецФункции

// Возвращает текст ошибки создания провайдера трассировки или пустую строку, если провайдер создан.
Функция ОшибкаСозданияПровайдераТрассировки(КонфигПровайдера)
	Попытка
		Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(Новый ОтелРесурс(), КонфигПровайдера);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Провайдер.Закрыть();
	Возврат "";
КонецФункции
