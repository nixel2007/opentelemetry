	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("Пропагатор ""xray"" не поддерживается");

КонецПроцедуры

