	КонфигСэмплера = Новый ОтелКонфигурацияСэмплера();
	КонфигСэмплера.Тип = "parent_based";
	КонфигСэмплера.Корневой = КонфигСэмплераТипа("trace_id_ratio_based", 0.1);
	КонфигПровайдера.Сэмплер = КонфигСэмплера;
	Модель.ПровайдерТрассировки = КонфигПровайдера;
	Модель.ПровайдерЛогирования = ПровайдерЛогированияСПроцессором();
	Модель.ПровайдерМетрик = ПровайдерМетрикСЧитателем();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Ожидаем.Что(Sdk.ПровайдерТрассировки().Сэмплер().Описание()).Равно(
		ОписаниеНаОсновеРодителя("TraceIdRatioBased{0.100000}"));

КонецПроцедуры

// ===== Обязательные свойства =====

// Configuration SDK, Create: обязательное свойство, которого нет в модели, - ошибка. У процессоров
// и периодического читателя обязателен exporter

&ПараметризованныйТест
&ИсточникЗначение("traces", "batch")
&ИсточникЗначение("traces", "simple")
&ИсточникЗначение("logs", "batch")
&ИсточникЗначение("logs", "simple")
&ИсточникЗначение("metrics", "periodic")
Процедура КомпонентБезЭкспортераОшибка(Сигнал, Компонент) Экспорт

	// Дано - Экспортер = Неопределено (по умолчанию)

	// Когда
	ТекстОшибки = "";
	Попытка
		ПровайдерСЭкспортером(Сигнал, Неопределено, Компонент).Закрыть();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Тогда - нарушение схемы с путем компонента
	Если Сигнал = "traces" Тогда
		Путь = "/tracer_provider/processors/0/";
	ИначеЕсли Сигнал = "logs" Тогда
		Путь = "/logger_provider/processors/0/";
	Иначе
		Путь = "/meter_provider/readers/0/";
	КонецЕсли;
	Ожидаем.Что(ТекстОшибки).Содержит(Путь + Компонент + ": Отсутствует обязательное свойство ""exporter""");

КонецПроцедуры

// file_format - обязательное свойство модели: без него и с версией, которую SDK не поддерживает, -
// ошибка, как при разборе файла

&ПараметризованныйТест
&ИсточникЗначение("", "Не задан обязательный file_format")
&ИсточникЗначение("2.0", "Неподдерживаемая версия формата файла: 2.0")
&ИсточникЗначение("abc", "Неподдерживаемая версия формата файла: abc")
Процедура СоздатьСНекорректнымФорматомФайлаОшибка(ФорматФайла, ОжидаемыйТекст) Экспорт

	// Дано
	Модель = НоваяМодель();
	Модель.ФорматФайла = ФорматФайла;

	// Когда
