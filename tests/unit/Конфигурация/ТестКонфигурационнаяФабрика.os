&Тест
Процедура ГенераторИдRandomПоУмолчанию() Экспорт

	// Дано - id_generator: random - генератор SDK по умолчанию
	КонфигПровайдера = ПровайдерТрассировкиСПроцессором();
	КонфигПровайдера.ГенераторИд = КомпонентКонфигурации("random");

	// Когда
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(Новый ОтелРесурс(), КонфигПровайдера);

	// Тогда - идентификаторы - случайные 16 байт
	ИдТрассировки = Провайдер.СгенерироватьИдТрассировки();
	Провайдер.Закрыть();
	Ожидаем.Что(СтрДлина(ИдТрассировки)).Равно(32);

КонецПроцедуры

