// ===== Сэмплеры =====

&Тест
Процедура СоздатьПровайдерТрассировкиСParentBasedСДелегатами() Экспорт

	// Дано - parent_based с полной конфигурацией всех 4 делегатов, отличных от делегатов по умолчанию
	Модель = НоваяМодель();
	КонфигПровайдера = ПровайдерТрассировкиСПроцессором();
	КонфигСэмплера = Новый ОтелКонфигурацияСэмплера();
	КонфигСэмплера.Тип = "parent_based";
	КонфигСэмплера.УдаленныйРодительСэмплирован = КонфигСэмплераТипа("always_off");
	КонфигСэмплера.УдаленныйРодительНеСэмплирован = КонфигСэмплераТипа("always_on");
	КонфигСэмплера.ЛокальныйРодительСэмплирован = КонфигСэмплераТипа("trace_id_ratio_based", 0.5);
	КонфигСэмплера.ЛокальныйРодительНеСэмплирован = КонфигСэмплераТипа("always_on");

	КонфигПровайдера.Сэмплер = КонфигСэмплера;
	Модель.ПровайдерТрассировки = КонфигПровайдера;
	Модель.ПровайдерЛогирования = ПровайдерЛогированияСПроцессором();
	Модель.ПровайдерМетрик = ПровайдерМетрикСЧитателем();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Ожидаем.Что(Sdk.ПровайдерТрассировки().Сэмплер().Описание()).Равно(
		"ParentBased{root:AlwaysOnSampler,remoteParentSampled:AlwaysOffSampler,"
		+ "remoteParentNotSampled:AlwaysOnSampler,localParentSampled:TraceIdRatioBased{0.500000},"
		+ "localParentNotSampled:AlwaysOnSampler}");

КонецПроцедуры

// Схема декларативной конфигурации: always_record заменяет решение DROP сэмплера root
// на RECORD_ONLY (Trace SDK, AlwaysRecord)
&Тест
Процедура СэмплерAlwaysRecordОборачиваетКорневой() Экспорт

	// Дано
	КонфигПровайдера = ПровайдерТрассировкиСПроцессором();
	КонфигСэмплера = КонфигСэмплераТипа("always_record");
	КонфигСэмплера.Корневой = КонфигСэмплераТипа("trace_id_ratio_based", 0.25);
	КонфигПровайдера.Сэмплер = КонфигСэмплера;

	// Когда
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(
		Новый ОтелРесурс(), КонфигПровайдера);

	// Тогда
	Ожидаем.Что(Провайдер.Сэмплер().Описание()).Равно("AlwaysRecord{TraceIdRatioBased{0.250000}}");
	Провайдер.Закрыть();

КонецПроцедуры

// Configuration SDK, Create: без обязательного свойства (root у always_record) - ошибка
&Тест
Процедура СэмплерAlwaysRecordБезКорневогоОшибка() Экспорт

	// Дано
	КонфигПровайдера = ПровайдерТрассировкиСПроцессором();
	КонфигПровайдера.Сэмплер = КонфигСэмплераТипа("always_record");

	// Когда
	ТекстОшибки = "";
	Попытка
		ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(Новый ОтелРесурс(), КонфигПровайдера);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("always_record");
	Ожидаем.Что(ТекстОшибки).Содержит("root");

КонецПроцедуры

// Configuration SDK, Create: вложенный сэмплер создается со своими параметрами
&Тест
Процедура ДелегатыParentBasedСоздаютсяСоСвоимиПараметрами() Экспорт

	// Дано - у корневого сэмплера и делегата свои доли; делегат - вложенный parent_based
	КонфигПровайдера = ПровайдерТрассировкиСПроцессором();
	КонфигСэмплера = Новый ОтелКонфигурацияСэмплера();
	КонфигСэмплера.Тип = "parent_based";
	КонфигСэмплера.Корневой = КонфигСэмплераТипа("trace_id_ratio_based", 0.1);
	КонфигСэмплера.УдаленныйРодительСэмплирован = КонфигСэмплераТипа("trace_id_ratio_based", 0.5);
	ВложенныйСэмплер = КонфигСэмплераТипа("parent_based");
	ВложенныйСэмплер.Корневой = КонфигСэмплераТипа("always_off");
	КонфигСэмплера.ЛокальныйРодительСэмплирован = ВложенныйСэмплер;
	КонфигПровайдера.Сэмплер = КонфигСэмплера;

	// Когда
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(
		Новый ОтелРесурс(), КонфигПровайдера);

	// Тогда
	ОписаниеВложенного = ОписаниеНаОсновеРодителя("AlwaysOffSampler");
	Ожидаем.Что(Провайдер.Сэмплер().Описание()).Равно(
		"ParentBased{root:TraceIdRatioBased{0.100000},remoteParentSampled:TraceIdRatioBased{0.500000},"
		+ "remoteParentNotSampled:AlwaysOffSampler,localParentSampled:"
		+ ОписаниеВложенного + ",localParentNotSampled:AlwaysOffSampler}");
	Провайдер.Закрыть();

КонецПроцедуры

// Configuration SDK, Create: компонент, которого нет в SDK, - ошибка (fail fast), а не предупреждение
// с заменой значением по умолчанию. Ошибка называет вид компонента и его имя

&ПараметризованныйТест
&ИсточникЗначение("провайдера")
&ИсточникЗначение("корневой")
Процедура НеподдерживаемыйСэмплерОшибка(Место) Экспорт

	// Дано - сэмплер, которого нет в SDK, у провайдера или корневым сэмплером parent_based
	НеподдерживаемыйСэмплер = КомпонентКонфигурации("my_sampler");
	КонфигПровайдера = ПровайдерТрассировкиСПроцессором();
	Если Место = "провайдера" Тогда
		КонфигПровайдера.Сэмплер = НеподдерживаемыйСэмплер;
	Иначе
		КонфигПровайдера.Сэмплер = КонфигСэмплераТипа("parent_based");
		КонфигПровайдера.Сэмплер.Корневой = НеподдерживаемыйСэмплер;
	КонецЕсли;

	// Когда
	ТекстОшибки = ОшибкаСозданияПровайдераТрассировки(КонфигПровайдера);

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("Сэмплер ""my_sampler"" не поддерживается");

КонецПроцедуры

// Тип сэмплера - ключ схемы: регистр значим, как в файле
&ПараметризованныйТест
&ИсточникЗначение("alwayson")
&ИсточникЗначение("ALWAYS_ON")
Процедура НеизвестныйТипСэмплераОшибка(ТипСэмплера) Экспорт

	// Дано - модель, собранная в коде, с опечаткой в типе сэмплера
	КонфигПровайдера = ПровайдерТрассировкиСПроцессором();
	КонфигПровайдера.Сэмплер = КонфигСэмплераТипа(ТипСэмплера);

	// Когда
	ТекстОшибки = ОшибкаСозданияПровайдераТрассировки(КонфигПровайдера);

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("Сэмплер """ + ТипСэмплера + """ не поддерживается");

КонецПроцедуры

&ПараметризованныйТест
