&Тест
Процедура СоздатьПропагаторыNoneСДругимиВыбрасываетИсключение() Экспорт

	// Дано
	КонфигПропагатора = Новый ОтелКонфигурацияПропагатора();
	КонфигПропагатора.Составной.Добавить(КомпонентКонфигурации("none"));
	КонфигПропагатора.Составной.Добавить(КомпонентКонфигурации("tracecontext"));

	// Когда / Тогда
	Попытка
		ОтелКонфигурационнаяФабрика.СоздатьПропагаторы(
			КонфигПропагатора);
		Ожидаем.Что(Ложь).ЭтоИстина("Должно было быть исключение");
	Исключение
		Ожидаем.Что(ИнформацияОбОшибке().Описание).Содержит("none");
	КонецПопытки;

КонецПроцедуры

// Ошибка конфигурации не оставляет работающих компонентов: провайдеры, которые Создать успела
// создать до ошибки, закрываются вместе с фоновым экспортом и транспортами. Закрытие видно по
// отладочной записи транспорта

&Тест
Процедура ОшибкаСозданияЗакрываетСозданныеПровайдеры() Экспорт

	// Дано - провайдер трассировки с экспортером и none вместе с другим пропагатором
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигЭкспортера.Адрес = "http://localhost:1/v1/traces";
	КонфигПроцессора = Новый ОтелКонфигурацияПакетногоПроцессора();
	КонфигПроцессора.Экспортер = КонфигЭкспортера;
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераТрассировки();
	КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора);
	Модель = НоваяМодель();
	Модель.ПровайдерТрассировки = КонфигПровайдера;
	Модель.Пропагатор = Новый ОтелКонфигурацияПропагатора();
	Модель.Пропагатор.СписокСоставного = "none,tracecontext";
	ИмяЛога = "oscript.lib.opentelemetry.transport";
	Аппендер = СоздатьТестовыйАппендер();
	Логирование.ПолучитьЛог(ИмяЛога).ДобавитьСпособВывода(Аппендер, УровниЛога.Отладка);

	// Когда
	ТекстОшибки = "";
	Попытка
		ОтелКонфигурационнаяФабрика.Создать(Модель);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Тогда
	Логирование.ПолучитьЛог(ИмяЛога).УдалитьСпособВывода(Аппендер);
	Ожидаем.Что(ТекстОшибки).Содержит("none");
	Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "транспорт закрыт")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СоздатьПропагаторыДедупликация() Экспорт

	// Дано - дубликаты должны быть удалены
	КонфигПропагатора = Новый ОтелКонфигурацияПропагатора();
	Пропагатор = КомпонентКонфигурации("tracecontext");
	КонфигПропагатора.Составной.Добавить(Пропагатор);
	КонфигПропагатора.Составной.Добавить(Пропагатор); // BSLLS:DuplicatedInsertionIntoCollection-off

	// Когда
	Пропагаторы = ОтелКонфигурационнаяФабрика.СоздатьПропагаторы(
		КонфигПропагатора);

	// Тогда - должен быть создан без ошибок
	Ожидаем.Что(ТипЗнч(Пропагаторы)).Равно(
		Тип("ОтелКомпозитныйПропагатор"));

КонецПроцедуры

// ===== Полный SDK с конфигурацией =====

&Тест
Процедура СоздатьSdkСПровайдерамиИРесурсом() Экспорт

	// Дано
	Модель = НоваяМодель();

	// Ресурс
	Модель.Ресурс = Новый ОтелКонфигурацияРесурса();
	ЗаписьАтрибута = Новый Структура(
		"Имя, Значение", "service.name", "factory-test");
	Модель.Ресурс.Атрибуты.Добавить(ЗаписьАтрибута);

	// Провайдер трассировки
	Модель.ПровайдерТрассировки = ПровайдерТрассировкиСПроцессором();

	// Провайдер логирования
	Модель.ПровайдерЛогирования = ПровайдерЛогированияСПроцессором();

	// Провайдер метрик
	Модель.ПровайдерМетрик = ПровайдерМетрикСЧитателем();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Ожидаем.Что(ТипЗнч(Sdk)).Равно(Тип("ОтелSdk"));

	// Проверяем что ресурс передан в провайдеры
	ИмяСервисаТрассировки = Sdk.ПровайдерТрассировки().Ресурс().Атрибуты().Получить("service.name");
	ИмяСервисаЛогирования = Sdk.ПровайдерЛогирования().Ресурс().Атрибуты().Получить("service.name");
	ИмяСервисаМетрик = Sdk.ПровайдерМетрик().Ресурс().Атрибуты().Получить("service.name");
	Ожидаем.Что(ИмяСервисаТрассировки).Равно("factory-test");
	Ожидаем.Что(ИмяСервисаЛогирования).Равно("factory-test");
	Ожидаем.Что(ИмяСервисаМетрик).Равно("factory-test");

КонецПроцедуры

