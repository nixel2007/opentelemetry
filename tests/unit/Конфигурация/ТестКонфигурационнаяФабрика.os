// ===== Сэмплеры =====

&Тест
Процедура СоздатьПровайдерТрассировкиСParentBasedСДелегатами() Экспорт

	// Дано - parent_based с полной конфигурацией всех 4 делегатов, отличных от делегатов по умолчанию
	Модель = Новый ОтелКонфигурация();
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераТрассировки();
	КонфигСэмплера = Новый ОтелКонфигурацияСэмплера();
	КонфигСэмплера.Тип = "parent_based";
	КонфигСэмплера.УдаленныйРодительСэмплирован = КонфигСэмплераТипа("always_off");
	КонфигСэмплера.УдаленныйРодительНеСэмплирован = КонфигСэмплераТипа("always_on");
	КонфигСэмплера.ЛокальныйРодительСэмплирован = КонфигСэмплераТипа("trace_id_ratio_based", 0.5);
	КонфигСэмплера.ЛокальныйРодительНеСэмплирован = КонфигСэмплераТипа("always_on");

	КонфигПровайдера.Сэмплер = КонфигСэмплера;
	Модель.ПровайдерТрассировки = КонфигПровайдера;
	Модель.ПровайдерЛогирования = Новый ОтелКонфигурацияПровайдераЛогирования();
	Модель.ПровайдерМетрик = Новый ОтелКонфигурацияПровайдераМетрик();

	// Когда
	Sdk = ОтелКонфигурационнаяФабрика.Создать(Модель);

	// Тогда
	Ожидаем.Что(Sdk.ПровайдерТрассировки().Сэмплер().Описание()).Равно(
		"ParentBased{root:AlwaysOnSampler,remoteParentSampled:AlwaysOffSampler,"
		+ "remoteParentNotSampled:AlwaysOnSampler,localParentSampled:TraceIdRatioBased{0.500000},"
		+ "localParentNotSampled:AlwaysOnSampler}");

КонецПроцедуры

// Configuration SDK, Create: вложенный сэмплер создается со своими параметрами
&Тест
Процедура ДелегатыParentBasedСоздаютсяСоСвоимиПараметрами() Экспорт

	// Дано - у корневого сэмплера и делегата свои доли; делегат - вложенный parent_based
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераТрассировки();
	КонфигСэмплера = Новый ОтелКонфигурацияСэмплера();
	КонфигСэмплера.Тип = "parent_based";
	КонфигСэмплера.Корневой = КонфигСэмплераТипа("trace_id_ratio_based", 0.1);
	КонфигСэмплера.УдаленныйРодительСэмплирован = КонфигСэмплераТипа("trace_id_ratio_based", 0.5);
	ВложенныйСэмплер = КонфигСэмплераТипа("parent_based");
	ВложенныйСэмплер.Корневой = КонфигСэмплераТипа("always_off");
	КонфигСэмплера.ЛокальныйРодительСэмплирован = ВложенныйСэмплер;
	КонфигПровайдера.Сэмплер = КонфигСэмплера;

	// Когда
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(
		Новый ОтелРесурс(), КонфигПровайдера);

	// Тогда
	ОписаниеВложенного = ОписаниеНаОсновеРодителя("AlwaysOffSampler");
	Ожидаем.Что(Провайдер.Сэмплер().Описание()).Равно(
		"ParentBased{root:TraceIdRatioBased{0.100000},remoteParentSampled:TraceIdRatioBased{0.500000},"
		+ "remoteParentNotSampled:AlwaysOffSampler,localParentSampled:"
		+ ОписаниеВложенного + ",localParentNotSampled:AlwaysOffSampler}");
	Провайдер.Закрыть();

КонецПроцедуры

&Тест
Процедура РазрешитьНеизвестногоКорневогоСэмплера() Экспорт

