	// Тогда
	Ожидаем.Что(Провайдер.Сэмплер().Описание()).Равно("TraceIdRatioBased{0.500000}");

КонецПроцедуры

&Тест
Процедура СоздатьПровайдерТрассировкиСParentBasedСэмплером() Экспорт

	// Дано
	Ресурс = Новый ОтелРесурс();
	КонфигПровайдера = ПровайдерТрассировкиСПроцессором();
	КонфигСэмплера = Новый ОтелКонфигурацияСэмплера();
	КонфигСэмплера.Тип = "parent_based";
	КорневойСэмплер = Новый ОтелКонфигурацияСэмплера();
	КорневойСэмплер.Тип = "always_off";
	КонфигСэмплера.Корневой = КорневойСэмплер;
	КонфигПровайдера.Сэмплер = КонфигСэмплера;

	// Когда
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(
		Ресурс, КонфигПровайдера);

	// Тогда
	Ожидаем.Что(Провайдер.Сэмплер().Описание()).Равно(
		ОписаниеНаОсновеРодителя("AlwaysOffSampler"));

КонецПроцедуры

&Тест
Процедура СоздатьПровайдерТрассировкиСЛимитамиСпана() Экспорт

	// Дано
	Ресурс = Новый ОтелРесурс();
	КонфигПровайдера = ПровайдерТрассировкиСПроцессором();

	КонфигЛимитов = Новый ОтелКонфигурацияЛимитовСпана();
	КонфигЛимитов.МаксКоличествоАтрибутов = 64;
	КонфигЛимитов.МаксДлинаЗначенияАтрибута = 256;
	КонфигЛимитов.МаксГлубинаЗначенияАтрибута = 3;
	КонфигЛимитов.МаксСобытий = 32;
	КонфигЛимитов.МаксЛинков = 16;
	КонфигЛимитов.МаксАтрибутовНаСобытие = 8;
	КонфигЛимитов.МаксАтрибутовНаЛинк = 4;
	КонфигПровайдера.Лимиты = КонфигЛимитов;

	// Когда
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(
		Ресурс, КонфигПровайдера);

	// Тогда
	Лимиты = Провайдер.ЛимитыСпана();
	Ожидаем.Что(Лимиты.МаксАтрибутов()).Равно(64);
	Ожидаем.Что(Лимиты.МаксДлинаЗначенияАтрибута()).Равно(256);
	Ожидаем.Что(Лимиты.МаксГлубинаЗначенияАтрибута()).Равно(3);
	Ожидаем.Что(Лимиты.МаксСобытий()).Равно(32);
	Ожидаем.Что(Лимиты.МаксЛинков()).Равно(16);
	Ожидаем.Что(Лимиты.МаксАтрибутовНаСобытие()).Равно(8);
	Ожидаем.Что(Лимиты.МаксАтрибутовНаЛинк()).Равно(4);

КонецПроцедуры

&Тест
Процедура ЛимитыСпанаСРезервомНаГлобальные() Экспорт

	// Дано - нет лимитов в провайдере, есть глобальные
	Ресурс = Новый ОтелРесурс();
	КонфигПровайдера = ПровайдерТрассировкиСПроцессором();

	ГлобальныеЛимиты = Новый ОтелКонфигурацияЛимитовАтрибутов();
	ГлобальныеЛимиты.МаксКоличествоАтрибутов = 50;
	ГлобальныеЛимиты.МаксДлинаЗначенияАтрибута = 100;
	ГлобальныеЛимиты.МаксГлубинаЗначенияАтрибута = 5;

	// Когда
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(
		Ресурс, КонфигПровайдера, ГлобальныеЛимиты);

	// Тогда
	Лимиты = Провайдер.ЛимитыСпана();
	Ожидаем.Что(Лимиты.МаксАтрибутов()).Равно(50);
	Ожидаем.Что(Лимиты.МаксДлинаЗначенияАтрибута()).Равно(100);
	Ожидаем.Что(Лимиты.МаксГлубинаЗначенияАтрибута()).Равно(5);

КонецПроцедуры

// Схема файла конфигурации: attribute_count_limit секции limits провайдера перекрывает
// attribute_limits.attribute_count_limit, а без него действует общий лимит

&Тест
Процедура ЛимитыСпанаБезКоличестваАтрибутовБерутОбщийЛимит() Экспорт

	// Дано - в limits провайдера задано только количество событий
	КонфигПровайдера = ПровайдерТрассировкиСПроцессором();
	КонфигПровайдера.Лимиты = Новый ОтелКонфигурацияЛимитовСпана();
	КонфигПровайдера.Лимиты.МаксСобытий = 10;
	ГлобальныеЛимиты = Новый ОтелКонфигурацияЛимитовАтрибутов();
	ГлобальныеЛимиты.МаксКоличествоАтрибутов = 50;

	// Когда
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(
		Новый ОтелРесурс(), КонфигПровайдера, ГлобальныеЛимиты);

	// Тогда
	Ожидаем.Что(Провайдер.ЛимитыСпана().МаксАтрибутов()).Равно(50);
	Ожидаем.Что(Провайдер.ЛимитыСпана().МаксСобытий()).Равно(10);

КонецПроцедуры

&Тест
Процедура ЛимитыЗаписейЛогаБезКоличестваАтрибутовБерутОбщийЛимит() Экспорт

	// Дано - в limits провайдера задана только длина значения
	КонфигПровайдера = ПровайдерЛогированияСПроцессором();
	КонфигПровайдера.Лимиты = Новый ОтелКонфигурацияЛимитовАтрибутов();
	КонфигПровайдера.Лимиты.МаксДлинаЗначенияАтрибута = 20;
	ГлобальныеЛимиты = Новый ОтелКонфигурацияЛимитовАтрибутов();
	ГлобальныеЛимиты.МаксКоличествоАтрибутов = 50;

	// Когда
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерЛогирования(
		Новый ОтелРесурс(), КонфигПровайдера, ГлобальныеЛимиты);

	// Тогда
	Ожидаем.Что(Провайдер.ЛимитыЗаписейЛога().МаксАтрибутов()).Равно(50);
	Ожидаем.Что(Провайдер.ЛимитыЗаписейЛога().МаксДлинаЗначенияАтрибута()).Равно(20);

КонецПроцедуры

&Тест
Процедура ЛимитКоличестваАтрибутовПоУмолчанию128() Экспорт

	// Дано - лимиты нигде не заданы
	ПровайдерТрассировки = ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(
		Новый ОтелРесурс(), ПровайдерТрассировкиСПроцессором(), Новый ОтелКонфигурацияЛимитовАтрибутов());
	ПровайдерЛогирования = ОтелКонфигурационнаяФабрика.СоздатьПровайдерЛогирования(
		Новый ОтелРесурс(), ПровайдерЛогированияСПроцессором(), Новый ОтелКонфигурацияЛимитовАтрибутов());

	// Тогда
	Ожидаем.Что(ПровайдерТрассировки.ЛимитыСпана().МаксАтрибутов()).Равно(128);
	Ожидаем.Что(ПровайдерЛогирования.ЛимитыЗаписейЛога().МаксАтрибутов()).Равно(128);

КонецПроцедуры

// Схема файла конфигурации: attribute_value_depth_limit секции limits провайдера перекрывает
// attribute_limits.attribute_value_depth_limit, без обоих действует 64

&Тест
Процедура ЛимитГлубиныЗначенияАтрибутаЛоговИзЛимитовПровайдераИлиОбщих() Экспорт

	// Дано
	ГлобальныеЛимиты = Новый ОтелКонфигурацияЛимитовАтрибутов();
	ГлобальныеЛимиты.МаксГлубинаЗначенияАтрибута = 5;
	КонфигСЛимитом = ПровайдерЛогированияСПроцессором();
	КонфигСЛимитом.Лимиты = Новый ОтелКонфигурацияЛимитовАтрибутов();
	КонфигСЛимитом.Лимиты.МаксГлубинаЗначенияАтрибута = 7;
	КонфигБезЛимита = ПровайдерЛогированияСПроцессором();
	КонфигБезЛимита.Лимиты = Новый ОтелКонфигурацияЛимитовАтрибутов();
	КонфигБезЛимита.Лимиты.МаксКоличествоАтрибутов = 10;

	// Когда
	ПровайдерСЛимитом = ОтелКонфигурационнаяФабрика.СоздатьПровайдерЛогирования(
		Новый ОтелРесурс(), КонфигСЛимитом, ГлобальныеЛимиты);
	ПровайдерБезЛимита = ОтелКонфигурационнаяФабрика.СоздатьПровайдерЛогирования(
		Новый ОтелРесурс(), КонфигБезЛимита, ГлобальныеЛимиты);

	// Тогда
	Ожидаем.Что(ПровайдерСЛимитом.ЛимитыЗаписейЛога().МаксГлубинаЗначенияАтрибута()).Равно(7);
	Ожидаем.Что(ПровайдерБезЛимита.ЛимитыЗаписейЛога().МаксГлубинаЗначенияАтрибута()).Равно(5);

КонецПроцедуры

