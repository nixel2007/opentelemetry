// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
#Использовать "../../.."
#Использовать asserts

// ------------------------------------------------------------------
// ОтелКонфигурационнаяФабрика: экспорт по секции otlp_http через тестовые серверы
// ------------------------------------------------------------------

Перем МокСервер;
Перем Порт;
Перем ЗависшийСервер;
Перем ПортЗависшегоСервера;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура ПередВсемиТестами() Экспорт
	Порт = 15318 + Цел(ТекущаяУниверсальнаяДата() - Дата(2025, 1, 1)) % 100;
	КаталогПомощников = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "helpers");
	ПутьСкрипта = ОбъединитьПути(КаталогПомощников, "mock_otlp_server.py");
	МокСервер = СоздатьПроцесс("python3 " + ПутьСкрипта + " " + Формат(Порт, "ЧГ="), , Истина);
	МокСервер.Запустить();
	// Сервер принимает соединение и не отвечает
	ПортЗависшегоСервера = Порт + 500;
	ПутьЗависшегоСервера = ОбъединитьПути(КаталогПомощников, "mock_hanging_tcp_server.py");
	Команда = "python3 " + ПутьЗависшегоСервера + " " + Формат(ПортЗависшегоСервера, "ЧГ=");
	ЗависшийСервер = СоздатьПроцесс(Команда, , Истина);
	ЗависшийСервер.Запустить();
	Приостановить(1000);
КонецПроцедуры

&ПослеВсех
Процедура ПослеВсехТестов() Экспорт
	Если МокСервер <> Неопределено Тогда
		МокСервер.Завершить();
	КонецЕсли;
	Если ЗависшийСервер <> Неопределено Тогда
		ЗависшийСервер.Завершить();
	КонецЕсли;
КонецПроцедуры

// Схема файла конфигурации: заголовки из headers приоритетнее заголовков из headers_list

&Тест
Процедура ЗаголовокИзHeadersПриоритетнееHeadersList() Экспорт

	// Дано - заголовок задан и в headers, и в headers_list; сервер принимает запрос, только если
	//   значение заголовка из headers
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигЭкспортера.Адрес = Адрес(Порт, "/header/X-Test/from-headers");
	КонфигЭкспортера.Заголовки.Добавить(Новый Структура("Имя, Значение", "X-Test", "from-headers"));
	КонфигЭкспортера.СписокЗаголовков = "X-Test=from-list";
	Провайдер = ПровайдерСТелеметрией("traces", КонфигЭкспортера);

	// Когда
	Результат = Провайдер.СброситьБуфер(5000);

	// Тогда
	Провайдер.Закрыть();
	Ожидаем.Что(Результат.Успешно()).ЭтоИстина();

КонецПроцедуры

// Схема файла конфигурации: timeout - наибольшее время ожидания каждого экспорта. Экспорт на сервер,
// который не отвечает, заканчивается по timeout, а не по таймауту экспортера по умолчанию (10000 мс)

&ПараметризованныйТест
&ИсточникЗначение("traces")
&ИсточникЗначение("logs")
&ИсточникЗначение("metrics")
Процедура ТаймаутОграничиваетЭкспорт(Сигнал) Экспорт

	// Дано
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигЭкспортера.Адрес = Адрес(ПортЗависшегоСервера, "/v1/" + Сигнал);
	КонфигЭкспортера.Таймаут = 1000;
	Провайдер = ПровайдерСТелеметрией(Сигнал, КонфигЭкспортера);
	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	// Когда
	Результат = Провайдер.СброситьБуфер(30000);

	// Тогда
	ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
	Провайдер.Закрыть(100);
	Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
	Ожидаем.Что(ДлительностьМс < 3000, ДлительностьМс).ЭтоИстина();

КонецПроцедуры

Функция Адрес(ПортСервера, Путь)
	Возврат "http://localhost:" + Формат(ПортСервера, "ЧГ=") + Путь;
КонецФункции

// Создает провайдер сигнала с экспортером otlp_http и записывает одно измерение, спан или
// запись лога.
Функция ПровайдерСТелеметрией(Сигнал, КонфигЭкспортера)
	Ресурс = Новый ОтелРесурс();
	Если Сигнал = "metrics" Тогда
		КонфигЧитателя = Новый ОтелКонфигурацияПериодическогоЧитателя();
		КонфигЧитателя.Экспортер = КонфигЭкспортера;
		КонфигПровайдера = Новый ОтелКонфигурацияПровайдераМетрик();
		КонфигПровайдера.Читатели.Добавить(КонфигЧитателя);
		Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерМетрик(Ресурс, КонфигПровайдера);
		Провайдер.ПолучитьМетр("test").СоздатьСчетчик("jobs").Добавить(1);
		Возврат Провайдер;
	КонецЕсли;
	КонфигПроцессора = Новый ОтелКонфигурацияПакетногоПроцессора();
	КонфигПроцессора.Экспортер = КонфигЭкспортера;
	Если Сигнал = "traces" Тогда
		КонфигПровайдера = Новый ОтелКонфигурацияПровайдераТрассировки();
		КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора);
		Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(Ресурс, КонфигПровайдера);
		Провайдер.ПолучитьТрассировщик("test").НачатьСпан("span").Завершить();
		Возврат Провайдер;
	КонецЕсли;
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераЛогирования();
	КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора);
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерЛогирования(Ресурс, КонфигПровайдера);
	Логгер = Провайдер.ПолучитьЛоггер("test");
	Логгер.Записать(Логгер.СоздатьЗаписьЛога());
	Возврат Провайдер;
КонецФункции
