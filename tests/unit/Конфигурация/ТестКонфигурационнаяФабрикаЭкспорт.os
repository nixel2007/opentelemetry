// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
#Использовать "../../.."
#Использовать asserts

// ------------------------------------------------------------------
// ОтелКонфигурационнаяФабрика: экспорт по секциям otlp_http и otlp_grpc через тестовые серверы
// ------------------------------------------------------------------

Перем МокСервер;
Перем Порт;
Перем ЗависшийСервер;
Перем ПортЗависшегоСервера;
Перем СерверСтатусов;
Перем ПортСервераСтатусов;
Перем ЖурналСервераСтатусов;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура ПередВсемиТестами() Экспорт
	Порт = 15318 + Цел(ТекущаяУниверсальнаяДата() - Дата(2025, 1, 1)) % 100;
	КаталогПомощников = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "helpers");
	ПутьСкрипта = ОбъединитьПути(КаталогПомощников, "mock_otlp_server.py");
	МокСервер = СоздатьПроцесс("python3 " + ПутьСкрипта + " " + Формат(Порт, "ЧГ="), , Истина);
	МокСервер.Запустить();
	// Сервер принимает соединение и не отвечает
	ПортЗависшегоСервера = Порт + 500;
	ПутьЗависшегоСервера = ОбъединитьПути(КаталогПомощников, "mock_hanging_tcp_server.py");
	Команда = "python3 " + ПутьЗависшегоСервера + " " + Формат(ПортЗависшегоСервера, "ЧГ=");
	ЗависшийСервер = СоздатьПроцесс(Команда, , Истина);
	ЗависшийСервер.Запустить();
	// gRPC-сервер отвечает ошибкой со статусом из метаданных вызова и пишет журнал вызовов
	ПортСервераСтатусов = Порт + 600;
	ЖурналСервераСтатусов = ОбъединитьПути(КаталогВременныхФайлов(),
		"otel-config-grpc-status-" + Формат(ПортСервераСтатусов, "ЧГ=") + ".log");
	ОчиститьЖурналСервераСтатусов();
	ПутьСервераСтатусов = ОбъединитьПути(КаталогПомощников, "mock_grpc_status_server.py");
	КомандаСервераСтатусов = СтрШаблон("python3 ""%1"" %2 ""%3""",
		ПутьСервераСтатусов, Формат(ПортСервераСтатусов, "ЧГ="), ЖурналСервераСтатусов);
	СерверСтатусов = СоздатьПроцесс(КомандаСервераСтатусов, , Истина);
	СерверСтатусов.Запустить();
	Приостановить(1000);
	ДождатьсяПорта(ПортСервераСтатусов);
КонецПроцедуры

&ПослеВсех
Процедура ПослеВсехТестов() Экспорт
	Если МокСервер <> Неопределено Тогда
		МокСервер.Завершить();
	КонецЕсли;
	Если ЗависшийСервер <> Неопределено Тогда
		ЗависшийСервер.Завершить();
	КонецЕсли;
	Если СерверСтатусов <> Неопределено Тогда
		СерверСтатусов.Завершить();
	КонецЕсли;
	ОчиститьЖурналСервераСтатусов();
КонецПроцедуры

// Экспортер otlp_grpc отправляет данные по gRPC на endpoint в сервис сигнала, заголовки headers и
// headers_list - метаданные вызова; при совпадении имён действует headers. Сервер отвечает статусом
// из метаданных x-otel-test-status и записывает его в журнал: статус INVALID_ARGUMENT не повторяется

&ПараметризованныйТест
&ИсточникЗначение("traces")
&ИсточникЗначение("logs")
&ИсточникЗначение("metrics")
Процедура ЭкспортOtlpGrpcДоходитДоСервераСМетаданнымиЗаголовков(Сигнал) Экспорт

	// Дано
	ОчиститьЖурналСервераСтатусов();
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpGrpc();
	КонфигЭкспортера.Адрес = Адрес(ПортСервераСтатусов, "");
	КонфигЭкспортера.Таймаут = 5000;
	КонфигЭкспортера.Заголовки.Добавить(
		Новый Структура("Имя, Значение", "x-otel-test-status", "INVALID_ARGUMENT"));
	КонфигЭкспортера.СписокЗаголовков = "x-otel-test-status=UNAVAILABLE";
	Провайдер = ПровайдерСТелеметрией(Сигнал, КонфигЭкспортера);

	// Когда
	Результат = Провайдер.СброситьБуфер(10000);
	Сценарии = СценарииСервераСтатусов();

	// Тогда - журнал прочитан до закрытия: закрытие провайдера метрик экспортирует еще раз
	Провайдер.Закрыть(1000);
	Ожидаем.Что(Результат.Успешно(), "ответ сервера - ошибка").ЭтоЛожь();
	Ожидаем.Что(Сценарии).Равно("INVALID_ARGUMENT");

КонецПроцедуры

// Схема файла конфигурации: заголовки из headers приоритетнее заголовков из headers_list

&Тест
Процедура ЗаголовокИзHeadersПриоритетнееHeadersList() Экспорт

	// Дано - заголовок задан и в headers, и в headers_list; сервер принимает запрос, только если
	//   значение заголовка из headers
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигЭкспортера.Адрес = Адрес(Порт, "/header/X-Test/from-headers");
	КонфигЭкспортера.Заголовки.Добавить(Новый Структура("Имя, Значение", "X-Test", "from-headers"));
	КонфигЭкспортера.СписокЗаголовков = "X-Test=from-list";
	Провайдер = ПровайдерСТелеметрией("traces", КонфигЭкспортера);

	// Когда
	Результат = Провайдер.СброситьБуфер(5000);

	// Тогда
	Провайдер.Закрыть();
	Ожидаем.Что(Результат.Успешно()).ЭтоИстина();

КонецПроцедуры

// Схема файла конфигурации: заголовок headers со значением null пропускается и не перекрывает заголовок
// с тем же именем из headers_list

&Тест
Процедура ЗаголовокСоЗначениемNullНеПерекрываетHeadersList() Экспорт

	// Дано - сервер принимает запрос, только если значение заголовка из headers_list
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигЭкспортера.Адрес = Адрес(Порт, "/header/X-Test/from-list");
	КонфигЭкспортера.Заголовки.Добавить(Новый Структура("Имя, Значение", "X-Test", Неопределено));
	КонфигЭкспортера.СписокЗаголовков = "X-Test=from-list";
	Провайдер = ПровайдерСТелеметрией("traces", КонфигЭкспортера);

	// Когда
	Результат = Провайдер.СброситьБуфер(5000);

	// Тогда
	Провайдер.Закрыть();
	Ожидаем.Что(Результат.Успешно()).ЭтоИстина();

КонецПроцедуры

// Схема файла конфигурации: timeout - наибольшее время ожидания каждого экспорта. Экспорт на сервер,
// который не отвечает, заканчивается по timeout, а не по таймауту экспортера по умолчанию (10000 мс)

&ПараметризованныйТест
&ИсточникЗначение("traces")
&ИсточникЗначение("logs")
&ИсточникЗначение("metrics")
Процедура ТаймаутОграничиваетЭкспорт(Сигнал) Экспорт

	// Дано
	КонфигЭкспортера = Новый ОтелКонфигурацияЭкспортераOtlpHttp();
	КонфигЭкспортера.Адрес = Адрес(ПортЗависшегоСервера, "/v1/" + Сигнал);
	КонфигЭкспортера.Таймаут = 1000;
	Провайдер = ПровайдерСТелеметрией(Сигнал, КонфигЭкспортера);
	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

	// Когда
	Результат = Провайдер.СброситьБуфер(30000);

	// Тогда
	ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
	Провайдер.Закрыть(100);
	Ожидаем.Что(Результат.Успешно()).ЭтоЛожь();
	Ожидаем.Что(ДлительностьМс < 3000, ДлительностьМс).ЭтоИстина();

КонецПроцедуры

Функция Адрес(ПортСервера, Путь)
	Возврат "http://localhost:" + Формат(ПортСервера, "ЧГ=") + Путь;
КонецФункции

// Возвращает статусы вызовов тестового gRPC-сервера из журнала через запятую по порядку.
Функция СценарииСервераСтатусов()
	Сценарии = Новый Массив();
	Если НЕ Новый Файл(ЖурналСервераСтатусов).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Чтение = Новый ЧтениеТекста(ЖурналСервераСтатусов, КодировкаТекста.UTF8);
	Строка = Чтение.ПрочитатьСтроку();
	Пока Строка <> Неопределено Цикл
		Сценарии.Добавить(СтрРазделить(Строка, Символы.Таб)[0]);
		Строка = Чтение.ПрочитатьСтроку();
	КонецЦикла;
	Чтение.Закрыть();
	Возврат СтрСоединить(Сценарии, ",");
КонецФункции

Процедура ОчиститьЖурналСервераСтатусов()
	Если Новый Файл(ЖурналСервераСтатусов).Существует() Тогда
		УдалитьФайлы(ЖурналСервераСтатусов);
	КонецЕсли;
КонецПроцедуры

// Ждет, пока тестовый сервер начнет принимать соединения, не дольше 10 с.
Процедура ДождатьсяПорта(ПортСервера)
	Срок = ТекущаяУниверсальнаяДатаВМиллисекундах() + 10000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Срок Цикл
		Попытка
			Соединение = Новый TCPСоединение("localhost", ПортСервера);
			Соединение.Закрыть();
			Возврат;
		Исключение
			Приостановить(200);
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

// Создает провайдер сигнала с экспортером otlp_http и записывает одно измерение, спан или
// запись лога.
Функция ПровайдерСТелеметрией(Сигнал, КонфигЭкспортера)
	Ресурс = Новый ОтелРесурс();
	Если Сигнал = "metrics" Тогда
		КонфигЧитателя = Новый ОтелКонфигурацияПериодическогоЧитателя();
		КонфигЧитателя.Экспортер = КонфигЭкспортера;
		КонфигПровайдера = Новый ОтелКонфигурацияПровайдераМетрик();
		КонфигПровайдера.Читатели.Добавить(КонфигЧитателя);
		Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерМетрик(Ресурс, КонфигПровайдера);
		Провайдер.ПолучитьМетр("test").СоздатьСчетчик("jobs").Добавить(1);
		Возврат Провайдер;
	КонецЕсли;
	КонфигПроцессора = Новый ОтелКонфигурацияПакетногоПроцессора();
	КонфигПроцессора.Экспортер = КонфигЭкспортера;
	Если Сигнал = "traces" Тогда
		КонфигПровайдера = Новый ОтелКонфигурацияПровайдераТрассировки();
		КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора);
		Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерТрассировки(Ресурс, КонфигПровайдера);
		Провайдер.ПолучитьТрассировщик("test").НачатьСпан("span").Завершить();
		Возврат Провайдер;
	КонецЕсли;
	КонфигПровайдера = Новый ОтелКонфигурацияПровайдераЛогирования();
	КонфигПровайдера.Процессоры.Добавить(КонфигПроцессора);
	Провайдер = ОтелКонфигурационнаяФабрика.СоздатьПровайдерЛогирования(Ресурс, КонфигПровайдера);
	Логгер = Провайдер.ПолучитьЛоггер("test");
	Логгер.Записать(Логгер.СоздатьЗаписьЛога());
	Возврат Провайдер;
КонецФункции
