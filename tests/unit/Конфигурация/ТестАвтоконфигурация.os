    // Тогда - действуют общие лимиты, о специфичном значении есть предупреждение
    ЗакончитьЗахватЛога(Аппендер);
    Ожидаем.Что(Лимиты.МаксАтрибутов()).Равно(64);
    Ожидаем.Что(Лимиты.МаксДлинаЗначенияАтрибута()).Равно(1024);
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "otel.span.attribute.count.limit"), "предупреждение")
        .ЭтоИстина();

