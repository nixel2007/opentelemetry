    Параметры.Вставить("otel.exporter.otlp.traces.endpoint", "ftp://host:21");
    Параметры.Вставить("otel.traces.sampler", "traceidratio");
    Параметры.Вставить("otel.traces.sampler.arg", "0.25");
    Параметры.Вставить("otel.span.attribute.count.limit", "7");

    // Когда
    Провайдер = ОтелАвтоконфигурация.СоздатьПровайдерТрассировки(МенеджерИзСоответствия(Параметры));

    // Тогда
    Ожидаем.Что(Провайдер.СтратегияСэмплирования()).Равно(ОтелСэмплер.ПоДолеТрассировок());
    Ожидаем.Что(Провайдер.ДоляСэмплирования()).Равно(0.25);
    Ожидаем.Что(Провайдер.ЛимитыСпана().МаксАтрибутов()).Равно(7);
    Провайдер.Закрыть();

