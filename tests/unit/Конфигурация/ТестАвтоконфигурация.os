    Параметры.Вставить("otel.span.attribute.count.limit", "abc");
    Параметры.Вставить("otel.attribute.count.limit", "64");
    Параметры.Вставить("otel.span.attribute.value.length.limit", "-5");
    Параметры.Вставить("otel.attribute.value.length.limit", "1024");
