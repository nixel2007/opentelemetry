&Тест
Процедура АтрибутыРесурсаСЭлементомБезРавноОтбрасываютсяЦеликом() Экспорт

    // Дано - элемент без "=" - ошибка разбора (Resource SDK: при любой ошибке значение
    // отбрасывается целиком, ошибка сообщается, SDK продолжает работу)
    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.resource.attributes", "ключ=значение,malformed_no_equals");

    Менеджер = Новый МенеджерПараметров();
    Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровСоответствие(Параметры));
    Менеджер.Прочитать();

    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.config");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Ошибка);

    // Когда - не должно падать
    Ресурс = ОтелАвтоконфигурация.СоздатьРесурс(Менеджер);

    // Тогда
    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);
    Ожидаем.Что(Ресурс.Атрибуты().Получить("ключ"), "корректная пара того же значения").Равно(Неопределено);
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "OTEL_RESOURCE_ATTRIBUTES"), "ошибка в логе").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АтрибутыРесурсаСОшибкойДекодированияОтбрасываютсяЦеликом() Экспорт

    // Дано - некорректный percent-encoding в одном из значений (Resource SDK: при ошибке
    // декодирования значение отбрасывается целиком, ошибка сообщается)
    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.resource.attributes", "a=%ZZ,b=1");

    Менеджер = Новый МенеджерПараметров();
    Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровСоответствие(Параметры));
    Менеджер.Прочитать();

    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.config");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Ошибка);

    // Когда
    Ресурс = ОтелАвтоконфигурация.СоздатьРесурс(Менеджер);

    // Тогда
    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);
    Ожидаем.Что(Ресурс.Атрибуты().Получить("a"), "атрибут с ошибкой").Равно(Неопределено);
    Ожидаем.Что(Ресурс.Атрибуты().Получить("b"), "остальные атрибуты значения").Равно(Неопределено);
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "OTEL_RESOURCE_ATTRIBUTES"), "ошибка в логе").ЭтоИстина();

КонецПроцедуры

