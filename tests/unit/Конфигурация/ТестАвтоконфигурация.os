&Тест
Процедура ПровайдерМетрикСЭкспортеромИмеетЧитатель() Экспорт

    // Дано - конфигурация с otlp экспортером метрик
    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.traces.exporter", "none");
    Параметры.Вставить("otel.logs.exporter", "none");
    Параметры.Вставить("otel.metrics.exporter", "otlp");
    Параметры.Вставить("otel.metric.export.interval", "100");
    Параметры.Вставить("otel.exporter.otlp.timeout", "1");
    Параметры.Вставить("otel.service.name", "тест-сервис");

    Менеджер = Новый МенеджерПараметров();
    Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровСоответствие(Параметры));
    Менеджер.Прочитать();

    // Когда
    Провайдер = ОтелАвтоконфигурация.СоздатьПровайдерМетрик(Менеджер);

    // Тогда - провайдер содержит читатель метрик
    Ожидаем.Что(Провайдер.ЧитательМетрик()).Не_().Равно(Неопределено);

    // Очистка - закрыть чтобы остановить фоновый поток
    Провайдер.Закрыть();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("|30000")
&ИсточникЗначение("1500|1500")
&ИсточникЗначение("abc|30000")
Процедура ТаймаутЭкспортаМетрикИзOTEL_METRIC_EXPORT_TIMEOUT(Случай) Экспорт

    // Дано - значение otel.metric.export.timeout|ожидаемый таймаут экспорта читателя
    Части = СтрРазделить(Случай, "|");
    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.traces.exporter", "none");
    Параметры.Вставить("otel.logs.exporter", "none");
    Параметры.Вставить("otel.metrics.exporter", "otlp");
    Параметры.Вставить("otel.metric.export.interval", "100");
    Параметры.Вставить("otel.exporter.otlp.timeout", "1");
    Если Части[0] <> "" Тогда
        Параметры.Вставить("otel.metric.export.timeout", Части[0]);
    КонецЕсли;

    Менеджер = Новый МенеджерПараметров();
    Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровСоответствие(Параметры));
    Менеджер.Прочитать();

    // Когда
    Провайдер = ОтелАвтоконфигурация.СоздатьПровайдерМетрик(Менеджер);

    // Тогда
    Ожидаем.Что(Провайдер.ЧитательМетрик().ТаймаутЭкспортаМс()).Равно(Число(Части[1]));
    Провайдер.Закрыть();

КонецПроцедуры

// OTEL_METRICS_EXPORTER=prometheus автоконфигурация не поддерживает: HTTP-сервера в SDK нет, Prometheus-
// читатель приложение создает и отдает само. Значение нераспознанное: предупреждение и экспортер otlp

&Тест
Процедура ЭкспортерМетрикPrometheusНеПоддерживается() Экспорт

    // Дано
    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.metrics.exporter", "prometheus");
    Параметры.Вставить("otel.exporter.otlp.timeout", "1");
    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.config");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);

    // Когда
    Провайдер = ОтелАвтоконфигурация.СоздатьПровайдерМетрик(МенеджерИзСоответствия(Параметры));

    // Тогда
    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);
    Читатель = Провайдер.ЧитательМетрик();
    Провайдер.Закрыть();
    Ожидаем.Что(ТипЗнч(Читатель)).Равно(Тип("ОтелПериодическийЧитательМетрик"));
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "prometheus"), "предупреждение в логе").ЭтоИстина();

КонецПроцедуры

