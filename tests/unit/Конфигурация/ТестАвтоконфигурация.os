&Тест
Процедура РазрешитьМенеджерКэшированный() Экспорт

    // Дано - инициализация SDK устанавливает кэшированный менеджер
    Менеджер = СоздатьМенеджерСПараметрами();
    Сдк = ОтелАвтоконфигурация.Инициализировать(Менеджер);

    // Когда - повторный вызов без менеджера использует кэшированный
    Провайдер = ОтелАвтоконфигурация.СоздатьПровайдерТрассировки();

    // Тогда - провайдер создан из кэшированного менеджера
    Ожидаем.Что(Провайдер).Не_().Равно(Неопределено);
    Провайдер.Закрыть();
    Сдк.Закрыть();

КонецПроцедуры

&Тест
Процедура ПодготовитьМенеджерБезПредварительногоЧтения() Экспорт

    // Дано - менеджер параметров, который ещё не был прочитан
    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.traces.exporter", "none");
    Параметры.Вставить("otel.logs.exporter", "none");
    Параметры.Вставить("otel.metrics.exporter", "none");
    Параметры.Вставить("otel.service.name", "тест-сервис");

    МенеджерБезЧтения = Новый МенеджерПараметров();
    МенеджерБезЧтения.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровСоответствие(Параметры));
    // НЕ вызываем Прочитать() - менеджер ещё не прочитан

    // Когда - передаём непрочитанный менеджер в СоздатьПровайдерТрассировки
    Провайдер = ОтелАвтоконфигурация.СоздатьПровайдерТрассировки(МенеджерБезЧтения);

    // Тогда - провайдер создан (ПодготовитьМенеджер вызвал Прочитать() автоматически)
    Ожидаем.Что(Провайдер).Не_().Равно(Неопределено);
    Провайдер.Закрыть();

КонецПроцедуры

Функция СоздатьМенеджерССэмплером(ИмяСэмплера, АргументСэмплера = Неопределено)
    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.traces.exporter", "otlp");
    Параметры.Вставить("otel.logs.exporter", "none");
    Параметры.Вставить("otel.metrics.exporter", "none");
    Параметры.Вставить("otel.bsp.schedule.delay", "100");
    Параметры.Вставить("otel.exporter.otlp.timeout", "1");
    Параметры.Вставить("otel.traces.sampler", ИмяСэмплера);
    Если АргументСэмплера <> Неопределено Тогда
        Параметры.Вставить("otel.traces.sampler.arg", АргументСэмплера);
    КонецЕсли;

    Менеджер = Новый МенеджерПараметров();
    Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровСоответствие(Параметры));
    Менеджер.Прочитать();
    Возврат Менеджер;
КонецФункции

&Тест
Процедура СоздатьПровайдерТрассировкиТранспортОтсутствует() Экспорт

    // Дано - endpoint с неподдерживаемой схемой ftp (транспорт = Неопределено)
    Параметры = Новый Соответствие();
