&Тест
Процедура СоздатьПровайдерТрассировкиСэмплерПоУмолчанию() Экспорт

    // Дано - конфигурация с otlp трассировкой, без явного otel.traces.sampler
    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.traces.exporter", "none");
    Параметры.Вставить("otel.logs.exporter", "none");
    Параметры.Вставить("otel.metrics.exporter", "none");

    Менеджер = Новый МенеджерПараметров();
    Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровСоответствие(Параметры));
    Менеджер.Прочитать();

    // Когда - sampler не задан, используется ParentBased(AlwaysOn)
    Провайдер = ОтелАвтоконфигурация.СоздатьПровайдерТрассировки(Менеджер);

    // Тогда - провайдер создан с сэмплером по умолчанию и без экспортера
    Ожидаем.Что(Провайдер.СтратегияСэмплирования()).Равно(ОтелСэмплер.НаОсновеРодителя());
    Ожидаем.Что(Провайдер.КорневаяСтратегия()).Равно(ОтелСэмплер.ВсегдаВключен());
    Провайдер.Закрыть();

КонецПроцедуры

// SDK Environment Variables: сэмплер и лимиты из окружения действуют и без экспортера
// (exporter = none или недоступный транспорт): решение сэмплера задает флаг sampled, который
// передается дальше, а спаны и записи получают процессоры, добавленные в коде

&ПараметризованныйТест
