    Менеджер = Новый МенеджерПараметров();
    Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровСоответствие(Параметры));
    Менеджер.Прочитать();

    // Когда
    Транспорт = ОтелАвтоконфигурация.СоздатьТранспорт(Менеджер);

    // Тогда
    Ожидаем.Что(ТипЗнч(Транспорт)).Равно(Тип("ОтелGrpcТранспорт"));

КонецПроцедуры

&Тест
Процедура СоздатьТранспортНеизвестныйПротоколПредупреждает() Экспорт

    // Дано - нераспознанное значение протокола
    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.exporter.otlp.protocol", "unknown_proto");

    Менеджер = Новый МенеджерПараметров();
    Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровСоответствие(Параметры));
    Менеджер.Прочитать();

    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.config");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);

    // Когда
    Транспорт = ОтелАвтоконфигурация.СоздатьТранспорт(Менеджер);

    // Тогда - предупреждение и HTTP-транспорт по умолчанию
    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);
    Ожидаем.Что(ТипЗнч(Транспорт)).Равно(Тип("ОтелHttpТранспорт"));
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "unknown_proto"), "предупреждение в логе").ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("zstd-unknown|да")
&ИсточникЗначение("NONE|нет")
&ИсточникЗначение("Gzip|нет")
Процедура НеизвестноеСжатиеПредупреждает(Случай) Экспорт

    // Дано - otel.exporter.otlp.compression: gzip и none распознаются без учета регистра,
    // о нераспознанном значении enum SHOULD выводиться предупреждение
    Части = СтрРазделить(Случай, "|");
    Сжатие = Части[0];
    ОжидаетсяПредупреждение = Части[1] = "да";

    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.exporter.otlp.compression", Сжатие);

    Менеджер = Новый МенеджерПараметров();
    Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровСоответствие(Параметры));
    Менеджер.Прочитать();

    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.config");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);

    // Когда - общий транспорт и транспорт сигнала
    ОтелАвтоконфигурация.СоздатьТранспорт(Менеджер);
    ПредупреждениеОбщего = ЕстьСообщениеСТекстом(Аппендер, Сжатие);
    Аппендер.События.Очистить();
    ОтелАвтоконфигурация.СоздатьТранспортДляСигнала(Менеджер, "traces");
    ПредупреждениеСигнала = ЕстьСообщениеСТекстом(Аппендер, Сжатие);

    // Тогда
    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);
    Ожидаем.Что(ПредупреждениеОбщего, "СоздатьТранспорт").Равно(ОжидаетсяПредупреждение);
    Ожидаем.Что(ПредупреждениеСигнала, "СоздатьТранспортДляСигнала").Равно(ОжидаетсяПредупреждение);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("base2_exponential_bucket_histogram|base2_exponential_bucket_histogram|нет")
&ИсточникЗначение("BASE2_Exponential_Bucket_Histogram|base2_exponential_bucket_histogram|нет")
&ИсточникЗначение("explicit_bucket_histogram|explicit_bucket_histogram|нет")
&ИсточникЗначение("weird_histogram|explicit_bucket_histogram|да")
Процедура АгрегацияГистограммПоУмолчаниюИзОкружения(Случай) Экспорт

    // Дано - OTEL_EXPORTER_OTLP_METRICS_DEFAULT_HISTOGRAM_AGGREGATION задает агрегацию гистограмм
    // читателя: провайдер берет ее у первого читателя для всех создаваемых метров
    Части = СтрРазделить(Случай, "|");
    Агрегация = Части[0];
    ОжидаемаяАгрегация = Части[1];
    ОжидаетсяПредупреждение = Части[2] = "да";

    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.traces.exporter", "none");
    Параметры.Вставить("otel.logs.exporter", "none");
    Параметры.Вставить("otel.metrics.exporter", "otlp");
    Параметры.Вставить("otel.exporter.otlp.metrics.default.histogram.aggregation", Агрегация);
    Параметры.Вставить("otel.metric.export.interval", "100");
    Параметры.Вставить("otel.exporter.otlp.timeout", "1");

    Менеджер = Новый МенеджерПараметров();
    Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровСоответствие(Параметры));
    Менеджер.Прочитать();

    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.config");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);

    // Когда
    Провайдер = ОтелАвтоконфигурация.СоздатьПровайдерМетрик(Менеджер);

    // Тогда
    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);
    АгрегацияЧитателя = Провайдер.ЧитательМетрик().АгрегацияГистограммПоУмолчанию();
    Провайдер.Закрыть();
    Ожидаем.Что(АгрегацияЧитателя, "агрегация гистограмм читателя").Равно(ОжидаемаяАгрегация);
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, Агрегация), "предупреждение в логе").Равно(ОжидаетсяПредупреждение);

КонецПроцедуры

