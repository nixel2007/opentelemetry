    // Когда
    ОтелАвтоконфигурация.СоздатьПропагаторы(МенеджерИзСоответствия(Параметры));

    // Тогда - в предупреждении значение пользователя, а не нормализованное
    ЗакончитьЗахватЛога(Аппендер);
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, """MyVendor"""), "предупреждение").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОтключенныйSdkПрименяетПропагаторы() Экспорт

    // Дано - отключение SDK не влияет на пропагаторы из OTEL_PROPAGATORS
    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.sdk.disabled", "true");
    Параметры.Вставить("otel.propagators", "none");

    // Когда
    ОтелАвтоконфигурация.Инициализировать(МенеджерИзСоответствия(Параметры));

    // Тогда
    Ожидаем.Что(ТипЗнч(ОтелГлобальный.ПолучитьПропагаторы())).Равно(Тип("ОтелНоопПропагатор"));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("none")
&ИсточникЗначение("otlp")
Процедура ФильтрЭкземпляровИзКонфигурацииПрименяется(Экспортер) Экспорт

    // Дано - OTEL_METRICS_EXEMPLAR_FILTER читается без учета регистра
    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.metrics.exporter", Экспортер);
    Параметры.Вставить("otel.exporter.otlp.timeout", "1");
    Параметры.Вставить("otel.metrics.exemplar.filter", "ALWAYS_OFF");

    // Когда
    Провайдер = ОтелАвтоконфигурация.СоздатьПровайдерМетрик(МенеджерИзСоответствия(Параметры));

    // Тогда
    Фильтр = Провайдер.ФильтрЭкземпляров();
    Провайдер.Закрыть(1000);
    Ожидаем.Что(Фильтр).Равно(ОтелФильтрЭкземпляров.ВсегдаВыключен());

КонецПроцедуры

&Тест
Процедура ПустойФильтрЭкземпляровКакНезаданный() Экспорт

    // Дано - пустое значение переменной равносильно незаданной
    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.metrics.exporter", "none");
    Параметры.Вставить("otel.metrics.exemplar.filter", "");
    Аппендер = НачатьЗахватЛога();

    // Когда
    Провайдер = ОтелАвтоконфигурация.СоздатьПровайдерМетрик(МенеджерИзСоответствия(Параметры));

    // Тогда - фильтр по умолчанию, без предупреждения
    ЗакончитьЗахватЛога(Аппендер);
    Ожидаем.Что(Провайдер.ФильтрЭкземпляров()).Равно(ОтелФильтрЭкземпляров.ПоТрассировке());
    Ожидаем.Что(Аппендер.События.Количество(), "предупреждения").Равно(0);

КонецПроцедуры

&Тест
Процедура НераспознанныйФильтрЭкземпляровПредупреждает() Экспорт

    // Дано
    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.metrics.exporter", "none");
    Параметры.Вставить("otel.metrics.exemplar.filter", "sometimes");
    Аппендер = НачатьЗахватЛога();

    // Когда
    Провайдер = ОтелАвтоконфигурация.СоздатьПровайдерМетрик(МенеджерИзСоответствия(Параметры));

    // Тогда
    ЗакончитьЗахватЛога(Аппендер);
    Ожидаем.Что(Провайдер.ФильтрЭкземпляров()).Равно(ОтелФильтрЭкземпляров.ПоТрассировке());
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "sometimes"), "предупреждение").ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("false|1500|1500|нет")
&ИсточникЗначение("true|1500|1500|нет")
&ИсточникЗначение("false|0|0|нет")
&ИсточникЗначение("false|abc|30000|да")
&ИсточникЗначение("false|-1|30000|да")
&ИсточникЗначение("false|2.5|30000|да")
Процедура ТаймаутЗакрытияSdkИзКонфигурации(Случай) Экспорт

    // Дано - OTEL_SDK_SHUTDOWN_TIMEOUT: Timeout, 0 - без ограничения, некорректное значение
    //   дает предупреждение и значение по умолчанию
    Части = СтрРазделить(Случай, "|");
    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.sdk.disabled", Части[0]);
    Параметры.Вставить("otel.traces.exporter", "none");
    Параметры.Вставить("otel.logs.exporter", "none");
    Параметры.Вставить("otel.metrics.exporter", "none");
    Параметры.Вставить("otel.sdk.shutdown.timeout", Части[1]);
    Аппендер = НачатьЗахватЛога();

    // Когда
    Сдк = ОтелАвтоконфигурация.Инициализировать(МенеджерИзСоответствия(Параметры));

    // Тогда
    ЗакончитьЗахватЛога(Аппендер);
    Ожидаем.Что(Сдк.ТаймаутЗакрытия()).Равно(Число(Части[2]));
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "otel.sdk.shutdown.timeout"), "предупреждение")
        .Равно(Части[3] = "да");

КонецПроцедуры

Функция МенеджерИзСоответствия(Параметры)
    Менеджер = Новый МенеджерПараметров();
    Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровСоответствие(Параметры));
    Менеджер.Прочитать();
    Возврат Менеджер;
КонецФункции

Функция НачатьЗахватЛога()
    Аппендер = СоздатьТестовыйАппендер();
    Логирование.ПолучитьЛог("oscript.lib.opentelemetry.config")
        .ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);
    Возврат Аппендер;
КонецФункции

Процедура ЗакончитьЗахватЛога(Аппендер)
    Логирование.ПолучитьЛог("oscript.lib.opentelemetry.config").УдалитьСпособВывода(Аппендер);
КонецПроцедуры

Функция СоздатьТестовыйАппендер()
    Текст = "Перем События Экспорт;
    |Процедура ВывестиСобытие(Событие) Экспорт
    |    События.Добавить(Событие);
    |КонецПроцедуры
    |Процедура Закрыть() Экспорт
    |КонецПроцедуры
    |Процедура УстановитьСвойство(Имя, Значение) Экспорт
    |КонецПроцедуры
    |События = Новый Массив();";
    Возврат ЗагрузитьСценарийИзСтроки(Текст);
КонецФункции

Функция ЕстьСообщениеСТекстом(Аппендер, Текст)
    Для Каждого Событие Из Аппендер.События Цикл
        Если СтрНайти(Событие.ПолучитьСообщение(), Текст) > 0 Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции
