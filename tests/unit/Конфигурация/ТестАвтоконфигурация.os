&ПараметризованныйТест
&ИсточникЗначение("traceidratio|1.5|1|да")
&ИсточникЗначение("parentbased_traceidratio|1.5|1|да")
&ИсточникЗначение("traceidratio|0.25|0.25|нет")
&ИсточникЗначение("traceidratio|0.00|0|нет")
&ИсточникЗначение("traceidratio|00|0|нет")
&ИсточникЗначение("traceidratio|-0.0|0|нет")
Процедура АргументСэмплераВнеДиапазонаИгнорируется(Случай) Экспорт

    // Дано - доля сэмплирования; значение вне [0; 1] по спецификации логируется и
    // игнорируется, как если бы otel.traces.sampler.arg не был задан (доля 1.0)
    Части = СтрРазделить(Случай, "|");
    Аргумент = Части[1];
    Менеджер = СоздатьМенеджерССэмплером(Части[0], Аргумент);
    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.config");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);

    // Когда
    Провайдер = ОтелАвтоконфигурация.СоздатьПровайдерТрассировки(Менеджер);

    // Тогда
    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);
    Доля = Провайдер.ДоляСэмплирования();
    Провайдер.Закрыть();
    Ожидаем.Что(Доля, "доля сэмплирования").Равно(Число(Части[2]));
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, Аргумент), "предупреждение в логе").Равно(Части[3] = "да");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("traces|otel.bsp")
&ИсточникЗначение("logs|otel.blrp")
Процедура РазмерПакетаБольшеОчередиЗаменяетсяРазмеромОчереди(Случай) Экспорт

    // Дано - спецификация: max.export.batch.size не больше max.queue.size, иначе пакет
    // не наберется и выгрузка по заполнению очереди не сработает
    Части = СтрРазделить(Случай, "|");
    Сигнал = Части[0];
    Префикс = Части[1];

    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.traces.exporter", ?(Сигнал = "traces", "otlp", "none"));
    Параметры.Вставить("otel.logs.exporter", ?(Сигнал = "logs", "otlp", "none"));
    Параметры.Вставить("otel.metrics.exporter", "none");
    Параметры.Вставить("otel.exporter.otlp.timeout", "1");
    Параметры.Вставить(Префикс + ".max.queue.size", "2");
    Параметры.Вставить(Префикс + ".max.export.batch.size", "5");

    Менеджер = Новый МенеджерПараметров();
    Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровСоответствие(Параметры));
    Менеджер.Прочитать();

    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.config");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);

    // Когда
    Попытка
        Если Сигнал = "traces" Тогда
            Провайдер = ОтелАвтоконфигурация.СоздатьПровайдерТрассировки(Менеджер);
        Иначе
            Провайдер = ОтелАвтоконфигурация.СоздатьПровайдерЛогирования(Менеджер);
        КонецЕсли;
    Исключение
        Лог.УдалитьСпособВывода(Аппендер);
        ВызватьИсключение;
    КонецПопытки;
    Лог.УдалитьСпособВывода(Аппендер);
    Провайдер.Закрыть(1000);

    // Тогда - предупреждение называет оба параметра и примененный размер пакета
    Ожидаемое = СтрШаблон("%1.max.export.batch.size (5) больше %1.max.queue.size (2), используется 2", Префикс);
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, Ожидаемое), "предупреждение в логе").ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("traces|otel.bsp.max.queue.size|2048|0")
&ИсточникЗначение("traces|otel.bsp.max.export.batch.size|512|0")
&ИсточникЗначение("logs|otel.blrp.max.queue.size|2048|0")
&ИсточникЗначение("logs|otel.blrp.max.export.batch.size|512|0")
&ИсточникЗначение("traces|otel.bsp.max.queue.size|2048|1.5")
&ИсточникЗначение("logs|otel.blrp.max.export.batch.size|512|2.5")
Процедура НекорректныйРазмерПакетногоПроцессораИгнорируется(Случай) Экспорт

    // Дано - размер очереди или пакета - целое число больше нуля: 0 вне допустимого
    // диапазона, дробное значение не целое. По спецификации переменных окружения -
    // предупреждение и значение по умолчанию
    Части = СтрРазделить(Случай, "|");
    Сигнал = Части[0];
    Ключ = Части[1];
    Умолчание = Части[2];

    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.traces.exporter", ?(Сигнал = "traces", "otlp", "none"));
    Параметры.Вставить("otel.logs.exporter", ?(Сигнал = "logs", "otlp", "none"));
    Параметры.Вставить("otel.metrics.exporter", "none");
    Параметры.Вставить("otel.exporter.otlp.timeout", "1");
    Параметры.Вставить(Ключ, Части[3]);

    Менеджер = Новый МенеджерПараметров();
    Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровСоответствие(Параметры));
    Менеджер.Прочитать();

    Аппендер = СоздатьТестовыйАппендер();
    Лог = Логирование.ПолучитьЛог("oscript.lib.opentelemetry.config");
    Лог.ДобавитьСпособВывода(Аппендер, УровниЛога.Предупреждение);

    // Когда
    Если Сигнал = "traces" Тогда
        Провайдер = ОтелАвтоконфигурация.СоздатьПровайдерТрассировки(Менеджер);
    Иначе
        Провайдер = ОтелАвтоконфигурация.СоздатьПровайдерЛогирования(Менеджер);
    КонецЕсли;

    // Тогда - предупреждение называет параметр и примененное значение по умолчанию
    Лог.УдалитьСпособВывода(Аппендер);
    Логирование.ЗакрытьЛог(Лог);
    Провайдер.Закрыть(1000);
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, Ключ), "предупреждение в логе").ЭтоИстина();
    Ожидаем.Что(ЕстьСообщениеСТекстом(Аппендер, "значение по умолчанию " + Умолчание), "значение по умолчанию")
        .ЭтоИстина();

КонецПроцедуры

