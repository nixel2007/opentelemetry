&Тест
Процедура СэмплерAlwaysOff() Экспорт

    // Дано
    Менеджер = СоздатьМенеджерССэмплером("always_off");

    // Когда
    Провайдер = ОтелАвтоконфигурация.СоздатьПровайдерТрассировки(Менеджер);

    // Тогда - спаны не записываются
    Трассировщик = Провайдер.ПолучитьТрассировщик("тест");
    Спан = Трассировщик.НачатьСпан("операция");
    Ожидаем.Что(Спан.ЗаписьАктивна()).Равно(Ложь);
    Спан.Завершить();
    Провайдер.Закрыть();

КонецПроцедуры

