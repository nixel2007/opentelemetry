    // Тогда - значения по умолчанию: длина значения без ограничения
    Ожидаем.Что(Лимиты.МаксАтрибутов()).Равно(128);
    Ожидаем.Что(Лимиты.МаксДлинаЗначенияАтрибута()).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура НулевыеЛимитыИзКонфигурацииСохраняются() Экспорт

    // Дано - по спецификации лимиты - неотрицательные целые, 0 - допустимый нулевой лимит
    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.attribute.value.length.limit", "0");
    Параметры.Вставить("otel.event.attribute.count.limit", "0");
    Параметры.Вставить("otel.link.attribute.count.limit", "0");
    Менеджер = МенеджерИзСоответствия(Параметры);

    // Когда
    ЛимитыСпана = ОтелАвтоконфигурация.СоздатьЛимитыСпана(Менеджер);
    ЛимитыЛога = ОтелАвтоконфигурация.СоздатьЛимитыЗаписейЛога(Менеджер);

    // Тогда
    Ожидаем.Что(ЛимитыСпана.МаксДлинаЗначенияАтрибута()).Равно(0);
    Ожидаем.Что(ЛимитыСпана.МаксАтрибутовНаСобытие()).Равно(0);
    Ожидаем.Что(ЛимитыСпана.МаксАтрибутовНаЛинк()).Равно(0);
    Ожидаем.Что(ЛимитыЛога.МаксДлинаЗначенияАтрибута()).Равно(0);

