// OTLP/gRPC: адрес сигнала - цель соединения, сервис gRPC выбирается по пути сигнала;
// с пустым путем gRPC-транспорт отклоняет каждую отправку как "неизвестный путь"
&Тест
Процедура GrpcСАдресомСигналаОтправляетВСервисСигнала() Экспорт

    // Дано
    Параметры = Новый Соответствие();
    Параметры.Вставить("otel.exporter.otlp.protocol", "grpc");
    Параметры.Вставить("otel.exporter.otlp.traces.endpoint", "http://localhost:1");

    // Когда
    Результат = ОтелАвтоконфигурация.СоздатьТранспортДляСигнала(МенеджерИзСоответствия(Параметры), "traces");

    // Тогда
    Ожидаем.Что(ТипЗнч(Результат.Транспорт)).Равно(Тип("ОтелGrpcТранспорт"));
    Ожидаем.Что(Результат.ПутьСигнала).Равно("/v1/traces");

