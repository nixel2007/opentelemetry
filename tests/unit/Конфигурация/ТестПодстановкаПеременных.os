// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:PublicMethodsDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:DuplicateStringLiteral-off
#Использовать "../../.."
#Использовать asserts

// Configuration Data Model / Environment variable substitution: случаи таблицы спецификации.
// Переменные окружения таблицы заданы с префиксом OTEL_TEST_ (см. УстановитьПеременныеТаблицы).
// Тип узла определяется после подстановки: значение без кавычек - по core schema YAML 1.2,
// значение в кавычках остается строкой

&ПараметризованныйТест
&ИсточникЗначение("${OTEL_TEST_STRING_VALUE}", "Строка", "value")
&ИсточникЗначение("${OTEL_TEST_BOOL_VALUE}", "Булево", "true")
&ИсточникЗначение("${OTEL_TEST_INT_VALUE}", "Число", "1")
&ИсточникЗначение("${OTEL_TEST_FLOAT_VALUE}", "Число", "1.1")
&ИсточникЗначение("${OTEL_TEST_HEX_VALUE}", "Число", "3735928559")
&ИсточникЗначение("""${OTEL_TEST_STRING_VALUE}""", "Строка", "value")
&ИсточникЗначение("""${OTEL_TEST_BOOL_VALUE}""", "Строка", "true")
&ИсточникЗначение("""${OTEL_TEST_INT_VALUE}""", "Строка", "1")
&ИсточникЗначение("""${OTEL_TEST_FLOAT_VALUE}""", "Строка", "1.1")
&ИсточникЗначение("""${OTEL_TEST_HEX_VALUE}""", "Строка", "0xdeadbeef")
&ИсточникЗначение("'${OTEL_TEST_INT_VALUE}'", "Строка", "1")
&ИсточникЗначение("${env:OTEL_TEST_STRING_VALUE}", "Строка", "value")
&ИсточникЗначение("foo ${OTEL_TEST_STRING_VALUE} ${OTEL_TEST_FLOAT_VALUE}", "Строка", "foo value 1.1")
&ИсточникЗначение("${OTEL_TEST_UNDEF}", "Неопределено", "")
&ИсточникЗначение("""${OTEL_TEST_UNDEF}""", "Строка", "")
&ИсточникЗначение("${OTEL_TEST_UNDEF:-fallback}", "Строка", "fallback")
&ИсточникЗначение("${OTEL_TEST_REPLACE_ME}", "Строка", "${OTEL_TEST_DO_NOT_REPLACE_ME}")
&ИсточникЗначение("${OTEL_TEST_UNDEF:-${OTEL_TEST_STRING_VALUE}}", "Строка", "${OTEL_TEST_STRING_VALUE}")
&ИсточникЗначение("$${OTEL_TEST_STRING_VALUE}", "Строка", "${OTEL_TEST_STRING_VALUE}")
&ИсточникЗначение("$$${OTEL_TEST_STRING_VALUE}", "Строка", "$value")
&ИсточникЗначение("$$$${OTEL_TEST_STRING_VALUE}", "Строка", "$${OTEL_TEST_STRING_VALUE}")
&ИсточникЗначение("$${OTEL_TEST_STRING_VALUE:-fallback}", "Строка", "${OTEL_TEST_STRING_VALUE:-fallback}")
&ИсточникЗначение("$${OTEL_TEST_STRING_VALUE:-${OTEL_TEST_STRING_VALUE}}", "Строка", "${OTEL_TEST_STRING_VALUE:-value}")
&ИсточникЗначение("${OTEL_TEST_UNDEF:-$${OTEL_TEST_UNDEF}}", "Строка", "${OTEL_TEST_UNDEF:-${OTEL_TEST_UNDEF}}")
&ИсточникЗначение("${OTEL_TEST_VALUE_WITH_ESCAPE}", "Строка", "value$$")
&ИсточникЗначение("a $$ b", "Строка", "a $ b")
&ИсточникЗначение("a $ b", "Строка", "a $ b")
Процедура ПодстановкаПоТаблицеСпецификации(ЗначениеYaml, ОжидаемыйТип, ОжидаемоеЗначение) Экспорт

    // Дано
    УстановитьПеременныеТаблицы();
    Попытка
        // Когда
        Результат = ОтелПодстановкаПеременных.ПрочитатьYaml("key: " + ЗначениеYaml);
    Исключение
        ОчиститьПеременныеТаблицы();
        ВызватьИсключение;
    КонецПопытки;
    ОчиститьПеременныеТаблицы();

    // Тогда - свойство есть и со значением null: Parse различает отсутствие и null
    Ожидаем.Что(ЕстьКлюч(Результат, "key"), "свойство key есть").ЭтоИстина();
    ПроверитьЗначение(Результат.Получить("key"), ОжидаемыйТип, ОжидаемоеЗначение);

КонецПроцедуры

&Тест
Процедура ПодстановкаНеВнедряетСтруктуруYaml() Экспорт

    // Дано - значение переменной похоже на YAML-отображение
    УстановитьПеременныеТаблицы();
    Попытка
        // Когда
        Результат = ОтелПодстановкаПеременных.ПрочитатьYaml("key: ${OTEL_TEST_INVALID_MAP_VALUE}");
    Исключение
        ОчиститьПеременныеТаблицы();
        ВызватьИсключение;
    КонецПопытки;
    ОчиститьПеременныеТаблицы();

    // Тогда - значение подставлено строкой, ключ из значения не появился
    Ожидаем.Что(Результат.Количество()).Равно(1);
    Ожидаем.Что(Результат.Получить("key")).Равно("value" + Символы.ПС + "key:value");

КонецПроцедуры

&Тест
Процедура ПодстановкаНеПрименяетсяКПеременнымВЗначенииПеременной() Экспорт

    // Дано - значение переменной содержит ссылку на другую переменную
    УстановитьПеременныеТаблицы();
    Попытка
        // Когда
        Результат = ОтелПодстановкаПеременных.ПрочитатьYaml(
            "key: ${OTEL_TEST_REPLACE_ME}" + Символы.ПС + "other: ${OTEL_TEST_DO_NOT_REPLACE_ME}");
    Исключение
        ОчиститьПеременныеТаблицы();
        ВызватьИсключение;
    КонецПопытки;
    ОчиститьПеременныеТаблицы();

    // Тогда
    Ожидаем.Что(Результат.Получить("key")).Равно("${OTEL_TEST_DO_NOT_REPLACE_ME}");
    Ожидаем.Что(Результат.Получить("other")).Равно("Never use this value");

КонецПроцедуры

&Тест
Процедура КлючиНеПодставляются() Экспорт

    // Дано - ссылка и экранирование в ключах
    УстановитьПеременныеТаблицы();
    Текст = "${OTEL_TEST_STRING_VALUE}: value" + Символы.ПС
        + """quoted ${OTEL_TEST_STRING_VALUE}"": 1" + Символы.ПС
        + "a$$b: 2" + Символы.ПС
        + "${1API_KEY}: 3";
    Попытка
        // Когда
        Результат = ОтелПодстановкаПеременных.ПрочитатьYaml(Текст);
    Исключение
        ОчиститьПеременныеТаблицы();
        ВызватьИсключение;
    КонецПопытки;
    ОчиститьПеременныеТаблицы();

    // Тогда - ключи остаются как в файле, некорректная ссылка в ключе не ошибка
    Ожидаем.Что(Результат.Получить("${OTEL_TEST_STRING_VALUE}")).Равно("value");
    Ожидаем.Что(Результат.Получить("quoted ${OTEL_TEST_STRING_VALUE}")).Равно(1);
    Ожидаем.Что(Результат.Получить("a$$b")).Равно(2);
    Ожидаем.Что(Результат.Получить("${1API_KEY}")).Равно(3);

КонецПроцедуры

&Тест
Процедура СсылкаВКомментарииНеПодставляется() Экспорт

    // Дано - некорректная ссылка в комментарии
    Текст = "key: 1 # ${1API_KEY}";

    // Когда
    Результат = ОтелПодстановкаПеременных.ПрочитатьYaml(Текст);

    // Тогда
    Ожидаем.Что(Результат.Получить("key")).Равно(1);

КонецПроцедуры

// Ссылка, которая не соответствует ENV-SUBSTITUTION (или с неподдерживаемым префиксом): разбор
// возвращает ошибку без частичного результата

&ПараметризованныйТест
&ИсточникЗначение("${OTEL_TEST_STRING_VALUE:?error}", "${OTEL_TEST_STRING_VALUE:?error}")
&ИсточникЗначение("${1API_KEY}", "${1API_KEY}")
&ИсточникЗначение("${API_$KEY}", "${API_$KEY}")
&ИсточникЗначение("${env:1API_KEY}", "${env:1API_KEY}")
&ИсточникЗначение("${sys:user.home}", "${sys:user.home}")
&ИсточникЗначение("""prefix ${ OTEL_TEST_STRING_VALUE } suffix""", "${ OTEL_TEST_STRING_VALUE }")
Процедура НекорректнаяСсылкаОшибкаРазбора(ЗначениеYaml, Ссылка) Экспорт

    // Дано
    Текст = "key: " + ЗначениеYaml;

    // Когда
    ТекстОшибки = "";
    Попытка
        ОтелПодстановкаПеременных.ПрочитатьYaml(Текст);
    Исключение
        ТекстОшибки = ОписаниеОшибки();
    КонецПопытки;

    // Тогда
    Ожидаем.Что(ТекстОшибки).Содержит(Ссылка);

КонецПроцедуры

&Тест
Процедура ТипыПослеПодстановкиВКоллекциях() Экспорт

    // Дано
    УстановитьПеременныеТаблицы();
    Текст = "list:" + Символы.ПС
        + "  - ${OTEL_TEST_INT_VALUE}" + Символы.ПС
        + "  - ""${OTEL_TEST_INT_VALUE}""" + Символы.ПС
        + "map:" + Символы.ПС
        + "  inner: ${OTEL_TEST_BOOL_VALUE}" + Символы.ПС
        + "flow: [${OTEL_TEST_INT_VALUE}, '${OTEL_TEST_INT_VALUE}']" + Символы.ПС
        + "plain: 42";
    Попытка
        // Когда
        Результат = ОтелПодстановкаПеременных.ПрочитатьYaml(Текст);
    Исключение
        ОчиститьПеременныеТаблицы();
        ВызватьИсключение;
    КонецПопытки;
    ОчиститьПеременныеТаблицы();

    // Тогда
    Ожидаем.Что(Результат.Получить("list")[0]).Равно(1);
    Ожидаем.Что(Результат.Получить("list")[1]).Равно("1");
    Ожидаем.Что(Результат.Получить("map").Получить("inner")).Равно(Истина);
    Ожидаем.Что(Результат.Получить("flow")[0]).Равно(1);
    Ожидаем.Что(Результат.Получить("flow")[1]).Равно("1");
    Ожидаем.Что(Результат.Получить("plain")).Равно(42);

КонецПроцедуры

// Тип подставленного значения без кавычек определяет парсер YAML, как для значения в файле: число,
// булево, null (пустое значение, ~ и null). Пробелы по краям значения отбрасываются, как у скаляра
// без кавычек. Конструкции YAML из значения (коллекции, якоря, алиасы, комментарии, директивы) не
// разбираются: такое значение остается строкой

&ПараметризованныйТест
&ИсточникЗначение("null", "Неопределено", "")
&ИсточникЗначение("Null", "Неопределено", "")
&ИсточникЗначение("NULL", "Неопределено", "")
&ИсточникЗначение("~", "Неопределено", "")
&ИсточникЗначение("True", "Булево", "true")
&ИсточникЗначение("FALSE", "Булево", "false")
&ИсточникЗначение("-5", "Число", "-5")
&ИсточникЗначение("+5", "Число", "5")
&ИсточникЗначение("0x1F", "Число", "31")
&ИсточникЗначение(".5", "Число", "0.5")
&ИсточникЗначение(" 7 ", "Число", "7")
&ИсточникЗначение(" value ", "Строка", "value")
&ИсточникЗначение("a b", "Строка", "a b")
&ИсточникЗначение("1.2.3", "Строка", "1.2.3")
&ИсточникЗначение("0x", "Строка", "0x")
&ИсточникЗначение(".inf", "Строка", ".inf")
&ИсточникЗначение("12abc", "Строка", "12abc")
&ИсточникЗначение("[1,2]", "Строка", "[1,2]")
&ИсточникЗначение("{a:1}", "Строка", "{a:1}")
&ИсточникЗначение("-", "Строка", "-")
&ИсточникЗначение("#ff0000", "Строка", "#ff0000")
&ИсточникЗначение("%2Fkey", "Строка", "%2Fkey")
&ИсточникЗначение("&anchor", "Строка", "&anchor")
&ИсточникЗначение("*alias", "Строка", "*alias")
Процедура ТипПодставленногоЗначенияКакУЗначенияВФайле(ЗначениеПеременной, ОжидаемыйТип, ОжидаемоеЗначение) Экспорт

    // Дано
    УстановитьПеременнуюСреды("OTEL_TEST_SCALAR", ЗначениеПеременной);
    Попытка
        // Когда
        Результат = ОтелПодстановкаПеременных.ПрочитатьYaml("key: ${OTEL_TEST_SCALAR}");
    Исключение
        УстановитьПеременнуюСреды("OTEL_TEST_SCALAR", "");
        ВызватьИсключение;
    КонецПопытки;
    УстановитьПеременнуюСреды("OTEL_TEST_SCALAR", "");

    // Тогда
    ПроверитьЗначение(Результат.Получить("key"), ОжидаемыйТип, ОжидаемоеЗначение);

КонецПроцедуры

// ПодставитьВСтроке: подстановка в строке по тем же правилам, результат всегда строка

&ПараметризованныйТест
&ИсточникЗначение("prefix-${OTEL_TEST_STRING_VALUE}-suffix", "prefix-value-suffix")
&ИсточникЗначение("${OTEL_TEST_UNDEF:-fallback}", "fallback")
&ИсточникЗначение("${OTEL_TEST_UNDEF}", "")
&ИсточникЗначение("${env:OTEL_TEST_INT_VALUE}", "1")
&ИсточникЗначение("$${OTEL_TEST_STRING_VALUE}", "${OTEL_TEST_STRING_VALUE}")
&ИсточникЗначение("${OTEL_TEST_UNDEF:-$${OTEL_TEST_UNDEF}}", "${OTEL_TEST_UNDEF:-${OTEL_TEST_UNDEF}}")
&ИсточникЗначение("\${OTEL_TEST_STRING_VALUE}", "\value")
&ИсточникЗначение("${UNCLOSED", "${UNCLOSED")
&ИсточникЗначение("text$", "text$")
&ИсточникЗначение("text$x", "text$x")
&ИсточникЗначение("", "")
Процедура ПодставитьВСтроке(Строка, Ожидаемое) Экспорт

    // Дано
    УстановитьПеременныеТаблицы();
    Попытка
        // Когда
        Результат = ОтелПодстановкаПеременных.ПодставитьВСтроке(Строка);
    Исключение
        ОчиститьПеременныеТаблицы();
        ВызватьИсключение;
    КонецПопытки;
    ОчиститьПеременныеТаблицы();

    // Тогда
    Ожидаем.Что(Результат).Равно(Ожидаемое);

КонецПроцедуры

&Тест
Процедура ПодставитьВСтрокеНекорректнаяСсылкаОшибка() Экспорт

    // Когда
    ТекстОшибки = "";
    Попытка
        ОтелПодстановкаПеременных.ПодставитьВСтроке("a ${1API_KEY} b");
    Исключение
        ТекстОшибки = ОписаниеОшибки();
    КонецПопытки;

    // Тогда
    Ожидаем.Что(ТекстОшибки).Содержит("${1API_KEY}");

КонецПроцедуры

Процедура ПроверитьЗначение(Значение, ОжидаемыйТип, ОжидаемоеЗначение)

    Если ОжидаемыйТип = "Неопределено" Тогда
        Ожидаем.Что(Значение).Равно(Неопределено);
    ИначеЕсли ОжидаемыйТип = "Булево" Тогда
        Ожидаем.Что(Значение).Равно(ОжидаемоеЗначение = "true");
    ИначеЕсли ОжидаемыйТип = "Число" Тогда
        Ожидаем.Что(ТипЗнч(Значение)).Равно(Тип("Число"));
        Ожидаем.Что(Значение).Равно(XMLЗначение(Тип("Число"), ОжидаемоеЗначение));
    Иначе
        Ожидаем.Что(ТипЗнч(Значение)).Равно(Тип("Строка"));
        Ожидаем.Что(Значение).Равно(ОжидаемоеЗначение);
    КонецЕсли;

КонецПроцедуры

Функция ЕстьКлюч(Данные, Ключ)
    Для Каждого КлючЗначение Из Данные Цикл
        Если КлючЗначение.Ключ = Ключ Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Процедура УстановитьПеременныеТаблицы()
    УстановитьПеременнуюСреды("OTEL_TEST_STRING_VALUE", "value");
    УстановитьПеременнуюСреды("OTEL_TEST_BOOL_VALUE", "true");
    УстановитьПеременнуюСреды("OTEL_TEST_INT_VALUE", "1");
    УстановитьПеременнуюСреды("OTEL_TEST_FLOAT_VALUE", "1.1");
    УстановитьПеременнуюСреды("OTEL_TEST_HEX_VALUE", "0xdeadbeef");
    УстановитьПеременнуюСреды("OTEL_TEST_INVALID_MAP_VALUE", "value" + Символы.ПС + "key:value");
    УстановитьПеременнуюСреды("OTEL_TEST_DO_NOT_REPLACE_ME", "Never use this value");
    УстановитьПеременнуюСреды("OTEL_TEST_REPLACE_ME", "${OTEL_TEST_DO_NOT_REPLACE_ME}");
    УстановитьПеременнуюСреды("OTEL_TEST_VALUE_WITH_ESCAPE", "value$$");
    УстановитьПеременнуюСреды("OTEL_TEST_UNDEF", "");
КонецПроцедуры

Процедура ОчиститьПеременныеТаблицы()
    УстановитьПеременнуюСреды("OTEL_TEST_STRING_VALUE", "");
    УстановитьПеременнуюСреды("OTEL_TEST_BOOL_VALUE", "");
    УстановитьПеременнуюСреды("OTEL_TEST_INT_VALUE", "");
    УстановитьПеременнуюСреды("OTEL_TEST_FLOAT_VALUE", "");
    УстановитьПеременнуюСреды("OTEL_TEST_HEX_VALUE", "");
    УстановитьПеременнуюСреды("OTEL_TEST_INVALID_MAP_VALUE", "");
    УстановитьПеременнуюСреды("OTEL_TEST_DO_NOT_REPLACE_ME", "");
    УстановитьПеременнуюСреды("OTEL_TEST_REPLACE_ME", "");
    УстановитьПеременнуюСреды("OTEL_TEST_VALUE_WITH_ESCAPE", "");
КонецПроцедуры
