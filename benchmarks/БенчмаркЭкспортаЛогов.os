// Стоимость экспорта пачки записей журнала по шагам: подготовка OTLP и кодирование для каждого протокола.
// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:ExportVariables-off
// BSLLS:UnusedParameters-off
#Использовать ".."

&Параметры(512)
Перем КоличествоЗаписей Экспорт;

Перем Записи;
Перем ДанныеOtlp;
Перем Конвертер;

&СортировкаПоМетоду
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередКаждымКейсом
Процедура Подготовить(Контекст) Экспорт
	Записи = ПачкаЗаписей(КоличествоЗаписей);
	Транспорт = Новый ОтелВПамятьТранспорт();
	Экспортер = Новый ОтелЭкспортерЛогов(Транспорт);
	Экспортер.Экспортировать(Записи);
	ДанныеOtlp = Транспорт.ПолучитьОтправленные()[0].Получить("Данные");
	Конвертер = Новый ОтелКонвертерOtlpВProto();
КонецПроцедуры

&Бенчмарк
Процедура ПодготовкаOtlp() Экспорт
	Экспортер = Новый ОтелЭкспортерЛогов(Новый ОтелВПамятьТранспорт());
	Экспортер.Экспортировать(Записи);
КонецПроцедуры

&Бенчмарк
Процедура КодированиеHttpProtobuf() Экспорт
	ОтелПротоКодировщикLogs.ЗакодироватьLogsData(ДанныеOtlp);
КонецПроцедуры

&Бенчмарк
Процедура КодированиеHttpJson() Экспорт
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеOtlp);
	ПолучитьДвоичныеДанныеИзСтроки(ЗаписьJSON.Закрыть(), "UTF-8");
КонецПроцедуры

&Бенчмарк
Процедура КонвертацияGrpc() Экспорт
	Конвертер.Конвертировать(ДанныеOtlp);
КонецПроцедуры

// Отладочные записи журнала запросов с контекстом трассировки и парой атрибутов.
Функция ПачкаЗаписей(Количество)
	Ресурс = Новый ОтелРесурс(Истина);
	Область = Новый ОтелОбластьИнструментирования("app.requests", "1.0.0");
	Результат = Новый Массив();
	Для Номер = 1 По Количество Цикл
		Запись = Новый ОтелЗаписьЛога();
		Запись.УстановитьРесурс(Ресурс);
		Запись.УстановитьОбластьИнструментирования(Область);
		Запись.УстановитьСерьезность(5);
		Запись.УстановитьТекстСерьезности("DEBUG");
		Тело = СтрШаблон("Запрос GET /items/%1 обработан за %2 мс, ответ 200, отдано %3 байт",
			Номер, Номер % 97, Номер * 13);
		Запись.УстановитьТело(Тело);
		Запись.УстановитьАтрибут("code.function.name", "ОбработатьЗапрос");
		Запись.УстановитьАтрибут("http.route", "/items/{id}");
		Запись.УстановитьАтрибут("thread.id", Номер % 24);
		Запись.УстановитьКонтекстТрассировки("0af7651916cd43dd8448eb211c80319c", "b7ad6b7169203331");
		Результат.Добавить(Запись);
	КонецЦикла;
	Возврат Результат;
КонецФункции
