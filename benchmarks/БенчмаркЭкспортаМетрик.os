// Стоимость экспорта выгрузки метрик по шагам: подготовка OTLP и кодирование для каждого протокола.
// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:ExportVariables-off
// BSLLS:UnusedParameters-off
#Использовать ".."

&Параметры(20)
Перем КоличествоМаршрутов Экспорт;

Перем ДанныеМетрик;
Перем ДанныеOtlp;
Перем Конвертер;

&СортировкаПоМетоду
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередКаждымКейсом
Процедура Подготовить(Контекст) Экспорт
	ДанныеМетрик = ВыгрузкаМетрик(КоличествоМаршрутов);
	Транспорт = Новый ОтелВПамятьТранспорт();
	Экспортер = Новый ОтелЭкспортерМетрик(Транспорт);
	Экспортер.Экспортировать(ДанныеМетрик);
	ДанныеOtlp = Транспорт.ПолучитьОтправленные()[0].Получить("Данные");
	Конвертер = Новый ОтелКонвертерOtlpВProto();
КонецПроцедуры

&Бенчмарк
Процедура ПодготовкаOtlp() Экспорт
	Экспортер = Новый ОтелЭкспортерМетрик(Новый ОтелВПамятьТранспорт());
	Экспортер.Экспортировать(ДанныеМетрик);
КонецПроцедуры

&Бенчмарк
Процедура КодированиеHttpProtobuf() Экспорт
	ОтелПротоКодировщикMetrics.ЗакодироватьMetricsData(ДанныеOtlp);
КонецПроцедуры

&Бенчмарк
Процедура КодированиеHttpJson() Экспорт
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеOtlp);
	ПолучитьДвоичныеДанныеИзСтроки(ЗаписьJSON.Закрыть(), "UTF-8");
КонецПроцедуры

&Бенчмарк
Процедура КонвертацияGrpc() Экспорт
	Конвертер.Конвертировать(ДанныеOtlp);
КонецПроцедуры

// Метрики HTTP-сервера: гистограмма длительности и счетчик запросов по маршрутам и кодам ответа,
// число активных запросов по маршрутам.
Функция ВыгрузкаМетрик(Маршрутов)
	Ресурс = Новый ОтелРесурс(Истина);
	Метр = Новый ОтелПровайдерМетрик(Ресурс).ПолучитьМетр("http-server", "1.0.0");
	Длительность = Метр.СоздатьГистограмму("http.server.request.duration", "", "s");
	Запросы = Метр.СоздатьСчетчик("http.server.requests");
	Активные = Метр.СоздатьРеверсивныйСчетчик("http.server.active_requests");
	Коды = СтрРазделить("200,304,404", ",");
	Для НомерМаршрута = 1 По Маршрутов Цикл
		Маршрут = "/route" + НомерМаршрута + "/{id}";
		Для Каждого Код Из Коды Цикл
			Атрибуты = Новый ОтелАтрибуты();
			Атрибуты.Установить("http.request.method", "GET");
			Атрибуты.Установить("http.route", Маршрут);
			Атрибуты.Установить("http.response.status_code", Число(Код));
			Для Замер = 1 По 10 Цикл
				Длительность.Записать(Замер * 0.037 + НомерМаршрута * 0.011, Атрибуты);
			КонецЦикла;
			Запросы.Добавить(10, Атрибуты);
		КонецЦикла;
		АтрибутыМаршрута = Новый ОтелАтрибуты();
		АтрибутыМаршрута.Установить("http.route", Маршрут);
		Активные.Добавить(НомерМаршрута % 5, АтрибутыМаршрута);
	КонецЦикла;

	Результат = Новый Массив();
	Результат.Добавить(Собрать(Метр, Длительность));
	Результат.Добавить(Собрать(Метр, Запросы));
	Результат.Добавить(Собрать(Метр, Активные));
	Возврат Результат;
КонецФункции

Функция Собрать(Метр, Инструмент)
	Возврат Инструмент.Собрать(Метр.Ресурс(), Метр.ОбластьИнструментирования(), Инструмент.Имя(), Инструмент.Описание());
КонецФункции
