// Стоимость записи измерения синхронного инструмента: гистограмма с атрибутами и без, счетчик с атрибутами.
// Объект атрибутов один на все измерения, как у инструментированного кода с постоянным набором атрибутов.
// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:ExportVariables-off
// BSLLS:UnusedParameters-off
#Использовать ".."

&Параметры(3)
Перем КоличествоАтрибутов Экспорт;

Перем Гистограмма;
Перем Счетчик;
Перем Атрибуты;

&СортировкаПоМетоду
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередКаждымКейсом
Процедура Подготовить(Контекст) Экспорт
	Читатели = Новый Массив();
	Читатели.Добавить(Новый ОтелПериодическийЧитательМетрик(Новый ОтелЭкспортерМетрик(Новый ОтелВПамятьТранспорт()),
		3600000));
	Провайдер = Новый ОтелПровайдерМетрик(Новый ОтелРесурс(), Читатели);
	Метр = Провайдер.ПолучитьМетр("app.requests");
	Гистограмма = Метр.СоздатьГистограмму("http.server.request.duration", "", "s");
	Счетчик = Метр.СоздатьСчетчик("http.server.requests", "", "1");
	Атрибуты = Новый ОтелАтрибуты();
	Для Номер = 1 По КоличествоАтрибутов Цикл
		Атрибуты.Установить("app.attribute." + Номер, "значение атрибута " + Номер);
	КонецЦикла;
КонецПроцедуры

&Бенчмарк
Процедура ГистограммаСАтрибутами() Экспорт
	Гистограмма.Записать(0.03, Атрибуты);
КонецПроцедуры

&Бенчмарк
Процедура ГистограммаБезАтрибутов() Экспорт
	Гистограмма.Записать(0.03);
КонецПроцедуры

&Бенчмарк
Процедура СчетчикСАтрибутами() Экспорт
	Счетчик.Добавить(1, Атрибуты);
КонецПроцедуры

&Бенчмарк
Процедура КлючАтрибутов() Экспорт
	Атрибуты.Ключ();
КонецПроцедуры
