// Стоимость экспорта пачки спанов по шагам: подготовка OTLP и кодирование для каждого протокола.
// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:ExportVariables-off
// BSLLS:UnusedParameters-off
#Использовать ".."

&Параметры(512)
Перем КоличествоСпанов Экспорт;

Перем Спаны;
Перем ДанныеOtlp;
Перем Конвертер;

&СортировкаПоМетоду
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередКаждымКейсом
Процедура Подготовить(Контекст) Экспорт
	Спаны = ПачкаСпанов(КоличествоСпанов);
	Транспорт = Новый ОтелВПамятьТранспорт();
	Экспортер = Новый ОтелЭкспортерСпанов(Транспорт);
	Экспортер.Экспортировать(Спаны);
	ДанныеOtlp = Транспорт.ПолучитьОтправленные()[0].Получить("Данные");
	Конвертер = Новый ОтелКонвертерOtlpВProto();
КонецПроцедуры

&Бенчмарк
Процедура ПодготовкаOtlp() Экспорт
	Экспортер = Новый ОтелЭкспортерСпанов(Новый ОтелВПамятьТранспорт());
	Экспортер.Экспортировать(Спаны);
КонецПроцедуры

&Бенчмарк
Процедура КодированиеHttpProtobuf() Экспорт
	ОтелПротоКодировщикTrace.ЗакодироватьTracesData(ДанныеOtlp);
КонецПроцедуры

&Бенчмарк
Процедура КодированиеHttpJson() Экспорт
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеOtlp);
	ПолучитьДвоичныеДанныеИзСтроки(ЗаписьJSON.Закрыть(), "UTF-8");
КонецПроцедуры

&Бенчмарк
Процедура КонвертацияGrpc() Экспорт
	Конвертер.Конвертировать(ДанныеOtlp);
КонецПроцедуры

// Треть спанов - входящие HTTP-запросы, остальные - запросы к базе данных.
Функция ПачкаСпанов(Количество)
	Ресурс = Новый ОтелРесурс();
	ОбластьHttp = Новый ОтелОбластьИнструментирования("http-server", "1.0.0");
	ОбластьБД = Новый ОтелОбластьИнструментирования("db-client", "1.0.0");
	Результат = Новый Массив();
	Для Номер = 1 По Количество Цикл
		Если Номер % 3 = 1 Тогда
			Спан = Новый ОтелСпан("GET /items/{id}", Ресурс, ОбластьHttp, , , , ОтелВидСпана.Сервер());
			Спан.УстановитьАтрибут("http.request.method", "GET");
			Спан.УстановитьАтрибут("http.route", "/items/{id}");
			Спан.УстановитьАтрибут("url.path", "/items/" + Номер);
			Спан.УстановитьАтрибут("url.scheme", "http");
			Спан.УстановитьАтрибут("server.address", "example.org");
			Спан.УстановитьАтрибут("server.port", 8080);
			Спан.УстановитьАтрибут("client.address", "10.0.0." + (Номер % 250));
			Спан.УстановитьАтрибут("user_agent.original", "load-generator/1.0");
			Спан.УстановитьАтрибут("http.response.status_code", 200);
			Спан.УстановитьАтрибут("network.protocol.version", "1.1");
		Иначе
			Спан = Новый ОтелСпан("SELECT shop.items", Ресурс, ОбластьБД, , , , ОтелВидСпана.Клиент());
			Спан.УстановитьАтрибут("db.system.name", "postgresql");
			Спан.УстановитьАтрибут("db.namespace", "shop");
			Спан.УстановитьАтрибут("db.operation.name", "SELECT");
			Спан.УстановитьАтрибут("db.collection.name", "items");
			Спан.УстановитьАтрибут("db.query.text",
				"SELECT id, owner_id, name, description, created_at, updated_at, views FROM items "
				+ "WHERE owner_id = $1 AND name = $2 ORDER BY name LIMIT 20 OFFSET 0");
			Спан.УстановитьАтрибут("server.address", "db");
			Спан.УстановитьАтрибут("server.port", 5432);
		КонецЕсли;
		Спан.Завершить();
		Результат.Добавить(Спан);
	КонецЦикла;
	Возврат Результат;
КонецФункции
