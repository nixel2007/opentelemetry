// Стоимость создания и завершения спана в SDK: корневой и дочерний без атрибутов, корневой с начальными атрибутами.
// Процессор простой и без экспортера: замер не включает экспорт.
// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:ExportVariables-off
// BSLLS:UnusedParameters-off
#Использовать ".."

&Параметры(27)
Перем КоличествоАтрибутов Экспорт;

Перем Трассировщик;
Перем Атрибуты;
Перем КонтекстРодителя;

&СортировкаПоМетоду
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередКаждымКейсом
Процедура Подготовить(Контекст) Экспорт
	Провайдер = Новый ОтелПровайдерТрассировки(Новый ОтелРесурс(), Новый ОтелПростойПроцессорСпанов(Неопределено));
	Трассировщик = Провайдер.ПолучитьТрассировщик("app.requests");
	Атрибуты = Новый Соответствие();
	Для Номер = 1 По КоличествоАтрибутов Цикл
		Атрибуты.Вставить("app.attribute." + Номер, "значение атрибута " + Номер);
	КонецЦикла;
	КонтекстСпанаРодителя = Новый ОтелКонтекстСпана("0af7651916cd43dd8448eb211c80319c", "b7ad6b7169203331", 1);
	КонтекстРодителя = ОтелКонтекст.КонтекстСоСпаном(Новый Соответствие(), ОтелСпаны.Обернуть(КонтекстСпанаРодителя));
КонецПроцедуры

&Бенчмарк
Процедура КорневойБезАтрибутов() Экспорт
	Спан = Трассировщик.НачатьКорневойСпан("GET /items/{id}");
	Спан.Завершить();
КонецПроцедуры

&Бенчмарк
Процедура ДочернийБезАтрибутов() Экспорт
	Спан = Трассировщик.НачатьДочернийСпан("SELECT items", КонтекстРодителя);
	Спан.Завершить();
КонецПроцедуры

&Бенчмарк
Процедура КорневойСАтрибутами() Экспорт
	Спан = Трассировщик.НачатьКорневойСпан("GET /items/{id}", , Атрибуты);
	Спан.Завершить();
КонецПроцедуры
