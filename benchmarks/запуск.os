// Запуск бенчмарков каталога: oscript benchmarks/запуск.os [ИмяФайла.os]... [ИмяПараметра=Число]...
// Без имен файлов запускаются все файлы Бенчмарк*.os.
// BSLLS:Typo-off
#Использовать benchmark

Каталог = ТекущийСценарий().Каталог;
Параметры = Новый Соответствие();
Файлы = Новый Массив();

Для Каждого Аргумент Из АргументыКоманднойСтроки Цикл
	Позиция = СтрНайти(Аргумент, "=");
	Если Позиция = 0 Тогда
		Файлы.Добавить(Новый Файл(ОбъединитьПути(Каталог, Аргумент)));
	Иначе
		Параметры.Вставить(Лев(Аргумент, Позиция - 1), Число(Сред(Аргумент, Позиция + 1)));
	КонецЕсли;
КонецЦикла;

Если Файлы.Количество() = 0 Тогда
	Файлы = НайтиФайлы(Каталог, "Бенчмарк*.os");
КонецЕсли;

Для Каждого ФайлБенчмарка Из Файлы Цикл
	ТипБенчмарка = Бенчмаркинг.ПодключитьБенчмарк(ФайлБенчмарка.ПолноеИмя);
	Если ТипБенчмарка = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Не удалось подключить бенчмарк %1", ФайлБенчмарка.ПолноеИмя);
	КонецЕсли;
	Конфигурация = Новый КонфигурацияБенчмарков(ТипБенчмарка);
	Для Каждого Параметр Из Параметры Цикл
		Конфигурация.ДобавитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	Бенчмаркинг.Запустить(ТипБенчмарка, Конфигурация);
КонецЦикла;
