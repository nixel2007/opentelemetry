// Стоимость записи журнала в SDK: создание записи, запись с атрибутами, тот же путь через пакетный процессор.
// Экспортеров нет: пакетный процессор копит записи, фоновый экспорт не наступает.
// BSLLS:MagicNumber-off
// BSLLS:MissingVariablesDescription-off
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// BSLLS:ExportVariables-off
// BSLLS:UnusedParameters-off
#Использовать ".."
#Использовать extends

&Параметры(20)
Перем КоличествоАтрибутов Экспорт;

Перем ЛоггерПростой;
Перем ЛоггерПакетный;
Перем ПровайдерПакетный;
Перем КонтекстЗаписи;

&СортировкаПоМетоду
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередКаждымКейсом
Процедура Подготовить(Контекст) Экспорт
	Ресурс = Новый ОтелРесурс();
	Провайдер = Новый ОтелПровайдерЛогирования(Ресурс, Новый ОтелПростойПроцессорЛогов(Неопределено));
	ЛоггерПростой = Провайдер.ПолучитьЛоггер("app.requests");
	Если ПровайдерПакетный <> Неопределено Тогда
		ПровайдерПакетный.Закрыть();
	КонецЕсли;
	Базовый = Новый ОтелБазовыйПакетныйПроцессор(Неопределено, "logs", 100000000, 100000000, 3600000);
	Процессор = Новый ПостроительНаследника(Новый ОтелПакетныйПроцессорЛогов(), Базовый).Построить();
	ПровайдерПакетный = Новый ОтелПровайдерЛогирования(Ресурс, Процессор);
	ЛоггерПакетный = ПровайдерПакетный.ПолучитьЛоггер("app.requests");
	КонтекстЗаписи = Новый Соответствие();
КонецПроцедуры

&ПослеВсех
Процедура Закрыть(Контекст) Экспорт
	Если ПровайдерПакетный <> Неопределено Тогда
		ПровайдерПакетный.Закрыть();
		ПровайдерПакетный = Неопределено;
	КонецЕсли;
КонецПроцедуры

&Бенчмарк
Процедура СозданиеЗаписи() Экспорт
	ЛоггерПростой.СоздатьЗаписьЛога();
КонецПроцедуры

&Бенчмарк
Процедура ЗаписьСАтрибутами() Экспорт
	ЛоггерПростой.Записать(НоваяЗаписьСАтрибутами(ЛоггерПростой), КонтекстЗаписи);
КонецПроцедуры

&Бенчмарк
Процедура ЗаписьСАтрибутамиПакетныйПроцессор() Экспорт
	ЛоггерПакетный.Записать(НоваяЗаписьСАтрибутами(ЛоггерПакетный), КонтекстЗаписи);
КонецПроцедуры

Функция НоваяЗаписьСАтрибутами(Логгер)
	Запись = Логгер.СоздатьЗаписьЛога();
	Запись.УстановитьСерьезность(5);
	Запись.УстановитьТело("Запрос GET /items/42 обработан за 17 мс");
	Для Номер = 1 По КоличествоАтрибутов Цикл
		Запись.УстановитьАтрибут("app.attribute." + Номер, "значение атрибута");
	КонецЦикла;
	Возврат Запись;
КонецФункции
